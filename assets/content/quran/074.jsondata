{"arabic":{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Müddessir","englishNameTranslation":"The Cloaked One","revelationType":"Meccan","numberOfAyahs":56,"ayahs":[{"number":5496,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ يَا أَيُّهَا الْمُدَّثِّرُ","numberInSurah":1,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5497,"text":"قُمْ فَأَنْذِرْ","numberInSurah":2,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5498,"text":"وَرَبَّكَ فَكَبِّرْ","numberInSurah":3,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5499,"text":"وَثِيَابَكَ فَطَهِّرْ","numberInSurah":4,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5500,"text":"وَالرُّجْزَ فَاهْجُرْ","numberInSurah":5,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5501,"text":"وَلَا تَمْنُنْ تَسْتَكْثِرُ","numberInSurah":6,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5502,"text":"وَلِرَبِّكَ فَاصْبِرْ","numberInSurah":7,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5503,"text":"فَإِذَا نُقِرَ فِي النَّاقُورِ","numberInSurah":8,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5504,"text":"فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ","numberInSurah":9,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5505,"text":"عَلَى الْكَافِرِينَ غَيْرُ يَسِيرٍ","numberInSurah":10,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5506,"text":"ذَرْنِي وَمَنْ خَلَقْتُ وَحِيدًا","numberInSurah":11,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5507,"text":"وَجَعَلْتُ لَهُ مَالًا مَمْدُودًا","numberInSurah":12,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5508,"text":"وَبَنِينَ شُهُودًا","numberInSurah":13,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5509,"text":"وَمَهَّدْتُ لَهُ تَمْهِيدًا","numberInSurah":14,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5510,"text":"ثُمَّ يَطْمَعُ أَنْ أَزِيدَ","numberInSurah":15,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5511,"text":"كَلَّا ۖ إِنَّهُ كَانَ لِآيَاتِنَا عَنِيدًا","numberInSurah":16,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5512,"text":"سَأُرْهِقُهُ صَعُودًا","numberInSurah":17,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5513,"text":"إِنَّهُ فَكَّرَ وَقَدَّرَ","numberInSurah":18,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5514,"text":"فَقُتِلَ كَيْفَ قَدَّرَ","numberInSurah":19,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5515,"text":"ثُمَّ قُتِلَ كَيْفَ قَدَّرَ","numberInSurah":20,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5516,"text":"ثُمَّ نَظَرَ","numberInSurah":21,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5517,"text":"ثُمَّ عَبَسَ وَبَسَرَ","numberInSurah":22,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5518,"text":"ثُمَّ أَدْبَرَ وَاسْتَكْبَرَ","numberInSurah":23,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5519,"text":"فَقَالَ إِنْ هَٰذَا إِلَّا سِحْرٌ يُؤْثَرُ","numberInSurah":24,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5520,"text":"إِنْ هَٰذَا إِلَّا قَوْلُ الْبَشَرِ","numberInSurah":25,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5521,"text":"سَأُصْلِيهِ سَقَرَ","numberInSurah":26,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5522,"text":"وَمَا أَدْرَاكَ مَا سَقَرُ","numberInSurah":27,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5523,"text":"لَا تُبْقِي وَلَا تَذَرُ","numberInSurah":28,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5524,"text":"لَوَّاحَةٌ لِلْبَشَرِ","numberInSurah":29,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5525,"text":"عَلَيْهَا تِسْعَةَ عَشَرَ","numberInSurah":30,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5526,"text":"وَمَا جَعَلْنَا أَصْحَابَ النَّارِ إِلَّا مَلَائِكَةً ۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِلَّذِينَ كَفَرُوا لِيَسْتَيْقِنَ الَّذِينَ أُوتُوا الْكِتَابَ وَيَزْدَادَ الَّذِينَ آمَنُوا إِيمَانًا ۙ وَلَا يَرْتَابَ الَّذِينَ أُوتُوا الْكِتَابَ وَالْمُؤْمِنُونَ ۙ وَلِيَقُولَ الَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ وَالْكَافِرُونَ مَاذَا أَرَادَ اللَّهُ بِهَٰذَا مَثَلًا ۚ كَذَٰلِكَ يُضِلُّ اللَّهُ مَنْ يَشَاءُ وَيَهْدِي مَنْ يَشَاءُ ۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ ۚ وَمَا هِيَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ","numberInSurah":31,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5527,"text":"كَلَّا وَالْقَمَرِ","numberInSurah":32,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5528,"text":"وَاللَّيْلِ إِذْ أَدْبَرَ","numberInSurah":33,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5529,"text":"وَالصُّبْحِ إِذَا أَسْفَرَ","numberInSurah":34,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5530,"text":"إِنَّهَا لَإِحْدَى الْكُبَرِ","numberInSurah":35,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5531,"text":"نَذِيرًا لِلْبَشَرِ","numberInSurah":36,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5532,"text":"لِمَنْ شَاءَ مِنْكُمْ أَنْ يَتَقَدَّمَ أَوْ يَتَأَخَّرَ","numberInSurah":37,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5533,"text":"كُلُّ نَفْسٍ بِمَا كَسَبَتْ رَهِينَةٌ","numberInSurah":38,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5534,"text":"إِلَّا أَصْحَابَ الْيَمِينِ","numberInSurah":39,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5535,"text":"فِي جَنَّاتٍ يَتَسَاءَلُونَ","numberInSurah":40,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5536,"text":"عَنِ الْمُجْرِمِينَ","numberInSurah":41,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5537,"text":"مَا سَلَكَكُمْ فِي سَقَرَ","numberInSurah":42,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5538,"text":"قَالُوا لَمْ نَكُ مِنَ الْمُصَلِّينَ","numberInSurah":43,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5539,"text":"وَلَمْ نَكُ نُطْعِمُ الْمِسْكِينَ","numberInSurah":44,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5540,"text":"وَكُنَّا نَخُوضُ مَعَ الْخَائِضِينَ","numberInSurah":45,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5541,"text":"وَكُنَّا نُكَذِّبُ بِيَوْمِ الدِّينِ","numberInSurah":46,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5542,"text":"حَتَّىٰ أَتَانَا الْيَقِينُ","numberInSurah":47,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5543,"text":"فَمَا تَنْفَعُهُمْ شَفَاعَةُ الشَّافِعِينَ","numberInSurah":48,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5544,"text":"فَمَا لَهُمْ عَنِ التَّذْكِرَةِ مُعْرِضِينَ","numberInSurah":49,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5545,"text":"كَأَنَّهُمْ حُمُرٌ مُسْتَنْفِرَةٌ","numberInSurah":50,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5546,"text":"فَرَّتْ مِنْ قَسْوَرَةٍ","numberInSurah":51,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5547,"text":"بَلْ يُرِيدُ كُلُّ امْرِئٍ مِنْهُمْ أَنْ يُؤْتَىٰ صُحُفًا مُنَشَّرَةً","numberInSurah":52,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5548,"text":"كَلَّا ۖ بَلْ لَا يَخَافُونَ الْآخِرَةَ","numberInSurah":53,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5549,"text":"كَلَّا إِنَّهُ تَذْكِرَةٌ","numberInSurah":54,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5550,"text":"فَمَنْ شَاءَ ذَكَرَهُ","numberInSurah":55,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5551,"text":"وَمَا يَذْكُرُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ ۚ هُوَ أَهْلُ التَّقْوَىٰ وَأَهْلُ الْمَغْفِرَةِ","numberInSurah":56,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":74,"name":"سُورَةُ المُدَّثِّرِ","englishName":"Müddessir","englishNameTranslation":"The Cloaked One","revelationType":"Meccan","numberOfAyahs":56,"ayahs":[{"number":5496,"text":"Ey örtüye bürünen!","numberInSurah":1,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5497,"text":"Kalk da uyar.","numberInSurah":2,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5498,"text":"Rabbini yücelt.","numberInSurah":3,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5499,"text":"Giydiklerini temiz tut.","numberInSurah":4,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5500,"text":"Kötü şeyleri terke devam et.","numberInSurah":5,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5501,"text":"Yaptığın iyiliği çok görerek başa kakma.","numberInSurah":6,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5502,"text":"Rabbin için sabret.","numberInSurah":7,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5503,"text":"Sura üflendiği vakit, işte o gün, inkarcılara kolay olmayan zorlu bir gündür.","numberInSurah":8,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5504,"text":"Sura üflendiği vakit, işte o gün, inkarcılara kolay olmayan zorlu bir gündür.","numberInSurah":9,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5505,"text":"Sura üflendiği vakit, işte o gün, inkarcılara kolay olmayan zorlu bir gündür.","numberInSurah":10,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5506,"text":"Tek olarak yaratıp kendisine bol bol mal, çevresinde bulunan oğullar verdiğim ve nimetleri yaydıkça yaydığım o kimseyi Bana bırak.","numberInSurah":11,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5507,"text":"Tek olarak yaratıp kendisine bol bol mal, çevresinde bulunan oğullar verdiğim ve nimetleri yaydıkça yaydığım o kimseyi Bana bırak.","numberInSurah":12,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5508,"text":"Tek olarak yaratıp kendisine bol bol mal, çevresinde bulunan oğullar verdiğim ve nimetleri yaydıkça yaydığım o kimseyi Bana bırak.","numberInSurah":13,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5509,"text":"Tek olarak yaratıp kendisine bol bol mal, çevresinde bulunan oğullar verdiğim ve nimetleri yaydıkça yaydığım o kimseyi Bana bırak.","numberInSurah":14,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5510,"text":"Bir de verdiğim nimetten artırmamı umar;","numberInSurah":15,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5511,"text":"Hayır; hayır; çünkü o, Bizim ayetlerimize karşı son derece inatçıdır.","numberInSurah":16,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5512,"text":"Onu sarp bir yokuşa sardıracağım.","numberInSurah":17,"juz":29,"manzil":7,"page":575,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5513,"text":"Çünkü o, düşündü, ölçtü biçti;","numberInSurah":18,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5514,"text":"Canı çıkası, ne biçim ölçüp biçti!","numberInSurah":19,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5515,"text":"Canı çıkası; sonra yine ne biçim ölçüp biçti!","numberInSurah":20,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5516,"text":"Sonra baktı;","numberInSurah":21,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5517,"text":"Sonra kaşlarını çattı, suratını aştı;","numberInSurah":22,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5518,"text":"Sonra da sırt çevirip büyüklük tasladı.","numberInSurah":23,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5519,"text":"\"Bu sadece öğretilegelen bir sihirdir. Bu Kuran yalnızca bir insan sözüdür\" dedi.","numberInSurah":24,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5520,"text":"\"Bu sadece öğretilegelen bir sihirdir. Bu Kuran yalnızca bir insan sözüdür\" dedi.","numberInSurah":25,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5521,"text":"İşte bu adamı yakıcı bir ateşe yaslayacağım.","numberInSurah":26,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5522,"text":"Yakıcı ateşin ne olduğunu sen nerden bilirsin?","numberInSurah":27,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5523,"text":"O, ne geri bırakır ne de azabdan vazgeçer.","numberInSurah":28,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5524,"text":"İnsanın derisini kavurur;","numberInSurah":29,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5525,"text":"Orada ondokuz bekçi vardır.","numberInSurah":30,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5526,"text":"Cehennemin bekçilerini yalnız meleklerden kılmışızdır. Sayılarını bildirmekle de, ancak inkar edenlerin denenmesini ve kendilerine kitap verilenlerin kesin bilgi edinmesini ve inananların da imanlarının artmasını sağladık. Kendilerine kitap verilenler ve inananlar şüpheye düşmesinler. Kalblerinde hastalık bulunanlar ve inkarcılar: \"Allah bu misalle neyi muradetti?\" desinler. İşte Allah, böylece, dilediğini saptırır, dilediğini de doğru yola eriştirir. Rabbinin ordularını kendisinden başkası bilmez. Bu, insanoğluna bir öğütten ibarettir.","numberInSurah":31,"juz":29,"manzil":7,"page":576,"ruku":510,"hizbQuarter":230,"sajda":false},{"number":5527,"text":"Hayır, hayır öğüt almazlar. Aya, dönüp gelen geceye, ağarmakta olan sabaha and olsun ki, içinizden öne geçmek veya geri kalmak isteyen kimseye, insanoğlunu uyarıcı olarak anlatılan cehennem büyük olaylardan biridir.","numberInSurah":32,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5528,"text":"Hayır, hayır öğüt almazlar. Aya, dönüp gelen geceye, ağarmakta olan sabaha and olsun ki, içinizden öne geçmek veya geri kalmak isteyen kimseye, insanoğlunu uyarıcı olarak anlatılan cehennem büyük olaylardan biridir.","numberInSurah":33,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5529,"text":"Hayır, hayır öğüt almazlar. Aya, dönüp gelen geceye, ağarmakta olan sabaha and olsun ki, içinizden öne geçmek veya geri kalmak isteyen kimseye, insanoğlunu uyarıcı olarak anlatılan cehennem büyük olaylardan biridir.","numberInSurah":34,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5530,"text":"Hayır, hayır öğüt almazlar. Aya, dönüp gelen geceye, ağarmakta olan sabaha and olsun ki, içinizden öne geçmek veya geri kalmak isteyen kimseye, insanoğlunu uyarıcı olarak anlatılan cehennem büyük olaylardan biridir.","numberInSurah":35,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5531,"text":"Hayır, hayır öğüt almazlar. Aya, dönüp gelen geceye, ağarmakta olan sabaha and olsun ki, içinizden öne geçmek veya geri kalmak isteyen kimseye, insanoğlunu uyarıcı olarak anlatılan cehennem büyük olaylardan biridir.","numberInSurah":36,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5532,"text":"Hayır, hayır öğüt almazlar. Aya, dönüp gelen geceye, ağarmakta olan sabaha and olsun ki, içinizden öne geçmek veya geri kalmak isteyen kimseye, insanoğlunu uyarıcı olarak anlatılan cehennem büyük olaylardan biridir.","numberInSurah":37,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5533,"text":"Herkes kazancına bağlı bir rehindir;","numberInSurah":38,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5534,"text":"Ancak, defteri sağdan verilenler böyle değildir; onlar cennettedirler. Suçlulara: \"Sizi bu yakıcı ateşe sürükleyen nedir?\" diye sorarlar.","numberInSurah":39,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5535,"text":"Ancak, defteri sağdan verilenler böyle değildir; onlar cennettedirler. Suçlulara: \"Sizi bu yakıcı ateşe sürükleyen nedir?\" diye sorarlar.","numberInSurah":40,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5536,"text":"Ancak, defteri sağdan verilenler böyle değildir; onlar cennettedirler. Suçlulara: \"Sizi bu yakıcı ateşe sürükleyen nedir?\" diye sorarlar.","numberInSurah":41,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5537,"text":"Ancak, defteri sağdan verilenler böyle değildir; onlar cennettedirler. Suçlulara: \"Sizi bu yakıcı ateşe sürükleyen nedir?\" diye sorarlar.","numberInSurah":42,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5538,"text":"Onlar derler ki: \"Namaz kılanlardan değildik.\"","numberInSurah":43,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5539,"text":"\"Düşkün kimseyi doyurmuyorduk.\"","numberInSurah":44,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5540,"text":"\"Batıla dalanlarla biz de dalardık.\"","numberInSurah":45,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5541,"text":"\"Ceza gününü yalanlardık.\"","numberInSurah":46,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5542,"text":"\"Ölüm bize o haldeyken geldi.\"","numberInSurah":47,"juz":29,"manzil":7,"page":576,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5543,"text":"Artık onlara, şefaatçilerin şefaati fayda vermez.","numberInSurah":48,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5544,"text":"Öyleyken, bunlara ne oluyor ki öğütten yüz çeviriyorlar?","numberInSurah":49,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5545,"text":"Aslandan ürkerek kaçan yabani merkeplere benzerler.","numberInSurah":50,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5546,"text":"Aslandan ürkerek kaçan yabani merkeplere benzerler.","numberInSurah":51,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5547,"text":"Hayır; her biri önüne açılıvermiş sahifeler verilmesini ister.","numberInSurah":52,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5548,"text":"Hayır; daha doğrusu ahiretten korkmazlar.","numberInSurah":53,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5549,"text":"Hayır; şüphesiz bu Kuran bir öğüttür.","numberInSurah":54,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5550,"text":"Dileyen kimse öğüt alır.","numberInSurah":55,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false},{"number":5551,"text":"Allah dilemeksizin öğüt alamazlar. O, kendisinden korkulmaya daha layıktır ve bağışlamaya daha ehildir.","numberInSurah":56,"juz":29,"manzil":7,"page":577,"ruku":511,"hizbQuarter":230,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}