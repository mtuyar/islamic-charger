{"arabic":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Hicr","englishNameTranslation":"The Rock","revelationType":"Meccan","numberOfAyahs":99,"ayahs":[{"number":1803,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الر ۚ تِلْكَ آيَاتُ الْكِتَابِ وَقُرْآنٍ مُبِينٍ","numberInSurah":1,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1804,"text":"رُبَمَا يَوَدُّ الَّذِينَ كَفَرُوا لَوْ كَانُوا مُسْلِمِينَ","numberInSurah":2,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1805,"text":"ذَرْهُمْ يَأْكُلُوا وَيَتَمَتَّعُوا وَيُلْهِهِمُ الْأَمَلُ ۖ فَسَوْفَ يَعْلَمُونَ","numberInSurah":3,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1806,"text":"وَمَا أَهْلَكْنَا مِنْ قَرْيَةٍ إِلَّا وَلَهَا كِتَابٌ مَعْلُومٌ","numberInSurah":4,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1807,"text":"مَا تَسْبِقُ مِنْ أُمَّةٍ أَجَلَهَا وَمَا يَسْتَأْخِرُونَ","numberInSurah":5,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1808,"text":"وَقَالُوا يَا أَيُّهَا الَّذِي نُزِّلَ عَلَيْهِ الذِّكْرُ إِنَّكَ لَمَجْنُونٌ","numberInSurah":6,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1809,"text":"لَوْ مَا تَأْتِينَا بِالْمَلَائِكَةِ إِنْ كُنْتَ مِنَ الصَّادِقِينَ","numberInSurah":7,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1810,"text":"مَا نُنَزِّلُ الْمَلَائِكَةَ إِلَّا بِالْحَقِّ وَمَا كَانُوا إِذًا مُنْظَرِينَ","numberInSurah":8,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1811,"text":"إِنَّا نَحْنُ نَزَّلْنَا الذِّكْرَ وَإِنَّا لَهُ لَحَافِظُونَ","numberInSurah":9,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1812,"text":"وَلَقَدْ أَرْسَلْنَا مِنْ قَبْلِكَ فِي شِيَعِ الْأَوَّلِينَ","numberInSurah":10,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1813,"text":"وَمَا يَأْتِيهِمْ مِنْ رَسُولٍ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ","numberInSurah":11,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1814,"text":"كَذَٰلِكَ نَسْلُكُهُ فِي قُلُوبِ الْمُجْرِمِينَ","numberInSurah":12,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1815,"text":"لَا يُؤْمِنُونَ بِهِ ۖ وَقَدْ خَلَتْ سُنَّةُ الْأَوَّلِينَ","numberInSurah":13,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1816,"text":"وَلَوْ فَتَحْنَا عَلَيْهِمْ بَابًا مِنَ السَّمَاءِ فَظَلُّوا فِيهِ يَعْرُجُونَ","numberInSurah":14,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1817,"text":"لَقَالُوا إِنَّمَا سُكِّرَتْ أَبْصَارُنَا بَلْ نَحْنُ قَوْمٌ مَسْحُورُونَ","numberInSurah":15,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1818,"text":"وَلَقَدْ جَعَلْنَا فِي السَّمَاءِ بُرُوجًا وَزَيَّنَّاهَا لِلنَّاظِرِينَ","numberInSurah":16,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1819,"text":"وَحَفِظْنَاهَا مِنْ كُلِّ شَيْطَانٍ رَجِيمٍ","numberInSurah":17,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1820,"text":"إِلَّا مَنِ اسْتَرَقَ السَّمْعَ فَأَتْبَعَهُ شِهَابٌ مُبِينٌ","numberInSurah":18,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1821,"text":"وَالْأَرْضَ مَدَدْنَاهَا وَأَلْقَيْنَا فِيهَا رَوَاسِيَ وَأَنْبَتْنَا فِيهَا مِنْ كُلِّ شَيْءٍ مَوْزُونٍ","numberInSurah":19,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1822,"text":"وَجَعَلْنَا لَكُمْ فِيهَا مَعَايِشَ وَمَنْ لَسْتُمْ لَهُ بِرَازِقِينَ","numberInSurah":20,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1823,"text":"وَإِنْ مِنْ شَيْءٍ إِلَّا عِنْدَنَا خَزَائِنُهُ وَمَا نُنَزِّلُهُ إِلَّا بِقَدَرٍ مَعْلُومٍ","numberInSurah":21,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1824,"text":"وَأَرْسَلْنَا الرِّيَاحَ لَوَاقِحَ فَأَنْزَلْنَا مِنَ السَّمَاءِ مَاءً فَأَسْقَيْنَاكُمُوهُ وَمَا أَنْتُمْ لَهُ بِخَازِنِينَ","numberInSurah":22,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1825,"text":"وَإِنَّا لَنَحْنُ نُحْيِي وَنُمِيتُ وَنَحْنُ الْوَارِثُونَ","numberInSurah":23,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1826,"text":"وَلَقَدْ عَلِمْنَا الْمُسْتَقْدِمِينَ مِنْكُمْ وَلَقَدْ عَلِمْنَا الْمُسْتَأْخِرِينَ","numberInSurah":24,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1827,"text":"وَإِنَّ رَبَّكَ هُوَ يَحْشُرُهُمْ ۚ إِنَّهُ حَكِيمٌ عَلِيمٌ","numberInSurah":25,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1828,"text":"وَلَقَدْ خَلَقْنَا الْإِنْسَانَ مِنْ صَلْصَالٍ مِنْ حَمَإٍ مَسْنُونٍ","numberInSurah":26,"juz":14,"manzil":3,"page":263,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1829,"text":"وَالْجَانَّ خَلَقْنَاهُ مِنْ قَبْلُ مِنْ نَارِ السَّمُومِ","numberInSurah":27,"juz":14,"manzil":3,"page":263,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1830,"text":"وَإِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي خَالِقٌ بَشَرًا مِنْ صَلْصَالٍ مِنْ حَمَإٍ مَسْنُونٍ","numberInSurah":28,"juz":14,"manzil":3,"page":263,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1831,"text":"فَإِذَا سَوَّيْتُهُ وَنَفَخْتُ فِيهِ مِنْ رُوحِي فَقَعُوا لَهُ سَاجِدِينَ","numberInSurah":29,"juz":14,"manzil":3,"page":263,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1832,"text":"فَسَجَدَ الْمَلَائِكَةُ كُلُّهُمْ أَجْمَعُونَ","numberInSurah":30,"juz":14,"manzil":3,"page":263,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1833,"text":"إِلَّا إِبْلِيسَ أَبَىٰ أَنْ يَكُونَ مَعَ السَّاجِدِينَ","numberInSurah":31,"juz":14,"manzil":3,"page":263,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1834,"text":"قَالَ يَا إِبْلِيسُ مَا لَكَ أَلَّا تَكُونَ مَعَ السَّاجِدِينَ","numberInSurah":32,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1835,"text":"قَالَ لَمْ أَكُنْ لِأَسْجُدَ لِبَشَرٍ خَلَقْتَهُ مِنْ صَلْصَالٍ مِنْ حَمَإٍ مَسْنُونٍ","numberInSurah":33,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1836,"text":"قَالَ فَاخْرُجْ مِنْهَا فَإِنَّكَ رَجِيمٌ","numberInSurah":34,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1837,"text":"وَإِنَّ عَلَيْكَ اللَّعْنَةَ إِلَىٰ يَوْمِ الدِّينِ","numberInSurah":35,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1838,"text":"قَالَ رَبِّ فَأَنْظِرْنِي إِلَىٰ يَوْمِ يُبْعَثُونَ","numberInSurah":36,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1839,"text":"قَالَ فَإِنَّكَ مِنَ الْمُنْظَرِينَ","numberInSurah":37,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1840,"text":"إِلَىٰ يَوْمِ الْوَقْتِ الْمَعْلُومِ","numberInSurah":38,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1841,"text":"قَالَ رَبِّ بِمَا أَغْوَيْتَنِي لَأُزَيِّنَنَّ لَهُمْ فِي الْأَرْضِ وَلَأُغْوِيَنَّهُمْ أَجْمَعِينَ","numberInSurah":39,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1842,"text":"إِلَّا عِبَادَكَ مِنْهُمُ الْمُخْلَصِينَ","numberInSurah":40,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1843,"text":"قَالَ هَٰذَا صِرَاطٌ عَلَيَّ مُسْتَقِيمٌ","numberInSurah":41,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1844,"text":"إِنَّ عِبَادِي لَيْسَ لَكَ عَلَيْهِمْ سُلْطَانٌ إِلَّا مَنِ اتَّبَعَكَ مِنَ الْغَاوِينَ","numberInSurah":42,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1845,"text":"وَإِنَّ جَهَنَّمَ لَمَوْعِدُهُمْ أَجْمَعِينَ","numberInSurah":43,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1846,"text":"لَهَا سَبْعَةُ أَبْوَابٍ لِكُلِّ بَابٍ مِنْهُمْ جُزْءٌ مَقْسُومٌ","numberInSurah":44,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1847,"text":"إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَعُيُونٍ","numberInSurah":45,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":105,"sajda":false},{"number":1848,"text":"ادْخُلُوهَا بِسَلَامٍ آمِنِينَ","numberInSurah":46,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":105,"sajda":false},{"number":1849,"text":"وَنَزَعْنَا مَا فِي صُدُورِهِمْ مِنْ غِلٍّ إِخْوَانًا عَلَىٰ سُرُرٍ مُتَقَابِلِينَ","numberInSurah":47,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":105,"sajda":false},{"number":1850,"text":"لَا يَمَسُّهُمْ فِيهَا نَصَبٌ وَمَا هُمْ مِنْهَا بِمُخْرَجِينَ","numberInSurah":48,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":105,"sajda":false},{"number":1851,"text":"۞ نَبِّئْ عِبَادِي أَنِّي أَنَا الْغَفُورُ الرَّحِيمُ","numberInSurah":49,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":105,"sajda":false},{"number":1852,"text":"وَأَنَّ عَذَابِي هُوَ الْعَذَابُ الْأَلِيمُ","numberInSurah":50,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1853,"text":"وَنَبِّئْهُمْ عَنْ ضَيْفِ إِبْرَاهِيمَ","numberInSurah":51,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1854,"text":"إِذْ دَخَلُوا عَلَيْهِ فَقَالُوا سَلَامًا قَالَ إِنَّا مِنْكُمْ وَجِلُونَ","numberInSurah":52,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1855,"text":"قَالُوا لَا تَوْجَلْ إِنَّا نُبَشِّرُكَ بِغُلَامٍ عَلِيمٍ","numberInSurah":53,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1856,"text":"قَالَ أَبَشَّرْتُمُونِي عَلَىٰ أَنْ مَسَّنِيَ الْكِبَرُ فَبِمَ تُبَشِّرُونَ","numberInSurah":54,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1857,"text":"قَالُوا بَشَّرْنَاكَ بِالْحَقِّ فَلَا تَكُنْ مِنَ الْقَانِطِينَ","numberInSurah":55,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1858,"text":"قَالَ وَمَنْ يَقْنَطُ مِنْ رَحْمَةِ رَبِّهِ إِلَّا الضَّالُّونَ","numberInSurah":56,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1859,"text":"قَالَ فَمَا خَطْبُكُمْ أَيُّهَا الْمُرْسَلُونَ","numberInSurah":57,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1860,"text":"قَالُوا إِنَّا أُرْسِلْنَا إِلَىٰ قَوْمٍ مُجْرِمِينَ","numberInSurah":58,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1861,"text":"إِلَّا آلَ لُوطٍ إِنَّا لَمُنَجُّوهُمْ أَجْمَعِينَ","numberInSurah":59,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1862,"text":"إِلَّا امْرَأَتَهُ قَدَّرْنَا ۙ إِنَّهَا لَمِنَ الْغَابِرِينَ","numberInSurah":60,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1863,"text":"فَلَمَّا جَاءَ آلَ لُوطٍ الْمُرْسَلُونَ","numberInSurah":61,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1864,"text":"قَالَ إِنَّكُمْ قَوْمٌ مُنْكَرُونَ","numberInSurah":62,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1865,"text":"قَالُوا بَلْ جِئْنَاكَ بِمَا كَانُوا فِيهِ يَمْتَرُونَ","numberInSurah":63,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1866,"text":"وَأَتَيْنَاكَ بِالْحَقِّ وَإِنَّا لَصَادِقُونَ","numberInSurah":64,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1867,"text":"فَأَسْرِ بِأَهْلِكَ بِقِطْعٍ مِنَ اللَّيْلِ وَاتَّبِعْ أَدْبَارَهُمْ وَلَا يَلْتَفِتْ مِنْكُمْ أَحَدٌ وَامْضُوا حَيْثُ تُؤْمَرُونَ","numberInSurah":65,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1868,"text":"وَقَضَيْنَا إِلَيْهِ ذَٰلِكَ الْأَمْرَ أَنَّ دَابِرَ هَٰؤُلَاءِ مَقْطُوعٌ مُصْبِحِينَ","numberInSurah":66,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1869,"text":"وَجَاءَ أَهْلُ الْمَدِينَةِ يَسْتَبْشِرُونَ","numberInSurah":67,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1870,"text":"قَالَ إِنَّ هَٰؤُلَاءِ ضَيْفِي فَلَا تَفْضَحُونِ","numberInSurah":68,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1871,"text":"وَاتَّقُوا اللَّهَ وَلَا تُخْزُونِ","numberInSurah":69,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1872,"text":"قَالُوا أَوَلَمْ نَنْهَكَ عَنِ الْعَالَمِينَ","numberInSurah":70,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1873,"text":"قَالَ هَٰؤُلَاءِ بَنَاتِي إِنْ كُنْتُمْ فَاعِلِينَ","numberInSurah":71,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1874,"text":"لَعَمْرُكَ إِنَّهُمْ لَفِي سَكْرَتِهِمْ يَعْمَهُونَ","numberInSurah":72,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1875,"text":"فَأَخَذَتْهُمُ الصَّيْحَةُ مُشْرِقِينَ","numberInSurah":73,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1876,"text":"فَجَعَلْنَا عَالِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهِمْ حِجَارَةً مِنْ سِجِّيلٍ","numberInSurah":74,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1877,"text":"إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِلْمُتَوَسِّمِينَ","numberInSurah":75,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1878,"text":"وَإِنَّهَا لَبِسَبِيلٍ مُقِيمٍ","numberInSurah":76,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1879,"text":"إِنَّ فِي ذَٰلِكَ لَآيَةً لِلْمُؤْمِنِينَ","numberInSurah":77,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1880,"text":"وَإِنْ كَانَ أَصْحَابُ الْأَيْكَةِ لَظَالِمِينَ","numberInSurah":78,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1881,"text":"فَانْتَقَمْنَا مِنْهُمْ وَإِنَّهُمَا لَبِإِمَامٍ مُبِينٍ","numberInSurah":79,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1882,"text":"وَلَقَدْ كَذَّبَ أَصْحَابُ الْحِجْرِ الْمُرْسَلِينَ","numberInSurah":80,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1883,"text":"وَآتَيْنَاهُمْ آيَاتِنَا فَكَانُوا عَنْهَا مُعْرِضِينَ","numberInSurah":81,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1884,"text":"وَكَانُوا يَنْحِتُونَ مِنَ الْجِبَالِ بُيُوتًا آمِنِينَ","numberInSurah":82,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1885,"text":"فَأَخَذَتْهُمُ الصَّيْحَةُ مُصْبِحِينَ","numberInSurah":83,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1886,"text":"فَمَا أَغْنَىٰ عَنْهُمْ مَا كَانُوا يَكْسِبُونَ","numberInSurah":84,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1887,"text":"وَمَا خَلَقْنَا السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا إِلَّا بِالْحَقِّ ۗ وَإِنَّ السَّاعَةَ لَآتِيَةٌ ۖ فَاصْفَحِ الصَّفْحَ الْجَمِيلَ","numberInSurah":85,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1888,"text":"إِنَّ رَبَّكَ هُوَ الْخَلَّاقُ الْعَلِيمُ","numberInSurah":86,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1889,"text":"وَلَقَدْ آتَيْنَاكَ سَبْعًا مِنَ الْمَثَانِي وَالْقُرْآنَ الْعَظِيمَ","numberInSurah":87,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1890,"text":"لَا تَمُدَّنَّ عَيْنَيْكَ إِلَىٰ مَا مَتَّعْنَا بِهِ أَزْوَاجًا مِنْهُمْ وَلَا تَحْزَنْ عَلَيْهِمْ وَاخْفِضْ جَنَاحَكَ لِلْمُؤْمِنِينَ","numberInSurah":88,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1891,"text":"وَقُلْ إِنِّي أَنَا النَّذِيرُ الْمُبِينُ","numberInSurah":89,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1892,"text":"كَمَا أَنْزَلْنَا عَلَى الْمُقْتَسِمِينَ","numberInSurah":90,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1893,"text":"الَّذِينَ جَعَلُوا الْقُرْآنَ عِضِينَ","numberInSurah":91,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1894,"text":"فَوَرَبِّكَ لَنَسْأَلَنَّهُمْ أَجْمَعِينَ","numberInSurah":92,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1895,"text":"عَمَّا كَانُوا يَعْمَلُونَ","numberInSurah":93,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1896,"text":"فَاصْدَعْ بِمَا تُؤْمَرُ وَأَعْرِضْ عَنِ الْمُشْرِكِينَ","numberInSurah":94,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1897,"text":"إِنَّا كَفَيْنَاكَ الْمُسْتَهْزِئِينَ","numberInSurah":95,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1898,"text":"الَّذِينَ يَجْعَلُونَ مَعَ اللَّهِ إِلَٰهًا آخَرَ ۚ فَسَوْفَ يَعْلَمُونَ","numberInSurah":96,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1899,"text":"وَلَقَدْ نَعْلَمُ أَنَّكَ يَضِيقُ صَدْرُكَ بِمَا يَقُولُونَ","numberInSurah":97,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1900,"text":"فَسَبِّحْ بِحَمْدِ رَبِّكَ وَكُنْ مِنَ السَّاجِدِينَ","numberInSurah":98,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1901,"text":"وَاعْبُدْ رَبَّكَ حَتَّىٰ يَأْتِيَكَ الْيَقِينُ","numberInSurah":99,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":15,"name":"سُورَةُ الحِجۡرِ","englishName":"Hicr","englishNameTranslation":"The Rock","revelationType":"Meccan","numberOfAyahs":99,"ayahs":[{"number":1803,"text":"Elif, Lam, Ra. Bunlar Kitap'ın ve apaçık olan Kuran'ın ayetleridir.","numberInSurah":1,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1804,"text":"İnkar edenler, keşke müslüman olsaydık temennisinde bulunacaklardır.","numberInSurah":2,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1805,"text":"Bırak onları yesinler, zevk alsınlar; ümit onları avundursun; ilerde öğrenecekler.","numberInSurah":3,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1806,"text":"Yok ettiğimiz herhangi bir kasabanın elbette belli bir yazısı vardır.","numberInSurah":4,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1807,"text":"Hiçbir ümmet kendi süresini öne alamaz, geciktiremez de.","numberInSurah":5,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1808,"text":"Onlar: \"Ey kendisine Kitap indirilen kimse! Sen mutlaka delisin. Doğrulardan isen melekleri bize getirsene\" dediler.","numberInSurah":6,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1809,"text":"Onlar: \"Ey kendisine Kitap indirilen kimse! Sen mutlaka delisin. Doğrulardan isen melekleri bize getirsene\" dediler.","numberInSurah":7,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1810,"text":"Biz melekleri ancak gerekince indiririz. O takdirde de ceza görecekler asla geri bırakılmazlar.","numberInSurah":8,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1811,"text":"Doğrusu Kitap'ı Biz indirdik, onun koruyucusu elbette Biziz.","numberInSurah":9,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1812,"text":"And olsun ki, senden önce çeşitli ümmetlere peygamber göndermiştik.","numberInSurah":10,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1813,"text":"Onlara gelen her peygamberi alaya alıyorlardı.","numberInSurah":11,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1814,"text":"Aynı şekilde biz de Kitap'ı suçluların kalblerine sokarız, ama ona yine de inanmazlar. Oysa kendilerinden öncekilerin uğradıkları meydandadır.","numberInSurah":12,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1815,"text":"Aynı şekilde biz de Kitap'ı suçluların kalblerine sokarız, ama ona yine de inanmazlar. Oysa kendilerinden öncekilerin uğradıkları meydandadır.","numberInSurah":13,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1816,"text":"Onlara gökten bir kapı açsak da, oradan çıkmağa koyulsalar: \"Gözlerimiz döndü, biz herhalde büyülendik\" derler.","numberInSurah":14,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1817,"text":"Onlara gökten bir kapı açsak da, oradan çıkmağa koyulsalar: \"Gözlerimiz döndü, biz herhalde büyülendik\" derler.","numberInSurah":15,"juz":14,"manzil":3,"page":262,"ruku":218,"hizbQuarter":105,"sajda":false},{"number":1818,"text":"And olsun ki, gökte burçlar meydana getirdik, onları bakanlar için donattık.","numberInSurah":16,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1819,"text":"Onları, kovulmuş her şeytandan koruduk.","numberInSurah":17,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1820,"text":"Fakat kulak hırsızlığı yapan olursa, parlak bir ateş onu kovalar.","numberInSurah":18,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1821,"text":"Yeri yaydık, oraya sabit dağlar yerleştirdik, orada her şeyi bir ölçüye göre bitirdik.","numberInSurah":19,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1822,"text":"Orada sizin ve rızık veremeyeceğiniz kimseler için geçimlikler meydana getirdik.","numberInSurah":20,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1823,"text":"Hazinesi Bizim katımızda olmayan hiçbir şey yoktur. Biz onu ancak belli bir ölçüye göre indiririz.","numberInSurah":21,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1824,"text":"Rüzgarları aşılayıcı olarak gönderdik; yukarıdan su indirdik de sizi onunla suladık. Yoksa siz onu toplayamazdınız.","numberInSurah":22,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1825,"text":"Doğrusu dirilten ve öldüren Biziz; hepsinin gerisinde de Biz kalırız.","numberInSurah":23,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1826,"text":"And olsun ki, sizden önce geçenleri biliriz; and olsun ki, geri kalanları da biliriz.","numberInSurah":24,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1827,"text":"Doğrusu Rabbin onları diriltip bir araya getirecektir. Şüphesiz O Hakim'dir, Herşeyi Bilen'dir.","numberInSurah":25,"juz":14,"manzil":3,"page":263,"ruku":219,"hizbQuarter":105,"sajda":false},{"number":1828,"text":"And olsun ki, insanı kuru balçıktan, işlenebilen kara topraktan yarattık.","numberInSurah":26,"juz":14,"manzil":3,"page":263,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1829,"text":"Cinleri de, daha önce, dumansız ateşten yarattık.","numberInSurah":27,"juz":14,"manzil":3,"page":263,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1830,"text":"'Rabbin meleklere: \"Ben, balçıktan, işlenebilen kara topraktan bir insan yaratacağım. Onu yapıp ruhumdan üflediğimde ona secdeye kapanın\" demişti.","numberInSurah":28,"juz":14,"manzil":3,"page":263,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1831,"text":"'Rabbin meleklere: \"Ben, balçıktan, işlenebilen kara topraktan bir insan yaratacağım. Onu yapıp ruhumdan üflediğimde ona secdeye kapanın\" demişti.","numberInSurah":29,"juz":14,"manzil":3,"page":263,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1832,"text":"Bunun üzerine, İblis'in dışında bütün melekler hemen secde ettiler. O, secde edenlerle beraber olmaktan çekindi.","numberInSurah":30,"juz":14,"manzil":3,"page":263,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1833,"text":"Bunun üzerine, İblis'in dışında bütün melekler hemen secde ettiler. O, secde edenlerle beraber olmaktan çekindi.","numberInSurah":31,"juz":14,"manzil":3,"page":263,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1834,"text":"Allah: \"Ey İblis! Secde edenlerle beraber olmaktan seni alıkoyan nedir?\" dedi.","numberInSurah":32,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1835,"text":"O: \"Balçıktan, işlenebilen kara topraktan yarattığın insana secde edemem\" dedi.","numberInSurah":33,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1836,"text":"\"Öyleyse defol oradan, sen artık kovulmuş birisin. Doğrusu hesap gününe kadar lanet sanadır\" dedi.","numberInSurah":34,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1837,"text":"\"Öyleyse defol oradan, sen artık kovulmuş birisin. Doğrusu hesap gününe kadar lanet sanadır\" dedi.","numberInSurah":35,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1838,"text":"\"Rabbim! Beni hiç olmazsa, tekrar dirilecekleri güne kadar ertele\" dedi.","numberInSurah":36,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1839,"text":"Allah: \"Sen, bilinen gün gelene kadar bırakılanlardansın\" dedi.","numberInSurah":37,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1840,"text":"Allah: \"Sen, bilinen gün gelene kadar bırakılanlardansın\" dedi.","numberInSurah":38,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1841,"text":"\"Rabbim! Beni saptırdığın için, and olsun ki yeryüzünde fenalıkları onlara güzel göstereceğim; halis kıldığın kulların bir yana, onların hepsini saptıracağım\" dedi.","numberInSurah":39,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1842,"text":"\"Rabbim! Beni saptırdığın için, and olsun ki yeryüzünde fenalıkları onlara güzel göstereceğim; halis kıldığın kulların bir yana, onların hepsini saptıracağım\" dedi.","numberInSurah":40,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1843,"text":"'Allah şöyle dedi: \"Benim gerekli kıldığım dosdoğru yol budur; kullarımın üzerinde senin bir nüfuzun olamaz. Ancak sana uyan sapıklar bunun dışındadır.\"","numberInSurah":41,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1844,"text":"'Allah şöyle dedi: \"Benim gerekli kıldığım dosdoğru yol budur; kullarımın üzerinde senin bir nüfuzun olamaz. Ancak sana uyan sapıklar bunun dışındadır.\"","numberInSurah":42,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1845,"text":"\"Ve Cehennem onların hepsinin toplanacağı yerdir.\"","numberInSurah":43,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1846,"text":"O cehennemin yedi kapısı olup, her kapıdan onların girecekleri ayrılmış bir kısım vardır.","numberInSurah":44,"juz":14,"manzil":3,"page":264,"ruku":220,"hizbQuarter":105,"sajda":false},{"number":1847,"text":"Allah'a karşı gelmekten sakınanlar ise, cennetlerde, pınar başlarındadırlar.","numberInSurah":45,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":105,"sajda":false},{"number":1848,"text":"\"Oraya güven içinde, esenlikle girin\" denilir.","numberInSurah":46,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":105,"sajda":false},{"number":1849,"text":"Biz onların gönüllerinde olan kini çıkardık, artık onlar sedirler üzerinde karşılıklı oturan kardeşlerdir.","numberInSurah":47,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":105,"sajda":false},{"number":1850,"text":"Onlar orada bir yorgunluk hissetmezler. Oradan çıkarılacak da değillerdir.","numberInSurah":48,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":105,"sajda":false},{"number":1851,"text":"Kullarıma Benim bağışlayan, merhamet eden olduğumu, azabımın can yakıcı bir azap olduğunu haber ver.","numberInSurah":49,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":105,"sajda":false},{"number":1852,"text":"Kullarıma Benim bağışlayan, merhamet eden olduğumu, azabımın can yakıcı bir azap olduğunu haber ver.","numberInSurah":50,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1853,"text":"Onlara İbrahim'in konuklarını da anlat:","numberInSurah":51,"juz":14,"manzil":3,"page":264,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1854,"text":"İbrahim'in yanına girdiklerinde selam vermişlerdi. O: \"Doğrusu biz sizden korkuyoruz\" demişti de: \"Korkma, biz sana, bilgin bir oğlun olacağını müjdelemeye geldik\" demişlerdi.","numberInSurah":52,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1855,"text":"İbrahim'in yanına girdiklerinde selam vermişlerdi. O: \"Doğrusu biz sizden korkuyoruz\" demişti de: \"Korkma, biz sana, bilgin bir oğlun olacağını müjdelemeye geldik\" demişlerdi.","numberInSurah":53,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1856,"text":"\"Ben kocamışken bana müjde mi veriyorsunuz? Neye dayanarak müjdeliyorsunuz?\" deyince:","numberInSurah":54,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1857,"text":"\"Seni gerçekten müjdeliyoruz, umutsuzlardan olma\" demişlerdi.","numberInSurah":55,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1858,"text":"\"Zaten sapıklardan başka kim Rabbinin rahmetinden umudunu keser!\" diyerek sormuştu: \"Ey elçiler! İşiniz nedir?\"","numberInSurah":56,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1859,"text":"\"Zaten sapıklardan başka kim Rabbinin rahmetinden umudunu keser!\" diyerek sormuştu: \"Ey elçiler! İşiniz nedir?\"","numberInSurah":57,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1860,"text":"Şöyle cevap vermişlerdi: \"Biz şüphesiz suçlu bir millete gönderildik. Lut'un ailesi bunun dışındadır. Karısı hariç hepsini kurtaracağız. Karısının geride kalanlardan olmasını gerekli bulduk.\"","numberInSurah":58,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1861,"text":"Şöyle cevap vermişlerdi: \"Biz şüphesiz suçlu bir millete gönderildik. Lut'un ailesi bunun dışındadır. Karısı hariç hepsini kurtaracağız. Karısının geride kalanlardan olmasını gerekli bulduk.\"","numberInSurah":59,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1862,"text":"Şöyle cevap vermişlerdi: \"Biz şüphesiz suçlu bir millete gönderildik. Lut'un ailesi bunun dışındadır. Karısı hariç hepsini kurtaracağız. Karısının geride kalanlardan olmasını gerekli bulduk.\"","numberInSurah":60,"juz":14,"manzil":3,"page":265,"ruku":221,"hizbQuarter":106,"sajda":false},{"number":1863,"text":"Elçiler Lut'un ailesine gelince, Lut: \"Doğrusu siz tanınmayan kimselersiniz\" dedi.","numberInSurah":61,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1864,"text":"Elçiler Lut'un ailesine gelince, Lut: \"Doğrusu siz tanınmayan kimselersiniz\" dedi.","numberInSurah":62,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1865,"text":"\"Biz sana sadece şüphe edip durdukları azabı getirdik. Sana gerçekle geldik. Şüphesiz biz doğru söyleyenleriz. Artık, geceleyin bir ara, aileni yola çıkar, sen de arkalarından git; hiçbiriniz arkaya bakmasın; emrolunduğunuz yere doğru yürüyün\" dediler.","numberInSurah":63,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1866,"text":"\"Biz sana sadece şüphe edip durdukları azabı getirdik. Sana gerçekle geldik. Şüphesiz biz doğru söyleyenleriz. Artık, geceleyin bir ara, aileni yola çıkar, sen de arkalarından git; hiçbiriniz arkaya bakmasın; emrolunduğunuz yere doğru yürüyün\" dediler.","numberInSurah":64,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1867,"text":"\"Biz sana sadece şüphe edip durdukları azabı getirdik. Sana gerçekle geldik. Şüphesiz biz doğru söyleyenleriz. Artık, geceleyin bir ara, aileni yola çıkar, sen de arkalarından git; hiçbiriniz arkaya bakmasın; emrolunduğunuz yere doğru yürüyün\" dediler.","numberInSurah":65,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1868,"text":"Böylece Lut'a bunların sonlarının kesilmiş olarak sabahlıyacaklarını bildirdik.","numberInSurah":66,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1869,"text":"Şehir halkı, sevinerek geldiler.","numberInSurah":67,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1870,"text":"Lut: \"Bunlar benim konuklarımdır, onlara karşı beni rüsvay etmeyin, Allah'tan korkun, beni utandırmayın\" dedi.","numberInSurah":68,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1871,"text":"Lut: \"Bunlar benim konuklarımdır, onlara karşı beni rüsvay etmeyin, Allah'tan korkun, beni utandırmayın\" dedi.","numberInSurah":69,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1872,"text":"\"Biz sana kimseyi misafir kabul etmeyi yasak etmemiş miydik?\" dediler.","numberInSurah":70,"juz":14,"manzil":3,"page":265,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1873,"text":"Lut: \"Alacaksanız, işte benim kızlarım\" dedi.","numberInSurah":71,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1874,"text":"Senin hayatına and olsun ki, onlar sarhoşlukları içinde bocalayıp duruyorlardı.","numberInSurah":72,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1875,"text":"Tanyeri ağarırken, çığlık onları yakalayıverdi.","numberInSurah":73,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1876,"text":"Memleketlerini alt üst ettik, üzerlerine sert taş yağdırdık.","numberInSurah":74,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1877,"text":"Bunda, görebilen insanlar için ibretler vardır.","numberInSurah":75,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1878,"text":"O şehrin kalıntıları işlek yollar üzerinde hala durmaktadır.","numberInSurah":76,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1879,"text":"Bunda inananlar için ibret vardır.","numberInSurah":77,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1880,"text":"Eykeliler de, şüphesiz zalim kimselerdi.","numberInSurah":78,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1881,"text":"Bunun için onlardan da öç aldık. Hala her iki memleket de işlek bir yol üzerindedirler.","numberInSurah":79,"juz":14,"manzil":3,"page":266,"ruku":222,"hizbQuarter":106,"sajda":false},{"number":1882,"text":"And olsun ki, Hicr halkı peygamberi yalanlamışlardı.","numberInSurah":80,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1883,"text":"Onlara ayetlerimizi verdiğimiz halde, yüz çevirmişlerdi.","numberInSurah":81,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1884,"text":"Dağlarda, güven içinde olarak evler yontuyorlardı.","numberInSurah":82,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1885,"text":"Sabaha karşı çığlık onları yakalayıverdi.","numberInSurah":83,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1886,"text":"Yaptıkları kendilerine bir fayda sağlamadı.","numberInSurah":84,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1887,"text":"Biz, gökleri, yeri ve her ikisi arasında bulunanları gereğince yarattık. Kıyamet günü şüphesiz gelecektir. O halde yumuşak ve iyi davran.","numberInSurah":85,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1888,"text":"Doğrusu yaratan ve bilen ancak Rabbindir.","numberInSurah":86,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1889,"text":"And olsun ki, sana daima tekrarlanan yedi ayetli Fatiha'yı ve Kuran-ı Azim'i verdik.","numberInSurah":87,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1890,"text":"Kafirler içinde bazı kimselere verdiğimiz kat kat servete gözünü dikme, onlara üzülme; inananları kanatların altına al.","numberInSurah":88,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1891,"text":"De ki: \"Doğrusu ben apaçık bir uyarıcıyım.\"","numberInSurah":89,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1892,"text":"Kuran'ı işlerine geldiği gibi bölenlere de, kendi Kitablarının bir kısmına inanıp bir kısmını kabul etmeyen yahudi ve hıristiyanlara da nitekim Kitap indirmiştik; Rabbine and olsun ki hepsini, yaptıklarından sorumlu tutacağız.","numberInSurah":90,"juz":14,"manzil":3,"page":266,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1893,"text":"Kuran'ı işlerine geldiği gibi bölenlere de, kendi Kitablarının bir kısmına inanıp bir kısmını kabul etmeyen yahudi ve hıristiyanlara da nitekim Kitap indirmiştik; Rabbine and olsun ki hepsini, yaptıklarından sorumlu tutacağız.","numberInSurah":91,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1894,"text":"Kuran'ı işlerine geldiği gibi bölenlere de, kendi Kitablarının bir kısmına inanıp bir kısmını kabul etmeyen yahudi ve hıristiyanlara da nitekim Kitap indirmiştik; Rabbine and olsun ki hepsini, yaptıklarından sorumlu tutacağız.","numberInSurah":92,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1895,"text":"Kuran'ı işlerine geldiği gibi bölenlere de, kendi Kitablarının bir kısmına inanıp bir kısmını kabul etmeyen yahudi ve hıristiyanlara da nitekim Kitap indirmiştik; Rabbine and olsun ki hepsini, yaptıklarından sorumlu tutacağız.","numberInSurah":93,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1896,"text":"Artık buyrulanı açıkça ortaya koy, puta tapanlara aldırış etme.","numberInSurah":94,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1897,"text":"Allah'la beraber başka bir tanrının bulunduğunu kabul eden alaycılara karşı şüphesiz Biz sana kafiyiz. Yakında ne olduğunu öğreneceklerdir.","numberInSurah":95,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1898,"text":"Allah'la beraber başka bir tanrının bulunduğunu kabul eden alaycılara karşı şüphesiz Biz sana kafiyiz. Yakında ne olduğunu öğreneceklerdir.","numberInSurah":96,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1899,"text":"And olsun ki, söyledikleri şeylerden senin gönlünün daraldığını biliyoruz.","numberInSurah":97,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1900,"text":"Rabbini hamd ile an, secde edenlerden ol ve ölünceye kadar Rabbine kulluk et.","numberInSurah":98,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false},{"number":1901,"text":"Rabbini hamd ile an, secde edenlerden ol ve ölünceye kadar Rabbine kulluk et.","numberInSurah":99,"juz":14,"manzil":3,"page":267,"ruku":223,"hizbQuarter":106,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}