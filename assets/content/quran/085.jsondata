{"arabic":{"number":85,"name":"سُورَةُ البُرُوجِ","englishName":"Burûc","englishNameTranslation":"The Constellations","revelationType":"Meccan","numberOfAyahs":22,"ayahs":[{"number":5910,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالسَّمَاءِ ذَاتِ الْبُرُوجِ","numberInSurah":1,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5911,"text":"وَالْيَوْمِ الْمَوْعُودِ","numberInSurah":2,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5912,"text":"وَشَاهِدٍ وَمَشْهُودٍ","numberInSurah":3,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5913,"text":"قُتِلَ أَصْحَابُ الْأُخْدُودِ","numberInSurah":4,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5914,"text":"النَّارِ ذَاتِ الْوَقُودِ","numberInSurah":5,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5915,"text":"إِذْ هُمْ عَلَيْهَا قُعُودٌ","numberInSurah":6,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5916,"text":"وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِالْمُؤْمِنِينَ شُهُودٌ","numberInSurah":7,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5917,"text":"وَمَا نَقَمُوا مِنْهُمْ إِلَّا أَنْ يُؤْمِنُوا بِاللَّهِ الْعَزِيزِ الْحَمِيدِ","numberInSurah":8,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5918,"text":"الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ۚ وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ شَهِيدٌ","numberInSurah":9,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5919,"text":"إِنَّ الَّذِينَ فَتَنُوا الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ثُمَّ لَمْ يَتُوبُوا فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ الْحَرِيقِ","numberInSurah":10,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5920,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ ۚ ذَٰلِكَ الْفَوْزُ الْكَبِيرُ","numberInSurah":11,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5921,"text":"إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ","numberInSurah":12,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5922,"text":"إِنَّهُ هُوَ يُبْدِئُ وَيُعِيدُ","numberInSurah":13,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5923,"text":"وَهُوَ الْغَفُورُ الْوَدُودُ","numberInSurah":14,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5924,"text":"ذُو الْعَرْشِ الْمَجِيدُ","numberInSurah":15,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5925,"text":"فَعَّالٌ لِمَا يُرِيدُ","numberInSurah":16,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5926,"text":"هَلْ أَتَاكَ حَدِيثُ الْجُنُودِ","numberInSurah":17,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5927,"text":"فِرْعَوْنَ وَثَمُودَ","numberInSurah":18,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5928,"text":"بَلِ الَّذِينَ كَفَرُوا فِي تَكْذِيبٍ","numberInSurah":19,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5929,"text":"وَاللَّهُ مِنْ وَرَائِهِمْ مُحِيطٌ","numberInSurah":20,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5930,"text":"بَلْ هُوَ قُرْآنٌ مَجِيدٌ","numberInSurah":21,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5931,"text":"فِي لَوْحٍ مَحْفُوظٍ","numberInSurah":22,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":85,"name":"سُورَةُ البُرُوجِ","englishName":"Burûc","englishNameTranslation":"The Constellations","revelationType":"Meccan","numberOfAyahs":22,"ayahs":[{"number":5910,"text":"İçinde burçları bulunan göğe and olsun;","numberInSurah":1,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5911,"text":"Söz verilen kıyamet gününe and olsun;","numberInSurah":2,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5912,"text":"Şahitlik edene ve edilene and olsun ki, insanlar öldükten sonra diriltileceklerdir.","numberInSurah":3,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5913,"text":"Hazırladıkları hendekleri, tutuşturulmuş ateşle doldurarak onun çevresinde oturup, inanmış kimselere dinlerinden dönmeleri için yaptıkları işkenceleri seyredenler kahrolmuştur!","numberInSurah":4,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5914,"text":"Hazırladıkları hendekleri, tutuşturulmuş ateşle doldurarak onun çevresinde oturup, inanmış kimselere dinlerinden dönmeleri için yaptıkları işkenceleri seyredenler kahrolmuştur!","numberInSurah":5,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5915,"text":"Hazırladıkları hendekleri, tutuşturulmuş ateşle doldurarak onun çevresinde oturup, inanmış kimselere dinlerinden dönmeleri için yaptıkları işkenceleri seyredenler kahrolmuştur!","numberInSurah":6,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5916,"text":"Hazırladıkları hendekleri, tutuşturulmuş ateşle doldurarak onun çevresinde oturup, inanmış kimselere dinlerinden dönmeleri için yaptıkları işkenceleri seyredenler kahrolmuştur!","numberInSurah":7,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5917,"text":"Bu inkarcıların, inananlara kızmaları; onların sadece, göklerin ve yerin hükümranlığı kendisinin bulunan ve övülmeğe layık ve güçlü olan Allah'a inanmış olmalarındandı. Allah her şeye şahiddir.","numberInSurah":8,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5918,"text":"Bu inkarcıların, inananlara kızmaları; onların sadece, göklerin ve yerin hükümranlığı kendisinin bulunan ve övülmeğe layık ve güçlü olan Allah'a inanmış olmalarındandı. Allah her şeye şahiddir.","numberInSurah":9,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5919,"text":"Ama inanmış erkek ve kadınlara işkence ederek onları dinlerinden çevirmeğe uğraşanlar, eğer tevbe etmezlerse, onlara cehennem azabı vardır. Yakıcı azap da onlaradır.","numberInSurah":10,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5920,"text":"Şüphesiz inanıp yararlı işler işleyenlere, onlara, içlerinden ırmaklar akan cennetler vardır. Bu, büyük kurtuluştur.","numberInSurah":11,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5921,"text":"Doğrusu Rabbinin yakalaması amansızdır.","numberInSurah":12,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5922,"text":"Önce yaratıp sonra bunu tekrar eden O'dur.","numberInSurah":13,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5923,"text":"Yüce arşın sahibi, çok seven, bağışlayan O'dur.","numberInSurah":14,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5924,"text":"Yüce arşın sahibi, çok seven, bağışlayan O'dur.","numberInSurah":15,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5925,"text":"Her dilediğini mutlaka yapandır.","numberInSurah":16,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5926,"text":"Firavun ve Semud ordularının haberi sana geldi mi?","numberInSurah":17,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5927,"text":"Firavun ve Semud ordularının haberi sana geldi mi?","numberInSurah":18,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5928,"text":"Doğrusu inkar edenler, hep yalanlayagelmişlerdir.","numberInSurah":19,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5929,"text":"Oysa Allah onları ardlarından çevirmiştir.","numberInSurah":20,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5930,"text":"Doğrusu sana vahyedilen bu Kitap, Levhi Mahfuz'da bulunan şanlı bir Kuran'dır.","numberInSurah":21,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false},{"number":5931,"text":"Doğrusu sana vahyedilen bu Kitap, Levhi Mahfuz'da bulunan şanlı bir Kuran'dır.","numberInSurah":22,"juz":30,"manzil":7,"page":590,"ruku":527,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}