{"arabic":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"Tûr","englishNameTranslation":"The Mount","revelationType":"Meccan","numberOfAyahs":49,"ayahs":[{"number":4736,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالطُّورِ","numberInSurah":1,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4737,"text":"وَكِتَابٍ مَسْطُورٍ","numberInSurah":2,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4738,"text":"فِي رَقٍّ مَنْشُورٍ","numberInSurah":3,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4739,"text":"وَالْبَيْتِ الْمَعْمُورِ","numberInSurah":4,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4740,"text":"وَالسَّقْفِ الْمَرْفُوعِ","numberInSurah":5,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4741,"text":"وَالْبَحْرِ الْمَسْجُورِ","numberInSurah":6,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4742,"text":"إِنَّ عَذَابَ رَبِّكَ لَوَاقِعٌ","numberInSurah":7,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4743,"text":"مَا لَهُ مِنْ دَافِعٍ","numberInSurah":8,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4744,"text":"يَوْمَ تَمُورُ السَّمَاءُ مَوْرًا","numberInSurah":9,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4745,"text":"وَتَسِيرُ الْجِبَالُ سَيْرًا","numberInSurah":10,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4746,"text":"فَوَيْلٌ يَوْمَئِذٍ لِلْمُكَذِّبِينَ","numberInSurah":11,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4747,"text":"الَّذِينَ هُمْ فِي خَوْضٍ يَلْعَبُونَ","numberInSurah":12,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4748,"text":"يَوْمَ يُدَعُّونَ إِلَىٰ نَارِ جَهَنَّمَ دَعًّا","numberInSurah":13,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4749,"text":"هَٰذِهِ النَّارُ الَّتِي كُنْتُمْ بِهَا تُكَذِّبُونَ","numberInSurah":14,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4750,"text":"أَفَسِحْرٌ هَٰذَا أَمْ أَنْتُمْ لَا تُبْصِرُونَ","numberInSurah":15,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4751,"text":"اصْلَوْهَا فَاصْبِرُوا أَوْ لَا تَصْبِرُوا سَوَاءٌ عَلَيْكُمْ ۖ إِنَّمَا تُجْزَوْنَ مَا كُنْتُمْ تَعْمَلُونَ","numberInSurah":16,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4752,"text":"إِنَّ الْمُتَّقِينَ فِي جَنَّاتٍ وَنَعِيمٍ","numberInSurah":17,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4753,"text":"فَاكِهِينَ بِمَا آتَاهُمْ رَبُّهُمْ وَوَقَاهُمْ رَبُّهُمْ عَذَابَ الْجَحِيمِ","numberInSurah":18,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4754,"text":"كُلُوا وَاشْرَبُوا هَنِيئًا بِمَا كُنْتُمْ تَعْمَلُونَ","numberInSurah":19,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4755,"text":"مُتَّكِئِينَ عَلَىٰ سُرُرٍ مَصْفُوفَةٍ ۖ وَزَوَّجْنَاهُمْ بِحُورٍ عِينٍ","numberInSurah":20,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4756,"text":"وَالَّذِينَ آمَنُوا وَاتَّبَعَتْهُمْ ذُرِّيَّتُهُمْ بِإِيمَانٍ أَلْحَقْنَا بِهِمْ ذُرِّيَّتَهُمْ وَمَا أَلَتْنَاهُمْ مِنْ عَمَلِهِمْ مِنْ شَيْءٍ ۚ كُلُّ امْرِئٍ بِمَا كَسَبَ رَهِينٌ","numberInSurah":21,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4757,"text":"وَأَمْدَدْنَاهُمْ بِفَاكِهَةٍ وَلَحْمٍ مِمَّا يَشْتَهُونَ","numberInSurah":22,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4758,"text":"يَتَنَازَعُونَ فِيهَا كَأْسًا لَا لَغْوٌ فِيهَا وَلَا تَأْثِيمٌ","numberInSurah":23,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4759,"text":"۞ وَيَطُوفُ عَلَيْهِمْ غِلْمَانٌ لَهُمْ كَأَنَّهُمْ لُؤْلُؤٌ مَكْنُونٌ","numberInSurah":24,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":210,"sajda":false},{"number":4760,"text":"وَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَسَاءَلُونَ","numberInSurah":25,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":210,"sajda":false},{"number":4761,"text":"قَالُوا إِنَّا كُنَّا قَبْلُ فِي أَهْلِنَا مُشْفِقِينَ","numberInSurah":26,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":210,"sajda":false},{"number":4762,"text":"فَمَنَّ اللَّهُ عَلَيْنَا وَوَقَانَا عَذَابَ السَّمُومِ","numberInSurah":27,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":210,"sajda":false},{"number":4763,"text":"إِنَّا كُنَّا مِنْ قَبْلُ نَدْعُوهُ ۖ إِنَّهُ هُوَ الْبَرُّ الرَّحِيمُ","numberInSurah":28,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":210,"sajda":false},{"number":4764,"text":"فَذَكِّرْ فَمَا أَنْتَ بِنِعْمَتِ رَبِّكَ بِكَاهِنٍ وَلَا مَجْنُونٍ","numberInSurah":29,"juz":27,"manzil":7,"page":524,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4765,"text":"أَمْ يَقُولُونَ شَاعِرٌ نَتَرَبَّصُ بِهِ رَيْبَ الْمَنُونِ","numberInSurah":30,"juz":27,"manzil":7,"page":524,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4766,"text":"قُلْ تَرَبَّصُوا فَإِنِّي مَعَكُمْ مِنَ الْمُتَرَبِّصِينَ","numberInSurah":31,"juz":27,"manzil":7,"page":524,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4767,"text":"أَمْ تَأْمُرُهُمْ أَحْلَامُهُمْ بِهَٰذَا ۚ أَمْ هُمْ قَوْمٌ طَاغُونَ","numberInSurah":32,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4768,"text":"أَمْ يَقُولُونَ تَقَوَّلَهُ ۚ بَلْ لَا يُؤْمِنُونَ","numberInSurah":33,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4769,"text":"فَلْيَأْتُوا بِحَدِيثٍ مِثْلِهِ إِنْ كَانُوا صَادِقِينَ","numberInSurah":34,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4770,"text":"أَمْ خُلِقُوا مِنْ غَيْرِ شَيْءٍ أَمْ هُمُ الْخَالِقُونَ","numberInSurah":35,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4771,"text":"أَمْ خَلَقُوا السَّمَاوَاتِ وَالْأَرْضَ ۚ بَلْ لَا يُوقِنُونَ","numberInSurah":36,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4772,"text":"أَمْ عِنْدَهُمْ خَزَائِنُ رَبِّكَ أَمْ هُمُ الْمُصَيْطِرُونَ","numberInSurah":37,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4773,"text":"أَمْ لَهُمْ سُلَّمٌ يَسْتَمِعُونَ فِيهِ ۖ فَلْيَأْتِ مُسْتَمِعُهُمْ بِسُلْطَانٍ مُبِينٍ","numberInSurah":38,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4774,"text":"أَمْ لَهُ الْبَنَاتُ وَلَكُمُ الْبَنُونَ","numberInSurah":39,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4775,"text":"أَمْ تَسْأَلُهُمْ أَجْرًا فَهُمْ مِنْ مَغْرَمٍ مُثْقَلُونَ","numberInSurah":40,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4776,"text":"أَمْ عِنْدَهُمُ الْغَيْبُ فَهُمْ يَكْتُبُونَ","numberInSurah":41,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4777,"text":"أَمْ يُرِيدُونَ كَيْدًا ۖ فَالَّذِينَ كَفَرُوا هُمُ الْمَكِيدُونَ","numberInSurah":42,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4778,"text":"أَمْ لَهُمْ إِلَٰهٌ غَيْرُ اللَّهِ ۚ سُبْحَانَ اللَّهِ عَمَّا يُشْرِكُونَ","numberInSurah":43,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4779,"text":"وَإِنْ يَرَوْا كِسْفًا مِنَ السَّمَاءِ سَاقِطًا يَقُولُوا سَحَابٌ مَرْكُومٌ","numberInSurah":44,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4780,"text":"فَذَرْهُمْ حَتَّىٰ يُلَاقُوا يَوْمَهُمُ الَّذِي فِيهِ يُصْعَقُونَ","numberInSurah":45,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4781,"text":"يَوْمَ لَا يُغْنِي عَنْهُمْ كَيْدُهُمْ شَيْئًا وَلَا هُمْ يُنْصَرُونَ","numberInSurah":46,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4782,"text":"وَإِنَّ لِلَّذِينَ ظَلَمُوا عَذَابًا دُونَ ذَٰلِكَ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ","numberInSurah":47,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4783,"text":"وَاصْبِرْ لِحُكْمِ رَبِّكَ فَإِنَّكَ بِأَعْيُنِنَا ۖ وَسَبِّحْ بِحَمْدِ رَبِّكَ حِينَ تَقُومُ","numberInSurah":48,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4784,"text":"وَمِنَ اللَّيْلِ فَسَبِّحْهُ وَإِدْبَارَ النُّجُومِ","numberInSurah":49,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":52,"name":"سُورَةُ الطُّورِ","englishName":"Tûr","englishNameTranslation":"The Mount","revelationType":"Meccan","numberOfAyahs":49,"ayahs":[{"number":4736,"text":"Tura, yayılmış ince deri üzerine satır satır dizilmiş Kitap'a, mamur bir ev olan Kabe'ye, yükseltilmiş tavan gibi göğe, kaynayacak denize and olsun ki, Rabbinin azabı hiç şüphesiz gelecektir. Onu savacak yoktur.","numberInSurah":1,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4737,"text":"Tura, yayılmış ince deri üzerine satır satır dizilmiş Kitap'a, mamur bir ev olan Kabe'ye, yükseltilmiş tavan gibi göğe, kaynayacak denize and olsun ki, Rabbinin azabı hiç şüphesiz gelecektir. Onu savacak yoktur.","numberInSurah":2,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4738,"text":"Tura, yayılmış ince deri üzerine satır satır dizilmiş Kitap'a, mamur bir ev olan Kabe'ye, yükseltilmiş tavan gibi göğe, kaynayacak denize and olsun ki, Rabbinin azabı hiç şüphesiz gelecektir. Onu savacak yoktur.","numberInSurah":3,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4739,"text":"Tura, yayılmış ince deri üzerine satır satır dizilmiş Kitap'a, mamur bir ev olan Kabe'ye, yükseltilmiş tavan gibi göğe, kaynayacak denize and olsun ki, Rabbinin azabı hiç şüphesiz gelecektir. Onu savacak yoktur.","numberInSurah":4,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4740,"text":"Tura, yayılmış ince deri üzerine satır satır dizilmiş Kitap'a, mamur bir ev olan Kabe'ye, yükseltilmiş tavan gibi göğe, kaynayacak denize and olsun ki, Rabbinin azabı hiç şüphesiz gelecektir. Onu savacak yoktur.","numberInSurah":5,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4741,"text":"Tura, yayılmış ince deri üzerine satır satır dizilmiş Kitap'a, mamur bir ev olan Kabe'ye, yükseltilmiş tavan gibi göğe, kaynayacak denize and olsun ki, Rabbinin azabı hiç şüphesiz gelecektir. Onu savacak yoktur.","numberInSurah":6,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4742,"text":"Tura, yayılmış ince deri üzerine satır satır dizilmiş Kitap'a, mamur bir ev olan Kabe'ye, yükseltilmiş tavan gibi göğe, kaynayacak denize and olsun ki, Rabbinin azabı hiç şüphesiz gelecektir. Onu savacak yoktur.","numberInSurah":7,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4743,"text":"Tura, yayılmış ince deri üzerine satır satır dizilmiş Kitap'a, mamur bir ev olan Kabe'ye, yükseltilmiş tavan gibi göğe, kaynayacak denize and olsun ki, Rabbinin azabı hiç şüphesiz gelecektir. Onu savacak yoktur.","numberInSurah":8,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4744,"text":"Göğün sarsıldıkça sarsılacağı, dağların yürüdükçe yürüyeceği gün; işte o gün, daldıkları yerde eğlenip oyalanarak kıyameti yalanlayanlara yazık olacak!","numberInSurah":9,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4745,"text":"Göğün sarsıldıkça sarsılacağı, dağların yürüdükçe yürüyeceği gün; işte o gün, daldıkları yerde eğlenip oyalanarak kıyameti yalanlayanlara yazık olacak!","numberInSurah":10,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4746,"text":"Göğün sarsıldıkça sarsılacağı, dağların yürüdükçe yürüyeceği gün; işte o gün, daldıkları yerde eğlenip oyalanarak kıyameti yalanlayanlara yazık olacak!","numberInSurah":11,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4747,"text":"Göğün sarsıldıkça sarsılacağı, dağların yürüdükçe yürüyeceği gün; işte o gün, daldıkları yerde eğlenip oyalanarak kıyameti yalanlayanlara yazık olacak!","numberInSurah":12,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4748,"text":"Cehennem ateşine itildikçe itildikleri gün, onlara: \"İşte yalanlayıp durduğunuz ateş budur;","numberInSurah":13,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4749,"text":"Cehennem ateşine itildikçe itildikleri gün, onlara: \"İşte yalanlayıp durduğunuz ateş budur;","numberInSurah":14,"juz":27,"manzil":7,"page":523,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4750,"text":"Bu bir büyü müdür, yoksa hala görmez misiniz? Girin oraya, sabretseniz de sabretmeseniz de artık birdir; ancak işlediklerinizin karşılığını görüyorsunuz\" denir.","numberInSurah":15,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4751,"text":"Bu bir büyü müdür, yoksa hala görmez misiniz? Girin oraya, sabretseniz de sabretmeseniz de artık birdir; ancak işlediklerinizin karşılığını görüyorsunuz\" denir.","numberInSurah":16,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4752,"text":"Allah'a karşı gelmekten sakınanlar, şüphesiz, cennetlerde ve Rablerinin kendilerine verdikleriyle zevk duyarak nimetler içindedirler. Rableri onları cehennem azabından korumuştur.","numberInSurah":17,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4753,"text":"Allah'a karşı gelmekten sakınanlar, şüphesiz, cennetlerde ve Rablerinin kendilerine verdikleriyle zevk duyarak nimetler içindedirler. Rableri onları cehennem azabından korumuştur.","numberInSurah":18,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4754,"text":"Onlara şöyle denir: \"İşlediklerinizden ötürü, dizi dizi tahtlara yaslanarak afiyetle yiyin için.\" Onlara, ceylan gözlü eşler veririz.","numberInSurah":19,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4755,"text":"Onlara şöyle denir: \"İşlediklerinizden ötürü, dizi dizi tahtlara yaslanarak afiyetle yiyin için.\" Onlara, ceylan gözlü eşler veririz.","numberInSurah":20,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4756,"text":"İnanan, soyları da inançta kendilerine uyan kimselere soylarını da katarız. Onların işlediklerinden hiçbir şey eksiltmeyiz. Herkes kazancına bağlıdır.","numberInSurah":21,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4757,"text":"Cennette olanlara diledikleri meyve ve etten bol bol veririz.","numberInSurah":22,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4758,"text":"Orada kadeh tokuştururlar; fakat bunda ne bir saçmalama, ne de bir günaha girme vardır.","numberInSurah":23,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":209,"sajda":false},{"number":4759,"text":"Sedefteki inciler gibi olan gençler yanlarında dolaşırlar.","numberInSurah":24,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":210,"sajda":false},{"number":4760,"text":"Birbirlerine dönüp soruşurlar:","numberInSurah":25,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":210,"sajda":false},{"number":4761,"text":"\"Doğrusu bundan önce ailemizin yanında bile korku içindeydik; Allah lütfedip bizi kavurucu azabdan korudu; doğrusu bundan önce de O'na yalvarıyorduk; şüphesiz O, iyilik yapandır, acıyandır\" derler.","numberInSurah":26,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":210,"sajda":false},{"number":4762,"text":"\"Doğrusu bundan önce ailemizin yanında bile korku içindeydik; Allah lütfedip bizi kavurucu azabdan korudu; doğrusu bundan önce de O'na yalvarıyorduk; şüphesiz O, iyilik yapandır, acıyandır\" derler.","numberInSurah":27,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":210,"sajda":false},{"number":4763,"text":"\"Doğrusu bundan önce ailemizin yanında bile korku içindeydik; Allah lütfedip bizi kavurucu azabdan korudu; doğrusu bundan önce de O'na yalvarıyorduk; şüphesiz O, iyilik yapandır, acıyandır\" derler.","numberInSurah":28,"juz":27,"manzil":7,"page":524,"ruku":458,"hizbQuarter":210,"sajda":false},{"number":4764,"text":"Öğüt ver; Rabbinin nimetiyle sen, ne kahinsin ne de delisin.","numberInSurah":29,"juz":27,"manzil":7,"page":524,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4765,"text":"Yoksa senin için şöyle mi derler: \"Şairdir, zamanın onun aleyhine dönmesini gözlüyoruz.\"","numberInSurah":30,"juz":27,"manzil":7,"page":524,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4766,"text":"De ki: \"Gözleyin, doğrusu ben de sizinle beraber gözlemekteyim.\"","numberInSurah":31,"juz":27,"manzil":7,"page":524,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4767,"text":"Bunu onlara akılları mı buyuruyor? Yoksa onlar azgın bir millet midirler?","numberInSurah":32,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4768,"text":"Yahut: \"Onu kendi uydurdu\" diyorlar öyle mi? Hayır, inanmıyorlar.","numberInSurah":33,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4769,"text":"Eğer iddialarında samimi iseler Kuran'ın benzeri bir söz meydana getirsinler.","numberInSurah":34,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4770,"text":"Onlar, yaratan olmaksızın mı yaratıldılar yoksa yaratanlar kendileri midir?","numberInSurah":35,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4771,"text":"Yoksa gökleri ve yeri kendileri mi yarattılar? Hayır, Allah'a kesin olarak inanmıyorlar.","numberInSurah":36,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4772,"text":"Yoksa Rabbinin hazineleri onların yanında mıdır? Yoksa onlar mı işe hakimdirler?","numberInSurah":37,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4773,"text":"Yoksa, üzerine çıkıp vahiy dinledikleri bir merdivenleri mi var? Öyleyse, dinleyenleri açık bir delil getirsin.","numberInSurah":38,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4774,"text":"Demek kızlar Allah'ın, oğullar sizin öyle mi?","numberInSurah":39,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4775,"text":"Yahut sen onlardan bir ücret istiyorsun da onlar ağır bir borç altında mı kalıyorlar?","numberInSurah":40,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4776,"text":"Veya, görülmeyeni bilmek kendilerine aittir de, onlar mı yazıyorlar?","numberInSurah":41,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4777,"text":"Yoksa bir tuzak mı kurmak istiyorlar? Ama o tuzağa yakalanacak olanlar inkar edenlerdir.","numberInSurah":42,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4778,"text":"Yoksa Allah'tan başka bir tanrıları mı vardır? Allah, onların ortak koşmalarından münezzehtir.","numberInSurah":43,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4779,"text":"Gökten azap olarak düşen bir parça görseler: \"Bulut kümesidir\" derler.","numberInSurah":44,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4780,"text":"Çarpılacakları güne erişmelerine kadar onları bırak.","numberInSurah":45,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4781,"text":"O gün, düzenleri kendilerine bir fayda vermez; yardım da görmezler.","numberInSurah":46,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4782,"text":"Zulmedenlere, şüphesiz, bundan başka da azap vardır; fakat onların çoğu bilmezler.","numberInSurah":47,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4783,"text":"Rabbinin hükmü yerine gelinceye kadar sabret; doğrusu sen, Bizim nezaretimiz altındasın; kalkarken Rabbini överek tesbih et;","numberInSurah":48,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false},{"number":4784,"text":"Geceleyin ve yıldızlar kaybolurken de O'nu tesbih et.","numberInSurah":49,"juz":27,"manzil":7,"page":525,"ruku":459,"hizbQuarter":210,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}