{"arabic":{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Hümeze","englishNameTranslation":"The Traducer","revelationType":"Meccan","numberOfAyahs":9,"ayahs":[{"number":6180,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَيْلٌ لِكُلِّ هُمَزَةٍ لُمَزَةٍ","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6181,"text":"الَّذِي جَمَعَ مَالًا وَعَدَّدَهُ","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6182,"text":"يَحْسَبُ أَنَّ مَالَهُ أَخْلَدَهُ","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6183,"text":"كَلَّا ۖ لَيُنْبَذَنَّ فِي الْحُطَمَةِ","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6184,"text":"وَمَا أَدْرَاكَ مَا الْحُطَمَةُ","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6185,"text":"نَارُ اللَّهِ الْمُوقَدَةُ","numberInSurah":6,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6186,"text":"الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ","numberInSurah":7,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6187,"text":"إِنَّهَا عَلَيْهِمْ مُؤْصَدَةٌ","numberInSurah":8,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6188,"text":"فِي عَمَدٍ مُمَدَّدَةٍ","numberInSurah":9,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":104,"name":"سُورَةُ الهُمَزَةِ","englishName":"Hümeze","englishNameTranslation":"The Traducer","revelationType":"Meccan","numberOfAyahs":9,"ayahs":[{"number":6180,"text":"Mal toplayarak onu tekrar tekrar sayan, diliyle çekiştirip alay eden kimsenin vay haline!","numberInSurah":1,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6181,"text":"Mal toplayarak onu tekrar tekrar sayan, diliyle çekiştirip alay eden kimsenin vay haline!","numberInSurah":2,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6182,"text":"Malının kendisini ölümsüz kılacağını sanır.","numberInSurah":3,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6183,"text":"Hayır; o, and olsun ki, Hutame'ye atılacaktır.","numberInSurah":4,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6184,"text":"Hutame'nin ne olduğunu sen bilir misin?","numberInSurah":5,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6185,"text":"O, yüreklere çökecek olan, Allah'ın tutuşturulmuş ateşidir.","numberInSurah":6,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6186,"text":"O, yüreklere çökecek olan, Allah'ın tutuşturulmuş ateşidir.","numberInSurah":7,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6187,"text":"Onlar, uzun sütunlar arasında, her yönden o ateşle kapatılmışlardır.","numberInSurah":8,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false},{"number":6188,"text":"Onlar, uzun sütunlar arasında, her yönden o ateşle kapatılmışlardır.","numberInSurah":9,"juz":30,"manzil":7,"page":601,"ruku":546,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}