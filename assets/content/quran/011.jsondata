{"arabic":{"number":11,"name":"سُورَةُ هُودٍ","englishName":"Hûd","englishNameTranslation":"Hud","revelationType":"Meccan","numberOfAyahs":123,"ayahs":[{"number":1474,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الر ۚ كِتَابٌ أُحْكِمَتْ آيَاتُهُ ثُمَّ فُصِّلَتْ مِنْ لَدُنْ حَكِيمٍ خَبِيرٍ","numberInSurah":1,"juz":11,"manzil":3,"page":221,"ruku":183,"hizbQuarter":88,"sajda":false},{"number":1475,"text":"أَلَّا تَعْبُدُوا إِلَّا اللَّهَ ۚ إِنَّنِي لَكُمْ مِنْهُ نَذِيرٌ وَبَشِيرٌ","numberInSurah":2,"juz":11,"manzil":3,"page":221,"ruku":183,"hizbQuarter":88,"sajda":false},{"number":1476,"text":"وَأَنِ اسْتَغْفِرُوا رَبَّكُمْ ثُمَّ تُوبُوا إِلَيْهِ يُمَتِّعْكُمْ مَتَاعًا حَسَنًا إِلَىٰ أَجَلٍ مُسَمًّى وَيُؤْتِ كُلَّ ذِي فَضْلٍ فَضْلَهُ ۖ وَإِنْ تَوَلَّوْا فَإِنِّي أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ كَبِيرٍ","numberInSurah":3,"juz":11,"manzil":3,"page":221,"ruku":183,"hizbQuarter":88,"sajda":false},{"number":1477,"text":"إِلَى اللَّهِ مَرْجِعُكُمْ ۖ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":4,"juz":11,"manzil":3,"page":221,"ruku":183,"hizbQuarter":88,"sajda":false},{"number":1478,"text":"أَلَا إِنَّهُمْ يَثْنُونَ صُدُورَهُمْ لِيَسْتَخْفُوا مِنْهُ ۚ أَلَا حِينَ يَسْتَغْشُونَ ثِيَابَهُمْ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ ۚ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","numberInSurah":5,"juz":11,"manzil":3,"page":221,"ruku":183,"hizbQuarter":88,"sajda":false},{"number":1479,"text":"۞ وَمَا مِنْ دَابَّةٍ فِي الْأَرْضِ إِلَّا عَلَى اللَّهِ رِزْقُهَا وَيَعْلَمُ مُسْتَقَرَّهَا وَمُسْتَوْدَعَهَا ۚ كُلٌّ فِي كِتَابٍ مُبِينٍ","numberInSurah":6,"juz":12,"manzil":3,"page":222,"ruku":183,"hizbQuarter":89,"sajda":false},{"number":1480,"text":"وَهُوَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ فِي سِتَّةِ أَيَّامٍ وَكَانَ عَرْشُهُ عَلَى الْمَاءِ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا ۗ وَلَئِنْ قُلْتَ إِنَّكُمْ مَبْعُوثُونَ مِنْ بَعْدِ الْمَوْتِ لَيَقُولَنَّ الَّذِينَ كَفَرُوا إِنْ هَٰذَا إِلَّا سِحْرٌ مُبِينٌ","numberInSurah":7,"juz":12,"manzil":3,"page":222,"ruku":183,"hizbQuarter":89,"sajda":false},{"number":1481,"text":"وَلَئِنْ أَخَّرْنَا عَنْهُمُ الْعَذَابَ إِلَىٰ أُمَّةٍ مَعْدُودَةٍ لَيَقُولُنَّ مَا يَحْبِسُهُ ۗ أَلَا يَوْمَ يَأْتِيهِمْ لَيْسَ مَصْرُوفًا عَنْهُمْ وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ","numberInSurah":8,"juz":12,"manzil":3,"page":222,"ruku":183,"hizbQuarter":89,"sajda":false},{"number":1482,"text":"وَلَئِنْ أَذَقْنَا الْإِنْسَانَ مِنَّا رَحْمَةً ثُمَّ نَزَعْنَاهَا مِنْهُ إِنَّهُ لَيَئُوسٌ كَفُورٌ","numberInSurah":9,"juz":12,"manzil":3,"page":222,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1483,"text":"وَلَئِنْ أَذَقْنَاهُ نَعْمَاءَ بَعْدَ ضَرَّاءَ مَسَّتْهُ لَيَقُولَنَّ ذَهَبَ السَّيِّئَاتُ عَنِّي ۚ إِنَّهُ لَفَرِحٌ فَخُورٌ","numberInSurah":10,"juz":12,"manzil":3,"page":222,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1484,"text":"إِلَّا الَّذِينَ صَبَرُوا وَعَمِلُوا الصَّالِحَاتِ أُولَٰئِكَ لَهُمْ مَغْفِرَةٌ وَأَجْرٌ كَبِيرٌ","numberInSurah":11,"juz":12,"manzil":3,"page":222,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1485,"text":"فَلَعَلَّكَ تَارِكٌ بَعْضَ مَا يُوحَىٰ إِلَيْكَ وَضَائِقٌ بِهِ صَدْرُكَ أَنْ يَقُولُوا لَوْلَا أُنْزِلَ عَلَيْهِ كَنْزٌ أَوْ جَاءَ مَعَهُ مَلَكٌ ۚ إِنَّمَا أَنْتَ نَذِيرٌ ۚ وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ وَكِيلٌ","numberInSurah":12,"juz":12,"manzil":3,"page":222,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1486,"text":"أَمْ يَقُولُونَ افْتَرَاهُ ۖ قُلْ فَأْتُوا بِعَشْرِ سُوَرٍ مِثْلِهِ مُفْتَرَيَاتٍ وَادْعُوا مَنِ اسْتَطَعْتُمْ مِنْ دُونِ اللَّهِ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":13,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1487,"text":"فَإِلَّمْ يَسْتَجِيبُوا لَكُمْ فَاعْلَمُوا أَنَّمَا أُنْزِلَ بِعِلْمِ اللَّهِ وَأَنْ لَا إِلَٰهَ إِلَّا هُوَ ۖ فَهَلْ أَنْتُمْ مُسْلِمُونَ","numberInSurah":14,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1488,"text":"مَنْ كَانَ يُرِيدُ الْحَيَاةَ الدُّنْيَا وَزِينَتَهَا نُوَفِّ إِلَيْهِمْ أَعْمَالَهُمْ فِيهَا وَهُمْ فِيهَا لَا يُبْخَسُونَ","numberInSurah":15,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1489,"text":"أُولَٰئِكَ الَّذِينَ لَيْسَ لَهُمْ فِي الْآخِرَةِ إِلَّا النَّارُ ۖ وَحَبِطَ مَا صَنَعُوا فِيهَا وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ","numberInSurah":16,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1490,"text":"أَفَمَنْ كَانَ عَلَىٰ بَيِّنَةٍ مِنْ رَبِّهِ وَيَتْلُوهُ شَاهِدٌ مِنْهُ وَمِنْ قَبْلِهِ كِتَابُ مُوسَىٰ إِمَامًا وَرَحْمَةً ۚ أُولَٰئِكَ يُؤْمِنُونَ بِهِ ۚ وَمَنْ يَكْفُرْ بِهِ مِنَ الْأَحْزَابِ فَالنَّارُ مَوْعِدُهُ ۚ فَلَا تَكُ فِي مِرْيَةٍ مِنْهُ ۚ إِنَّهُ الْحَقُّ مِنْ رَبِّكَ وَلَٰكِنَّ أَكْثَرَ النَّاسِ لَا يُؤْمِنُونَ","numberInSurah":17,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1491,"text":"وَمَنْ أَظْلَمُ مِمَّنِ افْتَرَىٰ عَلَى اللَّهِ كَذِبًا ۚ أُولَٰئِكَ يُعْرَضُونَ عَلَىٰ رَبِّهِمْ وَيَقُولُ الْأَشْهَادُ هَٰؤُلَاءِ الَّذِينَ كَذَبُوا عَلَىٰ رَبِّهِمْ ۚ أَلَا لَعْنَةُ اللَّهِ عَلَى الظَّالِمِينَ","numberInSurah":18,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1492,"text":"الَّذِينَ يَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَيَبْغُونَهَا عِوَجًا وَهُمْ بِالْآخِرَةِ هُمْ كَافِرُونَ","numberInSurah":19,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1493,"text":"أُولَٰئِكَ لَمْ يَكُونُوا مُعْجِزِينَ فِي الْأَرْضِ وَمَا كَانَ لَهُمْ مِنْ دُونِ اللَّهِ مِنْ أَوْلِيَاءَ ۘ يُضَاعَفُ لَهُمُ الْعَذَابُ ۚ مَا كَانُوا يَسْتَطِيعُونَ السَّمْعَ وَمَا كَانُوا يُبْصِرُونَ","numberInSurah":20,"juz":12,"manzil":3,"page":224,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1494,"text":"أُولَٰئِكَ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ وَضَلَّ عَنْهُمْ مَا كَانُوا يَفْتَرُونَ","numberInSurah":21,"juz":12,"manzil":3,"page":224,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1495,"text":"لَا جَرَمَ أَنَّهُمْ فِي الْآخِرَةِ هُمُ الْأَخْسَرُونَ","numberInSurah":22,"juz":12,"manzil":3,"page":224,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1496,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَأَخْبَتُوا إِلَىٰ رَبِّهِمْ أُولَٰئِكَ أَصْحَابُ الْجَنَّةِ ۖ هُمْ فِيهَا خَالِدُونَ","numberInSurah":23,"juz":12,"manzil":3,"page":224,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1497,"text":"۞ مَثَلُ الْفَرِيقَيْنِ كَالْأَعْمَىٰ وَالْأَصَمِّ وَالْبَصِيرِ وَالسَّمِيعِ ۚ هَلْ يَسْتَوِيَانِ مَثَلًا ۚ أَفَلَا تَذَكَّرُونَ","numberInSurah":24,"juz":12,"manzil":3,"page":224,"ruku":184,"hizbQuarter":90,"sajda":false},{"number":1498,"text":"وَلَقَدْ أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِهِ إِنِّي لَكُمْ نَذِيرٌ مُبِينٌ","numberInSurah":25,"juz":12,"manzil":3,"page":224,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1499,"text":"أَنْ لَا تَعْبُدُوا إِلَّا اللَّهَ ۖ إِنِّي أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ أَلِيمٍ","numberInSurah":26,"juz":12,"manzil":3,"page":224,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1500,"text":"فَقَالَ الْمَلَأُ الَّذِينَ كَفَرُوا مِنْ قَوْمِهِ مَا نَرَاكَ إِلَّا بَشَرًا مِثْلَنَا وَمَا نَرَاكَ اتَّبَعَكَ إِلَّا الَّذِينَ هُمْ أَرَاذِلُنَا بَادِيَ الرَّأْيِ وَمَا نَرَىٰ لَكُمْ عَلَيْنَا مِنْ فَضْلٍ بَلْ نَظُنُّكُمْ كَاذِبِينَ","numberInSurah":27,"juz":12,"manzil":3,"page":224,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1501,"text":"قَالَ يَا قَوْمِ أَرَأَيْتُمْ إِنْ كُنْتُ عَلَىٰ بَيِّنَةٍ مِنْ رَبِّي وَآتَانِي رَحْمَةً مِنْ عِنْدِهِ فَعُمِّيَتْ عَلَيْكُمْ أَنُلْزِمُكُمُوهَا وَأَنْتُمْ لَهَا كَارِهُونَ","numberInSurah":28,"juz":12,"manzil":3,"page":224,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1502,"text":"وَيَا قَوْمِ لَا أَسْأَلُكُمْ عَلَيْهِ مَالًا ۖ إِنْ أَجْرِيَ إِلَّا عَلَى اللَّهِ ۚ وَمَا أَنَا بِطَارِدِ الَّذِينَ آمَنُوا ۚ إِنَّهُمْ مُلَاقُو رَبِّهِمْ وَلَٰكِنِّي أَرَاكُمْ قَوْمًا تَجْهَلُونَ","numberInSurah":29,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1503,"text":"وَيَا قَوْمِ مَنْ يَنْصُرُنِي مِنَ اللَّهِ إِنْ طَرَدْتُهُمْ ۚ أَفَلَا تَذَكَّرُونَ","numberInSurah":30,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1504,"text":"وَلَا أَقُولُ لَكُمْ عِنْدِي خَزَائِنُ اللَّهِ وَلَا أَعْلَمُ الْغَيْبَ وَلَا أَقُولُ إِنِّي مَلَكٌ وَلَا أَقُولُ لِلَّذِينَ تَزْدَرِي أَعْيُنُكُمْ لَنْ يُؤْتِيَهُمُ اللَّهُ خَيْرًا ۖ اللَّهُ أَعْلَمُ بِمَا فِي أَنْفُسِهِمْ ۖ إِنِّي إِذًا لَمِنَ الظَّالِمِينَ","numberInSurah":31,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1505,"text":"قَالُوا يَا نُوحُ قَدْ جَادَلْتَنَا فَأَكْثَرْتَ جِدَالَنَا فَأْتِنَا بِمَا تَعِدُنَا إِنْ كُنْتَ مِنَ الصَّادِقِينَ","numberInSurah":32,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1506,"text":"قَالَ إِنَّمَا يَأْتِيكُمْ بِهِ اللَّهُ إِنْ شَاءَ وَمَا أَنْتُمْ بِمُعْجِزِينَ","numberInSurah":33,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1507,"text":"وَلَا يَنْفَعُكُمْ نُصْحِي إِنْ أَرَدْتُ أَنْ أَنْصَحَ لَكُمْ إِنْ كَانَ اللَّهُ يُرِيدُ أَنْ يُغْوِيَكُمْ ۚ هُوَ رَبُّكُمْ وَإِلَيْهِ تُرْجَعُونَ","numberInSurah":34,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1508,"text":"أَمْ يَقُولُونَ افْتَرَاهُ ۖ قُلْ إِنِ افْتَرَيْتُهُ فَعَلَيَّ إِجْرَامِي وَأَنَا بَرِيءٌ مِمَّا تُجْرِمُونَ","numberInSurah":35,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1509,"text":"وَأُوحِيَ إِلَىٰ نُوحٍ أَنَّهُ لَنْ يُؤْمِنَ مِنْ قَوْمِكَ إِلَّا مَنْ قَدْ آمَنَ فَلَا تَبْتَئِسْ بِمَا كَانُوا يَفْعَلُونَ","numberInSurah":36,"juz":12,"manzil":3,"page":225,"ruku":186,"hizbQuarter":90,"sajda":false},{"number":1510,"text":"وَاصْنَعِ الْفُلْكَ بِأَعْيُنِنَا وَوَحْيِنَا وَلَا تُخَاطِبْنِي فِي الَّذِينَ ظَلَمُوا ۚ إِنَّهُمْ مُغْرَقُونَ","numberInSurah":37,"juz":12,"manzil":3,"page":225,"ruku":186,"hizbQuarter":90,"sajda":false},{"number":1511,"text":"وَيَصْنَعُ الْفُلْكَ وَكُلَّمَا مَرَّ عَلَيْهِ مَلَأٌ مِنْ قَوْمِهِ سَخِرُوا مِنْهُ ۚ قَالَ إِنْ تَسْخَرُوا مِنَّا فَإِنَّا نَسْخَرُ مِنْكُمْ كَمَا تَسْخَرُونَ","numberInSurah":38,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":90,"sajda":false},{"number":1512,"text":"فَسَوْفَ تَعْلَمُونَ مَنْ يَأْتِيهِ عَذَابٌ يُخْزِيهِ وَيَحِلُّ عَلَيْهِ عَذَابٌ مُقِيمٌ","numberInSurah":39,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":90,"sajda":false},{"number":1513,"text":"حَتَّىٰ إِذَا جَاءَ أَمْرُنَا وَفَارَ التَّنُّورُ قُلْنَا احْمِلْ فِيهَا مِنْ كُلٍّ زَوْجَيْنِ اثْنَيْنِ وَأَهْلَكَ إِلَّا مَنْ سَبَقَ عَلَيْهِ الْقَوْلُ وَمَنْ آمَنَ ۚ وَمَا آمَنَ مَعَهُ إِلَّا قَلِيلٌ","numberInSurah":40,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":90,"sajda":false},{"number":1514,"text":"۞ وَقَالَ ارْكَبُوا فِيهَا بِسْمِ اللَّهِ مَجْرَاهَا وَمُرْسَاهَا ۚ إِنَّ رَبِّي لَغَفُورٌ رَحِيمٌ","numberInSurah":41,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1515,"text":"وَهِيَ تَجْرِي بِهِمْ فِي مَوْجٍ كَالْجِبَالِ وَنَادَىٰ نُوحٌ ابْنَهُ وَكَانَ فِي مَعْزِلٍ يَا بُنَيَّ ارْكَبْ مَعَنَا وَلَا تَكُنْ مَعَ الْكَافِرِينَ","numberInSurah":42,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1516,"text":"قَالَ سَآوِي إِلَىٰ جَبَلٍ يَعْصِمُنِي مِنَ الْمَاءِ ۚ قَالَ لَا عَاصِمَ الْيَوْمَ مِنْ أَمْرِ اللَّهِ إِلَّا مَنْ رَحِمَ ۚ وَحَالَ بَيْنَهُمَا الْمَوْجُ فَكَانَ مِنَ الْمُغْرَقِينَ","numberInSurah":43,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1517,"text":"وَقِيلَ يَا أَرْضُ ابْلَعِي مَاءَكِ وَيَا سَمَاءُ أَقْلِعِي وَغِيضَ الْمَاءُ وَقُضِيَ الْأَمْرُ وَاسْتَوَتْ عَلَى الْجُودِيِّ ۖ وَقِيلَ بُعْدًا لِلْقَوْمِ الظَّالِمِينَ","numberInSurah":44,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1518,"text":"وَنَادَىٰ نُوحٌ رَبَّهُ فَقَالَ رَبِّ إِنَّ ابْنِي مِنْ أَهْلِي وَإِنَّ وَعْدَكَ الْحَقُّ وَأَنْتَ أَحْكَمُ الْحَاكِمِينَ","numberInSurah":45,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1519,"text":"قَالَ يَا نُوحُ إِنَّهُ لَيْسَ مِنْ أَهْلِكَ ۖ إِنَّهُ عَمَلٌ غَيْرُ صَالِحٍ ۖ فَلَا تَسْأَلْنِ مَا لَيْسَ لَكَ بِهِ عِلْمٌ ۖ إِنِّي أَعِظُكَ أَنْ تَكُونَ مِنَ الْجَاهِلِينَ","numberInSurah":46,"juz":12,"manzil":3,"page":227,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1520,"text":"قَالَ رَبِّ إِنِّي أَعُوذُ بِكَ أَنْ أَسْأَلَكَ مَا لَيْسَ لِي بِهِ عِلْمٌ ۖ وَإِلَّا تَغْفِرْ لِي وَتَرْحَمْنِي أَكُنْ مِنَ الْخَاسِرِينَ","numberInSurah":47,"juz":12,"manzil":3,"page":227,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1521,"text":"قِيلَ يَا نُوحُ اهْبِطْ بِسَلَامٍ مِنَّا وَبَرَكَاتٍ عَلَيْكَ وَعَلَىٰ أُمَمٍ مِمَّنْ مَعَكَ ۚ وَأُمَمٌ سَنُمَتِّعُهُمْ ثُمَّ يَمَسُّهُمْ مِنَّا عَذَابٌ أَلِيمٌ","numberInSurah":48,"juz":12,"manzil":3,"page":227,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1522,"text":"تِلْكَ مِنْ أَنْبَاءِ الْغَيْبِ نُوحِيهَا إِلَيْكَ ۖ مَا كُنْتَ تَعْلَمُهَا أَنْتَ وَلَا قَوْمُكَ مِنْ قَبْلِ هَٰذَا ۖ فَاصْبِرْ ۖ إِنَّ الْعَاقِبَةَ لِلْمُتَّقِينَ","numberInSurah":49,"juz":12,"manzil":3,"page":227,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1523,"text":"وَإِلَىٰ عَادٍ أَخَاهُمْ هُودًا ۚ قَالَ يَا قَوْمِ اعْبُدُوا اللَّهَ مَا لَكُمْ مِنْ إِلَٰهٍ غَيْرُهُ ۖ إِنْ أَنْتُمْ إِلَّا مُفْتَرُونَ","numberInSurah":50,"juz":12,"manzil":3,"page":227,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1524,"text":"يَا قَوْمِ لَا أَسْأَلُكُمْ عَلَيْهِ أَجْرًا ۖ إِنْ أَجْرِيَ إِلَّا عَلَى الَّذِي فَطَرَنِي ۚ أَفَلَا تَعْقِلُونَ","numberInSurah":51,"juz":12,"manzil":3,"page":227,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1525,"text":"وَيَا قَوْمِ اسْتَغْفِرُوا رَبَّكُمْ ثُمَّ تُوبُوا إِلَيْهِ يُرْسِلِ السَّمَاءَ عَلَيْكُمْ مِدْرَارًا وَيَزِدْكُمْ قُوَّةً إِلَىٰ قُوَّتِكُمْ وَلَا تَتَوَلَّوْا مُجْرِمِينَ","numberInSurah":52,"juz":12,"manzil":3,"page":227,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1526,"text":"قَالُوا يَا هُودُ مَا جِئْتَنَا بِبَيِّنَةٍ وَمَا نَحْنُ بِتَارِكِي آلِهَتِنَا عَنْ قَوْلِكَ وَمَا نَحْنُ لَكَ بِمُؤْمِنِينَ","numberInSurah":53,"juz":12,"manzil":3,"page":227,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1527,"text":"إِنْ نَقُولُ إِلَّا اعْتَرَاكَ بَعْضُ آلِهَتِنَا بِسُوءٍ ۗ قَالَ إِنِّي أُشْهِدُ اللَّهَ وَاشْهَدُوا أَنِّي بَرِيءٌ مِمَّا تُشْرِكُونَ","numberInSurah":54,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1528,"text":"مِنْ دُونِهِ ۖ فَكِيدُونِي جَمِيعًا ثُمَّ لَا تُنْظِرُونِ","numberInSurah":55,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1529,"text":"إِنِّي تَوَكَّلْتُ عَلَى اللَّهِ رَبِّي وَرَبِّكُمْ ۚ مَا مِنْ دَابَّةٍ إِلَّا هُوَ آخِذٌ بِنَاصِيَتِهَا ۚ إِنَّ رَبِّي عَلَىٰ صِرَاطٍ مُسْتَقِيمٍ","numberInSurah":56,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1530,"text":"فَإِنْ تَوَلَّوْا فَقَدْ أَبْلَغْتُكُمْ مَا أُرْسِلْتُ بِهِ إِلَيْكُمْ ۚ وَيَسْتَخْلِفُ رَبِّي قَوْمًا غَيْرَكُمْ وَلَا تَضُرُّونَهُ شَيْئًا ۚ إِنَّ رَبِّي عَلَىٰ كُلِّ شَيْءٍ حَفِيظٌ","numberInSurah":57,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1531,"text":"وَلَمَّا جَاءَ أَمْرُنَا نَجَّيْنَا هُودًا وَالَّذِينَ آمَنُوا مَعَهُ بِرَحْمَةٍ مِنَّا وَنَجَّيْنَاهُمْ مِنْ عَذَابٍ غَلِيظٍ","numberInSurah":58,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1532,"text":"وَتِلْكَ عَادٌ ۖ جَحَدُوا بِآيَاتِ رَبِّهِمْ وَعَصَوْا رُسُلَهُ وَاتَّبَعُوا أَمْرَ كُلِّ جَبَّارٍ عَنِيدٍ","numberInSurah":59,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1533,"text":"وَأُتْبِعُوا فِي هَٰذِهِ الدُّنْيَا لَعْنَةً وَيَوْمَ الْقِيَامَةِ ۗ أَلَا إِنَّ عَادًا كَفَرُوا رَبَّهُمْ ۗ أَلَا بُعْدًا لِعَادٍ قَوْمِ هُودٍ","numberInSurah":60,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1534,"text":"۞ وَإِلَىٰ ثَمُودَ أَخَاهُمْ صَالِحًا ۚ قَالَ يَا قَوْمِ اعْبُدُوا اللَّهَ مَا لَكُمْ مِنْ إِلَٰهٍ غَيْرُهُ ۖ هُوَ أَنْشَأَكُمْ مِنَ الْأَرْضِ وَاسْتَعْمَرَكُمْ فِيهَا فَاسْتَغْفِرُوهُ ثُمَّ تُوبُوا إِلَيْهِ ۚ إِنَّ رَبِّي قَرِيبٌ مُجِيبٌ","numberInSurah":61,"juz":12,"manzil":3,"page":228,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1535,"text":"قَالُوا يَا صَالِحُ قَدْ كُنْتَ فِينَا مَرْجُوًّا قَبْلَ هَٰذَا ۖ أَتَنْهَانَا أَنْ نَعْبُدَ مَا يَعْبُدُ آبَاؤُنَا وَإِنَّنَا لَفِي شَكٍّ مِمَّا تَدْعُونَا إِلَيْهِ مُرِيبٍ","numberInSurah":62,"juz":12,"manzil":3,"page":228,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1536,"text":"قَالَ يَا قَوْمِ أَرَأَيْتُمْ إِنْ كُنْتُ عَلَىٰ بَيِّنَةٍ مِنْ رَبِّي وَآتَانِي مِنْهُ رَحْمَةً فَمَنْ يَنْصُرُنِي مِنَ اللَّهِ إِنْ عَصَيْتُهُ ۖ فَمَا تَزِيدُونَنِي غَيْرَ تَخْسِيرٍ","numberInSurah":63,"juz":12,"manzil":3,"page":229,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1537,"text":"وَيَا قَوْمِ هَٰذِهِ نَاقَةُ اللَّهِ لَكُمْ آيَةً فَذَرُوهَا تَأْكُلْ فِي أَرْضِ اللَّهِ وَلَا تَمَسُّوهَا بِسُوءٍ فَيَأْخُذَكُمْ عَذَابٌ قَرِيبٌ","numberInSurah":64,"juz":12,"manzil":3,"page":229,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1538,"text":"فَعَقَرُوهَا فَقَالَ تَمَتَّعُوا فِي دَارِكُمْ ثَلَاثَةَ أَيَّامٍ ۖ ذَٰلِكَ وَعْدٌ غَيْرُ مَكْذُوبٍ","numberInSurah":65,"juz":12,"manzil":3,"page":229,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1539,"text":"فَلَمَّا جَاءَ أَمْرُنَا نَجَّيْنَا صَالِحًا وَالَّذِينَ آمَنُوا مَعَهُ بِرَحْمَةٍ مِنَّا وَمِنْ خِزْيِ يَوْمِئِذٍ ۗ إِنَّ رَبَّكَ هُوَ الْقَوِيُّ الْعَزِيزُ","numberInSurah":66,"juz":12,"manzil":3,"page":229,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1540,"text":"وَأَخَذَ الَّذِينَ ظَلَمُوا الصَّيْحَةُ فَأَصْبَحُوا فِي دِيَارِهِمْ جَاثِمِينَ","numberInSurah":67,"juz":12,"manzil":3,"page":229,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1541,"text":"كَأَنْ لَمْ يَغْنَوْا فِيهَا ۗ أَلَا إِنَّ ثَمُودَ كَفَرُوا رَبَّهُمْ ۗ أَلَا بُعْدًا لِثَمُودَ","numberInSurah":68,"juz":12,"manzil":3,"page":229,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1542,"text":"وَلَقَدْ جَاءَتْ رُسُلُنَا إِبْرَاهِيمَ بِالْبُشْرَىٰ قَالُوا سَلَامًا ۖ قَالَ سَلَامٌ ۖ فَمَا لَبِثَ أَنْ جَاءَ بِعِجْلٍ حَنِيذٍ","numberInSurah":69,"juz":12,"manzil":3,"page":229,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1543,"text":"فَلَمَّا رَأَىٰ أَيْدِيَهُمْ لَا تَصِلُ إِلَيْهِ نَكِرَهُمْ وَأَوْجَسَ مِنْهُمْ خِيفَةً ۚ قَالُوا لَا تَخَفْ إِنَّا أُرْسِلْنَا إِلَىٰ قَوْمِ لُوطٍ","numberInSurah":70,"juz":12,"manzil":3,"page":229,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1544,"text":"وَامْرَأَتُهُ قَائِمَةٌ فَضَحِكَتْ فَبَشَّرْنَاهَا بِإِسْحَاقَ وَمِنْ وَرَاءِ إِسْحَاقَ يَعْقُوبَ","numberInSurah":71,"juz":12,"manzil":3,"page":229,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1545,"text":"قَالَتْ يَا وَيْلَتَىٰ أَأَلِدُ وَأَنَا عَجُوزٌ وَهَٰذَا بَعْلِي شَيْخًا ۖ إِنَّ هَٰذَا لَشَيْءٌ عَجِيبٌ","numberInSurah":72,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1546,"text":"قَالُوا أَتَعْجَبِينَ مِنْ أَمْرِ اللَّهِ ۖ رَحْمَتُ اللَّهِ وَبَرَكَاتُهُ عَلَيْكُمْ أَهْلَ الْبَيْتِ ۚ إِنَّهُ حَمِيدٌ مَجِيدٌ","numberInSurah":73,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1547,"text":"فَلَمَّا ذَهَبَ عَنْ إِبْرَاهِيمَ الرَّوْعُ وَجَاءَتْهُ الْبُشْرَىٰ يُجَادِلُنَا فِي قَوْمِ لُوطٍ","numberInSurah":74,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1548,"text":"إِنَّ إِبْرَاهِيمَ لَحَلِيمٌ أَوَّاهٌ مُنِيبٌ","numberInSurah":75,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1549,"text":"يَا إِبْرَاهِيمُ أَعْرِضْ عَنْ هَٰذَا ۖ إِنَّهُ قَدْ جَاءَ أَمْرُ رَبِّكَ ۖ وَإِنَّهُمْ آتِيهِمْ عَذَابٌ غَيْرُ مَرْدُودٍ","numberInSurah":76,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1550,"text":"وَلَمَّا جَاءَتْ رُسُلُنَا لُوطًا سِيءَ بِهِمْ وَضَاقَ بِهِمْ ذَرْعًا وَقَالَ هَٰذَا يَوْمٌ عَصِيبٌ","numberInSurah":77,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1551,"text":"وَجَاءَهُ قَوْمُهُ يُهْرَعُونَ إِلَيْهِ وَمِنْ قَبْلُ كَانُوا يَعْمَلُونَ السَّيِّئَاتِ ۚ قَالَ يَا قَوْمِ هَٰؤُلَاءِ بَنَاتِي هُنَّ أَطْهَرُ لَكُمْ ۖ فَاتَّقُوا اللَّهَ وَلَا تُخْزُونِ فِي ضَيْفِي ۖ أَلَيْسَ مِنْكُمْ رَجُلٌ رَشِيدٌ","numberInSurah":78,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1552,"text":"قَالُوا لَقَدْ عَلِمْتَ مَا لَنَا فِي بَنَاتِكَ مِنْ حَقٍّ وَإِنَّكَ لَتَعْلَمُ مَا نُرِيدُ","numberInSurah":79,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1553,"text":"قَالَ لَوْ أَنَّ لِي بِكُمْ قُوَّةً أَوْ آوِي إِلَىٰ رُكْنٍ شَدِيدٍ","numberInSurah":80,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1554,"text":"قَالُوا يَا لُوطُ إِنَّا رُسُلُ رَبِّكَ لَنْ يَصِلُوا إِلَيْكَ ۖ فَأَسْرِ بِأَهْلِكَ بِقِطْعٍ مِنَ اللَّيْلِ وَلَا يَلْتَفِتْ مِنْكُمْ أَحَدٌ إِلَّا امْرَأَتَكَ ۖ إِنَّهُ مُصِيبُهَا مَا أَصَابَهُمْ ۚ إِنَّ مَوْعِدَهُمُ الصُّبْحُ ۚ أَلَيْسَ الصُّبْحُ بِقَرِيبٍ","numberInSurah":81,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1555,"text":"فَلَمَّا جَاءَ أَمْرُنَا جَعَلْنَا عَالِيَهَا سَافِلَهَا وَأَمْطَرْنَا عَلَيْهَا حِجَارَةً مِنْ سِجِّيلٍ مَنْضُودٍ","numberInSurah":82,"juz":12,"manzil":3,"page":231,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1556,"text":"مُسَوَّمَةً عِنْدَ رَبِّكَ ۖ وَمَا هِيَ مِنَ الظَّالِمِينَ بِبَعِيدٍ","numberInSurah":83,"juz":12,"manzil":3,"page":231,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1557,"text":"۞ وَإِلَىٰ مَدْيَنَ أَخَاهُمْ شُعَيْبًا ۚ قَالَ يَا قَوْمِ اعْبُدُوا اللَّهَ مَا لَكُمْ مِنْ إِلَٰهٍ غَيْرُهُ ۖ وَلَا تَنْقُصُوا الْمِكْيَالَ وَالْمِيزَانَ ۚ إِنِّي أَرَاكُمْ بِخَيْرٍ وَإِنِّي أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ مُحِيطٍ","numberInSurah":84,"juz":12,"manzil":3,"page":231,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1558,"text":"وَيَا قَوْمِ أَوْفُوا الْمِكْيَالَ وَالْمِيزَانَ بِالْقِسْطِ ۖ وَلَا تَبْخَسُوا النَّاسَ أَشْيَاءَهُمْ وَلَا تَعْثَوْا فِي الْأَرْضِ مُفْسِدِينَ","numberInSurah":85,"juz":12,"manzil":3,"page":231,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1559,"text":"بَقِيَّتُ اللَّهِ خَيْرٌ لَكُمْ إِنْ كُنْتُمْ مُؤْمِنِينَ ۚ وَمَا أَنَا عَلَيْكُمْ بِحَفِيظٍ","numberInSurah":86,"juz":12,"manzil":3,"page":231,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1560,"text":"قَالُوا يَا شُعَيْبُ أَصَلَاتُكَ تَأْمُرُكَ أَنْ نَتْرُكَ مَا يَعْبُدُ آبَاؤُنَا أَوْ أَنْ نَفْعَلَ فِي أَمْوَالِنَا مَا نَشَاءُ ۖ إِنَّكَ لَأَنْتَ الْحَلِيمُ الرَّشِيدُ","numberInSurah":87,"juz":12,"manzil":3,"page":231,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1561,"text":"قَالَ يَا قَوْمِ أَرَأَيْتُمْ إِنْ كُنْتُ عَلَىٰ بَيِّنَةٍ مِنْ رَبِّي وَرَزَقَنِي مِنْهُ رِزْقًا حَسَنًا ۚ وَمَا أُرِيدُ أَنْ أُخَالِفَكُمْ إِلَىٰ مَا أَنْهَاكُمْ عَنْهُ ۚ إِنْ أُرِيدُ إِلَّا الْإِصْلَاحَ مَا اسْتَطَعْتُ ۚ وَمَا تَوْفِيقِي إِلَّا بِاللَّهِ ۚ عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ","numberInSurah":88,"juz":12,"manzil":3,"page":231,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1562,"text":"وَيَا قَوْمِ لَا يَجْرِمَنَّكُمْ شِقَاقِي أَنْ يُصِيبَكُمْ مِثْلُ مَا أَصَابَ قَوْمَ نُوحٍ أَوْ قَوْمَ هُودٍ أَوْ قَوْمَ صَالِحٍ ۚ وَمَا قَوْمُ لُوطٍ مِنْكُمْ بِبَعِيدٍ","numberInSurah":89,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1563,"text":"وَاسْتَغْفِرُوا رَبَّكُمْ ثُمَّ تُوبُوا إِلَيْهِ ۚ إِنَّ رَبِّي رَحِيمٌ وَدُودٌ","numberInSurah":90,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1564,"text":"قَالُوا يَا شُعَيْبُ مَا نَفْقَهُ كَثِيرًا مِمَّا تَقُولُ وَإِنَّا لَنَرَاكَ فِينَا ضَعِيفًا ۖ وَلَوْلَا رَهْطُكَ لَرَجَمْنَاكَ ۖ وَمَا أَنْتَ عَلَيْنَا بِعَزِيزٍ","numberInSurah":91,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1565,"text":"قَالَ يَا قَوْمِ أَرَهْطِي أَعَزُّ عَلَيْكُمْ مِنَ اللَّهِ وَاتَّخَذْتُمُوهُ وَرَاءَكُمْ ظِهْرِيًّا ۖ إِنَّ رَبِّي بِمَا تَعْمَلُونَ مُحِيطٌ","numberInSurah":92,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1566,"text":"وَيَا قَوْمِ اعْمَلُوا عَلَىٰ مَكَانَتِكُمْ إِنِّي عَامِلٌ ۖ سَوْفَ تَعْلَمُونَ مَنْ يَأْتِيهِ عَذَابٌ يُخْزِيهِ وَمَنْ هُوَ كَاذِبٌ ۖ وَارْتَقِبُوا إِنِّي مَعَكُمْ رَقِيبٌ","numberInSurah":93,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1567,"text":"وَلَمَّا جَاءَ أَمْرُنَا نَجَّيْنَا شُعَيْبًا وَالَّذِينَ آمَنُوا مَعَهُ بِرَحْمَةٍ مِنَّا وَأَخَذَتِ الَّذِينَ ظَلَمُوا الصَّيْحَةُ فَأَصْبَحُوا فِي دِيَارِهِمْ جَاثِمِينَ","numberInSurah":94,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1568,"text":"كَأَنْ لَمْ يَغْنَوْا فِيهَا ۗ أَلَا بُعْدًا لِمَدْيَنَ كَمَا بَعِدَتْ ثَمُودُ","numberInSurah":95,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1569,"text":"وَلَقَدْ أَرْسَلْنَا مُوسَىٰ بِآيَاتِنَا وَسُلْطَانٍ مُبِينٍ","numberInSurah":96,"juz":12,"manzil":3,"page":232,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1570,"text":"إِلَىٰ فِرْعَوْنَ وَمَلَئِهِ فَاتَّبَعُوا أَمْرَ فِرْعَوْنَ ۖ وَمَا أَمْرُ فِرْعَوْنَ بِرَشِيدٍ","numberInSurah":97,"juz":12,"manzil":3,"page":232,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1571,"text":"يَقْدُمُ قَوْمَهُ يَوْمَ الْقِيَامَةِ فَأَوْرَدَهُمُ النَّارَ ۖ وَبِئْسَ الْوِرْدُ الْمَوْرُودُ","numberInSurah":98,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1572,"text":"وَأُتْبِعُوا فِي هَٰذِهِ لَعْنَةً وَيَوْمَ الْقِيَامَةِ ۚ بِئْسَ الرِّفْدُ الْمَرْفُودُ","numberInSurah":99,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1573,"text":"ذَٰلِكَ مِنْ أَنْبَاءِ الْقُرَىٰ نَقُصُّهُ عَلَيْكَ ۖ مِنْهَا قَائِمٌ وَحَصِيدٌ","numberInSurah":100,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1574,"text":"وَمَا ظَلَمْنَاهُمْ وَلَٰكِنْ ظَلَمُوا أَنْفُسَهُمْ ۖ فَمَا أَغْنَتْ عَنْهُمْ آلِهَتُهُمُ الَّتِي يَدْعُونَ مِنْ دُونِ اللَّهِ مِنْ شَيْءٍ لَمَّا جَاءَ أَمْرُ رَبِّكَ ۖ وَمَا زَادُوهُمْ غَيْرَ تَتْبِيبٍ","numberInSurah":101,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1575,"text":"وَكَذَٰلِكَ أَخْذُ رَبِّكَ إِذَا أَخَذَ الْقُرَىٰ وَهِيَ ظَالِمَةٌ ۚ إِنَّ أَخْذَهُ أَلِيمٌ شَدِيدٌ","numberInSurah":102,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1576,"text":"إِنَّ فِي ذَٰلِكَ لَآيَةً لِمَنْ خَافَ عَذَابَ الْآخِرَةِ ۚ ذَٰلِكَ يَوْمٌ مَجْمُوعٌ لَهُ النَّاسُ وَذَٰلِكَ يَوْمٌ مَشْهُودٌ","numberInSurah":103,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1577,"text":"وَمَا نُؤَخِّرُهُ إِلَّا لِأَجَلٍ مَعْدُودٍ","numberInSurah":104,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1578,"text":"يَوْمَ يَأْتِ لَا تَكَلَّمُ نَفْسٌ إِلَّا بِإِذْنِهِ ۚ فَمِنْهُمْ شَقِيٌّ وَسَعِيدٌ","numberInSurah":105,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1579,"text":"فَأَمَّا الَّذِينَ شَقُوا فَفِي النَّارِ لَهُمْ فِيهَا زَفِيرٌ وَشَهِيقٌ","numberInSurah":106,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1580,"text":"خَالِدِينَ فِيهَا مَا دَامَتِ السَّمَاوَاتُ وَالْأَرْضُ إِلَّا مَا شَاءَ رَبُّكَ ۚ إِنَّ رَبَّكَ فَعَّالٌ لِمَا يُرِيدُ","numberInSurah":107,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1581,"text":"۞ وَأَمَّا الَّذِينَ سُعِدُوا فَفِي الْجَنَّةِ خَالِدِينَ فِيهَا مَا دَامَتِ السَّمَاوَاتُ وَالْأَرْضُ إِلَّا مَا شَاءَ رَبُّكَ ۖ عَطَاءً غَيْرَ مَجْذُوذٍ","numberInSurah":108,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":94,"sajda":false},{"number":1582,"text":"فَلَا تَكُ فِي مِرْيَةٍ مِمَّا يَعْبُدُ هَٰؤُلَاءِ ۚ مَا يَعْبُدُونَ إِلَّا كَمَا يَعْبُدُ آبَاؤُهُمْ مِنْ قَبْلُ ۚ وَإِنَّا لَمُوَفُّوهُمْ نَصِيبَهُمْ غَيْرَ مَنْقُوصٍ","numberInSurah":109,"juz":12,"manzil":3,"page":234,"ruku":191,"hizbQuarter":94,"sajda":false},{"number":1583,"text":"وَلَقَدْ آتَيْنَا مُوسَى الْكِتَابَ فَاخْتُلِفَ فِيهِ ۚ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِيَ بَيْنَهُمْ ۚ وَإِنَّهُمْ لَفِي شَكٍّ مِنْهُ مُرِيبٍ","numberInSurah":110,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1584,"text":"وَإِنَّ كُلًّا لَمَّا لَيُوَفِّيَنَّهُمْ رَبُّكَ أَعْمَالَهُمْ ۚ إِنَّهُ بِمَا يَعْمَلُونَ خَبِيرٌ","numberInSurah":111,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1585,"text":"فَاسْتَقِمْ كَمَا أُمِرْتَ وَمَنْ تَابَ مَعَكَ وَلَا تَطْغَوْا ۚ إِنَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","numberInSurah":112,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1586,"text":"وَلَا تَرْكَنُوا إِلَى الَّذِينَ ظَلَمُوا فَتَمَسَّكُمُ النَّارُ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ أَوْلِيَاءَ ثُمَّ لَا تُنْصَرُونَ","numberInSurah":113,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1587,"text":"وَأَقِمِ الصَّلَاةَ طَرَفَيِ النَّهَارِ وَزُلَفًا مِنَ اللَّيْلِ ۚ إِنَّ الْحَسَنَاتِ يُذْهِبْنَ السَّيِّئَاتِ ۚ ذَٰلِكَ ذِكْرَىٰ لِلذَّاكِرِينَ","numberInSurah":114,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1588,"text":"وَاصْبِرْ فَإِنَّ اللَّهَ لَا يُضِيعُ أَجْرَ الْمُحْسِنِينَ","numberInSurah":115,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1589,"text":"فَلَوْلَا كَانَ مِنَ الْقُرُونِ مِنْ قَبْلِكُمْ أُولُو بَقِيَّةٍ يَنْهَوْنَ عَنِ الْفَسَادِ فِي الْأَرْضِ إِلَّا قَلِيلًا مِمَّنْ أَنْجَيْنَا مِنْهُمْ ۗ وَاتَّبَعَ الَّذِينَ ظَلَمُوا مَا أُتْرِفُوا فِيهِ وَكَانُوا مُجْرِمِينَ","numberInSurah":116,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1590,"text":"وَمَا كَانَ رَبُّكَ لِيُهْلِكَ الْقُرَىٰ بِظُلْمٍ وَأَهْلُهَا مُصْلِحُونَ","numberInSurah":117,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1591,"text":"وَلَوْ شَاءَ رَبُّكَ لَجَعَلَ النَّاسَ أُمَّةً وَاحِدَةً ۖ وَلَا يَزَالُونَ مُخْتَلِفِينَ","numberInSurah":118,"juz":12,"manzil":3,"page":235,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1592,"text":"إِلَّا مَنْ رَحِمَ رَبُّكَ ۚ وَلِذَٰلِكَ خَلَقَهُمْ ۗ وَتَمَّتْ كَلِمَةُ رَبِّكَ لَأَمْلَأَنَّ جَهَنَّمَ مِنَ الْجِنَّةِ وَالنَّاسِ أَجْمَعِينَ","numberInSurah":119,"juz":12,"manzil":3,"page":235,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1593,"text":"وَكُلًّا نَقُصُّ عَلَيْكَ مِنْ أَنْبَاءِ الرُّسُلِ مَا نُثَبِّتُ بِهِ فُؤَادَكَ ۚ وَجَاءَكَ فِي هَٰذِهِ الْحَقُّ وَمَوْعِظَةٌ وَذِكْرَىٰ لِلْمُؤْمِنِينَ","numberInSurah":120,"juz":12,"manzil":3,"page":235,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1594,"text":"وَقُلْ لِلَّذِينَ لَا يُؤْمِنُونَ اعْمَلُوا عَلَىٰ مَكَانَتِكُمْ إِنَّا عَامِلُونَ","numberInSurah":121,"juz":12,"manzil":3,"page":235,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1595,"text":"وَانْتَظِرُوا إِنَّا مُنْتَظِرُونَ","numberInSurah":122,"juz":12,"manzil":3,"page":235,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1596,"text":"وَلِلَّهِ غَيْبُ السَّمَاوَاتِ وَالْأَرْضِ وَإِلَيْهِ يُرْجَعُ الْأَمْرُ كُلُّهُ فَاعْبُدْهُ وَتَوَكَّلْ عَلَيْهِ ۚ وَمَا رَبُّكَ بِغَافِلٍ عَمَّا تَعْمَلُونَ","numberInSurah":123,"juz":12,"manzil":3,"page":235,"ruku":192,"hizbQuarter":94,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":11,"name":"سُورَةُ هُودٍ","englishName":"Hûd","englishNameTranslation":"Hud","revelationType":"Meccan","numberOfAyahs":123,"ayahs":[{"number":1474,"text":"Elif, Lam, Ra. Bu Kitap, hakim ve haberdar olan Allah tarafından, Allah'tan başkasına kulluk etmeyesiniz diye ayetleri kesin kılınmış, sonra da uzun uzadıya açıklanmış bir Kitap'dır. Ben size, O'nun tarafından gönderilmiş bir uyarıcı ve müjdeciyim. Rabbinizden mağfiret dileyin ve O'na tevbe edin ki, belli bir süreye kadar sizi güzelce geçindirsin ve her fazilet sahibine faziletinin karşılığını versin. Eğer yüz çevirirseniz o zaman ben doğrusu hakkınızda büyük günün azabından korkarım.","numberInSurah":1,"juz":11,"manzil":3,"page":221,"ruku":183,"hizbQuarter":88,"sajda":false},{"number":1475,"text":"Elif, Lam, Ra. Bu Kitap, hakim ve haberdar olan Allah tarafından, Allah'tan başkasına kulluk etmeyesiniz diye ayetleri kesin kılınmış, sonra da uzun uzadıya açıklanmış bir Kitap'dır. Ben size, O'nun tarafından gönderilmiş bir uyarıcı ve müjdeciyim. Rabbinizden mağfiret dileyin ve O'na tevbe edin ki, belli bir süreye kadar sizi güzelce geçindirsin ve her fazilet sahibine faziletinin karşılığını versin. Eğer yüz çevirirseniz o zaman ben doğrusu hakkınızda büyük günün azabından korkarım.","numberInSurah":2,"juz":11,"manzil":3,"page":221,"ruku":183,"hizbQuarter":88,"sajda":false},{"number":1476,"text":"Elif, Lam, Ra. Bu Kitap, hakim ve haberdar olan Allah tarafından, Allah'tan başkasına kulluk etmeyesiniz diye ayetleri kesin kılınmış, sonra da uzun uzadıya açıklanmış bir Kitap'dır. Ben size, O'nun tarafından gönderilmiş bir uyarıcı ve müjdeciyim. Rabbinizden mağfiret dileyin ve O'na tevbe edin ki, belli bir süreye kadar sizi güzelce geçindirsin ve her fazilet sahibine faziletinin karşılığını versin. Eğer yüz çevirirseniz o zaman ben doğrusu hakkınızda büyük günün azabından korkarım.","numberInSurah":3,"juz":11,"manzil":3,"page":221,"ruku":183,"hizbQuarter":88,"sajda":false},{"number":1477,"text":"Dönüşünüz ancak Allah'adır. O her şeye Kadir'dir.","numberInSurah":4,"juz":11,"manzil":3,"page":221,"ruku":183,"hizbQuarter":88,"sajda":false},{"number":1478,"text":"Bilin ki, onlar Kuran okunurken gizlenmek için iki büklüm olurlar. Bilin ki, elbiselerine büründüklerinde bile Allah onların gizlediklerini ve açığa vurduklarını bilir. Çünkü O, kalblerde olanı bilendir.","numberInSurah":5,"juz":11,"manzil":3,"page":221,"ruku":183,"hizbQuarter":88,"sajda":false},{"number":1479,"text":"Yeryüzünde yaşayan bütün canlıların rızkı ancak Allah'a aittir. O, canlıları babaların sulbünde kararlaşmış ve anaların rahminde kararlaşmakta iken de bilir. Her şey apaçık bir Kitaptadır.","numberInSurah":6,"juz":12,"manzil":3,"page":222,"ruku":183,"hizbQuarter":89,"sajda":false},{"number":1480,"text":"Arş'ı su üzerinde iken, hanginizin daha güzel işi işleyeceğini ortaya koymak için, gökleri ve yeri altı günde yaratan O'dur. And olsun ki, \"Siz gerçekten, ölümden sonra dirileceksiniz\" desen, inkar edenler: \"Bu, apaçık bir sihirden başka bir şey değildir\" derler.","numberInSurah":7,"juz":12,"manzil":3,"page":222,"ruku":183,"hizbQuarter":89,"sajda":false},{"number":1481,"text":"And olsun ki, onların azabını sayılı bir süreye kadar ertelesek, \"Onu alıkoyan nedir?\" derler. Bilin ki, onlara azab geldiği gün, artık geri çevrilmez; alaya aldıkları şey onları mahvedecektir.","numberInSurah":8,"juz":12,"manzil":3,"page":222,"ruku":183,"hizbQuarter":89,"sajda":false},{"number":1482,"text":"And olsun ki, insana nimetimizi tattırır sonra onu ondan çekip alırsak, o şüphesiz umutsuz bir nanköre döner.","numberInSurah":9,"juz":12,"manzil":3,"page":222,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1483,"text":"Başına gelen sıkıntıdan sonra, ona bir nimet tattırırsak, \"Musibetler başımdan gitti\" der; doğrusu o, şımarıp böbürlenen biridir.","numberInSurah":10,"juz":12,"manzil":3,"page":222,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1484,"text":"Bunların dışında, sabredip iyi işler işleyen kimseler, işte onlara mağfiret ve büyük ecir vardır.","numberInSurah":11,"juz":12,"manzil":3,"page":222,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1485,"text":"Putperestlerin: \"Ona bir hazine indirilmeli veya yanında bir melek gelmeli değil miydi?\" demelerinden senin kalbin daralır ve belki de sana vahyolunanın bir kısmını terkedecek olursun. Sen ancak bir uyarıcısın, Allah her şeye vekildir.","numberInSurah":12,"juz":12,"manzil":3,"page":222,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1486,"text":"Senin için: \"Onu uydurdu\" diyorlar, öyle mi? De ki: \"Öyleyse onun surelerine benzer uydurma on sure meydana getirin, iddianızda samimi iseniz, Allah'tan başka çağırabileceklerinizi de çağırın.\"","numberInSurah":13,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1487,"text":"Söylediğinizi yapamazlarsa, bilin ki o, ancak Allah'ın ilmiyle indirilmiştir. O'ndan başka tanrı yoktur, artık müslümansınız değil mi?","numberInSurah":14,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1488,"text":"Dünya hayatını ve güzelliklerini isteyenlere, orada işlediklerinin karşılığını tastamam veririz; onlar orada bir eksikliğe de uğratılmazlar.","numberInSurah":15,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1489,"text":"İşte ahirette onlara ateşten başka bir şey yoktur. İşledikleri şeyler orada boşa gitmiştir. Zaten yapmakta oldukları da batıldır.","numberInSurah":16,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1490,"text":"Rabbinin katından bir belgesi ve onun arkasından da bir şahidi olanlar, önlerinde de Musa'nın Kitap'ı önder ve rahmet olarak bulunanlardır ki, işte onlar Kuran'a inanırlar. Hangi topluluk onu inkar ederse yeri ateştir; senin de bundan şüphen olmasın. Doğrusu o, Rabbinden bir gerçektir, fakat insanların çoğu inanmazlar.","numberInSurah":17,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1491,"text":"Yalan söyleyerek Allah'a iftira edenden daha zalim kim vardır? İşte bunlar Rablerine götürülürler ve şahidler: \"Rablerine yalan söyleyenler bunlardır\" derler. Bilin ki Allah'ın laneti haksızlık yapanlaradır.","numberInSurah":18,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1492,"text":"Bunlar Allah'ın yolundan alıkorlar ve o yolu eğriltmeğe çalışırlar; işte onlar ahireti inkar edenlerdir.","numberInSurah":19,"juz":12,"manzil":3,"page":223,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1493,"text":"Bunlar yeryüzünde Allah'ı aciz bırakamazlar. Allah'dan başka kendilerini kurtaracak dostları da yoktur. Azab onlara kat kat verilir; işitemezler ve göremezlerdi.","numberInSurah":20,"juz":12,"manzil":3,"page":224,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1494,"text":"İşte bunlar kendilerine yazık edenlerdir. Uydurdukları putlar da onlardan uzaklaşıp kaybolmuştur.","numberInSurah":21,"juz":12,"manzil":3,"page":224,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1495,"text":"Ahirette en çok kayba uğrayacaklar şüphesiz bunlardır.","numberInSurah":22,"juz":12,"manzil":3,"page":224,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1496,"text":"Doğrusu inanan ve yararlı iş yapanlar ve Rablerine boyun eğenler, işte onlar cennetliklerdir; orada temellidirler.","numberInSurah":23,"juz":12,"manzil":3,"page":224,"ruku":184,"hizbQuarter":89,"sajda":false},{"number":1497,"text":"Bu iki zümrenin durumu, kör ve sağır kimse ile gören ve işiten kimsenin durumuna benzer. Durumları hiç eşit olabilir mi? İbret almıyor musunuz?","numberInSurah":24,"juz":12,"manzil":3,"page":224,"ruku":184,"hizbQuarter":90,"sajda":false},{"number":1498,"text":"And olsun ki biz Nuh'u kendi milletine gönderdik; \"Ben sizin için apaçık bir uyarıcıyım; Allah'tan başkasına kulluk etmeyin; doğrusu ben hakkınızda can yakıcı bir günün azabından korkuyorum\" dedi.","numberInSurah":25,"juz":12,"manzil":3,"page":224,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1499,"text":"And olsun ki biz Nuh'u kendi milletine gönderdik; \"Ben sizin için apaçık bir uyarıcıyım; Allah'tan başkasına kulluk etmeyin; doğrusu ben hakkınızda can yakıcı bir günün azabından korkuyorum\" dedi.","numberInSurah":26,"juz":12,"manzil":3,"page":224,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1500,"text":"Milletinin inkarcı ileri gelenleri: \"Senin ancak kendimiz gibi bir insan olduğunu görüyoruz. Daha başlangıçta, sana bizim ayak takımı dışında kimsenin uyduğunu görmüyoruz. Sizin bizden bir üstünlüğünüz yoktur; biz sizi yalancı sanıyoruz\" dediler.","numberInSurah":27,"juz":12,"manzil":3,"page":224,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1501,"text":"Nuh: \"Ey milletim! Rabbimin katından bir delilim bulunsa ve bana yine katından bir rahmet vermiş de bunlar sizden gizlenmiş olsa, söyleyin bana, hoşlanmadığınız halde zorla sizi bunlara mecbur mu ederiz?\" dedi.","numberInSurah":28,"juz":12,"manzil":3,"page":224,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1502,"text":"\"Ey milletim! Buna karşılık ben sizden bir mal da istemiyorum. Benim ücretim Allah'a aittir; inananları da kovacak değilim; çünkü onlar Rableriyle karşılaşacaklar; fakat ben sizi cahil bir millet olarak görüyorum.\"","numberInSurah":29,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1503,"text":"\"Ey milletim! Onları kovarsam, Allah'a karşı beni kim savunur? Düşünmez misiniz?\"","numberInSurah":30,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1504,"text":"\"Size, Allah'ın hazineleri yanımdadır demiyorum; gaybı da bilmem; doğrusu melek olduğumu da söylemiyorum; küçük gördüklerinize Allah iyilik vermeyecektir diyemem; içlerinde olanı Allah daha iyi bilir. Yoksa şüphesiz haksızlık edenlerden olurum.\"","numberInSurah":31,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1505,"text":"\"Ey Nuh! Bizimle cidden tartıştın; hem de çok tartıştın. Doğru sözlülerden isen tehdit ettiğin azabı başımıza getir\" dediler.","numberInSurah":32,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1506,"text":"\"Ancak Allah dilerse onu başınıza getirir, siz O'nu aciz bırakamazsınız. Allah sizi azdırmak isterse, ben size öğüt vermek istesem de faydası olmaz. O, sizin Rabbinizdir, O'na döndürüleceksiniz\" dedi.","numberInSurah":33,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1507,"text":"\"Ancak Allah dilerse onu başınıza getirir, siz O'nu aciz bırakamazsınız. Allah sizi azdırmak isterse, ben size öğüt vermek istesem de faydası olmaz. O, sizin Rabbinizdir, O'na döndürüleceksiniz\" dedi.","numberInSurah":34,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1508,"text":"Sana \"Kuran'ı kendiliğinden uydurdu\" derler, de ki: \"Uydurdumsa suçu bana aittir; oysa ben sizin işlediğiniz günahlardan uzağım.\"","numberInSurah":35,"juz":12,"manzil":3,"page":225,"ruku":185,"hizbQuarter":90,"sajda":false},{"number":1509,"text":"Nuh'a, \"Senin milletinden, inanmış olanlardan başkası inanmayacaktır; onların yapageldiklerine üzülme; nezaretimiz altında, sana bildirdiğimiz gibi gemiyi yap. Haksızlık yapanlar için Bana baş vurma, çünkü onlar suda boğulacaklardır\" diye Allah tarafından vahyolundu.","numberInSurah":36,"juz":12,"manzil":3,"page":225,"ruku":186,"hizbQuarter":90,"sajda":false},{"number":1510,"text":"Nuh'a, \"Senin milletinden, inanmış olanlardan başkası inanmayacaktır; onların yapageldiklerine üzülme; nezaretimiz altında, sana bildirdiğimiz gibi gemiyi yap. Haksızlık yapanlar için Bana baş vurma, çünkü onlar suda boğulacaklardır\" diye Allah tarafından vahyolundu.","numberInSurah":37,"juz":12,"manzil":3,"page":225,"ruku":186,"hizbQuarter":90,"sajda":false},{"number":1511,"text":"Gemiyi yaparken, milletinin inkarcı ileri gelenleri yanına uğradıkça onunla alay ederlerdi. O da: \"Bizimle alay ediyorsunuz ama, alay ettiğiniz gibi biz de sizinle alay edeceğiz; rezil edecek olan azabın kime geleceğini ve kime sürekli azabın ineceğini göreceksiniz\" dedi.","numberInSurah":38,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":90,"sajda":false},{"number":1512,"text":"Gemiyi yaparken, milletinin inkarcı ileri gelenleri yanına uğradıkça onunla alay ederlerdi. O da: \"Bizimle alay ediyorsunuz ama, alay ettiğiniz gibi biz de sizinle alay edeceğiz; rezil edecek olan azabın kime geleceğini ve kime sürekli azabın ineceğini göreceksiniz\" dedi.","numberInSurah":39,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":90,"sajda":false},{"number":1513,"text":"Buyruğumuz gelip tandırdan sular kaynamağa başlayınca, \"Her cinsten birer çifti ve aleyhine hüküm verilmiş olanın dışında kalan çoluk çocuğunu ve inananları gemiye bindir\" dedik. Pek az kimse onunla beraber inanmıştı.","numberInSurah":40,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":90,"sajda":false},{"number":1514,"text":"Allah \"Oraya binin; yürümesi ve durması Allah'ın ismiyledir, Rabbin bağışlar ve merhamet eder\" dedi.","numberInSurah":41,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1515,"text":"Gemi, dağlar gibi dalgalar içinde onları götürürken, Nuh, bir kenarda ayrı kalmış olan oğluna \"Ey oğulcuğum! Bizimle beraber gel, kafirlerle birlik olma\" diye seslendi.","numberInSurah":42,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1516,"text":"Oğlu: \"Dağa sığınırım, beni sudan kurtarır\" deyince, Nuh: \"Bugün Allah'ın buyruğundan O'nun acıdıkları dışında kurtulacak yoktur\" dedi. Aralarına dalga girdi, oğlu da boğulanlara karıştı.","numberInSurah":43,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1517,"text":"Yere, \"Suyunu çek!\", göğe, \"Ey gök sen de tut!\" denildi. Su çekildi, iş de bitti; gemi Cudi'ye oturdu. \"Haksızlık yapan millet Allah'ın rahmetinden uzak olsun\" denildi.","numberInSurah":44,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1518,"text":"Nuh Rabbine seslendi: \"Rabbim! Oğlum benim ailemdendi. Doğrusu Senin vadin haktır. Sen hükmedenlerin en iyi hükmedenisin\" dedi.","numberInSurah":45,"juz":12,"manzil":3,"page":226,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1519,"text":"Allah: \"Ey Nuh! O senin ailenden sayılmaz; çünkü kötü bir iş işlemiştir; öyleyse bilmediğin şeyi Benden isteme. İşte sana öğüt, bilgisizlerden olma\" dedi.","numberInSurah":46,"juz":12,"manzil":3,"page":227,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1520,"text":"\"Rabbim! Bilmediğim şeyi Senden istemekten Sana sığınırım. Beni bağışlamaz ve bana merhamet etmezsen kaybedenlerden olurum\" dedi.","numberInSurah":47,"juz":12,"manzil":3,"page":227,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1521,"text":"\"Ey Nuh! Sana ve seninle beraber olan topluluklara bizden bir selamet ve bereketle gemiden in. Ama birçok toplulukları da geçindireceğiz, sonra onlara can yakıcı bir azab vereceğiz\" denildi.","numberInSurah":48,"juz":12,"manzil":3,"page":227,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1522,"text":"Bunlar sana vahyettiğimiz bilinmeyen olaylardır. Sen de, milletin de daha önce bunları bilmezdiniz. Sabret, sonuç, Allah'tan sakınanlarındır.","numberInSurah":49,"juz":12,"manzil":3,"page":227,"ruku":186,"hizbQuarter":91,"sajda":false},{"number":1523,"text":"Ad milletine kardeşleri Hud'u gönderdik. Şöyle dedi: \"Ey milletim! Allah'a kulluk edin. O'ndan başka tanrınız yoktur; yoksa sadece yalan uyduran kimseler olursunuz.\"","numberInSurah":50,"juz":12,"manzil":3,"page":227,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1524,"text":"\"Ey milletim! Buna karşılık sizden bir ücret istemiyorum. Benim ücretim ancak beni yaratana aittir. Akletmez misiniz?\"","numberInSurah":51,"juz":12,"manzil":3,"page":227,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1525,"text":"\"Ey milletim! Rabbinizden mağfiret dileyin, sonra O'na tevbe edin ki size gökten bol bol yağmur göndersin, kuvvetinize kuvvet katsın; suçlular olarak yüz çevirmeyin.\"","numberInSurah":52,"juz":12,"manzil":3,"page":227,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1526,"text":"\"Ey Hud! Sen bize bir belge getirmeden, senin sözünden ötürü tanrılarımızı terketmeyiz ve sana inanmayız.","numberInSurah":53,"juz":12,"manzil":3,"page":227,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1527,"text":"Bir kısım tanrılarımız seni çarpmıştır, demekten başka birşey demeyiz\" dediler. Hud: \"Doğrusu ben Allah'ı şahit tutuyorum; siz de şahit olun ki ben O'nu bırakıp koştuğunuz ortaklardan uzağım. Hepiniz bana tuzak kurun sonra da ertelemeyin. Ben, ancak benim de sizin de Rabbiniz olan Allah'a güvenirim. Hiçbir canlı yoktur ki Allah ona el koymamış bulunsun. Rabbim elbette doğru yoldadır. Eğer yüz çevirirseniz, şüphesiz ben size benimle gönderileni bildirdim. Rabbim sizden başka bir milleti yerinize getirebilir, O'na bir şey de yapamazsınız. Doğrusu Rabbim herşeyi koruyandır\" dedi.","numberInSurah":54,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1528,"text":"Bir kısım tanrılarımız seni çarpmıştır, demekten başka birşey demeyiz\" dediler. Hud: \"Doğrusu ben Allah'ı şahit tutuyorum; siz de şahit olun ki ben O'nu bırakıp koştuğunuz ortaklardan uzağım. Hepiniz bana tuzak kurun sonra da ertelemeyin. Ben, ancak benim de sizin de Rabbiniz olan Allah'a güvenirim. Hiçbir canlı yoktur ki Allah ona el koymamış bulunsun. Rabbim elbette doğru yoldadır. Eğer yüz çevirirseniz, şüphesiz ben size benimle gönderileni bildirdim. Rabbim sizden başka bir milleti yerinize getirebilir, O'na bir şey de yapamazsınız. Doğrusu Rabbim herşeyi koruyandır\" dedi.","numberInSurah":55,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1529,"text":"Bir kısım tanrılarımız seni çarpmıştır, demekten başka birşey demeyiz\" dediler. Hud: \"Doğrusu ben Allah'ı şahit tutuyorum; siz de şahit olun ki ben O'nu bırakıp koştuğunuz ortaklardan uzağım. Hepiniz bana tuzak kurun sonra da ertelemeyin. Ben, ancak benim de sizin de Rabbiniz olan Allah'a güvenirim. Hiçbir canlı yoktur ki Allah ona el koymamış bulunsun. Rabbim elbette doğru yoldadır. Eğer yüz çevirirseniz, şüphesiz ben size benimle gönderileni bildirdim. Rabbim sizden başka bir milleti yerinize getirebilir, O'na bir şey de yapamazsınız. Doğrusu Rabbim herşeyi koruyandır\" dedi.","numberInSurah":56,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1530,"text":"Bir kısım tanrılarımız seni çarpmıştır, demekten başka birşey demeyiz\" dediler. Hud: \"Doğrusu ben Allah'ı şahit tutuyorum; siz de şahit olun ki ben O'nu bırakıp koştuğunuz ortaklardan uzağım. Hepiniz bana tuzak kurun sonra da ertelemeyin. Ben, ancak benim de sizin de Rabbiniz olan Allah'a güvenirim. Hiçbir canlı yoktur ki Allah ona el koymamış bulunsun. Rabbim elbette doğru yoldadır. Eğer yüz çevirirseniz, şüphesiz ben size benimle gönderileni bildirdim. Rabbim sizden başka bir milleti yerinize getirebilir, O'na bir şey de yapamazsınız. Doğrusu Rabbim herşeyi koruyandır\" dedi.","numberInSurah":57,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1531,"text":"Buyruğumuz gelince, Hud'u ve beraberindeki inananları, rahmetimizle kurtardık. Onları çetin bir azabdan koruduk.","numberInSurah":58,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1532,"text":"İşte bu, Rablerinin ayetlerini bile bile inkar eden, peygamberlerine kafa tutan ve her inatçı zorbanın emrine uyan Ad milletidir.","numberInSurah":59,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1533,"text":"Bu dünyada da, kıyamet gününde de lanete uğradılar. Bilin ki Ad milleti Rablerini inkar etti ve yine bilin ki Hud'un milleti Ad Allah'ın rahmetinden uzaklaştı.","numberInSurah":60,"juz":12,"manzil":3,"page":228,"ruku":187,"hizbQuarter":91,"sajda":false},{"number":1534,"text":"Semud milletine kardeşleri Salih'i gönderdik. \"Ey milletim! Allah'a kulluk edin; O'ndan başka tanrınız yoktur; sizi yeryüzünde yaratıp orayı imar etmenizi dileyen O'dur. Öyleyse O'ndan mağfiret dileyin, sonra da O'na tevbe edin. Doğrusu Rabbim size yakın ve duaları kabul edendir\" dedi.","numberInSurah":61,"juz":12,"manzil":3,"page":228,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1535,"text":"\"Ey Salih! Sen bundan önce, aramızda kendisinden iyilik beklenir bir kimseydin; şimdi babalarımızın taptıklarına bizi tapmaktan men mi ediyorsun? Doğrusu bizi çağırdığın şeyden şüphe ve endişedeyiz\" dediler.","numberInSurah":62,"juz":12,"manzil":3,"page":228,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1536,"text":"\"Ey milletim! Eğer Rabbimden bir belgem olur ve bana rahmet eder de ben O'na baş kaldırırsam, söyleyin, Allah'a karşı beni kim savunur? Bana zararımı artırmaktan başka birşey yapamazsınız\" dedi.","numberInSurah":63,"juz":12,"manzil":3,"page":229,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1537,"text":"\"Ey milletim! Bu, size bir ayet olarak, Allah'ın devesidir. Bırakın onu, Allah'ın toprağında otlasın; ona fenalık etmeyin, yoksa siz hemen azaba uğrarsınız\"","numberInSurah":64,"juz":12,"manzil":3,"page":229,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1538,"text":"Buna rağmen onu kesip devirdiler. O zaman Salih: \"Yurdunuzda üç gün daha kalın. Bu, yalanlanmayacak bir sözdür\" dedi.","numberInSurah":65,"juz":12,"manzil":3,"page":229,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1539,"text":"Buyruğumuz gelince, Salih'i ve beraberindeki inananları katımızdan bir rahmet olarak o günün rezilliğinden kurtardık. Doğrusu Rabbin pek kuvvetli ve güçlüdür.","numberInSurah":66,"juz":12,"manzil":3,"page":229,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1540,"text":"Haksızlık yapanları bir çığlık tuttu, oldukları yerde diz üstü çöküverdiler.","numberInSurah":67,"juz":12,"manzil":3,"page":229,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1541,"text":"Sanki orada hiç yaşamamışlardı. Bilin ki, Semud milleti Rabbini inkar etmişti. Bilin ki, Semud milleti Allah'ın rahmetinden uzaklaştı.","numberInSurah":68,"juz":12,"manzil":3,"page":229,"ruku":188,"hizbQuarter":92,"sajda":false},{"number":1542,"text":"And olsun ki, elçilerimiz müjde ile İbrahim'e geldiler. \"Selam sana\" dediler, \"Size de selam\" dedi, hemen kızartılmış bir buzağı getirdi.","numberInSurah":69,"juz":12,"manzil":3,"page":229,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1543,"text":"Ellerini ona uzatmadıklarını görünce, durumlarını beğenmedi ve içine korku düştü. Onlar, \"Korkma, biz Lut milletine gönderildik\" dediler.","numberInSurah":70,"juz":12,"manzil":3,"page":229,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1544,"text":"Bu arada, İbrahim'in ayakta duran karısı gülünce, \"Ona İshak'ı ardından Yakub'u müjdeleriz\" dediler.","numberInSurah":71,"juz":12,"manzil":3,"page":229,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1545,"text":"\"Vay başıma gelenler! Ben bir kocakarı, kocam da ihtiyar olmuşken nasıl doğurabilirim? Doğrusu bu şaşılacak bir şey\" dedi.","numberInSurah":72,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1546,"text":"\"Ey evin hanımı! Allah'ın rahmeti ve bereketleri üzerinize olmuşken, nasıl Allah'ın işine şaşarsın? O, övülmeye layıktır, yücelerin yücesidir\" dediler.","numberInSurah":73,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1547,"text":"İbrahim'in korkusu gidip de müjde kendisine ulaşınca, Lut milleti hakkında elçilerimizle tartışmaya girişti.","numberInSurah":74,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1548,"text":"Doğrusu İbrahim çok içli, yumuşak huylu ve kendini Allah'a vermiş bir kimse idi.","numberInSurah":75,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1549,"text":"Elçilerimiz, \"Ey İbrahim! Bundan vazgeç, doğrusu Rabbinin emri gelmiştir. Onlara, şüphesiz, geri çevrilemeyecek bir azab gelmektedir\" dediler.","numberInSurah":76,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1550,"text":"Elçilerimiz Lut'a gelince, onun fenasına gitti; çok sıkıldı, \"Bu çetin bir gündür\" dedi.","numberInSurah":77,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1551,"text":"Milleti ona koşarak geldiler. Daha önce kötü işler işliyorlardı. \"Ey milletim! İşte bunlar benim kızlarım, onlar sizin için daha temizdir. (size nikahlıyabilirim!) Allah'tan sakının, konuklarımın önünde beni rezil etmeyin. İçinizde aklı başında kimse yok mudur?\" dedi.","numberInSurah":78,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1552,"text":"\"And olsun ki, senin kızlarınla bir işimiz olmadığını biliyorsun; doğrusu, ne istediğimizin farkındasın\" dediler.","numberInSurah":79,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1553,"text":"\"Keşke size yetecek bir kuvvetim olsa veya sağlam bir yere sığınsam\" dedi.","numberInSurah":80,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1554,"text":"\"Ey Lut! Biz Rabbinin elçileriyiz, onlar sana ilişemiyecekler; geceleyin bir ara, ailenle beraber yola çık; karının dışında kimse geri kalmasın. Doğrusu onların başına gelen onun başına da gelecektir. Vadeleri gün doğana kadardır. Gün doğması yakın değil mi?\" dediler.","numberInSurah":81,"juz":12,"manzil":3,"page":230,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1555,"text":"Buyruğumuz gelince oraların altını üstüne getirdik; üzerine Rabbinin katından, işaretli olarak yığın yığın sert taş yağdırdık. Bunlar zalimlerden hiçbir zaman uzak olmayacaktır.","numberInSurah":82,"juz":12,"manzil":3,"page":231,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1556,"text":"Buyruğumuz gelince oraların altını üstüne getirdik; üzerine Rabbinin katından, işaretli olarak yığın yığın sert taş yağdırdık. Bunlar zalimlerden hiçbir zaman uzak olmayacaktır.","numberInSurah":83,"juz":12,"manzil":3,"page":231,"ruku":189,"hizbQuarter":92,"sajda":false},{"number":1557,"text":"Medyen halkına kardeşleri Şuayb'ı gönderdik. Şöyle dedi: \"Ey milletim! Allah'a kulluk edin; O'ndan başka tanrınız yoktur. Ölçüyü tartıyı eksik tutmayın. Doğrusu ben sizi bolluk içinde görüyorum ve hakkınızda kuşatıcı bir günün azabından korkuyorum.\"","numberInSurah":84,"juz":12,"manzil":3,"page":231,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1558,"text":"\"Ey milletim! Ölçüyü ve tartıyı tamamı tamamına yapın; insanlara eşyalarını eksik vermeyin; yeryüzünde bozgunculuk yaparak karışıklık çıkarmayın.\"","numberInSurah":85,"juz":12,"manzil":3,"page":231,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1559,"text":"\"İnanıyorsanız, Allah'ın geri bıraktığı helal kar sizin için daha hayırlıdır. Ben size bekçi değilim.\"","numberInSurah":86,"juz":12,"manzil":3,"page":231,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1560,"text":"\"Ey Şuayb! Babalarımızın taptığını bırakmamızı emreden veya mallarımızı istediğimiz gibi kullanmamızı meneden senin namazın mıdır? Sen doğrusu aklı başında, yumuşak huylu birisin\" dediler.","numberInSurah":87,"juz":12,"manzil":3,"page":231,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1561,"text":"\"Ey Milletim! Rabbimden benim bir belgem olduğu ve bana güzel bir rızık da verdiği halde, O'na karşı gelebilir miyim? Söylesenize! Size yasak ettiğim şeylerde, aykırı hareket etmek istemem; gücümün yettiği kadar ıslah etmekten başka bir dileğim yoktur. Başarım ancak Allah'tandır, O'na güvendim; O'na yöneliyorum\" dedi.","numberInSurah":88,"juz":12,"manzil":3,"page":231,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1562,"text":"\"Ey Milletim! Bana karşı gelmeniz, Nuh milletine veya Hud milletine yahut da Salih milletine gelen felaketin bir benzerini, sakın başınıza getirmesin. Lut milleti sizden uzak değildir.\"","numberInSurah":89,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1563,"text":"\"Rabbinizden mağfiret dileyin; O'na tevbe edin; doğrusu Rabbim merhamet eder ve çok sever.\"","numberInSurah":90,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1564,"text":"\"Ey Şuayb! Söylediklerinin çoğunu anlamıyor ve doğrusu seni aramızda güçsüz görüyoruz. Eğer taraftarların olmasaydı seni taşlardık. Esasen bizim gözümüzde pek itibarın da yoktur\" dediler.","numberInSurah":91,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1565,"text":"\"Ey Milletim! Benim taraftarlarım size göre Allah'tan daha mı değerlidir ki Allah'a sırt çevirdiniz? Doğrusu Rabbim yaptıklarınızı bilgisiyle kuşatmıştır\" dedi.","numberInSurah":92,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1566,"text":"\"Ey Milletim! Durumunuzun gerektirdiğini yapın, doğrusu ben de yapacağım. Kime rezil edici bir azabın geleceğini, kimin yalancı olduğunu bileceksiniz. Gözleyin, doğrusu ben de sizinle beraber gözlüyorum.\"","numberInSurah":93,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1567,"text":"Buyruğumuz gelince, Şuayb'ı ve beraberindeki inananları katımızdan bir rahmet olarak kurtardık. Haksızlık yapanları bir çığlık yakaladı, oldukları yerde diz üstü çöküverdiler.","numberInSurah":94,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1568,"text":"Sanki orada hiç yaşamamışlardı. Bilin ki Semud milleti Allah'ın rahmetinden uzaklaştığı gibi Medyen halkı da uzaklaştı.","numberInSurah":95,"juz":12,"manzil":3,"page":232,"ruku":190,"hizbQuarter":93,"sajda":false},{"number":1569,"text":"And olsun ki Musa'yı Firavun ve erkanına mucizelerimizle, apaçık bir delil ile gönderdik. Firavun'un buyruğuna uydular, oysa Firavun'un buyurduğu sağduyuya uygun değildi.","numberInSurah":96,"juz":12,"manzil":3,"page":232,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1570,"text":"And olsun ki Musa'yı Firavun ve erkanına mucizelerimizle, apaçık bir delil ile gönderdik. Firavun'un buyruğuna uydular, oysa Firavun'un buyurduğu sağduyuya uygun değildi.","numberInSurah":97,"juz":12,"manzil":3,"page":232,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1571,"text":"Firavun, kıyamet gününde milletine öncülük eder, onları cehenneme götürür. Gittikleri yer ne kötü yerdir!","numberInSurah":98,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1572,"text":"Hem burada ve hem kıyamet gününde lanete uğratılırlar. Bu ne kötü bir bağıştır!","numberInSurah":99,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1573,"text":"Bu sana anlattıklarımız, kasabaların başından geçenlerdir. Onların bir kısmı hala duruyor, bir kısmı ise silinip gitmiştir.","numberInSurah":100,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1574,"text":"Onlara Biz zulmetmedik, fakat onlar kendilerine yazık ettiler. Rabbinin buyruğu gelince, Allah'ı bırakıp taptıkları tanrılar kendilerine bir fayda vermedi, kayıplarını artırmaktan başka bir şeye yaramadı.","numberInSurah":101,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1575,"text":"Allah, kasabaların zalim halkını yakalayınca, böyle yakalar; yakalaması da şiddetli ve elimdir.","numberInSurah":102,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1576,"text":"Ahiretin azabından korkanlara, bunda, hiç şüphesiz ibret vardır. Bu, insanların toplanacağı gündür; bu, görülecek bir gündür.","numberInSurah":103,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1577,"text":"Biz, o günü, ancak belli bir süreye kadar geciktiririz.","numberInSurah":104,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1578,"text":"O gün gelince, Allah'ın izni olmaksızın hiç kimse konuşamaz: İçlerinde bedbaht olanlar da, mesut olanlar da vardır.","numberInSurah":105,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1579,"text":"Bedbaht olanlar cehennemdedirler. Onlar orada ah edip inlerler.","numberInSurah":106,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1580,"text":"Rabbinin dilemesi bir yana, gökler ve yer durdukça, orada temelli kalacaklardır. Rabbin, şüphesiz, her istediğini yapar.","numberInSurah":107,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":93,"sajda":false},{"number":1581,"text":"Mesud olanlar ise cennettedirler. Rabbinin dilemesi bir yana, sonsuz bir lütuf olarak, gökler ve yer durdukça, orada temelli kalacaklardır.","numberInSurah":108,"juz":12,"manzil":3,"page":233,"ruku":191,"hizbQuarter":94,"sajda":false},{"number":1582,"text":"Bu putperestlerin taptıklarının batıl olduğunda şüphen olmasın; daha önce babalarının tapmış oldukları gibi onlar da taparlar. Onlara paylarını şüphesiz eksiksiz olarak ödeyeceğiz.","numberInSurah":109,"juz":12,"manzil":3,"page":234,"ruku":191,"hizbQuarter":94,"sajda":false},{"number":1583,"text":"And olsun ki, Musa'ya Kitap verdik; onda ayrılığa düştüler. Eğer Rabbinin verilmiş bir sözü olmasaydı, aralarında çoktan hükmedilmiş olurdu. Doğrusu onlar, Kitap'ın Allah katından olduğunda şüphe ve endişe içindedirler.","numberInSurah":110,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1584,"text":"Rabbin, onların işlerinin karşılığını elbette tamamen verecektir. O, şüphesiz, onların yaptıklarını bilir.","numberInSurah":111,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1585,"text":"Sen, beraberindeki tevbe edenlerle birlikte emrolunduğun gibi dosdoğru ol. Aşırı gitmeyin, doğrusu Allah yaptıklarınızı görür.","numberInSurah":112,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1586,"text":"Haksızlık yapanlara yönelmeyin, yoksa ateş size de dokunur. Sizin Allah'tan başka dostunuz yoktur; sonra, yardım da göremezsiniz.","numberInSurah":113,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1587,"text":"Gündüzün iki ucunda ve gecenin gündüze yakın zamanlarında namaz kıl. Doğrusu iyilikler kötülükleri giderir. Bu, öğüt kabul edenlere bir öğüttür.","numberInSurah":114,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1588,"text":"Sabret, Allah iyi davrananların ecrini elbette zayi etmez.","numberInSurah":115,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1589,"text":"Sizden önceki nesillerin ileri gelenleri, yeryüzünde bozgunculuğa engel olmalı değil miydiler? Onlardan kurtardıklarımız pek azdır. Kendilerine verilen nimete karşı haksızlık edenlere uyanlar ise suçlu oldular.","numberInSurah":116,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1590,"text":"Rabbin, kasabaların halkı ıslah olmuşken, haksız yere onları yok etmez.","numberInSurah":117,"juz":12,"manzil":3,"page":234,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1591,"text":"Eğer Rabbin dileseydi insanları tek bir ümmet kılardı. Fakat, Rabbinin merhamet ettikleri bir yana, hala ayrılıktadırlar, esasen onları bunun için yaratmıştır. Rabbinin \"And olsun ki cehennemi hep insan ve cin ile dolduracağım\" sözü yerine gelmiştir.","numberInSurah":118,"juz":12,"manzil":3,"page":235,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1592,"text":"Eğer Rabbin dileseydi insanları tek bir ümmet kılardı. Fakat, Rabbinin merhamet ettikleri bir yana, hala ayrılıktadırlar, esasen onları bunun için yaratmıştır. Rabbinin \"And olsun ki cehennemi hep insan ve cin ile dolduracağım\" sözü yerine gelmiştir.","numberInSurah":119,"juz":12,"manzil":3,"page":235,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1593,"text":"Peygamberlerin başlarından geçenlerden, sana anlattığımız her şey, senin gönlünü pekiştirmemizi sağlar; sana bu belgelerle gerçek; inananlara da öğüt ve hatırlatma gelmiştir.","numberInSurah":120,"juz":12,"manzil":3,"page":235,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1594,"text":"İnanmayanlara: \"Durumunuzun gerektirdiğini yapın, doğrusu biz de yapıyoruz; bekleyin, biz de bekliyoruz\" de.","numberInSurah":121,"juz":12,"manzil":3,"page":235,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1595,"text":"İnanmayanlara: \"Durumunuzun gerektirdiğini yapın, doğrusu biz de yapıyoruz; bekleyin, biz de bekliyoruz\" de.","numberInSurah":122,"juz":12,"manzil":3,"page":235,"ruku":192,"hizbQuarter":94,"sajda":false},{"number":1596,"text":"Göklerin ve yerin gaybı Allah'a aittir. Bütün işler O'na döndürülür. Öyleyse O'na kulluk et, O'na güven. Rabbin, yaptıklarınızdan habersiz değildir.","numberInSurah":123,"juz":12,"manzil":3,"page":235,"ruku":192,"hizbQuarter":94,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}