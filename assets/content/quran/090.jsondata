{"arabic":{"number":90,"name":"سُورَةُ البَلَدِ","englishName":"Beled","englishNameTranslation":"The City","revelationType":"Meccan","numberOfAyahs":20,"ayahs":[{"number":6024,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ لَا أُقْسِمُ بِهَٰذَا الْبَلَدِ","numberInSurah":1,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6025,"text":"وَأَنْتَ حِلٌّ بِهَٰذَا الْبَلَدِ","numberInSurah":2,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6026,"text":"وَوَالِدٍ وَمَا وَلَدَ","numberInSurah":3,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6027,"text":"لَقَدْ خَلَقْنَا الْإِنْسَانَ فِي كَبَدٍ","numberInSurah":4,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6028,"text":"أَيَحْسَبُ أَنْ لَنْ يَقْدِرَ عَلَيْهِ أَحَدٌ","numberInSurah":5,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6029,"text":"يَقُولُ أَهْلَكْتُ مَالًا لُبَدًا","numberInSurah":6,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6030,"text":"أَيَحْسَبُ أَنْ لَمْ يَرَهُ أَحَدٌ","numberInSurah":7,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6031,"text":"أَلَمْ نَجْعَلْ لَهُ عَيْنَيْنِ","numberInSurah":8,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6032,"text":"وَلِسَانًا وَشَفَتَيْنِ","numberInSurah":9,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6033,"text":"وَهَدَيْنَاهُ النَّجْدَيْنِ","numberInSurah":10,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6034,"text":"فَلَا اقْتَحَمَ الْعَقَبَةَ","numberInSurah":11,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6035,"text":"وَمَا أَدْرَاكَ مَا الْعَقَبَةُ","numberInSurah":12,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6036,"text":"فَكُّ رَقَبَةٍ","numberInSurah":13,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6037,"text":"أَوْ إِطْعَامٌ فِي يَوْمٍ ذِي مَسْغَبَةٍ","numberInSurah":14,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6038,"text":"يَتِيمًا ذَا مَقْرَبَةٍ","numberInSurah":15,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6039,"text":"أَوْ مِسْكِينًا ذَا مَتْرَبَةٍ","numberInSurah":16,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6040,"text":"ثُمَّ كَانَ مِنَ الَّذِينَ آمَنُوا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِ","numberInSurah":17,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6041,"text":"أُولَٰئِكَ أَصْحَابُ الْمَيْمَنَةِ","numberInSurah":18,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6042,"text":"وَالَّذِينَ كَفَرُوا بِآيَاتِنَا هُمْ أَصْحَابُ الْمَشْأَمَةِ","numberInSurah":19,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6043,"text":"عَلَيْهِمْ نَارٌ مُؤْصَدَةٌ","numberInSurah":20,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":90,"name":"سُورَةُ البَلَدِ","englishName":"Beled","englishNameTranslation":"The City","revelationType":"Meccan","numberOfAyahs":20,"ayahs":[{"number":6024,"text":"Bu şehre (Mekke'ye) yemin ederim; ki sen bu şehirde oturmuşsun.","numberInSurah":1,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6025,"text":"Bu şehre (Mekke'ye) yemin ederim; ki sen bu şehirde oturmuşsun.","numberInSurah":2,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6026,"text":"Doğurana ve doğurduğuna and olsun ki;","numberInSurah":3,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6027,"text":"İnsanoğlunu, zorluklara katlanacak şekilde yarattık.","numberInSurah":4,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6028,"text":"İnsanoğlu, kendisine kimsenin güç yetiremeyeceğini mi sanıyor?","numberInSurah":5,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6029,"text":"\"Yığın yığın mal tüketmişimdir\" diyor.","numberInSurah":6,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6030,"text":"O, kimsenin kendisini görmediğini mi zannediyor?","numberInSurah":7,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6031,"text":"Biz onun için iki göz, bir dil ve iki dudak var etmedik mi?","numberInSurah":8,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6032,"text":"Biz onun için iki göz, bir dil ve iki dudak var etmedik mi?","numberInSurah":9,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6033,"text":"Biz ona eğri ve doğru iki yolu da göstermedik mi?","numberInSurah":10,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6034,"text":"Ama o, zor geçidi aşmaya girişemedi.","numberInSurah":11,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6035,"text":"O zor geçidin ne olduğunu sen bilir misin?","numberInSurah":12,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6036,"text":"O geçit, bir köle ve esir azadetmek,","numberInSurah":13,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6037,"text":"Yahut, açlık gününde, yakını olan bir öksüzü, yahut toprağa serilmiş bir yoksulu doyurmaktır.","numberInSurah":14,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6038,"text":"Yahut, açlık gününde, yakını olan bir öksüzü, yahut toprağa serilmiş bir yoksulu doyurmaktır.","numberInSurah":15,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6039,"text":"Yahut, açlık gününde, yakını olan bir öksüzü, yahut toprağa serilmiş bir yoksulu doyurmaktır.","numberInSurah":16,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6040,"text":"Sonra, inanıp birbirlerine sabır tavsiye edenlerden, merhametlilerden olmayı tavsiye edenlerden olmaktır.","numberInSurah":17,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6041,"text":"İşte bunlar amel defterleri sağdan verilenlerdir.","numberInSurah":18,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6042,"text":"Ayetlerimizi inkar edenler, işte onlar amel defterleri sollarından verilenlerdir.","numberInSurah":19,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false},{"number":6043,"text":"Onlar her yönden ateşle kapatılacaklardır.","numberInSurah":20,"juz":30,"manzil":7,"page":594,"ruku":532,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}