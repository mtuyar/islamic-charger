{"arabic":{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Zilzâl","englishNameTranslation":"The Earthquake","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":6139,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِذَا زُلْزِلَتِ الْأَرْضُ زِلْزَالَهَا","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6140,"text":"وَأَخْرَجَتِ الْأَرْضُ أَثْقَالَهَا","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6141,"text":"وَقَالَ الْإِنْسَانُ مَا لَهَا","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6142,"text":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6143,"text":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6144,"text":"يَوْمَئِذٍ يَصْدُرُ النَّاسُ أَشْتَاتًا لِيُرَوْا أَعْمَالَهُمْ","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6145,"text":"فَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6146,"text":"وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُ","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":99,"name":"سُورَةُ الزَّلۡزَلَةِ","englishName":"Zilzâl","englishNameTranslation":"The Earthquake","revelationType":"Medinan","numberOfAyahs":8,"ayahs":[{"number":6139,"text":"Yer dehşetle sarsıldıkça sarsıldığı, yeryüzü ağırlıklarını dışarıya çıkardığı ve insanın: \"Buna ne oluyor?\" dediği zaman;","numberInSurah":1,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6140,"text":"Yer dehşetle sarsıldıkça sarsıldığı, yeryüzü ağırlıklarını dışarıya çıkardığı ve insanın: \"Buna ne oluyor?\" dediği zaman;","numberInSurah":2,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6141,"text":"Yer dehşetle sarsıldıkça sarsıldığı, yeryüzü ağırlıklarını dışarıya çıkardığı ve insanın: \"Buna ne oluyor?\" dediği zaman;","numberInSurah":3,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6142,"text":"İşte o gün, yer, Rabbinin ona vahyetmesiyle kendi haberlerini anlatır.","numberInSurah":4,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6143,"text":"İşte o gün, yer, Rabbinin ona vahyetmesiyle kendi haberlerini anlatır.","numberInSurah":5,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6144,"text":"O gün insanlar işlerinin kendilerine gösterilmesi için bölük bölük dönerler.","numberInSurah":6,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6145,"text":"Kim zerre kadar iyilik yapmışsa onu görür.","numberInSurah":7,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false},{"number":6146,"text":"Kim de zerre kadar kötülük yapmışsa onu görür.","numberInSurah":8,"juz":30,"manzil":7,"page":599,"ruku":541,"hizbQuarter":239,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}