ge":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5069,"text":"وَأَمَّا إِنْ كَانَ مِنْ أَصْحَابِ الْيَمِينِ","numberInSurah":90,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5070,"text":"فَسَلَامٌ لَكَ مِنْ أَصْحَابِ الْيَمِينِ","numberInSurah":91,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5071,"text":"وَأَمَّا إِنْ كَانَ مِنَ الْمُكَذِّبِينَ الضَّالِّينَ","numberInSurah":92,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5072,"text":"فَنُزُلٌ مِنْ حَمِيمٍ","numberInSurah":93,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5073,"text":"وَتَصْلِيَةُ جَحِيمٍ","numberInSurah":94,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5074,"text":"إِنَّ هَٰذَا لَهُوَ حَقُّ الْيَقِينِ","numberInSurah":95,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5075,"text":"فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ","numberInSurah":96,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":56,"name":"سُورَةُ الوَاقِعَةِ","englishName":"Vâkıa","englishNameTranslation":"The Inevitable","revelationType":"Meccan","numberOfAyahs":96,"ayahs":[{"number":4980,"text":"Kıyamet koptuğunda kimini alçaltacak ve kimini yükseltecek olan o hadisenin yalan olmadığı ortaya çıkacaktır.","numberInSurah":1,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4981,"text":"Kıyamet koptuğunda kimini alçaltacak ve kimini yükseltecek olan o hadisenin yalan olmadığı ortaya çıkacaktır.","numberInSurah":2,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4982,"text":"Kıyamet koptuğunda kimini alçaltacak ve kimini yükseltecek olan o hadisenin yalan olmadığı ortaya çıkacaktır.","numberInSurah":3,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4983,"text":"Ey insanlar! Yer sarsıldıkça sarsıldığı, dağlar ufalandıkça ufalanıp da toz duman haline geldiği zaman, siz de üç sınıf olursunuz.","numberInSurah":4,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4984,"text":"Ey insanlar! Yer sarsıldıkça sarsıldığı, dağlar ufalandıkça ufalanıp da toz duman haline geldiği zaman, siz de üç sınıf olursunuz.","numberInSurah":5,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4985,"text":"Ey insanlar! Yer sarsıldıkça sarsıldığı, dağlar ufalandıkça ufalanıp da toz duman haline geldiği zaman, siz de üç sınıf olursunuz.","numberInSurah":6,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4986,"text":"Ey insanlar! Yer sarsıldıkça sarsıldığı, dağlar ufalandıkça ufalanıp da toz duman haline geldiği zaman, siz de üç sınıf olursunuz.","numberInSurah":7,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4987,"text":"İyi işler işlediklerini belirtmek için, amel defterleri sağdan verilenler; ne mutlu o sağcılara!","numberInSurah":8,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4988,"text":"Kötülük işlediklerini belirtmek üzere, amel defterleri soldan verilenler; ne yazık o solculara!","numberInSurah":9,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4989,"text":"İyilik işlemekte önde olanlar, karşılıklarını almakta da önde olanlardır.","numberInSurah":10,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4990,"text":"Naim cennetlerinde Allah'a en çok yaklaştırılmış olanlar işte bunlardır.","numberInSurah":11,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4991,"text":"Naim cennetlerinde Allah'a en çok yaklaştırılmış olanlar işte bunlardır.","numberInSurah":12,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4992,"text":"Onların büyük kısmı eski ümmetlerden, bir kısmı da sonrakilerdendir.","numberInSurah":13,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4993,"text":"Onların büyük kısmı eski ümmetlerden, bir kısmı da sonrakilerdendir.","numberInSurah":14,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4994,"text":"Mücevheratla işlenmiş tahtlara karşılıklı olarak yaslanırlar.","numberInSurah":15,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4995,"text":"Mücevheratla işlenmiş tahtlara karşılıklı olarak yaslanırlar.","numberInSurah":16,"juz":27,"manzil":7,"page":534,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4996,"text":"Ölümsüz gençler yanlarında, baş ağrısı ve dönmesi vermeyen bembeyaz bir kaynaktan doldurulmuş kaseler, ibrikler, kadehler; seçecekleri meyveler, arzulayacakları kuş eti ile dolaşırlar.","numberInSurah":17,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4997,"text":"Ölümsüz gençler yanlarında, baş ağrısı ve dönmesi vermeyen bembeyaz bir kaynaktan doldurulmuş kaseler, ibrikler, kadehler; seçecekleri meyveler, arzulayacakları kuş eti ile dolaşırlar.","numberInSurah":18,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4998,"text":"Ölümsüz gençler yanlarında, baş ağrısı ve dönmesi vermeyen bembeyaz bir kaynaktan doldurulmuş kaseler, ibrikler, kadehler; seçecekleri meyveler, arzulayacakları kuş eti ile dolaşırlar.","numberInSurah":19,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":4999,"text":"Ölümsüz gençler yanlarında, baş ağrısı ve dönmesi vermeyen bembeyaz bir kaynaktan doldurulmuş kaseler, ibrikler, kadehler; seçecekleri meyveler, arzulayacakları kuş eti ile dolaşırlar.","numberInSurah":20,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5000,"text":"Ölümsüz gençler yanlarında, baş ağrısı ve dönmesi vermeyen bembeyaz bir kaynaktan doldurulmuş kaseler, ibrikler, kadehler; seçecekleri meyveler, arzulayacakları kuş eti ile dolaşırlar.","numberInSurah":21,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5001,"text":"İşlediklerine karşılık olarak, sedefteki inciler gibi ceylan gözlüler vardır. Orada boş ve günaha sokacak bir söz duymazlar.","numberInSurah":22,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5002,"text":"İşlediklerine karşılık olarak, sedefteki inciler gibi ceylan gözlüler vardır. Orada boş ve günaha sokacak bir söz duymazlar.","numberInSurah":23,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5003,"text":"İşlediklerine karşılık olarak, sedefteki inciler gibi ceylan gözlüler vardır. Orada boş ve günaha sokacak bir söz duymazlar.","numberInSurah":24,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5004,"text":"Sadece selama karşılık selam sözü işitirler.","numberInSurah":25,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5005,"text":"Defterleri sağdan verilenler; ne mutlu o sağcılara!","numberInSurah":26,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5006,"text":"Onlar dikensiz sedir ağaçları, salkımları sarkmış muz ağaçları, uzamış gölge altında, çağlayarak akan sular kenarlarında; bitip tükenmeyen ve yasak da edilmeyen bol meyveler arasında; yüksek döşekler üzerindedirler.","numberInSurah":27,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5007,"text":"Onlar dikensiz sedir ağaçları, salkımları sarkmış muz ağaçları, uzamış gölge altında, çağlayarak akan sular kenarlarında; bitip tükenmeyen ve yasak da edilmeyen bol meyveler arasında; yüksek döşekler üzerindedirler.","numberInSurah":28,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5008,"text":"Onlar dikensiz sedir ağaçları, salkımları sarkmış muz ağaçları, uzamış gölge altında, çağlayarak akan sular kenarlarında; bitip tükenmeyen ve yasak da edilmeyen bol meyveler arasında; yüksek döşekler üzerindedirler.","numberInSurah":29,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5009,"text":"Onlar dikensiz sedir ağaçları, salkımları sarkmış muz ağaçları, uzamış gölge altında, çağlayarak akan sular kenarlarında; bitip tükenmeyen ve yasak da edilmeyen bol meyveler arasında; yüksek döşekler üzerindedirler.","numberInSurah":30,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5010,"text":"Onlar dikensiz sedir ağaçları, salkımları sarkmış muz ağaçları, uzamış gölge altında, çağlayarak akan sular kenarlarında; bitip tükenmeyen ve yasak da edilmeyen bol meyveler arasında; yüksek döşekler üzerindedirler.","numberInSurah":31,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5011,"text":"Onlar dikensiz sedir ağaçları, salkımları sarkmış muz ağaçları, uzamış gölge altında, çağlayarak akan sular kenarlarında; bitip tükenmeyen ve yasak da edilmeyen bol meyveler arasında; yüksek döşekler üzerindedirler.","numberInSurah":32,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5012,"text":"Onlar dikensiz sedir ağaçları, salkımları sarkmış muz ağaçları, uzamış gölge altında, çağlayarak akan sular kenarlarında; bitip tükenmeyen ve yasak da edilmeyen bol meyveler arasında; yüksek döşekler üzerindedirler.","numberInSurah":33,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5013,"text":"Onlar dikensiz sedir ağaçları, salkımları sarkmış muz ağaçları, uzamış gölge altında, çağlayarak akan sular kenarlarında; bitip tükenmeyen ve yasak da edilmeyen bol meyveler arasında; yüksek döşekler üzerindedirler.","numberInSurah":34,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5014,"text":"Biz ceylan gözlüleri, defterleri sağdan verilenler için yeniden yaratmışızdır; onları bakire, eşlerine düşkün ve hepsini bir yaşta kılmışızdır.","numberInSurah":35,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5015,"text":"Biz ceylan gözlüleri, defterleri sağdan verilenler için yeniden yaratmışızdır; onları bakire, eşlerine düşkün ve hepsini bir yaşta kılmışızdır.","numberInSurah":36,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5016,"text":"Biz ceylan gözlüleri, defterleri sağdan verilenler için yeniden yaratmışızdır; onları bakire, eşlerine düşkün ve hepsini bir yaşta kılmışızdır.","numberInSurah":37,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5017,"text":"Biz ceylan gözlüleri, defterleri sağdan verilenler için yeniden yaratmışızdır; onları bakire, eşlerine düşkün ve hepsini bir yaşta kılmışızdır.","numberInSurah":38,"juz":27,"manzil":7,"page":535,"ruku":469,"hizbQuarter":214,"sajda":false},{"number":5018,"text":"Bunların bir kısmı eski ümmetlerden, bir kısmı da sonrakilerdendir.","numberInSurah":39,"juz":27,"manzil":7,"page":535,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5019,"text":"Bunların bir kısmı eski ümmetlerden, bir kısmı da sonrakilerdendir.","numberInSurah":40,"juz":27,"manzil":7,"page":535,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5020,"text":"Defterleri soldan verilenler; ne yazık o solculara!","numberInSurah":41,"juz":27,"manzil":7,"page":535,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5021,"text":"İnsanın içine işleyen bir sıcaklık ve kaynar su içinde, serinliği ve hoşluğu olmayan kara bir dumanın gölgesinde bulunurlar.","numberInSurah":42,"juz":27,"manzil":7,"page":535,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5022,"text":"İnsanın içine işleyen bir sıcaklık ve kaynar su içinde, serinliği ve hoşluğu olmayan kara bir dumanın gölgesinde bulunurlar.","numberInSurah":43,"juz":27,"manzil":7,"page":535,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5023,"text":"İnsanın içine işleyen bir sıcaklık ve kaynar su içinde, serinliği ve hoşluğu olmayan kara bir dumanın gölgesinde bulunurlar.","numberInSurah":44,"juz":27,"manzil":7,"page":535,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5024,"text":"Çünkü onlar, bundan önce, dünyada, nimet içinde bulunurlar iken, büyük günah işlemekte direnir dururlardı.","numberInSurah":45,"juz":27,"manzil":7,"page":535,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5025,"text":"Çünkü onlar, bundan önce, dünyada, nimet içinde bulunurlar iken, büyük günah işlemekte direnir dururlardı.","numberInSurah":46,"juz":27,"manzil":7,"page":535,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5026,"text":"Şöyle söylerlerdi: \"Öldüğümüzde, toprak ve kemik yığını olduğumuzda mı, biz mi tekrar dirileceğiz?\"","numberInSurah":47,"juz":27,"manzil":7,"page":535,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5027,"text":"\"Önce gelip geçmiş babalarımız da mı?\"","numberInSurah":48,"juz":27,"manzil":7,"page":535,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5028,"text":"De ki: \"Şüphesiz öncekiler de, sonrakiler de belli bir günün belirli bir vaktinde toplanacaklardır.\"","numberInSurah":49,"juz":27,"manzil":7,"page":535,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5029,"text":"De ki: \"Şüphesiz öncekiler de, sonrakiler de belli bir günün belirli bir vaktinde toplanacaklardır.\"","numberInSurah":50,"juz":27,"manzil":7,"page":535,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5030,"text":"Sonra, siz ey sapıklar, yalanlayanlar!","numberInSurah":51,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5031,"text":"Doğrusu bir zakkum ağacından yiyeceksiniz.","numberInSurah":52,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5032,"text":"Karınlarınızı onunla dolduracaksınız;","numberInSurah":53,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5033,"text":"Onun üzerine kaynar su içeceksiniz;","numberInSurah":54,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5034,"text":"Hem de susamış develerin suya saldırışı gibi içeceksiniz;","numberInSurah":55,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5035,"text":"İşte onlara, ceza günü sunulacak konukluk budur.","numberInSurah":56,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5036,"text":"Sizi yaratan Biziz; hala tasdik etmez misiniz?","numberInSurah":57,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5037,"text":"Söyleyin; akıttığınız meniden insanı yaratan siz misiniz, yoksa Biz mi yaratmaktayız?","numberInSurah":58,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5038,"text":"Söyleyin; akıttığınız meniden insanı yaratan siz misiniz, yoksa Biz mi yaratmaktayız?","numberInSurah":59,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5039,"text":"Ölümü aranızda Biz tayin ettik; sizi ortadan kaldırıp benzerlerinizi yerinize getirmeyi, sizi bilmediğiniz şekilde var etmeyi dilesek kimse önümüze geçemez.","numberInSurah":60,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5040,"text":"Ölümü aranızda Biz tayin ettik; sizi ortadan kaldırıp benzerlerinizi yerinize getirmeyi, sizi bilmediğiniz şekilde var etmeyi dilesek kimse önümüze geçemez.","numberInSurah":61,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5041,"text":"And olsun ki, ilk yaratmayı bilirsiniz, yine de düşünmez misiniz?","numberInSurah":62,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5042,"text":"Söyleyin, ektiklerinizi yerden bitirenler sizler misiniz, yoksa Biz mi bitiriyoruz?","numberInSurah":63,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5043,"text":"Söyleyin, ektiklerinizi yerden bitirenler sizler misiniz, yoksa Biz mi bitiriyoruz?","numberInSurah":64,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5044,"text":"Dilersek Biz onu çerçöp yaparız, şaşar kalırsınız; \"Doğrusu borç altına girdik, hatta yoksun kaldık\".","numberInSurah":65,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5045,"text":"Dilersek Biz onu çerçöp yaparız, şaşar kalırsınız; \"Doğrusu borç altına girdik, hatta yoksun kaldık\".","numberInSurah":66,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5046,"text":"Dilersek Biz onu çerçöp yaparız, şaşar kalırsınız; \"Doğrusu borç altına girdik, hatta yoksun kaldık\".","numberInSurah":67,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5047,"text":"Söyleyin; içtiğiniz suyu buluttan indirenler sizler misiniz yoksa onu Biz mi indiririz?","numberInSurah":68,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5048,"text":"Söyleyin; içtiğiniz suyu buluttan indirenler sizler misiniz yoksa onu Biz mi indiririz?","numberInSurah":69,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5049,"text":"Dileseydik onu acılaştırırdık; hala şükretmez misiniz?","numberInSurah":70,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5050,"text":"Söyleyin; yaktığınız ateşin ağacını var eden sizler misiniz, yoksa onu Biz mi var ederiz?","numberInSurah":71,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5051,"text":"Söyleyin; yaktığınız ateşin ağacını var eden sizler misiniz, yoksa onu Biz mi var ederiz?","numberInSurah":72,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5052,"text":"Biz onu bir ibret ve çölde konaklayanlar için yararlı kıldık.","numberInSurah":73,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5053,"text":"Öyleyse çok büyük Rabbinin adını tesbih et.","numberInSurah":74,"juz":27,"manzil":7,"page":536,"ruku":470,"hizbQuarter":214,"sajda":false},{"number":5054,"text":"Hayır; yıldızların yerleri üzerine yemin ederim; ki bunun ne büyük yemin olduğunu bir bilseniz!","numberInSurah":75,"juz":27,"manzil":7,"page":536,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5055,"text":"Hayır; yıldızların yerleri üzerine yemin ederim; ki bunun ne büyük yemin olduğunu bir bilseniz!","numberInSurah":76,"juz":27,"manzil":7,"page":536,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5056,"text":"Doğrusu bu Kitap, sadece arınmış olanların dokunabileceği, saklı bir Kitap'da mevcutken Alemlerin Rabbi tarafından indirilmiş olan Kuranı Kerim'dir.","numberInSurah":77,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5057,"text":"Doğrusu bu Kitap, sadece arınmış olanların dokunabileceği, saklı bir Kitap'da mevcutken Alemlerin Rabbi tarafından indirilmiş olan Kuranı Kerim'dir.","numberInSurah":78,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5058,"text":"Doğrusu bu Kitap, sadece arınmış olanların dokunabileceği, saklı bir Kitap'da mevcutken Alemlerin Rabbi tarafından indirilmiş olan Kuranı Kerim'dir.","numberInSurah":79,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5059,"text":"Doğrusu bu Kitap, sadece arınmış olanların dokunabileceği, saklı bir Kitap'da mevcutken Alemlerin Rabbi tarafından indirilmiş olan Kuranı Kerim'dir.","numberInSurah":80,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5060,"text":"Siz bu sözü mü hor görüyorsunuz?","numberInSurah":81,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5061,"text":"Rızkınıza şükredeceğiniz yere onu vereni mi yalanlıyorsunuz?","numberInSurah":82,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5062,"text":"Kişinin canı boğaza dayanınca ve siz o zaman bakıp kalırken, Biz o kişiye sizden daha yakınızdır, ama görmezsiniz.","numberInSurah":83,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5063,"text":"Kişinin canı boğaza dayanınca ve siz o zaman bakıp kalırken, Biz o kişiye sizden daha yakınızdır, ama görmezsiniz.","numberInSurah":84,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5064,"text":"Kişinin canı boğaza dayanınca ve siz o zaman bakıp kalırken, Biz o kişiye sizden daha yakınızdır, ama görmezsiniz.","numberInSurah":85,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5065,"text":"Siz dirilip yaptıklarınıza karşılık görmeyecekseniz ve eğer bu sözünüzde samimi iseniz, o çıkmak üzere olan canı geri çevirsenize!","numberInSurah":86,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5066,"text":"Siz dirilip yaptıklarınıza karşılık görmeyecekseniz ve eğer bu sözünüzde samimi iseniz, o çıkmak üzere olan canı geri çevirsenize!","numberInSurah":87,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5067,"text":"Eğer ölen o kişi, gözdelerden ise, rahatlık, hoşluk ve nimet cenneti onundur.","numberInSurah":88,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5068,"text":"Eğer ölen o kişi, gözdelerden ise, rahatlık, hoşluk ve nimet cenneti onundur.","numberInSurah":89,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5069,"text":"Eğer defteri sağdan verilenlerden ise,","numberInSurah":90,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5070,"text":"\"Ey sağcılardan olan kişi, sana selam olsun!\" denir.","numberInSurah":91,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5071,"text":"Eğer, sapık yalancılardan ise,","numberInSurah":92,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5072,"text":"Ona kaynar sudan konukluk sunulur.","numberInSurah":93,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5073,"text":"Cehenneme sokulur.","numberInSurah":94,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5074,"text":"Doğrusu kesin gerçek budur.","numberInSurah":95,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false},{"number":5075,"text":"Öyleyse çok büyük Rabbinin adını tesbih et.","numberInSurah":96,"juz":27,"manzil":7,"page":537,"ruku":471,"hizbQuarter":215,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}