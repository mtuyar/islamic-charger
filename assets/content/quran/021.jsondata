{"arabic":{"number":21,"name":"سُورَةُ الأَنبِيَاءِ","englishName":"Enbiyâ","englishNameTranslation":"The Prophets","revelationType":"Meccan","numberOfAyahs":112,"ayahs":[{"number":2484,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ اقْتَرَبَ لِلنَّاسِ حِسَابُهُمْ وَهُمْ فِي غَفْلَةٍ مُعْرِضُونَ","numberInSurah":1,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2485,"text":"مَا يَأْتِيهِمْ مِنْ ذِكْرٍ مِنْ رَبِّهِمْ مُحْدَثٍ إِلَّا اسْتَمَعُوهُ وَهُمْ يَلْعَبُونَ","numberInSurah":2,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2486,"text":"لَاهِيَةً قُلُوبُهُمْ ۗ وَأَسَرُّوا النَّجْوَى الَّذِينَ ظَلَمُوا هَلْ هَٰذَا إِلَّا بَشَرٌ مِثْلُكُمْ ۖ أَفَتَأْتُونَ السِّحْرَ وَأَنْتُمْ تُبْصِرُونَ","numberInSurah":3,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2487,"text":"قَالَ رَبِّي يَعْلَمُ الْقَوْلَ فِي السَّمَاءِ وَالْأَرْضِ ۖ وَهُوَ السَّمِيعُ الْعَلِيمُ","numberInSurah":4,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2488,"text":"بَلْ قَالُوا أَضْغَاثُ أَحْلَامٍ بَلِ افْتَرَاهُ بَلْ هُوَ شَاعِرٌ فَلْيَأْتِنَا بِآيَةٍ كَمَا أُرْسِلَ الْأَوَّلُونَ","numberInSurah":5,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2489,"text":"مَا آمَنَتْ قَبْلَهُمْ مِنْ قَرْيَةٍ أَهْلَكْنَاهَا ۖ أَفَهُمْ يُؤْمِنُونَ","numberInSurah":6,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2490,"text":"وَمَا أَرْسَلْنَا قَبْلَكَ إِلَّا رِجَالًا نُوحِي إِلَيْهِمْ ۖ فَاسْأَلُوا أَهْلَ الذِّكْرِ إِنْ كُنْتُمْ لَا تَعْلَمُونَ","numberInSurah":7,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2491,"text":"وَمَا جَعَلْنَاهُمْ جَسَدًا لَا يَأْكُلُونَ الطَّعَامَ وَمَا كَانُوا خَالِدِينَ","numberInSurah":8,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2492,"text":"ثُمَّ صَدَقْنَاهُمُ الْوَعْدَ فَأَنْجَيْنَاهُمْ وَمَنْ نَشَاءُ وَأَهْلَكْنَا الْمُسْرِفِينَ","numberInSurah":9,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2493,"text":"لَقَدْ أَنْزَلْنَا إِلَيْكُمْ كِتَابًا فِيهِ ذِكْرُكُمْ ۖ أَفَلَا تَعْقِلُونَ","numberInSurah":10,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2494,"text":"وَكَمْ قَصَمْنَا مِنْ قَرْيَةٍ كَانَتْ ظَالِمَةً وَأَنْشَأْنَا بَعْدَهَا قَوْمًا آخَرِينَ","numberInSurah":11,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2495,"text":"فَلَمَّا أَحَسُّوا بَأْسَنَا إِذَا هُمْ مِنْهَا يَرْكُضُونَ","numberInSurah":12,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2496,"text":"لَا تَرْكُضُوا وَارْجِعُوا إِلَىٰ مَا أُتْرِفْتُمْ فِيهِ وَمَسَاكِنِكُمْ لَعَلَّكُمْ تُسْأَلُونَ","numberInSurah":13,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2497,"text":"قَالُوا يَا وَيْلَنَا إِنَّا كُنَّا ظَالِمِينَ","numberInSurah":14,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2498,"text":"فَمَا زَالَتْ تِلْكَ دَعْوَاهُمْ حَتَّىٰ جَعَلْنَاهُمْ حَصِيدًا خَامِدِينَ","numberInSurah":15,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2499,"text":"وَمَا خَلَقْنَا السَّمَاءَ وَالْأَرْضَ وَمَا بَيْنَهُمَا لَاعِبِينَ","numberInSurah":16,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2500,"text":"لَوْ أَرَدْنَا أَنْ نَتَّخِذَ لَهْوًا لَاتَّخَذْنَاهُ مِنْ لَدُنَّا إِنْ كُنَّا فَاعِلِينَ","numberInSurah":17,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2501,"text":"بَلْ نَقْذِفُ بِالْحَقِّ عَلَى الْبَاطِلِ فَيَدْمَغُهُ فَإِذَا هُوَ زَاهِقٌ ۚ وَلَكُمُ الْوَيْلُ مِمَّا تَصِفُونَ","numberInSurah":18,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2502,"text":"وَلَهُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ ۚ وَمَنْ عِنْدَهُ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِ وَلَا يَسْتَحْسِرُونَ","numberInSurah":19,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2503,"text":"يُسَبِّحُونَ اللَّيْلَ وَالنَّهَارَ لَا يَفْتُرُونَ","numberInSurah":20,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2504,"text":"أَمِ اتَّخَذُوا آلِهَةً مِنَ الْأَرْضِ هُمْ يُنْشِرُونَ","numberInSurah":21,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2505,"text":"لَوْ كَانَ فِيهِمَا آلِهَةٌ إِلَّا اللَّهُ لَفَسَدَتَا ۚ فَسُبْحَانَ اللَّهِ رَبِّ الْعَرْشِ عَمَّا يَصِفُونَ","numberInSurah":22,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2506,"text":"لَا يُسْأَلُ عَمَّا يَفْعَلُ وَهُمْ يُسْأَلُونَ","numberInSurah":23,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2507,"text":"أَمِ اتَّخَذُوا مِنْ دُونِهِ آلِهَةً ۖ قُلْ هَاتُوا بُرْهَانَكُمْ ۖ هَٰذَا ذِكْرُ مَنْ مَعِيَ وَذِكْرُ مَنْ قَبْلِي ۗ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ الْحَقَّ ۖ فَهُمْ مُعْرِضُونَ","numberInSurah":24,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2508,"text":"وَمَا أَرْسَلْنَا مِنْ قَبْلِكَ مِنْ رَسُولٍ إِلَّا نُوحِي إِلَيْهِ أَنَّهُ لَا إِلَٰهَ إِلَّا أَنَا فَاعْبُدُونِ","numberInSurah":25,"juz":17,"manzil":4,"page":324,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2509,"text":"وَقَالُوا اتَّخَذَ الرَّحْمَٰنُ وَلَدًا ۗ سُبْحَانَهُ ۚ بَلْ عِبَادٌ مُكْرَمُونَ","numberInSurah":26,"juz":17,"manzil":4,"page":324,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2510,"text":"لَا يَسْبِقُونَهُ بِالْقَوْلِ وَهُمْ بِأَمْرِهِ يَعْمَلُونَ","numberInSurah":27,"juz":17,"manzil":4,"page":324,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2511,"text":"يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يَشْفَعُونَ إِلَّا لِمَنِ ارْتَضَىٰ وَهُمْ مِنْ خَشْيَتِهِ مُشْفِقُونَ","numberInSurah":28,"juz":17,"manzil":4,"page":324,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2512,"text":"۞ وَمَنْ يَقُلْ مِنْهُمْ إِنِّي إِلَٰهٌ مِنْ دُونِهِ فَذَٰلِكَ نَجْزِيهِ جَهَنَّمَ ۚ كَذَٰلِكَ نَجْزِي الظَّالِمِينَ","numberInSurah":29,"juz":17,"manzil":4,"page":324,"ruku":279,"hizbQuarter":130,"sajda":false},{"number":2513,"text":"أَوَلَمْ يَرَ الَّذِينَ كَفَرُوا أَنَّ السَّمَاوَاتِ وَالْأَرْضَ كَانَتَا رَتْقًا فَفَتَقْنَاهُمَا ۖ وَجَعَلْنَا مِنَ الْمَاءِ كُلَّ شَيْءٍ حَيٍّ ۖ أَفَلَا يُؤْمِنُونَ","numberInSurah":30,"juz":17,"manzil":4,"page":324,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2514,"text":"وَجَعَلْنَا فِي الْأَرْضِ رَوَاسِيَ أَنْ تَمِيدَ بِهِمْ وَجَعَلْنَا فِيهَا فِجَاجًا سُبُلًا لَعَلَّهُمْ يَهْتَدُونَ","numberInSurah":31,"juz":17,"manzil":4,"page":324,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2515,"text":"وَجَعَلْنَا السَّمَاءَ سَقْفًا مَحْفُوظًا ۖ وَهُمْ عَنْ آيَاتِهَا مُعْرِضُونَ","numberInSurah":32,"juz":17,"manzil":4,"page":324,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2516,"text":"وَهُوَ الَّذِي خَلَقَ اللَّيْلَ وَالنَّهَارَ وَالشَّمْسَ وَالْقَمَرَ ۖ كُلٌّ فِي فَلَكٍ يَسْبَحُونَ","numberInSurah":33,"juz":17,"manzil":4,"page":324,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2517,"text":"وَمَا جَعَلْنَا لِبَشَرٍ مِنْ قَبْلِكَ الْخُلْدَ ۖ أَفَإِنْ مِتَّ فَهُمُ الْخَالِدُونَ","numberInSurah":34,"juz":17,"manzil":4,"page":324,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2518,"text":"كُلُّ نَفْسٍ ذَائِقَةُ الْمَوْتِ ۗ وَنَبْلُوكُمْ بِالشَّرِّ وَالْخَيْرِ فِتْنَةً ۖ وَإِلَيْنَا تُرْجَعُونَ","numberInSurah":35,"juz":17,"manzil":4,"page":324,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2519,"text":"وَإِذَا رَآكَ الَّذِينَ كَفَرُوا إِنْ يَتَّخِذُونَكَ إِلَّا هُزُوًا أَهَٰذَا الَّذِي يَذْكُرُ آلِهَتَكُمْ وَهُمْ بِذِكْرِ الرَّحْمَٰنِ هُمْ كَافِرُونَ","numberInSurah":36,"juz":17,"manzil":4,"page":325,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2520,"text":"خُلِقَ الْإِنْسَانُ مِنْ عَجَلٍ ۚ سَأُرِيكُمْ آيَاتِي فَلَا تَسْتَعْجِلُونِ","numberInSurah":37,"juz":17,"manzil":4,"page":325,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2521,"text":"وَيَقُولُونَ مَتَىٰ هَٰذَا الْوَعْدُ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":38,"juz":17,"manzil":4,"page":325,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2522,"text":"لَوْ يَعْلَمُ الَّذِينَ كَفَرُوا حِينَ لَا يَكُفُّونَ عَنْ وُجُوهِهِمُ النَّارَ وَلَا عَنْ ظُهُورِهِمْ وَلَا هُمْ يُنْصَرُونَ","numberInSurah":39,"juz":17,"manzil":4,"page":325,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2523,"text":"بَلْ تَأْتِيهِمْ بَغْتَةً فَتَبْهَتُهُمْ فَلَا يَسْتَطِيعُونَ رَدَّهَا وَلَا هُمْ يُنْظَرُونَ","numberInSurah":40,"juz":17,"manzil":4,"page":325,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2524,"text":"وَلَقَدِ اسْتُهْزِئَ بِرُسُلٍ مِنْ قَبْلِكَ فَحَاقَ بِالَّذِينَ سَخِرُوا مِنْهُمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ","numberInSurah":41,"juz":17,"manzil":4,"page":325,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2525,"text":"قُلْ مَنْ يَكْلَؤُكُمْ بِاللَّيْلِ وَالنَّهَارِ مِنَ الرَّحْمَٰنِ ۗ بَلْ هُمْ عَنْ ذِكْرِ رَبِّهِمْ مُعْرِضُونَ","numberInSurah":42,"juz":17,"manzil":4,"page":325,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2526,"text":"أَمْ لَهُمْ آلِهَةٌ تَمْنَعُهُمْ مِنْ دُونِنَا ۚ لَا يَسْتَطِيعُونَ نَصْرَ أَنْفُسِهِمْ وَلَا هُمْ مِنَّا يُصْحَبُونَ","numberInSurah":43,"juz":17,"manzil":4,"page":325,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2527,"text":"بَلْ مَتَّعْنَا هَٰؤُلَاءِ وَآبَاءَهُمْ حَتَّىٰ طَالَ عَلَيْهِمُ الْعُمُرُ ۗ أَفَلَا يَرَوْنَ أَنَّا نَأْتِي الْأَرْضَ نَنْقُصُهَا مِنْ أَطْرَافِهَا ۚ أَفَهُمُ الْغَالِبُونَ","numberInSurah":44,"juz":17,"manzil":4,"page":325,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2528,"text":"قُلْ إِنَّمَا أُنْذِرُكُمْ بِالْوَحْيِ ۚ وَلَا يَسْمَعُ الصُّمُّ الدُّعَاءَ إِذَا مَا يُنْذَرُونَ","numberInSurah":45,"juz":17,"manzil":4,"page":326,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2529,"text":"وَلَئِنْ مَسَّتْهُمْ نَفْحَةٌ مِنْ عَذَابِ رَبِّكَ لَيَقُولُنَّ يَا وَيْلَنَا إِنَّا كُنَّا ظَالِمِينَ","numberInSurah":46,"juz":17,"manzil":4,"page":326,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2530,"text":"وَنَضَعُ الْمَوَازِينَ الْقِسْطَ لِيَوْمِ الْقِيَامَةِ فَلَا تُظْلَمُ نَفْسٌ شَيْئًا ۖ وَإِنْ كَانَ مِثْقَالَ حَبَّةٍ مِنْ خَرْدَلٍ أَتَيْنَا بِهَا ۗ وَكَفَىٰ بِنَا حَاسِبِينَ","numberInSurah":47,"juz":17,"manzil":4,"page":326,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2531,"text":"وَلَقَدْ آتَيْنَا مُوسَىٰ وَهَارُونَ الْفُرْقَانَ وَضِيَاءً وَذِكْرًا لِلْمُتَّقِينَ","numberInSurah":48,"juz":17,"manzil":4,"page":326,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2532,"text":"الَّذِينَ يَخْشَوْنَ رَبَّهُمْ بِالْغَيْبِ وَهُمْ مِنَ السَّاعَةِ مُشْفِقُونَ","numberInSurah":49,"juz":17,"manzil":4,"page":326,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2533,"text":"وَهَٰذَا ذِكْرٌ مُبَارَكٌ أَنْزَلْنَاهُ ۚ أَفَأَنْتُمْ لَهُ مُنْكِرُونَ","numberInSurah":50,"juz":17,"manzil":4,"page":326,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2534,"text":"۞ وَلَقَدْ آتَيْنَا إِبْرَاهِيمَ رُشْدَهُ مِنْ قَبْلُ وَكُنَّا بِهِ عَالِمِينَ","numberInSurah":51,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2535,"text":"إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِ مَا هَٰذِهِ التَّمَاثِيلُ الَّتِي أَنْتُمْ لَهَا عَاكِفُونَ","numberInSurah":52,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2536,"text":"قَالُوا وَجَدْنَا آبَاءَنَا لَهَا عَابِدِينَ","numberInSurah":53,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2537,"text":"قَالَ لَقَدْ كُنْتُمْ أَنْتُمْ وَآبَاؤُكُمْ فِي ضَلَالٍ مُبِينٍ","numberInSurah":54,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2538,"text":"قَالُوا أَجِئْتَنَا بِالْحَقِّ أَمْ أَنْتَ مِنَ اللَّاعِبِينَ","numberInSurah":55,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2539,"text":"قَالَ بَلْ رَبُّكُمْ رَبُّ السَّمَاوَاتِ وَالْأَرْضِ الَّذِي فَطَرَهُنَّ وَأَنَا عَلَىٰ ذَٰلِكُمْ مِنَ الشَّاهِدِينَ","numberInSurah":56,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2540,"text":"وَتَاللَّهِ لَأَكِيدَنَّ أَصْنَامَكُمْ بَعْدَ أَنْ تُوَلُّوا مُدْبِرِينَ","numberInSurah":57,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2541,"text":"فَجَعَلَهُمْ جُذَاذًا إِلَّا كَبِيرًا لَهُمْ لَعَلَّهُمْ إِلَيْهِ يَرْجِعُونَ","numberInSurah":58,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2542,"text":"قَالُوا مَنْ فَعَلَ هَٰذَا بِآلِهَتِنَا إِنَّهُ لَمِنَ الظَّالِمِينَ","numberInSurah":59,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2543,"text":"قَالُوا سَمِعْنَا فَتًى يَذْكُرُهُمْ يُقَالُ لَهُ إِبْرَاهِيمُ","numberInSurah":60,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2544,"text":"قَالُوا فَأْتُوا بِهِ عَلَىٰ أَعْيُنِ النَّاسِ لَعَلَّهُمْ يَشْهَدُونَ","numberInSurah":61,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2545,"text":"قَالُوا أَأَنْتَ فَعَلْتَ هَٰذَا بِآلِهَتِنَا يَا إِبْرَاهِيمُ","numberInSurah":62,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2546,"text":"قَالَ بَلْ فَعَلَهُ كَبِيرُهُمْ هَٰذَا فَاسْأَلُوهُمْ إِنْ كَانُوا يَنْطِقُونَ","numberInSurah":63,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2547,"text":"فَرَجَعُوا إِلَىٰ أَنْفُسِهِمْ فَقَالُوا إِنَّكُمْ أَنْتُمُ الظَّالِمُونَ","numberInSurah":64,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2548,"text":"ثُمَّ نُكِسُوا عَلَىٰ رُءُوسِهِمْ لَقَدْ عَلِمْتَ مَا هَٰؤُلَاءِ يَنْطِقُونَ","numberInSurah":65,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2549,"text":"قَالَ أَفَتَعْبُدُونَ مِنْ دُونِ اللَّهِ مَا لَا يَنْفَعُكُمْ شَيْئًا وَلَا يَضُرُّكُمْ","numberInSurah":66,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2550,"text":"أُفٍّ لَكُمْ وَلِمَا تَعْبُدُونَ مِنْ دُونِ اللَّهِ ۖ أَفَلَا تَعْقِلُونَ","numberInSurah":67,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2551,"text":"قَالُوا حَرِّقُوهُ وَانْصُرُوا آلِهَتَكُمْ إِنْ كُنْتُمْ فَاعِلِينَ","numberInSurah":68,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2552,"text":"قُلْنَا يَا نَارُ كُونِي بَرْدًا وَسَلَامًا عَلَىٰ إِبْرَاهِيمَ","numberInSurah":69,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2553,"text":"وَأَرَادُوا بِهِ كَيْدًا فَجَعَلْنَاهُمُ الْأَخْسَرِينَ","numberInSurah":70,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2554,"text":"وَنَجَّيْنَاهُ وَلُوطًا إِلَى الْأَرْضِ الَّتِي بَارَكْنَا فِيهَا لِلْعَالَمِينَ","numberInSurah":71,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2555,"text":"وَوَهَبْنَا لَهُ إِسْحَاقَ وَيَعْقُوبَ نَافِلَةً ۖ وَكُلًّا جَعَلْنَا صَالِحِينَ","numberInSurah":72,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2556,"text":"وَجَعَلْنَاهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا وَأَوْحَيْنَا إِلَيْهِمْ فِعْلَ الْخَيْرَاتِ وَإِقَامَ الصَّلَاةِ وَإِيتَاءَ الزَّكَاةِ ۖ وَكَانُوا لَنَا عَابِدِينَ","numberInSurah":73,"juz":17,"manzil":4,"page":328,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2557,"text":"وَلُوطًا آتَيْنَاهُ حُكْمًا وَعِلْمًا وَنَجَّيْنَاهُ مِنَ الْقَرْيَةِ الَّتِي كَانَتْ تَعْمَلُ الْخَبَائِثَ ۗ إِنَّهُمْ كَانُوا قَوْمَ سَوْءٍ فَاسِقِينَ","numberInSurah":74,"juz":17,"manzil":4,"page":328,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2558,"text":"وَأَدْخَلْنَاهُ فِي رَحْمَتِنَا ۖ إِنَّهُ مِنَ الصَّالِحِينَ","numberInSurah":75,"juz":17,"manzil":4,"page":328,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2559,"text":"وَنُوحًا إِذْ نَادَىٰ مِنْ قَبْلُ فَاسْتَجَبْنَا لَهُ فَنَجَّيْنَاهُ وَأَهْلَهُ مِنَ الْكَرْبِ الْعَظِيمِ","numberInSurah":76,"juz":17,"manzil":4,"page":328,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2560,"text":"وَنَصَرْنَاهُ مِنَ الْقَوْمِ الَّذِينَ كَذَّبُوا بِآيَاتِنَا ۚ إِنَّهُمْ كَانُوا قَوْمَ سَوْءٍ فَأَغْرَقْنَاهُمْ أَجْمَعِينَ","numberInSurah":77,"juz":17,"manzil":4,"page":328,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2561,"text":"وَدَاوُودَ وَسُلَيْمَانَ إِذْ يَحْكُمَانِ فِي الْحَرْثِ إِذْ نَفَشَتْ فِيهِ غَنَمُ الْقَوْمِ وَكُنَّا لِحُكْمِهِمْ شَاهِدِينَ","numberInSurah":78,"juz":17,"manzil":4,"page":328,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2562,"text":"فَفَهَّمْنَاهَا سُلَيْمَانَ ۚ وَكُلًّا آتَيْنَا حُكْمًا وَعِلْمًا ۚ وَسَخَّرْنَا مَعَ دَاوُودَ الْجِبَالَ يُسَبِّحْنَ وَالطَّيْرَ ۚ وَكُنَّا فَاعِلِينَ","numberInSurah":79,"juz":17,"manzil":4,"page":328,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2563,"text":"وَعَلَّمْنَاهُ صَنْعَةَ لَبُوسٍ لَكُمْ لِتُحْصِنَكُمْ مِنْ بَأْسِكُمْ ۖ فَهَلْ أَنْتُمْ شَاكِرُونَ","numberInSurah":80,"juz":17,"manzil":4,"page":328,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2564,"text":"وَلِسُلَيْمَانَ الرِّيحَ عَاصِفَةً تَجْرِي بِأَمْرِهِ إِلَى الْأَرْضِ الَّتِي بَارَكْنَا فِيهَا ۚ وَكُنَّا بِكُلِّ شَيْءٍ عَالِمِينَ","numberInSurah":81,"juz":17,"manzil":4,"page":328,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2565,"text":"وَمِنَ الشَّيَاطِينِ مَنْ يَغُوصُونَ لَهُ وَيَعْمَلُونَ عَمَلًا دُونَ ذَٰلِكَ ۖ وَكُنَّا لَهُمْ حَافِظِينَ","numberInSurah":82,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2566,"text":"۞ وَأَيُّوبَ إِذْ نَادَىٰ رَبَّهُ أَنِّي مَسَّنِيَ الضُّرُّ وَأَنْتَ أَرْحَمُ الرَّاحِمِينَ","numberInSurah":83,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2567,"text":"فَاسْتَجَبْنَا لَهُ فَكَشَفْنَا مَا بِهِ مِنْ ضُرٍّ ۖ وَآتَيْنَاهُ أَهْلَهُ وَمِثْلَهُمْ مَعَهُمْ رَحْمَةً مِنْ عِنْدِنَا وَذِكْرَىٰ لِلْعَابِدِينَ","numberInSurah":84,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2568,"text":"وَإِسْمَاعِيلَ وَإِدْرِيسَ وَذَا الْكِفْلِ ۖ كُلٌّ مِنَ الصَّابِرِينَ","numberInSurah":85,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2569,"text":"وَأَدْخَلْنَاهُمْ فِي رَحْمَتِنَا ۖ إِنَّهُمْ مِنَ الصَّالِحِينَ","numberInSurah":86,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2570,"text":"وَذَا النُّونِ إِذْ ذَهَبَ مُغَاضِبًا فَظَنَّ أَنْ لَنْ نَقْدِرَ عَلَيْهِ فَنَادَىٰ فِي الظُّلُمَاتِ أَنْ لَا إِلَٰهَ إِلَّا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ","numberInSurah":87,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2571,"text":"فَاسْتَجَبْنَا لَهُ وَنَجَّيْنَاهُ مِنَ الْغَمِّ ۚ وَكَذَٰلِكَ نُنْجِي الْمُؤْمِنِينَ","numberInSurah":88,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2572,"text":"وَزَكَرِيَّا إِذْ نَادَىٰ رَبَّهُ رَبِّ لَا تَذَرْنِي فَرْدًا وَأَنْتَ خَيْرُ الْوَارِثِينَ","numberInSurah":89,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2573,"text":"فَاسْتَجَبْنَا لَهُ وَوَهَبْنَا لَهُ يَحْيَىٰ وَأَصْلَحْنَا لَهُ زَوْجَهُ ۚ إِنَّهُمْ كَانُوا يُسَارِعُونَ فِي الْخَيْرَاتِ وَيَدْعُونَنَا رَغَبًا وَرَهَبًا ۖ وَكَانُوا لَنَا خَاشِعِينَ","numberInSurah":90,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2574,"text":"وَالَّتِي أَحْصَنَتْ فَرْجَهَا فَنَفَخْنَا فِيهَا مِنْ رُوحِنَا وَجَعَلْنَاهَا وَابْنَهَا آيَةً لِلْعَالَمِينَ","numberInSurah":91,"juz":17,"manzil":4,"page":330,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2575,"text":"إِنَّ هَٰذِهِ أُمَّتُكُمْ أُمَّةً وَاحِدَةً وَأَنَا رَبُّكُمْ فَاعْبُدُونِ","numberInSurah":92,"juz":17,"manzil":4,"page":330,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2576,"text":"وَتَقَطَّعُوا أَمْرَهُمْ بَيْنَهُمْ ۖ كُلٌّ إِلَيْنَا رَاجِعُونَ","numberInSurah":93,"juz":17,"manzil":4,"page":330,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2577,"text":"فَمَنْ يَعْمَلْ مِنَ الصَّالِحَاتِ وَهُوَ مُؤْمِنٌ فَلَا كُفْرَانَ لِسَعْيِهِ وَإِنَّا لَهُ كَاتِبُونَ","numberInSurah":94,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2578,"text":"وَحَرَامٌ عَلَىٰ قَرْيَةٍ أَهْلَكْنَاهَا أَنَّهُمْ لَا يَرْجِعُونَ","numberInSurah":95,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2579,"text":"حَتَّىٰ إِذَا فُتِحَتْ يَأْجُوجُ وَمَأْجُوجُ وَهُمْ مِنْ كُلِّ حَدَبٍ يَنْسِلُونَ","numberInSurah":96,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2580,"text":"وَاقْتَرَبَ الْوَعْدُ الْحَقُّ فَإِذَا هِيَ شَاخِصَةٌ أَبْصَارُ الَّذِينَ كَفَرُوا يَا وَيْلَنَا قَدْ كُنَّا فِي غَفْلَةٍ مِنْ هَٰذَا بَلْ كُنَّا ظَالِمِينَ","numberInSurah":97,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2581,"text":"إِنَّكُمْ وَمَا تَعْبُدُونَ مِنْ دُونِ اللَّهِ حَصَبُ جَهَنَّمَ أَنْتُمْ لَهَا وَارِدُونَ","numberInSurah":98,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2582,"text":"لَوْ كَانَ هَٰؤُلَاءِ آلِهَةً مَا وَرَدُوهَا ۖ وَكُلٌّ فِيهَا خَالِدُونَ","numberInSurah":99,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2583,"text":"لَهُمْ فِيهَا زَفِيرٌ وَهُمْ فِيهَا لَا يَسْمَعُونَ","numberInSurah":100,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2584,"text":"إِنَّ الَّذِينَ سَبَقَتْ لَهُمْ مِنَّا الْحُسْنَىٰ أُولَٰئِكَ عَنْهَا مُبْعَدُونَ","numberInSurah":101,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2585,"text":"لَا يَسْمَعُونَ حَسِيسَهَا ۖ وَهُمْ فِي مَا اشْتَهَتْ أَنْفُسُهُمْ خَالِدُونَ","numberInSurah":102,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2586,"text":"لَا يَحْزُنُهُمُ الْفَزَعُ الْأَكْبَرُ وَتَتَلَقَّاهُمُ الْمَلَائِكَةُ هَٰذَا يَوْمُكُمُ الَّذِي كُنْتُمْ تُوعَدُونَ","numberInSurah":103,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2587,"text":"يَوْمَ نَطْوِي السَّمَاءَ كَطَيِّ السِّجِلِّ لِلْكُتُبِ ۚ كَمَا بَدَأْنَا أَوَّلَ خَلْقٍ نُعِيدُهُ ۚ وَعْدًا عَلَيْنَا ۚ إِنَّا كُنَّا فَاعِلِينَ","numberInSurah":104,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2588,"text":"وَلَقَدْ كَتَبْنَا فِي الزَّبُورِ مِنْ بَعْدِ الذِّكْرِ أَنَّ الْأَرْضَ يَرِثُهَا عِبَادِيَ الصَّالِحُونَ","numberInSurah":105,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2589,"text":"إِنَّ فِي هَٰذَا لَبَلَاغًا لِقَوْمٍ عَابِدِينَ","numberInSurah":106,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2590,"text":"وَمَا أَرْسَلْنَاكَ إِلَّا رَحْمَةً لِلْعَالَمِينَ","numberInSurah":107,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2591,"text":"قُلْ إِنَّمَا يُوحَىٰ إِلَيَّ أَنَّمَا إِلَٰهُكُمْ إِلَٰهٌ وَاحِدٌ ۖ فَهَلْ أَنْتُمْ مُسْلِمُونَ","numberInSurah":108,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2592,"text":"فَإِنْ تَوَلَّوْا فَقُلْ آذَنْتُكُمْ عَلَىٰ سَوَاءٍ ۖ وَإِنْ أَدْرِي أَقَرِيبٌ أَمْ بَعِيدٌ مَا تُوعَدُونَ","numberInSurah":109,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2593,"text":"إِنَّهُ يَعْلَمُ الْجَهْرَ مِنَ الْقَوْلِ وَيَعْلَمُ مَا تَكْتُمُونَ","numberInSurah":110,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2594,"text":"وَإِنْ أَدْرِي لَعَلَّهُ فِتْنَةٌ لَكُمْ وَمَتَاعٌ إِلَىٰ حِينٍ","numberInSurah":111,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2595,"text":"قَالَ رَبِّ احْكُمْ بِالْحَقِّ ۗ وَرَبُّنَا الرَّحْمَٰنُ الْمُسْتَعَانُ عَلَىٰ مَا تَصِفُونَ","numberInSurah":112,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":21,"name":"سُورَةُ الأَنبِيَاءِ","englishName":"Enbiyâ","englishNameTranslation":"The Prophets","revelationType":"Meccan","numberOfAyahs":112,"ayahs":[{"number":2484,"text":"İnsanların hesap görme zamanı yaklaştı, fakat onlar hala habersiz, hakdan yüz çeviriyorlar.","numberInSurah":1,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2485,"text":"Rablerinden kendilerine gelen her yeni ihtarı mutlaka, gönülleri gaflet içinde eğlenerek dinlerler. Zulmedenler, gizli toplantılarında: \"Bu zat, sizin gibi bir insandan başka bir şey midir? Siz, göz göre göre sihre mi uyarsınız?\" diye konuşurlar.","numberInSurah":2,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2486,"text":"Rablerinden kendilerine gelen her yeni ihtarı mutlaka, gönülleri gaflet içinde eğlenerek dinlerler. Zulmedenler, gizli toplantılarında: \"Bu zat, sizin gibi bir insandan başka bir şey midir? Siz, göz göre göre sihre mi uyarsınız?\" diye konuşurlar.","numberInSurah":3,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2487,"text":"Peygamber: \"Benim Rabbim gökte ve yerde söyleneni bilir. O, işitendir, bilendir\" dedi.","numberInSurah":4,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2488,"text":"Onlar: \"Hayır; bunlar karışık rüyalardır\", \"Hayır; onu uydurmuştur\", \"Hayır; o şairdir\", \"Haydi önceki peygamberler gibi o da bize bir mucize getirsin\" dediler.","numberInSurah":5,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2489,"text":"Onlardan önce yoketmiş olduğumuz kasabalar halkı inanmadılar, bunlar mı inanacaklar?","numberInSurah":6,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2490,"text":"Senden önce de, kendilerine vahyettiğimiz adamlar gönderdik. Bilmiyorsanız kitablılara sorun.","numberInSurah":7,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2491,"text":"Biz onları yemek yemez birer ceset kılmadık ve onlar ölümsüz de değillerdi.","numberInSurah":8,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2492,"text":"Sonra Biz onlara verdiğimiz sözü yerine getirdik, kendilerini ve dilediklerimizi kurtardık; aşırı gidenleri ise yok ettik.","numberInSurah":9,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2493,"text":"And olsun ki, size şerefiniz ve öğüt veren bir Kitap indirdik; akletmiyor musunuz?","numberInSurah":10,"juz":17,"manzil":4,"page":322,"ruku":278,"hizbQuarter":129,"sajda":false},{"number":2494,"text":"Halkı zalim olan nice kasabaları kırıp geçirdik ve onlardan sonra başka milletler varettik.","numberInSurah":11,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2495,"text":"Onlar bizim baskınımızı hissettiklerinde, oradan kaçmağa koyuluyorlardı.","numberInSurah":12,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2496,"text":"\"Koşup kaçmayın; size nimet verilen yere, yurdlarınıza dönün, elbette sorguya çekileceksiniz\" dedik.","numberInSurah":13,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2497,"text":"\"Vay başımıza gelenlere! Doğrusu biz haksızlık yapmış kimseleriz\" dediler.","numberInSurah":14,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2498,"text":"Biz onları biçilmiş ot ve bir yığın kül haline getirinceye kadar haykırmaları devam etti.","numberInSurah":15,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2499,"text":"Biz gökleri, yeri ve ikisinin arasındakileri oyun olsun diye yaratmadık.","numberInSurah":16,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2500,"text":"Eğlenme dileseydik, bunu yapacak olsaydık, şanımıza uygun şekilde yapardık; ama yapmayız.","numberInSurah":17,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2501,"text":"Gerçeği batılın başına çarparız ve onun beynini parçalar; böylece batıl ortadan kalkar. Allah'a yakıştırdığınız vasıflardan ötürü yazıklar olsun size!","numberInSurah":18,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2502,"text":"Göklerde ve yerde ne varsa O'nundur. Katında olanlar O'na kulluk etmekten çekinmezler ve usanmazlar.","numberInSurah":19,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2503,"text":"Gece ve gündüz, bıkmadan tesbih ederler.","numberInSurah":20,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2504,"text":"Yeryüzünde edindikleri tanrılar mı, onlar mı ölüleri diriltecekler?","numberInSurah":21,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2505,"text":"Eğer yerle gökte Allah'tan başka tanrılar olsaydı, ikisi de bozulurdu. Arşın Rabbi olan Allah, onların vasıflandırdıklarından münezzehtir.","numberInSurah":22,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2506,"text":"O, yaptığından sorumlu değildir, onlar ise sorumlu tutulacaklardır.","numberInSurah":23,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2507,"text":"O'nu bırakıp tanrılar mı edindiler? De ki: \"Kesin delilinizi getirin. İşte benim ve ümmetimin Kitap'ı ve senden öncekilerin kitapları.\" Hayır; onların çoğu gerçeği bilmez de yüz çevirirler.","numberInSurah":24,"juz":17,"manzil":4,"page":323,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2508,"text":"Senden önce gönderdiğimiz her peygambere: \"Benden başka tanrı yoktur, Bana kulluk edin\" diye vahyetmişizdir.","numberInSurah":25,"juz":17,"manzil":4,"page":324,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2509,"text":"\"Rahman çocuk edindi\" dediler. Haşa; hayır, melekler şerefli kılınmış kullardır.","numberInSurah":26,"juz":17,"manzil":4,"page":324,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2510,"text":"Allah'tan önce söz söyleyemezler; ancak O'nun emri üzerine iş işlerler.","numberInSurah":27,"juz":17,"manzil":4,"page":324,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2511,"text":"Allah, onların yaptıklarını ve yapmakta olduklarını bilir. Onlar Allah'ın hoşnut olduğu kimseden başkasına şefaat edemezler; O'nun korkusundan titrerler.","numberInSurah":28,"juz":17,"manzil":4,"page":324,"ruku":279,"hizbQuarter":129,"sajda":false},{"number":2512,"text":"Bunlar içinde kim \"Ben, Allah'tan başka bir tanrıyım\" derse, işte onu cehennemle cezalandırırız. Zulmedenlerin cezasını böyle veririz.","numberInSurah":29,"juz":17,"manzil":4,"page":324,"ruku":279,"hizbQuarter":130,"sajda":false},{"number":2513,"text":"İnkar edenler, gökler ve yer yapışıkken onları ayırdığımızı ve bütün canlıları sudan meydana getirdiğimizi bilmezler mi? İnanmıyorlar mı?","numberInSurah":30,"juz":17,"manzil":4,"page":324,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2514,"text":"Yeryüzüne, insanlar sarsılmasın diye sabit dağlar yerleştirdik; rahat gidebilsinler diye aralarında geniş yollar varettik.","numberInSurah":31,"juz":17,"manzil":4,"page":324,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2515,"text":"Göğü karışıklıktan korunmuş bir tavan kıldık; oysa onlar bundaki delillerden yüz çeviriyorlar.","numberInSurah":32,"juz":17,"manzil":4,"page":324,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2516,"text":"Geceyi ve gündüzü, güneşi ve ayı yaratan O'dur. Her biri bir yörüngede yürür.","numberInSurah":33,"juz":17,"manzil":4,"page":324,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2517,"text":"Senden önce de hiçbir insanı ölümsüz kılmadık, sen ölürsün de onlar baki kalır mı?","numberInSurah":34,"juz":17,"manzil":4,"page":324,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2518,"text":"Her can ölümü tadacaktır. Bir imtihan olarak size iyilik ve kötülük veririz. Sonunda Bize dönersiniz.","numberInSurah":35,"juz":17,"manzil":4,"page":324,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2519,"text":"İnkarcılar seni gördükleri zaman, şüphesiz, seni alaya almaktan başka bir şey yapmazlar. \"Sizin tanrılarınızı diline dolayan bu mudur?\" derler ve Rahman'ın Kitabını işte onlar inkar ederler.","numberInSurah":36,"juz":17,"manzil":4,"page":325,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2520,"text":"İnsan aceleci olarak yaratılmıştır. Size ayetlerimi göstereceğim, bunu Benden acele istemeyin.","numberInSurah":37,"juz":17,"manzil":4,"page":325,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2521,"text":"\"Doğru sözlü iseniz bildirin bu tehdit ne zamandır?\" derler.","numberInSurah":38,"juz":17,"manzil":4,"page":325,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2522,"text":"Bu kafirler, ateşi yüzlerinden ve sırtlarından menedemeyecekleri ve yardım da göremiyecekleri zamanı keşke bilseler.","numberInSurah":39,"juz":17,"manzil":4,"page":325,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2523,"text":"Belki aniden gelecek de onları şaşırtacaktır. Artık onu geri çeviremezler; kendileri de ertelenmez.","numberInSurah":40,"juz":17,"manzil":4,"page":325,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2524,"text":"And olsun ki, senden önce birçok peygamber alaya alınmıştı da, alaya alanları, eğlendikleri şey mahvetmişti.","numberInSurah":41,"juz":17,"manzil":4,"page":325,"ruku":280,"hizbQuarter":130,"sajda":false},{"number":2525,"text":"De ki: \"Geceleyin ve gündüzün sizi Rahman'dan kim koruyabilir?\" Ama onlar Rablerinin Kitabından yüz çevirmektedirler.","numberInSurah":42,"juz":17,"manzil":4,"page":325,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2526,"text":"Yoksa kendilerini bize karşı savunacak tanrıları mı var? O tanrılar kendilerine bile yardım edemezler. Katımızdan da dostluk görmezler.","numberInSurah":43,"juz":17,"manzil":4,"page":325,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2527,"text":"Biz bunlara ve babalarına geçimlikler verdik de ömürleri uzadı; şimdi memleketlerini her yandan eksilttiğimizi görmüyorlar mı? Üstün gelen onlar mıdır?","numberInSurah":44,"juz":17,"manzil":4,"page":325,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2528,"text":"De ki: \"Ben ancak sizi vahy ile uyarıyorum\" Uyarıldıkları zaman, sağırlar çağrıyı duymazlar.","numberInSurah":45,"juz":17,"manzil":4,"page":326,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2529,"text":"Rabbinin azabından onlara bir esinti dokunsa: \"Vah bize! Doğrusu biz haksızdık\" derler.","numberInSurah":46,"juz":17,"manzil":4,"page":326,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2530,"text":"Kıyamet günü doğru teraziler kurarız; hiçbir kimse hiçbir haksızlığa uğratılmaz. Hardal tanesi kadar olsa bile yapılanı ortaya koyarız. Hesap gören olarak Biz yeteriz.","numberInSurah":47,"juz":17,"manzil":4,"page":326,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2531,"text":"And olsun ki, Musa ve Harun'a eğriyi doğrudan ayıran Kitap'ı sakınanlar için ışık ve öğüt olarak verdik.","numberInSurah":48,"juz":17,"manzil":4,"page":326,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2532,"text":"Onlar görmedikleri halde Rablerinden korkarlar; kıyamet saatinden de titrerler.","numberInSurah":49,"juz":17,"manzil":4,"page":326,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2533,"text":"İşte bu, indirdiğimiz kutsal bir Kitap'dır. Siz mi onu inkar ediyorsunuz?","numberInSurah":50,"juz":17,"manzil":4,"page":326,"ruku":281,"hizbQuarter":130,"sajda":false},{"number":2534,"text":"And olsun ki, daha önce İbrahim'e de akla uygun olanı göstermiştik. Biz onu biliyorduk.","numberInSurah":51,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2535,"text":"İbrahim, babasına ve milletine: \"Bu tapınıp durduğunuz heykeller nedir?\" demişti.","numberInSurah":52,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2536,"text":"\"Babalarımızı onlara tapar bulduk\" demişlerdi.","numberInSurah":53,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2537,"text":"İbrahim: \"And olsun ki sizler de babalarınız da apaçık bir sapıklık içindesiniz\" deyince:","numberInSurah":54,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2538,"text":"\"Sen bize gerçeği mi getirdin yoksa şaka mı ediyorsun?\" dediler.","numberInSurah":55,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2539,"text":"O şöyle dedi: \"Hayır; Rabbiniz, göklerin ve yerin Rabbidir ki onları O yaratmıştır. Ben de buna şahidlik edenlerdenim.\"","numberInSurah":56,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2540,"text":"\"Allah'a yemin ederim ki, siz ayrıldıktan sonra, putlarınıza bir tuzak kuracağım!\"","numberInSurah":57,"juz":17,"manzil":4,"page":326,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2541,"text":"Hepsini paramparça edip, içlerinden büyüğünü ona başvursunlar diye, sağlam bıraktı.","numberInSurah":58,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2542,"text":"Milleti: \"Tanrılarımıza bunu kim yaptı? Doğrusu o zalimlerden biridir\" dediler.","numberInSurah":59,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2543,"text":"Bazıları: \"İbrahim denen bir gencin onları diline doladığını duymuştuk\" deyince, \"O halde bunların şahidlik edebilmeleri için onu halkın gözü önüne getirin\" dediler.","numberInSurah":60,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2544,"text":"Bazıları: \"İbrahim denen bir gencin onları diline doladığını duymuştuk\" deyince, \"O halde bunların şahidlik edebilmeleri için onu halkın gözü önüne getirin\" dediler.","numberInSurah":61,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2545,"text":"İbrahim gelince, ona: \"Ey İbrahim, bunu tanrılarımıza sen mi yaptın?\" dediler.","numberInSurah":62,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2546,"text":"İbrahim: \"Belki onu şu büyükleri yapmıştır, konuşabiliyorlarsa onlara sorun\" dedi.","numberInSurah":63,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2547,"text":"Kendi kendilerine: \"Doğrusu siz haksızsınız\", sonra kafalarında olan eski inançlarına dönerek: \"Ey İbrahim! bunların konuşmayacağını, and olsun ki, bilirsin\" dediler.","numberInSurah":64,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2548,"text":"Kendi kendilerine: \"Doğrusu siz haksızsınız\", sonra kafalarında olan eski inançlarına dönerek: \"Ey İbrahim! bunların konuşmayacağını, and olsun ki, bilirsin\" dediler.","numberInSurah":65,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2549,"text":"İbrahim: \"O halde, Allah'ı bırakıp da size hiçbir fayda ve zarar veremeyecek olan putlara ne diye taparsınız? Size de, Allah'ı bırakıp taptıklarınıza da yazıklar olsun! Akletmiyor musunuz?\" dedi.","numberInSurah":66,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2550,"text":"İbrahim: \"O halde, Allah'ı bırakıp da size hiçbir fayda ve zarar veremeyecek olan putlara ne diye taparsınız? Size de, Allah'ı bırakıp taptıklarınıza da yazıklar olsun! Akletmiyor musunuz?\" dedi.","numberInSurah":67,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2551,"text":"Onlar: \"Bir şey yapacaksanız, şunu yakın da tanrılarınıza yardım edin\" dediler.","numberInSurah":68,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2552,"text":"Biz: \"Ey ateş! İbrahim'e karşı serin ve zararsız ol\" dedik.","numberInSurah":69,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2553,"text":"Ona düzen kurmak istediler, fakat Biz onları hüsrana uğrattık.","numberInSurah":70,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2554,"text":"Onu da, Lut'u da, alemler için kutsal kıldığımız yere ulaştırıp kurtardık.","numberInSurah":71,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2555,"text":"İbrahim'e, buna ilaveten İshak ve Yakub'u da verdik, her birini iyi kimseler kıldık.","numberInSurah":72,"juz":17,"manzil":4,"page":327,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2556,"text":"Onları, buyruğumuz altında insanları doğru yola götüren önderler yaptık; onlara, iyi işler yapmayı, namaz kılmayı, zekat vermeyi vahyettik. Onlar, bize kulluk eden kimselerdi.","numberInSurah":73,"juz":17,"manzil":4,"page":328,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2557,"text":"Lut'a da hüküm ve ilim verdik; onu, çirkin işler işleyen kasabadan kurtardık. Doğrusu onlar yoldan çıkmış kötü bir milletti.","numberInSurah":74,"juz":17,"manzil":4,"page":328,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2558,"text":"Lut'u rahmetimizin içine aldık; doğrusu o iyilerdendi.","numberInSurah":75,"juz":17,"manzil":4,"page":328,"ruku":282,"hizbQuarter":131,"sajda":false},{"number":2559,"text":"Nuh da daha önceleri Bize yalvarmıştı, onun duasını kabul edip, kendisini ve ailesini büyük sıkıntıdan kurtardık.","numberInSurah":76,"juz":17,"manzil":4,"page":328,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2560,"text":"Ayetlerimizi yalanlayan millete karşı ona yardım ettik. Doğrusu onlar fena bir milletti, hepsini suda boğduk.","numberInSurah":77,"juz":17,"manzil":4,"page":328,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2561,"text":"Davud ve Süleyman da milletin koyunlarının yayıldığı bir ekin hakkında hüküm veriyorlarken, Biz onların hükmüne şahiddik.","numberInSurah":78,"juz":17,"manzil":4,"page":328,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2562,"text":"Süleyman'a bu meselenin hükmünü bildirmiştik; her birine hüküm ve ilim verdik. Davud ile beraber tesbih etsinler diye dağları ve kuşları buyruk altına aldık. Bunları Biz yapmıştık.","numberInSurah":79,"juz":17,"manzil":4,"page":328,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2563,"text":"Ona, sizi savaşta korumak için zırh yapma sanatını öğrettik, artık şükreder misiniz?","numberInSurah":80,"juz":17,"manzil":4,"page":328,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2564,"text":"Bereketli kıldığımız yere doğru, Süleyman'ın emriyle yürüyen şiddetli rüzgarı, onun buyruğuna verdik. Biz herşeyi biliyorduk.","numberInSurah":81,"juz":17,"manzil":4,"page":328,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2565,"text":"Dalgıçlık yapan ve bundan başka işler de gören şeytanlardan da onun buyruğu altına verdik. Onların hepsini gözetiyorduk.","numberInSurah":82,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":131,"sajda":false},{"number":2566,"text":"Eyyub da: \"Başıma bir bela geldi, (Sana sığındım), Sen merhametlilerin merhametlisisin\" diye Rabbine nida etmişti.","numberInSurah":83,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2567,"text":"Biz de onun duasını kabul etmiş ve başına gelenleri kaldırmıştık. Katımızdan bir rahmet ve kulluk edenlere bir hatıra olmak üzere ona tekrar ailesini ve kaybettikleriyle bir mislini daha vermiştik.","numberInSurah":84,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2568,"text":"İsmail, İdris ve Zülkifl hakkında anlattığımızı da an; onların her biri sabredenlerdendi.","numberInSurah":85,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2569,"text":"Onları rahmetimizin içine aldık; doğrusu onlar iyilerdendi.","numberInSurah":86,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2570,"text":"Zünnun (Balık Sahibi; Yunus) hakkında söylediğimizi de an. O, öfkelenerek giderken, kendisini sıkıntıya sokmayacağımızı sanmıştı; fakat sonunda karanlıklar içinde: \"Senden başka tanrı yoktur, Sen münezzehsin, doğrusu ben haksızlık edenlerdenim\" diye seslenmişti.","numberInSurah":87,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2571,"text":"Biz de ona cevap verip, onu üzüntüden kurtarmıştık. inananları böyle kurtarırız.","numberInSurah":88,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2572,"text":"Zekeriya da: \"Rabbim! Beni tek Başıma bırakma, Sen varislerin en hayırlısısın\" diye nida etmişti.","numberInSurah":89,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2573,"text":"Biz de ona icabet ederek, Yahya'yı bahşetmiş, eşini de doğum yapacak hale getirmiştik. Doğrusu onlar iyi işlerde yarışıyorlar, korkarak ve umarak Bize yalvarıyorlardı. Bize karşı gönülden saygı duyuyorlardı.","numberInSurah":90,"juz":17,"manzil":4,"page":329,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2574,"text":"Mahrem yerini koruyan Meryem'e ruhumuzdan üflemiş, onu ve oğlunu, alemler için bir mucize kılmıştık.","numberInSurah":91,"juz":17,"manzil":4,"page":330,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2575,"text":"Doğrusu tevhid dini olan Müslümanlık, bir tek din olarak sizin dininizdir ve Ben de Rabbinizim, artık Bana kulluk edin.","numberInSurah":92,"juz":17,"manzil":4,"page":330,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2576,"text":"Ama insanlar, din konusunda aralarında bölüklere ayrıldılar, hepsi Bize döneceklerdir.","numberInSurah":93,"juz":17,"manzil":4,"page":330,"ruku":283,"hizbQuarter":132,"sajda":false},{"number":2577,"text":"İnanmış olarak yararlı iş işleyenin ameli inkar edilmeyecektir. Biz onu yazmaktayız.","numberInSurah":94,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2578,"text":"Yok ettiğimiz kasaba halkının ahirette ceza görmek üzere Bize dönmemesi imkansızdır.","numberInSurah":95,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2579,"text":"Yecüc ve Mecüc'ün seddi yıkıldığı zaman her dere ve tepeden boşanırlar.","numberInSurah":96,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2580,"text":"Gerçek vaad yaklaştığında, inkar edenlerin gözleri beleriverir: \"Vah bize! Bundan önce gaflet içindeydik, hem de zalimdik\" derler.","numberInSurah":97,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2581,"text":"Siz ve Allah'tan başka taptıklarınız, cehennemin yakıtısınız; oraya gireceksiniz.","numberInSurah":98,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2582,"text":"Eğer bunlar tanrı olsaydı cehenneme girmezlerdi; hepsi orada temelli kalacaktır.","numberInSurah":99,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2583,"text":"Orada onlara ah etmek vardır; birşey de işitemezler.","numberInSurah":100,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2584,"text":"Yaptıklarına karşılık katımızdan kendileri için iyi şeyler yazılmış olanlar, işte onlar cehennemden uzak tutulanlardır.","numberInSurah":101,"juz":17,"manzil":4,"page":330,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2585,"text":"Cehennemin uğultusunu duymazlar. Canlarının istediği şeyler içinde temelli kalırlar.","numberInSurah":102,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2586,"text":"En büyük korku bile onları üzmez; kendilerini melekler: \"Size söz verilen gün işte bugündür\" diye karşılarlar.","numberInSurah":103,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2587,"text":"Göğü, kitap dürer gibi dürdüğümüz zaman, yaratmaya ilk başladığımız gibi katımızdan verilmiş bir söz olarak onu tekrar var edeceğiz. Doğrusu Biz yaparız.","numberInSurah":104,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2588,"text":"And olsun ki, Tevrat'tan sonra Zebur'da da yeryüzüne ancak iyi kullarımın mirasçı olduğunu yazmıştık.","numberInSurah":105,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2589,"text":"Doğrusu bu Kuran'da, kulluk eden kimselere bildiri vardır.","numberInSurah":106,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2590,"text":"Biz seni ancak alemlere rahmet olarak gönderdik.","numberInSurah":107,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2591,"text":"De ki: \"Doğrusu tanrınızın tek bir Tanrı olduğu bana şüphesiz vahyolundu. Artık müslüman olacak mısınız?\"","numberInSurah":108,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2592,"text":"Eğer yüz çevirirlerse, de ki: \"Size düpedüz açıkladım; tehdit olunduğunuz şeyin yakın mı uzak mı olduğunu bilmem.\"","numberInSurah":109,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2593,"text":"\"Doğrusu O, açığa vurulan sözü de bilir, gizlediklerinizi de bilir.\"","numberInSurah":110,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2594,"text":"\"Bilmem; belki bu gecikme sizi denemek ve bir süreye kadar geçindirmek içindir.\"","numberInSurah":111,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false},{"number":2595,"text":"Peygamber: \"Rabbim! Aramızda gerçekle hükmet, anlattıklarınıza karşı ancak Rahman olan Rabbimizden yardım istenir\" dedi.","numberInSurah":112,"juz":17,"manzil":4,"page":331,"ruku":284,"hizbQuarter":132,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}