{"arabic":{"number":46,"name":"سُورَةُ الأَحۡقَافِ","englishName":"Ahkâf","englishNameTranslation":"The Dunes","revelationType":"Meccan","numberOfAyahs":35,"ayahs":[{"number":4511,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ حم","numberInSurah":1,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4512,"text":"تَنْزِيلُ الْكِتَابِ مِنَ اللَّهِ الْعَزِيزِ الْحَكِيمِ","numberInSurah":2,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4513,"text":"مَا خَلَقْنَا السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا إِلَّا بِالْحَقِّ وَأَجَلٍ مُسَمًّى ۚ وَالَّذِينَ كَفَرُوا عَمَّا أُنْذِرُوا مُعْرِضُونَ","numberInSurah":3,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4514,"text":"قُلْ أَرَأَيْتُمْ مَا تَدْعُونَ مِنْ دُونِ اللَّهِ أَرُونِي مَاذَا خَلَقُوا مِنَ الْأَرْضِ أَمْ لَهُمْ شِرْكٌ فِي السَّمَاوَاتِ ۖ ائْتُونِي بِكِتَابٍ مِنْ قَبْلِ هَٰذَا أَوْ أَثَارَةٍ مِنْ عِلْمٍ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":4,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4515,"text":"وَمَنْ أَضَلُّ مِمَّنْ يَدْعُو مِنْ دُونِ اللَّهِ مَنْ لَا يَسْتَجِيبُ لَهُ إِلَىٰ يَوْمِ الْقِيَامَةِ وَهُمْ عَنْ دُعَائِهِمْ غَافِلُونَ","numberInSurah":5,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4516,"text":"وَإِذَا حُشِرَ النَّاسُ كَانُوا لَهُمْ أَعْدَاءً وَكَانُوا بِعِبَادَتِهِمْ كَافِرِينَ","numberInSurah":6,"juz":26,"manzil":6,"page":503,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4517,"text":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ آيَاتُنَا بَيِّنَاتٍ قَالَ الَّذِينَ كَفَرُوا لِلْحَقِّ لَمَّا جَاءَهُمْ هَٰذَا سِحْرٌ مُبِينٌ","numberInSurah":7,"juz":26,"manzil":6,"page":503,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4518,"text":"أَمْ يَقُولُونَ افْتَرَاهُ ۖ قُلْ إِنِ افْتَرَيْتُهُ فَلَا تَمْلِكُونَ لِي مِنَ اللَّهِ شَيْئًا ۖ هُوَ أَعْلَمُ بِمَا تُفِيضُونَ فِيهِ ۖ كَفَىٰ بِهِ شَهِيدًا بَيْنِي وَبَيْنَكُمْ ۖ وَهُوَ الْغَفُورُ الرَّحِيمُ","numberInSurah":8,"juz":26,"manzil":6,"page":503,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4519,"text":"قُلْ مَا كُنْتُ بِدْعًا مِنَ الرُّسُلِ وَمَا أَدْرِي مَا يُفْعَلُ بِي وَلَا بِكُمْ ۖ إِنْ أَتَّبِعُ إِلَّا مَا يُوحَىٰ إِلَيَّ وَمَا أَنَا إِلَّا نَذِيرٌ مُبِينٌ","numberInSurah":9,"juz":26,"manzil":6,"page":503,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4520,"text":"قُلْ أَرَأَيْتُمْ إِنْ كَانَ مِنْ عِنْدِ اللَّهِ وَكَفَرْتُمْ بِهِ وَشَهِدَ شَاهِدٌ مِنْ بَنِي إِسْرَائِيلَ عَلَىٰ مِثْلِهِ فَآمَنَ وَاسْتَكْبَرْتُمْ ۖ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ","numberInSurah":10,"juz":26,"manzil":6,"page":503,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4521,"text":"وَقَالَ الَّذِينَ كَفَرُوا لِلَّذِينَ آمَنُوا لَوْ كَانَ خَيْرًا مَا سَبَقُونَا إِلَيْهِ ۚ وَإِذْ لَمْ يَهْتَدُوا بِهِ فَسَيَقُولُونَ هَٰذَا إِفْكٌ قَدِيمٌ","numberInSurah":11,"juz":26,"manzil":6,"page":503,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4522,"text":"وَمِنْ قَبْلِهِ كِتَابُ مُوسَىٰ إِمَامًا وَرَحْمَةً ۚ وَهَٰذَا كِتَابٌ مُصَدِّقٌ لِسَانًا عَرَبِيًّا لِيُنْذِرَ الَّذِينَ ظَلَمُوا وَبُشْرَىٰ لِلْمُحْسِنِينَ","numberInSurah":12,"juz":26,"manzil":6,"page":503,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4523,"text":"إِنَّ الَّذِينَ قَالُوا رَبُّنَا اللَّهُ ثُمَّ اسْتَقَامُوا فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ","numberInSurah":13,"juz":26,"manzil":6,"page":503,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4524,"text":"أُولَٰئِكَ أَصْحَابُ الْجَنَّةِ خَالِدِينَ فِيهَا جَزَاءً بِمَا كَانُوا يَعْمَلُونَ","numberInSurah":14,"juz":26,"manzil":6,"page":503,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4525,"text":"وَوَصَّيْنَا الْإِنْسَانَ بِوَالِدَيْهِ إِحْسَانًا ۖ حَمَلَتْهُ أُمُّهُ كُرْهًا وَوَضَعَتْهُ كُرْهًا ۖ وَحَمْلُهُ وَفِصَالُهُ ثَلَاثُونَ شَهْرًا ۚ حَتَّىٰ إِذَا بَلَغَ أَشُدَّهُ وَبَلَغَ أَرْبَعِينَ سَنَةً قَالَ رَبِّ أَوْزِعْنِي أَنْ أَشْكُرَ نِعْمَتَكَ الَّتِي أَنْعَمْتَ عَلَيَّ وَعَلَىٰ وَالِدَيَّ وَأَنْ أَعْمَلَ صَالِحًا تَرْضَاهُ وَأَصْلِحْ لِي فِي ذُرِّيَّتِي ۖ إِنِّي تُبْتُ إِلَيْكَ وَإِنِّي مِنَ الْمُسْلِمِينَ","numberInSurah":15,"juz":26,"manzil":6,"page":504,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4526,"text":"أُولَٰئِكَ الَّذِينَ نَتَقَبَّلُ عَنْهُمْ أَحْسَنَ مَا عَمِلُوا وَنَتَجَاوَزُ عَنْ سَيِّئَاتِهِمْ فِي أَصْحَابِ الْجَنَّةِ ۖ وَعْدَ الصِّدْقِ الَّذِي كَانُوا يُوعَدُونَ","numberInSurah":16,"juz":26,"manzil":6,"page":504,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4527,"text":"وَالَّذِي قَالَ لِوَالِدَيْهِ أُفٍّ لَكُمَا أَتَعِدَانِنِي أَنْ أُخْرَجَ وَقَدْ خَلَتِ الْقُرُونُ مِنْ قَبْلِي وَهُمَا يَسْتَغِيثَانِ اللَّهَ وَيْلَكَ آمِنْ إِنَّ وَعْدَ اللَّهِ حَقٌّ فَيَقُولُ مَا هَٰذَا إِلَّا أَسَاطِيرُ الْأَوَّلِينَ","numberInSurah":17,"juz":26,"manzil":6,"page":504,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4528,"text":"أُولَٰئِكَ الَّذِينَ حَقَّ عَلَيْهِمُ الْقَوْلُ فِي أُمَمٍ قَدْ خَلَتْ مِنْ قَبْلِهِمْ مِنَ الْجِنِّ وَالْإِنْسِ ۖ إِنَّهُمْ كَانُوا خَاسِرِينَ","numberInSurah":18,"juz":26,"manzil":6,"page":504,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4529,"text":"وَلِكُلٍّ دَرَجَاتٌ مِمَّا عَمِلُوا ۖ وَلِيُوَفِّيَهُمْ أَعْمَالَهُمْ وَهُمْ لَا يُظْلَمُونَ","numberInSurah":19,"juz":26,"manzil":6,"page":504,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4530,"text":"وَيَوْمَ يُعْرَضُ الَّذِينَ كَفَرُوا عَلَى النَّارِ أَذْهَبْتُمْ طَيِّبَاتِكُمْ فِي حَيَاتِكُمُ الدُّنْيَا وَاسْتَمْتَعْتُمْ بِهَا فَالْيَوْمَ تُجْزَوْنَ عَذَابَ الْهُونِ بِمَا كُنْتُمْ تَسْتَكْبِرُونَ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ وَبِمَا كُنْتُمْ تَفْسُقُونَ","numberInSurah":20,"juz":26,"manzil":6,"page":504,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4531,"text":"۞ وَاذْكُرْ أَخَا عَادٍ إِذْ أَنْذَرَ قَوْمَهُ بِالْأَحْقَافِ وَقَدْ خَلَتِ النُّذُرُ مِنْ بَيْنِ يَدَيْهِ وَمِنْ خَلْفِهِ أَلَّا تَعْبُدُوا إِلَّا اللَّهَ إِنِّي أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٍ","numberInSurah":21,"juz":26,"manzil":6,"page":505,"ruku":440,"hizbQuarter":202,"sajda":false},{"number":4532,"text":"قَالُوا أَجِئْتَنَا لِتَأْفِكَنَا عَنْ آلِهَتِنَا فَأْتِنَا بِمَا تَعِدُنَا إِنْ كُنْتَ مِنَ الصَّادِقِينَ","numberInSurah":22,"juz":26,"manzil":6,"page":505,"ruku":440,"hizbQuarter":202,"sajda":false},{"number":4533,"text":"قَالَ إِنَّمَا الْعِلْمُ عِنْدَ اللَّهِ وَأُبَلِّغُكُمْ مَا أُرْسِلْتُ بِهِ وَلَٰكِنِّي أَرَاكُمْ قَوْمًا تَجْهَلُونَ","numberInSurah":23,"juz":26,"manzil":6,"page":505,"ruku":440,"hizbQuarter":202,"sajda":false},{"number":4534,"text":"فَلَمَّا رَأَوْهُ عَارِضًا مُسْتَقْبِلَ أَوْدِيَتِهِمْ قَالُوا هَٰذَا عَارِضٌ مُمْطِرُنَا ۚ بَلْ هُوَ مَا اسْتَعْجَلْتُمْ بِهِ ۖ رِيحٌ فِيهَا عَذَابٌ أَلِيمٌ","numberInSurah":24,"juz":26,"manzil":6,"page":505,"ruku":440,"hizbQuarter":202,"sajda":false},{"number":4535,"text":"تُدَمِّرُ كُلَّ شَيْءٍ بِأَمْرِ رَبِّهَا فَأَصْبَحُوا لَا يُرَىٰ إِلَّا مَسَاكِنُهُمْ ۚ كَذَٰلِكَ نَجْزِي الْقَوْمَ الْمُجْرِمِينَ","numberInSurah":25,"juz":26,"manzil":6,"page":505,"ruku":440,"hizbQuarter":202,"sajda":false},{"number":4536,"text":"وَلَقَدْ مَكَّنَّاهُمْ فِيمَا إِنْ مَكَّنَّاكُمْ فِيهِ وَجَعَلْنَا لَهُمْ سَمْعًا وَأَبْصَارًا وَأَفْئِدَةً فَمَا أَغْنَىٰ عَنْهُمْ سَمْعُهُمْ وَلَا أَبْصَارُهُمْ وَلَا أَفْئِدَتُهُمْ مِنْ شَيْءٍ إِذْ كَانُوا يَجْحَدُونَ بِآيَاتِ اللَّهِ وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ","numberInSurah":26,"juz":26,"manzil":6,"page":505,"ruku":440,"hizbQuarter":202,"sajda":false},{"number":4537,"text":"وَلَقَدْ أَهْلَكْنَا مَا حَوْلَكُمْ مِنَ الْقُرَىٰ وَصَرَّفْنَا الْآيَاتِ لَعَلَّهُمْ يَرْجِعُونَ","numberInSurah":27,"juz":26,"manzil":6,"page":505,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4538,"text":"فَلَوْلَا نَصَرَهُمُ الَّذِينَ اتَّخَذُوا مِنْ دُونِ اللَّهِ قُرْبَانًا آلِهَةً ۖ بَلْ ضَلُّوا عَنْهُمْ ۚ وَذَٰلِكَ إِفْكُهُمْ وَمَا كَانُوا يَفْتَرُونَ","numberInSurah":28,"juz":26,"manzil":6,"page":505,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4539,"text":"وَإِذْ صَرَفْنَا إِلَيْكَ نَفَرًا مِنَ الْجِنِّ يَسْتَمِعُونَ الْقُرْآنَ فَلَمَّا حَضَرُوهُ قَالُوا أَنْصِتُوا ۖ فَلَمَّا قُضِيَ وَلَّوْا إِلَىٰ قَوْمِهِمْ مُنْذِرِينَ","numberInSurah":29,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4540,"text":"قَالُوا يَا قَوْمَنَا إِنَّا سَمِعْنَا كِتَابًا أُنْزِلَ مِنْ بَعْدِ مُوسَىٰ مُصَدِّقًا لِمَا بَيْنَ يَدَيْهِ يَهْدِي إِلَى الْحَقِّ وَإِلَىٰ طَرِيقٍ مُسْتَقِيمٍ","numberInSurah":30,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4541,"text":"يَا قَوْمَنَا أَجِيبُوا دَاعِيَ اللَّهِ وَآمِنُوا بِهِ يَغْفِرْ لَكُمْ مِنْ ذُنُوبِكُمْ وَيُجِرْكُمْ مِنْ عَذَابٍ أَلِيمٍ","numberInSurah":31,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4542,"text":"وَمَنْ لَا يُجِبْ دَاعِيَ اللَّهِ فَلَيْسَ بِمُعْجِزٍ فِي الْأَرْضِ وَلَيْسَ لَهُ مِنْ دُونِهِ أَوْلِيَاءُ ۚ أُولَٰئِكَ فِي ضَلَالٍ مُبِينٍ","numberInSurah":32,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4543,"text":"أَوَلَمْ يَرَوْا أَنَّ اللَّهَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَلَمْ يَعْيَ بِخَلْقِهِنَّ بِقَادِرٍ عَلَىٰ أَنْ يُحْيِيَ الْمَوْتَىٰ ۚ بَلَىٰ إِنَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":33,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4544,"text":"وَيَوْمَ يُعْرَضُ الَّذِينَ كَفَرُوا عَلَى النَّارِ أَلَيْسَ هَٰذَا بِالْحَقِّ ۖ قَالُوا بَلَىٰ وَرَبِّنَا ۚ قَالَ فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ","numberInSurah":34,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4545,"text":"فَاصْبِرْ كَمَا صَبَرَ أُولُو الْعَزْمِ مِنَ الرُّسُلِ وَلَا تَسْتَعْجِلْ لَهُمْ ۚ كَأَنَّهُمْ يَوْمَ يَرَوْنَ مَا يُوعَدُونَ لَمْ يَلْبَثُوا إِلَّا سَاعَةً مِنْ نَهَارٍ ۚ بَلَاغٌ ۚ فَهَلْ يُهْلَكُ إِلَّا الْقَوْمُ الْفَاسِقُونَ","numberInSurah":35,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":46,"name":"سُورَةُ الأَحۡقَافِ","englishName":"Ahkâf","englishNameTranslation":"The Dunes","revelationType":"Meccan","numberOfAyahs":35,"ayahs":[{"number":4511,"text":"Ha, Mim.","numberInSurah":1,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4512,"text":"Bu Kitap'ın indirilmesi güçlü olan, Hakim olan Allah katındandır.","numberInSurah":2,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4513,"text":"Biz, gökleri, yeri ve ikisinin arasında bulunanları, ancak gerçek üzere ve belirli bir süre için yarattık; inkar edenler, uyarıldıkları şeylerden yüz çevirmektedirler.","numberInSurah":3,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4514,"text":"De ki: \"Allah'ı bırakıp taptığınız şeyleri görüyor musunuz? Yeryüzünde ne yaratmışlar bana göstersenize! Yoksa Allah'la ortaklıkları göklerde midir? Eğer doğru sözlü iseniz, size indirilmiş bir kitap veya intikal etmiş bir bilgi kalıntısı varsa bana getirin.\"","numberInSurah":4,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4515,"text":"Allah'ı bırakıp da, kıyamet gününe kadar cevap veremeyecek şeylere yalvarandan daha sapık kimdir? Çünkü, yalvardıkları şeyler yalvarışlarından habersizdirler.","numberInSurah":5,"juz":26,"manzil":6,"page":502,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4516,"text":"Ama, insanlar kıyamet günü toplatılınca, putları onlara düşman olurlar ve tapınmalarını inkar ederler.","numberInSurah":6,"juz":26,"manzil":6,"page":503,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4517,"text":"Ayetlerimiz onlara açıkça okunduğu zaman inkar edenler, kendilerine gelen gerçek için: \"Bu, apaçık bir büyüdür\" derler.","numberInSurah":7,"juz":26,"manzil":6,"page":503,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4518,"text":"Veya, \"onu uydurdu\" derler. De ki: \"Eğer onu uydurdumsa, beni Allah'a karşı hiçbir şekilde savunamazsınız; O, Kuran için yaptığınız taşkınlıkları daha iyi bilir. Benimle sizin aranızda şahit olarak O yeter. O, bağışlayandır, merhamet edendir.\"","numberInSurah":8,"juz":26,"manzil":6,"page":503,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4519,"text":"De ki: \"Ben peygamberlerin ilki değilim; benim ve sizin başınıza gelecekleri bilmem; ben ancak bana vahyolunana uymaktayım; ben sadece apaçık bir uyarıcıyım.\"","numberInSurah":9,"juz":26,"manzil":6,"page":503,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4520,"text":"De ki: \"Eğer bu Kitap Allah katından ise ve siz de onu inkar etmişseniz; İsrailoğullarından bir şahit de bunun böyle olduğuna şehadet edip de inanmışken, siz yine de büyüklük taslarsınız, bana söyleyin kendinize yazık etmiş olmaz mısınız?\" Doğrusu Allah zalim milleti doğru yola eriştirmez.","numberInSurah":10,"juz":26,"manzil":6,"page":503,"ruku":438,"hizbQuarter":201,"sajda":false},{"number":4521,"text":"İnkar edenler, inananlar için: \"Eğer İslamiyet'te bir hayır olsaydı, bu hususta bizden öne geçemezlerdi\" derler. Bununla doğru yola girmedikleri için de, \"Bu, eski bir uydurmadır\" derler.","numberInSurah":11,"juz":26,"manzil":6,"page":503,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4522,"text":"Kuran'dan önce, Musa'nın kitabı (Tevrat), bir rahmet ve rehberdi. Bu Kuran da, zulmedenleri uyarmak ve iyi davrananlara müjde olmak üzere Arap diliyle indirilmiş, kendinden öncekileri doğrulayan bir Kitap'dır.","numberInSurah":12,"juz":26,"manzil":6,"page":503,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4523,"text":"Doğrusu, \"Rabbimiz Allah'tır\" deyip, sonra da dosdoğru gidenlere korku yoktur, onlar üzülmeyeceklerdir.","numberInSurah":13,"juz":26,"manzil":6,"page":503,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4524,"text":"İşte onlar, cennetliklerdir; işlediklerine karşılık olarak, içinde temelli kalacaklardır.","numberInSurah":14,"juz":26,"manzil":6,"page":503,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4525,"text":"Biz insana, anne ve babasına karşı iyi davranmasını tavsiye etmişizdir; zira annesi, onu, karnında, zorluğa uğrayarak taşımış; onu güçlükle doğurmuştur. Taşınması ve sütten kesilmesi otuz ay sürer. Sonunda erginlik çağına erince ve kırk yaşına varınca: \"Rabbim! Bana ve anne babama verdiğin nimete şükretmemi ve benim hoşnut olacağın yararlı bir işi yapmamı sağla; bana verdiğin gibi soyuma da salah ver; doğrusu Sana yöneldim, ben, kendini Sana verenlerdenim\" demesi gerekir.","numberInSurah":15,"juz":26,"manzil":6,"page":504,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4526,"text":"İşte, işlediklerini en güzel şekilde kabul ettiğimiz ve kötülüklerini geçtiğimiz bu kimseler, cennetlikler içindedirler. Bu, verilen doğru bir sözdür.","numberInSurah":16,"juz":26,"manzil":6,"page":504,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4527,"text":"Annesine babasına: \"Of ikinizden; benden önce nice nesiller gelip geçmişken beni tekrar diriltilmemle mi tehdit ediyorsunuz?\" diyen kimseye, anne babası Allah'a sığınarak: \"Sana yazıklar olsun! İnan; doğrusu Allah'ın sözü gerçektir\" dedikleri halde: \"Bu, Kuran öncekilerin masallarından başka bir şey değildir\" diye cevap verenler işte onlar kendilerinden önce cinlerden ve insanlardan gelip geçmiş ümmetler içinde, Allah'ın azap vadinin aleyhlerinde gerçekleştiği kimselerdir. Doğrusu onlar hüsranda olanlardır.","numberInSurah":17,"juz":26,"manzil":6,"page":504,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4528,"text":"Annesine babasına: \"Of ikinizden; benden önce nice nesiller gelip geçmişken beni tekrar diriltilmemle mi tehdit ediyorsunuz?\" diyen kimseye, anne babası Allah'a sığınarak: \"Sana yazıklar olsun! İnan; doğrusu Allah'ın sözü gerçektir\" dedikleri halde: \"Bu, Kuran öncekilerin masallarından başka bir şey değildir\" diye cevap verenler işte onlar kendilerinden önce cinlerden ve insanlardan gelip geçmiş ümmetler içinde, Allah'ın azap vadinin aleyhlerinde gerçekleştiği kimselerdir. Doğrusu onlar hüsranda olanlardır.","numberInSurah":18,"juz":26,"manzil":6,"page":504,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4529,"text":"İşlediklerinden ötürü herkesin bir derecesi vardır. Herkese işlediklerinin karşılığı ödenir. Kendilerine haksızlık yapılmaz.","numberInSurah":19,"juz":26,"manzil":6,"page":504,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4530,"text":"İnkar edenler, ateşe sunuldukları gün, onlara: \"Dünyadaki hayatınızda sizin için güzel olan her şeyi harcadınız, onların zevkini sürdünüz; ama bugün, yeryüzünde haksız yere büyüklük taslamanızın ve yoldan çıkmanızın karşılığında alçaltıcı bir azap göreceksiniz\"","numberInSurah":20,"juz":26,"manzil":6,"page":504,"ruku":439,"hizbQuarter":201,"sajda":false},{"number":4531,"text":"Ad milletinin kardeşi Hud'u an; ondan önce ve sonra, \"Allah'tan başkasına kulluk etmeyin\" diyen nice uyarıcılar gelip geçmişken, Ahkaf bölgesindeki milletini uyarmış \"Doğrusu sizin için, büyük günün azabından korkuyorum\" demişti.","numberInSurah":21,"juz":26,"manzil":6,"page":505,"ruku":440,"hizbQuarter":202,"sajda":false},{"number":4532,"text":"\"Bize, bizi tanrılarımızdan alıkoymak için mi geldin? Doğru sözlülerden isen, bizi tehdit ettiğin şeyi başımıza getir\" dediler.","numberInSurah":22,"juz":26,"manzil":6,"page":505,"ruku":440,"hizbQuarter":202,"sajda":false},{"number":4533,"text":"\"Doğrusu bunun ne zaman geleceğini Allah bilir; ben size benimle gönderileni tebliğ ediyorum; fakat sizin cahil bir millet olduğunuzu görüyorum.\" dedi.","numberInSurah":23,"juz":26,"manzil":6,"page":505,"ruku":440,"hizbQuarter":202,"sajda":false},{"number":4534,"text":"O azabın, yayılarak vadilerine doğru yöneldiğini gördüklerinde: \"Bu yaygın bulut bize yağmur yağdıracaktır\" dediler. Hud: \"Hayır, o, acele beklediğiniz şeydir; can yakıcı azap veren bir rüzgardır; Rabbinin buyruğu ile her şeyi yok eder\" dedi. Bunun üzerine evlerinin harabelerinden başka bir şey görünmez oldu. Biz, suçlu milleti işte böyle cezalandırırız.","numberInSurah":24,"juz":26,"manzil":6,"page":505,"ruku":440,"hizbQuarter":202,"sajda":false},{"number":4535,"text":"O azabın, yayılarak vadilerine doğru yöneldiğini gördüklerinde: \"Bu yaygın bulut bize yağmur yağdıracaktır\" dediler. Hud: \"Hayır, o, acele beklediğiniz şeydir; can yakıcı azap veren bir rüzgardır; Rabbinin buyruğu ile her şeyi yok eder\" dedi. Bunun üzerine evlerinin harabelerinden başka bir şey görünmez oldu. Biz, suçlu milleti işte böyle cezalandırırız.","numberInSurah":25,"juz":26,"manzil":6,"page":505,"ruku":440,"hizbQuarter":202,"sajda":false},{"number":4536,"text":"And olsun ki onlara, size vermediğimiz servet ve imkanı vermiştik. Onlara kulaklar, gözler ve kalbler vermiştik; ama kulakları, gözleri ve kalbleri onlara bir fayda sağlamadı, zira, Allah'ın ayetlerini bile bile inkar ediyorlardı, alaya aldıkları şeyler onları kuşatıp yokediverdi.","numberInSurah":26,"juz":26,"manzil":6,"page":505,"ruku":440,"hizbQuarter":202,"sajda":false},{"number":4537,"text":"And olsun ki, çevrenizde bulunan birçok kentleri yok etmişizdir. Belki doğru yola dönerler diye ayetleri türlü türlü anlatmışızdır.","numberInSurah":27,"juz":26,"manzil":6,"page":505,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4538,"text":"O zamanlar, Allah'ı bırakıp da O'na yakınlık peyda etmek için edindikleri tanrılar kendilerine yardım etmeli değil miydi? Ama tanrıları onlardan uzaklaştılar. Bu, onların yalanı ve uydurup durdukları şeydir.","numberInSurah":28,"juz":26,"manzil":6,"page":505,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4539,"text":"Kuran'ı dinleyecek cinlerden bir takımını sana yöneltmiştik. Onlar Kuran'ı dinlemeğe hazır olunca birbirlerine: \"Susun\" dediler. Kuran'ın okunması bitince, her biri birer uyarıcı olarak milletlerine döndüler.","numberInSurah":29,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4540,"text":"Şöyle dediler: \"Ey milletimiz! Doğrusu biz, Musa'dan sonra indirilen, kendinden öncekileri doğrulayan, gerçeği ve doğru yolu gösteren bir kitap dinledik.\"","numberInSurah":30,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4541,"text":"\"Ey milletimiz! Allah'a çağırana (Muhammed'e) uyun ve O'na inanın da Allah da sizin günahlarınızı bağışlasın ve sizi can yakıcı azabdan korusun.\"","numberInSurah":31,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4542,"text":"Allah'a çağırana uymayan kimse bilsin ki, Allah'ı yeryüzünde aciz bırakamaz; onların O'ndan başka dostları da bulunmaz; işte onlar apaçık sapıklıktadırlar.","numberInSurah":32,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4543,"text":"Gökleri, yeri yaratan ve onları yaratmaktan yorulmayan Allah'ın, ölüleri diriltmeye de kadir olduğunu görmezler mi? Evet; O her şeye Kadir'dir.","numberInSurah":33,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4544,"text":"İnkar edenler, ateşe sunuldukları gün onlara: \"Bu, gerçek değil miydi?\" denir, onlar: \"Rabbimize and olsun ki evet gerçekti\" derler. Allah: \"İnkar etmenizden ötürü azabı tadın\" der.","numberInSurah":34,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false},{"number":4545,"text":"Peygamberlerden azim sahibi olanların sabrettiği gibi sen de sabret; inkarcılar için acele etme; onlar, kendilerine söz verileni gördükleri gün dünyada sadece gündüzün bir müddeti eğlendiklerini sanırlar. Bu bir bildiridir; yoldan çıkmış olanlardan başkası mı yok edilir?","numberInSurah":35,"juz":26,"manzil":6,"page":506,"ruku":441,"hizbQuarter":202,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}