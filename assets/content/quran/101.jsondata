{"arabic":{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Kâria","englishNameTranslation":"The Calamity","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6158,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الْقَارِعَةُ","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6159,"text":"مَا الْقَارِعَةُ","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6160,"text":"وَمَا أَدْرَاكَ مَا الْقَارِعَةُ","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6161,"text":"يَوْمَ يَكُونُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوثِ","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6162,"text":"وَتَكُونُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوشِ","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6163,"text":"فَأَمَّا مَنْ ثَقُلَتْ مَوَازِينُهُ","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6164,"text":"فَهُوَ فِي عِيشَةٍ رَاضِيَةٍ","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6165,"text":"وَأَمَّا مَنْ خَفَّتْ مَوَازِينُهُ","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6166,"text":"فَأُمُّهُ هَاوِيَةٌ","numberInSurah":9,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6167,"text":"وَمَا أَدْرَاكَ مَا هِيَهْ","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6168,"text":"نَارٌ حَامِيَةٌ","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":101,"name":"سُورَةُ القَارِعَةِ","englishName":"Kâria","englishNameTranslation":"The Calamity","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6158,"text":"Gürültü koparacak olan","numberInSurah":1,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6159,"text":"Nedir o gürültü koparacak olan?","numberInSurah":2,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6160,"text":"O gürültü koparacak olanın ne olduğunu sen bilir misin?","numberInSurah":3,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6161,"text":"O gün insanlar, ateş etrafında çırpınıp dökülen pervaneye dönecekler.","numberInSurah":4,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6162,"text":"Dağlar, atılmış renkli yüne benzeyecekler.","numberInSurah":5,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6163,"text":"Ama tartıları ağır gelen kimse hoş bir hayat içinde olacaktır.","numberInSurah":6,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6164,"text":"Ama tartıları ağır gelen kimse hoş bir hayat içinde olacaktır.","numberInSurah":7,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6165,"text":"Tartıları hafif gelenler ise,","numberInSurah":8,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6166,"text":"Onların yeri bir çukurdur.","numberInSurah":9,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6167,"text":"O çukurun ne olduğunu sen bilir misin?","numberInSurah":10,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false},{"number":6168,"text":"O, kızgın bir ateştir.","numberInSurah":11,"juz":30,"manzil":7,"page":600,"ruku":543,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}