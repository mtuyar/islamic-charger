{"arabic":{"number":93,"name":"سُورَةُ الضُّحَىٰ","englishName":"Duhâ","englishNameTranslation":"The Morning Hours","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6080,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالضُّحَىٰ","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6081,"text":"وَاللَّيْلِ إِذَا سَجَىٰ","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6082,"text":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6083,"text":"وَلَلْآخِرَةُ خَيْرٌ لَكَ مِنَ الْأُولَىٰ","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6084,"text":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6085,"text":"أَلَمْ يَجِدْكَ يَتِيمًا فَآوَىٰ","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6086,"text":"وَوَجَدَكَ ضَالًّا فَهَدَىٰ","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6087,"text":"وَوَجَدَكَ عَائِلًا فَأَغْنَىٰ","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6088,"text":"فَأَمَّا الْيَتِيمَ فَلَا تَقْهَرْ","numberInSurah":9,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6089,"text":"وَأَمَّا السَّائِلَ فَلَا تَنْهَرْ","numberInSurah":10,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6090,"text":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","numberInSurah":11,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":93,"name":"سُورَةُ الضُّحَىٰ","englishName":"Duhâ","englishNameTranslation":"The Morning Hours","revelationType":"Meccan","numberOfAyahs":11,"ayahs":[{"number":6080,"text":"Kuşluk vaktine and olsun;","numberInSurah":1,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6081,"text":"Sükun erdiği zaman geceye and olsun ki,","numberInSurah":2,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6082,"text":"Rabbin seni ne bıraktı ve ne de sana darıldı.","numberInSurah":3,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6083,"text":"Doğrusu ahiret senin için dünyadan daha hayırlıdır.","numberInSurah":4,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6084,"text":"Rabbin şüphesiz sana verecek ve sen de hoşnut olacaksın.","numberInSurah":5,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6085,"text":"Seni öksüz bulup da barındırmadı mı?","numberInSurah":6,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6086,"text":"Seni şaşırmış bulup, doğru yola eriştirmedi mi?","numberInSurah":7,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6087,"text":"Seni fakir bulup zenginleştirmedi mi?","numberInSurah":8,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6088,"text":"Öyleyse sakın öksüze kötü muamele etme;","numberInSurah":9,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6089,"text":"Ve sakın bir şey isteyeni azarlama;","numberInSurah":10,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false},{"number":6090,"text":"Yalnızca Rabbinin nimetini anlat.","numberInSurah":11,"juz":30,"manzil":7,"page":596,"ruku":535,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}