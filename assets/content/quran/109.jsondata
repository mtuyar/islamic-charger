{"arabic":{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Kâfirûn","englishNameTranslation":"The Disbelievers","revelationType":"Meccan","numberOfAyahs":6,"ayahs":[{"number":6208,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ قُلْ يَا أَيُّهَا الْكَافِرُونَ","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6209,"text":"لَا أَعْبُدُ مَا تَعْبُدُونَ","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6210,"text":"وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6211,"text":"وَلَا أَنَا عَابِدٌ مَا عَبَدْتُمْ","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6212,"text":"وَلَا أَنْتُمْ عَابِدُونَ مَا أَعْبُدُ","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6213,"text":"لَكُمْ دِينُكُمْ وَلِيَ دِينِ","numberInSurah":6,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":109,"name":"سُورَةُ الكَافِرُونَ","englishName":"Kâfirûn","englishNameTranslation":"The Disbelievers","revelationType":"Meccan","numberOfAyahs":6,"ayahs":[{"number":6208,"text":"De ki: \"Ey inkarcılar!\"","numberInSurah":1,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6209,"text":"\"Ben sizin taptıklarınıza tapmam.\"","numberInSurah":2,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6210,"text":"\"Benim taptığıma da sizler tapmazsınız.\"","numberInSurah":3,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6211,"text":"\"Ben de sizin taptığınıza tapacak değilim.\"","numberInSurah":4,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6212,"text":"\"Benim taptığıma da sizler tapmıyorsunuz.\"","numberInSurah":5,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false},{"number":6213,"text":"\"Sizin dininiz size, benim dinim banadır.\"","numberInSurah":6,"juz":30,"manzil":7,"page":603,"ruku":551,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}