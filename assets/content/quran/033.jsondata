{"arabic":{"number":33,"name":"سُورَةُ الأَحۡزَابِ","englishName":"Ahzâb","englishNameTranslation":"The Clans","revelationType":"Medinan","numberOfAyahs":73,"ayahs":[{"number":3534,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ يَا أَيُّهَا النَّبِيُّ اتَّقِ اللَّهَ وَلَا تُطِعِ الْكَافِرِينَ وَالْمُنَافِقِينَ ۗ إِنَّ اللَّهَ كَانَ عَلِيمًا حَكِيمًا","numberInSurah":1,"juz":21,"manzil":5,"page":418,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3535,"text":"وَاتَّبِعْ مَا يُوحَىٰ إِلَيْكَ مِنْ رَبِّكَ ۚ إِنَّ اللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا","numberInSurah":2,"juz":21,"manzil":5,"page":418,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3536,"text":"وَتَوَكَّلْ عَلَى اللَّهِ ۚ وَكَفَىٰ بِاللَّهِ وَكِيلًا","numberInSurah":3,"juz":21,"manzil":5,"page":418,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3537,"text":"مَا جَعَلَ اللَّهُ لِرَجُلٍ مِنْ قَلْبَيْنِ فِي جَوْفِهِ ۚ وَمَا جَعَلَ أَزْوَاجَكُمُ اللَّائِي تُظَاهِرُونَ مِنْهُنَّ أُمَّهَاتِكُمْ ۚ وَمَا جَعَلَ أَدْعِيَاءَكُمْ أَبْنَاءَكُمْ ۚ ذَٰلِكُمْ قَوْلُكُمْ بِأَفْوَاهِكُمْ ۖ وَاللَّهُ يَقُولُ الْحَقَّ وَهُوَ يَهْدِي السَّبِيلَ","numberInSurah":4,"juz":21,"manzil":5,"page":418,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3538,"text":"ادْعُوهُمْ لِآبَائِهِمْ هُوَ أَقْسَطُ عِنْدَ اللَّهِ ۚ فَإِنْ لَمْ تَعْلَمُوا آبَاءَهُمْ فَإِخْوَانُكُمْ فِي الدِّينِ وَمَوَالِيكُمْ ۚ وَلَيْسَ عَلَيْكُمْ جُنَاحٌ فِيمَا أَخْطَأْتُمْ بِهِ وَلَٰكِنْ مَا تَعَمَّدَتْ قُلُوبُكُمْ ۚ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","numberInSurah":5,"juz":21,"manzil":5,"page":418,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3539,"text":"النَّبِيُّ أَوْلَىٰ بِالْمُؤْمِنِينَ مِنْ أَنْفُسِهِمْ ۖ وَأَزْوَاجُهُ أُمَّهَاتُهُمْ ۗ وَأُولُو الْأَرْحَامِ بَعْضُهُمْ أَوْلَىٰ بِبَعْضٍ فِي كِتَابِ اللَّهِ مِنَ الْمُؤْمِنِينَ وَالْمُهَاجِرِينَ إِلَّا أَنْ تَفْعَلُوا إِلَىٰ أَوْلِيَائِكُمْ مَعْرُوفًا ۚ كَانَ ذَٰلِكَ فِي الْكِتَابِ مَسْطُورًا","numberInSurah":6,"juz":21,"manzil":5,"page":418,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3540,"text":"وَإِذْ أَخَذْنَا مِنَ النَّبِيِّينَ مِيثَاقَهُمْ وَمِنْكَ وَمِنْ نُوحٍ وَإِبْرَاهِيمَ وَمُوسَىٰ وَعِيسَى ابْنِ مَرْيَمَ ۖ وَأَخَذْنَا مِنْهُمْ مِيثَاقًا غَلِيظًا","numberInSurah":7,"juz":21,"manzil":5,"page":419,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3541,"text":"لِيَسْأَلَ الصَّادِقِينَ عَنْ صِدْقِهِمْ ۚ وَأَعَدَّ لِلْكَافِرِينَ عَذَابًا أَلِيمًا","numberInSurah":8,"juz":21,"manzil":5,"page":419,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3542,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اذْكُرُوا نِعْمَةَ اللَّهِ عَلَيْكُمْ إِذْ جَاءَتْكُمْ جُنُودٌ فَأَرْسَلْنَا عَلَيْهِمْ رِيحًا وَجُنُودًا لَمْ تَرَوْهَا ۚ وَكَانَ اللَّهُ بِمَا تَعْمَلُونَ بَصِيرًا","numberInSurah":9,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3543,"text":"إِذْ جَاءُوكُمْ مِنْ فَوْقِكُمْ وَمِنْ أَسْفَلَ مِنْكُمْ وَإِذْ زَاغَتِ الْأَبْصَارُ وَبَلَغَتِ الْقُلُوبُ الْحَنَاجِرَ وَتَظُنُّونَ بِاللَّهِ الظُّنُونَا","numberInSurah":10,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3544,"text":"هُنَالِكَ ابْتُلِيَ الْمُؤْمِنُونَ وَزُلْزِلُوا زِلْزَالًا شَدِيدًا","numberInSurah":11,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3545,"text":"وَإِذْ يَقُولُ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ مَا وَعَدَنَا اللَّهُ وَرَسُولُهُ إِلَّا غُرُورًا","numberInSurah":12,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3546,"text":"وَإِذْ قَالَتْ طَائِفَةٌ مِنْهُمْ يَا أَهْلَ يَثْرِبَ لَا مُقَامَ لَكُمْ فَارْجِعُوا ۚ وَيَسْتَأْذِنُ فَرِيقٌ مِنْهُمُ النَّبِيَّ يَقُولُونَ إِنَّ بُيُوتَنَا عَوْرَةٌ وَمَا هِيَ بِعَوْرَةٍ ۖ إِنْ يُرِيدُونَ إِلَّا فِرَارًا","numberInSurah":13,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3547,"text":"وَلَوْ دُخِلَتْ عَلَيْهِمْ مِنْ أَقْطَارِهَا ثُمَّ سُئِلُوا الْفِتْنَةَ لَآتَوْهَا وَمَا تَلَبَّثُوا بِهَا إِلَّا يَسِيرًا","numberInSurah":14,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3548,"text":"وَلَقَدْ كَانُوا عَاهَدُوا اللَّهَ مِنْ قَبْلُ لَا يُوَلُّونَ الْأَدْبَارَ ۚ وَكَانَ عَهْدُ اللَّهِ مَسْئُولًا","numberInSurah":15,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3549,"text":"قُلْ لَنْ يَنْفَعَكُمُ الْفِرَارُ إِنْ فَرَرْتُمْ مِنَ الْمَوْتِ أَوِ الْقَتْلِ وَإِذًا لَا تُمَتَّعُونَ إِلَّا قَلِيلًا","numberInSurah":16,"juz":21,"manzil":5,"page":420,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3550,"text":"قُلْ مَنْ ذَا الَّذِي يَعْصِمُكُمْ مِنَ اللَّهِ إِنْ أَرَادَ بِكُمْ سُوءًا أَوْ أَرَادَ بِكُمْ رَحْمَةً ۚ وَلَا يَجِدُونَ لَهُمْ مِنْ دُونِ اللَّهِ وَلِيًّا وَلَا نَصِيرًا","numberInSurah":17,"juz":21,"manzil":5,"page":420,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3551,"text":"۞ قَدْ يَعْلَمُ اللَّهُ الْمُعَوِّقِينَ مِنْكُمْ وَالْقَائِلِينَ لِإِخْوَانِهِمْ هَلُمَّ إِلَيْنَا ۖ وَلَا يَأْتُونَ الْبَأْسَ إِلَّا قَلِيلًا","numberInSurah":18,"juz":21,"manzil":5,"page":420,"ruku":362,"hizbQuarter":168,"sajda":false},{"number":3552,"text":"أَشِحَّةً عَلَيْكُمْ ۖ فَإِذَا جَاءَ الْخَوْفُ رَأَيْتَهُمْ يَنْظُرُونَ إِلَيْكَ تَدُورُ أَعْيُنُهُمْ كَالَّذِي يُغْشَىٰ عَلَيْهِ مِنَ الْمَوْتِ ۖ فَإِذَا ذَهَبَ الْخَوْفُ سَلَقُوكُمْ بِأَلْسِنَةٍ حِدَادٍ أَشِحَّةً عَلَى الْخَيْرِ ۚ أُولَٰئِكَ لَمْ يُؤْمِنُوا فَأَحْبَطَ اللَّهُ أَعْمَالَهُمْ ۚ وَكَانَ ذَٰلِكَ عَلَى اللَّهِ يَسِيرًا","numberInSurah":19,"juz":21,"manzil":5,"page":420,"ruku":362,"hizbQuarter":168,"sajda":false},{"number":3553,"text":"يَحْسَبُونَ الْأَحْزَابَ لَمْ يَذْهَبُوا ۖ وَإِنْ يَأْتِ الْأَحْزَابُ يَوَدُّوا لَوْ أَنَّهُمْ بَادُونَ فِي الْأَعْرَابِ يَسْأَلُونَ عَنْ أَنْبَائِكُمْ ۖ وَلَوْ كَانُوا فِيكُمْ مَا قَاتَلُوا إِلَّا قَلِيلًا","numberInSurah":20,"juz":21,"manzil":5,"page":420,"ruku":362,"hizbQuarter":168,"sajda":false},{"number":3554,"text":"لَقَدْ كَانَ لَكُمْ فِي رَسُولِ اللَّهِ أُسْوَةٌ حَسَنَةٌ لِمَنْ كَانَ يَرْجُو اللَّهَ وَالْيَوْمَ الْآخِرَ وَذَكَرَ اللَّهَ كَثِيرًا","numberInSurah":21,"juz":21,"manzil":5,"page":420,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3555,"text":"وَلَمَّا رَأَى الْمُؤْمِنُونَ الْأَحْزَابَ قَالُوا هَٰذَا مَا وَعَدَنَا اللَّهُ وَرَسُولُهُ وَصَدَقَ اللَّهُ وَرَسُولُهُ ۚ وَمَا زَادَهُمْ إِلَّا إِيمَانًا وَتَسْلِيمًا","numberInSurah":22,"juz":21,"manzil":5,"page":420,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3556,"text":"مِنَ الْمُؤْمِنِينَ رِجَالٌ صَدَقُوا مَا عَاهَدُوا اللَّهَ عَلَيْهِ ۖ فَمِنْهُمْ مَنْ قَضَىٰ نَحْبَهُ وَمِنْهُمْ مَنْ يَنْتَظِرُ ۖ وَمَا بَدَّلُوا تَبْدِيلًا","numberInSurah":23,"juz":21,"manzil":5,"page":421,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3557,"text":"لِيَجْزِيَ اللَّهُ الصَّادِقِينَ بِصِدْقِهِمْ وَيُعَذِّبَ الْمُنَافِقِينَ إِنْ شَاءَ أَوْ يَتُوبَ عَلَيْهِمْ ۚ إِنَّ اللَّهَ كَانَ غَفُورًا رَحِيمًا","numberInSurah":24,"juz":21,"manzil":5,"page":421,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3558,"text":"وَرَدَّ اللَّهُ الَّذِينَ كَفَرُوا بِغَيْظِهِمْ لَمْ يَنَالُوا خَيْرًا ۚ وَكَفَى اللَّهُ الْمُؤْمِنِينَ الْقِتَالَ ۚ وَكَانَ اللَّهُ قَوِيًّا عَزِيزًا","numberInSurah":25,"juz":21,"manzil":5,"page":421,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3559,"text":"وَأَنْزَلَ الَّذِينَ ظَاهَرُوهُمْ مِنْ أَهْلِ الْكِتَابِ مِنْ صَيَاصِيهِمْ وَقَذَفَ فِي قُلُوبِهِمُ الرُّعْبَ فَرِيقًا تَقْتُلُونَ وَتَأْسِرُونَ فَرِيقًا","numberInSurah":26,"juz":21,"manzil":5,"page":421,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3560,"text":"وَأَوْرَثَكُمْ أَرْضَهُمْ وَدِيَارَهُمْ وَأَمْوَالَهُمْ وَأَرْضًا لَمْ تَطَئُوهَا ۚ وَكَانَ اللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرًا","numberInSurah":27,"juz":21,"manzil":5,"page":421,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3561,"text":"يَا أَيُّهَا النَّبِيُّ قُلْ لِأَزْوَاجِكَ إِنْ كُنْتُنَّ تُرِدْنَ الْحَيَاةَ الدُّنْيَا وَزِينَتَهَا فَتَعَالَيْنَ أُمَتِّعْكُنَّ وَأُسَرِّحْكُنَّ سَرَاحًا جَمِيلًا","numberInSurah":28,"juz":21,"manzil":5,"page":421,"ruku":364,"hizbQuarter":168,"sajda":false},{"number":3562,"text":"وَإِنْ كُنْتُنَّ تُرِدْنَ اللَّهَ وَرَسُولَهُ وَالدَّارَ الْآخِرَةَ فَإِنَّ اللَّهَ أَعَدَّ لِلْمُحْسِنَاتِ مِنْكُنَّ أَجْرًا عَظِيمًا","numberInSurah":29,"juz":21,"manzil":5,"page":421,"ruku":364,"hizbQuarter":168,"sajda":false},{"number":3563,"text":"يَا نِسَاءَ النَّبِيِّ مَنْ يَأْتِ مِنْكُنَّ بِفَاحِشَةٍ مُبَيِّنَةٍ يُضَاعَفْ لَهَا الْعَذَابُ ضِعْفَيْنِ ۚ وَكَانَ ذَٰلِكَ عَلَى اللَّهِ يَسِيرًا","numberInSurah":30,"juz":21,"manzil":5,"page":421,"ruku":364,"hizbQuarter":168,"sajda":false},{"number":3564,"text":"۞ وَمَنْ يَقْنُتْ مِنْكُنَّ لِلَّهِ وَرَسُولِهِ وَتَعْمَلْ صَالِحًا نُؤْتِهَا أَجْرَهَا مَرَّتَيْنِ وَأَعْتَدْنَا لَهَا رِزْقًا كَرِيمًا","numberInSurah":31,"juz":22,"manzil":5,"page":422,"ruku":364,"hizbQuarter":169,"sajda":false},{"number":3565,"text":"يَا نِسَاءَ النَّبِيِّ لَسْتُنَّ كَأَحَدٍ مِنَ النِّسَاءِ ۚ إِنِ اتَّقَيْتُنَّ فَلَا تَخْضَعْنَ بِالْقَوْلِ فَيَطْمَعَ الَّذِي فِي قَلْبِهِ مَرَضٌ وَقُلْنَ قَوْلًا مَعْرُوفًا","numberInSurah":32,"juz":22,"manzil":5,"page":422,"ruku":364,"hizbQuarter":169,"sajda":false},{"number":3566,"text":"وَقَرْنَ فِي بُيُوتِكُنَّ وَلَا تَبَرَّجْنَ تَبَرُّجَ الْجَاهِلِيَّةِ الْأُولَىٰ ۖ وَأَقِمْنَ الصَّلَاةَ وَآتِينَ الزَّكَاةَ وَأَطِعْنَ اللَّهَ وَرَسُولَهُ ۚ إِنَّمَا يُرِيدُ اللَّهُ لِيُذْهِبَ عَنْكُمُ الرِّجْسَ أَهْلَ الْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا","numberInSurah":33,"juz":22,"manzil":5,"page":422,"ruku":364,"hizbQuarter":169,"sajda":false},{"number":3567,"text":"وَاذْكُرْنَ مَا يُتْلَىٰ فِي بُيُوتِكُنَّ مِنْ آيَاتِ اللَّهِ وَالْحِكْمَةِ ۚ إِنَّ اللَّهَ كَانَ لَطِيفًا خَبِيرًا","numberInSurah":34,"juz":22,"manzil":5,"page":422,"ruku":364,"hizbQuarter":169,"sajda":false},{"number":3568,"text":"إِنَّ الْمُسْلِمِينَ وَالْمُسْلِمَاتِ وَالْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ وَالْقَانِتِينَ وَالْقَانِتَاتِ وَالصَّادِقِينَ وَالصَّادِقَاتِ وَالصَّابِرِينَ وَالصَّابِرَاتِ وَالْخَاشِعِينَ وَالْخَاشِعَاتِ وَالْمُتَصَدِّقِينَ وَالْمُتَصَدِّقَاتِ وَالصَّائِمِينَ وَالصَّائِمَاتِ وَالْحَافِظِينَ فُرُوجَهُمْ وَالْحَافِظَاتِ وَالذَّاكِرِينَ اللَّهَ كَثِيرًا وَالذَّاكِرَاتِ أَعَدَّ اللَّهُ لَهُمْ مَغْفِرَةً وَأَجْرًا عَظِيمًا","numberInSurah":35,"juz":22,"manzil":5,"page":422,"ruku":365,"hizbQuarter":169,"sajda":false},{"number":3569,"text":"وَمَا كَانَ لِمُؤْمِنٍ وَلَا مُؤْمِنَةٍ إِذَا قَضَى اللَّهُ وَرَسُولُهُ أَمْرًا أَنْ يَكُونَ لَهُمُ الْخِيَرَةُ مِنْ أَمْرِهِمْ ۗ وَمَنْ يَعْصِ اللَّهَ وَرَسُولَهُ فَقَدْ ضَلَّ ضَلَالًا مُبِينًا","numberInSurah":36,"juz":22,"manzil":5,"page":423,"ruku":365,"hizbQuarter":169,"sajda":false},{"number":3570,"text":"وَإِذْ تَقُولُ لِلَّذِي أَنْعَمَ اللَّهُ عَلَيْهِ وَأَنْعَمْتَ عَلَيْهِ أَمْسِكْ عَلَيْكَ زَوْجَكَ وَاتَّقِ اللَّهَ وَتُخْفِي فِي نَفْسِكَ مَا اللَّهُ مُبْدِيهِ وَتَخْشَى النَّاسَ وَاللَّهُ أَحَقُّ أَنْ تَخْشَاهُ ۖ فَلَمَّا قَضَىٰ زَيْدٌ مِنْهَا وَطَرًا زَوَّجْنَاكَهَا لِكَيْ لَا يَكُونَ عَلَى الْمُؤْمِنِينَ حَرَجٌ فِي أَزْوَاجِ أَدْعِيَائِهِمْ إِذَا قَضَوْا مِنْهُنَّ وَطَرًا ۚ وَكَانَ أَمْرُ اللَّهِ مَفْعُولًا","numberInSurah":37,"juz":22,"manzil":5,"page":423,"ruku":365,"hizbQuarter":169,"sajda":false},{"number":3571,"text":"مَا كَانَ عَلَى النَّبِيِّ مِنْ حَرَجٍ فِيمَا فَرَضَ اللَّهُ لَهُ ۖ سُنَّةَ اللَّهِ فِي الَّذِينَ خَلَوْا مِنْ قَبْلُ ۚ وَكَانَ أَمْرُ اللَّهِ قَدَرًا مَقْدُورًا","numberInSurah":38,"juz":22,"manzil":5,"page":423,"ruku":365,"hizbQuarter":169,"sajda":false},{"number":3572,"text":"الَّذِينَ يُبَلِّغُونَ رِسَالَاتِ اللَّهِ وَيَخْشَوْنَهُ وَلَا يَخْشَوْنَ أَحَدًا إِلَّا اللَّهَ ۗ وَكَفَىٰ بِاللَّهِ حَسِيبًا","numberInSurah":39,"juz":22,"manzil":5,"page":423,"ruku":365,"hizbQuarter":169,"sajda":false},{"number":3573,"text":"مَا كَانَ مُحَمَّدٌ أَبَا أَحَدٍ مِنْ رِجَالِكُمْ وَلَٰكِنْ رَسُولَ اللَّهِ وَخَاتَمَ النَّبِيِّينَ ۗ وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ عَلِيمًا","numberInSurah":40,"juz":22,"manzil":5,"page":423,"ruku":365,"hizbQuarter":169,"sajda":false},{"number":3574,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اذْكُرُوا اللَّهَ ذِكْرًا كَثِيرًا","numberInSurah":41,"juz":22,"manzil":5,"page":423,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3575,"text":"وَسَبِّحُوهُ بُكْرَةً وَأَصِيلًا","numberInSurah":42,"juz":22,"manzil":5,"page":423,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3576,"text":"هُوَ الَّذِي يُصَلِّي عَلَيْكُمْ وَمَلَائِكَتُهُ لِيُخْرِجَكُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ ۚ وَكَانَ بِالْمُؤْمِنِينَ رَحِيمًا","numberInSurah":43,"juz":22,"manzil":5,"page":423,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3577,"text":"تَحِيَّتُهُمْ يَوْمَ يَلْقَوْنَهُ سَلَامٌ ۚ وَأَعَدَّ لَهُمْ أَجْرًا كَرِيمًا","numberInSurah":44,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3578,"text":"يَا أَيُّهَا النَّبِيُّ إِنَّا أَرْسَلْنَاكَ شَاهِدًا وَمُبَشِّرًا وَنَذِيرًا","numberInSurah":45,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3579,"text":"وَدَاعِيًا إِلَى اللَّهِ بِإِذْنِهِ وَسِرَاجًا مُنِيرًا","numberInSurah":46,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3580,"text":"وَبَشِّرِ الْمُؤْمِنِينَ بِأَنَّ لَهُمْ مِنَ اللَّهِ فَضْلًا كَبِيرًا","numberInSurah":47,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3581,"text":"وَلَا تُطِعِ الْكَافِرِينَ وَالْمُنَافِقِينَ وَدَعْ أَذَاهُمْ وَتَوَكَّلْ عَلَى اللَّهِ ۚ وَكَفَىٰ بِاللَّهِ وَكِيلًا","numberInSurah":48,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3582,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا نَكَحْتُمُ الْمُؤْمِنَاتِ ثُمَّ طَلَّقْتُمُوهُنَّ مِنْ قَبْلِ أَنْ تَمَسُّوهُنَّ فَمَا لَكُمْ عَلَيْهِنَّ مِنْ عِدَّةٍ تَعْتَدُّونَهَا ۖ فَمَتِّعُوهُنَّ وَسَرِّحُوهُنَّ سَرَاحًا جَمِيلًا","numberInSurah":49,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3583,"text":"يَا أَيُّهَا النَّبِيُّ إِنَّا أَحْلَلْنَا لَكَ أَزْوَاجَكَ اللَّاتِي آتَيْتَ أُجُورَهُنَّ وَمَا مَلَكَتْ يَمِينُكَ مِمَّا أَفَاءَ اللَّهُ عَلَيْكَ وَبَنَاتِ عَمِّكَ وَبَنَاتِ عَمَّاتِكَ وَبَنَاتِ خَالِكَ وَبَنَاتِ خَالَاتِكَ اللَّاتِي هَاجَرْنَ مَعَكَ وَامْرَأَةً مُؤْمِنَةً إِنْ وَهَبَتْ نَفْسَهَا لِلنَّبِيِّ إِنْ أَرَادَ النَّبِيُّ أَنْ يَسْتَنْكِحَهَا خَالِصَةً لَكَ مِنْ دُونِ الْمُؤْمِنِينَ ۗ قَدْ عَلِمْنَا مَا فَرَضْنَا عَلَيْهِمْ فِي أَزْوَاجِهِمْ وَمَا مَلَكَتْ أَيْمَانُهُمْ لِكَيْلَا يَكُونَ عَلَيْكَ حَرَجٌ ۗ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","numberInSurah":50,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3584,"text":"۞ تُرْجِي مَنْ تَشَاءُ مِنْهُنَّ وَتُؤْوِي إِلَيْكَ مَنْ تَشَاءُ ۖ وَمَنِ ابْتَغَيْتَ مِمَّنْ عَزَلْتَ فَلَا جُنَاحَ عَلَيْكَ ۚ ذَٰلِكَ أَدْنَىٰ أَنْ تَقَرَّ أَعْيُنُهُنَّ وَلَا يَحْزَنَّ وَيَرْضَيْنَ بِمَا آتَيْتَهُنَّ كُلُّهُنَّ ۚ وَاللَّهُ يَعْلَمُ مَا فِي قُلُوبِكُمْ ۚ وَكَانَ اللَّهُ عَلِيمًا حَلِيمًا","numberInSurah":51,"juz":22,"manzil":5,"page":425,"ruku":366,"hizbQuarter":170,"sajda":false},{"number":3585,"text":"لَا يَحِلُّ لَكَ النِّسَاءُ مِنْ بَعْدُ وَلَا أَنْ تَبَدَّلَ بِهِنَّ مِنْ أَزْوَاجٍ وَلَوْ أَعْجَبَكَ حُسْنُهُنَّ إِلَّا مَا مَلَكَتْ يَمِينُكَ ۗ وَكَانَ اللَّهُ عَلَىٰ كُلِّ شَيْءٍ رَقِيبًا","numberInSurah":52,"juz":22,"manzil":5,"page":425,"ruku":366,"hizbQuarter":170,"sajda":false},{"number":3586,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَدْخُلُوا بُيُوتَ النَّبِيِّ إِلَّا أَنْ يُؤْذَنَ لَكُمْ إِلَىٰ طَعَامٍ غَيْرَ نَاظِرِينَ إِنَاهُ وَلَٰكِنْ إِذَا دُعِيتُمْ فَادْخُلُوا فَإِذَا طَعِمْتُمْ فَانْتَشِرُوا وَلَا مُسْتَأْنِسِينَ لِحَدِيثٍ ۚ إِنَّ ذَٰلِكُمْ كَانَ يُؤْذِي النَّبِيَّ فَيَسْتَحْيِي مِنْكُمْ ۖ وَاللَّهُ لَا يَسْتَحْيِي مِنَ الْحَقِّ ۚ وَإِذَا سَأَلْتُمُوهُنَّ مَتَاعًا فَاسْأَلُوهُنَّ مِنْ وَرَاءِ حِجَابٍ ۚ ذَٰلِكُمْ أَطْهَرُ لِقُلُوبِكُمْ وَقُلُوبِهِنَّ ۚ وَمَا كَانَ لَكُمْ أَنْ تُؤْذُوا رَسُولَ اللَّهِ وَلَا أَنْ تَنْكِحُوا أَزْوَاجَهُ مِنْ بَعْدِهِ أَبَدًا ۚ إِنَّ ذَٰلِكُمْ كَانَ عِنْدَ اللَّهِ عَظِيمًا","numberInSurah":53,"juz":22,"manzil":5,"page":425,"ruku":367,"hizbQuarter":170,"sajda":false},{"number":3587,"text":"إِنْ تُبْدُوا شَيْئًا أَوْ تُخْفُوهُ فَإِنَّ اللَّهَ كَانَ بِكُلِّ شَيْءٍ عَلِيمًا","numberInSurah":54,"juz":22,"manzil":5,"page":425,"ruku":367,"hizbQuarter":170,"sajda":false},{"number":3588,"text":"لَا جُنَاحَ عَلَيْهِنَّ فِي آبَائِهِنَّ وَلَا أَبْنَائِهِنَّ وَلَا إِخْوَانِهِنَّ وَلَا أَبْنَاءِ إِخْوَانِهِنَّ وَلَا أَبْنَاءِ أَخَوَاتِهِنَّ وَلَا نِسَائِهِنَّ وَلَا مَا مَلَكَتْ أَيْمَانُهُنَّ ۗ وَاتَّقِينَ اللَّهَ ۚ إِنَّ اللَّهَ كَانَ عَلَىٰ كُلِّ شَيْءٍ شَهِيدًا","numberInSurah":55,"juz":22,"manzil":5,"page":426,"ruku":367,"hizbQuarter":170,"sajda":false},{"number":3589,"text":"إِنَّ اللَّهَ وَمَلَائِكَتَهُ يُصَلُّونَ عَلَى النَّبِيِّ ۚ يَا أَيُّهَا الَّذِينَ آمَنُوا صَلُّوا عَلَيْهِ وَسَلِّمُوا تَسْلِيمًا","numberInSurah":56,"juz":22,"manzil":5,"page":426,"ruku":367,"hizbQuarter":170,"sajda":false},{"number":3590,"text":"إِنَّ الَّذِينَ يُؤْذُونَ اللَّهَ وَرَسُولَهُ لَعَنَهُمُ اللَّهُ فِي الدُّنْيَا وَالْآخِرَةِ وَأَعَدَّ لَهُمْ عَذَابًا مُهِينًا","numberInSurah":57,"juz":22,"manzil":5,"page":426,"ruku":367,"hizbQuarter":170,"sajda":false},{"number":3591,"text":"وَالَّذِينَ يُؤْذُونَ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ بِغَيْرِ مَا اكْتَسَبُوا فَقَدِ احْتَمَلُوا بُهْتَانًا وَإِثْمًا مُبِينًا","numberInSurah":58,"juz":22,"manzil":5,"page":426,"ruku":367,"hizbQuarter":170,"sajda":false},{"number":3592,"text":"يَا أَيُّهَا النَّبِيُّ قُلْ لِأَزْوَاجِكَ وَبَنَاتِكَ وَنِسَاءِ الْمُؤْمِنِينَ يُدْنِينَ عَلَيْهِنَّ مِنْ جَلَابِيبِهِنَّ ۚ ذَٰلِكَ أَدْنَىٰ أَنْ يُعْرَفْنَ فَلَا يُؤْذَيْنَ ۗ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","numberInSurah":59,"juz":22,"manzil":5,"page":426,"ruku":368,"hizbQuarter":170,"sajda":false},{"number":3593,"text":"۞ لَئِنْ لَمْ يَنْتَهِ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ وَالْمُرْجِفُونَ فِي الْمَدِينَةِ لَنُغْرِيَنَّكَ بِهِمْ ثُمَّ لَا يُجَاوِرُونَكَ فِيهَا إِلَّا قَلِيلًا","numberInSurah":60,"juz":22,"manzil":5,"page":426,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3594,"text":"مَلْعُونِينَ ۖ أَيْنَمَا ثُقِفُوا أُخِذُوا وَقُتِّلُوا تَقْتِيلًا","numberInSurah":61,"juz":22,"manzil":5,"page":426,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3595,"text":"سُنَّةَ اللَّهِ فِي الَّذِينَ خَلَوْا مِنْ قَبْلُ ۖ وَلَنْ تَجِدَ لِسُنَّةِ اللَّهِ تَبْدِيلًا","numberInSurah":62,"juz":22,"manzil":5,"page":426,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3596,"text":"يَسْأَلُكَ النَّاسُ عَنِ السَّاعَةِ ۖ قُلْ إِنَّمَا عِلْمُهَا عِنْدَ اللَّهِ ۚ وَمَا يُدْرِيكَ لَعَلَّ السَّاعَةَ تَكُونُ قَرِيبًا","numberInSurah":63,"juz":22,"manzil":5,"page":427,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3597,"text":"إِنَّ اللَّهَ لَعَنَ الْكَافِرِينَ وَأَعَدَّ لَهُمْ سَعِيرًا","numberInSurah":64,"juz":22,"manzil":5,"page":427,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3598,"text":"خَالِدِينَ فِيهَا أَبَدًا ۖ لَا يَجِدُونَ وَلِيًّا وَلَا نَصِيرًا","numberInSurah":65,"juz":22,"manzil":5,"page":427,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3599,"text":"يَوْمَ تُقَلَّبُ وُجُوهُهُمْ فِي النَّارِ يَقُولُونَ يَا لَيْتَنَا أَطَعْنَا اللَّهَ وَأَطَعْنَا الرَّسُولَا","numberInSurah":66,"juz":22,"manzil":5,"page":427,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3600,"text":"وَقَالُوا رَبَّنَا إِنَّا أَطَعْنَا سَادَتَنَا وَكُبَرَاءَنَا فَأَضَلُّونَا السَّبِيلَا","numberInSurah":67,"juz":22,"manzil":5,"page":427,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3601,"text":"رَبَّنَا آتِهِمْ ضِعْفَيْنِ مِنَ الْعَذَابِ وَالْعَنْهُمْ لَعْنًا كَبِيرًا","numberInSurah":68,"juz":22,"manzil":5,"page":427,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3602,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَكُونُوا كَالَّذِينَ آذَوْا مُوسَىٰ فَبَرَّأَهُ اللَّهُ مِمَّا قَالُوا ۚ وَكَانَ عِنْدَ اللَّهِ وَجِيهًا","numberInSurah":69,"juz":22,"manzil":5,"page":427,"ruku":369,"hizbQuarter":171,"sajda":false},{"number":3603,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَقُولُوا قَوْلًا سَدِيدًا","numberInSurah":70,"juz":22,"manzil":5,"page":427,"ruku":369,"hizbQuarter":171,"sajda":false},{"number":3604,"text":"يُصْلِحْ لَكُمْ أَعْمَالَكُمْ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ ۗ وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ فَقَدْ فَازَ فَوْزًا عَظِيمًا","numberInSurah":71,"juz":22,"manzil":5,"page":427,"ruku":369,"hizbQuarter":171,"sajda":false},{"number":3605,"text":"إِنَّا عَرَضْنَا الْأَمَانَةَ عَلَى السَّمَاوَاتِ وَالْأَرْضِ وَالْجِبَالِ فَأَبَيْنَ أَنْ يَحْمِلْنَهَا وَأَشْفَقْنَ مِنْهَا وَحَمَلَهَا الْإِنْسَانُ ۖ إِنَّهُ كَانَ ظَلُومًا جَهُولًا","numberInSurah":72,"juz":22,"manzil":5,"page":427,"ruku":369,"hizbQuarter":171,"sajda":false},{"number":3606,"text":"لِيُعَذِّبَ اللَّهُ الْمُنَافِقِينَ وَالْمُنَافِقَاتِ وَالْمُشْرِكِينَ وَالْمُشْرِكَاتِ وَيَتُوبَ اللَّهُ عَلَى الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ۗ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","numberInSurah":73,"juz":22,"manzil":5,"page":427,"ruku":369,"hizbQuarter":171,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":33,"name":"سُورَةُ الأَحۡزَابِ","englishName":"Ahzâb","englishNameTranslation":"The Clans","revelationType":"Medinan","numberOfAyahs":73,"ayahs":[{"number":3534,"text":"Ey peygamber! Allah'tan sakın, inkarcılara ve iki yüzlülere uyma, Allah şüphesiz bilendir, hakim'dir.","numberInSurah":1,"juz":21,"manzil":5,"page":418,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3535,"text":"Sana Rabbinden vahyolunana uy; şüphesiz Allah, yaptıklarınızdan haberdardır.","numberInSurah":2,"juz":21,"manzil":5,"page":418,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3536,"text":"Allah'a güven, Allah, vekil olarak yeter.","numberInSurah":3,"juz":21,"manzil":5,"page":418,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3537,"text":"Allah insanın içine iki kalp koymamıştır. Allah, zıhar yapmanız suretiyle eşlerinizi, anneleriniz gibi yaratmamıştır; evlatlıklarınızı da öz oğullarınız gibi saymanızı meşru kılmamıştır. Bunlar sizin dillerinize doladığınız boş sözlerdir. Allah gerçeği söylemektedir, doğru yola O eriştirir.","numberInSurah":4,"juz":21,"manzil":5,"page":418,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3538,"text":"Evlatlıkları babalarına nisbet edin, bu Allah katında en doğru olandır. Eğer babalarının kim olduğunu bilmiyorsanız, bu takdirde onları din kardeşi ve dostlarınız olarak kabul edin. İçinizden kasdederek yaptıklarınız bir yana, yanılmalarınızda size bir sorumluluk yoktur. Allah, bağışlar ve merhamet eder.","numberInSurah":5,"juz":21,"manzil":5,"page":418,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3539,"text":"Müminlerin, Peygamberi kendi nefislerinden çok sevmeleri gerekir; onun eşleri onların anneleridir; akraba olanlar, miras hususunda, Allah'ın Kitap'ında birbirlerine müminler ve muhacirlerden daha yakındırlar. Dostlarınıza yapacağınız uygun bir vasiyet bunun dışındadır. Bu Kitap'ta yazılı bulunmaktadır.","numberInSurah":6,"juz":21,"manzil":5,"page":418,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3540,"text":"Peygamberlerden söz almıştık. Senden, Nuh'dan, İbrahim'den, Musa'dan, Meryem oğlu İsa'dan sağlam bir söz almışızdır.","numberInSurah":7,"juz":21,"manzil":5,"page":419,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3541,"text":"Allah, doğrulardan doğruluklarını sormak ve inkarcılara can yakıcı azap hazırlamak için bunu yapmıştır.","numberInSurah":8,"juz":21,"manzil":5,"page":419,"ruku":361,"hizbQuarter":167,"sajda":false},{"number":3542,"text":"Ey inananlar! Allah'ın size olan nimetini anın; üzerinize ordular gelmişti. Biz de onların üzerine rüzgar ve göremediğiniz ordular göndermiştik. Allah, yaptıklarınızı görüyordu.","numberInSurah":9,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3543,"text":"Onlar size yukarınızdan ve aşağınızdan gelmişlerdi; gözler de dönmüştü, yürekler ağızlara gelmişti; Allah için çeşitli tahminlerde bulunuyordunuz.","numberInSurah":10,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3544,"text":"İşte orada, inananlar denenmiş ve çok şiddetli sarsıntıya uğratılmışlardı.","numberInSurah":11,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3545,"text":"İkiyüzlüler ve kalblerinde hastalık olanlar: \"Allah ve Peygamberi bize sadece kuru vaadlerde bulundular\" diyorlardı.","numberInSurah":12,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3546,"text":"İçlerinden bir takımı: \"Ey Medineliler! Tutunacak yeriniz yok, geri dönün\" demişti. İçlerinden bir topluluk da Peygamberden: \"Evlerimiz düşmana açıktır\" diyerek izin istemişlerdi. Oysa evleri açık değildi sadece kaçmak istiyorlardı.","numberInSurah":13,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3547,"text":"Eğer Medine'nin etrafından üzerlerine varılmış olsa, sonra da kendilerinden fitne çıkarmaları istense hemen buna girişip derhal yapmaktan geri kalmazlardı.","numberInSurah":14,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3548,"text":"And olsun ki, daha önce, sırt çevirip kaçmayacaklarına dair Allah'a ahd vermişlerdi. Allah'a verilen ahd sorulacaktır.","numberInSurah":15,"juz":21,"manzil":5,"page":419,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3549,"text":"De ki: \"Eğer ölümden yahut öldürülmekten kaçıyorsanız bilin ki, kaçmak size fayda vermeyecektir; kaçsanız bile az bir zamandan fazla yaşatılmazsınız.\"","numberInSurah":16,"juz":21,"manzil":5,"page":420,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3550,"text":"De ki: \"Allah size bir kötülük dilese veya bir rahmet istese, O'na karşı kim sizi koruyabilir? Allah'tan başka dost ve yardımcı da bulamazsınız.\"","numberInSurah":17,"juz":21,"manzil":5,"page":420,"ruku":362,"hizbQuarter":167,"sajda":false},{"number":3551,"text":"Allah, içinizden sizi alıkoyanları, size Allah'ın yardımını kıskanarak, kardeşlerine \"Bize gelin, zorlanmadıkça savaşa gitmeyin\" diyenleri bilir. Kalblerine korku gelince ölüm baygınlığı geçiren kimse gibi gözleri dönerek, sana baktıklarını görürsün. Korkuları gidince iyiliğinize olanı çekemeyip sivri dilleriyle sizi incitirler. Bunlar inanmamışlardır, Allah, bu sebeple işlerini boşa çıkarmıştır; bu, Allah için kolaydır.","numberInSurah":18,"juz":21,"manzil":5,"page":420,"ruku":362,"hizbQuarter":168,"sajda":false},{"number":3552,"text":"Allah, içinizden sizi alıkoyanları, size Allah'ın yardımını kıskanarak, kardeşlerine \"Bize gelin, zorlanmadıkça savaşa gitmeyin\" diyenleri bilir. Kalblerine korku gelince ölüm baygınlığı geçiren kimse gibi gözleri dönerek, sana baktıklarını görürsün. Korkuları gidince iyiliğinize olanı çekemeyip sivri dilleriyle sizi incitirler. Bunlar inanmamışlardır, Allah, bu sebeple işlerini boşa çıkarmıştır; bu, Allah için kolaydır.","numberInSurah":19,"juz":21,"manzil":5,"page":420,"ruku":362,"hizbQuarter":168,"sajda":false},{"number":3553,"text":"Bunlar, düşman birliklerinin gitmediklerini sanıyorlardı. Bu birlikler tekrar gelmiş olsalardı, kendileri çöllerde bedevilerin yanında bulunup, sadece sizin haberlerinizi sormayı dilerlerdi. Aranızda olsalar ancak pek az savaşırlardı.","numberInSurah":20,"juz":21,"manzil":5,"page":420,"ruku":362,"hizbQuarter":168,"sajda":false},{"number":3554,"text":"Ey inananlar! And olsun ki, sizin için, Allah'a ve ahiret gününe kavuşmayı umanlar ve Allah'ı çok anan kimseler için Resulullah (Allah'ın Elçisi) en güzel örnektir.","numberInSurah":21,"juz":21,"manzil":5,"page":420,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3555,"text":"İnananlar, düşman birliklerini gördükleri zaman: \"İşte bu, Allah ve Peygamberinin bize vadettiğidir; Allah ve Peygamberi doğru söylemiştir\" dediler. Bu onların ancak imanını ve teslimiyetlerini artırdı.","numberInSurah":22,"juz":21,"manzil":5,"page":420,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3556,"text":"İnananlardan, Allah'a verdiği ahdi yerine getiren adamlar vardır. Kimi, bu uğurda canını vermiş, kimi de beklemektedir. Ahdlerini hiç değiştirmemişlerdir.","numberInSurah":23,"juz":21,"manzil":5,"page":421,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3557,"text":"Bu sebeple Allah, doğruları doğrulukları ile mükafatlandırır; ikiyüzlüleri de dilerse azablandırır veya tevbelerini kabul eder. Şüphesiz Allah bağışlayandır, merhamet edendir.","numberInSurah":24,"juz":21,"manzil":5,"page":421,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3558,"text":"Allah inkar edenleri, kinleriyle geri çevirdi, bir hayra ulaşamadılar; savaşta, inananlara Allah'ın yardımı yetti. Allah kuvvetli olandır, güçlü olandır.","numberInSurah":25,"juz":21,"manzil":5,"page":421,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3559,"text":"Allah, Kitap ehlinden, kafirleri destekleyenleri kalelerinden indirmiş, kalblerine korku salmıştı; onların kimini öldürüyor, kimini de esir alıyordunuz.","numberInSurah":26,"juz":21,"manzil":5,"page":421,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3560,"text":"Yerlerini, yurtlarını, mallarını ve henüz ayağınızı dahi basmadığınız yerleri Allah size miras olarak verdi. Allah her şeye Kadir olandır.","numberInSurah":27,"juz":21,"manzil":5,"page":421,"ruku":363,"hizbQuarter":168,"sajda":false},{"number":3561,"text":"Ey Peygamber! Eşlerine şöyle söyle: \"Eğer dünya hayatını ve süslerini istiyorsanız gelin size bağışta bulunayım ve güzellikle salıvereyim.\"","numberInSurah":28,"juz":21,"manzil":5,"page":421,"ruku":364,"hizbQuarter":168,"sajda":false},{"number":3562,"text":"\"Eğer Allah'ı, Peygamberini, ahiret yurdunu istiyorsanız bilin ki, Allah içinizden iyi davrananlara büyük ecir hazırlamıştır.\"","numberInSurah":29,"juz":21,"manzil":5,"page":421,"ruku":364,"hizbQuarter":168,"sajda":false},{"number":3563,"text":"Ey Peygamber'in hanımları! Sizlerden biri açık bir hayasızlık yapacak olursa, onun azabı iki kat olur. Bu Allah'a kolaydır.","numberInSurah":30,"juz":21,"manzil":5,"page":421,"ruku":364,"hizbQuarter":168,"sajda":false},{"number":3564,"text":"Sizlerden Allah'a ve Peygamberine boyun eğip yararlı iş işleyenlere ecrini iki kat veririz; ona cömertçe rızık hazırlamışızdır.","numberInSurah":31,"juz":22,"manzil":5,"page":422,"ruku":364,"hizbQuarter":169,"sajda":false},{"number":3565,"text":"Ey Peygamberin hanımları! Sizler herhangi bir kadın gibi değilsiniz. Allah'tan sakınıyorsanız edalı konuşmayın, yoksa, kalbi bozuk olan kimse kötü şeyler ümit eder; daima ciddi ve ağırbaşlı söz söyleyin.","numberInSurah":32,"juz":22,"manzil":5,"page":422,"ruku":364,"hizbQuarter":169,"sajda":false},{"number":3566,"text":"Evlerinizde oturun; eski Cahiliyye'de olduğu gibi açılıp saçılmayın; namazı kılın; zekatı verin; Allah'a ve Peygamberine itaat edin. Ey Peygamberin ev halkı! (ehl-i beyt) Şüphesiz Allah sizden kusuru giderip sizi tertemiz yapmak ister.","numberInSurah":33,"juz":22,"manzil":5,"page":422,"ruku":364,"hizbQuarter":169,"sajda":false},{"number":3567,"text":"Evlerinizde okunan Allah'ın ayetlerini ve hikmetini hatırda tutun. Şüphesiz Allah haberdar olandır, latif olandır.","numberInSurah":34,"juz":22,"manzil":5,"page":422,"ruku":364,"hizbQuarter":169,"sajda":false},{"number":3568,"text":"Doğrusu erkek ve kadın müslümanlar, erkek ve kadın müminler, boyun eğen erkekler ve kadınlar, doğru sözlü erkekler ve kadınlar, sabırlı erkekler ve kadınlar, gönülden bağlanan erkekler ve kadınlar, sadaka veren erkekler ve kadınlar, oruç tutan erkekler ve kadınlar iffetlerini koruyan erkekler ve kadınlar, Allah'ı çok anan erkekler ve kadınlar, işte Allah bunların hepsine mağfiret ve büyük ecir hazırlamıştır.","numberInSurah":35,"juz":22,"manzil":5,"page":422,"ruku":365,"hizbQuarter":169,"sajda":false},{"number":3569,"text":"Allah ve Peygamber'i bir şeye hükmettiği zaman, inanan erkek ve kadına artık işlerinde başka yolu seçmek yaraşmaz. Allah'a ve Peygamber'e baş kaldıran şüphesiz apaçık bir şekilde sapmış olur.","numberInSurah":36,"juz":22,"manzil":5,"page":423,"ruku":365,"hizbQuarter":169,"sajda":false},{"number":3570,"text":"Allah'ın nimet verdiği ve senin de nimetlendirdiğin kimseye: \"Eşini bırakma, Allah'tan sakın\" diyor, Allah'ın açığa vuracağı şeyi içinde saklıyordun. İnsanlardan çekiniyordun; oysa Allah'tan çekinmen daha uygundu. Sonunda Zeyd eşiyle ilgisini kestiğinde onu seninle evlendirdik, ki evlatlıkları eşleriyle ilgilerini kestiklerinde onlarla evlenmek konusunda müminlere bir sorumluluk olmadığı bilinsin. Allah'ın buyruğu yerine gelecektir.","numberInSurah":37,"juz":22,"manzil":5,"page":423,"ruku":365,"hizbQuarter":169,"sajda":false},{"number":3571,"text":"Allah'ın Peygamber'e farz kıldığı şeylerde ona bir güçlük yoktur. Bu, Allah'ın öteden beri, gelmiş geçmişlere uyguladığı yasasıdır. Allah'ın emri şüphesiz gereği gibi yerine gelecektir.","numberInSurah":38,"juz":22,"manzil":5,"page":423,"ruku":365,"hizbQuarter":169,"sajda":false},{"number":3572,"text":"Allah'ın göndermiş olduklarını tebliğ edenler, Allah'tan korkarlar ve O'ndan başka kimseden korkmazlar. Allah hesap gören olarak yeter.","numberInSurah":39,"juz":22,"manzil":5,"page":423,"ruku":365,"hizbQuarter":169,"sajda":false},{"number":3573,"text":"Muhammed içinizden herhangi bir adamın babası değil, Allah'ın elçisi ve peygamberlerin sonuncusudur. Allah her şeyi bilendir.","numberInSurah":40,"juz":22,"manzil":5,"page":423,"ruku":365,"hizbQuarter":169,"sajda":false},{"number":3574,"text":"Ey inananlar! Allah'ı çok anın.","numberInSurah":41,"juz":22,"manzil":5,"page":423,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3575,"text":"O'nu sabah akşam tesbih edin.","numberInSurah":42,"juz":22,"manzil":5,"page":423,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3576,"text":"Karanlıklardan aydınlığa çıkarmak için size rahmet ve istiğfar eden Allah ve melekleridir. İnananlara merhamet eden O'dur.","numberInSurah":43,"juz":22,"manzil":5,"page":423,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3577,"text":"O'na kavuştukları gün müminlere yapılacak dirlik temennileri \"Selam\" demek olacaktır. Onlara cömertçe verilecek ecir hazırlamıştır.","numberInSurah":44,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3578,"text":"Biz seni şahit, müjdeci, uyarıcı; Allah'ın izniyle O'na çağıran, nurlandıran bir ışık olarak göndermişizdir.","numberInSurah":45,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3579,"text":"Biz seni şahit, müjdeci, uyarıcı; Allah'ın izniyle O'na çağıran, nurlandıran bir ışık olarak göndermişizdir.","numberInSurah":46,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3580,"text":"İnananlara, Rablerinden büyük bir lütuf olduğunu müjdele.","numberInSurah":47,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3581,"text":"İnkarcılara, ikiyüzlülere itaat etme; eziyetlerine aldırma; Allah'a güven, güvenilecek olarak Allah yeter.","numberInSurah":48,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3582,"text":"Ey inananlar! Mümin kadınlarla nikahlanıp, onları, temasta bulunmadan boşadığınızda, artık onlar için size iddet saymaya lüzum yoktur. Kendilerine bağışta bulunarak onları güzellikle serbest bırakın.","numberInSurah":49,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3583,"text":"Mehirlerini verdiğin eşlerini, Allah'ın sana ganimet olarak verdiği cariyeleri, seninle beraber hicret eden amcanın kızlarını, halalarının kızlarını, dayının kızlarını, teyzelerinin kızlarını ve Peygamber nikahlanmayı dilediği takdirde müminlerden ayrı, sırf sana mahsus olmak üzere kendisinin mehrini Peygambere hibe eden mümin kadını almanı helal kılmışızdır. Bir zorluğa uğramaman için; müminlerin eşleri ve cariyeleri hakkında onların üzerine neyi farz kılmış olduğumuzu bildirmiştik. Allah bağışlayandır, merhamet edendir.","numberInSurah":50,"juz":22,"manzil":5,"page":424,"ruku":366,"hizbQuarter":169,"sajda":false},{"number":3584,"text":"Bunlardan istediğini bırakır, istediğini yanına alabilirsin. Sırasını geri bırakmış olduklarından da arzu ettiğini yanına almanda sana bir sorumluluk yoktur. Bu onların gözlerinin aydın olmasını, üzülmemelerini, hepsine verdiğin şeylere razı olmalarını daha iyi sağlar. Allah kalblerinizde olanı bilir; Allah bilendir, Halim olandır.","numberInSurah":51,"juz":22,"manzil":5,"page":425,"ruku":366,"hizbQuarter":170,"sajda":false},{"number":3585,"text":"Bundan sonra sana hiçbir kadın, cariyelerin bir yana, güzellikleri ne kadar hoşuna giderse gitsin, hiçbirini boşayıp başka bir eşle değiştirmen helal değildir. Allah her şeyi gözetmektedir.","numberInSurah":52,"juz":22,"manzil":5,"page":425,"ruku":366,"hizbQuarter":170,"sajda":false},{"number":3586,"text":"Ey inananlar! Peygamber'in evlerine, yemeğe çağırılmaksızın vakitli vakitsiz girmeyin; fakat davet edilseniz girin ve yemeği yiyince, dağılın. Sohbet etmek için de girip oturmayın. Bu haliniz Peygamber'i üzüyor, o da size bir şey söylemeye çekiniyordu. Allah gerçeği söylemekten çekinmez. Peygamber'in eşlerinden bir şey isteyeceğinizde onu perde arkasından isteyin. Bu sayede sizin gönülleriniz de, onların gönülleri de daha temiz kalır. Bundan sonra ne Allah'ın Peygamber'ini üzmeniz ve ne de O'nuneşlerini nikahlamanız asla caiz değildir. Doğrusu bu, Allah katında büyük şeydir.","numberInSurah":53,"juz":22,"manzil":5,"page":425,"ruku":367,"hizbQuarter":170,"sajda":false},{"number":3587,"text":"Bir şeyi açıklasanız de gizleseniz de Allah şüphesiz hepsini bilir.","numberInSurah":54,"juz":22,"manzil":5,"page":425,"ruku":367,"hizbQuarter":170,"sajda":false},{"number":3588,"text":"Onların; babaları, oğulları, erkek kardeşleri, erkek kardeşlerinin oğulları, kız kardeşlerinin oğulları, hizmetçi kadınları ve cariyeleri hakkında bir sorumluluğu yoktur. Allah'tan sakının, çünkü Allah her şeye şahiddir.","numberInSurah":55,"juz":22,"manzil":5,"page":426,"ruku":367,"hizbQuarter":170,"sajda":false},{"number":3589,"text":"Şüphesiz Allah ve melekleri Peygamberi överler: Ey inananlar! Siz de onu övün, ona salat ve selam getirin.","numberInSurah":56,"juz":22,"manzil":5,"page":426,"ruku":367,"hizbQuarter":170,"sajda":false},{"number":3590,"text":"Allah'ı ve Peygamber'ini incitenlere, Allah dünyada da ahirette de lanet eder; onlara alçaltıcı bir azap hazırlar.","numberInSurah":57,"juz":22,"manzil":5,"page":426,"ruku":367,"hizbQuarter":170,"sajda":false},{"number":3591,"text":"İnanan erkek ve kadınları, yapmadıkları bir şeyden ötürü incitenler, şüphesiz iftira etmiş ve apaçık bir günah yüklenmiş olurlar.","numberInSurah":58,"juz":22,"manzil":5,"page":426,"ruku":367,"hizbQuarter":170,"sajda":false},{"number":3592,"text":"Ey Peygamber! Eşlerine, kızlarına ve müminlerin kadınlarına, dışarı çıkarken üstlerine örtü almalarını söyle; bu, onların hür ve namuslu bilinmelerini ve bundan dolayı incitilmemelerini daha iyi sağlar. Allah bağışlar ve merhamet eder.","numberInSurah":59,"juz":22,"manzil":5,"page":426,"ruku":368,"hizbQuarter":170,"sajda":false},{"number":3593,"text":"İkiyüzlüler, kalblerinde fesat bulunanlar, şehirde bozguncu haberler yayanlar, eğer bundan vazgeçmezlerse, and olsun ki, seni onlarla mücadeleye davet ederiz; sonra çevrende az bir zamandan fazla kalamazlar.","numberInSurah":60,"juz":22,"manzil":5,"page":426,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3594,"text":"Lanetlenmiş olarak, nerede bulunurlarsa yakalanır ve hem de öldürülürler.","numberInSurah":61,"juz":22,"manzil":5,"page":426,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3595,"text":"Allah'ın geçmişlere uyguladığı yasası budur ve Allah'ın yasasında bir değişme bulamazsın.","numberInSurah":62,"juz":22,"manzil":5,"page":426,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3596,"text":"İnsanlar senden kıyametin zamanını soruyorlar; de ki: \"Onun bilgisi ancak Allah katındadır; ne bilirsin, belki de zamanı yakındır.\"","numberInSurah":63,"juz":22,"manzil":5,"page":427,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3597,"text":"Allah şüphesiz, inkarcılara lanet etmiş ve onlara içinde sonsuz olarak temelli kalacakları çılgın alevli cehennemi hazırlamıştır. Onlar bir dost ve yardımcı bulamazlar.","numberInSurah":64,"juz":22,"manzil":5,"page":427,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3598,"text":"Allah şüphesiz, inkarcılara lanet etmiş ve onlara içinde sonsuz olarak temelli kalacakları çılgın alevli cehennemi hazırlamıştır. Onlar bir dost ve yardımcı bulamazlar.","numberInSurah":65,"juz":22,"manzil":5,"page":427,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3599,"text":"Yüzleri ateşte çevrildiği gün: \"Keşke Allah'a itaat etseydik, keşke Peygamber'e itaat etseydik!\" derler.","numberInSurah":66,"juz":22,"manzil":5,"page":427,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3600,"text":"\"Rabbimiz! Biz yöneticilerimize ve büyüklerimize itaat etmiştik, fakat onlar bizi yoldan saptırdılar.\", \"Rabbimiz! Onlara iki kat azap ver, onları büyük bir lanete uğrat\" derler.","numberInSurah":67,"juz":22,"manzil":5,"page":427,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3601,"text":"\"Rabbimiz! Biz yöneticilerimize ve büyüklerimize itaat etmiştik, fakat onlar bizi yoldan saptırdılar.\", \"Rabbimiz! Onlara iki kat azap ver, onları büyük bir lanete uğrat\" derler.","numberInSurah":68,"juz":22,"manzil":5,"page":427,"ruku":368,"hizbQuarter":171,"sajda":false},{"number":3602,"text":"Ey inananlar! Musa'yı incitenler gibi olmayın. Nitekim Allah onu, söylediklerinden beri tutmuştu. O, Allah'ın katında değerli bir kişiydi.","numberInSurah":69,"juz":22,"manzil":5,"page":427,"ruku":369,"hizbQuarter":171,"sajda":false},{"number":3603,"text":"Ey inananlar! Allah'tan sakının, dürüst söz söyleyin de Allah işlerinizi kendinize yararlı kılsın ve günahlarınızı size bağışlasın. Kim Allah'a ve Peygamber'ine itaat ederse, şüphesiz büyük bir kurtuluşa ermiş olur.","numberInSurah":70,"juz":22,"manzil":5,"page":427,"ruku":369,"hizbQuarter":171,"sajda":false},{"number":3604,"text":"Ey inananlar! Allah'tan sakının, dürüst söz söyleyin de Allah işlerinizi kendinize yararlı kılsın ve günahlarınızı size bağışlasın. Kim Allah'a ve Peygamber'ine itaat ederse, şüphesiz büyük bir kurtuluşa ermiş olur.","numberInSurah":71,"juz":22,"manzil":5,"page":427,"ruku":369,"hizbQuarter":171,"sajda":false},{"number":3605,"text":"Doğrusu Biz, sorumluluğu (emaneti) göklere, yere, dağlara sunmuşuzdur da onlar bunu yüklenmekten çekinmişler ve ondan korkup titremişlerdir; onu insan yüklendi. Doğrusu o çok zalim ve çok cahildir. (kabulüne rağmen emanete hıyanet etmektedir)","numberInSurah":72,"juz":22,"manzil":5,"page":427,"ruku":369,"hizbQuarter":171,"sajda":false},{"number":3606,"text":"Bunun sonucu olarak, Allah, ikiyüzlü erkek ve kadınlara, Allah'a ortak koşan erkek ve kadınlara azap verecektir. Allah inanan erkek ve kadınların tevbelerini kabul buyuracaktır. Allah bağışlar ve merhamet eder.","numberInSurah":73,"juz":22,"manzil":5,"page":427,"ruku":369,"hizbQuarter":171,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}