{"arabic":{"number":68,"name":"سُورَةُ القَلَمِ","englishName":"Kalem","englishNameTranslation":"The Pen","revelationType":"Meccan","numberOfAyahs":52,"ayahs":[{"number":5272,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ ن ۚ وَالْقَلَمِ وَمَا يَسْطُرُونَ","numberInSurah":1,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5273,"text":"مَا أَنْتَ بِنِعْمَةِ رَبِّكَ بِمَجْنُونٍ","numberInSurah":2,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5274,"text":"وَإِنَّ لَكَ لَأَجْرًا غَيْرَ مَمْنُونٍ","numberInSurah":3,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5275,"text":"وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ","numberInSurah":4,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5276,"text":"فَسَتُبْصِرُ وَيُبْصِرُونَ","numberInSurah":5,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5277,"text":"بِأَيْيِكُمُ الْمَفْتُونُ","numberInSurah":6,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5278,"text":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيلِهِ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ","numberInSurah":7,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5279,"text":"فَلَا تُطِعِ الْمُكَذِّبِينَ","numberInSurah":8,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5280,"text":"وَدُّوا لَوْ تُدْهِنُ فَيُدْهِنُونَ","numberInSurah":9,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5281,"text":"وَلَا تُطِعْ كُلَّ حَلَّافٍ مَهِينٍ","numberInSurah":10,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5282,"text":"هَمَّازٍ مَشَّاءٍ بِنَمِيمٍ","numberInSurah":11,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5283,"text":"مَنَّاعٍ لِلْخَيْرِ مُعْتَدٍ أَثِيمٍ","numberInSurah":12,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5284,"text":"عُتُلٍّ بَعْدَ ذَٰلِكَ زَنِيمٍ","numberInSurah":13,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5285,"text":"أَنْ كَانَ ذَا مَالٍ وَبَنِينَ","numberInSurah":14,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5286,"text":"إِذَا تُتْلَىٰ عَلَيْهِ آيَاتُنَا قَالَ أَسَاطِيرُ الْأَوَّلِينَ","numberInSurah":15,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5287,"text":"سَنَسِمُهُ عَلَى الْخُرْطُومِ","numberInSurah":16,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5288,"text":"إِنَّا بَلَوْنَاهُمْ كَمَا بَلَوْنَا أَصْحَابَ الْجَنَّةِ إِذْ أَقْسَمُوا لَيَصْرِمُنَّهَا مُصْبِحِينَ","numberInSurah":17,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5289,"text":"وَلَا يَسْتَثْنُونَ","numberInSurah":18,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5290,"text":"فَطَافَ عَلَيْهَا طَائِفٌ مِنْ رَبِّكَ وَهُمْ نَائِمُونَ","numberInSurah":19,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5291,"text":"فَأَصْبَحَتْ كَالصَّرِيمِ","numberInSurah":20,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5292,"text":"فَتَنَادَوْا مُصْبِحِينَ","numberInSurah":21,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5293,"text":"أَنِ اغْدُوا عَلَىٰ حَرْثِكُمْ إِنْ كُنْتُمْ صَارِمِينَ","numberInSurah":22,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5294,"text":"فَانْطَلَقُوا وَهُمْ يَتَخَافَتُونَ","numberInSurah":23,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5295,"text":"أَنْ لَا يَدْخُلَنَّهَا الْيَوْمَ عَلَيْكُمْ مِسْكِينٌ","numberInSurah":24,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5296,"text":"وَغَدَوْا عَلَىٰ حَرْدٍ قَادِرِينَ","numberInSurah":25,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5297,"text":"فَلَمَّا رَأَوْهَا قَالُوا إِنَّا لَضَالُّونَ","numberInSurah":26,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5298,"text":"بَلْ نَحْنُ مَحْرُومُونَ","numberInSurah":27,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5299,"text":"قَالَ أَوْسَطُهُمْ أَلَمْ أَقُلْ لَكُمْ لَوْلَا تُسَبِّحُونَ","numberInSurah":28,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5300,"text":"قَالُوا سُبْحَانَ رَبِّنَا إِنَّا كُنَّا ظَالِمِينَ","numberInSurah":29,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5301,"text":"فَأَقْبَلَ بَعْضُهُمْ عَلَىٰ بَعْضٍ يَتَلَاوَمُونَ","numberInSurah":30,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5302,"text":"قَالُوا يَا وَيْلَنَا إِنَّا كُنَّا طَاغِينَ","numberInSurah":31,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5303,"text":"عَسَىٰ رَبُّنَا أَنْ يُبْدِلَنَا خَيْرًا مِنْهَا إِنَّا إِلَىٰ رَبِّنَا رَاغِبُونَ","numberInSurah":32,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5304,"text":"كَذَٰلِكَ الْعَذَابُ ۖ وَلَعَذَابُ الْآخِرَةِ أَكْبَرُ ۚ لَوْ كَانُوا يَعْلَمُونَ","numberInSurah":33,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5305,"text":"إِنَّ لِلْمُتَّقِينَ عِنْدَ رَبِّهِمْ جَنَّاتِ النَّعِيمِ","numberInSurah":34,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5306,"text":"أَفَنَجْعَلُ الْمُسْلِمِينَ كَالْمُجْرِمِينَ","numberInSurah":35,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5307,"text":"مَا لَكُمْ كَيْفَ تَحْكُمُونَ","numberInSurah":36,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5308,"text":"أَمْ لَكُمْ كِتَابٌ فِيهِ تَدْرُسُونَ","numberInSurah":37,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5309,"text":"إِنَّ لَكُمْ فِيهِ لَمَا تَخَيَّرُونَ","numberInSurah":38,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5310,"text":"أَمْ لَكُمْ أَيْمَانٌ عَلَيْنَا بَالِغَةٌ إِلَىٰ يَوْمِ الْقِيَامَةِ ۙ إِنَّ لَكُمْ لَمَا تَحْكُمُونَ","numberInSurah":39,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5311,"text":"سَلْهُمْ أَيُّهُمْ بِذَٰلِكَ زَعِيمٌ","numberInSurah":40,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5312,"text":"أَمْ لَهُمْ شُرَكَاءُ فَلْيَأْتُوا بِشُرَكَائِهِمْ إِنْ كَانُوا صَادِقِينَ","numberInSurah":41,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5313,"text":"يَوْمَ يُكْشَفُ عَنْ سَاقٍ وَيُدْعَوْنَ إِلَى السُّجُودِ فَلَا يَسْتَطِيعُونَ","numberInSurah":42,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5314,"text":"خَاشِعَةً أَبْصَارُهُمْ تَرْهَقُهُمْ ذِلَّةٌ ۖ وَقَدْ كَانُوا يُدْعَوْنَ إِلَى السُّجُودِ وَهُمْ سَالِمُونَ","numberInSurah":43,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5315,"text":"فَذَرْنِي وَمَنْ يُكَذِّبُ بِهَٰذَا الْحَدِيثِ ۖ سَنَسْتَدْرِجُهُمْ مِنْ حَيْثُ لَا يَعْلَمُونَ","numberInSurah":44,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5316,"text":"وَأُمْلِي لَهُمْ ۚ إِنَّ كَيْدِي مَتِينٌ","numberInSurah":45,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5317,"text":"أَمْ تَسْأَلُهُمْ أَجْرًا فَهُمْ مِنْ مَغْرَمٍ مُثْقَلُونَ","numberInSurah":46,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5318,"text":"أَمْ عِنْدَهُمُ الْغَيْبُ فَهُمْ يَكْتُبُونَ","numberInSurah":47,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5319,"text":"فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تَكُنْ كَصَاحِبِ الْحُوتِ إِذْ نَادَىٰ وَهُوَ مَكْظُومٌ","numberInSurah":48,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5320,"text":"لَوْلَا أَنْ تَدَارَكَهُ نِعْمَةٌ مِنْ رَبِّهِ لَنُبِذَ بِالْعَرَاءِ وَهُوَ مَذْمُومٌ","numberInSurah":49,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5321,"text":"فَاجْتَبَاهُ رَبُّهُ فَجَعَلَهُ مِنَ الصَّالِحِينَ","numberInSurah":50,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5322,"text":"وَإِنْ يَكَادُ الَّذِينَ كَفَرُوا لَيُزْلِقُونَكَ بِأَبْصَارِهِمْ لَمَّا سَمِعُوا الذِّكْرَ وَيَقُولُونَ إِنَّهُ لَمَجْنُونٌ","numberInSurah":51,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5323,"text":"وَمَا هُوَ إِلَّا ذِكْرٌ لِلْعَالَمِينَ","numberInSurah":52,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":68,"name":"سُورَةُ القَلَمِ","englishName":"Kalem","englishNameTranslation":"The Pen","revelationType":"Meccan","numberOfAyahs":52,"ayahs":[{"number":5272,"text":"Nun; kalem ve onunla yazılanlara and olsun ki, sen Rabbinin nimetine uğramış bir kimsesin, deli (cinlenmiş) değilsin.","numberInSurah":1,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5273,"text":"Nun; kalem ve onunla yazılanlara and olsun ki, sen Rabbinin nimetine uğramış bir kimsesin, deli (cinlenmiş) değilsin.","numberInSurah":2,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5274,"text":"Doğrusu sana kesintisiz bir ecir vardır.","numberInSurah":3,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5275,"text":"Şüphesiz sen büyük bir ahlaka sahipsindir.","numberInSurah":4,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5276,"text":"Hanginizin aklından zoru olduğunu yakında sen de göreceksin, onlar da görecekler.","numberInSurah":5,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5277,"text":"Hanginizin aklından zoru olduğunu yakında sen de göreceksin, onlar da görecekler.","numberInSurah":6,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5278,"text":"Doğrusu senin Rabbin, yolundan sapıtanları çok iyi bilir; O, doğru yolda olanları da çok iyi bilir.","numberInSurah":7,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5279,"text":"Bundan böyle, yalanlayanlara itaat etme;","numberInSurah":8,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5280,"text":"(Onlar sana indirilen ayetlerden beğenmediklerini bırakman suretiyle senin) kendilerine yumuşak davranmanı isterler; böyle yapsan, onlar da seni över, yumuşak davranırlar.","numberInSurah":9,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5281,"text":"Diliyle iğneleyen, kovuculuk eden, iyiliği daima önleyen, aşırı giden, suç işleyen, çok yemin eden alçak zorbaya, bütün bunlar dışında bir de soysuzlukla damgalanmış kimseye, mal ve oğulları vardır diye aldırış etmeyesin.","numberInSurah":10,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5282,"text":"Diliyle iğneleyen, kovuculuk eden, iyiliği daima önleyen, aşırı giden, suç işleyen, çok yemin eden alçak zorbaya, bütün bunlar dışında bir de soysuzlukla damgalanmış kimseye, mal ve oğulları vardır diye aldırış etmeyesin.","numberInSurah":11,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5283,"text":"Diliyle iğneleyen, kovuculuk eden, iyiliği daima önleyen, aşırı giden, suç işleyen, çok yemin eden alçak zorbaya, bütün bunlar dışında bir de soysuzlukla damgalanmış kimseye, mal ve oğulları vardır diye aldırış etmeyesin.","numberInSurah":12,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5284,"text":"Diliyle iğneleyen, kovuculuk eden, iyiliği daima önleyen, aşırı giden, suç işleyen, çok yemin eden alçak zorbaya, bütün bunlar dışında bir de soysuzlukla damgalanmış kimseye, mal ve oğulları vardır diye aldırış etmeyesin.","numberInSurah":13,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5285,"text":"Diliyle iğneleyen, kovuculuk eden, iyiliği daima önleyen, aşırı giden, suç işleyen, çok yemin eden alçak zorbaya, bütün bunlar dışında bir de soysuzlukla damgalanmış kimseye, mal ve oğulları vardır diye aldırış etmeyesin.","numberInSurah":14,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5286,"text":"Ayetlerimiz ona okunduğu zaman: \"Öncekilerin masalları\" der.","numberInSurah":15,"juz":29,"manzil":7,"page":564,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5287,"text":"Onun havada olan burnunu yakında yere sürteceğiz.","numberInSurah":16,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5288,"text":"Biz bunları, vaktiyle bahçe sahiplerini denediğimiz gibi denedik. Sahipleri daha sabah olmadan, bahçeyi devşireceklerine bir istisna payı bırakmaksızın yemin etmişlerdi.","numberInSurah":17,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5289,"text":"Biz bunları, vaktiyle bahçe sahiplerini denediğimiz gibi denedik. Sahipleri daha sabah olmadan, bahçeyi devşireceklerine bir istisna payı bırakmaksızın yemin etmişlerdi.","numberInSurah":18,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5290,"text":"Ama onlar daha uykudayken Rabbinin katından gönderilen bir salgın o bahçeyi sarıvermişti de bahçe kapkara kesilmişti.","numberInSurah":19,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5291,"text":"Ama onlar daha uykudayken Rabbinin katından gönderilen bir salgın o bahçeyi sarıvermişti de bahçe kapkara kesilmişti.","numberInSurah":20,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5292,"text":"Sabah erken: \"Ürünlerinizi devşirecekseniz erken çıkın\" diye birbirlerine seslendiler.","numberInSurah":21,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5293,"text":"Sabah erken: \"Ürünlerinizi devşirecekseniz erken çıkın\" diye birbirlerine seslendiler.","numberInSurah":22,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5294,"text":"\"Bugün orada, hiçbir düşkün kimse yanımıza sokulmasın\" diye gizli gizli konuşarak yürüyorlardı.","numberInSurah":23,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5295,"text":"\"Bugün orada, hiçbir düşkün kimse yanımıza sokulmasın\" diye gizli gizli konuşarak yürüyorlardı.","numberInSurah":24,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5296,"text":"Yoksullara yardım etmeye güçleri yeterken böyle konuşarak erkenden gittiler.","numberInSurah":25,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5297,"text":"Bahçeyi gördüklerinde: \"Herhalde yolumuzu şaşırmış olacağız; belki de biz yoksun bırakıldık\" dediler.","numberInSurah":26,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5298,"text":"Bahçeyi gördüklerinde: \"Herhalde yolumuzu şaşırmış olacağız; belki de biz yoksun bırakıldık\" dediler.","numberInSurah":27,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5299,"text":"Ortancaları: \"Ben size Allah'ı anmanız gerekmez mi, dememiş miydim?\" dedi.","numberInSurah":28,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5300,"text":"\"Rabbimizi tenzih ederiz; doğrusu biz yazık etmiştik\" dediler.","numberInSurah":29,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5301,"text":"Birbirlerini yermeye başladılar.","numberInSurah":30,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5302,"text":"Sonra şöyle dediler: \"Yazıklar olsun bize; doğrusu azgınlık edenlerdendik.\"","numberInSurah":31,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5303,"text":"\"Belki Rabbimiz bize bundan daha iyisini verir; doğrusu artık, Rabbimizden dilemekteyiz.\"","numberInSurah":32,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5304,"text":"İşte azap böyledir; ama ahiret azabı daha büyüktür; keşke bilseler!","numberInSurah":33,"juz":29,"manzil":7,"page":565,"ruku":498,"hizbQuarter":226,"sajda":false},{"number":5305,"text":"Allah'a karşı gelmekten sakınanlara, Rableri katında nimet cennetleri vardır.","numberInSurah":34,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5306,"text":"Kendilerini Allah'a vermiş olanları hiç suçlular gibi tutar mıyız?","numberInSurah":35,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5307,"text":"Ne oluyorsunuz? Ne biçim hükmediyorsunuz?","numberInSurah":36,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5308,"text":"Yoksa okuduğunuz bir kitabınız mı var?","numberInSurah":37,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5309,"text":"Seçtikleriniz herhalde orada olacaktır.","numberInSurah":38,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5310,"text":"Yoksa aleyhimizde, kıyamet gününe kadar süregidecek ahidleriniz mi var ki, kendinize hükmettikleriniz sizin olacaktır?","numberInSurah":39,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5311,"text":"Sor onlara: \"Bunu kim üzerine alır?\"","numberInSurah":40,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5312,"text":"Yoksa onların ortakları mı vardır? Doğru sözlü iseler ortaklarını getirsinler.","numberInSurah":41,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5313,"text":"O gün işin dehşetinden baldırlar açılır; gözleri dönmüş olarak yüzlerini zillet bürür; secdeye çağırılırlar ama buna güçleri yetmez. Oysa, kendileri sapasağlam oldukları zaman secdeye çağırılmışlardı.","numberInSurah":42,"juz":29,"manzil":7,"page":565,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5314,"text":"O gün işin dehşetinden baldırlar açılır; gözleri dönmüş olarak yüzlerini zillet bürür; secdeye çağırılırlar ama buna güçleri yetmez. Oysa, kendileri sapasağlam oldukları zaman secdeye çağırılmışlardı.","numberInSurah":43,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5315,"text":"Kuran'ı yalanlayanları Bana bırak; Biz onları bilmedikleri yerden yavaş yavaş azaba yaklaştıracağız.","numberInSurah":44,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5316,"text":"Onlara mehil veriyorum; doğrusu Benim tuzağım sağlamdır.","numberInSurah":45,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5317,"text":"Yoksa, sen onlardan ücret istiyorsun da, ağır bir borç altında mı kalıyorlar? Elbette hayır.","numberInSurah":46,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5318,"text":"Yoksa, gaybın bilgisi kendilerinin katında da onlar mı yazıyorlar?","numberInSurah":47,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5319,"text":"Sen Rabbinin hükmüne kadar sabret; balık sahibi (Yunus) gibi olma, o, pek üzgün olarak Rabbine seslenmişti.","numberInSurah":48,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5320,"text":"Rabbinin katından ona bir nimet ulaşmasaydı, kınanmış olarak sahile atılacaktı.","numberInSurah":49,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5321,"text":"Rabbi onu seçip iyilerden kıldı. Doğrusu inkar edenler, Kuran'ı dinlediklerinde nerdeyse seni gözleriyle yıkıp devireceklerdi. \"O delidir\" diyorlardı.","numberInSurah":50,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5322,"text":"Rabbi onu seçip iyilerden kıldı. Doğrusu inkar edenler, Kuran'ı dinlediklerinde nerdeyse seni gözleriyle yıkıp devireceklerdi. \"O delidir\" diyorlardı.","numberInSurah":51,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false},{"number":5323,"text":"Oysa Kuran, alemler için bir öğütten başka bir şey değildir.","numberInSurah":52,"juz":29,"manzil":7,"page":566,"ruku":499,"hizbQuarter":226,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}