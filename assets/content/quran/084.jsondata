{"arabic":{"number":84,"name":"سُورَةُ الانشِقَاقِ","englishName":"İnşikâk","englishNameTranslation":"The Splitting Open","revelationType":"Meccan","numberOfAyahs":25,"ayahs":[{"number":5885,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِذَا السَّمَاءُ انْشَقَّتْ","numberInSurah":1,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5886,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","numberInSurah":2,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5887,"text":"وَإِذَا الْأَرْضُ مُدَّتْ","numberInSurah":3,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5888,"text":"وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ","numberInSurah":4,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5889,"text":"وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ","numberInSurah":5,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5890,"text":"يَا أَيُّهَا الْإِنْسَانُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَاقِيهِ","numberInSurah":6,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5891,"text":"فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ","numberInSurah":7,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5892,"text":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا","numberInSurah":8,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5893,"text":"وَيَنْقَلِبُ إِلَىٰ أَهْلِهِ مَسْرُورًا","numberInSurah":9,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5894,"text":"وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ وَرَاءَ ظَهْرِهِ","numberInSurah":10,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5895,"text":"فَسَوْفَ يَدْعُو ثُبُورًا","numberInSurah":11,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5896,"text":"وَيَصْلَىٰ سَعِيرًا","numberInSurah":12,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5897,"text":"إِنَّهُ كَانَ فِي أَهْلِهِ مَسْرُورًا","numberInSurah":13,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5898,"text":"إِنَّهُ ظَنَّ أَنْ لَنْ يَحُورَ","numberInSurah":14,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5899,"text":"بَلَىٰ إِنَّ رَبَّهُ كَانَ بِهِ بَصِيرًا","numberInSurah":15,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5900,"text":"فَلَا أُقْسِمُ بِالشَّفَقِ","numberInSurah":16,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5901,"text":"وَاللَّيْلِ وَمَا وَسَقَ","numberInSurah":17,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5902,"text":"وَالْقَمَرِ إِذَا اتَّسَقَ","numberInSurah":18,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5903,"text":"لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍ","numberInSurah":19,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5904,"text":"فَمَا لَهُمْ لَا يُؤْمِنُونَ","numberInSurah":20,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5905,"text":"وَإِذَا قُرِئَ عَلَيْهِمُ الْقُرْآنُ لَا يَسْجُدُونَ ۩","numberInSurah":21,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":{"id":14,"recommended":true,"obligatory":false}},{"number":5906,"text":"بَلِ الَّذِينَ كَفَرُوا يُكَذِّبُونَ","numberInSurah":22,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5907,"text":"وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَ","numberInSurah":23,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5908,"text":"فَبَشِّرْهُمْ بِعَذَابٍ أَلِيمٍ","numberInSurah":24,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5909,"text":"إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ","numberInSurah":25,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":84,"name":"سُورَةُ الانشِقَاقِ","englishName":"İnşikâk","englishNameTranslation":"The Splitting Open","revelationType":"Meccan","numberOfAyahs":25,"ayahs":[{"number":5885,"text":"Gök yarılıp Rabbine boyun eğdiği zaman, ki gök boyun eğecektir.","numberInSurah":1,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5886,"text":"Gök yarılıp Rabbine boyun eğdiği zaman, ki gök boyun eğecektir.","numberInSurah":2,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5887,"text":"Yer düzeltilip, içinde olanları dışarı atarak boşaldığı zaman ve yer Rabbine boyun eğdiği zaman, ki yer boyun eğecektir","numberInSurah":3,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5888,"text":"Yer düzeltilip, içinde olanları dışarı atarak boşaldığı zaman ve yer Rabbine boyun eğdiği zaman, ki yer boyun eğecektir","numberInSurah":4,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5889,"text":"Yer düzeltilip, içinde olanları dışarı atarak boşaldığı zaman ve yer Rabbine boyun eğdiği zaman, ki yer boyun eğecektir","numberInSurah":5,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5890,"text":"Ey insanoğlu! Sen Rabbine kavuşuncaya kadar çalışıp çabalarsın, sonunda O'na kavuşacaksın.","numberInSurah":6,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5891,"text":"Amel defteri kendisine sağından verilen kimse, kolay geçireceği bir hesaba çekilir ve arkadaşlarının yanına sevinçle döner.","numberInSurah":7,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5892,"text":"Amel defteri kendisine sağından verilen kimse, kolay geçireceği bir hesaba çekilir ve arkadaşlarının yanına sevinçle döner.","numberInSurah":8,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5893,"text":"Amel defteri kendisine sağından verilen kimse, kolay geçireceği bir hesaba çekilir ve arkadaşlarının yanına sevinçle döner.","numberInSurah":9,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5894,"text":"Ama amel defteri kendisine arkasından verilen kimse: \"Mahvoldum\" diye bağırır ve çılgın alevli cehenneme girer.","numberInSurah":10,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5895,"text":"Ama amel defteri kendisine arkasından verilen kimse: \"Mahvoldum\" diye bağırır ve çılgın alevli cehenneme girer.","numberInSurah":11,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5896,"text":"Ama amel defteri kendisine arkasından verilen kimse: \"Mahvoldum\" diye bağırır ve çılgın alevli cehenneme girer.","numberInSurah":12,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5897,"text":"Çünkü o, dünyada, adamlarının yanında iken zevk içindeydi.","numberInSurah":13,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5898,"text":"Zira; o, bir daha dirilip dönmeyeceğini sanmıştı.","numberInSurah":14,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5899,"text":"Bilin ki, Rabbi onu şüphesiz görmekteydi.","numberInSurah":15,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5900,"text":"Akşamın alaca karanlığına and olsun;","numberInSurah":16,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5901,"text":"Geceye ve gecenin içinde olan şeylere and olsun;","numberInSurah":17,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5902,"text":"Dolunay halindeki aya and olsun ki:","numberInSurah":18,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5903,"text":"Şüphesiz siz bir durumdan diğerine uğratılacaksınız. (tabakadan tabakaya bineceksiniz)","numberInSurah":19,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5904,"text":"Onlara ne oluyor da inanmıyorlar?","numberInSurah":20,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5905,"text":"Onlara Kuran okunduğu zaman neden secde etmiyorlar?","numberInSurah":21,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":{"id":14,"recommended":true,"obligatory":false}},{"number":5906,"text":"Aksine, inkarcılar yalanlıyorlar.","numberInSurah":22,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5907,"text":"Oysa, Allah, onların sakladıklarını çok iyi bilir.","numberInSurah":23,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5908,"text":"Onlara can yakıcı azabı müjde et.","numberInSurah":24,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false},{"number":5909,"text":"Yalnız, inanıp yararlı işler işleyenlere, onlara, kesintisiz ecir vardır.","numberInSurah":25,"juz":30,"manzil":7,"page":589,"ruku":526,"hizbQuarter":236,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}