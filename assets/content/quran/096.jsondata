{"arabic":{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Alak","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ اقْرَأْ بِاسْمِ رَبِّكَ الَّذِي خَلَقَ","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6108,"text":"خَلَقَ الْإِنْسَانَ مِنْ عَلَقٍ","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6109,"text":"اقْرَأْ وَرَبُّكَ الْأَكْرَمُ","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6110,"text":"الَّذِي عَلَّمَ بِالْقَلَمِ","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6111,"text":"عَلَّمَ الْإِنْسَانَ مَا لَمْ يَعْلَمْ","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6112,"text":"كَلَّا إِنَّ الْإِنْسَانَ لَيَطْغَىٰ","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6113,"text":"أَنْ رَآهُ اسْتَغْنَىٰ","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6114,"text":"إِنَّ إِلَىٰ رَبِّكَ الرُّجْعَىٰ","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6115,"text":"أَرَأَيْتَ الَّذِي يَنْهَىٰ","numberInSurah":9,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6116,"text":"عَبْدًا إِذَا صَلَّىٰ","numberInSurah":10,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6117,"text":"أَرَأَيْتَ إِنْ كَانَ عَلَى الْهُدَىٰ","numberInSurah":11,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6118,"text":"أَوْ أَمَرَ بِالتَّقْوَىٰ","numberInSurah":12,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6119,"text":"أَرَأَيْتَ إِنْ كَذَّبَ وَتَوَلَّىٰ","numberInSurah":13,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6120,"text":"أَلَمْ يَعْلَمْ بِأَنَّ اللَّهَ يَرَىٰ","numberInSurah":14,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6121,"text":"كَلَّا لَئِنْ لَمْ يَنْتَهِ لَنَسْفَعًا بِالنَّاصِيَةِ","numberInSurah":15,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6122,"text":"نَاصِيَةٍ كَاذِبَةٍ خَاطِئَةٍ","numberInSurah":16,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6123,"text":"فَلْيَدْعُ نَادِيَهُ","numberInSurah":17,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6124,"text":"سَنَدْعُ الزَّبَانِيَةَ","numberInSurah":18,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6125,"text":"كَلَّا لَا تُطِعْهُ وَاسْجُدْ وَاقْتَرِبْ ۩","numberInSurah":19,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":{"id":15,"recommended":false,"obligatory":true}}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":96,"name":"سُورَةُ العَلَقِ","englishName":"Alak","englishNameTranslation":"The Clot","revelationType":"Meccan","numberOfAyahs":19,"ayahs":[{"number":6107,"text":"Yaratan Rabbinin adıyla oku!","numberInSurah":1,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6108,"text":"O, insanı pıhtılaşmış kandan (alak'tan) yarattı.","numberInSurah":2,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6109,"text":"Oku! Kalemle öğreten, insana bilmediğini bildiren Rabbin, en büyük kerem sahibidir.","numberInSurah":3,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6110,"text":"Oku! Kalemle öğreten, insana bilmediğini bildiren Rabbin, en büyük kerem sahibidir.","numberInSurah":4,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6111,"text":"Oku! Kalemle öğreten, insana bilmediğini bildiren Rabbin, en büyük kerem sahibidir.","numberInSurah":5,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6112,"text":"Ama, insanoğlu kendini müstağni sayarak azgınlık eder.","numberInSurah":6,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6113,"text":"Ama, insanoğlu kendini müstağni sayarak azgınlık eder.","numberInSurah":7,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6114,"text":"Dönüş şüphesiz Rabbinedir.","numberInSurah":8,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6115,"text":"Sen, namaz kılan kulu bundan menedeni gördün mü?","numberInSurah":9,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6116,"text":"Sen, namaz kılan kulu bundan menedeni gördün mü?","numberInSurah":10,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6117,"text":"Söyle bakalım, o kul doğru yolda giden veya Allah'a karşı gelmekten sakınmayı buyuran bir kimse olsun; veya söyle, yalanlayıp yüz çeviren birisi olsun","numberInSurah":11,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6118,"text":"Söyle bakalım, o kul doğru yolda giden veya Allah'a karşı gelmekten sakınmayı buyuran bir kimse olsun; veya söyle, yalanlayıp yüz çeviren birisi olsun","numberInSurah":12,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6119,"text":"Söyle bakalım, o kul doğru yolda giden veya Allah'a karşı gelmekten sakınmayı buyuran bir kimse olsun; veya söyle, yalanlayıp yüz çeviren birisi olsun","numberInSurah":13,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6120,"text":"Allah'ın her şeyi görmekte olduğunu bilmez mi?","numberInSurah":14,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6121,"text":"Ama bundan vazgeçmezse, and olsun ki, onu perçeminden,","numberInSurah":15,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6122,"text":"Yalancı ve günahkar perçeminden cehenneme sürükleriz.","numberInSurah":16,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6123,"text":"O zaman, kafadarlarını çağırsın,","numberInSurah":17,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6124,"text":"Biz de zebanileri çağıracağız.","numberInSurah":18,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":false},{"number":6125,"text":"Sakın ona uyma; sen secde et, Rabbine yaklaş.","numberInSurah":19,"juz":30,"manzil":7,"page":597,"ruku":538,"hizbQuarter":239,"sajda":{"id":15,"recommended":false,"obligatory":true}}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}