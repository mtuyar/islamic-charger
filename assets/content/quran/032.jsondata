{"arabic":{"number":32,"name":"سُورَةُ السَّجۡدَةِ","englishName":"Secde","englishNameTranslation":"The Prostration","revelationType":"Meccan","numberOfAyahs":30,"ayahs":[{"number":3504,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الم","numberInSurah":1,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3505,"text":"تَنْزِيلُ الْكِتَابِ لَا رَيْبَ فِيهِ مِنْ رَبِّ الْعَالَمِينَ","numberInSurah":2,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3506,"text":"أَمْ يَقُولُونَ افْتَرَاهُ ۚ بَلْ هُوَ الْحَقُّ مِنْ رَبِّكَ لِتُنْذِرَ قَوْمًا مَا أَتَاهُمْ مِنْ نَذِيرٍ مِنْ قَبْلِكَ لَعَلَّهُمْ يَهْتَدُونَ","numberInSurah":3,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3507,"text":"اللَّهُ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَىٰ عَلَى الْعَرْشِ ۖ مَا لَكُمْ مِنْ دُونِهِ مِنْ وَلِيٍّ وَلَا شَفِيعٍ ۚ أَفَلَا تَتَذَكَّرُونَ","numberInSurah":4,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3508,"text":"يُدَبِّرُ الْأَمْرَ مِنَ السَّمَاءِ إِلَى الْأَرْضِ ثُمَّ يَعْرُجُ إِلَيْهِ فِي يَوْمٍ كَانَ مِقْدَارُهُ أَلْفَ سَنَةٍ مِمَّا تَعُدُّونَ","numberInSurah":5,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3509,"text":"ذَٰلِكَ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ الْعَزِيزُ الرَّحِيمُ","numberInSurah":6,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3510,"text":"الَّذِي أَحْسَنَ كُلَّ شَيْءٍ خَلَقَهُ ۖ وَبَدَأَ خَلْقَ الْإِنْسَانِ مِنْ طِينٍ","numberInSurah":7,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3511,"text":"ثُمَّ جَعَلَ نَسْلَهُ مِنْ سُلَالَةٍ مِنْ مَاءٍ مَهِينٍ","numberInSurah":8,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3512,"text":"ثُمَّ سَوَّاهُ وَنَفَخَ فِيهِ مِنْ رُوحِهِ ۖ وَجَعَلَ لَكُمُ السَّمْعَ وَالْأَبْصَارَ وَالْأَفْئِدَةَ ۚ قَلِيلًا مَا تَشْكُرُونَ","numberInSurah":9,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3513,"text":"وَقَالُوا أَإِذَا ضَلَلْنَا فِي الْأَرْضِ أَإِنَّا لَفِي خَلْقٍ جَدِيدٍ ۚ بَلْ هُمْ بِلِقَاءِ رَبِّهِمْ كَافِرُونَ","numberInSurah":10,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3514,"text":"۞ قُلْ يَتَوَفَّاكُمْ مَلَكُ الْمَوْتِ الَّذِي وُكِّلَ بِكُمْ ثُمَّ إِلَىٰ رَبِّكُمْ تُرْجَعُونَ","numberInSurah":11,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":166,"sajda":false},{"number":3515,"text":"وَلَوْ تَرَىٰ إِذِ الْمُجْرِمُونَ نَاكِسُو رُءُوسِهِمْ عِنْدَ رَبِّهِمْ رَبَّنَا أَبْصَرْنَا وَسَمِعْنَا فَارْجِعْنَا نَعْمَلْ صَالِحًا إِنَّا مُوقِنُونَ","numberInSurah":12,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3516,"text":"وَلَوْ شِئْنَا لَآتَيْنَا كُلَّ نَفْسٍ هُدَاهَا وَلَٰكِنْ حَقَّ الْقَوْلُ مِنِّي لَأَمْلَأَنَّ جَهَنَّمَ مِنَ الْجِنَّةِ وَالنَّاسِ أَجْمَعِينَ","numberInSurah":13,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3517,"text":"فَذُوقُوا بِمَا نَسِيتُمْ لِقَاءَ يَوْمِكُمْ هَٰذَا إِنَّا نَسِينَاكُمْ ۖ وَذُوقُوا عَذَابَ الْخُلْدِ بِمَا كُنْتُمْ تَعْمَلُونَ","numberInSurah":14,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3518,"text":"إِنَّمَا يُؤْمِنُ بِآيَاتِنَا الَّذِينَ إِذَا ذُكِّرُوا بِهَا خَرُّوا سُجَّدًا وَسَبَّحُوا بِحَمْدِ رَبِّهِمْ وَهُمْ لَا يَسْتَكْبِرُونَ ۩","numberInSurah":15,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":{"id":10,"recommended":false,"obligatory":true}},{"number":3519,"text":"تَتَجَافَىٰ جُنُوبُهُمْ عَنِ الْمَضَاجِعِ يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ","numberInSurah":16,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3520,"text":"فَلَا تَعْلَمُ نَفْسٌ مَا أُخْفِيَ لَهُمْ مِنْ قُرَّةِ أَعْيُنٍ جَزَاءً بِمَا كَانُوا يَعْمَلُونَ","numberInSurah":17,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3521,"text":"أَفَمَنْ كَانَ مُؤْمِنًا كَمَنْ كَانَ فَاسِقًا ۚ لَا يَسْتَوُونَ","numberInSurah":18,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3522,"text":"أَمَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَلَهُمْ جَنَّاتُ الْمَأْوَىٰ نُزُلًا بِمَا كَانُوا يَعْمَلُونَ","numberInSurah":19,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3523,"text":"وَأَمَّا الَّذِينَ فَسَقُوا فَمَأْوَاهُمُ النَّارُ ۖ كُلَّمَا أَرَادُوا أَنْ يَخْرُجُوا مِنْهَا أُعِيدُوا فِيهَا وَقِيلَ لَهُمْ ذُوقُوا عَذَابَ النَّارِ الَّذِي كُنْتُمْ بِهِ تُكَذِّبُونَ","numberInSurah":20,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3524,"text":"وَلَنُذِيقَنَّهُمْ مِنَ الْعَذَابِ الْأَدْنَىٰ دُونَ الْعَذَابِ الْأَكْبَرِ لَعَلَّهُمْ يَرْجِعُونَ","numberInSurah":21,"juz":21,"manzil":5,"page":417,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3525,"text":"وَمَنْ أَظْلَمُ مِمَّنْ ذُكِّرَ بِآيَاتِ رَبِّهِ ثُمَّ أَعْرَضَ عَنْهَا ۚ إِنَّا مِنَ الْمُجْرِمِينَ مُنْتَقِمُونَ","numberInSurah":22,"juz":21,"manzil":5,"page":417,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3526,"text":"وَلَقَدْ آتَيْنَا مُوسَى الْكِتَابَ فَلَا تَكُنْ فِي مِرْيَةٍ مِنْ لِقَائِهِ ۖ وَجَعَلْنَاهُ هُدًى لِبَنِي إِسْرَائِيلَ","numberInSurah":23,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3527,"text":"وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُوا ۖ وَكَانُوا بِآيَاتِنَا يُوقِنُونَ","numberInSurah":24,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3528,"text":"إِنَّ رَبَّكَ هُوَ يَفْصِلُ بَيْنَهُمْ يَوْمَ الْقِيَامَةِ فِيمَا كَانُوا فِيهِ يَخْتَلِفُونَ","numberInSurah":25,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3529,"text":"أَوَلَمْ يَهْدِ لَهُمْ كَمْ أَهْلَكْنَا مِنْ قَبْلِهِمْ مِنَ الْقُرُونِ يَمْشُونَ فِي مَسَاكِنِهِمْ ۚ إِنَّ فِي ذَٰلِكَ لَآيَاتٍ ۖ أَفَلَا يَسْمَعُونَ","numberInSurah":26,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3530,"text":"أَوَلَمْ يَرَوْا أَنَّا نَسُوقُ الْمَاءَ إِلَى الْأَرْضِ الْجُرُزِ فَنُخْرِجُ بِهِ زَرْعًا تَأْكُلُ مِنْهُ أَنْعَامُهُمْ وَأَنْفُسُهُمْ ۖ أَفَلَا يُبْصِرُونَ","numberInSurah":27,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3531,"text":"وَيَقُولُونَ مَتَىٰ هَٰذَا الْفَتْحُ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":28,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3532,"text":"قُلْ يَوْمَ الْفَتْحِ لَا يَنْفَعُ الَّذِينَ كَفَرُوا إِيمَانُهُمْ وَلَا هُمْ يُنْظَرُونَ","numberInSurah":29,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3533,"text":"فَأَعْرِضْ عَنْهُمْ وَانْتَظِرْ إِنَّهُمْ مُنْتَظِرُونَ","numberInSurah":30,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":32,"name":"سُورَةُ السَّجۡدَةِ","englishName":"Secde","englishNameTranslation":"The Prostration","revelationType":"Meccan","numberOfAyahs":30,"ayahs":[{"number":3504,"text":"Elif, Lam, Mim.","numberInSurah":1,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3505,"text":"Şüphe götürmeyen Kitap, Alemlerin Rabbi'nin indirdiğidir.","numberInSurah":2,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3506,"text":"\"Onu peygamberin kendisi uydurdu\" diyorlar, öyle mi? Hayır; O, senden önce peygamber gönderilmemiş olan bir milleti uyarman için sana Rabbinden gelen bir gerçektir. Belki artık doğru yolu bulurlar.","numberInSurah":3,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3507,"text":"Gökleri, yeri ve ikisinin arasında bulunanları altı günde yaratan, sonra arşa hükmeden Allah'tır. O'ndan başka bir dostunuz ve şefaatçiniz yoktur. Düşünmüyor musunuz?","numberInSurah":4,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3508,"text":"Gökten yere kadar, olan bütün işleri Allah düzenler, sonra, işler sizin hesabınıza göre bin yıl kadar tutan bir gün içinde O'na yükselir.","numberInSurah":5,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3509,"text":"O, görülmeyeni de görüleni de bilendir, güçlüdür, merhametlidir.","numberInSurah":6,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3510,"text":"Yarattığı her şeyi güzel yaratan, insanı başlangıçta çamurdan yaratan, sonra onun soyunu, bayağı bir suyun özünden yapan, sonra onu şekillendirip ruhundan ona üfleyen Allah'tır. Size kulaklar, gözler, kalbler verilmiştir. Öyleyken, pek az şükrediyorsunuz.","numberInSurah":7,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3511,"text":"Yarattığı her şeyi güzel yaratan, insanı başlangıçta çamurdan yaratan, sonra onun soyunu, bayağı bir suyun özünden yapan, sonra onu şekillendirip ruhundan ona üfleyen Allah'tır. Size kulaklar, gözler, kalbler verilmiştir. Öyleyken, pek az şükrediyorsunuz.","numberInSurah":8,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3512,"text":"Yarattığı her şeyi güzel yaratan, insanı başlangıçta çamurdan yaratan, sonra onun soyunu, bayağı bir suyun özünden yapan, sonra onu şekillendirip ruhundan ona üfleyen Allah'tır. Size kulaklar, gözler, kalbler verilmiştir. Öyleyken, pek az şükrediyorsunuz.","numberInSurah":9,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3513,"text":"Puta tapanlar: \"Toprağa karışıp yok olduktan sonra yeniden mi yaratılacağız?\" derler. Evet; onlar, Rab'lerine kavuşmayı inkar edenlerdir.","numberInSurah":10,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":165,"sajda":false},{"number":3514,"text":"De ki: \"Size vekil kılınan ölüm meleği canınızı alacak, sonra Rabbinize döndürüleceksiniz.\"","numberInSurah":11,"juz":21,"manzil":5,"page":415,"ruku":358,"hizbQuarter":166,"sajda":false},{"number":3515,"text":"Suçluları Rablerinin huzurunda, başları öne eğilmiş olarak: \"Rabbimiz! Gördük, dinledik, artık bizi dünyaya geri çevir de iyi iş işleyelim; doğrusu kesin olarak inandık\" derlerken bir görsen!","numberInSurah":12,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3516,"text":"Biz dilesek herkese hidayet verirdik, fakat cehennemi tamamen cin ve insanlarla dolduracağıma dair Benden söz çıkmıştır.","numberInSurah":13,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3517,"text":"\"Bugüne kavuşmayı unutmanızın karşılığını görün; doğrusu Biz de sizi unuttuk, yaptıklarınıza karşılık ebedi azabı tadın\" deriz.","numberInSurah":14,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3518,"text":"Ayetlerimize ancak, kendilerine hatırlatıldığı zaman secdeye kapananlar, büyüklük taslamayarak Rablerini överek yüceltenler, vücudlarını yataklardan uzak tutup korkarak ve umarak Rablerine yalvaranlar ve verdiğimiz rızıklardan sarfedenler inanır.","numberInSurah":15,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":{"id":10,"recommended":false,"obligatory":true}},{"number":3519,"text":"Ayetlerimize ancak, kendilerine hatırlatıldığı zaman secdeye kapananlar, büyüklük taslamayarak Rablerini överek yüceltenler, vücudlarını yataklardan uzak tutup korkarak ve umarak Rablerine yalvaranlar ve verdiğimiz rızıklardan sarfedenler inanır.","numberInSurah":16,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3520,"text":"Yaptıklarına karşılık onlar için saklanan müjdeyi kimse bilmez.","numberInSurah":17,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3521,"text":"İnanan kimse yoldan çıkmış kimseye benzer mi? Bunlar bir olamazlar.","numberInSurah":18,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3522,"text":"İnanıp yararlı iş işleyenlere gelince, onların yaptıklarına karşılık, varacakları cennet konakları vardır.","numberInSurah":19,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3523,"text":"Ama yoldan çıkanların, işte onların varacağı yer ateştir. Oradan çıkmak isteyişlerinin her defasında geri çevrilirler ve onlara: \"Yalanlayıp, durduğunuz ateşin azabını tadın\" denir.","numberInSurah":20,"juz":21,"manzil":5,"page":416,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3524,"text":"Belki yollarından dönerler diye and olsun onlara büyük azabdan önce dünya azabından tattırırız.","numberInSurah":21,"juz":21,"manzil":5,"page":417,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3525,"text":"Rabbinin ayetleri kendisine hatırlatılıp da onlardan yüz çeviren kimseden daha zalim var mıdır? Şüphesiz suçlulardan öç alacağız.","numberInSurah":22,"juz":21,"manzil":5,"page":417,"ruku":359,"hizbQuarter":166,"sajda":false},{"number":3526,"text":"And olsun ki Musa'ya Kitap verdik; Sakın sen ona kavuşacağından şüphe etme. Musa'ya verdiğimizi İsrailoğullarına doğruluk rehberi kıldık.","numberInSurah":23,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3527,"text":"Sabredip ayetlerimize kesin olarak inanmalarından ötürü, aralarından, onları buyruğumuzla doğru yola götüren önderler yaptık.","numberInSurah":24,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3528,"text":"Muhakkak ki Rabbin ayrılığa düştükleri şeylerde kıyamet günü aralarında hükmedecektir.","numberInSurah":25,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3529,"text":"Şimdi yurtlarında gezip dolaştıkları, kendilerinden önceki nice nesilleri yok etmiş olmamız onları doğru yola sevketmez mi? Bunlarda şüphesiz ibretler vardır. Dinlemezler mi?","numberInSurah":26,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3530,"text":"Kuru yerlere suyu gönderip onunla hayvanlarının ve kendilerinin yedikleri ekinleri çıkardığımızı görmezler mi? Görmüyorlar mı?","numberInSurah":27,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3531,"text":"\"Doğru söylüyorsanız bildirin bu hüküm ne zaman verilecektir?\" derler.","numberInSurah":28,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3532,"text":"De ki: \"Hükmün verileceği gün inkarcılara ne inanmaları fayda verir ve ne de ertelenirler.\"","numberInSurah":29,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false},{"number":3533,"text":"Onları bırak, bekle; zaten onlar da senin akıbetini beklemektedirler.","numberInSurah":30,"juz":21,"manzil":5,"page":417,"ruku":360,"hizbQuarter":166,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}