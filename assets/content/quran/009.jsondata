{"arabic":{"number":9,"name":"سُورَةُ التَّوۡبَةِ","englishName":"Tevbe","englishNameTranslation":"The Repentance","revelationType":"Medinan","numberOfAyahs":129,"ayahs":[{"number":1236,"text":"بَرَاءَةٌ مِنَ اللَّهِ وَرَسُولِهِ إِلَى الَّذِينَ عَاهَدْتُمْ مِنَ الْمُشْرِكِينَ","numberInSurah":1,"juz":10,"manzil":2,"page":187,"ruku":156,"hizbQuarter":75,"sajda":false},{"number":1237,"text":"فَسِيحُوا فِي الْأَرْضِ أَرْبَعَةَ أَشْهُرٍ وَاعْلَمُوا أَنَّكُمْ غَيْرُ مُعْجِزِي اللَّهِ ۙ وَأَنَّ اللَّهَ مُخْزِي الْكَافِرِينَ","numberInSurah":2,"juz":10,"manzil":2,"page":187,"ruku":156,"hizbQuarter":75,"sajda":false},{"number":1238,"text":"وَأَذَانٌ مِنَ اللَّهِ وَرَسُولِهِ إِلَى النَّاسِ يَوْمَ الْحَجِّ الْأَكْبَرِ أَنَّ اللَّهَ بَرِيءٌ مِنَ الْمُشْرِكِينَ ۙ وَرَسُولُهُ ۚ فَإِنْ تُبْتُمْ فَهُوَ خَيْرٌ لَكُمْ ۖ وَإِنْ تَوَلَّيْتُمْ فَاعْلَمُوا أَنَّكُمْ غَيْرُ مُعْجِزِي اللَّهِ ۗ وَبَشِّرِ الَّذِينَ كَفَرُوا بِعَذَابٍ أَلِيمٍ","numberInSurah":3,"juz":10,"manzil":2,"page":187,"ruku":156,"hizbQuarter":75,"sajda":false},{"number":1239,"text":"إِلَّا الَّذِينَ عَاهَدْتُمْ مِنَ الْمُشْرِكِينَ ثُمَّ لَمْ يَنْقُصُوكُمْ شَيْئًا وَلَمْ يُظَاهِرُوا عَلَيْكُمْ أَحَدًا فَأَتِمُّوا إِلَيْهِمْ عَهْدَهُمْ إِلَىٰ مُدَّتِهِمْ ۚ إِنَّ اللَّهَ يُحِبُّ الْمُتَّقِينَ","numberInSurah":4,"juz":10,"manzil":2,"page":187,"ruku":156,"hizbQuarter":75,"sajda":false},{"number":1240,"text":"فَإِذَا انْسَلَخَ الْأَشْهُرُ الْحُرُمُ فَاقْتُلُوا الْمُشْرِكِينَ حَيْثُ وَجَدْتُمُوهُمْ وَخُذُوهُمْ وَاحْصُرُوهُمْ وَاقْعُدُوا لَهُمْ كُلَّ مَرْصَدٍ ۚ فَإِنْ تَابُوا وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ فَخَلُّوا سَبِيلَهُمْ ۚ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","numberInSurah":5,"juz":10,"manzil":2,"page":187,"ruku":156,"hizbQuarter":75,"sajda":false},{"number":1241,"text":"وَإِنْ أَحَدٌ مِنَ الْمُشْرِكِينَ اسْتَجَارَكَ فَأَجِرْهُ حَتَّىٰ يَسْمَعَ كَلَامَ اللَّهِ ثُمَّ أَبْلِغْهُ مَأْمَنَهُ ۚ ذَٰلِكَ بِأَنَّهُمْ قَوْمٌ لَا يَعْلَمُونَ","numberInSurah":6,"juz":10,"manzil":2,"page":187,"ruku":156,"hizbQuarter":75,"sajda":false},{"number":1242,"text":"كَيْفَ يَكُونُ لِلْمُشْرِكِينَ عَهْدٌ عِنْدَ اللَّهِ وَعِنْدَ رَسُولِهِ إِلَّا الَّذِينَ عَاهَدْتُمْ عِنْدَ الْمَسْجِدِ الْحَرَامِ ۖ فَمَا اسْتَقَامُوا لَكُمْ فَاسْتَقِيمُوا لَهُمْ ۚ إِنَّ اللَّهَ يُحِبُّ الْمُتَّقِينَ","numberInSurah":7,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1243,"text":"كَيْفَ وَإِنْ يَظْهَرُوا عَلَيْكُمْ لَا يَرْقُبُوا فِيكُمْ إِلًّا وَلَا ذِمَّةً ۚ يُرْضُونَكُمْ بِأَفْوَاهِهِمْ وَتَأْبَىٰ قُلُوبُهُمْ وَأَكْثَرُهُمْ فَاسِقُونَ","numberInSurah":8,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1244,"text":"اشْتَرَوْا بِآيَاتِ اللَّهِ ثَمَنًا قَلِيلًا فَصَدُّوا عَنْ سَبِيلِهِ ۚ إِنَّهُمْ سَاءَ مَا كَانُوا يَعْمَلُونَ","numberInSurah":9,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1245,"text":"لَا يَرْقُبُونَ فِي مُؤْمِنٍ إِلًّا وَلَا ذِمَّةً ۚ وَأُولَٰئِكَ هُمُ الْمُعْتَدُونَ","numberInSurah":10,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1246,"text":"فَإِنْ تَابُوا وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ فَإِخْوَانُكُمْ فِي الدِّينِ ۗ وَنُفَصِّلُ الْآيَاتِ لِقَوْمٍ يَعْلَمُونَ","numberInSurah":11,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1247,"text":"وَإِنْ نَكَثُوا أَيْمَانَهُمْ مِنْ بَعْدِ عَهْدِهِمْ وَطَعَنُوا فِي دِينِكُمْ فَقَاتِلُوا أَئِمَّةَ الْكُفْرِ ۙ إِنَّهُمْ لَا أَيْمَانَ لَهُمْ لَعَلَّهُمْ يَنْتَهُونَ","numberInSurah":12,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1248,"text":"أَلَا تُقَاتِلُونَ قَوْمًا نَكَثُوا أَيْمَانَهُمْ وَهَمُّوا بِإِخْرَاجِ الرَّسُولِ وَهُمْ بَدَءُوكُمْ أَوَّلَ مَرَّةٍ ۚ أَتَخْشَوْنَهُمْ ۚ فَاللَّهُ أَحَقُّ أَنْ تَخْشَوْهُ إِنْ كُنْتُمْ مُؤْمِنِينَ","numberInSurah":13,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1249,"text":"قَاتِلُوهُمْ يُعَذِّبْهُمُ اللَّهُ بِأَيْدِيكُمْ وَيُخْزِهِمْ وَيَنْصُرْكُمْ عَلَيْهِمْ وَيَشْفِ صُدُورَ قَوْمٍ مُؤْمِنِينَ","numberInSurah":14,"juz":10,"manzil":2,"page":189,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1250,"text":"وَيُذْهِبْ غَيْظَ قُلُوبِهِمْ ۗ وَيَتُوبُ اللَّهُ عَلَىٰ مَنْ يَشَاءُ ۗ وَاللَّهُ عَلِيمٌ حَكِيمٌ","numberInSurah":15,"juz":10,"manzil":2,"page":189,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1251,"text":"أَمْ حَسِبْتُمْ أَنْ تُتْرَكُوا وَلَمَّا يَعْلَمِ اللَّهُ الَّذِينَ جَاهَدُوا مِنْكُمْ وَلَمْ يَتَّخِذُوا مِنْ دُونِ اللَّهِ وَلَا رَسُولِهِ وَلَا الْمُؤْمِنِينَ وَلِيجَةً ۚ وَاللَّهُ خَبِيرٌ بِمَا تَعْمَلُونَ","numberInSurah":16,"juz":10,"manzil":2,"page":189,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1252,"text":"مَا كَانَ لِلْمُشْرِكِينَ أَنْ يَعْمُرُوا مَسَاجِدَ اللَّهِ شَاهِدِينَ عَلَىٰ أَنْفُسِهِمْ بِالْكُفْرِ ۚ أُولَٰئِكَ حَبِطَتْ أَعْمَالُهُمْ وَفِي النَّارِ هُمْ خَالِدُونَ","numberInSurah":17,"juz":10,"manzil":2,"page":189,"ruku":158,"hizbQuarter":75,"sajda":false},{"number":1253,"text":"إِنَّمَا يَعْمُرُ مَسَاجِدَ اللَّهِ مَنْ آمَنَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَأَقَامَ الصَّلَاةَ وَآتَى الزَّكَاةَ وَلَمْ يَخْشَ إِلَّا اللَّهَ ۖ فَعَسَىٰ أُولَٰئِكَ أَنْ يَكُونُوا مِنَ الْمُهْتَدِينَ","numberInSurah":18,"juz":10,"manzil":2,"page":189,"ruku":158,"hizbQuarter":75,"sajda":false},{"number":1254,"text":"۞ أَجَعَلْتُمْ سِقَايَةَ الْحَاجِّ وَعِمَارَةَ الْمَسْجِدِ الْحَرَامِ كَمَنْ آمَنَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَجَاهَدَ فِي سَبِيلِ اللَّهِ ۚ لَا يَسْتَوُونَ عِنْدَ اللَّهِ ۗ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ","numberInSurah":19,"juz":10,"manzil":2,"page":189,"ruku":158,"hizbQuarter":76,"sajda":false},{"number":1255,"text":"الَّذِينَ آمَنُوا وَهَاجَرُوا وَجَاهَدُوا فِي سَبِيلِ اللَّهِ بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ أَعْظَمُ دَرَجَةً عِنْدَ اللَّهِ ۚ وَأُولَٰئِكَ هُمُ الْفَائِزُونَ","numberInSurah":20,"juz":10,"manzil":2,"page":189,"ruku":158,"hizbQuarter":76,"sajda":false},{"number":1256,"text":"يُبَشِّرُهُمْ رَبُّهُمْ بِرَحْمَةٍ مِنْهُ وَرِضْوَانٍ وَجَنَّاتٍ لَهُمْ فِيهَا نَعِيمٌ مُقِيمٌ","numberInSurah":21,"juz":10,"manzil":2,"page":190,"ruku":158,"hizbQuarter":76,"sajda":false},{"number":1257,"text":"خَالِدِينَ فِيهَا أَبَدًا ۚ إِنَّ اللَّهَ عِنْدَهُ أَجْرٌ عَظِيمٌ","numberInSurah":22,"juz":10,"manzil":2,"page":190,"ruku":158,"hizbQuarter":76,"sajda":false},{"number":1258,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَتَّخِذُوا آبَاءَكُمْ وَإِخْوَانَكُمْ أَوْلِيَاءَ إِنِ اسْتَحَبُّوا الْكُفْرَ عَلَى الْإِيمَانِ ۚ وَمَنْ يَتَوَلَّهُمْ مِنْكُمْ فَأُولَٰئِكَ هُمُ الظَّالِمُونَ","numberInSurah":23,"juz":10,"manzil":2,"page":190,"ruku":158,"hizbQuarter":76,"sajda":false},{"number":1259,"text":"قُلْ إِنْ كَانَ آبَاؤُكُمْ وَأَبْنَاؤُكُمْ وَإِخْوَانُكُمْ وَأَزْوَاجُكُمْ وَعَشِيرَتُكُمْ وَأَمْوَالٌ اقْتَرَفْتُمُوهَا وَتِجَارَةٌ تَخْشَوْنَ كَسَادَهَا وَمَسَاكِنُ تَرْضَوْنَهَا أَحَبَّ إِلَيْكُمْ مِنَ اللَّهِ وَرَسُولِهِ وَجِهَادٍ فِي سَبِيلِهِ فَتَرَبَّصُوا حَتَّىٰ يَأْتِيَ اللَّهُ بِأَمْرِهِ ۗ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْفَاسِقِينَ","numberInSurah":24,"juz":10,"manzil":2,"page":190,"ruku":158,"hizbQuarter":76,"sajda":false},{"number":1260,"text":"لَقَدْ نَصَرَكُمُ اللَّهُ فِي مَوَاطِنَ كَثِيرَةٍ ۙ وَيَوْمَ حُنَيْنٍ ۙ إِذْ أَعْجَبَتْكُمْ كَثْرَتُكُمْ فَلَمْ تُغْنِ عَنْكُمْ شَيْئًا وَضَاقَتْ عَلَيْكُمُ الْأَرْضُ بِمَا رَحُبَتْ ثُمَّ وَلَّيْتُمْ مُدْبِرِينَ","numberInSurah":25,"juz":10,"manzil":2,"page":190,"ruku":159,"hizbQuarter":76,"sajda":false},{"number":1261,"text":"ثُمَّ أَنْزَلَ اللَّهُ سَكِينَتَهُ عَلَىٰ رَسُولِهِ وَعَلَى الْمُؤْمِنِينَ وَأَنْزَلَ جُنُودًا لَمْ تَرَوْهَا وَعَذَّبَ الَّذِينَ كَفَرُوا ۚ وَذَٰلِكَ جَزَاءُ الْكَافِرِينَ","numberInSurah":26,"juz":10,"manzil":2,"page":190,"ruku":159,"hizbQuarter":76,"sajda":false},{"number":1262,"text":"ثُمَّ يَتُوبُ اللَّهُ مِنْ بَعْدِ ذَٰلِكَ عَلَىٰ مَنْ يَشَاءُ ۗ وَاللَّهُ غَفُورٌ رَحِيمٌ","numberInSurah":27,"juz":10,"manzil":2,"page":191,"ruku":159,"hizbQuarter":76,"sajda":false},{"number":1263,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّمَا الْمُشْرِكُونَ نَجَسٌ فَلَا يَقْرَبُوا الْمَسْجِدَ الْحَرَامَ بَعْدَ عَامِهِمْ هَٰذَا ۚ وَإِنْ خِفْتُمْ عَيْلَةً فَسَوْفَ يُغْنِيكُمُ اللَّهُ مِنْ فَضْلِهِ إِنْ شَاءَ ۚ إِنَّ اللَّهَ عَلِيمٌ حَكِيمٌ","numberInSurah":28,"juz":10,"manzil":2,"page":191,"ruku":159,"hizbQuarter":76,"sajda":false},{"number":1264,"text":"قَاتِلُوا الَّذِينَ لَا يُؤْمِنُونَ بِاللَّهِ وَلَا بِالْيَوْمِ الْآخِرِ وَلَا يُحَرِّمُونَ مَا حَرَّمَ اللَّهُ وَرَسُولُهُ وَلَا يَدِينُونَ دِينَ الْحَقِّ مِنَ الَّذِينَ أُوتُوا الْكِتَابَ حَتَّىٰ يُعْطُوا الْجِزْيَةَ عَنْ يَدٍ وَهُمْ صَاغِرُونَ","numberInSurah":29,"juz":10,"manzil":2,"page":191,"ruku":159,"hizbQuarter":76,"sajda":false},{"number":1265,"text":"وَقَالَتِ الْيَهُودُ عُزَيْرٌ ابْنُ اللَّهِ وَقَالَتِ النَّصَارَى الْمَسِيحُ ابْنُ اللَّهِ ۖ ذَٰلِكَ قَوْلُهُمْ بِأَفْوَاهِهِمْ ۖ يُضَاهِئُونَ قَوْلَ الَّذِينَ كَفَرُوا مِنْ قَبْلُ ۚ قَاتَلَهُمُ اللَّهُ ۚ أَنَّىٰ يُؤْفَكُونَ","numberInSurah":30,"juz":10,"manzil":2,"page":191,"ruku":160,"hizbQuarter":76,"sajda":false},{"number":1266,"text":"اتَّخَذُوا أَحْبَارَهُمْ وَرُهْبَانَهُمْ أَرْبَابًا مِنْ دُونِ اللَّهِ وَالْمَسِيحَ ابْنَ مَرْيَمَ وَمَا أُمِرُوا إِلَّا لِيَعْبُدُوا إِلَٰهًا وَاحِدًا ۖ لَا إِلَٰهَ إِلَّا هُوَ ۚ سُبْحَانَهُ عَمَّا يُشْرِكُونَ","numberInSurah":31,"juz":10,"manzil":2,"page":191,"ruku":160,"hizbQuarter":76,"sajda":false},{"number":1267,"text":"يُرِيدُونَ أَنْ يُطْفِئُوا نُورَ اللَّهِ بِأَفْوَاهِهِمْ وَيَأْبَى اللَّهُ إِلَّا أَنْ يُتِمَّ نُورَهُ وَلَوْ كَرِهَ الْكَافِرُونَ","numberInSurah":32,"juz":10,"manzil":2,"page":192,"ruku":160,"hizbQuarter":76,"sajda":false},{"number":1268,"text":"هُوَ الَّذِي أَرْسَلَ رَسُولَهُ بِالْهُدَىٰ وَدِينِ الْحَقِّ لِيُظْهِرَهُ عَلَى الدِّينِ كُلِّهِ وَلَوْ كَرِهَ الْمُشْرِكُونَ","numberInSurah":33,"juz":10,"manzil":2,"page":192,"ruku":160,"hizbQuarter":76,"sajda":false},{"number":1269,"text":"۞ يَا أَيُّهَا الَّذِينَ آمَنُوا إِنَّ كَثِيرًا مِنَ الْأَحْبَارِ وَالرُّهْبَانِ لَيَأْكُلُونَ أَمْوَالَ النَّاسِ بِالْبَاطِلِ وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ ۗ وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنْفِقُونَهَا فِي سَبِيلِ اللَّهِ فَبَشِّرْهُمْ بِعَذَابٍ أَلِيمٍ","numberInSurah":34,"juz":10,"manzil":2,"page":192,"ruku":160,"hizbQuarter":77,"sajda":false},{"number":1270,"text":"يَوْمَ يُحْمَىٰ عَلَيْهَا فِي نَارِ جَهَنَّمَ فَتُكْوَىٰ بِهَا جِبَاهُهُمْ وَجُنُوبُهُمْ وَظُهُورُهُمْ ۖ هَٰذَا مَا كَنَزْتُمْ لِأَنْفُسِكُمْ فَذُوقُوا مَا كُنْتُمْ تَكْنِزُونَ","numberInSurah":35,"juz":10,"manzil":2,"page":192,"ruku":160,"hizbQuarter":77,"sajda":false},{"number":1271,"text":"إِنَّ عِدَّةَ الشُّهُورِ عِنْدَ اللَّهِ اثْنَا عَشَرَ شَهْرًا فِي كِتَابِ اللَّهِ يَوْمَ خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ مِنْهَا أَرْبَعَةٌ حُرُمٌ ۚ ذَٰلِكَ الدِّينُ الْقَيِّمُ ۚ فَلَا تَظْلِمُوا فِيهِنَّ أَنْفُسَكُمْ ۚ وَقَاتِلُوا الْمُشْرِكِينَ كَافَّةً كَمَا يُقَاتِلُونَكُمْ كَافَّةً ۚ وَاعْلَمُوا أَنَّ اللَّهَ مَعَ الْمُتَّقِينَ","numberInSurah":36,"juz":10,"manzil":2,"page":192,"ruku":160,"hizbQuarter":77,"sajda":false},{"number":1272,"text":"إِنَّمَا النَّسِيءُ زِيَادَةٌ فِي الْكُفْرِ ۖ يُضَلُّ بِهِ الَّذِينَ كَفَرُوا يُحِلُّونَهُ عَامًا وَيُحَرِّمُونَهُ عَامًا لِيُوَاطِئُوا عِدَّةَ مَا حَرَّمَ اللَّهُ فَيُحِلُّوا مَا حَرَّمَ اللَّهُ ۚ زُيِّنَ لَهُمْ سُوءُ أَعْمَالِهِمْ ۗ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْكَافِرِينَ","numberInSurah":37,"juz":10,"manzil":2,"page":193,"ruku":160,"hizbQuarter":77,"sajda":false},{"number":1273,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا مَا لَكُمْ إِذَا قِيلَ لَكُمُ انْفِرُوا فِي سَبِيلِ اللَّهِ اثَّاقَلْتُمْ إِلَى الْأَرْضِ ۚ أَرَضِيتُمْ بِالْحَيَاةِ الدُّنْيَا مِنَ الْآخِرَةِ ۚ فَمَا مَتَاعُ الْحَيَاةِ الدُّنْيَا فِي الْآخِرَةِ إِلَّا قَلِيلٌ","numberInSurah":38,"juz":10,"manzil":2,"page":193,"ruku":161,"hizbQuarter":77,"sajda":false},{"number":1274,"text":"إِلَّا تَنْفِرُوا يُعَذِّبْكُمْ عَذَابًا أَلِيمًا وَيَسْتَبْدِلْ قَوْمًا غَيْرَكُمْ وَلَا تَضُرُّوهُ شَيْئًا ۗ وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":39,"juz":10,"manzil":2,"page":193,"ruku":161,"hizbQuarter":77,"sajda":false},{"number":1275,"text":"إِلَّا تَنْصُرُوهُ فَقَدْ نَصَرَهُ اللَّهُ إِذْ أَخْرَجَهُ الَّذِينَ كَفَرُوا ثَانِيَ اثْنَيْنِ إِذْ هُمَا فِي الْغَارِ إِذْ يَقُولُ لِصَاحِبِهِ لَا تَحْزَنْ إِنَّ اللَّهَ مَعَنَا ۖ فَأَنْزَلَ اللَّهُ سَكِينَتَهُ عَلَيْهِ وَأَيَّدَهُ بِجُنُودٍ لَمْ تَرَوْهَا وَجَعَلَ كَلِمَةَ الَّذِينَ كَفَرُوا السُّفْلَىٰ ۗ وَكَلِمَةُ اللَّهِ هِيَ الْعُلْيَا ۗ وَاللَّهُ عَزِيزٌ حَكِيمٌ","numberInSurah":40,"juz":10,"manzil":2,"page":193,"ruku":161,"hizbQuarter":77,"sajda":false},{"number":1276,"text":"انْفِرُوا خِفَافًا وَثِقَالًا وَجَاهِدُوا بِأَمْوَالِكُمْ وَأَنْفُسِكُمْ فِي سَبِيلِ اللَّهِ ۚ ذَٰلِكُمْ خَيْرٌ لَكُمْ إِنْ كُنْتُمْ تَعْلَمُونَ","numberInSurah":41,"juz":10,"manzil":2,"page":194,"ruku":161,"hizbQuarter":77,"sajda":false},{"number":1277,"text":"لَوْ كَانَ عَرَضًا قَرِيبًا وَسَفَرًا قَاصِدًا لَاتَّبَعُوكَ وَلَٰكِنْ بَعُدَتْ عَلَيْهِمُ الشُّقَّةُ ۚ وَسَيَحْلِفُونَ بِاللَّهِ لَوِ اسْتَطَعْنَا لَخَرَجْنَا مَعَكُمْ يُهْلِكُونَ أَنْفُسَهُمْ وَاللَّهُ يَعْلَمُ إِنَّهُمْ لَكَاذِبُونَ","numberInSurah":42,"juz":10,"manzil":2,"page":194,"ruku":161,"hizbQuarter":77,"sajda":false},{"number":1278,"text":"عَفَا اللَّهُ عَنْكَ لِمَ أَذِنْتَ لَهُمْ حَتَّىٰ يَتَبَيَّنَ لَكَ الَّذِينَ صَدَقُوا وَتَعْلَمَ الْكَاذِبِينَ","numberInSurah":43,"juz":10,"manzil":2,"page":194,"ruku":162,"hizbQuarter":77,"sajda":false},{"number":1279,"text":"لَا يَسْتَأْذِنُكَ الَّذِينَ يُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ أَنْ يُجَاهِدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ ۗ وَاللَّهُ عَلِيمٌ بِالْمُتَّقِينَ","numberInSurah":44,"juz":10,"manzil":2,"page":194,"ruku":162,"hizbQuarter":77,"sajda":false},{"number":1280,"text":"إِنَّمَا يَسْتَأْذِنُكَ الَّذِينَ لَا يُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَارْتَابَتْ قُلُوبُهُمْ فَهُمْ فِي رَيْبِهِمْ يَتَرَدَّدُونَ","numberInSurah":45,"juz":10,"manzil":2,"page":194,"ruku":162,"hizbQuarter":77,"sajda":false},{"number":1281,"text":"۞ وَلَوْ أَرَادُوا الْخُرُوجَ لَأَعَدُّوا لَهُ عُدَّةً وَلَٰكِنْ كَرِهَ اللَّهُ انْبِعَاثَهُمْ فَثَبَّطَهُمْ وَقِيلَ اقْعُدُوا مَعَ الْقَاعِدِينَ","numberInSurah":46,"juz":10,"manzil":2,"page":194,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1282,"text":"لَوْ خَرَجُوا فِيكُمْ مَا زَادُوكُمْ إِلَّا خَبَالًا وَلَأَوْضَعُوا خِلَالَكُمْ يَبْغُونَكُمُ الْفِتْنَةَ وَفِيكُمْ سَمَّاعُونَ لَهُمْ ۗ وَاللَّهُ عَلِيمٌ بِالظَّالِمِينَ","numberInSurah":47,"juz":10,"manzil":2,"page":194,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1283,"text":"لَقَدِ ابْتَغَوُا الْفِتْنَةَ مِنْ قَبْلُ وَقَلَّبُوا لَكَ الْأُمُورَ حَتَّىٰ جَاءَ الْحَقُّ وَظَهَرَ أَمْرُ اللَّهِ وَهُمْ كَارِهُونَ","numberInSurah":48,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1284,"text":"وَمِنْهُمْ مَنْ يَقُولُ ائْذَنْ لِي وَلَا تَفْتِنِّي ۚ أَلَا فِي الْفِتْنَةِ سَقَطُوا ۗ وَإِنَّ جَهَنَّمَ لَمُحِيطَةٌ بِالْكَافِرِينَ","numberInSurah":49,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1285,"text":"إِنْ تُصِبْكَ حَسَنَةٌ تَسُؤْهُمْ ۖ وَإِنْ تُصِبْكَ مُصِيبَةٌ يَقُولُوا قَدْ أَخَذْنَا أَمْرَنَا مِنْ قَبْلُ وَيَتَوَلَّوْا وَهُمْ فَرِحُونَ","numberInSurah":50,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1286,"text":"قُلْ لَنْ يُصِيبَنَا إِلَّا مَا كَتَبَ اللَّهُ لَنَا هُوَ مَوْلَانَا ۚ وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ","numberInSurah":51,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1287,"text":"قُلْ هَلْ تَرَبَّصُونَ بِنَا إِلَّا إِحْدَى الْحُسْنَيَيْنِ ۖ وَنَحْنُ نَتَرَبَّصُ بِكُمْ أَنْ يُصِيبَكُمُ اللَّهُ بِعَذَابٍ مِنْ عِنْدِهِ أَوْ بِأَيْدِينَا ۖ فَتَرَبَّصُوا إِنَّا مَعَكُمْ مُتَرَبِّصُونَ","numberInSurah":52,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1288,"text":"قُلْ أَنْفِقُوا طَوْعًا أَوْ كَرْهًا لَنْ يُتَقَبَّلَ مِنْكُمْ ۖ إِنَّكُمْ كُنْتُمْ قَوْمًا فَاسِقِينَ","numberInSurah":53,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1289,"text":"وَمَا مَنَعَهُمْ أَنْ تُقْبَلَ مِنْهُمْ نَفَقَاتُهُمْ إِلَّا أَنَّهُمْ كَفَرُوا بِاللَّهِ وَبِرَسُولِهِ وَلَا يَأْتُونَ الصَّلَاةَ إِلَّا وَهُمْ كُسَالَىٰ وَلَا يُنْفِقُونَ إِلَّا وَهُمْ كَارِهُونَ","numberInSurah":54,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1290,"text":"فَلَا تُعْجِبْكَ أَمْوَالُهُمْ وَلَا أَوْلَادُهُمْ ۚ إِنَّمَا يُرِيدُ اللَّهُ لِيُعَذِّبَهُمْ بِهَا فِي الْحَيَاةِ الدُّنْيَا وَتَزْهَقَ أَنْفُسُهُمْ وَهُمْ كَافِرُونَ","numberInSurah":55,"juz":10,"manzil":2,"page":196,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1291,"text":"وَيَحْلِفُونَ بِاللَّهِ إِنَّهُمْ لَمِنْكُمْ وَمَا هُمْ مِنْكُمْ وَلَٰكِنَّهُمْ قَوْمٌ يَفْرَقُونَ","numberInSurah":56,"juz":10,"manzil":2,"page":196,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1292,"text":"لَوْ يَجِدُونَ مَلْجَأً أَوْ مَغَارَاتٍ أَوْ مُدَّخَلًا لَوَلَّوْا إِلَيْهِ وَهُمْ يَجْمَحُونَ","numberInSurah":57,"juz":10,"manzil":2,"page":196,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1293,"text":"وَمِنْهُمْ مَنْ يَلْمِزُكَ فِي الصَّدَقَاتِ فَإِنْ أُعْطُوا مِنْهَا رَضُوا وَإِنْ لَمْ يُعْطَوْا مِنْهَا إِذَا هُمْ يَسْخَطُونَ","numberInSurah":58,"juz":10,"manzil":2,"page":196,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1294,"text":"وَلَوْ أَنَّهُمْ رَضُوا مَا آتَاهُمُ اللَّهُ وَرَسُولُهُ وَقَالُوا حَسْبُنَا اللَّهُ سَيُؤْتِينَا اللَّهُ مِنْ فَضْلِهِ وَرَسُولُهُ إِنَّا إِلَى اللَّهِ رَاغِبُونَ","numberInSurah":59,"juz":10,"manzil":2,"page":196,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1295,"text":"۞ إِنَّمَا الصَّدَقَاتُ لِلْفُقَرَاءِ وَالْمَسَاكِينِ وَالْعَامِلِينَ عَلَيْهَا وَالْمُؤَلَّفَةِ قُلُوبُهُمْ وَفِي الرِّقَابِ وَالْغَارِمِينَ وَفِي سَبِيلِ اللَّهِ وَابْنِ السَّبِيلِ ۖ فَرِيضَةً مِنَ اللَّهِ ۗ وَاللَّهُ عَلِيمٌ حَكِيمٌ","numberInSurah":60,"juz":10,"manzil":2,"page":196,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1296,"text":"وَمِنْهُمُ الَّذِينَ يُؤْذُونَ النَّبِيَّ وَيَقُولُونَ هُوَ أُذُنٌ ۚ قُلْ أُذُنُ خَيْرٍ لَكُمْ يُؤْمِنُ بِاللَّهِ وَيُؤْمِنُ لِلْمُؤْمِنِينَ وَرَحْمَةٌ لِلَّذِينَ آمَنُوا مِنْكُمْ ۚ وَالَّذِينَ يُؤْذُونَ رَسُولَ اللَّهِ لَهُمْ عَذَابٌ أَلِيمٌ","numberInSurah":61,"juz":10,"manzil":2,"page":196,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1297,"text":"يَحْلِفُونَ بِاللَّهِ لَكُمْ لِيُرْضُوكُمْ وَاللَّهُ وَرَسُولُهُ أَحَقُّ أَنْ يُرْضُوهُ إِنْ كَانُوا مُؤْمِنِينَ","numberInSurah":62,"juz":10,"manzil":2,"page":197,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1298,"text":"أَلَمْ يَعْلَمُوا أَنَّهُ مَنْ يُحَادِدِ اللَّهَ وَرَسُولَهُ فَأَنَّ لَهُ نَارَ جَهَنَّمَ خَالِدًا فِيهَا ۚ ذَٰلِكَ الْخِزْيُ الْعَظِيمُ","numberInSurah":63,"juz":10,"manzil":2,"page":197,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1299,"text":"يَحْذَرُ الْمُنَافِقُونَ أَنْ تُنَزَّلَ عَلَيْهِمْ سُورَةٌ تُنَبِّئُهُمْ بِمَا فِي قُلُوبِهِمْ ۚ قُلِ اسْتَهْزِئُوا إِنَّ اللَّهَ مُخْرِجٌ مَا تَحْذَرُونَ","numberInSurah":64,"juz":10,"manzil":2,"page":197,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1300,"text":"وَلَئِنْ سَأَلْتَهُمْ لَيَقُولُنَّ إِنَّمَا كُنَّا نَخُوضُ وَنَلْعَبُ ۚ قُلْ أَبِاللَّهِ وَآيَاتِهِ وَرَسُولِهِ كُنْتُمْ تَسْتَهْزِئُونَ","numberInSurah":65,"juz":10,"manzil":2,"page":197,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1301,"text":"لَا تَعْتَذِرُوا قَدْ كَفَرْتُمْ بَعْدَ إِيمَانِكُمْ ۚ إِنْ نَعْفُ عَنْ طَائِفَةٍ مِنْكُمْ نُعَذِّبْ طَائِفَةً بِأَنَّهُمْ كَانُوا مُجْرِمِينَ","numberInSurah":66,"juz":10,"manzil":2,"page":197,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1302,"text":"الْمُنَافِقُونَ وَالْمُنَافِقَاتُ بَعْضُهُمْ مِنْ بَعْضٍ ۚ يَأْمُرُونَ بِالْمُنْكَرِ وَيَنْهَوْنَ عَنِ الْمَعْرُوفِ وَيَقْبِضُونَ أَيْدِيَهُمْ ۚ نَسُوا اللَّهَ فَنَسِيَهُمْ ۗ إِنَّ الْمُنَافِقِينَ هُمُ الْفَاسِقُونَ","numberInSurah":67,"juz":10,"manzil":2,"page":197,"ruku":164,"hizbQuarter":79,"sajda":false},{"number":1303,"text":"وَعَدَ اللَّهُ الْمُنَافِقِينَ وَالْمُنَافِقَاتِ وَالْكُفَّارَ نَارَ جَهَنَّمَ خَالِدِينَ فِيهَا ۚ هِيَ حَسْبُهُمْ ۚ وَلَعَنَهُمُ اللَّهُ ۖ وَلَهُمْ عَذَابٌ مُقِيمٌ","numberInSurah":68,"juz":10,"manzil":2,"page":197,"ruku":164,"hizbQuarter":79,"sajda":false},{"number":1304,"text":"كَالَّذِينَ مِنْ قَبْلِكُمْ كَانُوا أَشَدَّ مِنْكُمْ قُوَّةً وَأَكْثَرَ أَمْوَالًا وَأَوْلَادًا فَاسْتَمْتَعُوا بِخَلَاقِهِمْ فَاسْتَمْتَعْتُمْ بِخَلَاقِكُمْ كَمَا اسْتَمْتَعَ الَّذِينَ مِنْ قَبْلِكُمْ بِخَلَاقِهِمْ وَخُضْتُمْ كَالَّذِي خَاضُوا ۚ أُولَٰئِكَ حَبِطَتْ أَعْمَالُهُمْ فِي الدُّنْيَا وَالْآخِرَةِ ۖ وَأُولَٰئِكَ هُمُ الْخَاسِرُونَ","numberInSurah":69,"juz":10,"manzil":2,"page":198,"ruku":164,"hizbQuarter":79,"sajda":false},{"number":1305,"text":"أَلَمْ يَأْتِهِمْ نَبَأُ الَّذِينَ مِنْ قَبْلِهِمْ قَوْمِ نُوحٍ وَعَادٍ وَثَمُودَ وَقَوْمِ إِبْرَاهِيمَ وَأَصْحَابِ مَدْيَنَ وَالْمُؤْتَفِكَاتِ ۚ أَتَتْهُمْ رُسُلُهُمْ بِالْبَيِّنَاتِ ۖ فَمَا كَانَ اللَّهُ لِيَظْلِمَهُمْ وَلَٰكِنْ كَانُوا أَنْفُسَهُمْ يَظْلِمُونَ","numberInSurah":70,"juz":10,"manzil":2,"page":198,"ruku":164,"hizbQuarter":79,"sajda":false},{"number":1306,"text":"وَالْمُؤْمِنُونَ وَالْمُؤْمِنَاتُ بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ ۚ يَأْمُرُونَ بِالْمَعْرُوفِ وَيَنْهَوْنَ عَنِ الْمُنْكَرِ وَيُقِيمُونَ الصَّلَاةَ وَيُؤْتُونَ الزَّكَاةَ وَيُطِيعُونَ اللَّهَ وَرَسُولَهُ ۚ أُولَٰئِكَ سَيَرْحَمُهُمُ اللَّهُ ۗ إِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ","numberInSurah":71,"juz":10,"manzil":2,"page":198,"ruku":164,"hizbQuarter":79,"sajda":false},{"number":1307,"text":"وَعَدَ اللَّهُ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَمَسَاكِنَ طَيِّبَةً فِي جَنَّاتِ عَدْنٍ ۚ وَرِضْوَانٌ مِنَ اللَّهِ أَكْبَرُ ۚ ذَٰلِكَ هُوَ الْفَوْزُ الْعَظِيمُ","numberInSurah":72,"juz":10,"manzil":2,"page":198,"ruku":164,"hizbQuarter":79,"sajda":false},{"number":1308,"text":"يَا أَيُّهَا النَّبِيُّ جَاهِدِ الْكُفَّارَ وَالْمُنَافِقِينَ وَاغْلُظْ عَلَيْهِمْ ۚ وَمَأْوَاهُمْ جَهَنَّمُ ۖ وَبِئْسَ الْمَصِيرُ","numberInSurah":73,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":79,"sajda":false},{"number":1309,"text":"يَحْلِفُونَ بِاللَّهِ مَا قَالُوا وَلَقَدْ قَالُوا كَلِمَةَ الْكُفْرِ وَكَفَرُوا بَعْدَ إِسْلَامِهِمْ وَهَمُّوا بِمَا لَمْ يَنَالُوا ۚ وَمَا نَقَمُوا إِلَّا أَنْ أَغْنَاهُمُ اللَّهُ وَرَسُولُهُ مِنْ فَضْلِهِ ۚ فَإِنْ يَتُوبُوا يَكُ خَيْرًا لَهُمْ ۖ وَإِنْ يَتَوَلَّوْا يُعَذِّبْهُمُ اللَّهُ عَذَابًا أَلِيمًا فِي الدُّنْيَا وَالْآخِرَةِ ۚ وَمَا لَهُمْ فِي الْأَرْضِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ","numberInSurah":74,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":79,"sajda":false},{"number":1310,"text":"۞ وَمِنْهُمْ مَنْ عَاهَدَ اللَّهَ لَئِنْ آتَانَا مِنْ فَضْلِهِ لَنَصَّدَّقَنَّ وَلَنَكُونَنَّ مِنَ الصَّالِحِينَ","numberInSurah":75,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":80,"sajda":false},{"number":1311,"text":"فَلَمَّا آتَاهُمْ مِنْ فَضْلِهِ بَخِلُوا بِهِ وَتَوَلَّوْا وَهُمْ مُعْرِضُونَ","numberInSurah":76,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":80,"sajda":false},{"number":1312,"text":"فَأَعْقَبَهُمْ نِفَاقًا فِي قُلُوبِهِمْ إِلَىٰ يَوْمِ يَلْقَوْنَهُ بِمَا أَخْلَفُوا اللَّهَ مَا وَعَدُوهُ وَبِمَا كَانُوا يَكْذِبُونَ","numberInSurah":77,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":80,"sajda":false},{"number":1313,"text":"أَلَمْ يَعْلَمُوا أَنَّ اللَّهَ يَعْلَمُ سِرَّهُمْ وَنَجْوَاهُمْ وَأَنَّ اللَّهَ عَلَّامُ الْغُيُوبِ","numberInSurah":78,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":80,"sajda":false},{"number":1314,"text":"الَّذِينَ يَلْمِزُونَ الْمُطَّوِّعِينَ مِنَ الْمُؤْمِنِينَ فِي الصَّدَقَاتِ وَالَّذِينَ لَا يَجِدُونَ إِلَّا جُهْدَهُمْ فَيَسْخَرُونَ مِنْهُمْ ۙ سَخِرَ اللَّهُ مِنْهُمْ وَلَهُمْ عَذَابٌ أَلِيمٌ","numberInSurah":79,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":80,"sajda":false},{"number":1315,"text":"اسْتَغْفِرْ لَهُمْ أَوْ لَا تَسْتَغْفِرْ لَهُمْ إِنْ تَسْتَغْفِرْ لَهُمْ سَبْعِينَ مَرَّةً فَلَنْ يَغْفِرَ اللَّهُ لَهُمْ ۚ ذَٰلِكَ بِأَنَّهُمْ كَفَرُوا بِاللَّهِ وَرَسُولِهِ ۗ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْفَاسِقِينَ","numberInSurah":80,"juz":10,"manzil":2,"page":200,"ruku":165,"hizbQuarter":80,"sajda":false},{"number":1316,"text":"فَرِحَ الْمُخَلَّفُونَ بِمَقْعَدِهِمْ خِلَافَ رَسُولِ اللَّهِ وَكَرِهُوا أَنْ يُجَاهِدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ فِي سَبِيلِ اللَّهِ وَقَالُوا لَا تَنْفِرُوا فِي الْحَرِّ ۗ قُلْ نَارُ جَهَنَّمَ أَشَدُّ حَرًّا ۚ لَوْ كَانُوا يَفْقَهُونَ","numberInSurah":81,"juz":10,"manzil":2,"page":200,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1317,"text":"فَلْيَضْحَكُوا قَلِيلًا وَلْيَبْكُوا كَثِيرًا جَزَاءً بِمَا كَانُوا يَكْسِبُونَ","numberInSurah":82,"juz":10,"manzil":2,"page":200,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1318,"text":"فَإِنْ رَجَعَكَ اللَّهُ إِلَىٰ طَائِفَةٍ مِنْهُمْ فَاسْتَأْذَنُوكَ لِلْخُرُوجِ فَقُلْ لَنْ تَخْرُجُوا مَعِيَ أَبَدًا وَلَنْ تُقَاتِلُوا مَعِيَ عَدُوًّا ۖ إِنَّكُمْ رَضِيتُمْ بِالْقُعُودِ أَوَّلَ مَرَّةٍ فَاقْعُدُوا مَعَ الْخَالِفِينَ","numberInSurah":83,"juz":10,"manzil":2,"page":200,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1319,"text":"وَلَا تُصَلِّ عَلَىٰ أَحَدٍ مِنْهُمْ مَاتَ أَبَدًا وَلَا تَقُمْ عَلَىٰ قَبْرِهِ ۖ إِنَّهُمْ كَفَرُوا بِاللَّهِ وَرَسُولِهِ وَمَاتُوا وَهُمْ فَاسِقُونَ","numberInSurah":84,"juz":10,"manzil":2,"page":200,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1320,"text":"وَلَا تُعْجِبْكَ أَمْوَالُهُمْ وَأَوْلَادُهُمْ ۚ إِنَّمَا يُرِيدُ اللَّهُ أَنْ يُعَذِّبَهُمْ بِهَا فِي الدُّنْيَا وَتَزْهَقَ أَنْفُسُهُمْ وَهُمْ كَافِرُونَ","numberInSurah":85,"juz":10,"manzil":2,"page":200,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1321,"text":"وَإِذَا أُنْزِلَتْ سُورَةٌ أَنْ آمِنُوا بِاللَّهِ وَجَاهِدُوا مَعَ رَسُولِهِ اسْتَأْذَنَكَ أُولُو الطَّوْلِ مِنْهُمْ وَقَالُوا ذَرْنَا نَكُنْ مَعَ الْقَاعِدِينَ","numberInSurah":86,"juz":10,"manzil":2,"page":200,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1322,"text":"رَضُوا بِأَنْ يَكُونُوا مَعَ الْخَوَالِفِ وَطُبِعَ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَفْقَهُونَ","numberInSurah":87,"juz":10,"manzil":2,"page":201,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1323,"text":"لَٰكِنِ الرَّسُولُ وَالَّذِينَ آمَنُوا مَعَهُ جَاهَدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ ۚ وَأُولَٰئِكَ لَهُمُ الْخَيْرَاتُ ۖ وَأُولَٰئِكَ هُمُ الْمُفْلِحُونَ","numberInSurah":88,"juz":10,"manzil":2,"page":201,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1324,"text":"أَعَدَّ اللَّهُ لَهُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا ۚ ذَٰلِكَ الْفَوْزُ الْعَظِيمُ","numberInSurah":89,"juz":10,"manzil":2,"page":201,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1325,"text":"وَجَاءَ الْمُعَذِّرُونَ مِنَ الْأَعْرَابِ لِيُؤْذَنَ لَهُمْ وَقَعَدَ الَّذِينَ كَذَبُوا اللَّهَ وَرَسُولَهُ ۚ سَيُصِيبُ الَّذِينَ كَفَرُوا مِنْهُمْ عَذَابٌ أَلِيمٌ","numberInSurah":90,"juz":10,"manzil":2,"page":201,"ruku":167,"hizbQuarter":80,"sajda":false},{"number":1326,"text":"لَيْسَ عَلَى الضُّعَفَاءِ وَلَا عَلَى الْمَرْضَىٰ وَلَا عَلَى الَّذِينَ لَا يَجِدُونَ مَا يُنْفِقُونَ حَرَجٌ إِذَا نَصَحُوا لِلَّهِ وَرَسُولِهِ ۚ مَا عَلَى الْمُحْسِنِينَ مِنْ سَبِيلٍ ۚ وَاللَّهُ غَفُورٌ رَحِيمٌ","numberInSurah":91,"juz":10,"manzil":2,"page":201,"ruku":167,"hizbQuarter":80,"sajda":false},{"number":1327,"text":"وَلَا عَلَى الَّذِينَ إِذَا مَا أَتَوْكَ لِتَحْمِلَهُمْ قُلْتَ لَا أَجِدُ مَا أَحْمِلُكُمْ عَلَيْهِ تَوَلَّوْا وَأَعْيُنُهُمْ تَفِيضُ مِنَ الدَّمْعِ حَزَنًا أَلَّا يَجِدُوا مَا يُنْفِقُونَ","numberInSurah":92,"juz":10,"manzil":2,"page":201,"ruku":167,"hizbQuarter":80,"sajda":false},{"number":1328,"text":"۞ إِنَّمَا السَّبِيلُ عَلَى الَّذِينَ يَسْتَأْذِنُونَكَ وَهُمْ أَغْنِيَاءُ ۚ رَضُوا بِأَنْ يَكُونُوا مَعَ الْخَوَالِفِ وَطَبَعَ اللَّهُ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَعْلَمُونَ","numberInSurah":93,"juz":11,"manzil":2,"page":201,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1329,"text":"يَعْتَذِرُونَ إِلَيْكُمْ إِذَا رَجَعْتُمْ إِلَيْهِمْ ۚ قُلْ لَا تَعْتَذِرُوا لَنْ نُؤْمِنَ لَكُمْ قَدْ نَبَّأَنَا اللَّهُ مِنْ أَخْبَارِكُمْ ۚ وَسَيَرَى اللَّهُ عَمَلَكُمْ وَرَسُولُهُ ثُمَّ تُرَدُّونَ إِلَىٰ عَالِمِ الْغَيْبِ وَالشَّهَادَةِ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ","numberInSurah":94,"juz":11,"manzil":2,"page":202,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1330,"text":"سَيَحْلِفُونَ بِاللَّهِ لَكُمْ إِذَا انْقَلَبْتُمْ إِلَيْهِمْ لِتُعْرِضُوا عَنْهُمْ ۖ فَأَعْرِضُوا عَنْهُمْ ۖ إِنَّهُمْ رِجْسٌ ۖ وَمَأْوَاهُمْ جَهَنَّمُ جَزَاءً بِمَا كَانُوا يَكْسِبُونَ","numberInSurah":95,"juz":11,"manzil":2,"page":202,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1331,"text":"يَحْلِفُونَ لَكُمْ لِتَرْضَوْا عَنْهُمْ ۖ فَإِنْ تَرْضَوْا عَنْهُمْ فَإِنَّ اللَّهَ لَا يَرْضَىٰ عَنِ الْقَوْمِ الْفَاسِقِينَ","numberInSurah":96,"juz":11,"manzil":2,"page":202,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1332,"text":"الْأَعْرَابُ أَشَدُّ كُفْرًا وَنِفَاقًا وَأَجْدَرُ أَلَّا يَعْلَمُوا حُدُودَ مَا أَنْزَلَ اللَّهُ عَلَىٰ رَسُولِهِ ۗ وَاللَّهُ عَلِيمٌ حَكِيمٌ","numberInSurah":97,"juz":11,"manzil":2,"page":202,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1333,"text":"وَمِنَ الْأَعْرَابِ مَنْ يَتَّخِذُ مَا يُنْفِقُ مَغْرَمًا وَيَتَرَبَّصُ بِكُمُ الدَّوَائِرَ ۚ عَلَيْهِمْ دَائِرَةُ السَّوْءِ ۗ وَاللَّهُ سَمِيعٌ عَلِيمٌ","numberInSurah":98,"juz":11,"manzil":2,"page":202,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1334,"text":"وَمِنَ الْأَعْرَابِ مَنْ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَيَتَّخِذُ مَا يُنْفِقُ قُرُبَاتٍ عِنْدَ اللَّهِ وَصَلَوَاتِ الرَّسُولِ ۚ أَلَا إِنَّهَا قُرْبَةٌ لَهُمْ ۚ سَيُدْخِلُهُمُ اللَّهُ فِي رَحْمَتِهِ ۗ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","numberInSurah":99,"juz":11,"manzil":2,"page":202,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1335,"text":"وَالسَّابِقُونَ الْأَوَّلُونَ مِنَ الْمُهَاجِرِينَ وَالْأَنْصَارِ وَالَّذِينَ اتَّبَعُوهُمْ بِإِحْسَانٍ رَضِيَ اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ وَأَعَدَّ لَهُمْ جَنَّاتٍ تَجْرِي تَحْتَهَا الْأَنْهَارُ خَالِدِينَ فِيهَا أَبَدًا ۚ ذَٰلِكَ الْفَوْزُ الْعَظِيمُ","numberInSurah":100,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1336,"text":"وَمِمَّنْ حَوْلَكُمْ مِنَ الْأَعْرَابِ مُنَافِقُونَ ۖ وَمِنْ أَهْلِ الْمَدِينَةِ ۖ مَرَدُوا عَلَى النِّفَاقِ لَا تَعْلَمُهُمْ ۖ نَحْنُ نَعْلَمُهُمْ ۚ سَنُعَذِّبُهُمْ مَرَّتَيْنِ ثُمَّ يُرَدُّونَ إِلَىٰ عَذَابٍ عَظِيمٍ","numberInSurah":101,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1337,"text":"وَآخَرُونَ اعْتَرَفُوا بِذُنُوبِهِمْ خَلَطُوا عَمَلًا صَالِحًا وَآخَرَ سَيِّئًا عَسَى اللَّهُ أَنْ يَتُوبَ عَلَيْهِمْ ۚ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","numberInSurah":102,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1338,"text":"خُذْ مِنْ أَمْوَالِهِمْ صَدَقَةً تُطَهِّرُهُمْ وَتُزَكِّيهِمْ بِهَا وَصَلِّ عَلَيْهِمْ ۖ إِنَّ صَلَاتَكَ سَكَنٌ لَهُمْ ۗ وَاللَّهُ سَمِيعٌ عَلِيمٌ","numberInSurah":103,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1339,"text":"أَلَمْ يَعْلَمُوا أَنَّ اللَّهَ هُوَ يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَأْخُذُ الصَّدَقَاتِ وَأَنَّ اللَّهَ هُوَ التَّوَّابُ الرَّحِيمُ","numberInSurah":104,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1340,"text":"وَقُلِ اعْمَلُوا فَسَيَرَى اللَّهُ عَمَلَكُمْ وَرَسُولُهُ وَالْمُؤْمِنُونَ ۖ وَسَتُرَدُّونَ إِلَىٰ عَالِمِ الْغَيْبِ وَالشَّهَادَةِ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ","numberInSurah":105,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1341,"text":"وَآخَرُونَ مُرْجَوْنَ لِأَمْرِ اللَّهِ إِمَّا يُعَذِّبُهُمْ وَإِمَّا يَتُوبُ عَلَيْهِمْ ۗ وَاللَّهُ عَلِيمٌ حَكِيمٌ","numberInSurah":106,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1342,"text":"وَالَّذِينَ اتَّخَذُوا مَسْجِدًا ضِرَارًا وَكُفْرًا وَتَفْرِيقًا بَيْنَ الْمُؤْمِنِينَ وَإِرْصَادًا لِمَنْ حَارَبَ اللَّهَ وَرَسُولَهُ مِنْ قَبْلُ ۚ وَلَيَحْلِفُنَّ إِنْ أَرَدْنَا إِلَّا الْحُسْنَىٰ ۖ وَاللَّهُ يَشْهَدُ إِنَّهُمْ لَكَاذِبُونَ","numberInSurah":107,"juz":11,"manzil":2,"page":204,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1343,"text":"لَا تَقُمْ فِيهِ أَبَدًا ۚ لَمَسْجِدٌ أُسِّسَ عَلَى التَّقْوَىٰ مِنْ أَوَّلِ يَوْمٍ أَحَقُّ أَنْ تَقُومَ فِيهِ ۚ فِيهِ رِجَالٌ يُحِبُّونَ أَنْ يَتَطَهَّرُوا ۚ وَاللَّهُ يُحِبُّ الْمُطَّهِّرِينَ","numberInSurah":108,"juz":11,"manzil":2,"page":204,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1344,"text":"أَفَمَنْ أَسَّسَ بُنْيَانَهُ عَلَىٰ تَقْوَىٰ مِنَ اللَّهِ وَرِضْوَانٍ خَيْرٌ أَمْ مَنْ أَسَّسَ بُنْيَانَهُ عَلَىٰ شَفَا جُرُفٍ هَارٍ فَانْهَارَ بِهِ فِي نَارِ جَهَنَّمَ ۗ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ","numberInSurah":109,"juz":11,"manzil":2,"page":204,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1345,"text":"لَا يَزَالُ بُنْيَانُهُمُ الَّذِي بَنَوْا رِيبَةً فِي قُلُوبِهِمْ إِلَّا أَنْ تَقَطَّعَ قُلُوبُهُمْ ۗ وَاللَّهُ عَلِيمٌ حَكِيمٌ","numberInSurah":110,"juz":11,"manzil":2,"page":204,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1346,"text":"۞ إِنَّ اللَّهَ اشْتَرَىٰ مِنَ الْمُؤْمِنِينَ أَنْفُسَهُمْ وَأَمْوَالَهُمْ بِأَنَّ لَهُمُ الْجَنَّةَ ۚ يُقَاتِلُونَ فِي سَبِيلِ اللَّهِ فَيَقْتُلُونَ وَيُقْتَلُونَ ۖ وَعْدًا عَلَيْهِ حَقًّا فِي التَّوْرَاةِ وَالْإِنْجِيلِ وَالْقُرْآنِ ۚ وَمَنْ أَوْفَىٰ بِعَهْدِهِ مِنَ اللَّهِ ۚ فَاسْتَبْشِرُوا بِبَيْعِكُمُ الَّذِي بَايَعْتُمْ بِهِ ۚ وَذَٰلِكَ هُوَ الْفَوْزُ الْعَظِيمُ","numberInSurah":111,"juz":11,"manzil":2,"page":204,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1347,"text":"التَّائِبُونَ الْعَابِدُونَ الْحَامِدُونَ السَّائِحُونَ الرَّاكِعُونَ السَّاجِدُونَ الْآمِرُونَ بِالْمَعْرُوفِ وَالنَّاهُونَ عَنِ الْمُنْكَرِ وَالْحَافِظُونَ لِحُدُودِ اللَّهِ ۗ وَبَشِّرِ الْمُؤْمِنِينَ","numberInSurah":112,"juz":11,"manzil":2,"page":205,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1348,"text":"مَا كَانَ لِلنَّبِيِّ وَالَّذِينَ آمَنُوا أَنْ يَسْتَغْفِرُوا لِلْمُشْرِكِينَ وَلَوْ كَانُوا أُولِي قُرْبَىٰ مِنْ بَعْدِ مَا تَبَيَّنَ لَهُمْ أَنَّهُمْ أَصْحَابُ الْجَحِيمِ","numberInSurah":113,"juz":11,"manzil":2,"page":205,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1349,"text":"وَمَا كَانَ اسْتِغْفَارُ إِبْرَاهِيمَ لِأَبِيهِ إِلَّا عَنْ مَوْعِدَةٍ وَعَدَهَا إِيَّاهُ فَلَمَّا تَبَيَّنَ لَهُ أَنَّهُ عَدُوٌّ لِلَّهِ تَبَرَّأَ مِنْهُ ۚ إِنَّ إِبْرَاهِيمَ لَأَوَّاهٌ حَلِيمٌ","numberInSurah":114,"juz":11,"manzil":2,"page":205,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1350,"text":"وَمَا كَانَ اللَّهُ لِيُضِلَّ قَوْمًا بَعْدَ إِذْ هَدَاهُمْ حَتَّىٰ يُبَيِّنَ لَهُمْ مَا يَتَّقُونَ ۚ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ","numberInSurah":115,"juz":11,"manzil":2,"page":205,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1351,"text":"إِنَّ اللَّهَ لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ۖ يُحْيِي وَيُمِيتُ ۚ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ","numberInSurah":116,"juz":11,"manzil":2,"page":205,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1352,"text":"لَقَدْ تَابَ اللَّهُ عَلَى النَّبِيِّ وَالْمُهَاجِرِينَ وَالْأَنْصَارِ الَّذِينَ اتَّبَعُوهُ فِي سَاعَةِ الْعُسْرَةِ مِنْ بَعْدِ مَا كَادَ يَزِيغُ قُلُوبُ فَرِيقٍ مِنْهُمْ ثُمَّ تَابَ عَلَيْهِمْ ۚ إِنَّهُ بِهِمْ رَءُوفٌ رَحِيمٌ","numberInSurah":117,"juz":11,"manzil":2,"page":205,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1353,"text":"وَعَلَى الثَّلَاثَةِ الَّذِينَ خُلِّفُوا حَتَّىٰ إِذَا ضَاقَتْ عَلَيْهِمُ الْأَرْضُ بِمَا رَحُبَتْ وَضَاقَتْ عَلَيْهِمْ أَنْفُسُهُمْ وَظَنُّوا أَنْ لَا مَلْجَأَ مِنَ اللَّهِ إِلَّا إِلَيْهِ ثُمَّ تَابَ عَلَيْهِمْ لِيَتُوبُوا ۚ إِنَّ اللَّهَ هُوَ التَّوَّابُ الرَّحِيمُ","numberInSurah":118,"juz":11,"manzil":2,"page":206,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1354,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَكُونُوا مَعَ الصَّادِقِينَ","numberInSurah":119,"juz":11,"manzil":2,"page":206,"ruku":170,"hizbQuarter":82,"sajda":false},{"number":1355,"text":"مَا كَانَ لِأَهْلِ الْمَدِينَةِ وَمَنْ حَوْلَهُمْ مِنَ الْأَعْرَابِ أَنْ يَتَخَلَّفُوا عَنْ رَسُولِ اللَّهِ وَلَا يَرْغَبُوا بِأَنْفُسِهِمْ عَنْ نَفْسِهِ ۚ ذَٰلِكَ بِأَنَّهُمْ لَا يُصِيبُهُمْ ظَمَأٌ وَلَا نَصَبٌ وَلَا مَخْمَصَةٌ فِي سَبِيلِ اللَّهِ وَلَا يَطَئُونَ مَوْطِئًا يَغِيظُ الْكُفَّارَ وَلَا يَنَالُونَ مِنْ عَدُوٍّ نَيْلًا إِلَّا كُتِبَ لَهُمْ بِهِ عَمَلٌ صَالِحٌ ۚ إِنَّ اللَّهَ لَا يُضِيعُ أَجْرَ الْمُحْسِنِينَ","numberInSurah":120,"juz":11,"manzil":2,"page":206,"ruku":170,"hizbQuarter":82,"sajda":false},{"number":1356,"text":"وَلَا يُنْفِقُونَ نَفَقَةً صَغِيرَةً وَلَا كَبِيرَةً وَلَا يَقْطَعُونَ وَادِيًا إِلَّا كُتِبَ لَهُمْ لِيَجْزِيَهُمُ اللَّهُ أَحْسَنَ مَا كَانُوا يَعْمَلُونَ","numberInSurah":121,"juz":11,"manzil":2,"page":206,"ruku":170,"hizbQuarter":82,"sajda":false},{"number":1357,"text":"۞ وَمَا كَانَ الْمُؤْمِنُونَ لِيَنْفِرُوا كَافَّةً ۚ فَلَوْلَا نَفَرَ مِنْ كُلِّ فِرْقَةٍ مِنْهُمْ طَائِفَةٌ لِيَتَفَقَّهُوا فِي الدِّينِ وَلِيُنْذِرُوا قَوْمَهُمْ إِذَا رَجَعُوا إِلَيْهِمْ لَعَلَّهُمْ يَحْذَرُونَ","numberInSurah":122,"juz":11,"manzil":2,"page":206,"ruku":170,"hizbQuarter":83,"sajda":false},{"number":1358,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا قَاتِلُوا الَّذِينَ يَلُونَكُمْ مِنَ الْكُفَّارِ وَلْيَجِدُوا فِيكُمْ غِلْظَةً ۚ وَاعْلَمُوا أَنَّ اللَّهَ مَعَ الْمُتَّقِينَ","numberInSurah":123,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false},{"number":1359,"text":"وَإِذَا مَا أُنْزِلَتْ سُورَةٌ فَمِنْهُمْ مَنْ يَقُولُ أَيُّكُمْ زَادَتْهُ هَٰذِهِ إِيمَانًا ۚ فَأَمَّا الَّذِينَ آمَنُوا فَزَادَتْهُمْ إِيمَانًا وَهُمْ يَسْتَبْشِرُونَ","numberInSurah":124,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false},{"number":1360,"text":"وَأَمَّا الَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ فَزَادَتْهُمْ رِجْسًا إِلَىٰ رِجْسِهِمْ وَمَاتُوا وَهُمْ كَافِرُونَ","numberInSurah":125,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false},{"number":1361,"text":"أَوَلَا يَرَوْنَ أَنَّهُمْ يُفْتَنُونَ فِي كُلِّ عَامٍ مَرَّةً أَوْ مَرَّتَيْنِ ثُمَّ لَا يَتُوبُونَ وَلَا هُمْ يَذَّكَّرُونَ","numberInSurah":126,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false},{"number":1362,"text":"وَإِذَا مَا أُنْزِلَتْ سُورَةٌ نَظَرَ بَعْضُهُمْ إِلَىٰ بَعْضٍ هَلْ يَرَاكُمْ مِنْ أَحَدٍ ثُمَّ انْصَرَفُوا ۚ صَرَفَ اللَّهُ قُلُوبَهُمْ بِأَنَّهُمْ قَوْمٌ لَا يَفْقَهُونَ","numberInSurah":127,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false},{"number":1363,"text":"لَقَدْ جَاءَكُمْ رَسُولٌ مِنْ أَنْفُسِكُمْ عَزِيزٌ عَلَيْهِ مَا عَنِتُّمْ حَرِيصٌ عَلَيْكُمْ بِالْمُؤْمِنِينَ رَءُوفٌ رَحِيمٌ","numberInSurah":128,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false},{"number":1364,"text":"فَإِنْ تَوَلَّوْا فَقُلْ حَسْبِيَ اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ ۖ عَلَيْهِ تَوَكَّلْتُ ۖ وَهُوَ رَبُّ الْعَرْشِ الْعَظِيمِ","numberInSurah":129,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":9,"name":"سُورَةُ التَّوۡبَةِ","englishName":"Tevbe","englishNameTranslation":"The Repentance","revelationType":"Medinan","numberOfAyahs":129,"ayahs":[{"number":1236,"text":"Allah'tan ve Peygamberinden, kendileriyle andlaşma yaptığınız müşriklere ihtardır: Yeryüzünde dört ay daha dolaşabilirsiniz. Allah'ı aciz bırakamayacağınızı, Allah'ın inkarcıları rezil edeceğini bilin.","numberInSurah":1,"juz":10,"manzil":2,"page":187,"ruku":156,"hizbQuarter":75,"sajda":false},{"number":1237,"text":"Allah'tan ve Peygamberinden, kendileriyle andlaşma yaptığınız müşriklere ihtardır: Yeryüzünde dört ay daha dolaşabilirsiniz. Allah'ı aciz bırakamayacağınızı, Allah'ın inkarcıları rezil edeceğini bilin.","numberInSurah":2,"juz":10,"manzil":2,"page":187,"ruku":156,"hizbQuarter":75,"sajda":false},{"number":1238,"text":"Allah'ın ve Peygamberinin, ortak koşanlardan uzak olduğunu, büyük hac günü, Allah ve peygamberi insanlara ilan eder. Eğer tevbe ederseniz, bu sizin için daha hayırlı olur, yüz çevirirseniz, bilin ki siz Allah'ı aciz bırakamazsınız. İnkar edenlere can yakıcı azabı müjdele.","numberInSurah":3,"juz":10,"manzil":2,"page":187,"ruku":156,"hizbQuarter":75,"sajda":false},{"number":1239,"text":"Yalnız, andlaşma hükümlerinde size karşı bir eksiklik yapmayan ve aleyhinizde kimseye yardım etmeyen müşriklerle yaptığınız andlaşmaya sonuna kadar riayet edin. Allah sakınanları sever.","numberInSurah":4,"juz":10,"manzil":2,"page":187,"ruku":156,"hizbQuarter":75,"sajda":false},{"number":1240,"text":"Hürmetli aylar çıkınca, puta tapanları bulduğunuz yerde öldürün; onları yakalayıp hapsedin; her gözetleme yerinde onları bekleyin. Eğer tevbe eder, namaz kılar ve zekat verirlerse yollarını serbest bırakın. Doğrusu Allah bağışlar ve merhamet eder.","numberInSurah":5,"juz":10,"manzil":2,"page":187,"ruku":156,"hizbQuarter":75,"sajda":false},{"number":1241,"text":"Puta tapanlardan biri sana sığınırsa, onu güvene al; ta ki Allah'ın sözünü dinlesin. Sonra onu güven içinde olacağı yere ulaştır. Çünkü onlar bilgisiz bir topluluktur.","numberInSurah":6,"juz":10,"manzil":2,"page":187,"ruku":156,"hizbQuarter":75,"sajda":false},{"number":1242,"text":"Mescidi Haram'ın yanında andlaştıklarınızın dışında, puta tapanların Allah katında ve Peygamberi önünde nasıl bir andlaşmaları olabilir. Size doğru davrandıkça siz de onlara doğru davranın. Allah, sözleşmelerini bozmaktan sakınanları sever.","numberInSurah":7,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1243,"text":"Nasıl olabilir ki, size üstün gelselerdi ne bir yakınlık, ne de bir ahd gözetirlerdi. Kalpleriyle istemezlerken sizi ağızlarıyla hoşnut etmeye uğraşırlar; çokları fasıktırlar.","numberInSurah":8,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1244,"text":"Allah'ın ayetlerini az bir değere değişip, O'nun yolundan alıkoydular. Onların işledikleri gerçekten ne kötüdür!","numberInSurah":9,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1245,"text":"Onlar hiçbir müminin yakınlık veya ahdini gözetmezler. İşte aşırı gidenler bunlardır.","numberInSurah":10,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1246,"text":"Eğer tevbe eder, namaz kılar ve zekat verirlerse, sizin din kardeşiniz olurlar. Bilen kimseler için ayetleri uzun uzadıya açıklıyoruz.","numberInSurah":11,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1247,"text":"Eğer andlaşmalarından sonra, yeminlerini bozarlar, dininize dil uzatırlarsa, inkarda önde gidenlerle savaşın, çünkü onların yeminleri sayılmaz, belki vazgeçerler.","numberInSurah":12,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1248,"text":"Yeminlerini bozan, Peygamberi sürgüne göndermeye azmeden bir toplumla savaşmanız gerekmez mi ki, önce onlar başlamışlardır? Onlardan korkar mısınız? Eğer inanıyorsanız bilin ki asıl korkmanız gereken Allah'tır.","numberInSurah":13,"juz":10,"manzil":2,"page":188,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1249,"text":"Onlarla savaşın ki Allah sizin elinizle onları azablandırsın, rezil etsin ve sizi üstün getirsin de müminlerin gönüllerini ferahlandırsın, kalblerindeki öfkeyi gidersin. Allah dilediğinin tevbesini kabul eder. Allah Bilendir, Hakimdir.","numberInSurah":14,"juz":10,"manzil":2,"page":189,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1250,"text":"Onlarla savaşın ki Allah sizin elinizle onları azablandırsın, rezil etsin ve sizi üstün getirsin de müminlerin gönüllerini ferahlandırsın, kalblerindeki öfkeyi gidersin. Allah dilediğinin tevbesini kabul eder. Allah Bilendir, Hakimdir.","numberInSurah":15,"juz":10,"manzil":2,"page":189,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1251,"text":"Allah, içinizden cihat edenleri; Allah'tan, peygamberinden ve inananlardan başka sırdaş edinmeyenleri ortaya çıkarmadan sizi kendi halinize bırakacak mı zannediyorsunuz? Allah işlediklerinizden haberdardır.","numberInSurah":16,"juz":10,"manzil":2,"page":189,"ruku":157,"hizbQuarter":75,"sajda":false},{"number":1252,"text":"Puta tapanların kendilerinin inkarcı olduklarını itiraf edip dururken Allah'ın mescidlerini onarmaları gerekmez. Onların işledikleri boşa gitmiştir, cehennemde temelli kalacaklardır.","numberInSurah":17,"juz":10,"manzil":2,"page":189,"ruku":158,"hizbQuarter":75,"sajda":false},{"number":1253,"text":"Allah'ın mescidlerini sadece, Allah'a ve ahiret gününe inanan, namaz kılan, zekat veren ve ancak Allah'tan korkan kimseler onarır. İşte onlar doğru yolda bulunanlardan olabilirler.","numberInSurah":18,"juz":10,"manzil":2,"page":189,"ruku":158,"hizbQuarter":75,"sajda":false},{"number":1254,"text":"Hacca gelenlere su vermeyi, Mescidi Haramı onarmayı, Allah'a ve ahiret gününe inananla, Allah yolunda cihat edenle bir mi tuttunuz? Allah katında bir olmazlar; Allah zulmeden milleti doğru yola eriştirmez.","numberInSurah":19,"juz":10,"manzil":2,"page":189,"ruku":158,"hizbQuarter":76,"sajda":false},{"number":1255,"text":"İnanan, hicret eden ve Allah yolunda mallarıyla, canlarıyla cihat eden kimselere Allah katında en büyük dereceler vardır. İşte kurtulanlar onlardır.","numberInSurah":20,"juz":10,"manzil":2,"page":189,"ruku":158,"hizbQuarter":76,"sajda":false},{"number":1256,"text":"Rableri onlara katından bir rahmet, hoşnutluk ve içinde tükenmez nimetler bulunan cennetleri müjdeler. Doğrusu büyük ecir Allah katındadır.","numberInSurah":21,"juz":10,"manzil":2,"page":190,"ruku":158,"hizbQuarter":76,"sajda":false},{"number":1257,"text":"Rableri onlara katından bir rahmet, hoşnutluk ve içinde tükenmez nimetler bulunan cennetleri müjdeler. Doğrusu büyük ecir Allah katındadır.","numberInSurah":22,"juz":10,"manzil":2,"page":190,"ruku":158,"hizbQuarter":76,"sajda":false},{"number":1258,"text":"Ey inananlar! Babalarınızı, kardeşlerinizi küfrü imana tercih ediyorlarsa dost edinmeyin. Sizden onları kim dost edinirse doğrusu kendine yazık etmiş olurlar.","numberInSurah":23,"juz":10,"manzil":2,"page":190,"ruku":158,"hizbQuarter":76,"sajda":false},{"number":1259,"text":"De ki: \"Babalarınız, oğullarınız, kardeşleriniz, eşleriniz, akrabanız, elde ettiğiniz mallar, durgun gitmesinden korktuğunuz ticaret, hoşunuza giden evler sizce Allah'tan, Peygamberinden ve Allah yolunda savaşmaktan daha sevgili ise, Allah'ın buyruğu gelene kadar bekleyin. Allah fasık kimseleri doğru yola eriştirmez.\"","numberInSurah":24,"juz":10,"manzil":2,"page":190,"ruku":158,"hizbQuarter":76,"sajda":false},{"number":1260,"text":"And olsun ki Allah size birçok yerlerde, ve çokluğunuzun sizi böbürlendirdiği fakat bir faydası da olmadığı, yeryüzünün geniş olmasına rağmen size dar gelip de bozularak arkanıza döndüğünüz Huneyn gününde yardım etmişti.","numberInSurah":25,"juz":10,"manzil":2,"page":190,"ruku":159,"hizbQuarter":76,"sajda":false},{"number":1261,"text":"Bozgundan sonra Allah, Peygamberine, müminlere güvenlik verdi ve görmediğiniz askerler indirdi; inkar edenleri azaba uğrattı. İnkarcıların cezası budur.","numberInSurah":26,"juz":10,"manzil":2,"page":190,"ruku":159,"hizbQuarter":76,"sajda":false},{"number":1262,"text":"Allah bundan sonra da dilediğinin tevbesini kabul eder. Allah bağışlar ve merhamet eder.","numberInSurah":27,"juz":10,"manzil":2,"page":191,"ruku":159,"hizbQuarter":76,"sajda":false},{"number":1263,"text":"Ey inananlar! Doğrusu puta tapanlar pistirler, bu sebeple, bu yıllardan sonra Mescidi Haram'a yaklaşmasınlar. Eğer fakirlikten korkarsanız, bilin ki Allah dilerse sizi bol nimetiyle zenginleştirecektir. Allah şüphesiz bilendir, hakimdir.","numberInSurah":28,"juz":10,"manzil":2,"page":191,"ruku":159,"hizbQuarter":76,"sajda":false},{"number":1264,"text":"Kitap verilenlerden, Allah'a, ahiret gününe inanmayan, Allah'ın ve Peygamberinin haram kıldığını haram saymayan, hak dinini din edinmeyenlerle, boyunlarını büküp kendi elleriyle cizye verene kadar savaşın.","numberInSurah":29,"juz":10,"manzil":2,"page":191,"ruku":159,"hizbQuarter":76,"sajda":false},{"number":1265,"text":"Yahudiler, \"Üzeyr Allah'ın oğludur\" dediler; Hıristiyanlar, \"Mesih Allah'ın oğludur\" dediler. Bu, daha önce inkar edenlerin sözlerine benzeterek ağızlarında geveledikleri sözdür. Allah onları yok etsin, nasıl da uyduruyorlar!","numberInSurah":30,"juz":10,"manzil":2,"page":191,"ruku":160,"hizbQuarter":76,"sajda":false},{"number":1266,"text":"Onlar Allah'ı bırakıp hahamlarını, papazlarını ve Meryem oğlu Mesih'i rableri olarak kabul ettiler. Oysa tek Tanrı'dan başkasına kulluk etmemekle emrolunmuşlardı. Ondan başka tanrı yoktur. Allah, koştukları eşlerden münezzehtir.","numberInSurah":31,"juz":10,"manzil":2,"page":191,"ruku":160,"hizbQuarter":76,"sajda":false},{"number":1267,"text":"Allah'ın nurunu ağızlarıyla söndürmek isterler. Kafirler istemese de Allah nurunu mutlaka tamamlayacaktır.","numberInSurah":32,"juz":10,"manzil":2,"page":192,"ruku":160,"hizbQuarter":76,"sajda":false},{"number":1268,"text":"Puta tapanlar hoşlanmasa da, dinini bütün dinlerden üstün kılmak üzere, Peygamberini doğru yol ve hak dinle gönderen Allah'tır.","numberInSurah":33,"juz":10,"manzil":2,"page":192,"ruku":160,"hizbQuarter":76,"sajda":false},{"number":1269,"text":"Ey inananlar! Hahamlar ve rahiplerin çoğu, insanların mallarını haksızlıkla yerler. Allah yolundan alıkoyarlar. Altın ve gümüşü biriktirip Allah yolunda sarf etmeyenlere can yakıcı bir azabı müjdele.","numberInSurah":34,"juz":10,"manzil":2,"page":192,"ruku":160,"hizbQuarter":77,"sajda":false},{"number":1270,"text":"Bunlar cehennem ateşinde kızdırıldığı gün, alınları, böğürleri ve sırtları onlarla dağlanacak, \"Bu, kendiniz için biriktirdiğinizdir; biriktirdiğinizi tadın\" denecek.","numberInSurah":35,"juz":10,"manzil":2,"page":192,"ruku":160,"hizbQuarter":77,"sajda":false},{"number":1271,"text":"Allah'ın gökleri ve yeri yarattığı günkü yazısında, Allah'a göre ayların sayısı onikidir. Bunlardan dördü hürmetli aydır. Bu dosdoğru bir nizamdır. Öyleyse o aylar içinde kendinize yazık etmeyin, topyekun sizinle savaşan putperestlerle siz de topyekun savaşın, Allah'ın sakınanlarla beraber olduğunu bilin.","numberInSurah":36,"juz":10,"manzil":2,"page":192,"ruku":160,"hizbQuarter":77,"sajda":false},{"number":1272,"text":"Sapıtmak için hürmetli ayların yerlerini değiştirip geciktirmek, küfürde gerçekten ileri gitmekdir. İnkar edenler Allah'ın haram kıldığı ayların sayısına uydurmak için, onu bir yıl haram, bir yıl helal sayıyor, böylece Allah'ın haram kıldığını helalkılıyorlar. Kötü işleri kendilerine güzel göründü. Allah inkar eden toplumu doğru yola eriştirmez.","numberInSurah":37,"juz":10,"manzil":2,"page":193,"ruku":160,"hizbQuarter":77,"sajda":false},{"number":1273,"text":"Ey inananlar! Size ne oldu ki, \"Allah yolunda, savaşa çıkın\" dendiği zaman yere çöküp kaldınız? Oysa dünya hayatının geçimi ahirete göre pek az bir şeydir.","numberInSurah":38,"juz":10,"manzil":2,"page":193,"ruku":161,"hizbQuarter":77,"sajda":false},{"number":1274,"text":"Çıkmazsanız Allah size can yakıcı azabla azabeder ve yerinize başka bir millet getirir. O'na bir şey de yapamazsınız. Allah her şeye kadirdir.","numberInSurah":39,"juz":10,"manzil":2,"page":193,"ruku":161,"hizbQuarter":77,"sajda":false},{"number":1275,"text":"Ona (Muhammed'e) yardım etmezseniz, bilin ki, inkar edenler onu Mekke'den çıkardıklarında mağarada bulunan iki kişiden biri olarak Allah ona yardım etmişti. Arkadaşına (Ebu Bekir'e) \"Üzülme, Allah bizimledir\" diyordu; Allah da ona güven vermiş, görmediğiniz askerlerle onu desteklemiş, inkar edenlerin sözünü alçaltmıştı. Ancak Allah'ın sözü yücedir. Allah güçlüdür, hakimdir.","numberInSurah":40,"juz":10,"manzil":2,"page":193,"ruku":161,"hizbQuarter":77,"sajda":false},{"number":1276,"text":"İsteyen, istemeyen, hepiniz savaşa çıkın. Allah yolunda mallarınızla, canlarınızla cihat edin. Bilirseniz bu sizin için hayırlıdır.","numberInSurah":41,"juz":10,"manzil":2,"page":194,"ruku":161,"hizbQuarter":77,"sajda":false},{"number":1277,"text":"Kolay bir kazanç, normal bir yolculuk olsaydı sana uyarlardı, fakat çıkılacak yol onlara uzak geldi, kendilerini helak ederek, \"Gücümüz yetseydi sizinle beraber çıkardık\" diye Allah'a yemin edeceklerdir. Allah, onların yalancı olduğunu elbette biliyor.","numberInSurah":42,"juz":10,"manzil":2,"page":194,"ruku":161,"hizbQuarter":77,"sajda":false},{"number":1278,"text":"Allah seni affetsin; doğrular sana belli olup, yalancıları bilmeden önce, niçin onlara izin verdin?","numberInSurah":43,"juz":10,"manzil":2,"page":194,"ruku":162,"hizbQuarter":77,"sajda":false},{"number":1279,"text":"Allah'a ve ahiret gününe inananlar, mallariyle, canlariyle savaşmak istediklerinden ötürü geri kalmak için senden izin istemezler. Allah sakınanları bilir.","numberInSurah":44,"juz":10,"manzil":2,"page":194,"ruku":162,"hizbQuarter":77,"sajda":false},{"number":1280,"text":"Ancak Allah'a ve ahiret gününe inanmayan, kalbleri şüpheye düşüp şüphelerinde bocalayan kimseler senden izin isterler.","numberInSurah":45,"juz":10,"manzil":2,"page":194,"ruku":162,"hizbQuarter":77,"sajda":false},{"number":1281,"text":"Eğer savaşa çıkmak isteselerdi bir hazırlık yaparlardı. Ama Allah davranışlarını beğenmedi de onları alıkoydu. \"Acizlerle beraber oturun\" denildi.","numberInSurah":46,"juz":10,"manzil":2,"page":194,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1282,"text":"Aranızda savaşa çıkmış olsalardı, ancak sizi bozmağa çalışırlar ve fitneye düşürmek için aranıza sokulurlardı. İçinizde onlara kulak verenler var. Allah kendilerine yazık edenleri bilir.","numberInSurah":47,"juz":10,"manzil":2,"page":194,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1283,"text":"And olsun ki, daha önce de fitne koparmak istemişlerdi. Sana karşı bir takım işler çeviriyorlardı, sonunda onlar istemedikleri halde hak ortaya çıktı, Allah'ın emri üstün geldi.","numberInSurah":48,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1284,"text":"Onlardan, \"Bana izin ver, beni fitneye düşürme\" diyen vardır. Bilin ki onlar zaten fitneye düşmüşlerdi. Cehennem, inkar edenleri şüphesiz kuşatacaktır.","numberInSurah":49,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1285,"text":"Sana bir iyilik gelince onların fenasına gider; bir kötülük gelse, \"Biz önceden ihtiyatlı davrandık\" derler, sevinerek dönüp giderler.","numberInSurah":50,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1286,"text":"De ki: \"Allah'ın bize yazdığından başkası başımıza gelmez. O bizim Mevlamızdır, inananlar Allah'a güvensin.\"","numberInSurah":51,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1287,"text":"De ki: \"Bize iki iyiden, gazilik ve şehidlikten başka bir şeyin gelmesini mi bekliyorsunuz? Oysa biz Allah'ın kendi katından veya elimizle, sizi bir azaba uğratmasını bekliyoruz. Bekleyiniz, doğrusu biz de sizinle birlikte beklemekteyiz.\"","numberInSurah":52,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1288,"text":"De ki: \"İstekli yahut isteksiz olarak verin, nasıl olsa kabul edilmeyecektir. Siz şüphesiz fasık bir topluluksunuz.\"","numberInSurah":53,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1289,"text":"Verdiklerinin kabul olunmasına engel olan, Allah'ı ve Peygamberini inkar etmeleri, namaza tembel tembel gelmeleri, istemeye istemeye vermeleridir.","numberInSurah":54,"juz":10,"manzil":2,"page":195,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1290,"text":"Artık onların malları ve çocukları seni imrendirmesin. Allah bunlarla onlara dünya hayatında azabetmek ve canlarının inkarcı olarak çıkmasını ister.","numberInSurah":55,"juz":10,"manzil":2,"page":196,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1291,"text":"Sizden olmadıkları halde, sizinle beraber olduklarına Allah'a yemin ederler. Oysa onlar korkak bir topluluktur.","numberInSurah":56,"juz":10,"manzil":2,"page":196,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1292,"text":"Bir sığınak veya mağara yahut girecek bir yer bulmuş olsalardı, çarçabuk oraya yönelirlerdi.","numberInSurah":57,"juz":10,"manzil":2,"page":196,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1293,"text":"Sadakalar hakkında sana dil uzatanlar vardır. Onlara verilirse hoşnut olurlar, verilmezse, hemen öfkeleniverirler.","numberInSurah":58,"juz":10,"manzil":2,"page":196,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1294,"text":"Eğer onlar, Allah ve Peygamberinin kendilerine vermiş oldukları şeylere razı olsalar ve \"Allah bize yeter, O ve Peygamberi bol nimetinden bize verecektir; doğrusu biz Allah'a gönül bağlayanlardanız\" deselerdi daha hayırlı olurdu.","numberInSurah":59,"juz":10,"manzil":2,"page":196,"ruku":162,"hizbQuarter":78,"sajda":false},{"number":1295,"text":"Zekatlar; Allah'tan bir farz olarak yoksullara, düşkünlere, onu toplayan memurlara, kalbleri Müslümanlığa ısındırılacaklara verilir; kölelerin, borçluların, Allah yolunda olanların ve yolda kalanların uğrunda sarfedilir. Allah bilendir, hakimdir.","numberInSurah":60,"juz":10,"manzil":2,"page":196,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1296,"text":"İkiyüzlülerin içinde \"O her şeye kulak kesiliyor\" diyerek Peygamberi incitenler vardır. De ki: \"O kulak, Allah'a inanan ve müminlere inanan, sizin için hayırlı olan, içinizden inanan kimselere rahmet olan bir kulaktır.\" Allah'ın Peygamberini incitenlere can yakıcı azab vardır.","numberInSurah":61,"juz":10,"manzil":2,"page":196,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1297,"text":"Sizi hoşnut etmek için Allah'a yemin ederler. Eğer inanıyorlarsa Allah'ı ve Peygamberini hoşnut etmeleri daha gereklidir.","numberInSurah":62,"juz":10,"manzil":2,"page":197,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1298,"text":"Allah'a ve Peygamberine karşı koymağa kalkışana, ebedi kalacağı cehennem ateşi bulunduğunu bilmezler mi? Büyük rezillik budur.","numberInSurah":63,"juz":10,"manzil":2,"page":197,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1299,"text":"İkiyüzlüler, kalblerinde olanı haber verecek bir surenin inmesinden çekiniyorlar. De ki: \"Alay edin bakalım, Allah çekindiğiniz şeyi ortaya koyacaktır.\"","numberInSurah":64,"juz":10,"manzil":2,"page":197,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1300,"text":"Onlara soracak olursan, \"Biz and olsun ki, eğlenip oynuyorduk\" diyecekler; De ki: \"Allah'la, ayetleriyle, Peygamberiyle mi alay ediyordunuz?\"","numberInSurah":65,"juz":10,"manzil":2,"page":197,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1301,"text":"Özür beyan etmeyin, inandıktan sonra inkar ettiniz. İçinizden bir topluluğu affetsek bile, suçlarından ötürü bir topluluğa da azab ederiz.","numberInSurah":66,"juz":10,"manzil":2,"page":197,"ruku":163,"hizbQuarter":79,"sajda":false},{"number":1302,"text":"İkiyüzlü erkek ve kadınlar da birbirlerindendir: Kötülüğü emreder, iyiliğe engel olurlar; elleri de sıkıdır; Allah'ı unuttular, bu yüzden Allah da onları unuttu. Doğrusu ikiyüzlüler fasıktırlar.","numberInSurah":67,"juz":10,"manzil":2,"page":197,"ruku":164,"hizbQuarter":79,"sajda":false},{"number":1303,"text":"Allah, ikiyüzlü erkek ve kadınlara ve inkarcılara, ebedi kalacakları cehennem ateşini hazırlamıştır. O, onlara yeter. Allah onları lanetlemiştir (rahmetinden uzak kılmıştır). Onlara devamlı azab vardır.","numberInSurah":68,"juz":10,"manzil":2,"page":197,"ruku":164,"hizbQuarter":79,"sajda":false},{"number":1304,"text":"Ey ikiyüzlüler! Siz, sizden önce daha kuvvetli, malları ve çocukları daha çok olup, hisselerince bunlardan faydalanan kimseler gibisiniz. Sizden öncekiler, hisselerince faydalandıkları gibi siz de hissenizce faydalandınız ve onların batıla daldıklarıgibi siz de daldınız. İşte bunlar dünyada ve ahirette işleri boşa çıkanlardır, işte bunlar mahvolanlardır.","numberInSurah":69,"juz":10,"manzil":2,"page":198,"ruku":164,"hizbQuarter":79,"sajda":false},{"number":1305,"text":"Kendilerinden önce olan Nuh, Ad, Semud milletlerinin, İbrahim milletinin, Medyen ve altüst olmuş şehirler halkının haberleri onlara gelmedi mi? Peygamberleri onlara belgeler getirmişlerdi. Allah onlara zulmetmemiş, onlar kendilerine yazık etmişlerdir.","numberInSurah":70,"juz":10,"manzil":2,"page":198,"ruku":164,"hizbQuarter":79,"sajda":false},{"number":1306,"text":"Mümin erkekler ve mümin kadınlar birbirlerinin velileridir; iyiyi emreder kötülükten alıkorlar; namaz kılarlar, zekat verirler, Allah'a ve Peygamberine itaat ederler. İşte Allah bunlara rahmet edecektir. Allah şüphesiz güçlüdür, hakimdir.","numberInSurah":71,"juz":10,"manzil":2,"page":198,"ruku":164,"hizbQuarter":79,"sajda":false},{"number":1307,"text":"Allah mümin erkeklere ve mümin kadınlara, temelli kalacakları, içlerinden ırmaklar akan cennetler, Adn cennetlerinde hoş meskenler vadetmiştir. Allah'ın hoşnut olması en büyük şeydir. İşte büyük kurtuluş budur.","numberInSurah":72,"juz":10,"manzil":2,"page":198,"ruku":164,"hizbQuarter":79,"sajda":false},{"number":1308,"text":"Ey Peygamber! İnkarcılarla, ikiyüzlülerle savaş; onlara karşı sert davran. Varacakları yer cehennemdir, ne kötü dönüştür.","numberInSurah":73,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":79,"sajda":false},{"number":1309,"text":"And olsun ki, müslüman olduktan sonra inkar edip küfür sözünü söylemişler iken, söylemedik diye Allah'a yemin ettiler, başaramayacakları bir şeye giriştiler; Allah ve Peygamberi bol nimetinden onları zenginleştirdi ve öç almaya kalktılar. Eğer tevbe ederlerse iyiliklerine olur; şayet yüz çevirirlerse, Allah onları dünya ve ahirette can yakıcı azaba uğratır. Yeryüzünde bir dost ve yardımcıları yoktur.","numberInSurah":74,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":79,"sajda":false},{"number":1310,"text":"Aralarında: \"Allah bize bol nimetinden verecek olursa, and olsun ki sadaka vereceğiz ve iyilerden olacağız\" diye O'na and verenler vardır.","numberInSurah":75,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":80,"sajda":false},{"number":1311,"text":"Allah onlara bol nimetinden verince, cimrilik ettiler, yüz çevirdiler. Zaten dönektirler.","numberInSurah":76,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":80,"sajda":false},{"number":1312,"text":"Allah'a verdikleri sözden caydıkları ve yalancı oldukları için O'nunla karşılaşacakları güne kadar Allah kalblerine nifak soktu.","numberInSurah":77,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":80,"sajda":false},{"number":1313,"text":"İkiyüzlüler, Allah'ın onların sırlarını ve gizli toplantılarını bildiğini, Allah'ın görünmeyenleri bilen olduğunu bilmiyorlar mıydı?","numberInSurah":78,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":80,"sajda":false},{"number":1314,"text":"Sadaka vermekte gönülden davranan müminlere dil uzatan ve ancak ellerinden geldiği kadar verebilenlerle alay eden kimselere bu davranışlarının cezasını Allah verir; onlara can yakıcı azab vardır.","numberInSurah":79,"juz":10,"manzil":2,"page":199,"ruku":165,"hizbQuarter":80,"sajda":false},{"number":1315,"text":"Onların ister bağışlanmasını dile, ister dileme, birdir. Onlara yetmiş defa bağışlanma dilesen Allah onları bağışlamayacaktır. Bu, Allah'ı ve Peygamberini inkar etmelerinden ötürüdür. Allah fasık topluluğu doğru yola eriştirmez.","numberInSurah":80,"juz":10,"manzil":2,"page":200,"ruku":165,"hizbQuarter":80,"sajda":false},{"number":1316,"text":"Allah'ın Peygamberinin hilafına geri kalanlar, oturup kalmalarına sevindiler. Allah yolunda mallariyle ve canlariyle cihat hoşlarına gitmedi. \"Sıcakta savaşa çıkmayın\" dediler. De ki: \"Cehennem ateşi daha sıcaktır.\" Keşke bilseydiler!","numberInSurah":81,"juz":10,"manzil":2,"page":200,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1317,"text":"Yaptıklarının cezası olarak, bundan böyle az gülsünler, çok ağlasınlar.","numberInSurah":82,"juz":10,"manzil":2,"page":200,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1318,"text":"Allah seni geri döndürüp, onlardan bir toplulukla karşılaştırdığı zaman, senden savaşa çıkmak için izin isterlerse, de ki: \"Benimle asla çıkamayacaksınız, benim yanımda hiçbir düşmanla savaşmıyacaksınız; çünkü baştan, oturup kalmaya razı oldunuz. Artık geri kalanlarla beraber oturun.\"","numberInSurah":83,"juz":10,"manzil":2,"page":200,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1319,"text":"Onlardan ölen kimsenin namazını sakın kılma, mezarı başında da durma! Çünkü onlar Allah'ı ve peygamberini inkar ettiler, fasık olarak öldüler.","numberInSurah":84,"juz":10,"manzil":2,"page":200,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1320,"text":"Malları ve çocukları seni hayrete düşürmesin; Allah bunlarla onlara dünyada azabetmek ve canlarının inkarcı olarak çıkmasını ister.","numberInSurah":85,"juz":10,"manzil":2,"page":200,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1321,"text":"\"Allah'a inanın ve Peygamberinin yanında savaşın\" diye bir sure inmiş olsa, onların gücü yetenleri sizden izin isterler ve \"Bizi bırak oturanlarla beraber kalalım\" derler.","numberInSurah":86,"juz":10,"manzil":2,"page":200,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1322,"text":"Geri kalan kadınlarla beraber bulunmaya razı oldular. Kalbleri kapanmıştır, bu yüzden anlamazlar.","numberInSurah":87,"juz":10,"manzil":2,"page":201,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1323,"text":"Ama Peygamber ve onunla beraber bulunan müminler, mallariyle ve canlariyle savaştılar. İşte iyilikler onlaradır, saadete erişenler de onlardır.","numberInSurah":88,"juz":10,"manzil":2,"page":201,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1324,"text":"Allah onlara temelli kalacakları, içlerinden ırmaklar akan cennetler hazırlamıştır. Büyük kurtuluş budur.","numberInSurah":89,"juz":10,"manzil":2,"page":201,"ruku":166,"hizbQuarter":80,"sajda":false},{"number":1325,"text":"Bedevilerden, izin almak üzere, özür beyan eden kimseler geldiler. Allah'a ve Peygamberine yalan söyleyenler ise, özür bile beyan etmeksizin geri kaldılar. Onlardan kafir olanlar can yakıcı azaba uğrayacaktır.","numberInSurah":90,"juz":10,"manzil":2,"page":201,"ruku":167,"hizbQuarter":80,"sajda":false},{"number":1326,"text":"Güçsüzlere, hastalara ve sarfedecek bir şeyi bulunmayanlara, Allah ve Peygamberine bağlı kaldıkları müddetçe sorumluluk yoktur. İyi davrananlara sorumluluk olmaz. Allah bağışlayandır, merhamet edendir.","numberInSurah":91,"juz":10,"manzil":2,"page":201,"ruku":167,"hizbQuarter":80,"sajda":false},{"number":1327,"text":"Binek vermen için sana geldiklerinde, \"Size binek bulamıyorum\" dediğin zaman, sarfedecek bir şey bulamadıkları için üzüntüden gözyaşı dökerek geri dönenlere de sorumluluk yoktur.","numberInSurah":92,"juz":10,"manzil":2,"page":201,"ruku":167,"hizbQuarter":80,"sajda":false},{"number":1328,"text":"Sorumluluk ancak, zengin oldukları halde senden izin isteyen, geride kalan kadınlarla bulunmaya razı olanlara ve Allah kalblerini mühürlemiş olduğu için bilmeyenleredir.","numberInSurah":93,"juz":11,"manzil":2,"page":201,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1329,"text":"Savaştan döndüğünüzde size özür beyan ederler. Onlara de ki: \"özür beyan etmeyin, size inanmayacağız, Allah haberlerinizi bize bildirmiştir. Allah da, Peygamberi de işleyeceklerinizi görecektir. Sonunda, görülmeyeni ve görüneni bilen Allah'a geri çevrileceksiniz. O, işlediklerinizi size haber verecektir.\"","numberInSurah":94,"juz":11,"manzil":2,"page":202,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1330,"text":"Döndüğünüzde kendilerine çıkışmamanız için, Allah'a yemin edeceklerdir. Siz onlardan yüz çevirin; çünkü pistirler. Yaptıklarının karşılığı olarak varacakları yer cehennemdir.","numberInSurah":95,"juz":11,"manzil":2,"page":202,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1331,"text":"Kendilerinden hoşnut olasınız diye, size and verirler. Siz onlardan hoşnut olsanız bile, Allah, yoldan çıkmış kimselerden razı olmaz.","numberInSurah":96,"juz":11,"manzil":2,"page":202,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1332,"text":"Bedevilerin küfür ve nifakları her yönden, daha ileridir. Allah'ın, Peygamberine indirdiğinin sınırlarını bilmemek, onlara daha layıktır. Allah bilendir, hakimdir.","numberInSurah":97,"juz":11,"manzil":2,"page":202,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1333,"text":"Bedevilerden, Allah yolunda sarfettiklerini angarya sayanlar ve sizin başınıza belalar gelmesini bekleyenler vardır. Belalar onlara olsun; Allah işitir ve bilir.","numberInSurah":98,"juz":11,"manzil":2,"page":202,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1334,"text":"Bedevilerden, Allah'a ve ahiret gününe inanan, sarfettiğini, Allah katında ibadet ve Peygamberin dualarına nail olmağa vesile sayanlar da vardır. Bilin ki, verdikleri onlar için ibadettir. Allah, onlara rahmet edecektir. Allah şüphesiz bağışlar ve merhamet eder.","numberInSurah":99,"juz":11,"manzil":2,"page":202,"ruku":167,"hizbQuarter":81,"sajda":false},{"number":1335,"text":"İyilik yarışında önceliği kazanan Muhacirler ve Ensar ile, onlara güzelce uyanlardan Allah hoşnut olmuştur, onlar da Allah'tan hoşnuddurlar. Allah onlara, içinde temelli ve ebedi kalacakları, içlerinden ırmaklar akan cennetler hazırlamıştır; işte büyük kurtuluş budur.","numberInSurah":100,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1336,"text":"Çevrenizdeki Bedeviler içinde ikiyüzlüler ve Medine'liler içinde de ikiyüzlülükte direnenler vardır. Onları siz değil, ancak Biz biliriz. Kendilerine iki defa azabedeceğiz; onlar sonra da büyük bir azaba uğratılırlar.","numberInSurah":101,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1337,"text":"Savaştan geri kalanların bir kısmı da, suçlarını itiraf ettiler. Onlar iyi işi kötüyle karıştırmışlardı. Allah'ın onların tevbesini kabul etmesi umulur; çünkü O bağışlayandır, merhamet edendir.","numberInSurah":102,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1338,"text":"Mallarının bir kısmını, kendilerini temizleyip arıtacak sadaka olarak al, onlara dua et; senin duan onlar için bir güvendir. Allah işitir ve bilir.","numberInSurah":103,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1339,"text":"Allah'ın, kullarının tevbesini kabul ettiğini, sadakalar aldığını, Allah'ın tevbeleri kabul ve merhamet eden olduğunu bilmiyorlar mı?","numberInSurah":104,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1340,"text":"De ki: \"İstediğinizi işleyin; Allah, Peygamberi ve müminler işlediklerinizi görecektir. Hepiniz, görülmeyeni ve görüleni bilen Allah'a döndürüleceksiniz. O size, işlediklerinizi bildirecektir.\"","numberInSurah":105,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1341,"text":"Savaştan geri kalanların bir kısmının işi de Allah'ın buyruğuna kalmıştır. Allah onlara ya azabeder, ya da tevbelerini kabul eder. O bilendir, hakimdir.","numberInSurah":106,"juz":11,"manzil":2,"page":203,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1342,"text":"Zarar vermek, inkar etmek, müminlerin arasını ayırmak, Allah ve Peygamber'ine karşı savaşanlara daha önceden gözcülük yapmak üzere bir mescid kurup: \"Biz sadece iyilik yapmak istedik\" diye yemin edenlerin yalancı olduklarına şüphesiz ki Allah şahiddir.","numberInSurah":107,"juz":11,"manzil":2,"page":204,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1343,"text":"O mescide hiç girme! İlk gününden beri Allah'a karşı gelmekten sakınmak için kurulan mescidde bulunman daha uygundur. Orada, arınmak isteyen insanlar vardır. Allah, arınmak isteyenleri sever.","numberInSurah":108,"juz":11,"manzil":2,"page":204,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1344,"text":"Yapısını, Allah'tan sakınmak ve Onun hoşnudluğuna ermek için yapan kimse mi daha hayırlıdır; yoksa, yapısını kayacak bir yar kıyısına yapıp da onunla beraber cehennem ateşine yuvarlanan kimse mi? Allah, zulmeden kimselere doğru yolu göstermez.","numberInSurah":109,"juz":11,"manzil":2,"page":204,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1345,"text":"Yaptıkları bina, kalblerinde şüphe ve ızdırap kaynağı olmakta kalbleri paralanana kadar devam edecektir. Allah bilendir, hakimdir.","numberInSurah":110,"juz":11,"manzil":2,"page":204,"ruku":168,"hizbQuarter":81,"sajda":false},{"number":1346,"text":"Allah şüphesiz, Allah yolunda savaşıp, öldüren ve öldürülen müminlerin canlarını ve mallarını Tevrat, İncil ve Kuran'da söz verilmiş bir hak olarak cennete karşılık satın almıştır. Verdiği sözü Allah'tan daha çok tutan kim vardır? Öyleyse, yaptığınız alışverişe sevinin; bu büyük başarıdır.","numberInSurah":111,"juz":11,"manzil":2,"page":204,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1347,"text":"Allah'a tevbe eden, kullukta bulunan, O'nu öven, O'nun uğrunda gezen, rüku ve secde eden, uygun olanı buyurup fenalığı yasak eden ve Allah'ın yasalarını koruyan müminlere de müjdele.","numberInSurah":112,"juz":11,"manzil":2,"page":205,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1348,"text":"Cehennemlik oldukları anlaşıldıktan sonra, akraba bile olsalar, puta tapanlar için mağfiret dilemek Peygamber'e ve müminlere yaraşmaz.","numberInSurah":113,"juz":11,"manzil":2,"page":205,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1349,"text":"İbrahim'in, babası için mağfiret dilemesi, sadece ona verdiği bir sözden ötürü idi.","numberInSurah":114,"juz":11,"manzil":2,"page":205,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1350,"text":"Allah, bir milleti doğru yola eriştirdikten sonra, sakınacakları şeyleri onlara açıklamadıkça, sapıklığa düşürmez. Allah şüphesiz her şeyi bilir.","numberInSurah":115,"juz":11,"manzil":2,"page":205,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1351,"text":"Göklerin ve yerin hükümranlığı elbette Allah'ındır; dirilten ve öldüren O'dur. Allah'tan başka dost ve yardımcınız yoktur.","numberInSurah":116,"juz":11,"manzil":2,"page":205,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1352,"text":"And olsun ki, Allah, sıkıntılı bir zamanda bir kısmının kalbleri kaymak üzere iken Peygamber'e uyan Muhacirlerle Ensarın ve Peygamberin tevbelerini kabul etti. Tevbelerini, onlara karşı şefkatli ve merhametli olduğu için kabul etmiştir.","numberInSurah":117,"juz":11,"manzil":2,"page":205,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1353,"text":"Bütün genişliğine rağmen yer onlara dar gelerek nefisleri kendilerini sıkıştırıp, Allah'tan başka sığınacak kimse olmadığını anlayan, savaştan geri kalmış üç kişinin tevbesini de kabul etti. Allah, tevbe ettikleri için onların tevbesini kabul etmiştir. Çünkü O tevbeleri kabul eden, merhametli olandır.","numberInSurah":118,"juz":11,"manzil":2,"page":206,"ruku":169,"hizbQuarter":82,"sajda":false},{"number":1354,"text":"Ey inananlar! Allah'tan sakının ve doğrularla beraber olun.","numberInSurah":119,"juz":11,"manzil":2,"page":206,"ruku":170,"hizbQuarter":82,"sajda":false},{"number":1355,"text":"Medinelilere ve çevrelerinde bulunan Bedevilere, savaşta Allah'ın Peygamberinden geri kalmak, kendilerini ona tercih etmek yaraşmaz. Çünkü Allah yolunda susuzluğa, yorgunluğa, açlığa uğramak, kafirleri kızdıracak bir yeri işgal etmek ve düşmana başarı kazanmak karşılığında, onların yararlı bir iş yaptıkları mutlaka yazılır. Doğrusu Allah iyilik yapanların ecrini zayi etmez.","numberInSurah":120,"juz":11,"manzil":2,"page":206,"ruku":170,"hizbQuarter":82,"sajda":false},{"number":1356,"text":"Allah, yaptıklarının karşılığını en güzel şekilde kendilerine vermek üzere, az veya çok sarfettikleri her şey, yürüdükleri her yol, onlar için yazılır.","numberInSurah":121,"juz":11,"manzil":2,"page":206,"ruku":170,"hizbQuarter":82,"sajda":false},{"number":1357,"text":"İnananlar toptan savaşa çıkmamalıdır. Her topluluktan bir taifenin dini iyi öğrenmek ve milletlerini geri döndüklerinde uyarmak üzere geri kalmaları gerekli olmaz mı? Ki böylece belki yanlış hareketlerden çekinirler.","numberInSurah":122,"juz":11,"manzil":2,"page":206,"ruku":170,"hizbQuarter":83,"sajda":false},{"number":1358,"text":"Ey inananlar! Yakınınızda bulunan inkarcılarla savaşın; sizi kendilerine karşı sert bulsunlar. Bilin ki Allah, kendisine karşı gelmekten sakınanlarla beraberdir.","numberInSurah":123,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false},{"number":1359,"text":"Bir sure inince, aralarında \"Bu, hanginizin imanını artırdı?\" diyen ikiyüzlüler vardır. İnananların ise imanını artırmıştır; onlar birbirlerine bunu müjdelemek isterler.","numberInSurah":124,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false},{"number":1360,"text":"Kalblerinde hastalık olanların ise pisliklerine pislik katmıştır; onlar kafir olarak ölmüşlerdir.","numberInSurah":125,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false},{"number":1361,"text":"Onlar, yılda bir iki defa belaya uğratılıp imtihana çekildiklerini görmüyorlar mı? Böyleyken yine tevbe etmiyorlar, ibret de almıyorlar.","numberInSurah":126,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false},{"number":1362,"text":"Bir sure inince, \"Sizi bir kimse görüyor mu?\" diye birbirlerine bakarlar, sonra dönüp giderler. Anlamaz bir güruh olmalarına karşılık Allah onların kalblerini imandan döndürmüştür.","numberInSurah":127,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false},{"number":1363,"text":"Ey inananlar! And olsun ki, içinizden size, sıkıntıya uğramanız kendisine ağır gelen, size düşkün, inananlara şefkatli ve merhametli bir peygamber gelmiştir.","numberInSurah":128,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false},{"number":1364,"text":"Eğer yüz çevirirlerse de ki: \"Allah bana yeter; O'ndan başka tanrı yoktur, yalnız O'na güveniyorum; O büyük arşın Rabbidir.\"","numberInSurah":129,"juz":11,"manzil":2,"page":207,"ruku":171,"hizbQuarter":83,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}