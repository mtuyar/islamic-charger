{"arabic":{"number":8,"name":"سُورَةُ الأَنفَالِ","englishName":"Enfâl","englishNameTranslation":"The Spoils of War","revelationType":"Medinan","numberOfAyahs":75,"ayahs":[{"number":1161,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ يَسْأَلُونَكَ عَنِ الْأَنْفَالِ ۖ قُلِ الْأَنْفَالُ لِلَّهِ وَالرَّسُولِ ۖ فَاتَّقُوا اللَّهَ وَأَصْلِحُوا ذَاتَ بَيْنِكُمْ ۖ وَأَطِيعُوا اللَّهَ وَرَسُولَهُ إِنْ كُنْتُمْ مُؤْمِنِينَ","numberInSurah":1,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1162,"text":"إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ إِذَا ذُكِرَ اللَّهُ وَجِلَتْ قُلُوبُهُمْ وَإِذَا تُلِيَتْ عَلَيْهِمْ آيَاتُهُ زَادَتْهُمْ إِيمَانًا وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ","numberInSurah":2,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1163,"text":"الَّذِينَ يُقِيمُونَ الصَّلَاةَ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ","numberInSurah":3,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1164,"text":"أُولَٰئِكَ هُمُ الْمُؤْمِنُونَ حَقًّا ۚ لَهُمْ دَرَجَاتٌ عِنْدَ رَبِّهِمْ وَمَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ","numberInSurah":4,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1165,"text":"كَمَا أَخْرَجَكَ رَبُّكَ مِنْ بَيْتِكَ بِالْحَقِّ وَإِنَّ فَرِيقًا مِنَ الْمُؤْمِنِينَ لَكَارِهُونَ","numberInSurah":5,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1166,"text":"يُجَادِلُونَكَ فِي الْحَقِّ بَعْدَمَا تَبَيَّنَ كَأَنَّمَا يُسَاقُونَ إِلَى الْمَوْتِ وَهُمْ يَنْظُرُونَ","numberInSurah":6,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1167,"text":"وَإِذْ يَعِدُكُمُ اللَّهُ إِحْدَى الطَّائِفَتَيْنِ أَنَّهَا لَكُمْ وَتَوَدُّونَ أَنَّ غَيْرَ ذَاتِ الشَّوْكَةِ تَكُونُ لَكُمْ وَيُرِيدُ اللَّهُ أَنْ يُحِقَّ الْحَقَّ بِكَلِمَاتِهِ وَيَقْطَعَ دَابِرَ الْكَافِرِينَ","numberInSurah":7,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1168,"text":"لِيُحِقَّ الْحَقَّ وَيُبْطِلَ الْبَاطِلَ وَلَوْ كَرِهَ الْمُجْرِمُونَ","numberInSurah":8,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1169,"text":"إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمْ أَنِّي مُمِدُّكُمْ بِأَلْفٍ مِنَ الْمَلَائِكَةِ مُرْدِفِينَ","numberInSurah":9,"juz":9,"manzil":2,"page":178,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1170,"text":"وَمَا جَعَلَهُ اللَّهُ إِلَّا بُشْرَىٰ وَلِتَطْمَئِنَّ بِهِ قُلُوبُكُمْ ۚ وَمَا النَّصْرُ إِلَّا مِنْ عِنْدِ اللَّهِ ۚ إِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ","numberInSurah":10,"juz":9,"manzil":2,"page":178,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1171,"text":"إِذْ يُغَشِّيكُمُ النُّعَاسَ أَمَنَةً مِنْهُ وَيُنَزِّلُ عَلَيْكُمْ مِنَ السَّمَاءِ مَاءً لِيُطَهِّرَكُمْ بِهِ وَيُذْهِبَ عَنْكُمْ رِجْزَ الشَّيْطَانِ وَلِيَرْبِطَ عَلَىٰ قُلُوبِكُمْ وَيُثَبِّتَ بِهِ الْأَقْدَامَ","numberInSurah":11,"juz":9,"manzil":2,"page":178,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1172,"text":"إِذْ يُوحِي رَبُّكَ إِلَى الْمَلَائِكَةِ أَنِّي مَعَكُمْ فَثَبِّتُوا الَّذِينَ آمَنُوا ۚ سَأُلْقِي فِي قُلُوبِ الَّذِينَ كَفَرُوا الرُّعْبَ فَاضْرِبُوا فَوْقَ الْأَعْنَاقِ وَاضْرِبُوا مِنْهُمْ كُلَّ بَنَانٍ","numberInSurah":12,"juz":9,"manzil":2,"page":178,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1173,"text":"ذَٰلِكَ بِأَنَّهُمْ شَاقُّوا اللَّهَ وَرَسُولَهُ ۚ وَمَنْ يُشَاقِقِ اللَّهَ وَرَسُولَهُ فَإِنَّ اللَّهَ شَدِيدُ الْعِقَابِ","numberInSurah":13,"juz":9,"manzil":2,"page":178,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1174,"text":"ذَٰلِكُمْ فَذُوقُوهُ وَأَنَّ لِلْكَافِرِينَ عَذَابَ النَّارِ","numberInSurah":14,"juz":9,"manzil":2,"page":178,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1175,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا لَقِيتُمُ الَّذِينَ كَفَرُوا زَحْفًا فَلَا تُوَلُّوهُمُ الْأَدْبَارَ","numberInSurah":15,"juz":9,"manzil":2,"page":178,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1176,"text":"وَمَنْ يُوَلِّهِمْ يَوْمَئِذٍ دُبُرَهُ إِلَّا مُتَحَرِّفًا لِقِتَالٍ أَوْ مُتَحَيِّزًا إِلَىٰ فِئَةٍ فَقَدْ بَاءَ بِغَضَبٍ مِنَ اللَّهِ وَمَأْوَاهُ جَهَنَّمُ ۖ وَبِئْسَ الْمَصِيرُ","numberInSurah":16,"juz":9,"manzil":2,"page":178,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1177,"text":"فَلَمْ تَقْتُلُوهُمْ وَلَٰكِنَّ اللَّهَ قَتَلَهُمْ ۚ وَمَا رَمَيْتَ إِذْ رَمَيْتَ وَلَٰكِنَّ اللَّهَ رَمَىٰ ۚ وَلِيُبْلِيَ الْمُؤْمِنِينَ مِنْهُ بَلَاءً حَسَنًا ۚ إِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ","numberInSurah":17,"juz":9,"manzil":2,"page":179,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1178,"text":"ذَٰلِكُمْ وَأَنَّ اللَّهَ مُوهِنُ كَيْدِ الْكَافِرِينَ","numberInSurah":18,"juz":9,"manzil":2,"page":179,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1179,"text":"إِنْ تَسْتَفْتِحُوا فَقَدْ جَاءَكُمُ الْفَتْحُ ۖ وَإِنْ تَنْتَهُوا فَهُوَ خَيْرٌ لَكُمْ ۖ وَإِنْ تَعُودُوا نَعُدْ وَلَنْ تُغْنِيَ عَنْكُمْ فِئَتُكُمْ شَيْئًا وَلَوْ كَثُرَتْ وَأَنَّ اللَّهَ مَعَ الْمُؤْمِنِينَ","numberInSurah":19,"juz":9,"manzil":2,"page":179,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1180,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا أَطِيعُوا اللَّهَ وَرَسُولَهُ وَلَا تَوَلَّوْا عَنْهُ وَأَنْتُمْ تَسْمَعُونَ","numberInSurah":20,"juz":9,"manzil":2,"page":179,"ruku":148,"hizbQuarter":71,"sajda":false},{"number":1181,"text":"وَلَا تَكُونُوا كَالَّذِينَ قَالُوا سَمِعْنَا وَهُمْ لَا يَسْمَعُونَ","numberInSurah":21,"juz":9,"manzil":2,"page":179,"ruku":148,"hizbQuarter":71,"sajda":false},{"number":1182,"text":"۞ إِنَّ شَرَّ الدَّوَابِّ عِنْدَ اللَّهِ الصُّمُّ الْبُكْمُ الَّذِينَ لَا يَعْقِلُونَ","numberInSurah":22,"juz":9,"manzil":2,"page":179,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1183,"text":"وَلَوْ عَلِمَ اللَّهُ فِيهِمْ خَيْرًا لَأَسْمَعَهُمْ ۖ وَلَوْ أَسْمَعَهُمْ لَتَوَلَّوْا وَهُمْ مُعْرِضُونَ","numberInSurah":23,"juz":9,"manzil":2,"page":179,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1184,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اسْتَجِيبُوا لِلَّهِ وَلِلرَّسُولِ إِذَا دَعَاكُمْ لِمَا يُحْيِيكُمْ ۖ وَاعْلَمُوا أَنَّ اللَّهَ يَحُولُ بَيْنَ الْمَرْءِ وَقَلْبِهِ وَأَنَّهُ إِلَيْهِ تُحْشَرُونَ","numberInSurah":24,"juz":9,"manzil":2,"page":179,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1185,"text":"وَاتَّقُوا فِتْنَةً لَا تُصِيبَنَّ الَّذِينَ ظَلَمُوا مِنْكُمْ خَاصَّةً ۖ وَاعْلَمُوا أَنَّ اللَّهَ شَدِيدُ الْعِقَابِ","numberInSurah":25,"juz":9,"manzil":2,"page":179,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1186,"text":"وَاذْكُرُوا إِذْ أَنْتُمْ قَلِيلٌ مُسْتَضْعَفُونَ فِي الْأَرْضِ تَخَافُونَ أَنْ يَتَخَطَّفَكُمُ النَّاسُ فَآوَاكُمْ وَأَيَّدَكُمْ بِنَصْرِهِ وَرَزَقَكُمْ مِنَ الطَّيِّبَاتِ لَعَلَّكُمْ تَشْكُرُونَ","numberInSurah":26,"juz":9,"manzil":2,"page":180,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1187,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَخُونُوا اللَّهَ وَالرَّسُولَ وَتَخُونُوا أَمَانَاتِكُمْ وَأَنْتُمْ تَعْلَمُونَ","numberInSurah":27,"juz":9,"manzil":2,"page":180,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1188,"text":"وَاعْلَمُوا أَنَّمَا أَمْوَالُكُمْ وَأَوْلَادُكُمْ فِتْنَةٌ وَأَنَّ اللَّهَ عِنْدَهُ أَجْرٌ عَظِيمٌ","numberInSurah":28,"juz":9,"manzil":2,"page":180,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1189,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا وَيُكَفِّرْ عَنْكُمْ سَيِّئَاتِكُمْ وَيَغْفِرْ لَكُمْ ۗ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ","numberInSurah":29,"juz":9,"manzil":2,"page":180,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1190,"text":"وَإِذْ يَمْكُرُ بِكَ الَّذِينَ كَفَرُوا لِيُثْبِتُوكَ أَوْ يَقْتُلُوكَ أَوْ يُخْرِجُوكَ ۚ وَيَمْكُرُونَ وَيَمْكُرُ اللَّهُ ۖ وَاللَّهُ خَيْرُ الْمَاكِرِينَ","numberInSurah":30,"juz":9,"manzil":2,"page":180,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1191,"text":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ آيَاتُنَا قَالُوا قَدْ سَمِعْنَا لَوْ نَشَاءُ لَقُلْنَا مِثْلَ هَٰذَا ۙ إِنْ هَٰذَا إِلَّا أَسَاطِيرُ الْأَوَّلِينَ","numberInSurah":31,"juz":9,"manzil":2,"page":180,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1192,"text":"وَإِذْ قَالُوا اللَّهُمَّ إِنْ كَانَ هَٰذَا هُوَ الْحَقَّ مِنْ عِنْدِكَ فَأَمْطِرْ عَلَيْنَا حِجَارَةً مِنَ السَّمَاءِ أَوِ ائْتِنَا بِعَذَابٍ أَلِيمٍ","numberInSurah":32,"juz":9,"manzil":2,"page":180,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1193,"text":"وَمَا كَانَ اللَّهُ لِيُعَذِّبَهُمْ وَأَنْتَ فِيهِمْ ۚ وَمَا كَانَ اللَّهُ مُعَذِّبَهُمْ وَهُمْ يَسْتَغْفِرُونَ","numberInSurah":33,"juz":9,"manzil":2,"page":180,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1194,"text":"وَمَا لَهُمْ أَلَّا يُعَذِّبَهُمُ اللَّهُ وَهُمْ يَصُدُّونَ عَنِ الْمَسْجِدِ الْحَرَامِ وَمَا كَانُوا أَوْلِيَاءَهُ ۚ إِنْ أَوْلِيَاؤُهُ إِلَّا الْمُتَّقُونَ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ","numberInSurah":34,"juz":9,"manzil":2,"page":181,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1195,"text":"وَمَا كَانَ صَلَاتُهُمْ عِنْدَ الْبَيْتِ إِلَّا مُكَاءً وَتَصْدِيَةً ۚ فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ","numberInSurah":35,"juz":9,"manzil":2,"page":181,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1196,"text":"إِنَّ الَّذِينَ كَفَرُوا يُنْفِقُونَ أَمْوَالَهُمْ لِيَصُدُّوا عَنْ سَبِيلِ اللَّهِ ۚ فَسَيُنْفِقُونَهَا ثُمَّ تَكُونُ عَلَيْهِمْ حَسْرَةً ثُمَّ يُغْلَبُونَ ۗ وَالَّذِينَ كَفَرُوا إِلَىٰ جَهَنَّمَ يُحْشَرُونَ","numberInSurah":36,"juz":9,"manzil":2,"page":181,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1197,"text":"لِيَمِيزَ اللَّهُ الْخَبِيثَ مِنَ الطَّيِّبِ وَيَجْعَلَ الْخَبِيثَ بَعْضَهُ عَلَىٰ بَعْضٍ فَيَرْكُمَهُ جَمِيعًا فَيَجْعَلَهُ فِي جَهَنَّمَ ۚ أُولَٰئِكَ هُمُ الْخَاسِرُونَ","numberInSurah":37,"juz":9,"manzil":2,"page":181,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1198,"text":"قُلْ لِلَّذِينَ كَفَرُوا إِنْ يَنْتَهُوا يُغْفَرْ لَهُمْ مَا قَدْ سَلَفَ وَإِنْ يَعُودُوا فَقَدْ مَضَتْ سُنَّتُ الْأَوَّلِينَ","numberInSurah":38,"juz":9,"manzil":2,"page":181,"ruku":150,"hizbQuarter":72,"sajda":false},{"number":1199,"text":"وَقَاتِلُوهُمْ حَتَّىٰ لَا تَكُونَ فِتْنَةٌ وَيَكُونَ الدِّينُ كُلُّهُ لِلَّهِ ۚ فَإِنِ انْتَهَوْا فَإِنَّ اللَّهَ بِمَا يَعْمَلُونَ بَصِيرٌ","numberInSurah":39,"juz":9,"manzil":2,"page":181,"ruku":150,"hizbQuarter":72,"sajda":false},{"number":1200,"text":"وَإِنْ تَوَلَّوْا فَاعْلَمُوا أَنَّ اللَّهَ مَوْلَاكُمْ ۚ نِعْمَ الْمَوْلَىٰ وَنِعْمَ النَّصِيرُ","numberInSurah":40,"juz":9,"manzil":2,"page":181,"ruku":150,"hizbQuarter":72,"sajda":false},{"number":1201,"text":"۞ وَاعْلَمُوا أَنَّمَا غَنِمْتُمْ مِنْ شَيْءٍ فَأَنَّ لِلَّهِ خُمُسَهُ وَلِلرَّسُولِ وَلِذِي الْقُرْبَىٰ وَالْيَتَامَىٰ وَالْمَسَاكِينِ وَابْنِ السَّبِيلِ إِنْ كُنْتُمْ آمَنْتُمْ بِاللَّهِ وَمَا أَنْزَلْنَا عَلَىٰ عَبْدِنَا يَوْمَ الْفُرْقَانِ يَوْمَ الْتَقَى الْجَمْعَانِ ۗ وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":41,"juz":10,"manzil":2,"page":182,"ruku":150,"hizbQuarter":73,"sajda":false},{"number":1202,"text":"إِذْ أَنْتُمْ بِالْعُدْوَةِ الدُّنْيَا وَهُمْ بِالْعُدْوَةِ الْقُصْوَىٰ وَالرَّكْبُ أَسْفَلَ مِنْكُمْ ۚ وَلَوْ تَوَاعَدْتُمْ لَاخْتَلَفْتُمْ فِي الْمِيعَادِ ۙ وَلَٰكِنْ لِيَقْضِيَ اللَّهُ أَمْرًا كَانَ مَفْعُولًا لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ وَيَحْيَىٰ مَنْ حَيَّ عَنْ بَيِّنَةٍ ۗ وَإِنَّ اللَّهَ لَسَمِيعٌ عَلِيمٌ","numberInSurah":42,"juz":10,"manzil":2,"page":182,"ruku":150,"hizbQuarter":73,"sajda":false},{"number":1203,"text":"إِذْ يُرِيكَهُمُ اللَّهُ فِي مَنَامِكَ قَلِيلًا ۖ وَلَوْ أَرَاكَهُمْ كَثِيرًا لَفَشِلْتُمْ وَلَتَنَازَعْتُمْ فِي الْأَمْرِ وَلَٰكِنَّ اللَّهَ سَلَّمَ ۗ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","numberInSurah":43,"juz":10,"manzil":2,"page":182,"ruku":150,"hizbQuarter":73,"sajda":false},{"number":1204,"text":"وَإِذْ يُرِيكُمُوهُمْ إِذِ الْتَقَيْتُمْ فِي أَعْيُنِكُمْ قَلِيلًا وَيُقَلِّلُكُمْ فِي أَعْيُنِهِمْ لِيَقْضِيَ اللَّهُ أَمْرًا كَانَ مَفْعُولًا ۗ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","numberInSurah":44,"juz":10,"manzil":2,"page":182,"ruku":150,"hizbQuarter":73,"sajda":false},{"number":1205,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا لَقِيتُمْ فِئَةً فَاثْبُتُوا وَاذْكُرُوا اللَّهَ كَثِيرًا لَعَلَّكُمْ تُفْلِحُونَ","numberInSurah":45,"juz":10,"manzil":2,"page":182,"ruku":151,"hizbQuarter":73,"sajda":false},{"number":1206,"text":"وَأَطِيعُوا اللَّهَ وَرَسُولَهُ وَلَا تَنَازَعُوا فَتَفْشَلُوا وَتَذْهَبَ رِيحُكُمْ ۖ وَاصْبِرُوا ۚ إِنَّ اللَّهَ مَعَ الصَّابِرِينَ","numberInSurah":46,"juz":10,"manzil":2,"page":183,"ruku":151,"hizbQuarter":73,"sajda":false},{"number":1207,"text":"وَلَا تَكُونُوا كَالَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ بَطَرًا وَرِئَاءَ النَّاسِ وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ ۚ وَاللَّهُ بِمَا يَعْمَلُونَ مُحِيطٌ","numberInSurah":47,"juz":10,"manzil":2,"page":183,"ruku":151,"hizbQuarter":73,"sajda":false},{"number":1208,"text":"وَإِذْ زَيَّنَ لَهُمُ الشَّيْطَانُ أَعْمَالَهُمْ وَقَالَ لَا غَالِبَ لَكُمُ الْيَوْمَ مِنَ النَّاسِ وَإِنِّي جَارٌ لَكُمْ ۖ فَلَمَّا تَرَاءَتِ الْفِئَتَانِ نَكَصَ عَلَىٰ عَقِبَيْهِ وَقَالَ إِنِّي بَرِيءٌ مِنْكُمْ إِنِّي أَرَىٰ مَا لَا تَرَوْنَ إِنِّي أَخَافُ اللَّهَ ۚ وَاللَّهُ شَدِيدُ الْعِقَابِ","numberInSurah":48,"juz":10,"manzil":2,"page":183,"ruku":151,"hizbQuarter":73,"sajda":false},{"number":1209,"text":"إِذْ يَقُولُ الْمُنَافِقُونَ وَالَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ غَرَّ هَٰؤُلَاءِ دِينُهُمْ ۗ وَمَنْ يَتَوَكَّلْ عَلَى اللَّهِ فَإِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ","numberInSurah":49,"juz":10,"manzil":2,"page":183,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1210,"text":"وَلَوْ تَرَىٰ إِذْ يَتَوَفَّى الَّذِينَ كَفَرُوا ۙ الْمَلَائِكَةُ يَضْرِبُونَ وُجُوهَهُمْ وَأَدْبَارَهُمْ وَذُوقُوا عَذَابَ الْحَرِيقِ","numberInSurah":50,"juz":10,"manzil":2,"page":183,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1211,"text":"ذَٰلِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ","numberInSurah":51,"juz":10,"manzil":2,"page":183,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1212,"text":"كَدَأْبِ آلِ فِرْعَوْنَ ۙ وَالَّذِينَ مِنْ قَبْلِهِمْ ۚ كَفَرُوا بِآيَاتِ اللَّهِ فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ ۗ إِنَّ اللَّهَ قَوِيٌّ شَدِيدُ الْعِقَابِ","numberInSurah":52,"juz":10,"manzil":2,"page":183,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1213,"text":"ذَٰلِكَ بِأَنَّ اللَّهَ لَمْ يَكُ مُغَيِّرًا نِعْمَةً أَنْعَمَهَا عَلَىٰ قَوْمٍ حَتَّىٰ يُغَيِّرُوا مَا بِأَنْفُسِهِمْ ۙ وَأَنَّ اللَّهَ سَمِيعٌ عَلِيمٌ","numberInSurah":53,"juz":10,"manzil":2,"page":184,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1214,"text":"كَدَأْبِ آلِ فِرْعَوْنَ ۙ وَالَّذِينَ مِنْ قَبْلِهِمْ ۚ كَذَّبُوا بِآيَاتِ رَبِّهِمْ فَأَهْلَكْنَاهُمْ بِذُنُوبِهِمْ وَأَغْرَقْنَا آلَ فِرْعَوْنَ ۚ وَكُلٌّ كَانُوا ظَالِمِينَ","numberInSurah":54,"juz":10,"manzil":2,"page":184,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1215,"text":"إِنَّ شَرَّ الدَّوَابِّ عِنْدَ اللَّهِ الَّذِينَ كَفَرُوا فَهُمْ لَا يُؤْمِنُونَ","numberInSurah":55,"juz":10,"manzil":2,"page":184,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1216,"text":"الَّذِينَ عَاهَدْتَ مِنْهُمْ ثُمَّ يَنْقُضُونَ عَهْدَهُمْ فِي كُلِّ مَرَّةٍ وَهُمْ لَا يَتَّقُونَ","numberInSurah":56,"juz":10,"manzil":2,"page":184,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1217,"text":"فَإِمَّا تَثْقَفَنَّهُمْ فِي الْحَرْبِ فَشَرِّدْ بِهِمْ مَنْ خَلْفَهُمْ لَعَلَّهُمْ يَذَّكَّرُونَ","numberInSurah":57,"juz":10,"manzil":2,"page":184,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1218,"text":"وَإِمَّا تَخَافَنَّ مِنْ قَوْمٍ خِيَانَةً فَانْبِذْ إِلَيْهِمْ عَلَىٰ سَوَاءٍ ۚ إِنَّ اللَّهَ لَا يُحِبُّ الْخَائِنِينَ","numberInSurah":58,"juz":10,"manzil":2,"page":184,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1219,"text":"وَلَا يَحْسَبَنَّ الَّذِينَ كَفَرُوا سَبَقُوا ۚ إِنَّهُمْ لَا يُعْجِزُونَ","numberInSurah":59,"juz":10,"manzil":2,"page":184,"ruku":153,"hizbQuarter":73,"sajda":false},{"number":1220,"text":"وَأَعِدُّوا لَهُمْ مَا اسْتَطَعْتُمْ مِنْ قُوَّةٍ وَمِنْ رِبَاطِ الْخَيْلِ تُرْهِبُونَ بِهِ عَدُوَّ اللَّهِ وَعَدُوَّكُمْ وَآخَرِينَ مِنْ دُونِهِمْ لَا تَعْلَمُونَهُمُ اللَّهُ يَعْلَمُهُمْ ۚ وَمَا تُنْفِقُوا مِنْ شَيْءٍ فِي سَبِيلِ اللَّهِ يُوَفَّ إِلَيْكُمْ وَأَنْتُمْ لَا تُظْلَمُونَ","numberInSurah":60,"juz":10,"manzil":2,"page":184,"ruku":153,"hizbQuarter":73,"sajda":false},{"number":1221,"text":"۞ وَإِنْ جَنَحُوا لِلسَّلْمِ فَاجْنَحْ لَهَا وَتَوَكَّلْ عَلَى اللَّهِ ۚ إِنَّهُ هُوَ السَّمِيعُ الْعَلِيمُ","numberInSurah":61,"juz":10,"manzil":2,"page":184,"ruku":153,"hizbQuarter":74,"sajda":false},{"number":1222,"text":"وَإِنْ يُرِيدُوا أَنْ يَخْدَعُوكَ فَإِنَّ حَسْبَكَ اللَّهُ ۚ هُوَ الَّذِي أَيَّدَكَ بِنَصْرِهِ وَبِالْمُؤْمِنِينَ","numberInSurah":62,"juz":10,"manzil":2,"page":185,"ruku":153,"hizbQuarter":74,"sajda":false},{"number":1223,"text":"وَأَلَّفَ بَيْنَ قُلُوبِهِمْ ۚ لَوْ أَنْفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ وَلَٰكِنَّ اللَّهَ أَلَّفَ بَيْنَهُمْ ۚ إِنَّهُ عَزِيزٌ حَكِيمٌ","numberInSurah":63,"juz":10,"manzil":2,"page":185,"ruku":153,"hizbQuarter":74,"sajda":false},{"number":1224,"text":"يَا أَيُّهَا النَّبِيُّ حَسْبُكَ اللَّهُ وَمَنِ اتَّبَعَكَ مِنَ الْمُؤْمِنِينَ","numberInSurah":64,"juz":10,"manzil":2,"page":185,"ruku":153,"hizbQuarter":74,"sajda":false},{"number":1225,"text":"يَا أَيُّهَا النَّبِيُّ حَرِّضِ الْمُؤْمِنِينَ عَلَى الْقِتَالِ ۚ إِنْ يَكُنْ مِنْكُمْ عِشْرُونَ صَابِرُونَ يَغْلِبُوا مِائَتَيْنِ ۚ وَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ يَغْلِبُوا أَلْفًا مِنَ الَّذِينَ كَفَرُوا بِأَنَّهُمْ قَوْمٌ لَا يَفْقَهُونَ","numberInSurah":65,"juz":10,"manzil":2,"page":185,"ruku":154,"hizbQuarter":74,"sajda":false},{"number":1226,"text":"الْآنَ خَفَّفَ اللَّهُ عَنْكُمْ وَعَلِمَ أَنَّ فِيكُمْ ضَعْفًا ۚ فَإِنْ يَكُنْ مِنْكُمْ مِائَةٌ صَابِرَةٌ يَغْلِبُوا مِائَتَيْنِ ۚ وَإِنْ يَكُنْ مِنْكُمْ أَلْفٌ يَغْلِبُوا أَلْفَيْنِ بِإِذْنِ اللَّهِ ۗ وَاللَّهُ مَعَ الصَّابِرِينَ","numberInSurah":66,"juz":10,"manzil":2,"page":185,"ruku":154,"hizbQuarter":74,"sajda":false},{"number":1227,"text":"مَا كَانَ لِنَبِيٍّ أَنْ يَكُونَ لَهُ أَسْرَىٰ حَتَّىٰ يُثْخِنَ فِي الْأَرْضِ ۚ تُرِيدُونَ عَرَضَ الدُّنْيَا وَاللَّهُ يُرِيدُ الْآخِرَةَ ۗ وَاللَّهُ عَزِيزٌ حَكِيمٌ","numberInSurah":67,"juz":10,"manzil":2,"page":185,"ruku":154,"hizbQuarter":74,"sajda":false},{"number":1228,"text":"لَوْلَا كِتَابٌ مِنَ اللَّهِ سَبَقَ لَمَسَّكُمْ فِيمَا أَخَذْتُمْ عَذَابٌ عَظِيمٌ","numberInSurah":68,"juz":10,"manzil":2,"page":185,"ruku":154,"hizbQuarter":74,"sajda":false},{"number":1229,"text":"فَكُلُوا مِمَّا غَنِمْتُمْ حَلَالًا طَيِّبًا ۚ وَاتَّقُوا اللَّهَ ۚ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","numberInSurah":69,"juz":10,"manzil":2,"page":185,"ruku":154,"hizbQuarter":74,"sajda":false},{"number":1230,"text":"يَا أَيُّهَا النَّبِيُّ قُلْ لِمَنْ فِي أَيْدِيكُمْ مِنَ الْأَسْرَىٰ إِنْ يَعْلَمِ اللَّهُ فِي قُلُوبِكُمْ خَيْرًا يُؤْتِكُمْ خَيْرًا مِمَّا أُخِذَ مِنْكُمْ وَيَغْفِرْ لَكُمْ ۗ وَاللَّهُ غَفُورٌ رَحِيمٌ","numberInSurah":70,"juz":10,"manzil":2,"page":186,"ruku":155,"hizbQuarter":74,"sajda":false},{"number":1231,"text":"وَإِنْ يُرِيدُوا خِيَانَتَكَ فَقَدْ خَانُوا اللَّهَ مِنْ قَبْلُ فَأَمْكَنَ مِنْهُمْ ۗ وَاللَّهُ عَلِيمٌ حَكِيمٌ","numberInSurah":71,"juz":10,"manzil":2,"page":186,"ruku":155,"hizbQuarter":74,"sajda":false},{"number":1232,"text":"إِنَّ الَّذِينَ آمَنُوا وَهَاجَرُوا وَجَاهَدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ فِي سَبِيلِ اللَّهِ وَالَّذِينَ آوَوْا وَنَصَرُوا أُولَٰئِكَ بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ ۚ وَالَّذِينَ آمَنُوا وَلَمْ يُهَاجِرُوا مَا لَكُمْ مِنْ وَلَايَتِهِمْ مِنْ شَيْءٍ حَتَّىٰ يُهَاجِرُوا ۚ وَإِنِ اسْتَنْصَرُوكُمْ فِي الدِّينِ فَعَلَيْكُمُ النَّصْرُ إِلَّا عَلَىٰ قَوْمٍ بَيْنَكُمْ وَبَيْنَهُمْ مِيثَاقٌ ۗ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","numberInSurah":72,"juz":10,"manzil":2,"page":186,"ruku":155,"hizbQuarter":74,"sajda":false},{"number":1233,"text":"وَالَّذِينَ كَفَرُوا بَعْضُهُمْ أَوْلِيَاءُ بَعْضٍ ۚ إِلَّا تَفْعَلُوهُ تَكُنْ فِتْنَةٌ فِي الْأَرْضِ وَفَسَادٌ كَبِيرٌ","numberInSurah":73,"juz":10,"manzil":2,"page":186,"ruku":155,"hizbQuarter":74,"sajda":false},{"number":1234,"text":"وَالَّذِينَ آمَنُوا وَهَاجَرُوا وَجَاهَدُوا فِي سَبِيلِ اللَّهِ وَالَّذِينَ آوَوْا وَنَصَرُوا أُولَٰئِكَ هُمُ الْمُؤْمِنُونَ حَقًّا ۚ لَهُمْ مَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ","numberInSurah":74,"juz":10,"manzil":2,"page":186,"ruku":155,"hizbQuarter":74,"sajda":false},{"number":1235,"text":"وَالَّذِينَ آمَنُوا مِنْ بَعْدُ وَهَاجَرُوا وَجَاهَدُوا مَعَكُمْ فَأُولَٰئِكَ مِنْكُمْ ۚ وَأُولُو الْأَرْحَامِ بَعْضُهُمْ أَوْلَىٰ بِبَعْضٍ فِي كِتَابِ اللَّهِ ۗ إِنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ","numberInSurah":75,"juz":10,"manzil":2,"page":186,"ruku":155,"hizbQuarter":74,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":8,"name":"سُورَةُ الأَنفَالِ","englishName":"Enfâl","englishNameTranslation":"The Spoils of War","revelationType":"Medinan","numberOfAyahs":75,"ayahs":[{"number":1161,"text":"Sana, ganimetlere dair soru sorarlar, de ki: Ganimetler Allah'ın ve Peygamberindir. İnanıyorsanız Allah'tan sakının, aranızdaki münasebetleri düzeltin, Allah'a ve Peygamberine itaat edin.","numberInSurah":1,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1162,"text":"İnananlar ancak, o kimselerdir ki Allah anıldığı zaman kalbleri titrer, ayetleri okunduğu zaman bu onların imanlarını artırır. Ve Rablerine güvenirler; namaz kılarlar; kendilerine verdiğimiz rızıktan yerli yerince sarf ederler.","numberInSurah":2,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1163,"text":"İnananlar ancak, o kimselerdir ki Allah anıldığı zaman kalbleri titrer, ayetleri okunduğu zaman bu onların imanlarını artırır. Ve Rablerine güvenirler; namaz kılarlar; kendilerine verdiğimiz rızıktan yerli yerince sarf ederler.","numberInSurah":3,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1164,"text":"İşte gerçekten inanmış olanlar bunlardır. Onlara Rablerinin katında mertebeler, mağfiret ve cömertçe verilmiş rızıklar vardır.","numberInSurah":4,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1165,"text":"Nitekim, Rabbin seni hak uğrunda evinden savaş için çıkarmıştı, oysa müslümanların bir takımı bundan hoşlanmamıştı.","numberInSurah":5,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1166,"text":"Sanki göz göre göre ölüme sürükleniyorlarmış gibi, gerçek ortaya çıktıktan sonra bile seninle tartışıyorlardı.","numberInSurah":6,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1167,"text":"Allah bu iki taifeden birini size vadetmişti; siz, kuvvetsiz olanın size düşmesini istiyordunuz. Oysa, suçluların hoşuna gitmese de, hakkı ortaya çıkarmak ve batılı tepelemek için, Allah sözleriyle hakkı ortaya koymak ve inkarcıların kökünü kesmek istiyordu.","numberInSurah":7,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1168,"text":"Allah bu iki taifeden birini size vadetmişti; siz, kuvvetsiz olanın size düşmesini istiyordunuz. Oysa, suçluların hoşuna gitmese de, hakkı ortaya çıkarmak ve batılı tepelemek için, Allah sözleriyle hakkı ortaya koymak ve inkarcıların kökünü kesmek istiyordu.","numberInSurah":8,"juz":9,"manzil":2,"page":177,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1169,"text":"Rabbinizin yardımına sığınıyordunuz. O, \"Ben size, birbiri peşinden bin melekle yardım ederim\" diye cevap vermişti.","numberInSurah":9,"juz":9,"manzil":2,"page":178,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1170,"text":"Allah bunu ancak bir müjde olması ve kalblerinizin yatışması için yapmıştı. Yardım ancak Allah katındandır. Doğrusu Allah güçlüdür, hakimdir.","numberInSurah":10,"juz":9,"manzil":2,"page":178,"ruku":146,"hizbQuarter":71,"sajda":false},{"number":1171,"text":"Allah kendi katından bir güven işareti olarak sizi hafif bir uykuya daldırmıştı. Sizi arıtmak, sizden şeytan vesvesesini gidermek, kalblerinizi pekiştirmek ve sebatınızı artırmak için gökten size su indirmişti.","numberInSurah":11,"juz":9,"manzil":2,"page":178,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1172,"text":"Rabbin meleklere, \"Ben sizinleyim, inananları destekleyin\" diye vahyetti. \"Ben inkar edenlerin kalblerine korku salacağım, artık vurun onların boyunları üstüne, vurun her parmağına\" dedi.","numberInSurah":12,"juz":9,"manzil":2,"page":178,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1173,"text":"Bu, onların Allah'a ve Peygamberine karşı koymalarındandır. Kim Allah'a ve peygamberine karşı koyarsa, bilsin ki, Allah'ın cezası şiddetlidir.","numberInSurah":13,"juz":9,"manzil":2,"page":178,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1174,"text":"İşte bunu tadın, inkar edenlere cehennem azabı da vardır.","numberInSurah":14,"juz":9,"manzil":2,"page":178,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1175,"text":"Ey İnananlar! Savaş için ilerlerken, inkar edenlerle toplu halde karşılaştığınızda onlara arkanızı dönmeyin.","numberInSurah":15,"juz":9,"manzil":2,"page":178,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1176,"text":"Tekrar savaşmak için bir tarafa çekilmek veya bir başka topluluğa katılmak maksadı dışında, o gün arkasını düşmana dönen kimse Allah'dan bir gazaba uğramış olur. Onun varacağı yer cehennemdir. Ne kötü bir dönüştür!","numberInSurah":16,"juz":9,"manzil":2,"page":178,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1177,"text":"Onları siz öldürmediniz fakat Allah öldürdü. Attığın zaman da sen atmamıştın, fakat Allah atmıştı. Allah bunu, inananları güzel bir imtihana tabi tutmak için yapmıştı. Doğrusu O işitir ve bilir.","numberInSurah":17,"juz":9,"manzil":2,"page":179,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1178,"text":"İşte bu, Allah'ın inkarcıların düzenini zayıflatıp yok etmesidir.","numberInSurah":18,"juz":9,"manzil":2,"page":179,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1179,"text":"Ey inkarcılar! Zafer istiyorsanız, işte zafer geldi (aleyhinize çıktı). Peygambere karşı gelmekten vazgeçerseniz sizin iyiliğinize olur, yok tekrar dönerseniz biz de döneriz; topluluğunuz çok da olsa size hiçbir fayda vermez. Allah inananlarla beraberdir.","numberInSurah":19,"juz":9,"manzil":2,"page":179,"ruku":147,"hizbQuarter":71,"sajda":false},{"number":1180,"text":"Ey inananlar! Allah'a ve Peygamberine itaat edin, Kuran'ı dinleyip dururken yüz çevirmeyin, dinlemedikleri halde \"dinledik\" diyenler gibi olmayın.","numberInSurah":20,"juz":9,"manzil":2,"page":179,"ruku":148,"hizbQuarter":71,"sajda":false},{"number":1181,"text":"Ey inananlar! Allah'a ve Peygamberine itaat edin, Kuran'ı dinleyip dururken yüz çevirmeyin, dinlemedikleri halde \"dinledik\" diyenler gibi olmayın.","numberInSurah":21,"juz":9,"manzil":2,"page":179,"ruku":148,"hizbQuarter":71,"sajda":false},{"number":1182,"text":"Allah katında, yeryüzündeki canlıların en kötüsü gerçeği akletmeyen sağırlar ve dilsizlerdir.","numberInSurah":22,"juz":9,"manzil":2,"page":179,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1183,"text":"Allah onlarda bir iyilik görseydi onlara işittirirdi. Onlara işittirmiş olsaydı yine de yüz çevirirlerdi, zaten dönektirler.","numberInSurah":23,"juz":9,"manzil":2,"page":179,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1184,"text":"Ey inananlar! Allah ve Peygamber, sizi, hayat verecek şeye çağırdığı zaman icabet edin. Allah'ın kişi ile kalbi arasına girdiğini ve sonunda O'nun katında toplanacağınızı bilin.","numberInSurah":24,"juz":9,"manzil":2,"page":179,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1185,"text":"Aranızdan yalnız zalimlere erişmekle kalmayacak fitneden sakının, Allah'ın azabının şiddetli olduğunu bilin.","numberInSurah":25,"juz":9,"manzil":2,"page":179,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1186,"text":"Yeryüzünde az sayıda olduğunuz ve zayıf sayıldığınız için insanların sizi esir olarak alıp götürmesinden korktuğunuz zamanları, hatırlayın. Allah, şükredesiniz diye sizi barındırmış, yardımıyla desteklemiş, temiz şeylerle rızıklandırmıştır.","numberInSurah":26,"juz":9,"manzil":2,"page":180,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1187,"text":"Ey inananlar! Allah'a ve Peygambere karşı hainlik etmeyin, size güvenilen şeylere bile bile hıyanet etmiş olursunuz.","numberInSurah":27,"juz":9,"manzil":2,"page":180,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1188,"text":"Mallarınızın ve çocuklarınızın, aslında bir sınama olduğunu ve büyük ecrin Allah katında bulunduğunu bilin.","numberInSurah":28,"juz":9,"manzil":2,"page":180,"ruku":148,"hizbQuarter":72,"sajda":false},{"number":1189,"text":"Ey inananlar! Allah'tan sakınırsanız, O size iyiyi kötüden ayırdedecek bir anlayış verir, kötülüklerinizi örter, sizi bağışlar. Allah büyük, bol nimet sahibidir.","numberInSurah":29,"juz":9,"manzil":2,"page":180,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1190,"text":"İnkar edenler, seni bağlayıp bir yere kapamak veya öldürmek, ya da sürmek için düzen kuruyorlardı. Onlar düzen kurarken, Allah da düzenlerini bozuyordu. Allah düzen yapanların en iyisidir.","numberInSurah":30,"juz":9,"manzil":2,"page":180,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1191,"text":"Ayetlerimiz onlara okunduğu zaman, \"İşittik, işittik! İstesek biz de aynını söyleyebiliriz; bu sadece eskilerin masallarıdır\" derlerdi.","numberInSurah":31,"juz":9,"manzil":2,"page":180,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1192,"text":"\"Allah'ımız! Eğer bu Kitap, gerçekten Senin katından ise bize gökten taş yağdır veya can yakıcı bir azab ver\" demişlerdi.","numberInSurah":32,"juz":9,"manzil":2,"page":180,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1193,"text":"Oysa, sen içlerinde iken Allah onlara azabetmez. Onlar bağışlanma dilerlerken de elbette Allah azab edecek değildir.","numberInSurah":33,"juz":9,"manzil":2,"page":180,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1194,"text":"Yoksa Mescidi Haram'a girmekten menederlerken Allah onlara niçin azab etmesin? Hem de O'nun dostu değiller; O'nun dostları ancak karşı gelmekten sakınanlardır. Fakat çoğu bunu bilmiyorlar.","numberInSurah":34,"juz":9,"manzil":2,"page":181,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1195,"text":"Kabe'deki tapınmaları sadece ıslık çalmak ve el çırpmaktan başka bir şey değildir. İnkarınıza karşılık artık azabı tadın.","numberInSurah":35,"juz":9,"manzil":2,"page":181,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1196,"text":"Doğrusu inkar edenler mallarını Allah'ın yolundan insanları alıkoymak için sarfederler ve daha da sarfedeceklerdir; ama sonra içleri yanacak, hem de mağlup olacaklardır. Bu, Allah'ın, temizi murdardan ayırması ve murdarları üstüste koyup hepsini yığarak cehenneme yerleştirmesi içindir; inkar edenler cehenneme toplanacaklardır. İşte onlar mahvolanlardır.","numberInSurah":36,"juz":9,"manzil":2,"page":181,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1197,"text":"Doğrusu inkar edenler mallarını Allah'ın yolundan insanları alıkoymak için sarfederler ve daha da sarfedeceklerdir; ama sonra içleri yanacak, hem de mağlup olacaklardır. Bu, Allah'ın, temizi murdardan ayırması ve murdarları üstüste koyup hepsini yığarak cehenneme yerleştirmesi içindir; inkar edenler cehenneme toplanacaklardır. İşte onlar mahvolanlardır.","numberInSurah":37,"juz":9,"manzil":2,"page":181,"ruku":149,"hizbQuarter":72,"sajda":false},{"number":1198,"text":"İnkar edenlere, eğer savaştan vazgeçerlerse, geçmişlerinin bağışlanacağını ve tekrar başlarlarsa evvelkilerin hükmünün uygulanacağını söyle.","numberInSurah":38,"juz":9,"manzil":2,"page":181,"ruku":150,"hizbQuarter":72,"sajda":false},{"number":1199,"text":"Fitne kalmayıp, yalnız Allah'ın dini kalana kadar onlarla savaşın. Eğer vazgeçerlerse bilsinler ki Allah onların işlediklerini şüphesiz görür.","numberInSurah":39,"juz":9,"manzil":2,"page":181,"ruku":150,"hizbQuarter":72,"sajda":false},{"number":1200,"text":"Eğer yüz çevirirlerse Allah'ın sizin dostunuz olduğunu bilin; O ne güzel dost, ne güzel yardımcıdır!","numberInSurah":40,"juz":9,"manzil":2,"page":181,"ruku":150,"hizbQuarter":72,"sajda":false},{"number":1201,"text":"Eğer Allah'a ve hakkı batıldan ayıran o günde, iki topluluğun karşılaştığı günde kulumuza indirdiğimize inanıyorsanız, bilin ki, ele geçirdiğiniz ganimetin beşte biri Allah'ın, Peygamber'in ve yakınlarının, yetimlerin, düşkünlerin ve yolcularındır. Allah her şeye Kadir'dir.","numberInSurah":41,"juz":10,"manzil":2,"page":182,"ruku":150,"hizbQuarter":73,"sajda":false},{"number":1202,"text":"Siz vadiye en yakın ve onlar da en uzak yamaçta idiler; kervanın süvarileri sizden daha aşağıdaydı. Savaş için buluşmak üzere sözleşmeye kalksaydınız, vaktini tayinde anlaşmazlığa düşerdiniz; fakat Allah mahvolan, apaçık belgeden ötürü mahvolsun, yaşayan da apaçık belgeden ötürü yaşasın diye olacak işi yaptı. Doğrusu Allah işitir ve bilir.","numberInSurah":42,"juz":10,"manzil":2,"page":182,"ruku":150,"hizbQuarter":73,"sajda":false},{"number":1203,"text":"Allah onları uykunda sana az gösteriyordu. Çok göstermiş olsaydı, yılacak ve bu hususta çekişmeye başlıyacaktınız, fakat Allah sizi kurtardı; çünkü O kalblerde olanı bilir.","numberInSurah":43,"juz":10,"manzil":2,"page":182,"ruku":150,"hizbQuarter":73,"sajda":false},{"number":1204,"text":"Karşılaştığınızda, olacak işi oldurmak için, onları gözlerinize az gösteriyor ve sizi de onların gözünde azaltıyordu. Bütün işler dönüp Allah'a varır.","numberInSurah":44,"juz":10,"manzil":2,"page":182,"ruku":150,"hizbQuarter":73,"sajda":false},{"number":1205,"text":"Ey inananlar! Bir toplulukla karşılaşırsanız dayanın; başarıya erişebilmeniz için Allah'ı çok anın.","numberInSurah":45,"juz":10,"manzil":2,"page":182,"ruku":151,"hizbQuarter":73,"sajda":false},{"number":1206,"text":"Allah'a ve Peygamberine itaat edin; çekişmeyin, yoksa korkar başarısızlığa düşersiniz ve kuvvetiniz gider. Sabredin, doğrusu Allah sabredenlerle beraberdir.","numberInSurah":46,"juz":10,"manzil":2,"page":183,"ruku":151,"hizbQuarter":73,"sajda":false},{"number":1207,"text":"Yurtlarından böbürlenerek, insanlara gösteriş yaparak çıkan ve Allah yolundan men edenler gibi olmayın. Allah onların işlediklerini her yönüyle bilendir.","numberInSurah":47,"juz":10,"manzil":2,"page":183,"ruku":151,"hizbQuarter":73,"sajda":false},{"number":1208,"text":"Şeytan onlara işlediklerini güzel gösterdi ve \"Bugün insanlardan sizi yenecek kimse yoktur; doğrusu ben de size yardımcıyım\" dedi. İki ordu karşılaşınca da, geri dönüp, \"Benim sizinle ilgim yok; doğrusu sizin görmediğinizi ben görüyorum ve şüphesiz Allah'tan korkuyorum, Allah'ın azabı şiddetlidir\" dedi.","numberInSurah":48,"juz":10,"manzil":2,"page":183,"ruku":151,"hizbQuarter":73,"sajda":false},{"number":1209,"text":"İkiyüzlüler ve kalblerinde hastalık bulunanlar \"Müslümanları dinleri aldattı\" diyorlardı; oysa, kim Allah'a güvenirse bilmelidir ki Allah güçlüdür, hakimdir.","numberInSurah":49,"juz":10,"manzil":2,"page":183,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1210,"text":"Melekler, inkar edenlerin yüzlerine ve sırtlarına vurarak, \"Yakıcı azabı tadın, bu, kendi ellerinizle yaptığınızın karşılığıdır\" diyerek canlarını alırken bir görseydin! Yoksa Allah kullara asla zulmetmez.","numberInSurah":50,"juz":10,"manzil":2,"page":183,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1211,"text":"Melekler, inkar edenlerin yüzlerine ve sırtlarına vurarak, \"Yakıcı azabı tadın, bu, kendi ellerinizle yaptığınızın karşılığıdır\" diyerek canlarını alırken bir görseydin! Yoksa Allah kullara asla zulmetmez.","numberInSurah":51,"juz":10,"manzil":2,"page":183,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1212,"text":"Firavun taifesi ve onlardan öncekilerin gidişi gibi, Allah'ın ayetlerini yalanladılar da Allah onları günahlarından ötürü yoketti. Allah kuvvetlidir, cezalandırması şiddetlidir.","numberInSurah":52,"juz":10,"manzil":2,"page":183,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1213,"text":"Bu, bir topluluk iyi gidişini değiştirmedikçe Allah'ın da verdiği nimeti değiştirmeyeceğinden ve Allah'ın işiten, bilen olmasındandır.","numberInSurah":53,"juz":10,"manzil":2,"page":184,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1214,"text":"Firavun taifesi ve onlardan öncekilerin gidişi gibi, Rablerinin ayetlerini yalanladılar da onları günahlarından ötürü yok ettik. Firavun taifesini suda boğduk, hepsi zalimlerdi.","numberInSurah":54,"juz":10,"manzil":2,"page":184,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1215,"text":"Allah katında yeryüzünde yaşayanların en kötüsü, inkar edenlerdir. Onlar artık inanmazlar.","numberInSurah":55,"juz":10,"manzil":2,"page":184,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1216,"text":"Anlaşma yaptığın kimseler, sonucundan sakınmayarak anlaşmalarını her defasında bozarlar. Savaşta onları yakalarsan, arkalarındakilere ibret olacak şekilde, darmadağın et.","numberInSurah":56,"juz":10,"manzil":2,"page":184,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1217,"text":"Anlaşma yaptığın kimseler, sonucundan sakınmayarak anlaşmalarını her defasında bozarlar. Savaşta onları yakalarsan, arkalarındakilere ibret olacak şekilde, darmadağın et.","numberInSurah":57,"juz":10,"manzil":2,"page":184,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1218,"text":"Eğer bir topluluğun anlaşmaya hıyanet etmesinden korkarsan, sen de onlara karşı anlaşmayı bozarak aynı şekilde davran. Doğrusu Allah hainleri sevmez.","numberInSurah":58,"juz":10,"manzil":2,"page":184,"ruku":152,"hizbQuarter":73,"sajda":false},{"number":1219,"text":"İnkar edenler, asla öne geçtiklerini sanmasınlar, çünkü onlar bizi aciz bırakamıyacaklardır.","numberInSurah":59,"juz":10,"manzil":2,"page":184,"ruku":153,"hizbQuarter":73,"sajda":false},{"number":1220,"text":"Ey inananlar! Onlara karşı gücünüzün yettiği kadar Allah'ın düşmanı ve sizin düşmanlarınızı ve bunların dışında Allah'ın bilip sizin bilmediklerinizi yıldırmak üzere kuvvet ve savaş atları hazırlayın. Allah yolunda sarfettiğiniz her şey size haksızlık yapılmadan, tamamen ödenecektir.","numberInSurah":60,"juz":10,"manzil":2,"page":184,"ruku":153,"hizbQuarter":73,"sajda":false},{"number":1221,"text":"Eğer onlar barışa yanaşırlarsa, sen de yanaş ve Allah'a güven. O, şüphesiz işitir ve bilir.","numberInSurah":61,"juz":10,"manzil":2,"page":184,"ruku":153,"hizbQuarter":74,"sajda":false},{"number":1222,"text":"Seni aldatmak isterlerse, bil ki şüphesiz Allah sana kafidir. Seni ve inananları yardımıyla destekleyen, kalblerini uzlaştıran O'dur. Eğer yeryüzünde olan her şeyi sarfetsen bile, sen onların kalblerini uzlaştıramazdın, ama Allah onları uzlaştırdı. Doğrusu O Güçlü'dür, Hakim'dir.","numberInSurah":62,"juz":10,"manzil":2,"page":185,"ruku":153,"hizbQuarter":74,"sajda":false},{"number":1223,"text":"Seni aldatmak isterlerse, bil ki şüphesiz Allah sana kafidir. Seni ve inananları yardımıyla destekleyen, kalblerini uzlaştıran O'dur. Eğer yeryüzünde olan her şeyi sarfetsen bile, sen onların kalblerini uzlaştıramazdın, ama Allah onları uzlaştırdı. Doğrusu O Güçlü'dür, Hakim'dir.","numberInSurah":63,"juz":10,"manzil":2,"page":185,"ruku":153,"hizbQuarter":74,"sajda":false},{"number":1224,"text":"Allah'ın yardımı sana ve sana uyan müminlere yeter.","numberInSurah":64,"juz":10,"manzil":2,"page":185,"ruku":153,"hizbQuarter":74,"sajda":false},{"number":1225,"text":"Müminleri savaş için coştur. Sizin sabırlı yirmi kişiniz onlardan ikiyüz kişiyi yener. Sizin yüz kişiniz, inkar edenlerden bin kişiyi yener; çünkü onlar anlayışsız bir güruhtur. Şimdi Allah yükünüzü hafifletti, zira içinizde zaaf bulunduğunu biliyordu. Sizin sabırlı yüz kişiniz onlardan ikiyüz kişiyi yener; sizin bin kişiniz, Allah'ın izniyle, ikibin kişiyi yener. Allah sabredenlerle beraberdir.","numberInSurah":65,"juz":10,"manzil":2,"page":185,"ruku":154,"hizbQuarter":74,"sajda":false},{"number":1226,"text":"Müminleri savaş için coştur. Sizin sabırlı yirmi kişiniz onlardan ikiyüz kişiyi yener. Sizin yüz kişiniz, inkar edenlerden bin kişiyi yener; çünkü onlar anlayışsız bir güruhtur. Şimdi Allah yükünüzü hafifletti, zira içinizde zaaf bulunduğunu biliyordu. Sizin sabırlı yüz kişiniz onlardan ikiyüz kişiyi yener; sizin bin kişiniz, Allah'ın izniyle, ikibin kişiyi yener. Allah sabredenlerle beraberdir.","numberInSurah":66,"juz":10,"manzil":2,"page":185,"ruku":154,"hizbQuarter":74,"sajda":false},{"number":1227,"text":"Yeryüzünde savaşırken, düşmanı yere sermeden esir almak hiçbir peygambere yaraşmaz. Geçici dünya malını istiyorsunuz, oysa Allah ahireti kazanmanızı ister. Allah Güçlü'dür, Hakim'dir.","numberInSurah":67,"juz":10,"manzil":2,"page":185,"ruku":154,"hizbQuarter":74,"sajda":false},{"number":1228,"text":"Daha önceden Allah'tan verilmiş bir hüküm olmasaydı, aldıklarınızdan ötürü size büyük bir azab erişirdi.","numberInSurah":68,"juz":10,"manzil":2,"page":185,"ruku":154,"hizbQuarter":74,"sajda":false},{"number":1229,"text":"Elde ettiğiniz ganimetleri temiz ve helal olarak yiyin; Allah'tan sakının, doğrusu Allah bağışlar ve merhamet eder.","numberInSurah":69,"juz":10,"manzil":2,"page":185,"ruku":154,"hizbQuarter":74,"sajda":false},{"number":1230,"text":"Elinizde bulunan esirlere, \"Allah kalblerinizde bir iyilik bulursa, size sizden alınanın daha hayırlısını verir, sizi bağışlar, Allah bağışlayandır, merhamet edendir\" de.","numberInSurah":70,"juz":10,"manzil":2,"page":186,"ruku":155,"hizbQuarter":74,"sajda":false},{"number":1231,"text":"Esirler sana hıyanet etmek isterlerse, bilsinler ki esasen daha önce de Allah'a hıyanet etmişlerdi, Allah bundan ötürü onları yenmen için sana imkan verdi. Allah Bilen'dir, Hakim'dir.","numberInSurah":71,"juz":10,"manzil":2,"page":186,"ruku":155,"hizbQuarter":74,"sajda":false},{"number":1232,"text":"Doğrusu inanıp hicret edenler, Allah yolunda mallarıyla canlarıyla cihat edenler ve muhacirleri barındırıp onlara yardım edenler, işte bunlar birbirinin dostudurlar. İnanıp hicret etmeyenlerle, hicret edene kadar sizin dostluğunuz yoktur. Fakat din uğrunda yardım isterlerse, aranızda anlaşma olmayan topluluktan başkasına karşı onlara yardım etmeniz gerekir. Allah işlediklerinizi görür.","numberInSurah":72,"juz":10,"manzil":2,"page":186,"ruku":155,"hizbQuarter":74,"sajda":false},{"number":1233,"text":"İnkar edenler birbirlerinin dostlarıdır. Eğer siz aranızda dost olmazsanız yeryüzünde kargaşalık, fitne ve büyük bozgun çıkar.","numberInSurah":73,"juz":10,"manzil":2,"page":186,"ruku":155,"hizbQuarter":74,"sajda":false},{"number":1234,"text":"İnanıp hicret eden, Allah yolunda savaşanlar ve muhacirleri barındırıp onlara yardım edenler, işte onlar gerçekten inanmış olanlardır. Onlara mağfiret ve cömertçe verilmiş rızıklar vardır.","numberInSurah":74,"juz":10,"manzil":2,"page":186,"ruku":155,"hizbQuarter":74,"sajda":false},{"number":1235,"text":"Sonra inanıp hicret eden ve sizinle birlikte savaşanlar, işte onlar sizdendir. Birbirinin mirasçısı olan akraba, Allah'ın Kitap'ına göre birbirine daha yakındır. Doğrusu Allah her şeyi bilir.","numberInSurah":75,"juz":10,"manzil":2,"page":186,"ruku":155,"hizbQuarter":74,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}