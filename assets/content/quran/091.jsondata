{"arabic":{"number":91,"name":"سُورَةُ الشَّمۡسِ","englishName":"Şems","englishNameTranslation":"The Sun","revelationType":"Meccan","numberOfAyahs":15,"ayahs":[{"number":6044,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ وَالشَّمْسِ وَضُحَاهَا","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6045,"text":"وَالْقَمَرِ إِذَا تَلَاهَا","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6046,"text":"وَالنَّهَارِ إِذَا جَلَّاهَا","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6047,"text":"وَاللَّيْلِ إِذَا يَغْشَاهَا","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6048,"text":"وَالسَّمَاءِ وَمَا بَنَاهَا","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6049,"text":"وَالْأَرْضِ وَمَا طَحَاهَا","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6050,"text":"وَنَفْسٍ وَمَا سَوَّاهَا","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6051,"text":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَاهَا","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6052,"text":"قَدْ أَفْلَحَ مَنْ زَكَّاهَا","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6053,"text":"وَقَدْ خَابَ مَنْ دَسَّاهَا","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6054,"text":"كَذَّبَتْ ثَمُودُ بِطَغْوَاهَا","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6055,"text":"إِذِ انْبَعَثَ أَشْقَاهَا","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6056,"text":"فَقَالَ لَهُمْ رَسُولُ اللَّهِ نَاقَةَ اللَّهِ وَسُقْيَاهَا","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6057,"text":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُمْ بِذَنْبِهِمْ فَسَوَّاهَا","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6058,"text":"وَلَا يَخَافُ عُقْبَاهَا","numberInSurah":15,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":91,"name":"سُورَةُ الشَّمۡسِ","englishName":"Şems","englishNameTranslation":"The Sun","revelationType":"Meccan","numberOfAyahs":15,"ayahs":[{"number":6044,"text":"Güneşe ve onun ışığına,","numberInSurah":1,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6045,"text":"Ardından gelmekte olan aya,","numberInSurah":2,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6046,"text":"Onu ortaya koyan gündüze,","numberInSurah":3,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6047,"text":"Onu bürüyen geceye,","numberInSurah":4,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6048,"text":"Göğe ve onu yapana,","numberInSurah":5,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6049,"text":"Yere ve onu yayana,","numberInSurah":6,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6050,"text":"Kişiye ve onu şekillendirene,","numberInSurah":7,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6051,"text":"Sonra da ona iyilik ve kötülük kabiliyeti verene and olsun ki:","numberInSurah":8,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6052,"text":"Kendini arıtan saadete ermiştir.","numberInSurah":9,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6053,"text":"Kendini fenalıklara gömen kimse de ziyana uğramıştır.","numberInSurah":10,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6054,"text":"Semud milleti, içlerinden en azgını ileri atılınca, azgınlığı yüzünden peygamberleri yalanladı.","numberInSurah":11,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6055,"text":"Semud milleti, içlerinden en azgını ileri atılınca, azgınlığı yüzünden peygamberleri yalanladı.","numberInSurah":12,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6056,"text":"Allah'ın peygamberi onlara, Allah'ın devesini göstermiş ve: \"Allah'ın bu devesine ve onun su hakkına dokunmayın\" demişti.","numberInSurah":13,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6057,"text":"Onu yalanladılar ve deveyi boğazladılar. Bunun üzerine Rableri, suçlarından dolayı onların üzerine katmerli azap indirdi; yerle bir etti onları.","numberInSurah":14,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false},{"number":6058,"text":"Bu işin sonundan O'nun korkusu yoktur.","numberInSurah":15,"juz":30,"manzil":7,"page":595,"ruku":533,"hizbQuarter":238,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}