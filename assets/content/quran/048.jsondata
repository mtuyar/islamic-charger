{"arabic":{"number":48,"name":"سُورَةُ الفَتۡحِ","englishName":"Fetih","englishNameTranslation":"The Victory","revelationType":"Medinan","numberOfAyahs":29,"ayahs":[{"number":4584,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ إِنَّا فَتَحْنَا لَكَ فَتْحًا مُبِينًا","numberInSurah":1,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4585,"text":"لِيَغْفِرَ لَكَ اللَّهُ مَا تَقَدَّمَ مِنْ ذَنْبِكَ وَمَا تَأَخَّرَ وَيُتِمَّ نِعْمَتَهُ عَلَيْكَ وَيَهْدِيَكَ صِرَاطًا مُسْتَقِيمًا","numberInSurah":2,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4586,"text":"وَيَنْصُرَكَ اللَّهُ نَصْرًا عَزِيزًا","numberInSurah":3,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4587,"text":"هُوَ الَّذِي أَنْزَلَ السَّكِينَةَ فِي قُلُوبِ الْمُؤْمِنِينَ لِيَزْدَادُوا إِيمَانًا مَعَ إِيمَانِهِمْ ۗ وَلِلَّهِ جُنُودُ السَّمَاوَاتِ وَالْأَرْضِ ۚ وَكَانَ اللَّهُ عَلِيمًا حَكِيمًا","numberInSurah":4,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4588,"text":"لِيُدْخِلَ الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَيُكَفِّرَ عَنْهُمْ سَيِّئَاتِهِمْ ۚ وَكَانَ ذَٰلِكَ عِنْدَ اللَّهِ فَوْزًا عَظِيمًا","numberInSurah":5,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4589,"text":"وَيُعَذِّبَ الْمُنَافِقِينَ وَالْمُنَافِقَاتِ وَالْمُشْرِكِينَ وَالْمُشْرِكَاتِ الظَّانِّينَ بِاللَّهِ ظَنَّ السَّوْءِ ۚ عَلَيْهِمْ دَائِرَةُ السَّوْءِ ۖ وَغَضِبَ اللَّهُ عَلَيْهِمْ وَلَعَنَهُمْ وَأَعَدَّ لَهُمْ جَهَنَّمَ ۖ وَسَاءَتْ مَصِيرًا","numberInSurah":6,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4590,"text":"وَلِلَّهِ جُنُودُ السَّمَاوَاتِ وَالْأَرْضِ ۚ وَكَانَ اللَّهُ عَزِيزًا حَكِيمًا","numberInSurah":7,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4591,"text":"إِنَّا أَرْسَلْنَاكَ شَاهِدًا وَمُبَشِّرًا وَنَذِيرًا","numberInSurah":8,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4592,"text":"لِتُؤْمِنُوا بِاللَّهِ وَرَسُولِهِ وَتُعَزِّرُوهُ وَتُوَقِّرُوهُ وَتُسَبِّحُوهُ بُكْرَةً وَأَصِيلًا","numberInSurah":9,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4593,"text":"إِنَّ الَّذِينَ يُبَايِعُونَكَ إِنَّمَا يُبَايِعُونَ اللَّهَ يَدُ اللَّهِ فَوْقَ أَيْدِيهِمْ ۚ فَمَنْ نَكَثَ فَإِنَّمَا يَنْكُثُ عَلَىٰ نَفْسِهِ ۖ وَمَنْ أَوْفَىٰ بِمَا عَاهَدَ عَلَيْهُ اللَّهَ فَسَيُؤْتِيهِ أَجْرًا عَظِيمًا","numberInSurah":10,"juz":26,"manzil":6,"page":512,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4594,"text":"سَيَقُولُ لَكَ الْمُخَلَّفُونَ مِنَ الْأَعْرَابِ شَغَلَتْنَا أَمْوَالُنَا وَأَهْلُونَا فَاسْتَغْفِرْ لَنَا ۚ يَقُولُونَ بِأَلْسِنَتِهِمْ مَا لَيْسَ فِي قُلُوبِهِمْ ۚ قُلْ فَمَنْ يَمْلِكُ لَكُمْ مِنَ اللَّهِ شَيْئًا إِنْ أَرَادَ بِكُمْ ضَرًّا أَوْ أَرَادَ بِكُمْ نَفْعًا ۚ بَلْ كَانَ اللَّهُ بِمَا تَعْمَلُونَ خَبِيرًا","numberInSurah":11,"juz":26,"manzil":6,"page":512,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4595,"text":"بَلْ ظَنَنْتُمْ أَنْ لَنْ يَنْقَلِبَ الرَّسُولُ وَالْمُؤْمِنُونَ إِلَىٰ أَهْلِيهِمْ أَبَدًا وَزُيِّنَ ذَٰلِكَ فِي قُلُوبِكُمْ وَظَنَنْتُمْ ظَنَّ السَّوْءِ وَكُنْتُمْ قَوْمًا بُورًا","numberInSurah":12,"juz":26,"manzil":6,"page":512,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4596,"text":"وَمَنْ لَمْ يُؤْمِنْ بِاللَّهِ وَرَسُولِهِ فَإِنَّا أَعْتَدْنَا لِلْكَافِرِينَ سَعِيرًا","numberInSurah":13,"juz":26,"manzil":6,"page":512,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4597,"text":"وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ۚ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ ۚ وَكَانَ اللَّهُ غَفُورًا رَحِيمًا","numberInSurah":14,"juz":26,"manzil":6,"page":512,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4598,"text":"سَيَقُولُ الْمُخَلَّفُونَ إِذَا انْطَلَقْتُمْ إِلَىٰ مَغَانِمَ لِتَأْخُذُوهَا ذَرُونَا نَتَّبِعْكُمْ ۖ يُرِيدُونَ أَنْ يُبَدِّلُوا كَلَامَ اللَّهِ ۚ قُلْ لَنْ تَتَّبِعُونَا كَذَٰلِكُمْ قَالَ اللَّهُ مِنْ قَبْلُ ۖ فَسَيَقُولُونَ بَلْ تَحْسُدُونَنَا ۚ بَلْ كَانُوا لَا يَفْقَهُونَ إِلَّا قَلِيلًا","numberInSurah":15,"juz":26,"manzil":6,"page":512,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4599,"text":"قُلْ لِلْمُخَلَّفِينَ مِنَ الْأَعْرَابِ سَتُدْعَوْنَ إِلَىٰ قَوْمٍ أُولِي بَأْسٍ شَدِيدٍ تُقَاتِلُونَهُمْ أَوْ يُسْلِمُونَ ۖ فَإِنْ تُطِيعُوا يُؤْتِكُمُ اللَّهُ أَجْرًا حَسَنًا ۖ وَإِنْ تَتَوَلَّوْا كَمَا تَوَلَّيْتُمْ مِنْ قَبْلُ يُعَذِّبْكُمْ عَذَابًا أَلِيمًا","numberInSurah":16,"juz":26,"manzil":6,"page":513,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4600,"text":"لَيْسَ عَلَى الْأَعْمَىٰ حَرَجٌ وَلَا عَلَى الْأَعْرَجِ حَرَجٌ وَلَا عَلَى الْمَرِيضِ حَرَجٌ ۗ وَمَنْ يُطِعِ اللَّهَ وَرَسُولَهُ يُدْخِلْهُ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ ۖ وَمَنْ يَتَوَلَّ يُعَذِّبْهُ عَذَابًا أَلِيمًا","numberInSurah":17,"juz":26,"manzil":6,"page":513,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4601,"text":"۞ لَقَدْ رَضِيَ اللَّهُ عَنِ الْمُؤْمِنِينَ إِذْ يُبَايِعُونَكَ تَحْتَ الشَّجَرَةِ فَعَلِمَ مَا فِي قُلُوبِهِمْ فَأَنْزَلَ السَّكِينَةَ عَلَيْهِمْ وَأَثَابَهُمْ فَتْحًا قَرِيبًا","numberInSurah":18,"juz":26,"manzil":6,"page":513,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4602,"text":"وَمَغَانِمَ كَثِيرَةً يَأْخُذُونَهَا ۗ وَكَانَ اللَّهُ عَزِيزًا حَكِيمًا","numberInSurah":19,"juz":26,"manzil":6,"page":513,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4603,"text":"وَعَدَكُمُ اللَّهُ مَغَانِمَ كَثِيرَةً تَأْخُذُونَهَا فَعَجَّلَ لَكُمْ هَٰذِهِ وَكَفَّ أَيْدِيَ النَّاسِ عَنْكُمْ وَلِتَكُونَ آيَةً لِلْمُؤْمِنِينَ وَيَهْدِيَكُمْ صِرَاطًا مُسْتَقِيمًا","numberInSurah":20,"juz":26,"manzil":6,"page":513,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4604,"text":"وَأُخْرَىٰ لَمْ تَقْدِرُوا عَلَيْهَا قَدْ أَحَاطَ اللَّهُ بِهَا ۚ وَكَانَ اللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرًا","numberInSurah":21,"juz":26,"manzil":6,"page":513,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4605,"text":"وَلَوْ قَاتَلَكُمُ الَّذِينَ كَفَرُوا لَوَلَّوُا الْأَدْبَارَ ثُمَّ لَا يَجِدُونَ وَلِيًّا وَلَا نَصِيرًا","numberInSurah":22,"juz":26,"manzil":6,"page":513,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4606,"text":"سُنَّةَ اللَّهِ الَّتِي قَدْ خَلَتْ مِنْ قَبْلُ ۖ وَلَنْ تَجِدَ لِسُنَّةِ اللَّهِ تَبْدِيلًا","numberInSurah":23,"juz":26,"manzil":6,"page":513,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4607,"text":"وَهُوَ الَّذِي كَفَّ أَيْدِيَهُمْ عَنْكُمْ وَأَيْدِيَكُمْ عَنْهُمْ بِبَطْنِ مَكَّةَ مِنْ بَعْدِ أَنْ أَظْفَرَكُمْ عَلَيْهِمْ ۚ وَكَانَ اللَّهُ بِمَا تَعْمَلُونَ بَصِيرًا","numberInSurah":24,"juz":26,"manzil":6,"page":514,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4608,"text":"هُمُ الَّذِينَ كَفَرُوا وَصَدُّوكُمْ عَنِ الْمَسْجِدِ الْحَرَامِ وَالْهَدْيَ مَعْكُوفًا أَنْ يَبْلُغَ مَحِلَّهُ ۚ وَلَوْلَا رِجَالٌ مُؤْمِنُونَ وَنِسَاءٌ مُؤْمِنَاتٌ لَمْ تَعْلَمُوهُمْ أَنْ تَطَئُوهُمْ فَتُصِيبَكُمْ مِنْهُمْ مَعَرَّةٌ بِغَيْرِ عِلْمٍ ۖ لِيُدْخِلَ اللَّهُ فِي رَحْمَتِهِ مَنْ يَشَاءُ ۚ لَوْ تَزَيَّلُوا لَعَذَّبْنَا الَّذِينَ كَفَرُوا مِنْهُمْ عَذَابًا أَلِيمًا","numberInSurah":25,"juz":26,"manzil":6,"page":514,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4609,"text":"إِذْ جَعَلَ الَّذِينَ كَفَرُوا فِي قُلُوبِهِمُ الْحَمِيَّةَ حَمِيَّةَ الْجَاهِلِيَّةِ فَأَنْزَلَ اللَّهُ سَكِينَتَهُ عَلَىٰ رَسُولِهِ وَعَلَى الْمُؤْمِنِينَ وَأَلْزَمَهُمْ كَلِمَةَ التَّقْوَىٰ وَكَانُوا أَحَقَّ بِهَا وَأَهْلَهَا ۚ وَكَانَ اللَّهُ بِكُلِّ شَيْءٍ عَلِيمًا","numberInSurah":26,"juz":26,"manzil":6,"page":514,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4610,"text":"لَقَدْ صَدَقَ اللَّهُ رَسُولَهُ الرُّؤْيَا بِالْحَقِّ ۖ لَتَدْخُلُنَّ الْمَسْجِدَ الْحَرَامَ إِنْ شَاءَ اللَّهُ آمِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ لَا تَخَافُونَ ۖ فَعَلِمَ مَا لَمْ تَعْلَمُوا فَجَعَلَ مِنْ دُونِ ذَٰلِكَ فَتْحًا قَرِيبًا","numberInSurah":27,"juz":26,"manzil":6,"page":514,"ruku":449,"hizbQuarter":205,"sajda":false},{"number":4611,"text":"هُوَ الَّذِي أَرْسَلَ رَسُولَهُ بِالْهُدَىٰ وَدِينِ الْحَقِّ لِيُظْهِرَهُ عَلَى الدِّينِ كُلِّهِ ۚ وَكَفَىٰ بِاللَّهِ شَهِيدًا","numberInSurah":28,"juz":26,"manzil":6,"page":514,"ruku":449,"hizbQuarter":205,"sajda":false},{"number":4612,"text":"مُحَمَّدٌ رَسُولُ اللَّهِ ۚ وَالَّذِينَ مَعَهُ أَشِدَّاءُ عَلَى الْكُفَّارِ رُحَمَاءُ بَيْنَهُمْ ۖ تَرَاهُمْ رُكَّعًا سُجَّدًا يَبْتَغُونَ فَضْلًا مِنَ اللَّهِ وَرِضْوَانًا ۖ سِيمَاهُمْ فِي وُجُوهِهِمْ مِنْ أَثَرِ السُّجُودِ ۚ ذَٰلِكَ مَثَلُهُمْ فِي التَّوْرَاةِ ۚ وَمَثَلُهُمْ فِي الْإِنْجِيلِ كَزَرْعٍ أَخْرَجَ شَطْأَهُ فَآزَرَهُ فَاسْتَغْلَظَ فَاسْتَوَىٰ عَلَىٰ سُوقِهِ يُعْجِبُ الزُّرَّاعَ لِيَغِيظَ بِهِمُ الْكُفَّارَ ۗ وَعَدَ اللَّهُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ مِنْهُمْ مَغْفِرَةً وَأَجْرًا عَظِيمًا","numberInSurah":29,"juz":26,"manzil":6,"page":515,"ruku":449,"hizbQuarter":205,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":48,"name":"سُورَةُ الفَتۡحِ","englishName":"Fetih","englishNameTranslation":"The Victory","revelationType":"Medinan","numberOfAyahs":29,"ayahs":[{"number":4584,"text":"Doğrusu Biz sana apaçık bir zafer sağlamışızdır.","numberInSurah":1,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4585,"text":"Allah böylece, senin geçmiş ve gelecek günahlarını bağışlar, sana olan nimetini tamamlar, seni doğru yola eriştirir.","numberInSurah":2,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4586,"text":"Böylece sana, kimsenin güç yetiremeyeceği bir şekilde yardım eder.","numberInSurah":3,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4587,"text":"İnananların, imanlarını kat kat artırmaları için, kalblerine güven indiren O'dur. Göklerdeki ve yerdeki ordular Allah'ındır. Allah bilendir, Hakim olandır.","numberInSurah":4,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4588,"text":"İnanan erkek ve kadınları, içinde temelli kalacakları, içlerinden ırmaklar akan cennetlere koyar, onların kötülüklerini örter. Allah katında büyük kurtuluş işte budur.","numberInSurah":5,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4589,"text":"İnananlara yardım etmez diye Allah'a kötü sanıda bulunan ikiyüzlü erkek ve kadınlara, puta tapan erek ve kadınlara Allah azabetsin; kötü sanıları kendi baslarına gelsin! Allah onlara gazabetmiş, onları lanetlemiş ve cehennemi kendilerine hazırlamıştır. Ne kötü dönüş yeridir!","numberInSurah":6,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4590,"text":"Göklerdeki ve yerdeki ordular Allah'ındır. Allah güçlü olandır. Hakim olandır.","numberInSurah":7,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4591,"text":"Doğrusu seni şahit, müjdeci ve uyarıcı olarak gönderdik. Ey insanlar, siz de Allah'a ve Peygamberine inanasınız, ona yardım edesiniz, O'na saygı gösteresiniz ve O'nu sabah akşam tesbih edesiniz.","numberInSurah":8,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4592,"text":"Doğrusu seni şahit, müjdeci ve uyarıcı olarak gönderdik. Ey insanlar, siz de Allah'a ve Peygamberine inanasınız, ona yardım edesiniz, O'na saygı gösteresiniz ve O'nu sabah akşam tesbih edesiniz.","numberInSurah":9,"juz":26,"manzil":6,"page":511,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4593,"text":"Şüphesiz sana baş eğerek ellerini verenler (biat edenler), Allah'a baş eğip el vermiş sayılırlar. Allah'ın eli onların ellerinin üstündedir. Verdiği bu sözden dönen, ancak kendi aleyhine dönmüş olur. Allah'a verdiği sözü yerine getirene, Allah büyük ecir verecektir.","numberInSurah":10,"juz":26,"manzil":6,"page":512,"ruku":446,"hizbQuarter":204,"sajda":false},{"number":4594,"text":"Bedevilerin savaştan geri kalmış olanları, sana: \"Bizi mallarımız ve ailelerimiz alıkoydu. Allah'tan bizim bağışlanmamızı dile\" diyecekler. Dilleriyle, gönüllerinde bulunmayanı söylerler; de ki: \"Allah size bir zarar gelmesini dilerse, yahut bir fayda elde etmenizi dilerse, O'na karşı kimin gücü bir şeye yeter? Kaldı ki, Allah yaptıklarınızdan haberdardır.\"","numberInSurah":11,"juz":26,"manzil":6,"page":512,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4595,"text":"Aslında siz, Peygamberin ve inananların, ailelerine bir daha dönmeyeceklerini sanmıştınız. Bu, gönüllerinize güzel görünmüştü de kötü sanıda bulunmuştunuz. Hayırsız bir topluluk oldunuz.","numberInSurah":12,"juz":26,"manzil":6,"page":512,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4596,"text":"Allah'a ve Peygamberine kim inanmamışsa bilsin ki, şüphesiz Biz, inkarcılar için çılgın alevli cehennemi hazırlamışızdır.","numberInSurah":13,"juz":26,"manzil":6,"page":512,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4597,"text":"Göklerin ve yerin hükümranlığı Allah'ındır. O, dilediğini bağışlar, dilediğine azabeder. Allah bağışlayandır, merhamet edendir.","numberInSurah":14,"juz":26,"manzil":6,"page":512,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4598,"text":"Savaştan geri kalmış olanlar, siz ganimetleri almaya giderken: \"Bırakın, biz de sizinle gelelim\" diyeceklerdir. Onlar Allah'ın sözünü değiştirmek isterler. De ki: \"Bize uymayacaksınız; Allah sizin için önceden böyle buyurmuştur.\" Size: \"Hayır, bizi çekemiyorsunuz\" diyecekler. Aksine, kendileri ancak pek az söz anlayan kimselerdir.","numberInSurah":15,"juz":26,"manzil":6,"page":512,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4599,"text":"Bedevilerden geri kalmış olanlara de ki: \"güçlü kuvvetli bir millete karşı, onlar müslüman olana kadar savaşmaya çağrılacaksanız; eğer itaat ederseniz Allah size güzel ecir verir, ama daha önce döndüğünüz gibi yine dönecek olursanız sizi can yakan bir azaba uğratır.\"","numberInSurah":16,"juz":26,"manzil":6,"page":513,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4600,"text":"Ama, gözleri görmeyen kimse savaşa gelmezse ona bir sorumluluk yoktur; topala ve hastaya da sorumluluk yoktur. Kim Allah'a ve peygamberine itaat ederse, Allah onu, içlerinden ırmaklar akan cennetlere koyar. Kim yüz çevirirse, onu can yakıcı azaba uğratır.","numberInSurah":17,"juz":26,"manzil":6,"page":513,"ruku":447,"hizbQuarter":204,"sajda":false},{"number":4601,"text":"Allah inananlardan, ağaç altında sana baş eğerek el verirlerken, and olsun ki hoşnut olmuştur. Gönüllerinde olanı da bilmiş, onlara güvenlik vermiş, onlara yakın bir zafer ve ele geçirecekleri bol ganimetler bahşetmiştir. Allah, güçlü olandır, Hakim olandır.","numberInSurah":18,"juz":26,"manzil":6,"page":513,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4602,"text":"Allah inananlardan, ağaç altında sana baş eğerek el verirlerken, and olsun ki hoşnut olmuştur. Gönüllerinde olanı da bilmiş, onlara güvenlik vermiş, onlara yakın bir zafer ve ele geçirecekleri bol ganimetler bahşetmiştir. Allah, güçlü olandır, Hakim olandır.","numberInSurah":19,"juz":26,"manzil":6,"page":513,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4603,"text":"Allah size, ele geçireceğiniz bol bol ganimetler vadetmiştir. İnananlar için bir belge olması, sizi doğru yola eriştirmesi için bunları size hemen vermiş ve insanların size uzanan ellerini önlemiştir.","numberInSurah":20,"juz":26,"manzil":6,"page":513,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4604,"text":"Bundan başka, sizin gücünüzün yetmediği fakat Allah'ın sizin için sakladığı ganimetler de vardır. Allah her şeye Kadir olandır.","numberInSurah":21,"juz":26,"manzil":6,"page":513,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4605,"text":"İnkar edenler sizinle savaşsalardı yüzgeri döneceklerdi. Sonra bir dost ve yardımcı da bulamayacaklardı.","numberInSurah":22,"juz":26,"manzil":6,"page":513,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4606,"text":"Allah'ın önceden gelip geçmişlere uyguladığı yasası budur. Allah'ın yasasında değişme bulamazsın.","numberInSurah":23,"juz":26,"manzil":6,"page":513,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4607,"text":"Sizi onlara üstün kıldıktan sonra, Mekke bölgesinde, onların ellerini sizden, sizin ellerinizi onlardan geri tutan, savaşı önleyen O'dur. Allah yaptıklarınızı görendir.","numberInSurah":24,"juz":26,"manzil":6,"page":514,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4608,"text":"Onlar inkar edenlerdir, sizi Mescidi Haram'ı ziyaretten ve bağlı kurbanları yerlerine gitmekten alıkoyanlardır. Eğer, oradaki henüz tanımadığınız inanmış erkeklerle inanmış kadınları bilmeyerek ezmek suretiyle üzüntüye kapılmanız ihtimali olmasaydı Allah savaşı önlemezdi. Allah, dilediklerine rahmet etmek için böyle yapmıştır. Eğer inananlarla inkarcılar birbirinden ayrılmış olsalardı, inkar edenleri can yakıcı bir azaba uğratırdık.","numberInSurah":25,"juz":26,"manzil":6,"page":514,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4609,"text":"İnkar edenler, gönüllerindeki cahiliyye çağının asabiyet ateşini ateşlendirdiklerinde, Allah, Peygamberine ve inananlara huzur indirdi; onların takva sözünü tutmalarını sağladı. Onlar, bu söze layık ve ehil kimselerdi. Allah her şeyi bilmektedir.","numberInSurah":26,"juz":26,"manzil":6,"page":514,"ruku":448,"hizbQuarter":205,"sajda":false},{"number":4610,"text":"And olsun ki Allah, Peygamberinin rüyasının gerçek olduğunu tasdik eder. Ey inananlar! Siz, Allah dilerse, güven içinde, başlarınızı tıraş etmiş veya saçlarınızı kısaltmış olarak, korkmadan Mescidi Haram'a gireceksiniz. Allah, sizin bilmediğinizi bilir. Size, bundan başka, yakın zamanda bir zafer verecektir.","numberInSurah":27,"juz":26,"manzil":6,"page":514,"ruku":449,"hizbQuarter":205,"sajda":false},{"number":4611,"text":"Bütün dinlerden üstün kılmak üzere, Peygamberini, doğruluk rehberi Kuran ve hak din ile gönderen O'dur. Şahit olarak Allah yeter.","numberInSurah":28,"juz":26,"manzil":6,"page":514,"ruku":449,"hizbQuarter":205,"sajda":false},{"number":4612,"text":"Muhammed Allah'ın elçisidir. Onun beraberinde bulunanlar, inkarcılara karşı sert, birbirlerine merhametlidirler. Onları rükua varırken, secde ederken, Allah'tan lütuf ve hoşnudluk dilerken görürsün. Onlar, yüzlerindeki secde izi ile tanınırlar. İşte bu, onların Tevrat'ta anlatılan vasıflarıdır. İncil'de de şöyle vasıflandırılmışlardı: Filizini çıkarmış, onu kuvvetlendirmiş, kalınlaşmış, gövdesi üzerine dikilmiş, ekincilerin hoşuna giden ekin gibidirler. Allah böylece bunları çoğaltıp kuvvetlendirmekle inkarcıları öfkelendirir. Allah, inanıp yararlı işler işleyenlere, bağışlama ve büyük ecir vadetmiştir.","numberInSurah":29,"juz":26,"manzil":6,"page":515,"ruku":449,"hizbQuarter":205,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}