{"arabic":{"number":22,"name":"سُورَةُ الحَجِّ","englishName":"Hac","englishNameTranslation":"The Pilgrimage","revelationType":"Medinan","numberOfAyahs":78,"ayahs":[{"number":2596,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ يَا أَيُّهَا النَّاسُ اتَّقُوا رَبَّكُمْ ۚ إِنَّ زَلْزَلَةَ السَّاعَةِ شَيْءٌ عَظِيمٌ","numberInSurah":1,"juz":17,"manzil":4,"page":332,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2597,"text":"يَوْمَ تَرَوْنَهَا تَذْهَلُ كُلُّ مُرْضِعَةٍ عَمَّا أَرْضَعَتْ وَتَضَعُ كُلُّ ذَاتِ حَمْلٍ حَمْلَهَا وَتَرَى النَّاسَ سُكَارَىٰ وَمَا هُمْ بِسُكَارَىٰ وَلَٰكِنَّ عَذَابَ اللَّهِ شَدِيدٌ","numberInSurah":2,"juz":17,"manzil":4,"page":332,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2598,"text":"وَمِنَ النَّاسِ مَنْ يُجَادِلُ فِي اللَّهِ بِغَيْرِ عِلْمٍ وَيَتَّبِعُ كُلَّ شَيْطَانٍ مَرِيدٍ","numberInSurah":3,"juz":17,"manzil":4,"page":332,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2599,"text":"كُتِبَ عَلَيْهِ أَنَّهُ مَنْ تَوَلَّاهُ فَأَنَّهُ يُضِلُّهُ وَيَهْدِيهِ إِلَىٰ عَذَابِ السَّعِيرِ","numberInSurah":4,"juz":17,"manzil":4,"page":332,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2600,"text":"يَا أَيُّهَا النَّاسُ إِنْ كُنْتُمْ فِي رَيْبٍ مِنَ الْبَعْثِ فَإِنَّا خَلَقْنَاكُمْ مِنْ تُرَابٍ ثُمَّ مِنْ نُطْفَةٍ ثُمَّ مِنْ عَلَقَةٍ ثُمَّ مِنْ مُضْغَةٍ مُخَلَّقَةٍ وَغَيْرِ مُخَلَّقَةٍ لِنُبَيِّنَ لَكُمْ ۚ وَنُقِرُّ فِي الْأَرْحَامِ مَا نَشَاءُ إِلَىٰ أَجَلٍ مُسَمًّى ثُمَّ نُخْرِجُكُمْ طِفْلًا ثُمَّ لِتَبْلُغُوا أَشُدَّكُمْ ۖ وَمِنْكُمْ مَنْ يُتَوَفَّىٰ وَمِنْكُمْ مَنْ يُرَدُّ إِلَىٰ أَرْذَلِ الْعُمُرِ لِكَيْلَا يَعْلَمَ مِنْ بَعْدِ عِلْمٍ شَيْئًا ۚ وَتَرَى الْأَرْضَ هَامِدَةً فَإِذَا أَنْزَلْنَا عَلَيْهَا الْمَاءَ اهْتَزَّتْ وَرَبَتْ وَأَنْبَتَتْ مِنْ كُلِّ زَوْجٍ بَهِيجٍ","numberInSurah":5,"juz":17,"manzil":4,"page":332,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2601,"text":"ذَٰلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّهُ يُحْيِي الْمَوْتَىٰ وَأَنَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":6,"juz":17,"manzil":4,"page":333,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2602,"text":"وَأَنَّ السَّاعَةَ آتِيَةٌ لَا رَيْبَ فِيهَا وَأَنَّ اللَّهَ يَبْعَثُ مَنْ فِي الْقُبُورِ","numberInSurah":7,"juz":17,"manzil":4,"page":333,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2603,"text":"وَمِنَ النَّاسِ مَنْ يُجَادِلُ فِي اللَّهِ بِغَيْرِ عِلْمٍ وَلَا هُدًى وَلَا كِتَابٍ مُنِيرٍ","numberInSurah":8,"juz":17,"manzil":4,"page":333,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2604,"text":"ثَانِيَ عِطْفِهِ لِيُضِلَّ عَنْ سَبِيلِ اللَّهِ ۖ لَهُ فِي الدُّنْيَا خِزْيٌ ۖ وَنُذِيقُهُ يَوْمَ الْقِيَامَةِ عَذَابَ الْحَرِيقِ","numberInSurah":9,"juz":17,"manzil":4,"page":333,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2605,"text":"ذَٰلِكَ بِمَا قَدَّمَتْ يَدَاكَ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ","numberInSurah":10,"juz":17,"manzil":4,"page":333,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2606,"text":"وَمِنَ النَّاسِ مَنْ يَعْبُدُ اللَّهَ عَلَىٰ حَرْفٍ ۖ فَإِنْ أَصَابَهُ خَيْرٌ اطْمَأَنَّ بِهِ ۖ وَإِنْ أَصَابَتْهُ فِتْنَةٌ انْقَلَبَ عَلَىٰ وَجْهِهِ خَسِرَ الدُّنْيَا وَالْآخِرَةَ ۚ ذَٰلِكَ هُوَ الْخُسْرَانُ الْمُبِينُ","numberInSurah":11,"juz":17,"manzil":4,"page":333,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2607,"text":"يَدْعُو مِنْ دُونِ اللَّهِ مَا لَا يَضُرُّهُ وَمَا لَا يَنْفَعُهُ ۚ ذَٰلِكَ هُوَ الضَّلَالُ الْبَعِيدُ","numberInSurah":12,"juz":17,"manzil":4,"page":333,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2608,"text":"يَدْعُو لَمَنْ ضَرُّهُ أَقْرَبُ مِنْ نَفْعِهِ ۚ لَبِئْسَ الْمَوْلَىٰ وَلَبِئْسَ الْعَشِيرُ","numberInSurah":13,"juz":17,"manzil":4,"page":333,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2609,"text":"إِنَّ اللَّهَ يُدْخِلُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ ۚ إِنَّ اللَّهَ يَفْعَلُ مَا يُرِيدُ","numberInSurah":14,"juz":17,"manzil":4,"page":333,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2610,"text":"مَنْ كَانَ يَظُنُّ أَنْ لَنْ يَنْصُرَهُ اللَّهُ فِي الدُّنْيَا وَالْآخِرَةِ فَلْيَمْدُدْ بِسَبَبٍ إِلَى السَّمَاءِ ثُمَّ لْيَقْطَعْ فَلْيَنْظُرْ هَلْ يُذْهِبَنَّ كَيْدُهُ مَا يَغِيظُ","numberInSurah":15,"juz":17,"manzil":4,"page":333,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2611,"text":"وَكَذَٰلِكَ أَنْزَلْنَاهُ آيَاتٍ بَيِّنَاتٍ وَأَنَّ اللَّهَ يَهْدِي مَنْ يُرِيدُ","numberInSurah":16,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2612,"text":"إِنَّ الَّذِينَ آمَنُوا وَالَّذِينَ هَادُوا وَالصَّابِئِينَ وَالنَّصَارَىٰ وَالْمَجُوسَ وَالَّذِينَ أَشْرَكُوا إِنَّ اللَّهَ يَفْصِلُ بَيْنَهُمْ يَوْمَ الْقِيَامَةِ ۚ إِنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ شَهِيدٌ","numberInSurah":17,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2613,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ يَسْجُدُ لَهُ مَنْ فِي السَّمَاوَاتِ وَمَنْ فِي الْأَرْضِ وَالشَّمْسُ وَالْقَمَرُ وَالنُّجُومُ وَالْجِبَالُ وَالشَّجَرُ وَالدَّوَابُّ وَكَثِيرٌ مِنَ النَّاسِ ۖ وَكَثِيرٌ حَقَّ عَلَيْهِ الْعَذَابُ ۗ وَمَنْ يُهِنِ اللَّهُ فَمَا لَهُ مِنْ مُكْرِمٍ ۚ إِنَّ اللَّهَ يَفْعَلُ مَا يَشَاءُ ۩","numberInSurah":18,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":133,"sajda":{"id":6,"recommended":true,"obligatory":false}},{"number":2614,"text":"۞ هَٰذَانِ خَصْمَانِ اخْتَصَمُوا فِي رَبِّهِمْ ۖ فَالَّذِينَ كَفَرُوا قُطِّعَتْ لَهُمْ ثِيَابٌ مِنْ نَارٍ يُصَبُّ مِنْ فَوْقِ رُءُوسِهِمُ الْحَمِيمُ","numberInSurah":19,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":134,"sajda":false},{"number":2615,"text":"يُصْهَرُ بِهِ مَا فِي بُطُونِهِمْ وَالْجُلُودُ","numberInSurah":20,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":134,"sajda":false},{"number":2616,"text":"وَلَهُمْ مَقَامِعُ مِنْ حَدِيدٍ","numberInSurah":21,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":134,"sajda":false},{"number":2617,"text":"كُلَّمَا أَرَادُوا أَنْ يَخْرُجُوا مِنْهَا مِنْ غَمٍّ أُعِيدُوا فِيهَا وَذُوقُوا عَذَابَ الْحَرِيقِ","numberInSurah":22,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":134,"sajda":false},{"number":2618,"text":"إِنَّ اللَّهَ يُدْخِلُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ يُحَلَّوْنَ فِيهَا مِنْ أَسَاوِرَ مِنْ ذَهَبٍ وَلُؤْلُؤًا ۖ وَلِبَاسُهُمْ فِيهَا حَرِيرٌ","numberInSurah":23,"juz":17,"manzil":4,"page":334,"ruku":287,"hizbQuarter":134,"sajda":false},{"number":2619,"text":"وَهُدُوا إِلَى الطَّيِّبِ مِنَ الْقَوْلِ وَهُدُوا إِلَىٰ صِرَاطِ الْحَمِيدِ","numberInSurah":24,"juz":17,"manzil":4,"page":335,"ruku":287,"hizbQuarter":134,"sajda":false},{"number":2620,"text":"إِنَّ الَّذِينَ كَفَرُوا وَيَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَالْمَسْجِدِ الْحَرَامِ الَّذِي جَعَلْنَاهُ لِلنَّاسِ سَوَاءً الْعَاكِفُ فِيهِ وَالْبَادِ ۚ وَمَنْ يُرِدْ فِيهِ بِإِلْحَادٍ بِظُلْمٍ نُذِقْهُ مِنْ عَذَابٍ أَلِيمٍ","numberInSurah":25,"juz":17,"manzil":4,"page":335,"ruku":287,"hizbQuarter":134,"sajda":false},{"number":2621,"text":"وَإِذْ بَوَّأْنَا لِإِبْرَاهِيمَ مَكَانَ الْبَيْتِ أَنْ لَا تُشْرِكْ بِي شَيْئًا وَطَهِّرْ بَيْتِيَ لِلطَّائِفِينَ وَالْقَائِمِينَ وَالرُّكَّعِ السُّجُودِ","numberInSurah":26,"juz":17,"manzil":4,"page":335,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2622,"text":"وَأَذِّنْ فِي النَّاسِ بِالْحَجِّ يَأْتُوكَ رِجَالًا وَعَلَىٰ كُلِّ ضَامِرٍ يَأْتِينَ مِنْ كُلِّ فَجٍّ عَمِيقٍ","numberInSurah":27,"juz":17,"manzil":4,"page":335,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2623,"text":"لِيَشْهَدُوا مَنَافِعَ لَهُمْ وَيَذْكُرُوا اسْمَ اللَّهِ فِي أَيَّامٍ مَعْلُومَاتٍ عَلَىٰ مَا رَزَقَهُمْ مِنْ بَهِيمَةِ الْأَنْعَامِ ۖ فَكُلُوا مِنْهَا وَأَطْعِمُوا الْبَائِسَ الْفَقِيرَ","numberInSurah":28,"juz":17,"manzil":4,"page":335,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2624,"text":"ثُمَّ لْيَقْضُوا تَفَثَهُمْ وَلْيُوفُوا نُذُورَهُمْ وَلْيَطَّوَّفُوا بِالْبَيْتِ الْعَتِيقِ","numberInSurah":29,"juz":17,"manzil":4,"page":335,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2625,"text":"ذَٰلِكَ وَمَنْ يُعَظِّمْ حُرُمَاتِ اللَّهِ فَهُوَ خَيْرٌ لَهُ عِنْدَ رَبِّهِ ۗ وَأُحِلَّتْ لَكُمُ الْأَنْعَامُ إِلَّا مَا يُتْلَىٰ عَلَيْكُمْ ۖ فَاجْتَنِبُوا الرِّجْسَ مِنَ الْأَوْثَانِ وَاجْتَنِبُوا قَوْلَ الزُّورِ","numberInSurah":30,"juz":17,"manzil":4,"page":335,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2626,"text":"حُنَفَاءَ لِلَّهِ غَيْرَ مُشْرِكِينَ بِهِ ۚ وَمَنْ يُشْرِكْ بِاللَّهِ فَكَأَنَّمَا خَرَّ مِنَ السَّمَاءِ فَتَخْطَفُهُ الطَّيْرُ أَوْ تَهْوِي بِهِ الرِّيحُ فِي مَكَانٍ سَحِيقٍ","numberInSurah":31,"juz":17,"manzil":4,"page":336,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2627,"text":"ذَٰلِكَ وَمَنْ يُعَظِّمْ شَعَائِرَ اللَّهِ فَإِنَّهَا مِنْ تَقْوَى الْقُلُوبِ","numberInSurah":32,"juz":17,"manzil":4,"page":336,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2628,"text":"لَكُمْ فِيهَا مَنَافِعُ إِلَىٰ أَجَلٍ مُسَمًّى ثُمَّ مَحِلُّهَا إِلَى الْبَيْتِ الْعَتِيقِ","numberInSurah":33,"juz":17,"manzil":4,"page":336,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2629,"text":"وَلِكُلِّ أُمَّةٍ جَعَلْنَا مَنْسَكًا لِيَذْكُرُوا اسْمَ اللَّهِ عَلَىٰ مَا رَزَقَهُمْ مِنْ بَهِيمَةِ الْأَنْعَامِ ۗ فَإِلَٰهُكُمْ إِلَٰهٌ وَاحِدٌ فَلَهُ أَسْلِمُوا ۗ وَبَشِّرِ الْمُخْبِتِينَ","numberInSurah":34,"juz":17,"manzil":4,"page":336,"ruku":289,"hizbQuarter":134,"sajda":false},{"number":2630,"text":"الَّذِينَ إِذَا ذُكِرَ اللَّهُ وَجِلَتْ قُلُوبُهُمْ وَالصَّابِرِينَ عَلَىٰ مَا أَصَابَهُمْ وَالْمُقِيمِي الصَّلَاةِ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ","numberInSurah":35,"juz":17,"manzil":4,"page":336,"ruku":289,"hizbQuarter":134,"sajda":false},{"number":2631,"text":"وَالْبُدْنَ جَعَلْنَاهَا لَكُمْ مِنْ شَعَائِرِ اللَّهِ لَكُمْ فِيهَا خَيْرٌ ۖ فَاذْكُرُوا اسْمَ اللَّهِ عَلَيْهَا صَوَافَّ ۖ فَإِذَا وَجَبَتْ جُنُوبُهَا فَكُلُوا مِنْهَا وَأَطْعِمُوا الْقَانِعَ وَالْمُعْتَرَّ ۚ كَذَٰلِكَ سَخَّرْنَاهَا لَكُمْ لَعَلَّكُمْ تَشْكُرُونَ","numberInSurah":36,"juz":17,"manzil":4,"page":336,"ruku":289,"hizbQuarter":134,"sajda":false},{"number":2632,"text":"لَنْ يَنَالَ اللَّهَ لُحُومُهَا وَلَا دِمَاؤُهَا وَلَٰكِنْ يَنَالُهُ التَّقْوَىٰ مِنْكُمْ ۚ كَذَٰلِكَ سَخَّرَهَا لَكُمْ لِتُكَبِّرُوا اللَّهَ عَلَىٰ مَا هَدَاكُمْ ۗ وَبَشِّرِ الْمُحْسِنِينَ","numberInSurah":37,"juz":17,"manzil":4,"page":336,"ruku":289,"hizbQuarter":134,"sajda":false},{"number":2633,"text":"۞ إِنَّ اللَّهَ يُدَافِعُ عَنِ الَّذِينَ آمَنُوا ۗ إِنَّ اللَّهَ لَا يُحِبُّ كُلَّ خَوَّانٍ كَفُورٍ","numberInSurah":38,"juz":17,"manzil":4,"page":336,"ruku":289,"hizbQuarter":135,"sajda":false},{"number":2634,"text":"أُذِنَ لِلَّذِينَ يُقَاتَلُونَ بِأَنَّهُمْ ظُلِمُوا ۚ وَإِنَّ اللَّهَ عَلَىٰ نَصْرِهِمْ لَقَدِيرٌ","numberInSurah":39,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2635,"text":"الَّذِينَ أُخْرِجُوا مِنْ دِيَارِهِمْ بِغَيْرِ حَقٍّ إِلَّا أَنْ يَقُولُوا رَبُّنَا اللَّهُ ۗ وَلَوْلَا دَفْعُ اللَّهِ النَّاسَ بَعْضَهُمْ بِبَعْضٍ لَهُدِّمَتْ صَوَامِعُ وَبِيَعٌ وَصَلَوَاتٌ وَمَسَاجِدُ يُذْكَرُ فِيهَا اسْمُ اللَّهِ كَثِيرًا ۗ وَلَيَنْصُرَنَّ اللَّهُ مَنْ يَنْصُرُهُ ۗ إِنَّ اللَّهَ لَقَوِيٌّ عَزِيزٌ","numberInSurah":40,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2636,"text":"الَّذِينَ إِنْ مَكَّنَّاهُمْ فِي الْأَرْضِ أَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ وَأَمَرُوا بِالْمَعْرُوفِ وَنَهَوْا عَنِ الْمُنْكَرِ ۗ وَلِلَّهِ عَاقِبَةُ الْأُمُورِ","numberInSurah":41,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2637,"text":"وَإِنْ يُكَذِّبُوكَ فَقَدْ كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَعَادٌ وَثَمُودُ","numberInSurah":42,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2638,"text":"وَقَوْمُ إِبْرَاهِيمَ وَقَوْمُ لُوطٍ","numberInSurah":43,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2639,"text":"وَأَصْحَابُ مَدْيَنَ ۖ وَكُذِّبَ مُوسَىٰ فَأَمْلَيْتُ لِلْكَافِرِينَ ثُمَّ أَخَذْتُهُمْ ۖ فَكَيْفَ كَانَ نَكِيرِ","numberInSurah":44,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2640,"text":"فَكَأَيِّنْ مِنْ قَرْيَةٍ أَهْلَكْنَاهَا وَهِيَ ظَالِمَةٌ فَهِيَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا وَبِئْرٍ مُعَطَّلَةٍ وَقَصْرٍ مَشِيدٍ","numberInSurah":45,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2641,"text":"أَفَلَمْ يَسِيرُوا فِي الْأَرْضِ فَتَكُونَ لَهُمْ قُلُوبٌ يَعْقِلُونَ بِهَا أَوْ آذَانٌ يَسْمَعُونَ بِهَا ۖ فَإِنَّهَا لَا تَعْمَى الْأَبْصَارُ وَلَٰكِنْ تَعْمَى الْقُلُوبُ الَّتِي فِي الصُّدُورِ","numberInSurah":46,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2642,"text":"وَيَسْتَعْجِلُونَكَ بِالْعَذَابِ وَلَنْ يُخْلِفَ اللَّهُ وَعْدَهُ ۚ وَإِنَّ يَوْمًا عِنْدَ رَبِّكَ كَأَلْفِ سَنَةٍ مِمَّا تَعُدُّونَ","numberInSurah":47,"juz":17,"manzil":4,"page":338,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2643,"text":"وَكَأَيِّنْ مِنْ قَرْيَةٍ أَمْلَيْتُ لَهَا وَهِيَ ظَالِمَةٌ ثُمَّ أَخَذْتُهَا وَإِلَيَّ الْمَصِيرُ","numberInSurah":48,"juz":17,"manzil":4,"page":338,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2644,"text":"قُلْ يَا أَيُّهَا النَّاسُ إِنَّمَا أَنَا لَكُمْ نَذِيرٌ مُبِينٌ","numberInSurah":49,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2645,"text":"فَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ مَغْفِرَةٌ وَرِزْقٌ كَرِيمٌ","numberInSurah":50,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2646,"text":"وَالَّذِينَ سَعَوْا فِي آيَاتِنَا مُعَاجِزِينَ أُولَٰئِكَ أَصْحَابُ الْجَحِيمِ","numberInSurah":51,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2647,"text":"وَمَا أَرْسَلْنَا مِنْ قَبْلِكَ مِنْ رَسُولٍ وَلَا نَبِيٍّ إِلَّا إِذَا تَمَنَّىٰ أَلْقَى الشَّيْطَانُ فِي أُمْنِيَّتِهِ فَيَنْسَخُ اللَّهُ مَا يُلْقِي الشَّيْطَانُ ثُمَّ يُحْكِمُ اللَّهُ آيَاتِهِ ۗ وَاللَّهُ عَلِيمٌ حَكِيمٌ","numberInSurah":52,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2648,"text":"لِيَجْعَلَ مَا يُلْقِي الشَّيْطَانُ فِتْنَةً لِلَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ وَالْقَاسِيَةِ قُلُوبُهُمْ ۗ وَإِنَّ الظَّالِمِينَ لَفِي شِقَاقٍ بَعِيدٍ","numberInSurah":53,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2649,"text":"وَلِيَعْلَمَ الَّذِينَ أُوتُوا الْعِلْمَ أَنَّهُ الْحَقُّ مِنْ رَبِّكَ فَيُؤْمِنُوا بِهِ فَتُخْبِتَ لَهُ قُلُوبُهُمْ ۗ وَإِنَّ اللَّهَ لَهَادِ الَّذِينَ آمَنُوا إِلَىٰ صِرَاطٍ مُسْتَقِيمٍ","numberInSurah":54,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2650,"text":"وَلَا يَزَالُ الَّذِينَ كَفَرُوا فِي مِرْيَةٍ مِنْهُ حَتَّىٰ تَأْتِيَهُمُ السَّاعَةُ بَغْتَةً أَوْ يَأْتِيَهُمْ عَذَابُ يَوْمٍ عَقِيمٍ","numberInSurah":55,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2651,"text":"الْمُلْكُ يَوْمَئِذٍ لِلَّهِ يَحْكُمُ بَيْنَهُمْ ۚ فَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فِي جَنَّاتِ النَّعِيمِ","numberInSurah":56,"juz":17,"manzil":4,"page":339,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2652,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا فَأُولَٰئِكَ لَهُمْ عَذَابٌ مُهِينٌ","numberInSurah":57,"juz":17,"manzil":4,"page":339,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2653,"text":"وَالَّذِينَ هَاجَرُوا فِي سَبِيلِ اللَّهِ ثُمَّ قُتِلُوا أَوْ مَاتُوا لَيَرْزُقَنَّهُمُ اللَّهُ رِزْقًا حَسَنًا ۚ وَإِنَّ اللَّهَ لَهُوَ خَيْرُ الرَّازِقِينَ","numberInSurah":58,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":135,"sajda":false},{"number":2654,"text":"لَيُدْخِلَنَّهُمْ مُدْخَلًا يَرْضَوْنَهُ ۗ وَإِنَّ اللَّهَ لَعَلِيمٌ حَلِيمٌ","numberInSurah":59,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":135,"sajda":false},{"number":2655,"text":"۞ ذَٰلِكَ وَمَنْ عَاقَبَ بِمِثْلِ مَا عُوقِبَ بِهِ ثُمَّ بُغِيَ عَلَيْهِ لَيَنْصُرَنَّهُ اللَّهُ ۗ إِنَّ اللَّهَ لَعَفُوٌّ غَفُورٌ","numberInSurah":60,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":136,"sajda":false},{"number":2656,"text":"ذَٰلِكَ بِأَنَّ اللَّهَ يُولِجُ اللَّيْلَ فِي النَّهَارِ وَيُولِجُ النَّهَارَ فِي اللَّيْلِ وَأَنَّ اللَّهَ سَمِيعٌ بَصِيرٌ","numberInSurah":61,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":136,"sajda":false},{"number":2657,"text":"ذَٰلِكَ بِأَنَّ اللَّهَ هُوَ الْحَقُّ وَأَنَّ مَا يَدْعُونَ مِنْ دُونِهِ هُوَ الْبَاطِلُ وَأَنَّ اللَّهَ هُوَ الْعَلِيُّ الْكَبِيرُ","numberInSurah":62,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":136,"sajda":false},{"number":2658,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ أَنْزَلَ مِنَ السَّمَاءِ مَاءً فَتُصْبِحُ الْأَرْضُ مُخْضَرَّةً ۗ إِنَّ اللَّهَ لَطِيفٌ خَبِيرٌ","numberInSurah":63,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":136,"sajda":false},{"number":2659,"text":"لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ وَإِنَّ اللَّهَ لَهُوَ الْغَنِيُّ الْحَمِيدُ","numberInSurah":64,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":136,"sajda":false},{"number":2660,"text":"أَلَمْ تَرَ أَنَّ اللَّهَ سَخَّرَ لَكُمْ مَا فِي الْأَرْضِ وَالْفُلْكَ تَجْرِي فِي الْبَحْرِ بِأَمْرِهِ وَيُمْسِكُ السَّمَاءَ أَنْ تَقَعَ عَلَى الْأَرْضِ إِلَّا بِإِذْنِهِ ۗ إِنَّ اللَّهَ بِالنَّاسِ لَرَءُوفٌ رَحِيمٌ","numberInSurah":65,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2661,"text":"وَهُوَ الَّذِي أَحْيَاكُمْ ثُمَّ يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ ۗ إِنَّ الْإِنْسَانَ لَكَفُورٌ","numberInSurah":66,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2662,"text":"لِكُلِّ أُمَّةٍ جَعَلْنَا مَنْسَكًا هُمْ نَاسِكُوهُ ۖ فَلَا يُنَازِعُنَّكَ فِي الْأَمْرِ ۚ وَادْعُ إِلَىٰ رَبِّكَ ۖ إِنَّكَ لَعَلَىٰ هُدًى مُسْتَقِيمٍ","numberInSurah":67,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2663,"text":"وَإِنْ جَادَلُوكَ فَقُلِ اللَّهُ أَعْلَمُ بِمَا تَعْمَلُونَ","numberInSurah":68,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2664,"text":"اللَّهُ يَحْكُمُ بَيْنَكُمْ يَوْمَ الْقِيَامَةِ فِيمَا كُنْتُمْ فِيهِ تَخْتَلِفُونَ","numberInSurah":69,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2665,"text":"أَلَمْ تَعْلَمْ أَنَّ اللَّهَ يَعْلَمُ مَا فِي السَّمَاءِ وَالْأَرْضِ ۗ إِنَّ ذَٰلِكَ فِي كِتَابٍ ۚ إِنَّ ذَٰلِكَ عَلَى اللَّهِ يَسِيرٌ","numberInSurah":70,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2666,"text":"وَيَعْبُدُونَ مِنْ دُونِ اللَّهِ مَا لَمْ يُنَزِّلْ بِهِ سُلْطَانًا وَمَا لَيْسَ لَهُمْ بِهِ عِلْمٌ ۗ وَمَا لِلظَّالِمِينَ مِنْ نَصِيرٍ","numberInSurah":71,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2667,"text":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ آيَاتُنَا بَيِّنَاتٍ تَعْرِفُ فِي وُجُوهِ الَّذِينَ كَفَرُوا الْمُنْكَرَ ۖ يَكَادُونَ يَسْطُونَ بِالَّذِينَ يَتْلُونَ عَلَيْهِمْ آيَاتِنَا ۗ قُلْ أَفَأُنَبِّئُكُمْ بِشَرٍّ مِنْ ذَٰلِكُمُ ۗ النَّارُ وَعَدَهَا اللَّهُ الَّذِينَ كَفَرُوا ۖ وَبِئْسَ الْمَصِيرُ","numberInSurah":72,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2668,"text":"يَا أَيُّهَا النَّاسُ ضُرِبَ مَثَلٌ فَاسْتَمِعُوا لَهُ ۚ إِنَّ الَّذِينَ تَدْعُونَ مِنْ دُونِ اللَّهِ لَنْ يَخْلُقُوا ذُبَابًا وَلَوِ اجْتَمَعُوا لَهُ ۖ وَإِنْ يَسْلُبْهُمُ الذُّبَابُ شَيْئًا لَا يَسْتَنْقِذُوهُ مِنْهُ ۚ ضَعُفَ الطَّالِبُ وَالْمَطْلُوبُ","numberInSurah":73,"juz":17,"manzil":4,"page":341,"ruku":294,"hizbQuarter":136,"sajda":false},{"number":2669,"text":"مَا قَدَرُوا اللَّهَ حَقَّ قَدْرِهِ ۗ إِنَّ اللَّهَ لَقَوِيٌّ عَزِيزٌ","numberInSurah":74,"juz":17,"manzil":4,"page":341,"ruku":294,"hizbQuarter":136,"sajda":false},{"number":2670,"text":"اللَّهُ يَصْطَفِي مِنَ الْمَلَائِكَةِ رُسُلًا وَمِنَ النَّاسِ ۚ إِنَّ اللَّهَ سَمِيعٌ بَصِيرٌ","numberInSurah":75,"juz":17,"manzil":4,"page":341,"ruku":294,"hizbQuarter":136,"sajda":false},{"number":2671,"text":"يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ ۗ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","numberInSurah":76,"juz":17,"manzil":4,"page":341,"ruku":294,"hizbQuarter":136,"sajda":false},{"number":2672,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا ارْكَعُوا وَاسْجُدُوا وَاعْبُدُوا رَبَّكُمْ وَافْعَلُوا الْخَيْرَ لَعَلَّكُمْ تُفْلِحُونَ ۩","numberInSurah":77,"juz":17,"manzil":4,"page":341,"ruku":294,"hizbQuarter":136,"sajda":{"id":7,"recommended":true,"obligatory":false}},{"number":2673,"text":"وَجَاهِدُوا فِي اللَّهِ حَقَّ جِهَادِهِ ۚ هُوَ اجْتَبَاكُمْ وَمَا جَعَلَ عَلَيْكُمْ فِي الدِّينِ مِنْ حَرَجٍ ۚ مِلَّةَ أَبِيكُمْ إِبْرَاهِيمَ ۚ هُوَ سَمَّاكُمُ الْمُسْلِمِينَ مِنْ قَبْلُ وَفِي هَٰذَا لِيَكُونَ الرَّسُولُ شَهِيدًا عَلَيْكُمْ وَتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ ۚ فَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَاعْتَصِمُوا بِاللَّهِ هُوَ مَوْلَاكُمْ ۖ فَنِعْمَ الْمَوْلَىٰ وَنِعْمَ النَّصِيرُ","numberInSurah":78,"juz":17,"manzil":4,"page":341,"ruku":294,"hizbQuarter":136,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":22,"name":"سُورَةُ الحَجِّ","englishName":"Hac","englishNameTranslation":"The Pilgrimage","revelationType":"Medinan","numberOfAyahs":78,"ayahs":[{"number":2596,"text":"Ey insanlar! Rabbinizden sakının; doğrusu kıyamet gününün sarsıntısı büyük şeydir.","numberInSurah":1,"juz":17,"manzil":4,"page":332,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2597,"text":"Kıyameti gören her emzikli kadın emzirdiğini unutur, her hamile kadın çocuğunu düşürür. İnsanları sarhoş gibi görürsün oysa sarhoş değildirler, fakat bu sadece Allah'ın azabının çetin olmasındandır.","numberInSurah":2,"juz":17,"manzil":4,"page":332,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2598,"text":"Allah hakkında bilmeden taşıyan ve her azılı şeytana uyan insanlar vardır.","numberInSurah":3,"juz":17,"manzil":4,"page":332,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2599,"text":"Onun hakkında şöyle yazılmıştır: O kendisini dost edinen kimseyi saptırır ve alevli azaba götürür.","numberInSurah":4,"juz":17,"manzil":4,"page":332,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2600,"text":"Ey insanlar! Öldükten sonra tekrar dirilmekten şüphede iseniz bilin ki, ne olduğunuzu size açıklamak için, Biz sizi topraktan sonra nutfeden, sonra pıhtılaşmış kandan, sonra da yapısı belli belirsiz bir çiğnem etten yaratmışızdır. Dilediğimizi belli bir süreye kadar rahimlerde tutarız; sonra sizi çocuk olarak çıkartırız, böylece yetişip erginlik çağına varırsınız. Kiminiz öldürülür, kiminiz de ömrünün en fena zamanına ulaştırılır ki, bilirken birşey bilmez olur. Yeryüzünü görürsün ki kupkurudur; fakat Biz ona su indirdiğimiz zaman harekete geçer, kabarır, her güzel bitkiden çift çift yetiştirir.","numberInSurah":5,"juz":17,"manzil":4,"page":332,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2601,"text":"Bunlar, yalnız Allah'ın gerçek olduğunu, ölüleri dirilttiğini, gücünün herşeye yettiğini, şüphe götürmeyen kıyamet saatinin geleceğini, Allah'ın kabirlerde olanı dirilteceğini gösterir.","numberInSurah":6,"juz":17,"manzil":4,"page":333,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2602,"text":"Bunlar, yalnız Allah'ın gerçek olduğunu, ölüleri dirilttiğini, gücünün herşeye yettiğini, şüphe götürmeyen kıyamet saatinin geleceğini, Allah'ın kabirlerde olanı dirilteceğini gösterir.","numberInSurah":7,"juz":17,"manzil":4,"page":333,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2603,"text":"Bilmeden, doğruya götüren bir rehberi olmadan, aydınlatıcı bir kitabı da bulunmadan Allah yolundan saptırmak için büyüklük taslayarak Allah hakkında tartışan insan vardır. Dünyada rezillik onadır; ona kıyamet günü yakıcı azabı tattırırız.","numberInSurah":8,"juz":17,"manzil":4,"page":333,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2604,"text":"Bilmeden, doğruya götüren bir rehberi olmadan, aydınlatıcı bir kitabı da bulunmadan Allah yolundan saptırmak için büyüklük taslayarak Allah hakkında tartışan insan vardır. Dünyada rezillik onadır; ona kıyamet günü yakıcı azabı tattırırız.","numberInSurah":9,"juz":17,"manzil":4,"page":333,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2605,"text":"Ona: \"Bunlar senin yaptıklarından ötürüdür\" denir, yoksa Allah, kullarına karşı hiç de zalim değildir.","numberInSurah":10,"juz":17,"manzil":4,"page":333,"ruku":285,"hizbQuarter":133,"sajda":false},{"number":2606,"text":"İnsanlar içinde Allah'a, bir yar kenarındaymış gibi kulluk eden vardır. Ona bir iyilik gelirse yatışır, başına bir bela gelirse yüz üstü döner. Dünyayı da ahireti de kaybeder. İşte apaçık kayıp budur.","numberInSurah":11,"juz":17,"manzil":4,"page":333,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2607,"text":"Allah'ı bırakıp, kendisine fayda da zarar da veremeyen şeylere yalvarır. İşte derin sapıklık budur.","numberInSurah":12,"juz":17,"manzil":4,"page":333,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2608,"text":"Kendisine zararı faydasından daha yakın olana yalvarır. Yalvardığı şey ne kötü yardımcı ve ne kötü yoldaştır!","numberInSurah":13,"juz":17,"manzil":4,"page":333,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2609,"text":"Doğrusu Allah, inananları ve yararlı işler işleyenleri, içlerinden ırmaklar akan cennetlere koyar. Allah, şüphesiz, istediğini yapar.","numberInSurah":14,"juz":17,"manzil":4,"page":333,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2610,"text":"Allah'ın peygamber'e dünyada ve ahirette yardım etmeyeceğini sanan kimse, yukarı bağladığı bir ipe kendini asıp, boğsun; bir düşünsün bakalım, bu hilesi kendisini öfkelendiren şeye engel olabilir mi?","numberInSurah":15,"juz":17,"manzil":4,"page":333,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2611,"text":"İşte böylece Kuran'ı apaçık ayetler olarak indirdik. Allah, şüphesiz, dilediğini doğru yola eriştirir.","numberInSurah":16,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2612,"text":"Doğrusu, inananlar ve yahudiler, sabiiler, hıristiyanlar, mecusiler, ortak koşanlar arasında, kıyamet günü Allah kesin hüküm verecektir. Doğrusu Allah herşeye şahiddir.","numberInSurah":17,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":133,"sajda":false},{"number":2613,"text":"Göklerde ve yerde olanların, güneş, ay, yıldızlar, dağlar, ağaçlar, hayvanların ve insanların birçoğunun Allah'a secde ettiklerini görmüyor musun? İnsanların birçoğu da azabı hak etmiştir. Allah'ın alçalttığı kimseyi yükseltebilecek yoktur. Doğrusu Allah ne dilerse yapar.","numberInSurah":18,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":133,"sajda":{"id":6,"recommended":true,"obligatory":false}},{"number":2614,"text":"İşte Rableri hakkında tartışmaya giren iki taraf: O'nu inkar edenlere, ateşten elbiseler kesilmiştir, başlarına da kaynar su dökülür de bununla karınlarındakiler ve deriler eritilir. Demir topuzlar da onlar içindir.","numberInSurah":19,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":134,"sajda":false},{"number":2615,"text":"İşte Rableri hakkında tartışmaya giren iki taraf: O'nu inkar edenlere, ateşten elbiseler kesilmiştir, başlarına da kaynar su dökülür de bununla karınlarındakiler ve deriler eritilir. Demir topuzlar da onlar içindir.","numberInSurah":20,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":134,"sajda":false},{"number":2616,"text":"İşte Rableri hakkında tartışmaya giren iki taraf: O'nu inkar edenlere, ateşten elbiseler kesilmiştir, başlarına da kaynar su dökülür de bununla karınlarındakiler ve deriler eritilir. Demir topuzlar da onlar içindir.","numberInSurah":21,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":134,"sajda":false},{"number":2617,"text":"Orada, uğradıkları gamdan ne zaman çıkmak isteseler her defasında oraya geri çevrilirler: \"Yakıcı azabı tadın\" denir.","numberInSurah":22,"juz":17,"manzil":4,"page":334,"ruku":286,"hizbQuarter":134,"sajda":false},{"number":2618,"text":"Doğrusu Allah, inanıp yararlı iş işleyenleri, içlerinden ırmaklar akan cennetlere koyar. Orada altın bilezikler ve inciler takınırlar. Oradaki elbiseleri de ipektendir.","numberInSurah":23,"juz":17,"manzil":4,"page":334,"ruku":287,"hizbQuarter":134,"sajda":false},{"number":2619,"text":"Bu kimseler, sözün güzelini işitecek duruma ulaştırılmışlar, övülmeğe layık olan Allah'ın yoluna eriştirilmişlerdir.","numberInSurah":24,"juz":17,"manzil":4,"page":335,"ruku":287,"hizbQuarter":134,"sajda":false},{"number":2620,"text":"Doğrusu inkar edenleri, Allah'ın yolundan, yerli ve yolcu bütün insanlar için eşit kılınan Mescidi Haram'dan alıkoyanları ve orada zulm ile yanlış yola saptırmak isteyeni, can yakıcı bir azaba uğratırız.","numberInSurah":25,"juz":17,"manzil":4,"page":335,"ruku":287,"hizbQuarter":134,"sajda":false},{"number":2621,"text":"\"Bana hiçbir şeyi ortak koşma; tavaf edenler, orada kıyama duranlar, rüku edenler ve secdeye varanlar için Evimi temiz tut\" diye İbrahim'i Kabe'nin yerine yerleştirmiştik.","numberInSurah":26,"juz":17,"manzil":4,"page":335,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2622,"text":"İnsanları hacca çağır; yürüyerek veya binekler üstünde uzak yollardan sana gelsinler.","numberInSurah":27,"juz":17,"manzil":4,"page":335,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2623,"text":"Taki kendi menfaatlerine şahid olsunlar; Allah'ın onlara rızık olarak verdiği hayvanları belli günlerde kurban ederken O'nun adını ansınlar. Siz de bunlardan yiyin, çaresiz kalmış yoksulu da doyurun.","numberInSurah":28,"juz":17,"manzil":4,"page":335,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2624,"text":"Sonra kirlerini giderip temizlensinler. Adaklarını yerine getirsinler. Kabe'yi tavaf etsinler.","numberInSurah":29,"juz":17,"manzil":4,"page":335,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2625,"text":"İşte böyle. Kim Allah'ın yasaklarına saygı gösterirse, bu Rabbinin katında kendi iyiliğinedir. (Haram olduğu) size okunanlar dışında kalan hayvanlar, size helal kılındı. O halde pis putlardan sakının; yalan sözden kaçının.","numberInSurah":30,"juz":17,"manzil":4,"page":335,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2626,"text":"Allah'a ortak koşmaksızın O'na yönelerek pis putlardan kaçının, yalan sözden çekinin. Allah'a ortak koşan kimse, gökten düşüp de kuşların kaptığı veya rüzgarın bir uçuruma attığı şeye benzer.","numberInSurah":31,"juz":17,"manzil":4,"page":336,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2627,"text":"Bu böyledir; kişinin Allah'ın nişanelerine hürmet göstermesi, kalblerin Allah'a karşı gelmekten sakınmasındandır.","numberInSurah":32,"juz":17,"manzil":4,"page":336,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2628,"text":"Bu nişanelerde sizin için belli bir süreye kadar faydalar vardır. Sonra bunlar Beyti Atik'de, Kabe'de son bulurlar.","numberInSurah":33,"juz":17,"manzil":4,"page":336,"ruku":288,"hizbQuarter":134,"sajda":false},{"number":2629,"text":"Her ümmet için, Allah'ın kendilerine rızk olarak verdiği kurbanlık hayvanların üzerlerine O'nun adını anarak kurban kesmeyi meşru kıldık. Sizin Tanrınız tek bir Tanrı'dır, O'na teslim olun. Allah anıldığı zaman kalbleri titreyen, başlarına gelene sabreden, namaz kılan, kendilerine verdiğimiz rızıktan sarfeden ve Allah'a gönül vermiş olan kimselere müjde et.","numberInSurah":34,"juz":17,"manzil":4,"page":336,"ruku":289,"hizbQuarter":134,"sajda":false},{"number":2630,"text":"Her ümmet için, Allah'ın kendilerine rızk olarak verdiği kurbanlık hayvanların üzerlerine O'nun adını anarak kurban kesmeyi meşru kıldık. Sizin Tanrınız tek bir Tanrı'dır, O'na teslim olun. Allah anıldığı zaman kalbleri titreyen, başlarına gelene sabreden, namaz kılan, kendilerine verdiğimiz rızıktan sarfeden ve Allah'a gönül vermiş olan kimselere müjde et.","numberInSurah":35,"juz":17,"manzil":4,"page":336,"ruku":289,"hizbQuarter":134,"sajda":false},{"number":2631,"text":"İşte kurbanlık deve ve sığırları Allah'ın size olan nişanelerinden kıldık. Onlarda sizin için hayır vardır. Bağlı halde keserken üzerlerine Allah'ın adını anın. Yan üstü düşüp ölünce onlardan yiyin, isteyene de istemeyene de verin. Şükredersiniz diye onları böylece sizin buyruğunuza verdik.","numberInSurah":36,"juz":17,"manzil":4,"page":336,"ruku":289,"hizbQuarter":134,"sajda":false},{"number":2632,"text":"Bu hayvanların ne etleri ve ne de kanları Allah'a ulaşacaktır. Allah'a ulaşacak olan ancak sizin O'nun için yaptığınız gösterişten uzak amel ve ibadettir. Size doğru yolu gösterdiğinden, Allah'ı yüceltmeniz için onları böylece sizin buyruğunuza vermiştir. İyilik yapanlara müjde et.","numberInSurah":37,"juz":17,"manzil":4,"page":336,"ruku":289,"hizbQuarter":134,"sajda":false},{"number":2633,"text":"Allah şüphesiz inananları savunur, çünkü hainleri ve nankörleri hiç sevmez.","numberInSurah":38,"juz":17,"manzil":4,"page":336,"ruku":289,"hizbQuarter":135,"sajda":false},{"number":2634,"text":"Haksızlığa uğratılarak kendilerine savaş açılan kimselerin karşı koyup savaşmasına izin verilmiştir. Allah onlara yardım etmeğe elbette Kadir'dir.","numberInSurah":39,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2635,"text":"Onlar haksız yere ve \"Rabbimiz Allah'tır\" dediler diye yurtlarından çıkarılmışlardır. Allah insanların bir kısmını diğeriyle savmasaydı, manastırlar, kiliseler, havralar ve içinde Allah'ın adı çok anılan camiler yıkılıp giderdi. And olsun ki, Allah'a yardım edenlere O da yardım eder. Doğrusu Allah kuvvetlidir, güçlüdür.","numberInSurah":40,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2636,"text":"Onları biz yeryüzüne yerleştirirsek namaz kılarlar, zekat verirler, uygun olanı emrederler, fenalığı yasak ederler. İşlerin sonucu Allah'a aittir.","numberInSurah":41,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2637,"text":"Seni yalancı sayıyorlarsa bil ki, onlardan önce Nuh milleti, Ad, Semud, İbrahim milleti, Lut milleti ve Medyen halkı da peygamberlerini yalancı saymış ve Musa da yalanlanmıştı. Ama Ben, kafirlere önce mehil verdim, sonra da onları yakalayıverdim; Beni tanımamak nasılmış görsünler.","numberInSurah":42,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2638,"text":"Seni yalancı sayıyorlarsa bil ki, onlardan önce Nuh milleti, Ad, Semud, İbrahim milleti, Lut milleti ve Medyen halkı da peygamberlerini yalancı saymış ve Musa da yalanlanmıştı. Ama Ben, kafirlere önce mehil verdim, sonra da onları yakalayıverdim; Beni tanımamak nasılmış görsünler.","numberInSurah":43,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2639,"text":"Seni yalancı sayıyorlarsa bil ki, onlardan önce Nuh milleti, Ad, Semud, İbrahim milleti, Lut milleti ve Medyen halkı da peygamberlerini yalancı saymış ve Musa da yalanlanmıştı. Ama Ben, kafirlere önce mehil verdim, sonra da onları yakalayıverdim; Beni tanımamak nasılmış görsünler.","numberInSurah":44,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2640,"text":"Nice kasabaların halkını haksızlık yaparken yok ettik. Artık çatıları çökmüş, kuyuları metruk, sarayları bomboş kalmıştır.","numberInSurah":45,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2641,"text":"Yeryüzünde dolaşmıyorlar mı ki, orada olanları akledecek kalbleri, işitecek kulakları olsun. Ama yalnız gözler kör olmaz, fakat göğüslerde olan kalbler de körleşir.","numberInSurah":46,"juz":17,"manzil":4,"page":337,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2642,"text":"Senden, başlarına acele azap getirmeni istiyorlar. Allah sözünden asla caymayacaktır. Rabbinin katında bir gün, saydıklarınızdan bin yıl gibidir.","numberInSurah":47,"juz":17,"manzil":4,"page":338,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2643,"text":"Nice kasabalara, haksız oldukları halde, mehil vermiştim; sonunda onları yakalayıverdim. Dönüş ancak Bana'dır.","numberInSurah":48,"juz":17,"manzil":4,"page":338,"ruku":290,"hizbQuarter":135,"sajda":false},{"number":2644,"text":"\"Ey insanlar! Ben sizin için ancak apaçık bir uyarıcıyım\" de.","numberInSurah":49,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2645,"text":"Cömertçe verilmiş rızık ve mağfiret, inanan ve yararlı iş işleyenleredir.","numberInSurah":50,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2646,"text":"Ayetlerimizi tartışarak bozmağa uğraşanlar, işte onlar cehennemliklerdir.","numberInSurah":51,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2647,"text":"Senden önce gönderdiğimiz hiçbir resul ve nebi yoktur ki, birşeyi arzuladığı zaman, şeytan onun arzusuna vesvese karıştırmamış olsun. Fakat Allah, şeytanın attığını derhal iptal eder, sonra kendi ayetlerini sağlamlaştırır. Allah bilendir, hüküm ve hikmet sahibidir.","numberInSurah":52,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2648,"text":"/. Allah şeytanın karıştırdığını, kalblerinde hastalık bulunan ve kalbleri kaskatı olan kimseleri sınamayı vesile kılar. Zalimler şüphesiz derin bir ayrılık içindedirler.","numberInSurah":53,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2649,"text":"Bu, kendilerine ilim verilenlerin Kuran'ın, senin Rabbin'den bir gerçek olduğunu bilip de ona inanmaları ve gönüllerini bağlamaları içindir. Allah inananları şüphesiz doğru yola eriştirir.","numberInSurah":54,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2650,"text":"İnkar edenler, ceza saati kendilerine ansızın gelene veya gecesi olmayan günün azabı çatana kadar Kuran'dan şüphe etmekte devam ederler.","numberInSurah":55,"juz":17,"manzil":4,"page":338,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2651,"text":"İşte o gün hükümranlık Allah'ındır. O aralarında hükmeder. İnanıp yararlı iş işleyenler nimet cennetlerindedirler.","numberInSurah":56,"juz":17,"manzil":4,"page":339,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2652,"text":"İnkar edenler, ayetlerimizi yalan sayan kimseler, işte onlar için hakir düşüren azap vardır.","numberInSurah":57,"juz":17,"manzil":4,"page":339,"ruku":291,"hizbQuarter":135,"sajda":false},{"number":2653,"text":"Allah yolunda hicret edenlere, sonra öldürülen veya ölenlere Allah, elbette onlara güzel bir rızık verecektir. Rızık verenlerin en hayırlısı yalnız Allah'tır.","numberInSurah":58,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":135,"sajda":false},{"number":2654,"text":"And olsun ki, onları hoşnut olacakları bir yere koyar. Şüphesiz Allah bilendir, Halim'dir.","numberInSurah":59,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":135,"sajda":false},{"number":2655,"text":"Bu böyledir; kim kendisine verilen kadar ceza verirse ve kendisine yine de saldırılırsa, Allah ona, and olsun ki yardım edecektir. Allah şüphesiz, affeder ve bağışlar.","numberInSurah":60,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":136,"sajda":false},{"number":2656,"text":"Böyledir; Allah geceyi gündüze katar, gündüzü de geceye katar ve Allah şüphesiz işitir ve görür.","numberInSurah":61,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":136,"sajda":false},{"number":2657,"text":"Keza Hak yalnız Allah'tır; O'nu bırakıp taptıkları sadece batıldır. Doğrusu Allah yücedir büyüktür.","numberInSurah":62,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":136,"sajda":false},{"number":2658,"text":"Allah'ın gökten indirdiği su ile yerin yemyeşil olduğunu görmez misin? Doğrusu Allah Latif'dir, haberdardır.","numberInSurah":63,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":136,"sajda":false},{"number":2659,"text":"Göklerde olanlar, yerde olanlar O'nundur. Doğrusu Allah müstağnidir, övülmeğe layık olandır.","numberInSurah":64,"juz":17,"manzil":4,"page":339,"ruku":292,"hizbQuarter":136,"sajda":false},{"number":2660,"text":"Allah'ın yerde olanları ve emriyle denizlerde yürüyen gemileri buyruğunuz altına vermiş olduğunu; buyruğu olmaksızın yere düşmemesi için göğü O'nun tuttuğunu görmez misin? Doğrusu Allah insanlara karşı şefkatli ve merhametli olandır.","numberInSurah":65,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2661,"text":"Sizi dirilten, sonra öldürecek sonra yine diriltecek olan O'dur. İnsan gerçekten pek nankördür.","numberInSurah":66,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2662,"text":"Her ümmete, yerine getirmeleri gerekli ibadetler koyduk. Öyleyse, bu konuda seninle çekişmelerine fırsat verme; Rabbine davet et, sen şüphesiz doğru yol üzerindesin. Seninle tartışırlarsa: \"Allah yaptığınızı çok iyi bilir; ayrılığa düştüğünüz şeyler hakkında, kıyamet günü aranızda Allah hükmedecektir\" de.","numberInSurah":67,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2663,"text":"Her ümmete, yerine getirmeleri gerekli ibadetler koyduk. Öyleyse, bu konuda seninle çekişmelerine fırsat verme; Rabbine davet et, sen şüphesiz doğru yol üzerindesin. Seninle tartışırlarsa: \"Allah yaptığınızı çok iyi bilir; ayrılığa düştüğünüz şeyler hakkında, kıyamet günü aranızda Allah hükmedecektir\" de.","numberInSurah":68,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2664,"text":"Her ümmete, yerine getirmeleri gerekli ibadetler koyduk. Öyleyse, bu konuda seninle çekişmelerine fırsat verme; Rabbine davet et, sen şüphesiz doğru yol üzerindesin. Seninle tartışırlarsa: \"Allah yaptığınızı çok iyi bilir; ayrılığa düştüğünüz şeyler hakkında, kıyamet günü aranızda Allah hükmedecektir\" de.","numberInSurah":69,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2665,"text":"Gökte ve yerde olanı Allah'ın bildiğini bilmez misin? Bunlar hiç şüphesiz Kitap'dadır ve şüphesiz bunlar Allah'a kolaydır.","numberInSurah":70,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2666,"text":"Onlar Allah'ı bırakıp da O'nun, haklarında hiçbir delil indirmediği, kendilerinde de bir bilgi olmayan şeylere taparlar. Zulmedenlerin yardımcısı olmaz.","numberInSurah":71,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2667,"text":"Onlara ayetlerimiz apaçık olarak okunduğu zaman, inkar edenlerin yüzlerinden inkarlarını anlarsın. Nerdeyse, kendilerine ayetlerimizi okuyanlara saldıracaklar. De ki: \"Size bundan daha fenasını haber vereyim mi? Allah'ın inkarcılara vadettiği ateş! Ne kötü bir dönüştür!..","numberInSurah":72,"juz":17,"manzil":4,"page":340,"ruku":293,"hizbQuarter":136,"sajda":false},{"number":2668,"text":"Ey insanlar! Bir misal verilmektedir, şimdi onu dinleyin: Sizlerin Allah'ı bırakıp taptıklarınız bir araya gelseler, bir sinek bile yaratamıyacaklardır. Sinek onlardan bir şey kapsa, onu kurtaramazlar; isteyen de, istenen de aciz!","numberInSurah":73,"juz":17,"manzil":4,"page":341,"ruku":294,"hizbQuarter":136,"sajda":false},{"number":2669,"text":"Allah'ı gereği gibi değerlendiremediler. Doğrusu Allah kuvvetlidir, güçlüdür.","numberInSurah":74,"juz":17,"manzil":4,"page":341,"ruku":294,"hizbQuarter":136,"sajda":false},{"number":2670,"text":"Allah meleklerden ve insanlardan peygamberler seçer. Doğrusu Allah işitir ve görür.","numberInSurah":75,"juz":17,"manzil":4,"page":341,"ruku":294,"hizbQuarter":136,"sajda":false},{"number":2671,"text":"O, geçmişlerini geleceklerini bilir. Bütün işler Allah'a döner.","numberInSurah":76,"juz":17,"manzil":4,"page":341,"ruku":294,"hizbQuarter":136,"sajda":false},{"number":2672,"text":"Ey inananlar! Rüku edin, secdeye varın, Rabbiniz'e kulluk edin, iyilik yapın ki saadete erişesiniz.","numberInSurah":77,"juz":17,"manzil":4,"page":341,"ruku":294,"hizbQuarter":136,"sajda":{"id":7,"recommended":true,"obligatory":false}},{"number":2673,"text":"Allah uğrunda gereği gibi cihat edin. O, sizi seçmiş, babanız İbrahim'in yolu olan dinde sizin için bir zorluk kılmamıştır. Daha önce ve Kuran'da, peygamberin size şahit olması, sizin de insanlara şahit olmanız için size müslüman adını veren O'dur. Artık, namaz kılın, zekat verin, Allah'a sarılın. O sizin sahibinizdir. Ne güzel sahip ve ne güzel yardımcıdır!","numberInSurah":78,"juz":17,"manzil":4,"page":341,"ruku":294,"hizbQuarter":136,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}