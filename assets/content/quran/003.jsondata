{"arabic":{"number":3,"name":"سُورَةُ آلِ عِمۡرَانَ","englishName":"Âl-i İmrân","englishNameTranslation":"The Family of Imraan","revelationType":"Medinan","numberOfAyahs":200,"ayahs":[{"number":294,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الم","numberInSurah":1,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":295,"text":"اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ","numberInSurah":2,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":296,"text":"نَزَّلَ عَلَيْكَ الْكِتَابَ بِالْحَقِّ مُصَدِّقًا لِمَا بَيْنَ يَدَيْهِ وَأَنْزَلَ التَّوْرَاةَ وَالْإِنْجِيلَ","numberInSurah":3,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":297,"text":"مِنْ قَبْلُ هُدًى لِلنَّاسِ وَأَنْزَلَ الْفُرْقَانَ ۗ إِنَّ الَّذِينَ كَفَرُوا بِآيَاتِ اللَّهِ لَهُمْ عَذَابٌ شَدِيدٌ ۗ وَاللَّهُ عَزِيزٌ ذُو انْتِقَامٍ","numberInSurah":4,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":298,"text":"إِنَّ اللَّهَ لَا يَخْفَىٰ عَلَيْهِ شَيْءٌ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ","numberInSurah":5,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":299,"text":"هُوَ الَّذِي يُصَوِّرُكُمْ فِي الْأَرْحَامِ كَيْفَ يَشَاءُ ۚ لَا إِلَٰهَ إِلَّا هُوَ الْعَزِيزُ الْحَكِيمُ","numberInSurah":6,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":300,"text":"هُوَ الَّذِي أَنْزَلَ عَلَيْكَ الْكِتَابَ مِنْهُ آيَاتٌ مُحْكَمَاتٌ هُنَّ أُمُّ الْكِتَابِ وَأُخَرُ مُتَشَابِهَاتٌ ۖ فَأَمَّا الَّذِينَ فِي قُلُوبِهِمْ زَيْغٌ فَيَتَّبِعُونَ مَا تَشَابَهَ مِنْهُ ابْتِغَاءَ الْفِتْنَةِ وَابْتِغَاءَ تَأْوِيلِهِ ۗ وَمَا يَعْلَمُ تَأْوِيلَهُ إِلَّا اللَّهُ ۗ وَالرَّاسِخُونَ فِي الْعِلْمِ يَقُولُونَ آمَنَّا بِهِ كُلٌّ مِنْ عِنْدِ رَبِّنَا ۗ وَمَا يَذَّكَّرُ إِلَّا أُولُو الْأَلْبَابِ","numberInSurah":7,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":301,"text":"رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَبْ لَنَا مِنْ لَدُنْكَ رَحْمَةً ۚ إِنَّكَ أَنْتَ الْوَهَّابُ","numberInSurah":8,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":302,"text":"رَبَّنَا إِنَّكَ جَامِعُ النَّاسِ لِيَوْمٍ لَا رَيْبَ فِيهِ ۚ إِنَّ اللَّهَ لَا يُخْلِفُ الْمِيعَادَ","numberInSurah":9,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":303,"text":"إِنَّ الَّذِينَ كَفَرُوا لَنْ تُغْنِيَ عَنْهُمْ أَمْوَالُهُمْ وَلَا أَوْلَادُهُمْ مِنَ اللَّهِ شَيْئًا ۖ وَأُولَٰئِكَ هُمْ وَقُودُ النَّارِ","numberInSurah":10,"juz":3,"manzil":1,"page":51,"ruku":43,"hizbQuarter":20,"sajda":false},{"number":304,"text":"كَدَأْبِ آلِ فِرْعَوْنَ وَالَّذِينَ مِنْ قَبْلِهِمْ ۚ كَذَّبُوا بِآيَاتِنَا فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ ۗ وَاللَّهُ شَدِيدُ الْعِقَابِ","numberInSurah":11,"juz":3,"manzil":1,"page":51,"ruku":43,"hizbQuarter":20,"sajda":false},{"number":305,"text":"قُلْ لِلَّذِينَ كَفَرُوا سَتُغْلَبُونَ وَتُحْشَرُونَ إِلَىٰ جَهَنَّمَ ۚ وَبِئْسَ الْمِهَادُ","numberInSurah":12,"juz":3,"manzil":1,"page":51,"ruku":43,"hizbQuarter":20,"sajda":false},{"number":306,"text":"قَدْ كَانَ لَكُمْ آيَةٌ فِي فِئَتَيْنِ الْتَقَتَا ۖ فِئَةٌ تُقَاتِلُ فِي سَبِيلِ اللَّهِ وَأُخْرَىٰ كَافِرَةٌ يَرَوْنَهُمْ مِثْلَيْهِمْ رَأْيَ الْعَيْنِ ۚ وَاللَّهُ يُؤَيِّدُ بِنَصْرِهِ مَنْ يَشَاءُ ۗ إِنَّ فِي ذَٰلِكَ لَعِبْرَةً لِأُولِي الْأَبْصَارِ","numberInSurah":13,"juz":3,"manzil":1,"page":51,"ruku":43,"hizbQuarter":20,"sajda":false},{"number":307,"text":"زُيِّنَ لِلنَّاسِ حُبُّ الشَّهَوَاتِ مِنَ النِّسَاءِ وَالْبَنِينَ وَالْقَنَاطِيرِ الْمُقَنْطَرَةِ مِنَ الذَّهَبِ وَالْفِضَّةِ وَالْخَيْلِ الْمُسَوَّمَةِ وَالْأَنْعَامِ وَالْحَرْثِ ۗ ذَٰلِكَ مَتَاعُ الْحَيَاةِ الدُّنْيَا ۖ وَاللَّهُ عِنْدَهُ حُسْنُ الْمَآبِ","numberInSurah":14,"juz":3,"manzil":1,"page":51,"ruku":43,"hizbQuarter":20,"sajda":false},{"number":308,"text":"۞ قُلْ أَؤُنَبِّئُكُمْ بِخَيْرٍ مِنْ ذَٰلِكُمْ ۚ لِلَّذِينَ اتَّقَوْا عِنْدَ رَبِّهِمْ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا وَأَزْوَاجٌ مُطَهَّرَةٌ وَرِضْوَانٌ مِنَ اللَّهِ ۗ وَاللَّهُ بَصِيرٌ بِالْعِبَادِ","numberInSurah":15,"juz":3,"manzil":1,"page":51,"ruku":43,"hizbQuarter":21,"sajda":false},{"number":309,"text":"الَّذِينَ يَقُولُونَ رَبَّنَا إِنَّنَا آمَنَّا فَاغْفِرْ لَنَا ذُنُوبَنَا وَقِنَا عَذَابَ النَّارِ","numberInSurah":16,"juz":3,"manzil":1,"page":52,"ruku":43,"hizbQuarter":21,"sajda":false},{"number":310,"text":"الصَّابِرِينَ وَالصَّادِقِينَ وَالْقَانِتِينَ وَالْمُنْفِقِينَ وَالْمُسْتَغْفِرِينَ بِالْأَسْحَارِ","numberInSurah":17,"juz":3,"manzil":1,"page":52,"ruku":43,"hizbQuarter":21,"sajda":false},{"number":311,"text":"شَهِدَ اللَّهُ أَنَّهُ لَا إِلَٰهَ إِلَّا هُوَ وَالْمَلَائِكَةُ وَأُولُو الْعِلْمِ قَائِمًا بِالْقِسْطِ ۚ لَا إِلَٰهَ إِلَّا هُوَ الْعَزِيزُ الْحَكِيمُ","numberInSurah":18,"juz":3,"manzil":1,"page":52,"ruku":43,"hizbQuarter":21,"sajda":false},{"number":312,"text":"إِنَّ الدِّينَ عِنْدَ اللَّهِ الْإِسْلَامُ ۗ وَمَا اخْتَلَفَ الَّذِينَ أُوتُوا الْكِتَابَ إِلَّا مِنْ بَعْدِ مَا جَاءَهُمُ الْعِلْمُ بَغْيًا بَيْنَهُمْ ۗ وَمَنْ يَكْفُرْ بِآيَاتِ اللَّهِ فَإِنَّ اللَّهَ سَرِيعُ الْحِسَابِ","numberInSurah":19,"juz":3,"manzil":1,"page":52,"ruku":43,"hizbQuarter":21,"sajda":false},{"number":313,"text":"فَإِنْ حَاجُّوكَ فَقُلْ أَسْلَمْتُ وَجْهِيَ لِلَّهِ وَمَنِ اتَّبَعَنِ ۗ وَقُلْ لِلَّذِينَ أُوتُوا الْكِتَابَ وَالْأُمِّيِّينَ أَأَسْلَمْتُمْ ۚ فَإِنْ أَسْلَمُوا فَقَدِ اهْتَدَوْا ۖ وَإِنْ تَوَلَّوْا فَإِنَّمَا عَلَيْكَ الْبَلَاغُ ۗ وَاللَّهُ بَصِيرٌ بِالْعِبَادِ","numberInSurah":20,"juz":3,"manzil":1,"page":52,"ruku":43,"hizbQuarter":21,"sajda":false},{"number":314,"text":"إِنَّ الَّذِينَ يَكْفُرُونَ بِآيَاتِ اللَّهِ وَيَقْتُلُونَ النَّبِيِّينَ بِغَيْرِ حَقٍّ وَيَقْتُلُونَ الَّذِينَ يَأْمُرُونَ بِالْقِسْطِ مِنَ النَّاسِ فَبَشِّرْهُمْ بِعَذَابٍ أَلِيمٍ","numberInSurah":21,"juz":3,"manzil":1,"page":52,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":315,"text":"أُولَٰئِكَ الَّذِينَ حَبِطَتْ أَعْمَالُهُمْ فِي الدُّنْيَا وَالْآخِرَةِ وَمَا لَهُمْ مِنْ نَاصِرِينَ","numberInSurah":22,"juz":3,"manzil":1,"page":52,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":316,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ أُوتُوا نَصِيبًا مِنَ الْكِتَابِ يُدْعَوْنَ إِلَىٰ كِتَابِ اللَّهِ لِيَحْكُمَ بَيْنَهُمْ ثُمَّ يَتَوَلَّىٰ فَرِيقٌ مِنْهُمْ وَهُمْ مُعْرِضُونَ","numberInSurah":23,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":317,"text":"ذَٰلِكَ بِأَنَّهُمْ قَالُوا لَنْ تَمَسَّنَا النَّارُ إِلَّا أَيَّامًا مَعْدُودَاتٍ ۖ وَغَرَّهُمْ فِي دِينِهِمْ مَا كَانُوا يَفْتَرُونَ","numberInSurah":24,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":318,"text":"فَكَيْفَ إِذَا جَمَعْنَاهُمْ لِيَوْمٍ لَا رَيْبَ فِيهِ وَوُفِّيَتْ كُلُّ نَفْسٍ مَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ","numberInSurah":25,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":319,"text":"قُلِ اللَّهُمَّ مَالِكَ الْمُلْكِ تُؤْتِي الْمُلْكَ مَنْ تَشَاءُ وَتَنْزِعُ الْمُلْكَ مِمَّنْ تَشَاءُ وَتُعِزُّ مَنْ تَشَاءُ وَتُذِلُّ مَنْ تَشَاءُ ۖ بِيَدِكَ الْخَيْرُ ۖ إِنَّكَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":26,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":320,"text":"تُولِجُ اللَّيْلَ فِي النَّهَارِ وَتُولِجُ النَّهَارَ فِي اللَّيْلِ ۖ وَتُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَتُخْرِجُ الْمَيِّتَ مِنَ الْحَيِّ ۖ وَتَرْزُقُ مَنْ تَشَاءُ بِغَيْرِ حِسَابٍ","numberInSurah":27,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":321,"text":"لَا يَتَّخِذِ الْمُؤْمِنُونَ الْكَافِرِينَ أَوْلِيَاءَ مِنْ دُونِ الْمُؤْمِنِينَ ۖ وَمَنْ يَفْعَلْ ذَٰلِكَ فَلَيْسَ مِنَ اللَّهِ فِي شَيْءٍ إِلَّا أَنْ تَتَّقُوا مِنْهُمْ تُقَاةً ۗ وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ ۗ وَإِلَى اللَّهِ الْمَصِيرُ","numberInSurah":28,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":322,"text":"قُلْ إِنْ تُخْفُوا مَا فِي صُدُورِكُمْ أَوْ تُبْدُوهُ يَعْلَمْهُ اللَّهُ ۗ وَيَعْلَمُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":29,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":323,"text":"يَوْمَ تَجِدُ كُلُّ نَفْسٍ مَا عَمِلَتْ مِنْ خَيْرٍ مُحْضَرًا وَمَا عَمِلَتْ مِنْ سُوءٍ تَوَدُّ لَوْ أَنَّ بَيْنَهَا وَبَيْنَهُ أَمَدًا بَعِيدًا ۗ وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ ۗ وَاللَّهُ رَءُوفٌ بِالْعِبَادِ","numberInSurah":30,"juz":3,"manzil":1,"page":54,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":324,"text":"قُلْ إِنْ كُنْتُمْ تُحِبُّونَ اللَّهَ فَاتَّبِعُونِي يُحْبِبْكُمُ اللَّهُ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ ۗ وَاللَّهُ غَفُورٌ رَحِيمٌ","numberInSurah":31,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":21,"sajda":false},{"number":325,"text":"قُلْ أَطِيعُوا اللَّهَ وَالرَّسُولَ ۖ فَإِنْ تَوَلَّوْا فَإِنَّ اللَّهَ لَا يُحِبُّ الْكَافِرِينَ","numberInSurah":32,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":21,"sajda":false},{"number":326,"text":"۞ إِنَّ اللَّهَ اصْطَفَىٰ آدَمَ وَنُوحًا وَآلَ إِبْرَاهِيمَ وَآلَ عِمْرَانَ عَلَى الْعَالَمِينَ","numberInSurah":33,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":327,"text":"ذُرِّيَّةً بَعْضُهَا مِنْ بَعْضٍ ۗ وَاللَّهُ سَمِيعٌ عَلِيمٌ","numberInSurah":34,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":328,"text":"إِذْ قَالَتِ امْرَأَتُ عِمْرَانَ رَبِّ إِنِّي نَذَرْتُ لَكَ مَا فِي بَطْنِي مُحَرَّرًا فَتَقَبَّلْ مِنِّي ۖ إِنَّكَ أَنْتَ السَّمِيعُ الْعَلِيمُ","numberInSurah":35,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":329,"text":"فَلَمَّا وَضَعَتْهَا قَالَتْ رَبِّ إِنِّي وَضَعْتُهَا أُنْثَىٰ وَاللَّهُ أَعْلَمُ بِمَا وَضَعَتْ وَلَيْسَ الذَّكَرُ كَالْأُنْثَىٰ ۖ وَإِنِّي سَمَّيْتُهَا مَرْيَمَ وَإِنِّي أُعِيذُهَا بِكَ وَذُرِّيَّتَهَا مِنَ الشَّيْطَانِ الرَّجِيمِ","numberInSurah":36,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":330,"text":"فَتَقَبَّلَهَا رَبُّهَا بِقَبُولٍ حَسَنٍ وَأَنْبَتَهَا نَبَاتًا حَسَنًا وَكَفَّلَهَا زَكَرِيَّا ۖ كُلَّمَا دَخَلَ عَلَيْهَا زَكَرِيَّا الْمِحْرَابَ وَجَدَ عِنْدَهَا رِزْقًا ۖ قَالَ يَا مَرْيَمُ أَنَّىٰ لَكِ هَٰذَا ۖ قَالَتْ هُوَ مِنْ عِنْدِ اللَّهِ ۖ إِنَّ اللَّهَ يَرْزُقُ مَنْ يَشَاءُ بِغَيْرِ حِسَابٍ","numberInSurah":37,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":331,"text":"هُنَالِكَ دَعَا زَكَرِيَّا رَبَّهُ ۖ قَالَ رَبِّ هَبْ لِي مِنْ لَدُنْكَ ذُرِّيَّةً طَيِّبَةً ۖ إِنَّكَ سَمِيعُ الدُّعَاءِ","numberInSurah":38,"juz":3,"manzil":1,"page":55,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":332,"text":"فَنَادَتْهُ الْمَلَائِكَةُ وَهُوَ قَائِمٌ يُصَلِّي فِي الْمِحْرَابِ أَنَّ اللَّهَ يُبَشِّرُكَ بِيَحْيَىٰ مُصَدِّقًا بِكَلِمَةٍ مِنَ اللَّهِ وَسَيِّدًا وَحَصُورًا وَنَبِيًّا مِنَ الصَّالِحِينَ","numberInSurah":39,"juz":3,"manzil":1,"page":55,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":333,"text":"قَالَ رَبِّ أَنَّىٰ يَكُونُ لِي غُلَامٌ وَقَدْ بَلَغَنِيَ الْكِبَرُ وَامْرَأَتِي عَاقِرٌ ۖ قَالَ كَذَٰلِكَ اللَّهُ يَفْعَلُ مَا يَشَاءُ","numberInSurah":40,"juz":3,"manzil":1,"page":55,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":334,"text":"قَالَ رَبِّ اجْعَلْ لِي آيَةً ۖ قَالَ آيَتُكَ أَلَّا تُكَلِّمَ النَّاسَ ثَلَاثَةَ أَيَّامٍ إِلَّا رَمْزًا ۗ وَاذْكُرْ رَبَّكَ كَثِيرًا وَسَبِّحْ بِالْعَشِيِّ وَالْإِبْكَارِ","numberInSurah":41,"juz":3,"manzil":1,"page":55,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":335,"text":"وَإِذْ قَالَتِ الْمَلَائِكَةُ يَا مَرْيَمُ إِنَّ اللَّهَ اصْطَفَاكِ وَطَهَّرَكِ وَاصْطَفَاكِ عَلَىٰ نِسَاءِ الْعَالَمِينَ","numberInSurah":42,"juz":3,"manzil":1,"page":55,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":336,"text":"يَا مَرْيَمُ اقْنُتِي لِرَبِّكِ وَاسْجُدِي وَارْكَعِي مَعَ الرَّاكِعِينَ","numberInSurah":43,"juz":3,"manzil":1,"page":55,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":337,"text":"ذَٰلِكَ مِنْ أَنْبَاءِ الْغَيْبِ نُوحِيهِ إِلَيْكَ ۚ وَمَا كُنْتَ لَدَيْهِمْ إِذْ يُلْقُونَ أَقْلَامَهُمْ أَيُّهُمْ يَكْفُلُ مَرْيَمَ وَمَا كُنْتَ لَدَيْهِمْ إِذْ يَخْتَصِمُونَ","numberInSurah":44,"juz":3,"manzil":1,"page":55,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":338,"text":"إِذْ قَالَتِ الْمَلَائِكَةُ يَا مَرْيَمُ إِنَّ اللَّهَ يُبَشِّرُكِ بِكَلِمَةٍ مِنْهُ اسْمُهُ الْمَسِيحُ عِيسَى ابْنُ مَرْيَمَ وَجِيهًا فِي الدُّنْيَا وَالْآخِرَةِ وَمِنَ الْمُقَرَّبِينَ","numberInSurah":45,"juz":3,"manzil":1,"page":55,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":339,"text":"وَيُكَلِّمُ النَّاسَ فِي الْمَهْدِ وَكَهْلًا وَمِنَ الصَّالِحِينَ","numberInSurah":46,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":340,"text":"قَالَتْ رَبِّ أَنَّىٰ يَكُونُ لِي وَلَدٌ وَلَمْ يَمْسَسْنِي بَشَرٌ ۖ قَالَ كَذَٰلِكِ اللَّهُ يَخْلُقُ مَا يَشَاءُ ۚ إِذَا قَضَىٰ أَمْرًا فَإِنَّمَا يَقُولُ لَهُ كُنْ فَيَكُونُ","numberInSurah":47,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":341,"text":"وَيُعَلِّمُهُ الْكِتَابَ وَالْحِكْمَةَ وَالتَّوْرَاةَ وَالْإِنْجِيلَ","numberInSurah":48,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":342,"text":"وَرَسُولًا إِلَىٰ بَنِي إِسْرَائِيلَ أَنِّي قَدْ جِئْتُكُمْ بِآيَةٍ مِنْ رَبِّكُمْ ۖ أَنِّي أَخْلُقُ لَكُمْ مِنَ الطِّينِ كَهَيْئَةِ الطَّيْرِ فَأَنْفُخُ فِيهِ فَيَكُونُ طَيْرًا بِإِذْنِ اللَّهِ ۖ وَأُبْرِئُ الْأَكْمَهَ وَالْأَبْرَصَ وَأُحْيِي الْمَوْتَىٰ بِإِذْنِ اللَّهِ ۖ وَأُنَبِّئُكُمْ بِمَا تَأْكُلُونَ وَمَا تَدَّخِرُونَ فِي بُيُوتِكُمْ ۚ إِنَّ فِي ذَٰلِكَ لَآيَةً لَكُمْ إِنْ كُنْتُمْ مُؤْمِنِينَ","numberInSurah":49,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":343,"text":"وَمُصَدِّقًا لِمَا بَيْنَ يَدَيَّ مِنَ التَّوْرَاةِ وَلِأُحِلَّ لَكُمْ بَعْضَ الَّذِي حُرِّمَ عَلَيْكُمْ ۚ وَجِئْتُكُمْ بِآيَةٍ مِنْ رَبِّكُمْ فَاتَّقُوا اللَّهَ وَأَطِيعُونِ","numberInSurah":50,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":344,"text":"إِنَّ اللَّهَ رَبِّي وَرَبُّكُمْ فَاعْبُدُوهُ ۗ هَٰذَا صِرَاطٌ مُسْتَقِيمٌ","numberInSurah":51,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":345,"text":"۞ فَلَمَّا أَحَسَّ عِيسَىٰ مِنْهُمُ الْكُفْرَ قَالَ مَنْ أَنْصَارِي إِلَى اللَّهِ ۖ قَالَ الْحَوَارِيُّونَ نَحْنُ أَنْصَارُ اللَّهِ آمَنَّا بِاللَّهِ وَاشْهَدْ بِأَنَّا مُسْلِمُونَ","numberInSurah":52,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":23,"sajda":false},{"number":346,"text":"رَبَّنَا آمَنَّا بِمَا أَنْزَلْتَ وَاتَّبَعْنَا الرَّسُولَ فَاكْتُبْنَا مَعَ الشَّاهِدِينَ","numberInSurah":53,"juz":3,"manzil":1,"page":57,"ruku":46,"hizbQuarter":23,"sajda":false},{"number":347,"text":"وَمَكَرُوا وَمَكَرَ اللَّهُ ۖ وَاللَّهُ خَيْرُ الْمَاكِرِينَ","numberInSurah":54,"juz":3,"manzil":1,"page":57,"ruku":46,"hizbQuarter":23,"sajda":false},{"number":348,"text":"إِذْ قَالَ اللَّهُ يَا عِيسَىٰ إِنِّي مُتَوَفِّيكَ وَرَافِعُكَ إِلَيَّ وَمُطَهِّرُكَ مِنَ الَّذِينَ كَفَرُوا وَجَاعِلُ الَّذِينَ اتَّبَعُوكَ فَوْقَ الَّذِينَ كَفَرُوا إِلَىٰ يَوْمِ الْقِيَامَةِ ۖ ثُمَّ إِلَيَّ مَرْجِعُكُمْ فَأَحْكُمُ بَيْنَكُمْ فِيمَا كُنْتُمْ فِيهِ تَخْتَلِفُونَ","numberInSurah":55,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":349,"text":"فَأَمَّا الَّذِينَ كَفَرُوا فَأُعَذِّبُهُمْ عَذَابًا شَدِيدًا فِي الدُّنْيَا وَالْآخِرَةِ وَمَا لَهُمْ مِنْ نَاصِرِينَ","numberInSurah":56,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":350,"text":"وَأَمَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَيُوَفِّيهِمْ أُجُورَهُمْ ۗ وَاللَّهُ لَا يُحِبُّ الظَّالِمِينَ","numberInSurah":57,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":351,"text":"ذَٰلِكَ نَتْلُوهُ عَلَيْكَ مِنَ الْآيَاتِ وَالذِّكْرِ الْحَكِيمِ","numberInSurah":58,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":352,"text":"إِنَّ مَثَلَ عِيسَىٰ عِنْدَ اللَّهِ كَمَثَلِ آدَمَ ۖ خَلَقَهُ مِنْ تُرَابٍ ثُمَّ قَالَ لَهُ كُنْ فَيَكُونُ","numberInSurah":59,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":353,"text":"الْحَقُّ مِنْ رَبِّكَ فَلَا تَكُنْ مِنَ الْمُمْتَرِينَ","numberInSurah":60,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":354,"text":"فَمَنْ حَاجَّكَ فِيهِ مِنْ بَعْدِ مَا جَاءَكَ مِنَ الْعِلْمِ فَقُلْ تَعَالَوْا نَدْعُ أَبْنَاءَنَا وَأَبْنَاءَكُمْ وَنِسَاءَنَا وَنِسَاءَكُمْ وَأَنْفُسَنَا وَأَنْفُسَكُمْ ثُمَّ نَبْتَهِلْ فَنَجْعَلْ لَعْنَتَ اللَّهِ عَلَى الْكَاذِبِينَ","numberInSurah":61,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":355,"text":"إِنَّ هَٰذَا لَهُوَ الْقَصَصُ الْحَقُّ ۚ وَمَا مِنْ إِلَٰهٍ إِلَّا اللَّهُ ۚ وَإِنَّ اللَّهَ لَهُوَ الْعَزِيزُ الْحَكِيمُ","numberInSurah":62,"juz":3,"manzil":1,"page":58,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":356,"text":"فَإِنْ تَوَلَّوْا فَإِنَّ اللَّهَ عَلِيمٌ بِالْمُفْسِدِينَ","numberInSurah":63,"juz":3,"manzil":1,"page":58,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":357,"text":"قُلْ يَا أَهْلَ الْكِتَابِ تَعَالَوْا إِلَىٰ كَلِمَةٍ سَوَاءٍ بَيْنَنَا وَبَيْنَكُمْ أَلَّا نَعْبُدَ إِلَّا اللَّهَ وَلَا نُشْرِكَ بِهِ شَيْئًا وَلَا يَتَّخِذَ بَعْضُنَا بَعْضًا أَرْبَابًا مِنْ دُونِ اللَّهِ ۚ فَإِنْ تَوَلَّوْا فَقُولُوا اشْهَدُوا بِأَنَّا مُسْلِمُونَ","numberInSurah":64,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":358,"text":"يَا أَهْلَ الْكِتَابِ لِمَ تُحَاجُّونَ فِي إِبْرَاهِيمَ وَمَا أُنْزِلَتِ التَّوْرَاةُ وَالْإِنْجِيلُ إِلَّا مِنْ بَعْدِهِ ۚ أَفَلَا تَعْقِلُونَ","numberInSurah":65,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":359,"text":"هَا أَنْتُمْ هَٰؤُلَاءِ حَاجَجْتُمْ فِيمَا لَكُمْ بِهِ عِلْمٌ فَلِمَ تُحَاجُّونَ فِيمَا لَيْسَ لَكُمْ بِهِ عِلْمٌ ۚ وَاللَّهُ يَعْلَمُ وَأَنْتُمْ لَا تَعْلَمُونَ","numberInSurah":66,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":360,"text":"مَا كَانَ إِبْرَاهِيمُ يَهُودِيًّا وَلَا نَصْرَانِيًّا وَلَٰكِنْ كَانَ حَنِيفًا مُسْلِمًا وَمَا كَانَ مِنَ الْمُشْرِكِينَ","numberInSurah":67,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":361,"text":"إِنَّ أَوْلَى النَّاسِ بِإِبْرَاهِيمَ لَلَّذِينَ اتَّبَعُوهُ وَهَٰذَا النَّبِيُّ وَالَّذِينَ آمَنُوا ۗ وَاللَّهُ وَلِيُّ الْمُؤْمِنِينَ","numberInSurah":68,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":362,"text":"وَدَّتْ طَائِفَةٌ مِنْ أَهْلِ الْكِتَابِ لَوْ يُضِلُّونَكُمْ وَمَا يُضِلُّونَ إِلَّا أَنْفُسَهُمْ وَمَا يَشْعُرُونَ","numberInSurah":69,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":363,"text":"يَا أَهْلَ الْكِتَابِ لِمَ تَكْفُرُونَ بِآيَاتِ اللَّهِ وَأَنْتُمْ تَشْهَدُونَ","numberInSurah":70,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":364,"text":"يَا أَهْلَ الْكِتَابِ لِمَ تَلْبِسُونَ الْحَقَّ بِالْبَاطِلِ وَتَكْتُمُونَ الْحَقَّ وَأَنْتُمْ تَعْلَمُونَ","numberInSurah":71,"juz":3,"manzil":1,"page":59,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":365,"text":"وَقَالَتْ طَائِفَةٌ مِنْ أَهْلِ الْكِتَابِ آمِنُوا بِالَّذِي أُنْزِلَ عَلَى الَّذِينَ آمَنُوا وَجْهَ النَّهَارِ وَاكْفُرُوا آخِرَهُ لَعَلَّهُمْ يَرْجِعُونَ","numberInSurah":72,"juz":3,"manzil":1,"page":59,"ruku":49,"hizbQuarter":23,"sajda":false},{"number":366,"text":"وَلَا تُؤْمِنُوا إِلَّا لِمَنْ تَبِعَ دِينَكُمْ قُلْ إِنَّ الْهُدَىٰ هُدَى اللَّهِ أَنْ يُؤْتَىٰ أَحَدٌ مِثْلَ مَا أُوتِيتُمْ أَوْ يُحَاجُّوكُمْ عِنْدَ رَبِّكُمْ ۗ قُلْ إِنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ ۗ وَاللَّهُ وَاسِعٌ عَلِيمٌ","numberInSurah":73,"juz":3,"manzil":1,"page":59,"ruku":49,"hizbQuarter":23,"sajda":false},{"number":367,"text":"يَخْتَصُّ بِرَحْمَتِهِ مَنْ يَشَاءُ ۗ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ","numberInSurah":74,"juz":3,"manzil":1,"page":59,"ruku":49,"hizbQuarter":23,"sajda":false},{"number":368,"text":"۞ وَمِنْ أَهْلِ الْكِتَابِ مَنْ إِنْ تَأْمَنْهُ بِقِنْطَارٍ يُؤَدِّهِ إِلَيْكَ وَمِنْهُمْ مَنْ إِنْ تَأْمَنْهُ بِدِينَارٍ لَا يُؤَدِّهِ إِلَيْكَ إِلَّا مَا دُمْتَ عَلَيْهِ قَائِمًا ۗ ذَٰلِكَ بِأَنَّهُمْ قَالُوا لَيْسَ عَلَيْنَا فِي الْأُمِّيِّينَ سَبِيلٌ وَيَقُولُونَ عَلَى اللَّهِ الْكَذِبَ وَهُمْ يَعْلَمُونَ","numberInSurah":75,"juz":3,"manzil":1,"page":59,"ruku":49,"hizbQuarter":24,"sajda":false},{"number":369,"text":"بَلَىٰ مَنْ أَوْفَىٰ بِعَهْدِهِ وَاتَّقَىٰ فَإِنَّ اللَّهَ يُحِبُّ الْمُتَّقِينَ","numberInSurah":76,"juz":3,"manzil":1,"page":59,"ruku":49,"hizbQuarter":24,"sajda":false},{"number":370,"text":"إِنَّ الَّذِينَ يَشْتَرُونَ بِعَهْدِ اللَّهِ وَأَيْمَانِهِمْ ثَمَنًا قَلِيلًا أُولَٰئِكَ لَا خَلَاقَ لَهُمْ فِي الْآخِرَةِ وَلَا يُكَلِّمُهُمُ اللَّهُ وَلَا يَنْظُرُ إِلَيْهِمْ يَوْمَ الْقِيَامَةِ وَلَا يُزَكِّيهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ","numberInSurah":77,"juz":3,"manzil":1,"page":59,"ruku":49,"hizbQuarter":24,"sajda":false},{"number":371,"text":"وَإِنَّ مِنْهُمْ لَفَرِيقًا يَلْوُونَ أَلْسِنَتَهُمْ بِالْكِتَابِ لِتَحْسَبُوهُ مِنَ الْكِتَابِ وَمَا هُوَ مِنَ الْكِتَابِ وَيَقُولُونَ هُوَ مِنْ عِنْدِ اللَّهِ وَمَا هُوَ مِنْ عِنْدِ اللَّهِ وَيَقُولُونَ عَلَى اللَّهِ الْكَذِبَ وَهُمْ يَعْلَمُونَ","numberInSurah":78,"juz":3,"manzil":1,"page":60,"ruku":49,"hizbQuarter":24,"sajda":false},{"number":372,"text":"مَا كَانَ لِبَشَرٍ أَنْ يُؤْتِيَهُ اللَّهُ الْكِتَابَ وَالْحُكْمَ وَالنُّبُوَّةَ ثُمَّ يَقُولَ لِلنَّاسِ كُونُوا عِبَادًا لِي مِنْ دُونِ اللَّهِ وَلَٰكِنْ كُونُوا رَبَّانِيِّينَ بِمَا كُنْتُمْ تُعَلِّمُونَ الْكِتَابَ وَبِمَا كُنْتُمْ تَدْرُسُونَ","numberInSurah":79,"juz":3,"manzil":1,"page":60,"ruku":49,"hizbQuarter":24,"sajda":false},{"number":373,"text":"وَلَا يَأْمُرَكُمْ أَنْ تَتَّخِذُوا الْمَلَائِكَةَ وَالنَّبِيِّينَ أَرْبَابًا ۗ أَيَأْمُرُكُمْ بِالْكُفْرِ بَعْدَ إِذْ أَنْتُمْ مُسْلِمُونَ","numberInSurah":80,"juz":3,"manzil":1,"page":60,"ruku":49,"hizbQuarter":24,"sajda":false},{"number":374,"text":"وَإِذْ أَخَذَ اللَّهُ مِيثَاقَ النَّبِيِّينَ لَمَا آتَيْتُكُمْ مِنْ كِتَابٍ وَحِكْمَةٍ ثُمَّ جَاءَكُمْ رَسُولٌ مُصَدِّقٌ لِمَا مَعَكُمْ لَتُؤْمِنُنَّ بِهِ وَلَتَنْصُرُنَّهُ ۚ قَالَ أَأَقْرَرْتُمْ وَأَخَذْتُمْ عَلَىٰ ذَٰلِكُمْ إِصْرِي ۖ قَالُوا أَقْرَرْنَا ۚ قَالَ فَاشْهَدُوا وَأَنَا مَعَكُمْ مِنَ الشَّاهِدِينَ","numberInSurah":81,"juz":3,"manzil":1,"page":60,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":375,"text":"فَمَنْ تَوَلَّىٰ بَعْدَ ذَٰلِكَ فَأُولَٰئِكَ هُمُ الْفَاسِقُونَ","numberInSurah":82,"juz":3,"manzil":1,"page":60,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":376,"text":"أَفَغَيْرَ دِينِ اللَّهِ يَبْغُونَ وَلَهُ أَسْلَمَ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ طَوْعًا وَكَرْهًا وَإِلَيْهِ يُرْجَعُونَ","numberInSurah":83,"juz":3,"manzil":1,"page":60,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":377,"text":"قُلْ آمَنَّا بِاللَّهِ وَمَا أُنْزِلَ عَلَيْنَا وَمَا أُنْزِلَ عَلَىٰ إِبْرَاهِيمَ وَإِسْمَاعِيلَ وَإِسْحَاقَ وَيَعْقُوبَ وَالْأَسْبَاطِ وَمَا أُوتِيَ مُوسَىٰ وَعِيسَىٰ وَالنَّبِيُّونَ مِنْ رَبِّهِمْ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِنْهُمْ وَنَحْنُ لَهُ مُسْلِمُونَ","numberInSurah":84,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":378,"text":"وَمَنْ يَبْتَغِ غَيْرَ الْإِسْلَامِ دِينًا فَلَنْ يُقْبَلَ مِنْهُ وَهُوَ فِي الْآخِرَةِ مِنَ الْخَاسِرِينَ","numberInSurah":85,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":379,"text":"كَيْفَ يَهْدِي اللَّهُ قَوْمًا كَفَرُوا بَعْدَ إِيمَانِهِمْ وَشَهِدُوا أَنَّ الرَّسُولَ حَقٌّ وَجَاءَهُمُ الْبَيِّنَاتُ ۚ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ","numberInSurah":86,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":380,"text":"أُولَٰئِكَ جَزَاؤُهُمْ أَنَّ عَلَيْهِمْ لَعْنَةَ اللَّهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ","numberInSurah":87,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":381,"text":"خَالِدِينَ فِيهَا لَا يُخَفَّفُ عَنْهُمُ الْعَذَابُ وَلَا هُمْ يُنْظَرُونَ","numberInSurah":88,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":382,"text":"إِلَّا الَّذِينَ تَابُوا مِنْ بَعْدِ ذَٰلِكَ وَأَصْلَحُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","numberInSurah":89,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":383,"text":"إِنَّ الَّذِينَ كَفَرُوا بَعْدَ إِيمَانِهِمْ ثُمَّ ازْدَادُوا كُفْرًا لَنْ تُقْبَلَ تَوْبَتُهُمْ وَأُولَٰئِكَ هُمُ الضَّالُّونَ","numberInSurah":90,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":384,"text":"إِنَّ الَّذِينَ كَفَرُوا وَمَاتُوا وَهُمْ كُفَّارٌ فَلَنْ يُقْبَلَ مِنْ أَحَدِهِمْ مِلْءُ الْأَرْضِ ذَهَبًا وَلَوِ افْتَدَىٰ بِهِ ۗ أُولَٰئِكَ لَهُمْ عَذَابٌ أَلِيمٌ وَمَا لَهُمْ مِنْ نَاصِرِينَ","numberInSurah":91,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":385,"text":"لَنْ تَنَالُوا الْبِرَّ حَتَّىٰ تُنْفِقُوا مِمَّا تُحِبُّونَ ۚ وَمَا تُنْفِقُوا مِنْ شَيْءٍ فَإِنَّ اللَّهَ بِهِ عَلِيمٌ","numberInSurah":92,"juz":3,"manzil":1,"page":62,"ruku":51,"hizbQuarter":24,"sajda":false},{"number":386,"text":"۞ كُلُّ الطَّعَامِ كَانَ حِلًّا لِبَنِي إِسْرَائِيلَ إِلَّا مَا حَرَّمَ إِسْرَائِيلُ عَلَىٰ نَفْسِهِ مِنْ قَبْلِ أَنْ تُنَزَّلَ التَّوْرَاةُ ۗ قُلْ فَأْتُوا بِالتَّوْرَاةِ فَاتْلُوهَا إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":93,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":387,"text":"فَمَنِ افْتَرَىٰ عَلَى اللَّهِ الْكَذِبَ مِنْ بَعْدِ ذَٰلِكَ فَأُولَٰئِكَ هُمُ الظَّالِمُونَ","numberInSurah":94,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":388,"text":"قُلْ صَدَقَ اللَّهُ ۗ فَاتَّبِعُوا مِلَّةَ إِبْرَاهِيمَ حَنِيفًا وَمَا كَانَ مِنَ الْمُشْرِكِينَ","numberInSurah":95,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":389,"text":"إِنَّ أَوَّلَ بَيْتٍ وُضِعَ لِلنَّاسِ لَلَّذِي بِبَكَّةَ مُبَارَكًا وَهُدًى لِلْعَالَمِينَ","numberInSurah":96,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":390,"text":"فِيهِ آيَاتٌ بَيِّنَاتٌ مَقَامُ إِبْرَاهِيمَ ۖ وَمَنْ دَخَلَهُ كَانَ آمِنًا ۗ وَلِلَّهِ عَلَى النَّاسِ حِجُّ الْبَيْتِ مَنِ اسْتَطَاعَ إِلَيْهِ سَبِيلًا ۚ وَمَنْ كَفَرَ فَإِنَّ اللَّهَ غَنِيٌّ عَنِ الْعَالَمِينَ","numberInSurah":97,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":391,"text":"قُلْ يَا أَهْلَ الْكِتَابِ لِمَ تَكْفُرُونَ بِآيَاتِ اللَّهِ وَاللَّهُ شَهِيدٌ عَلَىٰ مَا تَعْمَلُونَ","numberInSurah":98,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":392,"text":"قُلْ يَا أَهْلَ الْكِتَابِ لِمَ تَصُدُّونَ عَنْ سَبِيلِ اللَّهِ مَنْ آمَنَ تَبْغُونَهَا عِوَجًا وَأَنْتُمْ شُهَدَاءُ ۗ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ","numberInSurah":99,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":393,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تُطِيعُوا فَرِيقًا مِنَ الَّذِينَ أُوتُوا الْكِتَابَ يَرُدُّوكُمْ بَعْدَ إِيمَانِكُمْ كَافِرِينَ","numberInSurah":100,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":394,"text":"وَكَيْفَ تَكْفُرُونَ وَأَنْتُمْ تُتْلَىٰ عَلَيْكُمْ آيَاتُ اللَّهِ وَفِيكُمْ رَسُولُهُ ۗ وَمَنْ يَعْتَصِمْ بِاللَّهِ فَقَدْ هُدِيَ إِلَىٰ صِرَاطٍ مُسْتَقِيمٍ","numberInSurah":101,"juz":4,"manzil":1,"page":63,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":395,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ حَقَّ تُقَاتِهِ وَلَا تَمُوتُنَّ إِلَّا وَأَنْتُمْ مُسْلِمُونَ","numberInSurah":102,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":396,"text":"وَاعْتَصِمُوا بِحَبْلِ اللَّهِ جَمِيعًا وَلَا تَفَرَّقُوا ۚ وَاذْكُرُوا نِعْمَتَ اللَّهِ عَلَيْكُمْ إِذْ كُنْتُمْ أَعْدَاءً فَأَلَّفَ بَيْنَ قُلُوبِكُمْ فَأَصْبَحْتُمْ بِنِعْمَتِهِ إِخْوَانًا وَكُنْتُمْ عَلَىٰ شَفَا حُفْرَةٍ مِنَ النَّارِ فَأَنْقَذَكُمْ مِنْهَا ۗ كَذَٰلِكَ يُبَيِّنُ اللَّهُ لَكُمْ آيَاتِهِ لَعَلَّكُمْ تَهْتَدُونَ","numberInSurah":103,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":397,"text":"وَلْتَكُنْ مِنْكُمْ أُمَّةٌ يَدْعُونَ إِلَى الْخَيْرِ وَيَأْمُرُونَ بِالْمَعْرُوفِ وَيَنْهَوْنَ عَنِ الْمُنْكَرِ ۚ وَأُولَٰئِكَ هُمُ الْمُفْلِحُونَ","numberInSurah":104,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":398,"text":"وَلَا تَكُونُوا كَالَّذِينَ تَفَرَّقُوا وَاخْتَلَفُوا مِنْ بَعْدِ مَا جَاءَهُمُ الْبَيِّنَاتُ ۚ وَأُولَٰئِكَ لَهُمْ عَذَابٌ عَظِيمٌ","numberInSurah":105,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":399,"text":"يَوْمَ تَبْيَضُّ وُجُوهٌ وَتَسْوَدُّ وُجُوهٌ ۚ فَأَمَّا الَّذِينَ اسْوَدَّتْ وُجُوهُهُمْ أَكَفَرْتُمْ بَعْدَ إِيمَانِكُمْ فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ","numberInSurah":106,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":400,"text":"وَأَمَّا الَّذِينَ ابْيَضَّتْ وُجُوهُهُمْ فَفِي رَحْمَةِ اللَّهِ هُمْ فِيهَا خَالِدُونَ","numberInSurah":107,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":401,"text":"تِلْكَ آيَاتُ اللَّهِ نَتْلُوهَا عَلَيْكَ بِالْحَقِّ ۗ وَمَا اللَّهُ يُرِيدُ ظُلْمًا لِلْعَالَمِينَ","numberInSurah":108,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":402,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۚ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","numberInSurah":109,"juz":4,"manzil":1,"page":64,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":403,"text":"كُنْتُمْ خَيْرَ أُمَّةٍ أُخْرِجَتْ لِلنَّاسِ تَأْمُرُونَ بِالْمَعْرُوفِ وَتَنْهَوْنَ عَنِ الْمُنْكَرِ وَتُؤْمِنُونَ بِاللَّهِ ۗ وَلَوْ آمَنَ أَهْلُ الْكِتَابِ لَكَانَ خَيْرًا لَهُمْ ۚ مِنْهُمُ الْمُؤْمِنُونَ وَأَكْثَرُهُمُ الْفَاسِقُونَ","numberInSurah":110,"juz":4,"manzil":1,"page":64,"ruku":53,"hizbQuarter":25,"sajda":false},{"number":404,"text":"لَنْ يَضُرُّوكُمْ إِلَّا أَذًى ۖ وَإِنْ يُقَاتِلُوكُمْ يُوَلُّوكُمُ الْأَدْبَارَ ثُمَّ لَا يُنْصَرُونَ","numberInSurah":111,"juz":4,"manzil":1,"page":64,"ruku":53,"hizbQuarter":25,"sajda":false},{"number":405,"text":"ضُرِبَتْ عَلَيْهِمُ الذِّلَّةُ أَيْنَ مَا ثُقِفُوا إِلَّا بِحَبْلٍ مِنَ اللَّهِ وَحَبْلٍ مِنَ النَّاسِ وَبَاءُوا بِغَضَبٍ مِنَ اللَّهِ وَضُرِبَتْ عَلَيْهِمُ الْمَسْكَنَةُ ۚ ذَٰلِكَ بِأَنَّهُمْ كَانُوا يَكْفُرُونَ بِآيَاتِ اللَّهِ وَيَقْتُلُونَ الْأَنْبِيَاءَ بِغَيْرِ حَقٍّ ۚ ذَٰلِكَ بِمَا عَصَوْا وَكَانُوا يَعْتَدُونَ","numberInSurah":112,"juz":4,"manzil":1,"page":64,"ruku":53,"hizbQuarter":25,"sajda":false},{"number":406,"text":"۞ لَيْسُوا سَوَاءً ۗ مِنْ أَهْلِ الْكِتَابِ أُمَّةٌ قَائِمَةٌ يَتْلُونَ آيَاتِ اللَّهِ آنَاءَ اللَّيْلِ وَهُمْ يَسْجُدُونَ","numberInSurah":113,"juz":4,"manzil":1,"page":64,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":407,"text":"يُؤْمِنُونَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَيَأْمُرُونَ بِالْمَعْرُوفِ وَيَنْهَوْنَ عَنِ الْمُنْكَرِ وَيُسَارِعُونَ فِي الْخَيْرَاتِ وَأُولَٰئِكَ مِنَ الصَّالِحِينَ","numberInSurah":114,"juz":4,"manzil":1,"page":64,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":408,"text":"وَمَا يَفْعَلُوا مِنْ خَيْرٍ فَلَنْ يُكْفَرُوهُ ۗ وَاللَّهُ عَلِيمٌ بِالْمُتَّقِينَ","numberInSurah":115,"juz":4,"manzil":1,"page":64,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":409,"text":"إِنَّ الَّذِينَ كَفَرُوا لَنْ تُغْنِيَ عَنْهُمْ أَمْوَالُهُمْ وَلَا أَوْلَادُهُمْ مِنَ اللَّهِ شَيْئًا ۖ وَأُولَٰئِكَ أَصْحَابُ النَّارِ ۚ هُمْ فِيهَا خَالِدُونَ","numberInSurah":116,"juz":4,"manzil":1,"page":65,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":410,"text":"مَثَلُ مَا يُنْفِقُونَ فِي هَٰذِهِ الْحَيَاةِ الدُّنْيَا كَمَثَلِ رِيحٍ فِيهَا صِرٌّ أَصَابَتْ حَرْثَ قَوْمٍ ظَلَمُوا أَنْفُسَهُمْ فَأَهْلَكَتْهُ ۚ وَمَا ظَلَمَهُمُ اللَّهُ وَلَٰكِنْ أَنْفُسَهُمْ يَظْلِمُونَ","numberInSurah":117,"juz":4,"manzil":1,"page":65,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":411,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَتَّخِذُوا بِطَانَةً مِنْ دُونِكُمْ لَا يَأْلُونَكُمْ خَبَالًا وَدُّوا مَا عَنِتُّمْ قَدْ بَدَتِ الْبَغْضَاءُ مِنْ أَفْوَاهِهِمْ وَمَا تُخْفِي صُدُورُهُمْ أَكْبَرُ ۚ قَدْ بَيَّنَّا لَكُمُ الْآيَاتِ ۖ إِنْ كُنْتُمْ تَعْقِلُونَ","numberInSurah":118,"juz":4,"manzil":1,"page":65,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":412,"text":"هَا أَنْتُمْ أُولَاءِ تُحِبُّونَهُمْ وَلَا يُحِبُّونَكُمْ وَتُؤْمِنُونَ بِالْكِتَابِ كُلِّهِ وَإِذَا لَقُوكُمْ قَالُوا آمَنَّا وَإِذَا خَلَوْا عَضُّوا عَلَيْكُمُ الْأَنَامِلَ مِنَ الْغَيْظِ ۚ قُلْ مُوتُوا بِغَيْظِكُمْ ۗ إِنَّ اللَّهَ عَلِيمٌ بِذَاتِ الصُّدُورِ","numberInSurah":119,"juz":4,"manzil":1,"page":65,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":413,"text":"إِنْ تَمْسَسْكُمْ حَسَنَةٌ تَسُؤْهُمْ وَإِنْ تُصِبْكُمْ سَيِّئَةٌ يَفْرَحُوا بِهَا ۖ وَإِنْ تَصْبِرُوا وَتَتَّقُوا لَا يَضُرُّكُمْ كَيْدُهُمْ شَيْئًا ۗ إِنَّ اللَّهَ بِمَا يَعْمَلُونَ مُحِيطٌ","numberInSurah":120,"juz":4,"manzil":1,"page":65,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":414,"text":"وَإِذْ غَدَوْتَ مِنْ أَهْلِكَ تُبَوِّئُ الْمُؤْمِنِينَ مَقَاعِدَ لِلْقِتَالِ ۗ وَاللَّهُ سَمِيعٌ عَلِيمٌ","numberInSurah":121,"juz":4,"manzil":1,"page":65,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":415,"text":"إِذْ هَمَّتْ طَائِفَتَانِ مِنْكُمْ أَنْ تَفْشَلَا وَاللَّهُ وَلِيُّهُمَا ۗ وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ","numberInSurah":122,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":416,"text":"وَلَقَدْ نَصَرَكُمُ اللَّهُ بِبَدْرٍ وَأَنْتُمْ أَذِلَّةٌ ۖ فَاتَّقُوا اللَّهَ لَعَلَّكُمْ تَشْكُرُونَ","numberInSurah":123,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":417,"text":"إِذْ تَقُولُ لِلْمُؤْمِنِينَ أَلَنْ يَكْفِيَكُمْ أَنْ يُمِدَّكُمْ رَبُّكُمْ بِثَلَاثَةِ آلَافٍ مِنَ الْمَلَائِكَةِ مُنْزَلِينَ","numberInSurah":124,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":418,"text":"بَلَىٰ ۚ إِنْ تَصْبِرُوا وَتَتَّقُوا وَيَأْتُوكُمْ مِنْ فَوْرِهِمْ هَٰذَا يُمْدِدْكُمْ رَبُّكُمْ بِخَمْسَةِ آلَافٍ مِنَ الْمَلَائِكَةِ مُسَوِّمِينَ","numberInSurah":125,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":419,"text":"وَمَا جَعَلَهُ اللَّهُ إِلَّا بُشْرَىٰ لَكُمْ وَلِتَطْمَئِنَّ قُلُوبُكُمْ بِهِ ۗ وَمَا النَّصْرُ إِلَّا مِنْ عِنْدِ اللَّهِ الْعَزِيزِ الْحَكِيمِ","numberInSurah":126,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":420,"text":"لِيَقْطَعَ طَرَفًا مِنَ الَّذِينَ كَفَرُوا أَوْ يَكْبِتَهُمْ فَيَنْقَلِبُوا خَائِبِينَ","numberInSurah":127,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":421,"text":"لَيْسَ لَكَ مِنَ الْأَمْرِ شَيْءٌ أَوْ يَتُوبَ عَلَيْهِمْ أَوْ يُعَذِّبَهُمْ فَإِنَّهُمْ ظَالِمُونَ","numberInSurah":128,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":422,"text":"وَلِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۚ يَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ ۚ وَاللَّهُ غَفُورٌ رَحِيمٌ","numberInSurah":129,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":423,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَأْكُلُوا الرِّبَا أَضْعَافًا مُضَاعَفَةً ۖ وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُفْلِحُونَ","numberInSurah":130,"juz":4,"manzil":1,"page":66,"ruku":55,"hizbQuarter":26,"sajda":false},{"number":424,"text":"وَاتَّقُوا النَّارَ الَّتِي أُعِدَّتْ لِلْكَافِرِينَ","numberInSurah":131,"juz":4,"manzil":1,"page":66,"ruku":55,"hizbQuarter":26,"sajda":false},{"number":425,"text":"وَأَطِيعُوا اللَّهَ وَالرَّسُولَ لَعَلَّكُمْ تُرْحَمُونَ","numberInSurah":132,"juz":4,"manzil":1,"page":66,"ruku":55,"hizbQuarter":26,"sajda":false},{"number":426,"text":"۞ وَسَارِعُوا إِلَىٰ مَغْفِرَةٍ مِنْ رَبِّكُمْ وَجَنَّةٍ عَرْضُهَا السَّمَاوَاتُ وَالْأَرْضُ أُعِدَّتْ لِلْمُتَّقِينَ","numberInSurah":133,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":427,"text":"الَّذِينَ يُنْفِقُونَ فِي السَّرَّاءِ وَالضَّرَّاءِ وَالْكَاظِمِينَ الْغَيْظَ وَالْعَافِينَ عَنِ النَّاسِ ۗ وَاللَّهُ يُحِبُّ الْمُحْسِنِينَ","numberInSurah":134,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":428,"text":"وَالَّذِينَ إِذَا فَعَلُوا فَاحِشَةً أَوْ ظَلَمُوا أَنْفُسَهُمْ ذَكَرُوا اللَّهَ فَاسْتَغْفَرُوا لِذُنُوبِهِمْ وَمَنْ يَغْفِرُ الذُّنُوبَ إِلَّا اللَّهُ وَلَمْ يُصِرُّوا عَلَىٰ مَا فَعَلُوا وَهُمْ يَعْلَمُونَ","numberInSurah":135,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":429,"text":"أُولَٰئِكَ جَزَاؤُهُمْ مَغْفِرَةٌ مِنْ رَبِّهِمْ وَجَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا ۚ وَنِعْمَ أَجْرُ الْعَامِلِينَ","numberInSurah":136,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":430,"text":"قَدْ خَلَتْ مِنْ قَبْلِكُمْ سُنَنٌ فَسِيرُوا فِي الْأَرْضِ فَانْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الْمُكَذِّبِينَ","numberInSurah":137,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":431,"text":"هَٰذَا بَيَانٌ لِلنَّاسِ وَهُدًى وَمَوْعِظَةٌ لِلْمُتَّقِينَ","numberInSurah":138,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":432,"text":"وَلَا تَهِنُوا وَلَا تَحْزَنُوا وَأَنْتُمُ الْأَعْلَوْنَ إِنْ كُنْتُمْ مُؤْمِنِينَ","numberInSurah":139,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":433,"text":"إِنْ يَمْسَسْكُمْ قَرْحٌ فَقَدْ مَسَّ الْقَوْمَ قَرْحٌ مِثْلُهُ ۚ وَتِلْكَ الْأَيَّامُ نُدَاوِلُهَا بَيْنَ النَّاسِ وَلِيَعْلَمَ اللَّهُ الَّذِينَ آمَنُوا وَيَتَّخِذَ مِنْكُمْ شُهَدَاءَ ۗ وَاللَّهُ لَا يُحِبُّ الظَّالِمِينَ","numberInSurah":140,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":434,"text":"وَلِيُمَحِّصَ اللَّهُ الَّذِينَ آمَنُوا وَيَمْحَقَ الْكَافِرِينَ","numberInSurah":141,"juz":4,"manzil":1,"page":68,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":435,"text":"أَمْ حَسِبْتُمْ أَنْ تَدْخُلُوا الْجَنَّةَ وَلَمَّا يَعْلَمِ اللَّهُ الَّذِينَ جَاهَدُوا مِنْكُمْ وَيَعْلَمَ الصَّابِرِينَ","numberInSurah":142,"juz":4,"manzil":1,"page":68,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":436,"text":"وَلَقَدْ كُنْتُمْ تَمَنَّوْنَ الْمَوْتَ مِنْ قَبْلِ أَنْ تَلْقَوْهُ فَقَدْ رَأَيْتُمُوهُ وَأَنْتُمْ تَنْظُرُونَ","numberInSurah":143,"juz":4,"manzil":1,"page":68,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":437,"text":"وَمَا مُحَمَّدٌ إِلَّا رَسُولٌ قَدْ خَلَتْ مِنْ قَبْلِهِ الرُّسُلُ ۚ أَفَإِنْ مَاتَ أَوْ قُتِلَ انْقَلَبْتُمْ عَلَىٰ أَعْقَابِكُمْ ۚ وَمَنْ يَنْقَلِبْ عَلَىٰ عَقِبَيْهِ فَلَنْ يَضُرَّ اللَّهَ شَيْئًا ۗ وَسَيَجْزِي اللَّهُ الشَّاكِرِينَ","numberInSurah":144,"juz":4,"manzil":1,"page":68,"ruku":56,"hizbQuarter":27,"sajda":false},{"number":438,"text":"وَمَا كَانَ لِنَفْسٍ أَنْ تَمُوتَ إِلَّا بِإِذْنِ اللَّهِ كِتَابًا مُؤَجَّلًا ۗ وَمَنْ يُرِدْ ثَوَابَ الدُّنْيَا نُؤْتِهِ مِنْهَا وَمَنْ يُرِدْ ثَوَابَ الْآخِرَةِ نُؤْتِهِ مِنْهَا ۚ وَسَنَجْزِي الشَّاكِرِينَ","numberInSurah":145,"juz":4,"manzil":1,"page":68,"ruku":56,"hizbQuarter":27,"sajda":false},{"number":439,"text":"وَكَأَيِّنْ مِنْ نَبِيٍّ قَاتَلَ مَعَهُ رِبِّيُّونَ كَثِيرٌ فَمَا وَهَنُوا لِمَا أَصَابَهُمْ فِي سَبِيلِ اللَّهِ وَمَا ضَعُفُوا وَمَا اسْتَكَانُوا ۗ وَاللَّهُ يُحِبُّ الصَّابِرِينَ","numberInSurah":146,"juz":4,"manzil":1,"page":68,"ruku":56,"hizbQuarter":27,"sajda":false},{"number":440,"text":"وَمَا كَانَ قَوْلَهُمْ إِلَّا أَنْ قَالُوا رَبَّنَا اغْفِرْ لَنَا ذُنُوبَنَا وَإِسْرَافَنَا فِي أَمْرِنَا وَثَبِّتْ أَقْدَامَنَا وَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ","numberInSurah":147,"juz":4,"manzil":1,"page":68,"ruku":56,"hizbQuarter":27,"sajda":false},{"number":441,"text":"فَآتَاهُمُ اللَّهُ ثَوَابَ الدُّنْيَا وَحُسْنَ ثَوَابِ الْآخِرَةِ ۗ وَاللَّهُ يُحِبُّ الْمُحْسِنِينَ","numberInSurah":148,"juz":4,"manzil":1,"page":68,"ruku":56,"hizbQuarter":27,"sajda":false},{"number":442,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تُطِيعُوا الَّذِينَ كَفَرُوا يَرُدُّوكُمْ عَلَىٰ أَعْقَابِكُمْ فَتَنْقَلِبُوا خَاسِرِينَ","numberInSurah":149,"juz":4,"manzil":1,"page":69,"ruku":57,"hizbQuarter":27,"sajda":false},{"number":443,"text":"بَلِ اللَّهُ مَوْلَاكُمْ ۖ وَهُوَ خَيْرُ النَّاصِرِينَ","numberInSurah":150,"juz":4,"manzil":1,"page":69,"ruku":57,"hizbQuarter":27,"sajda":false},{"number":444,"text":"سَنُلْقِي فِي قُلُوبِ الَّذِينَ كَفَرُوا الرُّعْبَ بِمَا أَشْرَكُوا بِاللَّهِ مَا لَمْ يُنَزِّلْ بِهِ سُلْطَانًا ۖ وَمَأْوَاهُمُ النَّارُ ۚ وَبِئْسَ مَثْوَى الظَّالِمِينَ","numberInSurah":151,"juz":4,"manzil":1,"page":69,"ruku":57,"hizbQuarter":27,"sajda":false},{"number":445,"text":"وَلَقَدْ صَدَقَكُمُ اللَّهُ وَعْدَهُ إِذْ تَحُسُّونَهُمْ بِإِذْنِهِ ۖ حَتَّىٰ إِذَا فَشِلْتُمْ وَتَنَازَعْتُمْ فِي الْأَمْرِ وَعَصَيْتُمْ مِنْ بَعْدِ مَا أَرَاكُمْ مَا تُحِبُّونَ ۚ مِنْكُمْ مَنْ يُرِيدُ الدُّنْيَا وَمِنْكُمْ مَنْ يُرِيدُ الْآخِرَةَ ۚ ثُمَّ صَرَفَكُمْ عَنْهُمْ لِيَبْتَلِيَكُمْ ۖ وَلَقَدْ عَفَا عَنْكُمْ ۗ وَاللَّهُ ذُو فَضْلٍ عَلَى الْمُؤْمِنِينَ","numberInSurah":152,"juz":4,"manzil":1,"page":69,"ruku":57,"hizbQuarter":27,"sajda":false},{"number":446,"text":"۞ إِذْ تُصْعِدُونَ وَلَا تَلْوُونَ عَلَىٰ أَحَدٍ وَالرَّسُولُ يَدْعُوكُمْ فِي أُخْرَاكُمْ فَأَثَابَكُمْ غَمًّا بِغَمٍّ لِكَيْلَا تَحْزَنُوا عَلَىٰ مَا فَاتَكُمْ وَلَا مَا أَصَابَكُمْ ۗ وَاللَّهُ خَبِيرٌ بِمَا تَعْمَلُونَ","numberInSurah":153,"juz":4,"manzil":1,"page":69,"ruku":57,"hizbQuarter":28,"sajda":false},{"number":447,"text":"ثُمَّ أَنْزَلَ عَلَيْكُمْ مِنْ بَعْدِ الْغَمِّ أَمَنَةً نُعَاسًا يَغْشَىٰ طَائِفَةً مِنْكُمْ ۖ وَطَائِفَةٌ قَدْ أَهَمَّتْهُمْ أَنْفُسُهُمْ يَظُنُّونَ بِاللَّهِ غَيْرَ الْحَقِّ ظَنَّ الْجَاهِلِيَّةِ ۖ يَقُولُونَ هَلْ لَنَا مِنَ الْأَمْرِ مِنْ شَيْءٍ ۗ قُلْ إِنَّ الْأَمْرَ كُلَّهُ لِلَّهِ ۗ يُخْفُونَ فِي أَنْفُسِهِمْ مَا لَا يُبْدُونَ لَكَ ۖ يَقُولُونَ لَوْ كَانَ لَنَا مِنَ الْأَمْرِ شَيْءٌ مَا قُتِلْنَا هَاهُنَا ۗ قُلْ لَوْ كُنْتُمْ فِي بُيُوتِكُمْ لَبَرَزَ الَّذِينَ كُتِبَ عَلَيْهِمُ الْقَتْلُ إِلَىٰ مَضَاجِعِهِمْ ۖ وَلِيَبْتَلِيَ اللَّهُ مَا فِي صُدُورِكُمْ وَلِيُمَحِّصَ مَا فِي قُلُوبِكُمْ ۗ وَاللَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","numberInSurah":154,"juz":4,"manzil":1,"page":70,"ruku":57,"hizbQuarter":28,"sajda":false},{"number":448,"text":"إِنَّ الَّذِينَ تَوَلَّوْا مِنْكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ إِنَّمَا اسْتَزَلَّهُمُ الشَّيْطَانُ بِبَعْضِ مَا كَسَبُوا ۖ وَلَقَدْ عَفَا اللَّهُ عَنْهُمْ ۗ إِنَّ اللَّهَ غَفُورٌ حَلِيمٌ","numberInSurah":155,"juz":4,"manzil":1,"page":70,"ruku":57,"hizbQuarter":28,"sajda":false},{"number":449,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَكُونُوا كَالَّذِينَ كَفَرُوا وَقَالُوا لِإِخْوَانِهِمْ إِذَا ضَرَبُوا فِي الْأَرْضِ أَوْ كَانُوا غُزًّى لَوْ كَانُوا عِنْدَنَا مَا مَاتُوا وَمَا قُتِلُوا لِيَجْعَلَ اللَّهُ ذَٰلِكَ حَسْرَةً فِي قُلُوبِهِمْ ۗ وَاللَّهُ يُحْيِي وَيُمِيتُ ۗ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","numberInSurah":156,"juz":4,"manzil":1,"page":70,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":450,"text":"وَلَئِنْ قُتِلْتُمْ فِي سَبِيلِ اللَّهِ أَوْ مُتُّمْ لَمَغْفِرَةٌ مِنَ اللَّهِ وَرَحْمَةٌ خَيْرٌ مِمَّا يَجْمَعُونَ","numberInSurah":157,"juz":4,"manzil":1,"page":70,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":451,"text":"وَلَئِنْ مُتُّمْ أَوْ قُتِلْتُمْ لَإِلَى اللَّهِ تُحْشَرُونَ","numberInSurah":158,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":452,"text":"فَبِمَا رَحْمَةٍ مِنَ اللَّهِ لِنْتَ لَهُمْ ۖ وَلَوْ كُنْتَ فَظًّا غَلِيظَ الْقَلْبِ لَانْفَضُّوا مِنْ حَوْلِكَ ۖ فَاعْفُ عَنْهُمْ وَاسْتَغْفِرْ لَهُمْ وَشَاوِرْهُمْ فِي الْأَمْرِ ۖ فَإِذَا عَزَمْتَ فَتَوَكَّلْ عَلَى اللَّهِ ۚ إِنَّ اللَّهَ يُحِبُّ الْمُتَوَكِّلِينَ","numberInSurah":159,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":453,"text":"إِنْ يَنْصُرْكُمُ اللَّهُ فَلَا غَالِبَ لَكُمْ ۖ وَإِنْ يَخْذُلْكُمْ فَمَنْ ذَا الَّذِي يَنْصُرُكُمْ مِنْ بَعْدِهِ ۗ وَعَلَى اللَّهِ فَلْيَتَوَكَّلِ الْمُؤْمِنُونَ","numberInSurah":160,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":454,"text":"وَمَا كَانَ لِنَبِيٍّ أَنْ يَغُلَّ ۚ وَمَنْ يَغْلُلْ يَأْتِ بِمَا غَلَّ يَوْمَ الْقِيَامَةِ ۚ ثُمَّ تُوَفَّىٰ كُلُّ نَفْسٍ مَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ","numberInSurah":161,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":455,"text":"أَفَمَنِ اتَّبَعَ رِضْوَانَ اللَّهِ كَمَنْ بَاءَ بِسَخَطٍ مِنَ اللَّهِ وَمَأْوَاهُ جَهَنَّمُ ۚ وَبِئْسَ الْمَصِيرُ","numberInSurah":162,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":456,"text":"هُمْ دَرَجَاتٌ عِنْدَ اللَّهِ ۗ وَاللَّهُ بَصِيرٌ بِمَا يَعْمَلُونَ","numberInSurah":163,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":457,"text":"لَقَدْ مَنَّ اللَّهُ عَلَى الْمُؤْمِنِينَ إِذْ بَعَثَ فِيهِمْ رَسُولًا مِنْ أَنْفُسِهِمْ يَتْلُو عَلَيْهِمْ آيَاتِهِ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ الْكِتَابَ وَالْحِكْمَةَ وَإِنْ كَانُوا مِنْ قَبْلُ لَفِي ضَلَالٍ مُبِينٍ","numberInSurah":164,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":458,"text":"أَوَلَمَّا أَصَابَتْكُمْ مُصِيبَةٌ قَدْ أَصَبْتُمْ مِثْلَيْهَا قُلْتُمْ أَنَّىٰ هَٰذَا ۖ قُلْ هُوَ مِنْ عِنْدِ أَنْفُسِكُمْ ۗ إِنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":165,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":459,"text":"وَمَا أَصَابَكُمْ يَوْمَ الْتَقَى الْجَمْعَانِ فَبِإِذْنِ اللَّهِ وَلِيَعْلَمَ الْمُؤْمِنِينَ","numberInSurah":166,"juz":4,"manzil":1,"page":72,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":460,"text":"وَلِيَعْلَمَ الَّذِينَ نَافَقُوا ۚ وَقِيلَ لَهُمْ تَعَالَوْا قَاتِلُوا فِي سَبِيلِ اللَّهِ أَوِ ادْفَعُوا ۖ قَالُوا لَوْ نَعْلَمُ قِتَالًا لَاتَّبَعْنَاكُمْ ۗ هُمْ لِلْكُفْرِ يَوْمَئِذٍ أَقْرَبُ مِنْهُمْ لِلْإِيمَانِ ۚ يَقُولُونَ بِأَفْوَاهِهِمْ مَا لَيْسَ فِي قُلُوبِهِمْ ۗ وَاللَّهُ أَعْلَمُ بِمَا يَكْتُمُونَ","numberInSurah":167,"juz":4,"manzil":1,"page":72,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":461,"text":"الَّذِينَ قَالُوا لِإِخْوَانِهِمْ وَقَعَدُوا لَوْ أَطَاعُونَا مَا قُتِلُوا ۗ قُلْ فَادْرَءُوا عَنْ أَنْفُسِكُمُ الْمَوْتَ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":168,"juz":4,"manzil":1,"page":72,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":462,"text":"وَلَا تَحْسَبَنَّ الَّذِينَ قُتِلُوا فِي سَبِيلِ اللَّهِ أَمْوَاتًا ۚ بَلْ أَحْيَاءٌ عِنْدَ رَبِّهِمْ يُرْزَقُونَ","numberInSurah":169,"juz":4,"manzil":1,"page":72,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":463,"text":"فَرِحِينَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ وَيَسْتَبْشِرُونَ بِالَّذِينَ لَمْ يَلْحَقُوا بِهِمْ مِنْ خَلْفِهِمْ أَلَّا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ","numberInSurah":170,"juz":4,"manzil":1,"page":72,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":464,"text":"۞ يَسْتَبْشِرُونَ بِنِعْمَةٍ مِنَ اللَّهِ وَفَضْلٍ وَأَنَّ اللَّهَ لَا يُضِيعُ أَجْرَ الْمُؤْمِنِينَ","numberInSurah":171,"juz":4,"manzil":1,"page":72,"ruku":58,"hizbQuarter":29,"sajda":false},{"number":465,"text":"الَّذِينَ اسْتَجَابُوا لِلَّهِ وَالرَّسُولِ مِنْ بَعْدِ مَا أَصَابَهُمُ الْقَرْحُ ۚ لِلَّذِينَ أَحْسَنُوا مِنْهُمْ وَاتَّقَوْا أَجْرٌ عَظِيمٌ","numberInSurah":172,"juz":4,"manzil":1,"page":72,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":466,"text":"الَّذِينَ قَالَ لَهُمُ النَّاسُ إِنَّ النَّاسَ قَدْ جَمَعُوا لَكُمْ فَاخْشَوْهُمْ فَزَادَهُمْ إِيمَانًا وَقَالُوا حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ","numberInSurah":173,"juz":4,"manzil":1,"page":72,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":467,"text":"فَانْقَلَبُوا بِنِعْمَةٍ مِنَ اللَّهِ وَفَضْلٍ لَمْ يَمْسَسْهُمْ سُوءٌ وَاتَّبَعُوا رِضْوَانَ اللَّهِ ۗ وَاللَّهُ ذُو فَضْلٍ عَظِيمٍ","numberInSurah":174,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":468,"text":"إِنَّمَا ذَٰلِكُمُ الشَّيْطَانُ يُخَوِّفُ أَوْلِيَاءَهُ فَلَا تَخَافُوهُمْ وَخَافُونِ إِنْ كُنْتُمْ مُؤْمِنِينَ","numberInSurah":175,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":469,"text":"وَلَا يَحْزُنْكَ الَّذِينَ يُسَارِعُونَ فِي الْكُفْرِ ۚ إِنَّهُمْ لَنْ يَضُرُّوا اللَّهَ شَيْئًا ۗ يُرِيدُ اللَّهُ أَلَّا يَجْعَلَ لَهُمْ حَظًّا فِي الْآخِرَةِ ۖ وَلَهُمْ عَذَابٌ عَظِيمٌ","numberInSurah":176,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":470,"text":"إِنَّ الَّذِينَ اشْتَرَوُا الْكُفْرَ بِالْإِيمَانِ لَنْ يَضُرُّوا اللَّهَ شَيْئًا وَلَهُمْ عَذَابٌ أَلِيمٌ","numberInSurah":177,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":471,"text":"وَلَا يَحْسَبَنَّ الَّذِينَ كَفَرُوا أَنَّمَا نُمْلِي لَهُمْ خَيْرٌ لِأَنْفُسِهِمْ ۚ إِنَّمَا نُمْلِي لَهُمْ لِيَزْدَادُوا إِثْمًا ۚ وَلَهُمْ عَذَابٌ مُهِينٌ","numberInSurah":178,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":472,"text":"مَا كَانَ اللَّهُ لِيَذَرَ الْمُؤْمِنِينَ عَلَىٰ مَا أَنْتُمْ عَلَيْهِ حَتَّىٰ يَمِيزَ الْخَبِيثَ مِنَ الطَّيِّبِ ۗ وَمَا كَانَ اللَّهُ لِيُطْلِعَكُمْ عَلَى الْغَيْبِ وَلَٰكِنَّ اللَّهَ يَجْتَبِي مِنْ رُسُلِهِ مَنْ يَشَاءُ ۖ فَآمِنُوا بِاللَّهِ وَرُسُلِهِ ۚ وَإِنْ تُؤْمِنُوا وَتَتَّقُوا فَلَكُمْ أَجْرٌ عَظِيمٌ","numberInSurah":179,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":473,"text":"وَلَا يَحْسَبَنَّ الَّذِينَ يَبْخَلُونَ بِمَا آتَاهُمُ اللَّهُ مِنْ فَضْلِهِ هُوَ خَيْرًا لَهُمْ ۖ بَلْ هُوَ شَرٌّ لَهُمْ ۖ سَيُطَوَّقُونَ مَا بَخِلُوا بِهِ يَوْمَ الْقِيَامَةِ ۗ وَلِلَّهِ مِيرَاثُ السَّمَاوَاتِ وَالْأَرْضِ ۗ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","numberInSurah":180,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":474,"text":"لَقَدْ سَمِعَ اللَّهُ قَوْلَ الَّذِينَ قَالُوا إِنَّ اللَّهَ فَقِيرٌ وَنَحْنُ أَغْنِيَاءُ ۘ سَنَكْتُبُ مَا قَالُوا وَقَتْلَهُمُ الْأَنْبِيَاءَ بِغَيْرِ حَقٍّ وَنَقُولُ ذُوقُوا عَذَابَ الْحَرِيقِ","numberInSurah":181,"juz":4,"manzil":1,"page":74,"ruku":60,"hizbQuarter":29,"sajda":false},{"number":475,"text":"ذَٰلِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ وَأَنَّ اللَّهَ لَيْسَ بِظَلَّامٍ لِلْعَبِيدِ","numberInSurah":182,"juz":4,"manzil":1,"page":74,"ruku":60,"hizbQuarter":29,"sajda":false},{"number":476,"text":"الَّذِينَ قَالُوا إِنَّ اللَّهَ عَهِدَ إِلَيْنَا أَلَّا نُؤْمِنَ لِرَسُولٍ حَتَّىٰ يَأْتِيَنَا بِقُرْبَانٍ تَأْكُلُهُ النَّارُ ۗ قُلْ قَدْ جَاءَكُمْ رُسُلٌ مِنْ قَبْلِي بِالْبَيِّنَاتِ وَبِالَّذِي قُلْتُمْ فَلِمَ قَتَلْتُمُوهُمْ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":183,"juz":4,"manzil":1,"page":74,"ruku":60,"hizbQuarter":29,"sajda":false},{"number":477,"text":"فَإِنْ كَذَّبُوكَ فَقَدْ كُذِّبَ رُسُلٌ مِنْ قَبْلِكَ جَاءُوا بِالْبَيِّنَاتِ وَالزُّبُرِ وَالْكِتَابِ الْمُنِيرِ","numberInSurah":184,"juz":4,"manzil":1,"page":74,"ruku":60,"hizbQuarter":29,"sajda":false},{"number":478,"text":"كُلُّ نَفْسٍ ذَائِقَةُ الْمَوْتِ ۗ وَإِنَّمَا تُوَفَّوْنَ أُجُورَكُمْ يَوْمَ الْقِيَامَةِ ۖ فَمَنْ زُحْزِحَ عَنِ النَّارِ وَأُدْخِلَ الْجَنَّةَ فَقَدْ فَازَ ۗ وَمَا الْحَيَاةُ الدُّنْيَا إِلَّا مَتَاعُ الْغُرُورِ","numberInSurah":185,"juz":4,"manzil":1,"page":74,"ruku":60,"hizbQuarter":29,"sajda":false},{"number":479,"text":"۞ لَتُبْلَوُنَّ فِي أَمْوَالِكُمْ وَأَنْفُسِكُمْ وَلَتَسْمَعُنَّ مِنَ الَّذِينَ أُوتُوا الْكِتَابَ مِنْ قَبْلِكُمْ وَمِنَ الَّذِينَ أَشْرَكُوا أَذًى كَثِيرًا ۚ وَإِنْ تَصْبِرُوا وَتَتَّقُوا فَإِنَّ ذَٰلِكَ مِنْ عَزْمِ الْأُمُورِ","numberInSurah":186,"juz":4,"manzil":1,"page":74,"ruku":60,"hizbQuarter":30,"sajda":false},{"number":480,"text":"وَإِذْ أَخَذَ اللَّهُ مِيثَاقَ الَّذِينَ أُوتُوا الْكِتَابَ لَتُبَيِّنُنَّهُ لِلنَّاسِ وَلَا تَكْتُمُونَهُ فَنَبَذُوهُ وَرَاءَ ظُهُورِهِمْ وَاشْتَرَوْا بِهِ ثَمَنًا قَلِيلًا ۖ فَبِئْسَ مَا يَشْتَرُونَ","numberInSurah":187,"juz":4,"manzil":1,"page":75,"ruku":60,"hizbQuarter":30,"sajda":false},{"number":481,"text":"لَا تَحْسَبَنَّ الَّذِينَ يَفْرَحُونَ بِمَا أَتَوْا وَيُحِبُّونَ أَنْ يُحْمَدُوا بِمَا لَمْ يَفْعَلُوا فَلَا تَحْسَبَنَّهُمْ بِمَفَازَةٍ مِنَ الْعَذَابِ ۖ وَلَهُمْ عَذَابٌ أَلِيمٌ","numberInSurah":188,"juz":4,"manzil":1,"page":75,"ruku":60,"hizbQuarter":30,"sajda":false},{"number":482,"text":"وَلِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ۗ وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":189,"juz":4,"manzil":1,"page":75,"ruku":60,"hizbQuarter":30,"sajda":false},{"number":483,"text":"إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ لَآيَاتٍ لِأُولِي الْأَلْبَابِ","numberInSurah":190,"juz":4,"manzil":1,"page":75,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":484,"text":"الَّذِينَ يَذْكُرُونَ اللَّهَ قِيَامًا وَقُعُودًا وَعَلَىٰ جُنُوبِهِمْ وَيَتَفَكَّرُونَ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ رَبَّنَا مَا خَلَقْتَ هَٰذَا بَاطِلًا سُبْحَانَكَ فَقِنَا عَذَابَ النَّارِ","numberInSurah":191,"juz":4,"manzil":1,"page":75,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":485,"text":"رَبَّنَا إِنَّكَ مَنْ تُدْخِلِ النَّارَ فَقَدْ أَخْزَيْتَهُ ۖ وَمَا لِلظَّالِمِينَ مِنْ أَنْصَارٍ","numberInSurah":192,"juz":4,"manzil":1,"page":75,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":486,"text":"رَبَّنَا إِنَّنَا سَمِعْنَا مُنَادِيًا يُنَادِي لِلْإِيمَانِ أَنْ آمِنُوا بِرَبِّكُمْ فَآمَنَّا ۚ رَبَّنَا فَاغْفِرْ لَنَا ذُنُوبَنَا وَكَفِّرْ عَنَّا سَيِّئَاتِنَا وَتَوَفَّنَا مَعَ الْأَبْرَارِ","numberInSurah":193,"juz":4,"manzil":1,"page":75,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":487,"text":"رَبَّنَا وَآتِنَا مَا وَعَدْتَنَا عَلَىٰ رُسُلِكَ وَلَا تُخْزِنَا يَوْمَ الْقِيَامَةِ ۗ إِنَّكَ لَا تُخْلِفُ الْمِيعَادَ","numberInSurah":194,"juz":4,"manzil":1,"page":75,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":488,"text":"فَاسْتَجَابَ لَهُمْ رَبُّهُمْ أَنِّي لَا أُضِيعُ عَمَلَ عَامِلٍ مِنْكُمْ مِنْ ذَكَرٍ أَوْ أُنْثَىٰ ۖ بَعْضُكُمْ مِنْ بَعْضٍ ۖ فَالَّذِينَ هَاجَرُوا وَأُخْرِجُوا مِنْ دِيَارِهِمْ وَأُوذُوا فِي سَبِيلِي وَقَاتَلُوا وَقُتِلُوا لَأُكَفِّرَنَّ عَنْهُمْ سَيِّئَاتِهِمْ وَلَأُدْخِلَنَّهُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ ثَوَابًا مِنْ عِنْدِ اللَّهِ ۗ وَاللَّهُ عِنْدَهُ حُسْنُ الثَّوَابِ","numberInSurah":195,"juz":4,"manzil":1,"page":76,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":489,"text":"لَا يَغُرَّنَّكَ تَقَلُّبُ الَّذِينَ كَفَرُوا فِي الْبِلَادِ","numberInSurah":196,"juz":4,"manzil":1,"page":76,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":490,"text":"مَتَاعٌ قَلِيلٌ ثُمَّ مَأْوَاهُمْ جَهَنَّمُ ۚ وَبِئْسَ الْمِهَادُ","numberInSurah":197,"juz":4,"manzil":1,"page":76,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":491,"text":"لَٰكِنِ الَّذِينَ اتَّقَوْا رَبَّهُمْ لَهُمْ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا نُزُلًا مِنْ عِنْدِ اللَّهِ ۗ وَمَا عِنْدَ اللَّهِ خَيْرٌ لِلْأَبْرَارِ","numberInSurah":198,"juz":4,"manzil":1,"page":76,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":492,"text":"وَإِنَّ مِنْ أَهْلِ الْكِتَابِ لَمَنْ يُؤْمِنُ بِاللَّهِ وَمَا أُنْزِلَ إِلَيْكُمْ وَمَا أُنْزِلَ إِلَيْهِمْ خَاشِعِينَ لِلَّهِ لَا يَشْتَرُونَ بِآيَاتِ اللَّهِ ثَمَنًا قَلِيلًا ۗ أُولَٰئِكَ لَهُمْ أَجْرُهُمْ عِنْدَ رَبِّهِمْ ۗ إِنَّ اللَّهَ سَرِيعُ الْحِسَابِ","numberInSurah":199,"juz":4,"manzil":1,"page":76,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":493,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اصْبِرُوا وَصَابِرُوا وَرَابِطُوا وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُفْلِحُونَ","numberInSurah":200,"juz":4,"manzil":1,"page":76,"ruku":61,"hizbQuarter":30,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":3,"name":"سُورَةُ آلِ عِمۡرَانَ","englishName":"Âl-i İmrân","englishNameTranslation":"The Family of Imraan","revelationType":"Medinan","numberOfAyahs":200,"ayahs":[{"number":294,"text":"Elif, Lam, Mim.","numberInSurah":1,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":295,"text":"Allah, Ondan başka tanrı olmayan, diri, her an yaratıklarını gözetip durandır.","numberInSurah":2,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":296,"text":"Kendisinden önceki Kitapları tasdik eden Hak Kitap'ı sana indirdi. Önceden insanlara yol gösterici olarak Tevrat ve İncil'i de indirmişti. O, doğruyu yanlıştan ayıran Kitap'ı indirdi. Doğrusu Allah'ın ayetlerini inkar edenler için şiddetli azab vardır. Allah güçlüdür, mazlumların öcünü alır.","numberInSurah":3,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":297,"text":"Kendisinden önceki Kitapları tasdik eden Hak Kitap'ı sana indirdi. Önceden insanlara yol gösterici olarak Tevrat ve İncil'i de indirmişti. O, doğruyu yanlıştan ayıran Kitap'ı indirdi. Doğrusu Allah'ın ayetlerini inkar edenler için şiddetli azab vardır. Allah güçlüdür, mazlumların öcünü alır.","numberInSurah":4,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":298,"text":"Şüphesiz gökte ve yerde hiçbir şey Allah'tan gizli kalmaz.","numberInSurah":5,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":299,"text":"Ana rahminde sizi dilediği gibi şekillendiren O'dur. O'ndan başka tanrı yoktur, güçlüdür, Hakim'dir.","numberInSurah":6,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":300,"text":"Sana Kitap'ı indiren O'dur. Onda Kitap'ın temeli olan kesin anlamlı ayetler vardır, diğerleri de çeşitli anlamlıdırlar. Kalblerinde eğrilik olan kimseler, fitne çıkarmak, kendilerine göre yorumlamak için onların çeşitli anlamlı olanlarına uyarlar. Oysa onların yorumunu ancak Allah bilir. İlimde derinleşmiş olanlar: \"Ona inandık, hepsi Rabbimiz'in katındandır\" derler. Bunu ancak akıl sahipleri düşünür;","numberInSurah":7,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":301,"text":"Rabbimiz! Bizi doğru yola erdirdikten sonra kalblerimizi eğriltme, katından bize rahmet bağışla; şüphesiz Sen sonsuz bağışta bulunansın.","numberInSurah":8,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":302,"text":"Rabbimiz! Doğrusu geleceği şüphe götürmeyen günde, insanları toplayacak olan Sensin. Şüphesiz ki Allah verdiği sözden caymaz.","numberInSurah":9,"juz":3,"manzil":1,"page":50,"ruku":42,"hizbQuarter":20,"sajda":false},{"number":303,"text":"İnkar edenlerin malları ve çocukları, Allah'a karşı onlara bir şey sağlamaz. İşte onlar ateşin yakıtlarıdır.","numberInSurah":10,"juz":3,"manzil":1,"page":51,"ruku":43,"hizbQuarter":20,"sajda":false},{"number":304,"text":"Bunların tutumu, Firavun ailesinin ve onlardan öncekilerin tutumu gibi ki, ayetlerimizi yalanladılar da Allah onları günahlarından dolayı yok (helak) etti. Allah'ın cezalandırması şiddetlidir.","numberInSurah":11,"juz":3,"manzil":1,"page":51,"ruku":43,"hizbQuarter":20,"sajda":false},{"number":305,"text":"İnkar edenlere: \"Yenileceksiniz, toplanıp cehenneme sürüleceksiniz, orası ne kötü döşektir\" de.","numberInSurah":12,"juz":3,"manzil":1,"page":51,"ruku":43,"hizbQuarter":20,"sajda":false},{"number":306,"text":"Karşı karşıya gelen iki topluluğun durumlarında sizin için ibret vardır; biri Allah yolunda savaşanlardır, diğeri inkarcılardır ki, bunlar karşı tarafı gözleriyle kendilerinin iki misli görüyorlardı. Allah dilediğini yardımıyla destekler. Bunda görebilenler için ibret vardır.","numberInSurah":13,"juz":3,"manzil":1,"page":51,"ruku":43,"hizbQuarter":20,"sajda":false},{"number":307,"text":"Kadınlara, oğullara, kantar kantar altın ve gümüşe, nişanlı atlar ve develere, ekinlere karşı aşırı sevgi beslemek insanlara güzel gösterilmiştir. Bunlar dünya hayatının nimetleridir, oysa gidilecek yerin güzeli Allah katındadır.","numberInSurah":14,"juz":3,"manzil":1,"page":51,"ruku":43,"hizbQuarter":20,"sajda":false},{"number":308,"text":"De ki: Bundan daha iyisini size haber vereyim mi? Allah'a karşı gelmekten sakınanlara, Rab'lerinin katında, altlarından ırmaklar akan ve orada temelli kalacakları cennetler, tertemiz eşler ve Allah'ın rızası vardır. Allah kullarını hakkiyle görücüdür.","numberInSurah":15,"juz":3,"manzil":1,"page":51,"ruku":43,"hizbQuarter":21,"sajda":false},{"number":309,"text":"Onlar ki, \"Rabbimiz! Biz şüphesiz inandık, bunun için günahlarımızı bize bağışla ve bizi ateşin azabından koru\" diyen, sabreden, doğru olan, gönülden kulluk eden, hayra sarfeden ve seher vakitlerinde bağışlanma dileyenlerdir.","numberInSurah":16,"juz":3,"manzil":1,"page":52,"ruku":43,"hizbQuarter":21,"sajda":false},{"number":310,"text":"Onlar ki, \"Rabbimiz! Biz şüphesiz inandık, bunun için günahlarımızı bize bağışla ve bizi ateşin azabından koru\" diyen, sabreden, doğru olan, gönülden kulluk eden, hayra sarfeden ve seher vakitlerinde bağışlanma dileyenlerdir.","numberInSurah":17,"juz":3,"manzil":1,"page":52,"ruku":43,"hizbQuarter":21,"sajda":false},{"number":311,"text":"Allah, melekler ve adaleti yerine getiren ilim sahibleri, O'ndan başka tanrı olmadığına şahidlik etmişlerdir. O'ndan başka tanrı yoktur, O güçlüdür, Hakim'dir.","numberInSurah":18,"juz":3,"manzil":1,"page":52,"ruku":43,"hizbQuarter":21,"sajda":false},{"number":312,"text":"Allah katında din, şüphesiz İslam'dır. Ancak, Kitap verilenler, kendilerine ilim geldikten sonra, aralarındaki ihtiras yüzünden ayrılığa düştüler. Allah'ın ayetlerini kim inkar ederse bilsin ki, Allah hesabı çabuk görür.","numberInSurah":19,"juz":3,"manzil":1,"page":52,"ruku":43,"hizbQuarter":21,"sajda":false},{"number":313,"text":"Eğer seninle tartışmaya girişirlerse, \"Ben bana uyanlarla birlikte kendimi Allah'a verdim\" de. Kendilerine Kitap verilenlere ve kitapsızlara: \"Siz de İslam oldunuz mu?\" de, şayet İslam olurlarsa doğru yola girmişlerdir, yüz çevirirlerse, sana yalnız tebliğ etmek düşer. Allah kullarını görür.","numberInSurah":20,"juz":3,"manzil":1,"page":52,"ruku":43,"hizbQuarter":21,"sajda":false},{"number":314,"text":"Allah'ın ayetlerini inkar edenlere, haksız yere peygamberleri öldürenlere, insanlardan adaleti emredenleri öldürenlere elem verici bir azabı müjdele.","numberInSurah":21,"juz":3,"manzil":1,"page":52,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":315,"text":"Onlar, dünya ve ahirette işleri boşa çıkacak olanlardır. Onların hiç yardımcıları da yoktur.","numberInSurah":22,"juz":3,"manzil":1,"page":52,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":316,"text":"Kendilerine Kitapdan bir pay verilenleri, görmedin mi? Onlar aralarında hüküm vermek için Allah'ın Kitabına çağırılmışlar, sonra onlardan bir takımı dönmüşlerdir. Onlar temelli yüz çevirenlerdir.","numberInSurah":23,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":317,"text":"Bu, onların: \"Bize ateş sadece sayılı birkaç gün değecektir\" demelerindendir. Uydurup durdukları şeyler, onları dinlerinde yanıltmıştır.","numberInSurah":24,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":318,"text":"Geleceğinden şüphe olmayan günde, onları topladığımız ve haksızlık yapılmayarak herkese kazandığı eksiksiz verildiği zaman, nasıl olacak?","numberInSurah":25,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":319,"text":"De ki: \"Mülkün sahibi olan Allah'ım! Mülkü dilediğine verirsin; dilediğinden çekip alırsın; dilediğini aziz kılar, dilediğini alçaltırsın; iyilik elindedir. Doğrusu Sen, her şeye Kadir'sin.","numberInSurah":26,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":320,"text":"Geceyi gündüze, gündüzü geceye geçirirsin; ölüden diri, diriden ölü çıkarırsın; dilediğini hesapsız rızıklandırırsın\".","numberInSurah":27,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":321,"text":"Müminler, müminleri bırakıp kafirleri dost edinmesinler; kim böyle yaparsa Allah katında bir değeri yoktur, ancak, onlardan sakınmanız hali müstesnadır. Allah sizi Kendisiyle korkutur, dönüş Allah'adır.","numberInSurah":28,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":322,"text":"De ki: \"İçinizde olanı gizleseniz de açıklasanız da Allah onu bilir. Göklerde olanları da, yerde olanları da bilir. Allah her şeye Kadir'dir\".","numberInSurah":29,"juz":3,"manzil":1,"page":53,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":323,"text":"Her kişinin yaptığı iyiliği ve yaptığı kötülüğü, ki kendisiyle o kötülük arasında uzun bir mesafe olmasını diler, hazır bulacağı günü bir düşünün. Kullarına karşı şefkatli olan Allah size kendinden korkmanızı emreder.","numberInSurah":30,"juz":3,"manzil":1,"page":54,"ruku":44,"hizbQuarter":21,"sajda":false},{"number":324,"text":"De ki: \"Allah'ı seviyorsanız bana uyun. Allah da sizi sevsin ve günahlarınızı bağışlasın. Allah affeder ve merhamet eder\".","numberInSurah":31,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":21,"sajda":false},{"number":325,"text":"De ki: \"Allah'a ve Peygambere itaat edin\". Yüz çevirirlerse bilsinler ki, Allah inkar edenleri sevmez.","numberInSurah":32,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":21,"sajda":false},{"number":326,"text":"Allah, Adem'i, Nuh'u, İbrahim ailesini, İmran ailesini birbirinin soyundan olarak alemlere tercih etti. Allah işitendir, bilendir.","numberInSurah":33,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":327,"text":"Allah, Adem'i, Nuh'u, İbrahim ailesini, İmran ailesini birbirinin soyundan olarak alemlere tercih etti. Allah işitendir, bilendir.","numberInSurah":34,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":328,"text":"İmran'ın karısı: \"Ya Rabbi! Karnımda olanı, sadece sana hizmet etmek üzere adadım, benden kabul buyur, doğrusu işiten ve bilen ancak Sensin\" demişti.","numberInSurah":35,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":329,"text":"Onu doğurduğunda, Allah onun ne doğurduğunu bilirken \"Ya Rabbi! Kız doğurdum. Erkek, kız gibi değildir, ben ona Meryem adını verdim, ben onu da soyunu da, kovulmuş şeytandan Sana sığındırırım\" dedi.","numberInSurah":36,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":330,"text":"Rabbi onu güzel bir kabulle karşıladı, güzel bir bitki gibi yetiştirdi; onu Zekeriya'nın himayesine bıraktı. Zekeriya mabedde onun yanına her girişinde, yanında bir yiyecek bulurdu. \"Ey Meryem! Bu sana nereden geldi?\" demiş, o da: Bu, Allah'ın katındandır\" cevabını vermişti. Doğrusu Allah dilediğini hesapsız rızıklandırır.","numberInSurah":37,"juz":3,"manzil":1,"page":54,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":331,"text":"Orada Zekeriya Rabbine dua etti: \"Ya Rabbi! Bana kendi katından temiz bir soy bahşet, doğrusu Sen duayı işitirsin\".","numberInSurah":38,"juz":3,"manzil":1,"page":55,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":332,"text":"Mabedde namaz kılarken melekler ona seslendiler: \"Allah sana Allah'ın emriyle (vücud bulan İsa'yı) tasdik eden, efendi, iffetli, iyilerden bir peygamber olarak Yahya'yı müjdeler\".","numberInSurah":39,"juz":3,"manzil":1,"page":55,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":333,"text":"\"Ya Rabbi! Ben artık iyice kocamış, karım da kısırken nasıl oğlum olabilir?\" dedi. Allah: \"Böyledir, Allah dilediğini yapar\" dedi.","numberInSurah":40,"juz":3,"manzil":1,"page":55,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":334,"text":"\"Ya Rabbi! Bana bir alamet ver\" dedi, \"Alametin, üç gün, işaretle anlaşma dışında insanlarla konuşmamandır; Rabbini çok an, akşam sabah hamd et\" dedi.","numberInSurah":41,"juz":3,"manzil":1,"page":55,"ruku":45,"hizbQuarter":22,"sajda":false},{"number":335,"text":"Melekler şöyle demişti: \"Ey Meryem! Allah seni seçip temizledi. Dünyaların kadınlarından seni üstün tuttu.\"","numberInSurah":42,"juz":3,"manzil":1,"page":55,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":336,"text":"\"Ey Meryem! Rabbine gönülden boyun eğ, secde et, rüku edenlerle birlikte rüku et.\"","numberInSurah":43,"juz":3,"manzil":1,"page":55,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":337,"text":"Bu Sana vahyettiğimiz gayb haberlerindendir. Meryem'e hangisi kefil olacak diye kalemlerini atarlarken sen yanlarında değildin, çekişirlerken de orada bulunmadın.","numberInSurah":44,"juz":3,"manzil":1,"page":55,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":338,"text":"Melekler demişti ki: \"Ey Meryem! Allah sana, Kendinden bir sözü, adı Meryem oğlu İsa olan Mesihi, dünya ve ahirette şerefli ve Allah'a yakın kılınanlardan olarak müjdeler\".","numberInSurah":45,"juz":3,"manzil":1,"page":55,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":339,"text":"\"İnsanlarla, beşikte iken de, yetişkin iken de konuşacaktır ve o, iyilerdendir\".","numberInSurah":46,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":340,"text":"Meryem: \"Rabbim! Bana bir insan dokunmamışken nasıl çocuğum olabilir?\" demişti. Melekler şöyle dediler: \"Allah dilediğini böylece yaratır. Bir işin olmasını dilerse ona ol der ve olur\".","numberInSurah":47,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":341,"text":"Ona Kitabı, hikmeti, Tevrat'ı ve İncil'i öğretecek, İsrailoğullarına şöyle diyen bir peygamber kılacak: \"Ben size Rabbinizden bir ayet getirdim. Ben size çamurdan kuş gibi bir şey yapıp ona üfleyeceğim, Allah'ın izniyle, hemen kuş olacaktır; anadan doğma körleri, alacalıları iyi edeceğim; Allah'ın izniyle, ölüleri dirilteceğim; yediklerinizi ve evlerinizde sakladıklarınızı da size haber vereceğim. İnanmışsanız bunda size delil vardır\".","numberInSurah":48,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":342,"text":"Ona Kitabı, hikmeti, Tevrat'ı ve İncil'i öğretecek, İsrailoğullarına şöyle diyen bir peygamber kılacak: \"Ben size Rabbinizden bir ayet getirdim. Ben size çamurdan kuş gibi bir şey yapıp ona üfleyeceğim, Allah'ın izniyle, hemen kuş olacaktır; anadan doğma körleri, alacalıları iyi edeceğim; Allah'ın izniyle, ölüleri dirilteceğim; yediklerinizi ve evlerinizde sakladıklarınızı da size haber vereceğim. İnanmışsanız bunda size delil vardır\".","numberInSurah":49,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":343,"text":"\"Benden önce gelen Tevrat'ı tasdik etmekle beraber size yasak edilenlerin bir kısmını helal kılmak üzere, Rabbinizden size bir ayet getirdim. Allah'tan sakının ve bana itaat edin; çünkü Allah benim de Rabbim, sizin de Rabbinizdir. O'na kulluk edin, bu doğru yoldur\".","numberInSurah":50,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":344,"text":"\"Benden önce gelen Tevrat'ı tasdik etmekle beraber size yasak edilenlerin bir kısmını helal kılmak üzere, Rabbinizden size bir ayet getirdim. Allah'tan sakının ve bana itaat edin; çünkü Allah benim de Rabbim, sizin de Rabbinizdir. O'na kulluk edin, bu doğru yoldur\".","numberInSurah":51,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":22,"sajda":false},{"number":345,"text":"İsa onların inkarlarını hissedince: \"Allah uğrunda yardımcılarım kimlerdir?\" dedi. Havariler şöyle dediler: \"Biz Allah'ın yardımcılarıyız, Allah'a inandık, O'na teslim olduğumuza şahid ol\".","numberInSurah":52,"juz":3,"manzil":1,"page":56,"ruku":46,"hizbQuarter":23,"sajda":false},{"number":346,"text":"\"Rabbimiz! İndirdiğine inandık, Peygambere uyduk; bizi sahid olanlarla beraber yaz\".","numberInSurah":53,"juz":3,"manzil":1,"page":57,"ruku":46,"hizbQuarter":23,"sajda":false},{"number":347,"text":"Fakat (inkarcılar) hile yaptılar. Allah da onları cezalandırdı. Allah, hile yapanların cezasını en iyi verendir.","numberInSurah":54,"juz":3,"manzil":1,"page":57,"ruku":46,"hizbQuarter":23,"sajda":false},{"number":348,"text":"Allah demişti ki: \"Ey İsa! Ben seni eceline yetireceğim, seni kendime yükselteceğim, inkar edenlerden seni tertemiz ayıracağım; sana uyanları, kıyamet gününe kadar, inkar edenlerin üstünde tutacağım. Sonra dönüşünüz Banadır. Ayrılığa düştüğünüz hususlarda aranızda hükmedeceğim. İnkar edenleri de dünya ve ahirette şiddetli azaba uğratacağım. Onların hiç yardımcıları olmayacaktır.\"","numberInSurah":55,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":349,"text":"Allah demişti ki: \"Ey İsa! Ben seni eceline yetireceğim, seni kendime yükselteceğim, inkar edenlerden seni tertemiz ayıracağım; sana uyanları, kıyamet gününe kadar, inkar edenlerin üstünde tutacağım. Sonra dönüşünüz Banadır. Ayrılığa düştüğünüz hususlarda aranızda hükmedeceğim. İnkar edenleri de dünya ve ahirette şiddetli azaba uğratacağım. Onların hiç yardımcıları olmayacaktır.\"","numberInSurah":56,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":350,"text":"İnanıp yararlı iş işleyenlerin ecirleri ise tastamam verilecektir. Allah zalimleri sevmez.","numberInSurah":57,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":351,"text":"Sana okuduğumuz bunlar, ayetlerden ve hikmet dolu Kuran'dandır.","numberInSurah":58,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":352,"text":"Allah'ın katında İsa'nın durumu kendisini topraktan yaratıp sonra ol demesiyle olmuş olan Adem'in durumu gibidir.","numberInSurah":59,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":353,"text":"Gerçek Rabb'indendir, o halde şüphelenenlerden olma.","numberInSurah":60,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":354,"text":"Sana ilim geldikten sonra, bu hususta seninle kim tartışacak olursa, de ki: \"Gelin, oğullarımızı, oğullarınızı, kadınlarımızı, kadınlarınızı, kendimizi ve kendinizi çağıralım, sonra lanetleşelim de, Allah'ın lanetinin yalancılara olmasını dileyelim\".","numberInSurah":61,"juz":3,"manzil":1,"page":57,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":355,"text":"Şüphesiz bu anlatılanlar gerçek olaylardır. Allah'tan başka tanrı yoktur. Doğrusu Allah güçlüdür, Hakim'dir.","numberInSurah":62,"juz":3,"manzil":1,"page":58,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":356,"text":"Eğer yüz çevirirlerse, şüphesiz Allah bozguncuları bilir.","numberInSurah":63,"juz":3,"manzil":1,"page":58,"ruku":47,"hizbQuarter":23,"sajda":false},{"number":357,"text":"De ki: \"Ey Kitap ehli! Ancak Allah'a kulluk etmek, O'na bir şeyi eş koşmamak, Allah'ı bırakıp birbirimizi rab olarak benimsememek üzere, bizimle sizin aranızda müşterek bir söze gelin\". Eğer yüz çevirirlerse: \"Bizim müslüman olduğumuza şahid olun\" deyin.","numberInSurah":64,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":358,"text":"Ey Kitap ehli! İbrahim hakkında niçin tartışıyorsunuz? Tevrat da, İncil de şüphesiz ondan sonra indirilmiştir. Akletmiyor musunuz?","numberInSurah":65,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":359,"text":"Siz, hadi bilginiz olan şey üzerinde tartışanlarsınız. Ama bilginiz olmayan şey hakkında niçin tartışırsınız? Oysa Allah bilir, sizler bilmezsiniz.","numberInSurah":66,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":360,"text":"İbrahim, yahudi de, hıristiyan da değildi, ama doğruya yönelen bir müslimdi; ortak koşanlardan değildi.","numberInSurah":67,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":361,"text":"Doğrusu İbrahim'e en yakın olanlar, ona uyanlar, bu Peygamber ve inananlardır. Allah inananların dostudur.","numberInSurah":68,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":362,"text":"Kitap ehlinden bir takımı sizi sapıtmak isterler; oysa kendilerini saptırırlar da farkına varmazlar.","numberInSurah":69,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":363,"text":"Ey Kitap ehli! Sizler göz göre göre Allah'ın ayetlerini niçin inkar ediyorsunuz?","numberInSurah":70,"juz":3,"manzil":1,"page":58,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":364,"text":"Ey Kitap ehli! Niçin hakkı batıla karıştırıyor ve bile bile hakkı gizliyorsunuz?","numberInSurah":71,"juz":3,"manzil":1,"page":59,"ruku":48,"hizbQuarter":23,"sajda":false},{"number":365,"text":"Kitap ehlinden bir takımı şöyle dedi: \"İnananlara indirilene günün başında inanın, sonunda inkar edin ki, belki dönerler ve dininize uyanlardan başkasına inanmayın\". De ki: \"Doğru yol Allah'ın yoludur\". Ve yine başkasına da verildiğine veya Rabbinizin katında Müslümanların karşı delil getirip sizi alt edeceğine inanmayın, derler. De ki: \"Doğrusu bol nimet Allah'ın elindedir, onu dilediğine verir. Allah'ın fazlı her şeyi kaplar, O her şeyi bilir\".","numberInSurah":72,"juz":3,"manzil":1,"page":59,"ruku":49,"hizbQuarter":23,"sajda":false},{"number":366,"text":"Kitap ehlinden bir takımı şöyle dedi: \"İnananlara indirilene günün başında inanın, sonunda inkar edin ki, belki dönerler ve dininize uyanlardan başkasına inanmayın\". De ki: \"Doğru yol Allah'ın yoludur\". Ve yine başkasına da verildiğine veya Rabbinizin katında Müslümanların karşı delil getirip sizi alt edeceğine inanmayın, derler. De ki: \"Doğrusu bol nimet Allah'ın elindedir, onu dilediğine verir. Allah'ın fazlı her şeyi kaplar, O her şeyi bilir\".","numberInSurah":73,"juz":3,"manzil":1,"page":59,"ruku":49,"hizbQuarter":23,"sajda":false},{"number":367,"text":"\"Rahmetini dilediğine tahsis eder, Allah büyük, bol nimet sahibidir\".","numberInSurah":74,"juz":3,"manzil":1,"page":59,"ruku":49,"hizbQuarter":23,"sajda":false},{"number":368,"text":"Kitap ehli arasında kantarla emanet bıraksan onu sana ödeyen ve bir lira emanet etsen, tepesine dikilmedikçe onu sana ödemeyen vardır. Bu, onların: \"Kitapsızlara karşı üzerimize bir sorumluluk yoktur\" demelerindendir. Onlar bile bile Allah'a karşı yalan söylemektedirler.","numberInSurah":75,"juz":3,"manzil":1,"page":59,"ruku":49,"hizbQuarter":24,"sajda":false},{"number":369,"text":"Hayır, öyle değil; ahdini yerine getiren ve günahtan sakınan bilsin ki, Allah sakınanları şüphesiz sever.","numberInSurah":76,"juz":3,"manzil":1,"page":59,"ruku":49,"hizbQuarter":24,"sajda":false},{"number":370,"text":"Allah'ın ahdini ve yeminlerini az bir değere değişenlerin, işte onların, ahirette bir payları yoktur. Allah onlara kıyamet günü hitab etmeyecek, onlara bakmayacak, onları temize çıkarmayacaktır. Elem verici azab onlar içindir.","numberInSurah":77,"juz":3,"manzil":1,"page":59,"ruku":49,"hizbQuarter":24,"sajda":false},{"number":371,"text":"Onlardan bir takımı, Kitapta olmadığı halde Kitaptan zannedesiniz diye dillerini eğip bükerler. O, Allah katından olmadığı halde: \"Allah katındandır\" derler, bile bile Allah'a karşı yalan söylerler.","numberInSurah":78,"juz":3,"manzil":1,"page":60,"ruku":49,"hizbQuarter":24,"sajda":false},{"number":372,"text":"Allah'ın kendisine Kitap'ı, hükmü, peygamberliği verdiği insanoğluna: \"Allah'ı bırakıp bana kulluk edin\" demek yaraşmaz, fakat: \"Kitabı öğrettiğinize, okuduğunuza göre Rabb'e kul olun\" demek yaraşır.","numberInSurah":79,"juz":3,"manzil":1,"page":60,"ruku":49,"hizbQuarter":24,"sajda":false},{"number":373,"text":"Size melekleri, peygamberleri Rab olarak benimsemenizi emretmesi de yaraşmaz. Siz müslüman olduktan sonra, size inkar etmeyi mi emredecek?","numberInSurah":80,"juz":3,"manzil":1,"page":60,"ruku":49,"hizbQuarter":24,"sajda":false},{"number":374,"text":"Allah peygamberlerden ahid almıştı: \"And olsun ki size Kitap, hikmet verdim; sizde olanı tasdik eden bir peygamber gelecek, ona mutlaka inanacaksınız ve ona mutlaka yardım edeceksiniz, ikrar edip bu ahdi kabul ettiniz mi?\" demişti. \"İkrar ettik\" demişlerdi de: \"Şahid olun, Ben de sizinle beraber şahidlerdenim\" demişti.","numberInSurah":81,"juz":3,"manzil":1,"page":60,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":375,"text":"Bunun ardından yüz çeviren var ya, işte onlar fasık olanlardır.","numberInSurah":82,"juz":3,"manzil":1,"page":60,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":376,"text":"Allah'ın dininden başka bir din mi arzu ediyorlar? Oysa göklerde ve yerde kim varsa, ister istemez O'na teslim olmuştur, O'na döneceklerdir.","numberInSurah":83,"juz":3,"manzil":1,"page":60,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":377,"text":"\"Allah'a, bize indirilene, İbrahim'e, İsmail'e, İshak'a, Yakub'a ve torunlarına indirilene, Rableri tarafından Musa, İsa ve peygamberlere verilene inandık, onları birbirinden ayırt etmeyiz, biz O'na teslim olanlarız\" de.","numberInSurah":84,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":378,"text":"Kim İslam'dan başka bir dine yönelirse, onunki kabul edilmeyecektir. O ahirette de kaybedenlerdendir.","numberInSurah":85,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":379,"text":"İnandıktan, peygamberin hak olduğuna şehadet ettikten, kendilerine belgeler geldikten sonra inkar eden bir milleti Allah nasıl doğru yola eriştirir? Allah zalimleri doğru yola eriştirmez.","numberInSurah":86,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":380,"text":"İşte bunların cezası, Allah'ın, meleklerin, insanların hepsinin lanetine uğramalarıdır.","numberInSurah":87,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":381,"text":"Orada temellidirler; onlardan azab hafifletilmez; onların azabı geciktirilmez.","numberInSurah":88,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":382,"text":"Ancak bunun ardından tevbe edip düzelenler müstesnadır. Doğrusu Allah bağışlar ve merhamet eder.","numberInSurah":89,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":383,"text":"İnandıktan sonra inkar edip, inkarda aşırı gidenler var ya, onların tevbeleri kabul edilmeyecektir. İşte sapıklar onlardır.","numberInSurah":90,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":384,"text":"Doğrusu inkar edip, inkarcı olarak ölenlerin hiçbirinden, yeryüzünü dolduracak kadar altını fidye vermiş olsa bile, bu kabul edilmeyecektir. İşte elem verici azab onlaradır, onların hiç yardımcıları da yoktur.","numberInSurah":91,"juz":3,"manzil":1,"page":61,"ruku":50,"hizbQuarter":24,"sajda":false},{"number":385,"text":"Sevdiğiniz şeylerden sarfetmedikçe iyiliğe erişemezsiniz. Her ne sarfederseniz, şüphesiz Allah onu bilir.","numberInSurah":92,"juz":3,"manzil":1,"page":62,"ruku":51,"hizbQuarter":24,"sajda":false},{"number":386,"text":"Tevrat'ın indirilmesinden önce İsrail'in kendisine haram ettiğinden başka bütün yiyecekler İsrailoğullarına helal idi. De ki: \"Doğru sözlü iseniz Tevrat'ı getirip okuyun\".","numberInSurah":93,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":387,"text":"Bundan sonra Allah'a karşı kim yalan isnad ederse, işte onlar zalimlerdir.","numberInSurah":94,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":388,"text":"De ki: \"Allah doğru söyledi, doğruya meyleden İbrahim'in dinine uyun; O, puta tapanlardan değildi\".","numberInSurah":95,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":389,"text":"Doğrusu insanlar için ilk kurulan ev, Mekke'de, dünyalar için mübarek ve doğru yol gösteren Kabe'dir.","numberInSurah":96,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":390,"text":"Orada apaçık deliller vardır, İbrahim'in makamı vardır; kim oraya girerse, güvenlik içinde olur; oraya yol bulabilen insana Allah için Kabe'yi haccetmesi gereklidir. Kim inkar ederse, bilsin ki; doğrusu Allah alemlerden müstağnidir.","numberInSurah":97,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":391,"text":"De ki: \"Ey Kitap ehli! Allah yaptıklarınızı görüp dururken, niçin Allah'ın ayetlerini inkar ediyorsunuz?\"","numberInSurah":98,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":392,"text":"De ki: \"Ey Kitap ehli! Siz doğru olduğuna şahidken, niçin inananları Allah'ın yolunu eğri göstermeğe yeltenerek ondan çeviriyorsunuz? Allah işlediklerinizden gafil değildir\".","numberInSurah":99,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":393,"text":"Ey İnananlar! Kitap verilenlerin bir takımına uyarsanız, inanmanızdan sonra sizi kafir olmağa çevirirler.","numberInSurah":100,"juz":4,"manzil":1,"page":62,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":394,"text":"Allah'ın ayetleri size okunur, aranızda da Peygamberi bulunurken nasıl inkar edersiniz? Kim Allah'ın Kitabına sarılırsa şüphesiz doğru yola erişir.","numberInSurah":101,"juz":4,"manzil":1,"page":63,"ruku":51,"hizbQuarter":25,"sajda":false},{"number":395,"text":"Ey inananlar! Allah'tan, sakınılması gerektiği gibi sakının, sizler ancak müslüman olarak can verin.","numberInSurah":102,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":396,"text":"Toptan Allah'ın ipine sarılın, ayrılmayın. Allah'ın size olan nimetini anın: Düşmandınız, kalblerinizin arasını uzlaştırdı da onun nimeti sayesinde kardeş oldunuz. Bir ateş çukurunun kenarında idiniz, sizi oradan kurtardı. Allah, doğru yola erişesiniz diye size böylece ayetlerini açıklar.","numberInSurah":103,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":397,"text":"Sizden, iyiye çağıran, doğruluğu emreden ve fenalıktan meneden bir cemaat olsun. İşte başarıya erişenler yalnız onlardır.","numberInSurah":104,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":398,"text":"Kendilerine belgeler geldikten sonra ayrılan ve ayrılığa düşenler gibi olmayın. Bir takım yüzlerin ağaracağı ve bir takım yüzlerin kararacağı günde büyük azab onlaradır. Yüzleri kararanlara: \"İnanmanızdan sonra inkar eder misiniz? İnkar etmenizden dolayı tadın azabı\" denecektir.","numberInSurah":105,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":399,"text":"Kendilerine belgeler geldikten sonra ayrılan ve ayrılığa düşenler gibi olmayın. Bir takım yüzlerin ağaracağı ve bir takım yüzlerin kararacağı günde büyük azab onlaradır. Yüzleri kararanlara: \"İnanmanızdan sonra inkar eder misiniz? İnkar etmenizden dolayı tadın azabı\" denecektir.","numberInSurah":106,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":400,"text":"Yüzleri ağaranlar ise Allah'ın rahmetindedirler. Onlar orada temellidirler.","numberInSurah":107,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":401,"text":"İşte bunlar, sana doğru olarak okuduğumuz Allah'ın ayetleridir. Allah hiç kimseye zulmetmek istemez.","numberInSurah":108,"juz":4,"manzil":1,"page":63,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":402,"text":"Göklerde olanlar da, yerde olanlar da Allah'ındır. İşler Allah'a varacaktır.","numberInSurah":109,"juz":4,"manzil":1,"page":64,"ruku":52,"hizbQuarter":25,"sajda":false},{"number":403,"text":"Siz, insanlar için ortaya çıkarılan, doğruluğu emreden, fenalıktan alıkoyan, Allah'a inanan hayırlı bir ümmetsiniz. Kitap ehli inanmış olsalardı, kendileri için daha hayırlı olurdu; içlerinde inananlar olmakla beraber, çoğu yoldan çıkmıştır.","numberInSurah":110,"juz":4,"manzil":1,"page":64,"ruku":53,"hizbQuarter":25,"sajda":false},{"number":404,"text":"Onlar incitmekten başka size bir zarar veremezler. Sizinle savaşa koyulurlarsa, geri dönüp kaçarlar. Sonra kendilerine yardım da edilmez.","numberInSurah":111,"juz":4,"manzil":1,"page":64,"ruku":53,"hizbQuarter":25,"sajda":false},{"number":405,"text":"Nerede bulunsalar Allah'ın ve inanan insanların himayesinde olanlar müstesna onlara alçaklık damgası vurulmuştur. Allah'tan bir gazaba uğradılar, onlara aşağılık damgası vuruldu. Bu, Allah'ın ayetlerini inkar etmeleri ve haksız yere peygamberleri öldürmelerindendir. Bu, karşı gelmeleri ve taşkınlık yapmalarındandır.","numberInSurah":112,"juz":4,"manzil":1,"page":64,"ruku":53,"hizbQuarter":25,"sajda":false},{"number":406,"text":"Kitap ehlinin hepsi bir değildir: Onlardan geceleri secdeye kapanarak Allah'ın ayetlerini okuyup duranlar vardır; bunlar Allah'a ve ahiret gününe inanır, kötülükten meneder, iyiliklere koşarlar. İşte onlar iyilerdendir.","numberInSurah":113,"juz":4,"manzil":1,"page":64,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":407,"text":"Kitap ehlinin hepsi bir değildir: Onlardan geceleri secdeye kapanarak Allah'ın ayetlerini okuyup duranlar vardır; bunlar Allah'a ve ahiret gününe inanır, kötülükten meneder, iyiliklere koşarlar. İşte onlar iyilerdendir.","numberInSurah":114,"juz":4,"manzil":1,"page":64,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":408,"text":"Ne iyilik yaparlarsa, karşılığını bulacaklardır. Allah sakınanları bilir.","numberInSurah":115,"juz":4,"manzil":1,"page":64,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":409,"text":"İnkar eden kimselerin malları ve çocukları, Allah'tan yana, onlara bir fayda vermeyecektir. İşte onlar cehennemliklerdir, onlar orada temellidirler.","numberInSurah":116,"juz":4,"manzil":1,"page":65,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":410,"text":"Bu dünya hayatında sarfettiklerinin durumu, kendilerine zulmeden kimselerin ekinlerine isabetle kavurup mahveden soğuk bir rüzgarın durumu gibidir. Allah onlara zulmetmedi, onlar kendilerine yazık ettiler.","numberInSurah":117,"juz":4,"manzil":1,"page":65,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":411,"text":"Ey İnananlar! Sizden olmayanı sırdaş edinmeyin, onlar sizi şaşırtmaktan geri durmazlar, sıkıntıya düşmenizi isterler. Onların öfkesi ağızlarından taşmaktadır, kalblerinin gizlediği ise daha büyüktür. Eğer aklediyorsanız, şüphesiz size ayetleri açıkladık.","numberInSurah":118,"juz":4,"manzil":1,"page":65,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":412,"text":"İşte siz, onlar sizi sevmezken onları seven ve Kitapların bütününe inanan kimselersiniz. Size rastladıkları zaman: \"İnandık\" derler, yalnız kaldıklarında da, size öfkelerinden parmaklarını ısırırlar. De ki: \"Öfkenizden çatlayın\". Allah kalblerde olanı bilir.","numberInSurah":119,"juz":4,"manzil":1,"page":65,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":413,"text":"Size bir iyilik gelse, onların fenasına gider; başınıza bir kötülük gelse buna sevinirler. Sabreder ve sakınırsanız, onların hilesi size hiçbir zarar vermez. Allah işlediklerinin hepsini ilmiyle kuşatmıştır.","numberInSurah":120,"juz":4,"manzil":1,"page":65,"ruku":53,"hizbQuarter":26,"sajda":false},{"number":414,"text":"Sen inananları savaş için duracakları yerlere yerleştirmek üzere, erkenden evinden ayrılmıştın. Allah işitir ve bilir.","numberInSurah":121,"juz":4,"manzil":1,"page":65,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":415,"text":"Sizden iki takım bozulup geri çekilmek üzere idi; oysa Allah onların dostu idi, inananlar yalnız Allah'a güvensinler.","numberInSurah":122,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":416,"text":"And olsun ki, siz düşkün bir durumda iken, Bedir'de, Allah size yardım etmişti; Allah'tan sakının ki şükredebilesiniz.","numberInSurah":123,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":417,"text":"İnananlara: \"Rabbinizin size gönderilmiş üç bin melekle yardım etmesi size yetmeyecek mi?\" diyordun. Evet, eğer sabrederseniz, sakınırsanız ve onlar de hemen üzerinize gelirlerse Rabbiniz size, nişanlı beş bin melekle imdat edecektir.","numberInSurah":124,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":418,"text":"İnananlara: \"Rabbinizin size gönderilmiş üç bin melekle yardım etmesi size yetmeyecek mi?\" diyordun. Evet, eğer sabrederseniz, sakınırsanız ve onlar de hemen üzerinize gelirlerse Rabbiniz size, nişanlı beş bin melekle imdat edecektir.","numberInSurah":125,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":419,"text":"Allah bunu, ancak size müjde olsun ve böylece kalbleriniz yatışsın diye yapmıştır. İnkar edenlerin bir kısmını kesmek veya ümidsiz olarak geri dönecek şekilde bozguna uğratmak için gereken yardım, ancak Güçlü ve Hakim olan Allah katından olur.","numberInSurah":126,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":420,"text":"Allah bunu, ancak size müjde olsun ve böylece kalbleriniz yatışsın diye yapmıştır. İnkar edenlerin bir kısmını kesmek veya ümidsiz olarak geri dönecek şekilde bozguna uğratmak için gereken yardım, ancak Güçlü ve Hakim olan Allah katından olur.","numberInSurah":127,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":421,"text":"Allah'ın, onların tevbelerini kabul veya onlara azab etmesi işiyle senin bir ilişiğin yoktur; çünkü onlar zalimlerdir.","numberInSurah":128,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":422,"text":"Göklerde olanlar da, yerde olanlar da Allah'ındır. Dilediğini bağışlar, dilediğine azab eder. Allah bağışlayandır, merhamet edendir.","numberInSurah":129,"juz":4,"manzil":1,"page":66,"ruku":54,"hizbQuarter":26,"sajda":false},{"number":423,"text":"Ey İnananlar! Faizi kat kat alarak yemeyin. Allah'tan sakının ki başarıya erişesiniz.","numberInSurah":130,"juz":4,"manzil":1,"page":66,"ruku":55,"hizbQuarter":26,"sajda":false},{"number":424,"text":"İnkar edenler için hazırlanmış ateşten sakının.","numberInSurah":131,"juz":4,"manzil":1,"page":66,"ruku":55,"hizbQuarter":26,"sajda":false},{"number":425,"text":"Size merhamet edilmesi için, Allah'a ve Peygamber'e itaat edin.","numberInSurah":132,"juz":4,"manzil":1,"page":66,"ruku":55,"hizbQuarter":26,"sajda":false},{"number":426,"text":"Rabbinizin mağfiretine ve Allah'a karşı gelmekten sakınanlar için hazırlanmış eni gökler ve yer kadar olan cennete koşuşun.","numberInSurah":133,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":427,"text":"Onlar bollukta ve darlıkta sarfederler, öfkelerini yenerler, insanların kusurlarını affederler. Allah iyilik yapanları sever.","numberInSurah":134,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":428,"text":"Onlar fena bir şey yaptıklarında veya kendilerine zulmettiklerinde Allah'ı anarlar, günahlarının bağışlanmasını dilerler. Günahları Allah'tan başka bağışlayan kim vardır? Onlar, yaptıklarında bile bile direnmezler.","numberInSurah":135,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":429,"text":"Onların hareketlerinin karşılığı Rablerinden bağışlanma ve altlarından ırmaklar akan, içinde temelli kalacakları cennetlerdir. İyi davrananların ne güzel ecri vardır!","numberInSurah":136,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":430,"text":"Sizden önce neler gelip geçmiştir. Yeryüzünde gezin de, yalancıların sonunun ne olduğuna bir bakın.","numberInSurah":137,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":431,"text":"Bu Kuran, insanlara bir açıklama, sakınanlara yol gösterme ve bir öğüttür.","numberInSurah":138,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":432,"text":"Gevşemeyin, üzülmeyin, inanmışsanız, mutlaka siz en üstünsünüzdür.","numberInSurah":139,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":433,"text":"Eğer siz (Uhud'da) bir yara almışsanız, (size düşman olan) o topluluk da (Bedir'de) benzeri bir yara almıştı. Böylece biz, Allah'ın gerçek müminleri ortaya çıkarması ve içinizden şahitler edinmesi için, bu günleri bazen lehe, bazen de aleyhe döndürüp duruyoruz. Allah, zulmedenleri sevmez.","numberInSurah":140,"juz":4,"manzil":1,"page":67,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":434,"text":"Bir de Allah, böylece iman edenleri günahlardan arıtmak, inkarcıları ise yok etmek ister.","numberInSurah":141,"juz":4,"manzil":1,"page":68,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":435,"text":"Yoksa içinizden Allah cihad edenleri ve sabredenleri belirtmeden cennete gireceğinizi mi sanıyordunuz?","numberInSurah":142,"juz":4,"manzil":1,"page":68,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":436,"text":"And olsun ki, ölümle karşılaşmadan önce onu temenni ediyordunuz; işte onu gözlerinizle bakarak gördünüz.","numberInSurah":143,"juz":4,"manzil":1,"page":68,"ruku":55,"hizbQuarter":27,"sajda":false},{"number":437,"text":"Muhammed ancak bir peygamberdir. Ondan önce de peygamberler geçmişti. Ölür veya öldürülürse geriye mi döneceksiniz? Geriye dönen, Allah'a hiçbir zarar vermez. Allah şükredenlerin mükafatını verecektir.","numberInSurah":144,"juz":4,"manzil":1,"page":68,"ruku":56,"hizbQuarter":27,"sajda":false},{"number":438,"text":"Hiçbir kimse Allah'ın izni olmadan ölmez; o, belli bir vakte bağlanmıştır. Kim dünya nimetini isterse ona ondan veririz; ve kim ahiret nimetini isterse ona ondan veririz. Şükredenlerin mükafatını vereceğiz.","numberInSurah":145,"juz":4,"manzil":1,"page":68,"ruku":56,"hizbQuarter":27,"sajda":false},{"number":439,"text":"Nice peygamberlerin yanında Rabbe kul olmuş pek çok kimse savaşmıştır. Allah yolunda başlarına gelenlerden ötürü gevşememişler, yılmamışlar ve boyun eğmemişlerdi. Allah, sabredenleri sever.","numberInSurah":146,"juz":4,"manzil":1,"page":68,"ruku":56,"hizbQuarter":27,"sajda":false},{"number":440,"text":"Dedikleri ancak şu idi: \"Rabbimiz! Günahlarımızı, işimizdeki aşırılıklarımızı bize bağışla, sebatımızı arttır, inkarcı topluluğa karşı bize yardım et\".","numberInSurah":147,"juz":4,"manzil":1,"page":68,"ruku":56,"hizbQuarter":27,"sajda":false},{"number":441,"text":"Bu yüzden Allah onlara dünya nimetini de ahiret nimetini de fazlasiyle verdi. Allah işlerini iyi yapanları sever.","numberInSurah":148,"juz":4,"manzil":1,"page":68,"ruku":56,"hizbQuarter":27,"sajda":false},{"number":442,"text":"Ey İnananlar! İnkar edenlere itaat ederseniz, sizi geriye döndürürler de kayba uğrarsınız.","numberInSurah":149,"juz":4,"manzil":1,"page":69,"ruku":57,"hizbQuarter":27,"sajda":false},{"number":443,"text":"Halbuki Mevlanız Allah'tır. O, yardımcıların en iyisidir.","numberInSurah":150,"juz":4,"manzil":1,"page":69,"ruku":57,"hizbQuarter":27,"sajda":false},{"number":444,"text":"Hakkında hiçbir delil indirmediği şeyi Allah'a ortak koşmalarından ötürü, inkar edenlerin kalbine korku salacağız. Onların varacağı yer cehennemdir. Zalimlerin durağı ne kötüdür!","numberInSurah":151,"juz":4,"manzil":1,"page":69,"ruku":57,"hizbQuarter":27,"sajda":false},{"number":445,"text":"And olsun ki, Allah, size verdiği sözde durdu. Onun izniyle kafirleri kırıp biçiyordunuz, ama Allah size arzuladığınız zaferi gösterdikten sonra gevşeyip bu hususta çekiştiniz ve isyan ettiniz; sizden kimi dünyayı, kimi ahireti istiyordu; derken denemek için Allah sizi geri çevirip bozguna uğrattı. And olsun ki O, sizi bağışladı. Allah'ın inananlara nimeti boldur.","numberInSurah":152,"juz":4,"manzil":1,"page":69,"ruku":57,"hizbQuarter":27,"sajda":false},{"number":446,"text":"Peygamber arkanızdan sizi çağırırken, kimseye bakmadan kaçıyordunuz; kaybettiğinize ve başınıza gelene üzülmeyesiniz diye, Allah sizi kederden kedere uğrattı. Allah, işlediklerinizden haberdardır.","numberInSurah":153,"juz":4,"manzil":1,"page":69,"ruku":57,"hizbQuarter":28,"sajda":false},{"number":447,"text":"Kederden sonra, bir takımınızı kendinden geçirecek şekilde size huzur ve emniyet indirdi; oysa bir takımınız da kendi derdlerine düşmüşlerdi. Haksız yere Allah hakkında, cahiliye devrinde olduğu gibi inanıyorlar. \"Bu işte bizim bir fikrimiz var mı?\" diyorlardı; De ki: \"Buyruğun hepsi Allah'ındır\". Sana açmadıklarını içlerinde gizliyorlar. \"Bu işte bizim fikrimiz alınsaydı, burada öldürülmezdik\" diyorlar. De ki: Evlerinizde olsaydınız, haklarında ölüm yazılı olan kimseler, yine de devrilecekleri yere varırlardı. Bu, Allah'ın içinizde olanı denemesi, kalblerinizde olanı arıtması içindir. Allah gönüllerde olanı bilir.","numberInSurah":154,"juz":4,"manzil":1,"page":70,"ruku":57,"hizbQuarter":28,"sajda":false},{"number":448,"text":"İki topluluğun karşılaştığı gün, içinizden yüz çevirenlerin, yaptıklarının bir kısmından ötürü şeytan ayaklarını kaydırıp yoldan çıkarmak istemişti. Allah, and olsun ki, onları affetti. Allah bağışlayandır. Halim'dir.","numberInSurah":155,"juz":4,"manzil":1,"page":70,"ruku":57,"hizbQuarter":28,"sajda":false},{"number":449,"text":"Ey İnananlar! Yolculuğa çıkan veya savaşa giden kardeşleri hakkında: \"Onlar yanımızda olsalardı ölmezler ve öldürülmezlerdi\" diyen inkarcılar gibi olmayın ki, Allah bunu onların kalblerinde bir hasret olarak bıraksın. Dirilten de öldüren de Allah'tır. Allah işlediklerinizi görür.","numberInSurah":156,"juz":4,"manzil":1,"page":70,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":450,"text":"Allah yolunda öldürülür veya ölürseniz, size Allah'tan onların topladıklarından hayırlı bir mağfiret ve rahmet vardır.","numberInSurah":157,"juz":4,"manzil":1,"page":70,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":451,"text":"And olsun ki, ölseniz de, öldürülseniz de Allah katında toplanacaksınız.","numberInSurah":158,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":452,"text":"Allah'ın rahmetinden dolayı, sen onlara karşı yumuşak davrandın. Eğer kaba ve katı kalbli olsaydın, şüphesiz etrafından dağılır giderlerdi. Onları affet, onlara mağfiret dile, iş hakkında onlara danış, fakat karar verdin mi Allah'a güven, doğrusu Allah güvenenleri sever.","numberInSurah":159,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":453,"text":"Allah size yardım ederse, sizi yenecek yoktur; eğer sizi yardımsız bırakıverirse, O'ndan başka size yardım edecek kimdir? İnananlar yalnız Allah'a güvensinler.","numberInSurah":160,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":454,"text":"Hiçbir peygambere ganimete ve millet malına hiyanet yaraşmaz; haksızlık kim yaparsa, kıyamet günü yaptığı ile gelir, sonra, haksızlık yapılmaksızın herkese kazanmış olduğu ödenir.","numberInSurah":161,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":455,"text":"Allah'ın rızasına uyan kimse, Allah'ın hışmına uğrayan gibi midir? Bu kimsenin varacağı yer cehennemdir; o ne kötü varılacak yerdir!","numberInSurah":162,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":456,"text":"Onlar Allah katında derece derecedir. Allah, işlediklerini görmektedir.","numberInSurah":163,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":457,"text":"And olsun ki Allah, inananlara, ayetlerini okuyan, onları arıtan, onlara Kitap ve hikmeti öğreten, kendilerinden bir peygamber göndermekle iyilikte bulunmuştur. Halbuki onlar, önceleri apaçık sapıklıkta idiler.","numberInSurah":164,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":458,"text":"Başkalarını iki misline uğrattığınız bir musibete kendiniz uğrayınca mı: \"Bu nereden?\" dersiniz? De ki: \"O, kendi tarafınızdandır\". Doğrusu Allah her şeye Kadir'dir.","numberInSurah":165,"juz":4,"manzil":1,"page":71,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":459,"text":"İki topluluğun karşılaştığı günde başınıza gelen, Allah'ın izniyledir. Bu, inananları da, münafıklık edenleri de belirtmesi içindir. Münafıklık edenlere: \"gelin, Allah yolunda savaşın, veya hiç olmazsa savunmada bulunun\" dendiği zaman: \"Eğer savaşmayı bilseydik, ardınızdan gelirdik\" dediler. O gün, onlar imandan çok inkara yakındılar. Kalblerinde olmayanı ağızlarıyla söylüyorlar. Allah gizlediklerini onlardan iyi bilir.","numberInSurah":166,"juz":4,"manzil":1,"page":72,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":460,"text":"İki topluluğun karşılaştığı günde başınıza gelen, Allah'ın izniyledir. Bu, inananları da, münafıklık edenleri de belirtmesi içindir. Münafıklık edenlere: \"gelin, Allah yolunda savaşın, veya hiç olmazsa savunmada bulunun\" dendiği zaman: \"Eğer savaşmayı bilseydik, ardınızdan gelirdik\" dediler. O gün, onlar imandan çok inkara yakındılar. Kalblerinde olmayanı ağızlarıyla söylüyorlar. Allah gizlediklerini onlardan iyi bilir.","numberInSurah":167,"juz":4,"manzil":1,"page":72,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":461,"text":"Onlar oturup, kardeşleri için: \"Bize itaat etselerdi öldürülmezlerdi\" dediler. De ki: \"Eğer doğru sözlü iseniz, ölümü kendinizden savın\".","numberInSurah":168,"juz":4,"manzil":1,"page":72,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":462,"text":"Allah yolunda öldürülenleri ölü saymayın, bilakis Rableri katında diridirler. Allah'ın bol nimetinden onlara verdiği şeylerle sevinç içinde rızıklanırlar, arkalarından kendilerine ulaşamayan kimselere, kendilerine korku olmadığını ve kendilerinin üzülmeyeceklerini müjde etmek isterler.","numberInSurah":169,"juz":4,"manzil":1,"page":72,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":463,"text":"Allah yolunda öldürülenleri ölü saymayın, bilakis Rableri katında diridirler. Allah'ın bol nimetinden onlara verdiği şeylerle sevinç içinde rızıklanırlar, arkalarından kendilerine ulaşamayan kimselere, kendilerine korku olmadığını ve kendilerinin üzülmeyeceklerini müjde etmek isterler.","numberInSurah":170,"juz":4,"manzil":1,"page":72,"ruku":58,"hizbQuarter":28,"sajda":false},{"number":464,"text":"Onlar Allah'tan olan bir nimeti, bolluğu ve Allah'ın, müminlerin ecrini zayi etmeyeceğini müjdelemek isterler.","numberInSurah":171,"juz":4,"manzil":1,"page":72,"ruku":58,"hizbQuarter":29,"sajda":false},{"number":465,"text":"Kendileri savaşta yara aldıktan sonra Allah ve Peygamberin çağrısına koşanlara, hele onlardan iyilik edip sakınanlara büyük ecir vardır.","numberInSurah":172,"juz":4,"manzil":1,"page":72,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":466,"text":"İnsanlar onlara: \"Düşmanınız olan insanlar size karşı bir ordu topladılar, onlardan korkun\" dediler. Bu, onların imanını artırdı da: \"Allah bize yeter. O ne güzel Vekil'dir\" dediler.","numberInSurah":173,"juz":4,"manzil":1,"page":72,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":467,"text":"Bu yüzden kendilerine bir fenalık dokunmadan, Allah'tan nimet ve bollukla geri döndüler; Allah'ın rızasına uydular. Allah büyük, bol nimet sahibidir.","numberInSurah":174,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":468,"text":"İşte o şeytan ancak kendi dostlarını korkutur, inanmışsanız onlardan korkmayın, Benden korkun.","numberInSurah":175,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":469,"text":"Küfürde yarışanlar seni üzmesin; şüphesiz onlar Allah'a bir zarar veremezler. Allah ahirette onlara bir pay vermemek istiyor; onlara büyük azab vardır.","numberInSurah":176,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":470,"text":"İmanı inkar edenler, kendilerine vermiş olduğumuz mühletin sakın kendileri için hayırlı olduğunu sanmasınlar.","numberInSurah":177,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":471,"text":"Biz onlara ancak, günahları çoğalsın diye mühlet veriyoruz. Küçültücü azab onlaradır.","numberInSurah":178,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":472,"text":"Allah inananları sizin durumunuzda bırakacak değildir, temizi pisten ayıracaktır. Allah size gaybı bildirecek değildir; fakat Allah peygamberlerinden dilediğini seçip, ona gaybı bildirir. Artık Allah'a ve peygamberlerine inanın; inanır ve sakınırsanız size büyük ecir vardır.","numberInSurah":179,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":473,"text":"Allah'ın bol nimetinden verdiklerinde cimrilik edenler, sakın bunun kendileri için hayırlı olduğunu sanmasınlar, bilakis bu onların kötülüğünedir. Cimrilik yaptıkları şey, kıyamet günü boyunlarına dolanacaktır. Göklerin ve yerin mirası Allah'ındır. Allah işlediklerinizden haberdardır.","numberInSurah":180,"juz":4,"manzil":1,"page":73,"ruku":59,"hizbQuarter":29,"sajda":false},{"number":474,"text":"And olsun ki, Allah: \"Allah fakir; biz zenginiz\" diyenlerin sözünü işitmiştir. Dediklerini ve haksız yere peygamberleri öldürdüklerini elbette yazacağız, \"Yakıcı azabı tadın\" diyeceğiz.","numberInSurah":181,"juz":4,"manzil":1,"page":74,"ruku":60,"hizbQuarter":29,"sajda":false},{"number":475,"text":"\"Bu, yaptığınızın karşılığıdır\". Yoksa Allah kullara asla zulmetmez.","numberInSurah":182,"juz":4,"manzil":1,"page":74,"ruku":60,"hizbQuarter":29,"sajda":false},{"number":476,"text":"\"Doğrusu, ateşin yiyeceği bir kurban getirmedikçe hiçbir peygambere inanmamak üzere Allah bize ahid verdi\" diyenlere sen, de ki: \"Benden önce peygamberler size belgeler ve dediğiniz şeyi getirdi. Doğru sözlü iseniz niçin onları öldürdünüz?\"","numberInSurah":183,"juz":4,"manzil":1,"page":74,"ruku":60,"hizbQuarter":29,"sajda":false},{"number":477,"text":"Seni yalancı saydılarsa, senden önce belgeler, sahifeler ve aydınlatıcı kitap getiren peygamberler de yalanlanmıştı.","numberInSurah":184,"juz":4,"manzil":1,"page":74,"ruku":60,"hizbQuarter":29,"sajda":false},{"number":478,"text":"Her insan ölümü tadacaktır. Kıyamet günü, ecirleriniz size mutlaka ödenecektir. Ateşten uzaklaştırılıp cennete sokulan kimse artık kurtulmuştur. Dünya hayatı, zaten, sadece aldatıcı bir geçinmeden ibarettir.","numberInSurah":185,"juz":4,"manzil":1,"page":74,"ruku":60,"hizbQuarter":29,"sajda":false},{"number":479,"text":"And olsun ki mallarınız ve canlarınızla sınanacaksınız; hiç şüphesiz, sizden önce Kitap verilenlerden ve Allah'a eş koşanlardan çok üzücü sözler işiteceksiniz. Sabreder ve Allah'a karşı gelmekten sakınırsanız bilin ki, bu üzerinde sebat edilecek işlerdendir.","numberInSurah":186,"juz":4,"manzil":1,"page":74,"ruku":60,"hizbQuarter":30,"sajda":false},{"number":480,"text":"Allah, Kitap verilenlerden, onu insanlara açıklayacaksınız ve gizlemeyeceksiniz, diye ahid almıştı. Onlar ise, onu arkalarına atıp az bir değere değiştiler. Alış verişleri ne kötüdür!","numberInSurah":187,"juz":4,"manzil":1,"page":75,"ruku":60,"hizbQuarter":30,"sajda":false},{"number":481,"text":"Ettiklerine sevinen ve yapmadıklarıyla övülmekten hoşlananların, sakın onların azabdan kurtulacaklarını sanma; elem verici azab onlaradır.","numberInSurah":188,"juz":4,"manzil":1,"page":75,"ruku":60,"hizbQuarter":30,"sajda":false},{"number":482,"text":"Göklerin ve yerin hükümranlığı Allah'ındır. Allah her şeye Kadir'dir.","numberInSurah":189,"juz":4,"manzil":1,"page":75,"ruku":60,"hizbQuarter":30,"sajda":false},{"number":483,"text":"Göklerin ve yerin yaratılışında, gece ile gündüzün birbiri ardınca gelmesinde akıl sahiblerine şüphesiz deliller vardır.","numberInSurah":190,"juz":4,"manzil":1,"page":75,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":484,"text":"Onlar ayakta iken, otururken, yan yatarken Allah'ı anarlar; göklerin ve yerin yaratılışını düşünürler: \"Rabbimiz! Sen bunu boşuna yaratmadın, Sen münezzehsin. Bizi ateşin azabından koru\"","numberInSurah":191,"juz":4,"manzil":1,"page":75,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":485,"text":"\"Rabbimiz! Sen ateşe kimi sokarsan, onu şüphesiz rezil etmiş olursun, zulmedenlerin hiç yardımcıları yoktur\".","numberInSurah":192,"juz":4,"manzil":1,"page":75,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":486,"text":"\"Rabbimiz! Doğrusu biz Rabbinize inanın diye inanmaya çağıran bir çağırıcıyı işittik de iman ettik. Rabbimiz! Günahlarımızı bize bağışla, kötülüklerimizi ört, canımızi iyilerle beraber al\".","numberInSurah":193,"juz":4,"manzil":1,"page":75,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":487,"text":"\"Rabbimiz! Peygamberlerinle vadettiklerini bize ver, kıyamet günü bizi rezil etme. Sen şüphesiz sözünden caymazsın\".","numberInSurah":194,"juz":4,"manzil":1,"page":75,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":488,"text":"Rableri dualarını kabul etti: \"Birbirinizden meydana gelen sizlerden, erkek olsun, kadın olsun, iş yapanın işini boşa çıkarmam. Hicret edenlerin, memleketlerinden çıkarılanların, yolumda ezaya uğratılanların, savaşan ve öldürülenlerin günahlarını elbette örteceğim. And olsun ki, Allah katından bir nimet olarak, onları içlerinden ırmaklar akan cennetlere koyacağım. Nimetin güzeli Allah katındadır\".","numberInSurah":195,"juz":4,"manzil":1,"page":76,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":489,"text":"İnkar edenlerin diyar diyar gezip refah içinde dolaşması sakın seni aldatmasın; az bir faydalanmadan sonra onların varacakları yer cehennemdir. O ne kötü duraktır!..","numberInSurah":196,"juz":4,"manzil":1,"page":76,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":490,"text":"İnkar edenlerin diyar diyar gezip refah içinde dolaşması sakın seni aldatmasın; az bir faydalanmadan sonra onların varacakları yer cehennemdir. O ne kötü duraktır!..","numberInSurah":197,"juz":4,"manzil":1,"page":76,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":491,"text":"Fakat Rablerinden sakınanlara, Allah katından konukluklar bulunan, içlerinden ırmaklar akan, içinde temelli kalacakları cennetler vardır. Allah katındaki şeyler, iyi olanlar için daha hayırlıdır.","numberInSurah":198,"juz":4,"manzil":1,"page":76,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":492,"text":"Kitap ehlinden Allah'a huşu duyarak inanıp, Allah'ın ayetlerini az bir değere değişmeyenler vardır. İşte onların ecirleri Rablerinin katındadır. Şüphesiz Allah'ın hesabı çabuktur.","numberInSurah":199,"juz":4,"manzil":1,"page":76,"ruku":61,"hizbQuarter":30,"sajda":false},{"number":493,"text":"Ey İnananlar! Sabredin, düşmanlarınızdan daha sabırlı olun, cihada hazır bulunun, Allah'a karşı gelmekten sakının ki başarıya erişebilesiniz.","numberInSurah":200,"juz":4,"manzil":1,"page":76,"ruku":61,"hizbQuarter":30,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}