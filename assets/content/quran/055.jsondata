3,"sajda":false},{"number":4975,"text":"لَمْ يَطْمِثْهُنَّ إِنْسٌ قَبْلَهُمْ وَلَا جَانٌّ","numberInSurah":74,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4976,"text":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ","numberInSurah":75,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4977,"text":"مُتَّكِئِينَ عَلَىٰ رَفْرَفٍ خُضْرٍ وَعَبْقَرِيٍّ حِسَانٍ","numberInSurah":76,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4978,"text":"فَبِأَيِّ آلَاءِ رَبِّكُمَا تُكَذِّبَانِ","numberInSurah":77,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4979,"text":"تَبَارَكَ اسْمُ رَبِّكَ ذِي الْجَلَالِ وَالْإِكْرَامِ","numberInSurah":78,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":55,"name":"سُورَةُ الرَّحۡمَٰن","englishName":"Rahmân","englishNameTranslation":"The Beneficent","revelationType":"Medinan","numberOfAyahs":78,"ayahs":[{"number":4902,"text":"Rahman olan Allah Kuran'ı öğretti;","numberInSurah":1,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4903,"text":"Rahman olan Allah Kuran'ı öğretti;","numberInSurah":2,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4904,"text":"İnsanı yarattı, ona konuşmayı öğretti.","numberInSurah":3,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4905,"text":"İnsanı yarattı, ona konuşmayı öğretti.","numberInSurah":4,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4906,"text":"Güneş ve ayın hareketleri bir hesaba göredir.","numberInSurah":5,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4907,"text":"Bitkiler ve ağaçlar O'nun buyruğuna boyun eğerler.","numberInSurah":6,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4908,"text":"O, göğü yükseltmiştir; tartıyı koymuştur.","numberInSurah":7,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4909,"text":"Artık tartıda tecavüz etmeyin.","numberInSurah":8,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4910,"text":"Tartmayı doğru yapın, tartıyı eksik tutmayın.","numberInSurah":9,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4911,"text":"Allah, yeri yaratıkları için meydana getirmiştir.","numberInSurah":10,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4912,"text":"Orada meyveler, salkımlı hurma ağaçları, kabuklu taneler, güzel kokulu otlar vardır.","numberInSurah":11,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4913,"text":"Orada meyveler, salkımlı hurma ağaçları, kabuklu taneler, güzel kokulu otlar vardır.","numberInSurah":12,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4914,"text":"Ey insanlar ve cinler! Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":13,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4915,"text":"O, insanı pişmiş çamur gibi kuru balçıktan yaratmıştır.","numberInSurah":14,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4916,"text":"Cinleri de yalın bir alevden yaratmıştır.","numberInSurah":15,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4917,"text":"Öyleyken; Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":16,"juz":27,"manzil":7,"page":531,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4918,"text":"O, iki doğunun Rabbidir, iki batının Rabbidir.","numberInSurah":17,"juz":27,"manzil":7,"page":532,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4919,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":18,"juz":27,"manzil":7,"page":532,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4920,"text":"Acı ve tatlı sulu iki denizi birbirine kavuşmamak üzere salıvermiştir.","numberInSurah":19,"juz":27,"manzil":7,"page":532,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4921,"text":"Aralarında bir engel vardır; birbirinin sınırını aşamazlar.","numberInSurah":20,"juz":27,"manzil":7,"page":532,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4922,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":21,"juz":27,"manzil":7,"page":532,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4923,"text":"Bu iki denizden de inci ve mercan çıkar.","numberInSurah":22,"juz":27,"manzil":7,"page":532,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4924,"text":"Öyleyken Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":23,"juz":27,"manzil":7,"page":532,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4925,"text":"Denizde yürüyen dağlar gibi gemiler O'nundur.","numberInSurah":24,"juz":27,"manzil":7,"page":532,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4926,"text":"Öyleyken Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":25,"juz":27,"manzil":7,"page":532,"ruku":466,"hizbQuarter":213,"sajda":false},{"number":4927,"text":"Yeryüzünde bulunan her şey fanidir.","numberInSurah":26,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4928,"text":"Ancak, yüce ve cömert olan Rabbinin varlığı bakidir.","numberInSurah":27,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4929,"text":"Öyleyken Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":28,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4930,"text":"Göklerde ve yerde olan kimseler her şeyi O'ndan isterler; O her an kainata tasarruf etmektedir.","numberInSurah":29,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4931,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":30,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4932,"text":"Ey insan ve cin toplulukları! Sizin de hesabınızı ele alacağız.","numberInSurah":31,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4933,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":32,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4934,"text":"Ey cin ve insan toplulukları! Göklerin ve yerin çevresini aşıp geçmeye gücünüz yetiyorsa geçin! Ama Allah'ın verdiği bir güç olmaksızın geçemezsiniz ki!","numberInSurah":33,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4935,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":34,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4936,"text":"Ey insanlar ve cinler! Üzerinize dumansız bir alev ve ateşsiz bir duman gönderilir de kurtulamazsınız.","numberInSurah":35,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4937,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":36,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4938,"text":"Gök yarılıp da, gül gibi kızardığı, yağ gibi eridiği zaman haliniz nice olur?","numberInSurah":37,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4939,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":38,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4940,"text":"O gün ne insana ve ne cine suçu sorulur.","numberInSurah":39,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4941,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":40,"juz":27,"manzil":7,"page":532,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4942,"text":"Suçlular simalarından tanınırlar da, alın saçlarından ve ayaklarından yakalanırlar.","numberInSurah":41,"juz":27,"manzil":7,"page":533,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4943,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":42,"juz":27,"manzil":7,"page":533,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4944,"text":"İşte suçluların yalanladıkları cehennem budur.","numberInSurah":43,"juz":27,"manzil":7,"page":533,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4945,"text":"Onlar, cehennem ateşiyle kaynar su arasında dolaşır dururlar.","numberInSurah":44,"juz":27,"manzil":7,"page":533,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4946,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":45,"juz":27,"manzil":7,"page":533,"ruku":467,"hizbQuarter":213,"sajda":false},{"number":4947,"text":"Rabbine karşı durmaktan korkan kimseye iki cennet vardır.","numberInSurah":46,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4948,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":47,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4949,"text":"Bu iki cennet türlü ağaçlarla doludur.","numberInSurah":48,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4950,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":49,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4951,"text":"Bu cennetlerden akan iki kaynak vardır.","numberInSurah":50,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4952,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":51,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4953,"text":"Bu cennetlerde türlü meyveden çift çift vardır.","numberInSurah":52,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4954,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":53,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4955,"text":"Orada, örtüleri parlak atlastan yataklara yaslanırlar; iki cennetin meyvelerini de kolayca toplarlar.","numberInSurah":54,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4956,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":55,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4957,"text":"Orada, bakışlarını yalnız eşlerine çevirmiş, daha önce ne insan ve ne de cinlerin dokunmuş olduğu eşler vardır.","numberInSurah":56,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4958,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":57,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4959,"text":"Onlar yakut ve mercan gibidirler.","numberInSurah":58,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4960,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":59,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4961,"text":"İyiliğin karşılığı ancak iyilik değil midir?","numberInSurah":60,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4962,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":61,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4963,"text":"Bu iki cennetten başka iki cennet daha vardır.","numberInSurah":62,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4964,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":63,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4965,"text":"Renkleri koyu yeşildir.","numberInSurah":64,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4966,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":65,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4967,"text":"İkisinde de durmadan fışkıran iki kaynak vardır.","numberInSurah":66,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4968,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":67,"juz":27,"manzil":7,"page":533,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4969,"text":"İkisinde de türlü türlü meyveler, hurmalıklar ve nar ağaçları vardır.","numberInSurah":68,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4970,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":69,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4971,"text":"Oralarda iyi huylu güzel kadınlar vardır.","numberInSurah":70,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4972,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":71,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4973,"text":"Çadırlar içinde ceylan gözlüler vardır.","numberInSurah":72,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4974,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":73,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4975,"text":"Onlara daha önce insan da, cin de dokunmamıştır.","numberInSurah":74,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4976,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":75,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4977,"text":"Cennetlikler orada yeşil yastıklara ve harikulade işlemeli döşeklere yaslanırlar.","numberInSurah":76,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4978,"text":"Öyleyken, Rabbinizin nimetlerinden hangisini yalanlarsınız?","numberInSurah":77,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false},{"number":4979,"text":"Büyük ve pek cömert olan Rabbinin adı ne yücedir!","numberInSurah":78,"juz":27,"manzil":7,"page":534,"ruku":468,"hizbQuarter":213,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}