{"arabic":{"number":6,"name":"سُورَةُ الأَنۡعَامِ","englishName":"En'âm","englishNameTranslation":"The Cattle","revelationType":"Meccan","numberOfAyahs":165,"ayahs":[{"number":790,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الْحَمْدُ لِلَّهِ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ وَجَعَلَ الظُّلُمَاتِ وَالنُّورَ ۖ ثُمَّ الَّذِينَ كَفَرُوا بِرَبِّهِمْ يَعْدِلُونَ","numberInSurah":1,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":791,"text":"هُوَ الَّذِي خَلَقَكُمْ مِنْ طِينٍ ثُمَّ قَضَىٰ أَجَلًا ۖ وَأَجَلٌ مُسَمًّى عِنْدَهُ ۖ ثُمَّ أَنْتُمْ تَمْتَرُونَ","numberInSurah":2,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":792,"text":"وَهُوَ اللَّهُ فِي السَّمَاوَاتِ وَفِي الْأَرْضِ ۖ يَعْلَمُ سِرَّكُمْ وَجَهْرَكُمْ وَيَعْلَمُ مَا تَكْسِبُونَ","numberInSurah":3,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":793,"text":"وَمَا تَأْتِيهِمْ مِنْ آيَةٍ مِنْ آيَاتِ رَبِّهِمْ إِلَّا كَانُوا عَنْهَا مُعْرِضِينَ","numberInSurah":4,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":794,"text":"فَقَدْ كَذَّبُوا بِالْحَقِّ لَمَّا جَاءَهُمْ ۖ فَسَوْفَ يَأْتِيهِمْ أَنْبَاءُ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ","numberInSurah":5,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":795,"text":"أَلَمْ يَرَوْا كَمْ أَهْلَكْنَا مِنْ قَبْلِهِمْ مِنْ قَرْنٍ مَكَّنَّاهُمْ فِي الْأَرْضِ مَا لَمْ نُمَكِّنْ لَكُمْ وَأَرْسَلْنَا السَّمَاءَ عَلَيْهِمْ مِدْرَارًا وَجَعَلْنَا الْأَنْهَارَ تَجْرِي مِنْ تَحْتِهِمْ فَأَهْلَكْنَاهُمْ بِذُنُوبِهِمْ وَأَنْشَأْنَا مِنْ بَعْدِهِمْ قَرْنًا آخَرِينَ","numberInSurah":6,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":796,"text":"وَلَوْ نَزَّلْنَا عَلَيْكَ كِتَابًا فِي قِرْطَاسٍ فَلَمَسُوهُ بِأَيْدِيهِمْ لَقَالَ الَّذِينَ كَفَرُوا إِنْ هَٰذَا إِلَّا سِحْرٌ مُبِينٌ","numberInSurah":7,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":797,"text":"وَقَالُوا لَوْلَا أُنْزِلَ عَلَيْهِ مَلَكٌ ۖ وَلَوْ أَنْزَلْنَا مَلَكًا لَقُضِيَ الْأَمْرُ ثُمَّ لَا يُنْظَرُونَ","numberInSurah":8,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":798,"text":"وَلَوْ جَعَلْنَاهُ مَلَكًا لَجَعَلْنَاهُ رَجُلًا وَلَلَبَسْنَا عَلَيْهِمْ مَا يَلْبِسُونَ","numberInSurah":9,"juz":7,"manzil":2,"page":129,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":799,"text":"وَلَقَدِ اسْتُهْزِئَ بِرُسُلٍ مِنْ قَبْلِكَ فَحَاقَ بِالَّذِينَ سَخِرُوا مِنْهُمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ","numberInSurah":10,"juz":7,"manzil":2,"page":129,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":800,"text":"قُلْ سِيرُوا فِي الْأَرْضِ ثُمَّ انْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الْمُكَذِّبِينَ","numberInSurah":11,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":51,"sajda":false},{"number":801,"text":"قُلْ لِمَنْ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ ۖ قُلْ لِلَّهِ ۚ كَتَبَ عَلَىٰ نَفْسِهِ الرَّحْمَةَ ۚ لَيَجْمَعَنَّكُمْ إِلَىٰ يَوْمِ الْقِيَامَةِ لَا رَيْبَ فِيهِ ۚ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ فَهُمْ لَا يُؤْمِنُونَ","numberInSurah":12,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":51,"sajda":false},{"number":802,"text":"۞ وَلَهُ مَا سَكَنَ فِي اللَّيْلِ وَالنَّهَارِ ۚ وَهُوَ السَّمِيعُ الْعَلِيمُ","numberInSurah":13,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":803,"text":"قُلْ أَغَيْرَ اللَّهِ أَتَّخِذُ وَلِيًّا فَاطِرِ السَّمَاوَاتِ وَالْأَرْضِ وَهُوَ يُطْعِمُ وَلَا يُطْعَمُ ۗ قُلْ إِنِّي أُمِرْتُ أَنْ أَكُونَ أَوَّلَ مَنْ أَسْلَمَ ۖ وَلَا تَكُونَنَّ مِنَ الْمُشْرِكِينَ","numberInSurah":14,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":804,"text":"قُلْ إِنِّي أَخَافُ إِنْ عَصَيْتُ رَبِّي عَذَابَ يَوْمٍ عَظِيمٍ","numberInSurah":15,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":805,"text":"مَنْ يُصْرَفْ عَنْهُ يَوْمَئِذٍ فَقَدْ رَحِمَهُ ۚ وَذَٰلِكَ الْفَوْزُ الْمُبِينُ","numberInSurah":16,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":806,"text":"وَإِنْ يَمْسَسْكَ اللَّهُ بِضُرٍّ فَلَا كَاشِفَ لَهُ إِلَّا هُوَ ۖ وَإِنْ يَمْسَسْكَ بِخَيْرٍ فَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":17,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":807,"text":"وَهُوَ الْقَاهِرُ فَوْقَ عِبَادِهِ ۚ وَهُوَ الْحَكِيمُ الْخَبِيرُ","numberInSurah":18,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":808,"text":"قُلْ أَيُّ شَيْءٍ أَكْبَرُ شَهَادَةً ۖ قُلِ اللَّهُ ۖ شَهِيدٌ بَيْنِي وَبَيْنَكُمْ ۚ وَأُوحِيَ إِلَيَّ هَٰذَا الْقُرْآنُ لِأُنْذِرَكُمْ بِهِ وَمَنْ بَلَغَ ۚ أَئِنَّكُمْ لَتَشْهَدُونَ أَنَّ مَعَ اللَّهِ آلِهَةً أُخْرَىٰ ۚ قُلْ لَا أَشْهَدُ ۚ قُلْ إِنَّمَا هُوَ إِلَٰهٌ وَاحِدٌ وَإِنَّنِي بَرِيءٌ مِمَّا تُشْرِكُونَ","numberInSurah":19,"juz":7,"manzil":2,"page":130,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":809,"text":"الَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يَعْرِفُونَهُ كَمَا يَعْرِفُونَ أَبْنَاءَهُمُ ۘ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ فَهُمْ لَا يُؤْمِنُونَ","numberInSurah":20,"juz":7,"manzil":2,"page":130,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":810,"text":"وَمَنْ أَظْلَمُ مِمَّنِ افْتَرَىٰ عَلَى اللَّهِ كَذِبًا أَوْ كَذَّبَ بِآيَاتِهِ ۗ إِنَّهُ لَا يُفْلِحُ الظَّالِمُونَ","numberInSurah":21,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":811,"text":"وَيَوْمَ نَحْشُرُهُمْ جَمِيعًا ثُمَّ نَقُولُ لِلَّذِينَ أَشْرَكُوا أَيْنَ شُرَكَاؤُكُمُ الَّذِينَ كُنْتُمْ تَزْعُمُونَ","numberInSurah":22,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":812,"text":"ثُمَّ لَمْ تَكُنْ فِتْنَتُهُمْ إِلَّا أَنْ قَالُوا وَاللَّهِ رَبِّنَا مَا كُنَّا مُشْرِكِينَ","numberInSurah":23,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":813,"text":"انْظُرْ كَيْفَ كَذَبُوا عَلَىٰ أَنْفُسِهِمْ ۚ وَضَلَّ عَنْهُمْ مَا كَانُوا يَفْتَرُونَ","numberInSurah":24,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":814,"text":"وَمِنْهُمْ مَنْ يَسْتَمِعُ إِلَيْكَ ۖ وَجَعَلْنَا عَلَىٰ قُلُوبِهِمْ أَكِنَّةً أَنْ يَفْقَهُوهُ وَفِي آذَانِهِمْ وَقْرًا ۚ وَإِنْ يَرَوْا كُلَّ آيَةٍ لَا يُؤْمِنُوا بِهَا ۚ حَتَّىٰ إِذَا جَاءُوكَ يُجَادِلُونَكَ يَقُولُ الَّذِينَ كَفَرُوا إِنْ هَٰذَا إِلَّا أَسَاطِيرُ الْأَوَّلِينَ","numberInSurah":25,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":815,"text":"وَهُمْ يَنْهَوْنَ عَنْهُ وَيَنْأَوْنَ عَنْهُ ۖ وَإِنْ يُهْلِكُونَ إِلَّا أَنْفُسَهُمْ وَمَا يَشْعُرُونَ","numberInSurah":26,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":816,"text":"وَلَوْ تَرَىٰ إِذْ وُقِفُوا عَلَى النَّارِ فَقَالُوا يَا لَيْتَنَا نُرَدُّ وَلَا نُكَذِّبَ بِآيَاتِ رَبِّنَا وَنَكُونَ مِنَ الْمُؤْمِنِينَ","numberInSurah":27,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":817,"text":"بَلْ بَدَا لَهُمْ مَا كَانُوا يُخْفُونَ مِنْ قَبْلُ ۖ وَلَوْ رُدُّوا لَعَادُوا لِمَا نُهُوا عَنْهُ وَإِنَّهُمْ لَكَاذِبُونَ","numberInSurah":28,"juz":7,"manzil":2,"page":131,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":818,"text":"وَقَالُوا إِنْ هِيَ إِلَّا حَيَاتُنَا الدُّنْيَا وَمَا نَحْنُ بِمَبْعُوثِينَ","numberInSurah":29,"juz":7,"manzil":2,"page":131,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":819,"text":"وَلَوْ تَرَىٰ إِذْ وُقِفُوا عَلَىٰ رَبِّهِمْ ۚ قَالَ أَلَيْسَ هَٰذَا بِالْحَقِّ ۚ قَالُوا بَلَىٰ وَرَبِّنَا ۚ قَالَ فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْفُرُونَ","numberInSurah":30,"juz":7,"manzil":2,"page":131,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":820,"text":"قَدْ خَسِرَ الَّذِينَ كَذَّبُوا بِلِقَاءِ اللَّهِ ۖ حَتَّىٰ إِذَا جَاءَتْهُمُ السَّاعَةُ بَغْتَةً قَالُوا يَا حَسْرَتَنَا عَلَىٰ مَا فَرَّطْنَا فِيهَا وَهُمْ يَحْمِلُونَ أَوْزَارَهُمْ عَلَىٰ ظُهُورِهِمْ ۚ أَلَا سَاءَ مَا يَزِرُونَ","numberInSurah":31,"juz":7,"manzil":2,"page":131,"ruku":105,"hizbQuarter":52,"sajda":false},{"number":821,"text":"وَمَا الْحَيَاةُ الدُّنْيَا إِلَّا لَعِبٌ وَلَهْوٌ ۖ وَلَلدَّارُ الْآخِرَةُ خَيْرٌ لِلَّذِينَ يَتَّقُونَ ۗ أَفَلَا تَعْقِلُونَ","numberInSurah":32,"juz":7,"manzil":2,"page":131,"ruku":105,"hizbQuarter":52,"sajda":false},{"number":822,"text":"قَدْ نَعْلَمُ إِنَّهُ لَيَحْزُنُكَ الَّذِي يَقُولُونَ ۖ فَإِنَّهُمْ لَا يُكَذِّبُونَكَ وَلَٰكِنَّ الظَّالِمِينَ بِآيَاتِ اللَّهِ يَجْحَدُونَ","numberInSurah":33,"juz":7,"manzil":2,"page":131,"ruku":105,"hizbQuarter":52,"sajda":false},{"number":823,"text":"وَلَقَدْ كُذِّبَتْ رُسُلٌ مِنْ قَبْلِكَ فَصَبَرُوا عَلَىٰ مَا كُذِّبُوا وَأُوذُوا حَتَّىٰ أَتَاهُمْ نَصْرُنَا ۚ وَلَا مُبَدِّلَ لِكَلِمَاتِ اللَّهِ ۚ وَلَقَدْ جَاءَكَ مِنْ نَبَإِ الْمُرْسَلِينَ","numberInSurah":34,"juz":7,"manzil":2,"page":131,"ruku":105,"hizbQuarter":52,"sajda":false},{"number":824,"text":"وَإِنْ كَانَ كَبُرَ عَلَيْكَ إِعْرَاضُهُمْ فَإِنِ اسْتَطَعْتَ أَنْ تَبْتَغِيَ نَفَقًا فِي الْأَرْضِ أَوْ سُلَّمًا فِي السَّمَاءِ فَتَأْتِيَهُمْ بِآيَةٍ ۚ وَلَوْ شَاءَ اللَّهُ لَجَمَعَهُمْ عَلَى الْهُدَىٰ ۚ فَلَا تَكُونَنَّ مِنَ الْجَاهِلِينَ","numberInSurah":35,"juz":7,"manzil":2,"page":131,"ruku":105,"hizbQuarter":52,"sajda":false},{"number":825,"text":"۞ إِنَّمَا يَسْتَجِيبُ الَّذِينَ يَسْمَعُونَ ۘ وَالْمَوْتَىٰ يَبْعَثُهُمُ اللَّهُ ثُمَّ إِلَيْهِ يُرْجَعُونَ","numberInSurah":36,"juz":7,"manzil":2,"page":132,"ruku":105,"hizbQuarter":53,"sajda":false},{"number":826,"text":"وَقَالُوا لَوْلَا نُزِّلَ عَلَيْهِ آيَةٌ مِنْ رَبِّهِ ۚ قُلْ إِنَّ اللَّهَ قَادِرٌ عَلَىٰ أَنْ يُنَزِّلَ آيَةً وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ","numberInSurah":37,"juz":7,"manzil":2,"page":132,"ruku":105,"hizbQuarter":53,"sajda":false},{"number":827,"text":"وَمَا مِنْ دَابَّةٍ فِي الْأَرْضِ وَلَا طَائِرٍ يَطِيرُ بِجَنَاحَيْهِ إِلَّا أُمَمٌ أَمْثَالُكُمْ ۚ مَا فَرَّطْنَا فِي الْكِتَابِ مِنْ شَيْءٍ ۚ ثُمَّ إِلَىٰ رَبِّهِمْ يُحْشَرُونَ","numberInSurah":38,"juz":7,"manzil":2,"page":132,"ruku":105,"hizbQuarter":53,"sajda":false},{"number":828,"text":"وَالَّذِينَ كَذَّبُوا بِآيَاتِنَا صُمٌّ وَبُكْمٌ فِي الظُّلُمَاتِ ۗ مَنْ يَشَإِ اللَّهُ يُضْلِلْهُ وَمَنْ يَشَأْ يَجْعَلْهُ عَلَىٰ صِرَاطٍ مُسْتَقِيمٍ","numberInSurah":39,"juz":7,"manzil":2,"page":132,"ruku":105,"hizbQuarter":53,"sajda":false},{"number":829,"text":"قُلْ أَرَأَيْتَكُمْ إِنْ أَتَاكُمْ عَذَابُ اللَّهِ أَوْ أَتَتْكُمُ السَّاعَةُ أَغَيْرَ اللَّهِ تَدْعُونَ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":40,"juz":7,"manzil":2,"page":132,"ruku":105,"hizbQuarter":53,"sajda":false},{"number":830,"text":"بَلْ إِيَّاهُ تَدْعُونَ فَيَكْشِفُ مَا تَدْعُونَ إِلَيْهِ إِنْ شَاءَ وَتَنْسَوْنَ مَا تُشْرِكُونَ","numberInSurah":41,"juz":7,"manzil":2,"page":132,"ruku":105,"hizbQuarter":53,"sajda":false},{"number":831,"text":"وَلَقَدْ أَرْسَلْنَا إِلَىٰ أُمَمٍ مِنْ قَبْلِكَ فَأَخَذْنَاهُمْ بِالْبَأْسَاءِ وَالضَّرَّاءِ لَعَلَّهُمْ يَتَضَرَّعُونَ","numberInSurah":42,"juz":7,"manzil":2,"page":132,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":832,"text":"فَلَوْلَا إِذْ جَاءَهُمْ بَأْسُنَا تَضَرَّعُوا وَلَٰكِنْ قَسَتْ قُلُوبُهُمْ وَزَيَّنَ لَهُمُ الشَّيْطَانُ مَا كَانُوا يَعْمَلُونَ","numberInSurah":43,"juz":7,"manzil":2,"page":132,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":833,"text":"فَلَمَّا نَسُوا مَا ذُكِّرُوا بِهِ فَتَحْنَا عَلَيْهِمْ أَبْوَابَ كُلِّ شَيْءٍ حَتَّىٰ إِذَا فَرِحُوا بِمَا أُوتُوا أَخَذْنَاهُمْ بَغْتَةً فَإِذَا هُمْ مُبْلِسُونَ","numberInSurah":44,"juz":7,"manzil":2,"page":132,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":834,"text":"فَقُطِعَ دَابِرُ الْقَوْمِ الَّذِينَ ظَلَمُوا ۚ وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","numberInSurah":45,"juz":7,"manzil":2,"page":133,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":835,"text":"قُلْ أَرَأَيْتُمْ إِنْ أَخَذَ اللَّهُ سَمْعَكُمْ وَأَبْصَارَكُمْ وَخَتَمَ عَلَىٰ قُلُوبِكُمْ مَنْ إِلَٰهٌ غَيْرُ اللَّهِ يَأْتِيكُمْ بِهِ ۗ انْظُرْ كَيْفَ نُصَرِّفُ الْآيَاتِ ثُمَّ هُمْ يَصْدِفُونَ","numberInSurah":46,"juz":7,"manzil":2,"page":133,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":836,"text":"قُلْ أَرَأَيْتَكُمْ إِنْ أَتَاكُمْ عَذَابُ اللَّهِ بَغْتَةً أَوْ جَهْرَةً هَلْ يُهْلَكُ إِلَّا الْقَوْمُ الظَّالِمُونَ","numberInSurah":47,"juz":7,"manzil":2,"page":133,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":837,"text":"وَمَا نُرْسِلُ الْمُرْسَلِينَ إِلَّا مُبَشِّرِينَ وَمُنْذِرِينَ ۖ فَمَنْ آمَنَ وَأَصْلَحَ فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ","numberInSurah":48,"juz":7,"manzil":2,"page":133,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":838,"text":"وَالَّذِينَ كَذَّبُوا بِآيَاتِنَا يَمَسُّهُمُ الْعَذَابُ بِمَا كَانُوا يَفْسُقُونَ","numberInSurah":49,"juz":7,"manzil":2,"page":133,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":839,"text":"قُلْ لَا أَقُولُ لَكُمْ عِنْدِي خَزَائِنُ اللَّهِ وَلَا أَعْلَمُ الْغَيْبَ وَلَا أَقُولُ لَكُمْ إِنِّي مَلَكٌ ۖ إِنْ أَتَّبِعُ إِلَّا مَا يُوحَىٰ إِلَيَّ ۚ قُلْ هَلْ يَسْتَوِي الْأَعْمَىٰ وَالْبَصِيرُ ۚ أَفَلَا تَتَفَكَّرُونَ","numberInSurah":50,"juz":7,"manzil":2,"page":133,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":840,"text":"وَأَنْذِرْ بِهِ الَّذِينَ يَخَافُونَ أَنْ يُحْشَرُوا إِلَىٰ رَبِّهِمْ ۙ لَيْسَ لَهُمْ مِنْ دُونِهِ وَلِيٌّ وَلَا شَفِيعٌ لَعَلَّهُمْ يَتَّقُونَ","numberInSurah":51,"juz":7,"manzil":2,"page":133,"ruku":107,"hizbQuarter":53,"sajda":false},{"number":841,"text":"وَلَا تَطْرُدِ الَّذِينَ يَدْعُونَ رَبَّهُمْ بِالْغَدَاةِ وَالْعَشِيِّ يُرِيدُونَ وَجْهَهُ ۖ مَا عَلَيْكَ مِنْ حِسَابِهِمْ مِنْ شَيْءٍ وَمَا مِنْ حِسَابِكَ عَلَيْهِمْ مِنْ شَيْءٍ فَتَطْرُدَهُمْ فَتَكُونَ مِنَ الظَّالِمِينَ","numberInSurah":52,"juz":7,"manzil":2,"page":133,"ruku":107,"hizbQuarter":53,"sajda":false},{"number":842,"text":"وَكَذَٰلِكَ فَتَنَّا بَعْضَهُمْ بِبَعْضٍ لِيَقُولُوا أَهَٰؤُلَاءِ مَنَّ اللَّهُ عَلَيْهِمْ مِنْ بَيْنِنَا ۗ أَلَيْسَ اللَّهُ بِأَعْلَمَ بِالشَّاكِرِينَ","numberInSurah":53,"juz":7,"manzil":2,"page":134,"ruku":107,"hizbQuarter":53,"sajda":false},{"number":843,"text":"وَإِذَا جَاءَكَ الَّذِينَ يُؤْمِنُونَ بِآيَاتِنَا فَقُلْ سَلَامٌ عَلَيْكُمْ ۖ كَتَبَ رَبُّكُمْ عَلَىٰ نَفْسِهِ الرَّحْمَةَ ۖ أَنَّهُ مَنْ عَمِلَ مِنْكُمْ سُوءًا بِجَهَالَةٍ ثُمَّ تَابَ مِنْ بَعْدِهِ وَأَصْلَحَ فَأَنَّهُ غَفُورٌ رَحِيمٌ","numberInSurah":54,"juz":7,"manzil":2,"page":134,"ruku":107,"hizbQuarter":53,"sajda":false},{"number":844,"text":"وَكَذَٰلِكَ نُفَصِّلُ الْآيَاتِ وَلِتَسْتَبِينَ سَبِيلُ الْمُجْرِمِينَ","numberInSurah":55,"juz":7,"manzil":2,"page":134,"ruku":107,"hizbQuarter":53,"sajda":false},{"number":845,"text":"قُلْ إِنِّي نُهِيتُ أَنْ أَعْبُدَ الَّذِينَ تَدْعُونَ مِنْ دُونِ اللَّهِ ۚ قُلْ لَا أَتَّبِعُ أَهْوَاءَكُمْ ۙ قَدْ ضَلَلْتُ إِذًا وَمَا أَنَا مِنَ الْمُهْتَدِينَ","numberInSurah":56,"juz":7,"manzil":2,"page":134,"ruku":108,"hizbQuarter":53,"sajda":false},{"number":846,"text":"قُلْ إِنِّي عَلَىٰ بَيِّنَةٍ مِنْ رَبِّي وَكَذَّبْتُمْ بِهِ ۚ مَا عِنْدِي مَا تَسْتَعْجِلُونَ بِهِ ۚ إِنِ الْحُكْمُ إِلَّا لِلَّهِ ۖ يَقُصُّ الْحَقَّ ۖ وَهُوَ خَيْرُ الْفَاصِلِينَ","numberInSurah":57,"juz":7,"manzil":2,"page":134,"ruku":108,"hizbQuarter":53,"sajda":false},{"number":847,"text":"قُلْ لَوْ أَنَّ عِنْدِي مَا تَسْتَعْجِلُونَ بِهِ لَقُضِيَ الْأَمْرُ بَيْنِي وَبَيْنَكُمْ ۗ وَاللَّهُ أَعْلَمُ بِالظَّالِمِينَ","numberInSurah":58,"juz":7,"manzil":2,"page":134,"ruku":108,"hizbQuarter":53,"sajda":false},{"number":848,"text":"۞ وَعِنْدَهُ مَفَاتِحُ الْغَيْبِ لَا يَعْلَمُهَا إِلَّا هُوَ ۚ وَيَعْلَمُ مَا فِي الْبَرِّ وَالْبَحْرِ ۚ وَمَا تَسْقُطُ مِنْ وَرَقَةٍ إِلَّا يَعْلَمُهَا وَلَا حَبَّةٍ فِي ظُلُمَاتِ الْأَرْضِ وَلَا رَطْبٍ وَلَا يَابِسٍ إِلَّا فِي كِتَابٍ مُبِينٍ","numberInSurah":59,"juz":7,"manzil":2,"page":134,"ruku":108,"hizbQuarter":54,"sajda":false},{"number":849,"text":"وَهُوَ الَّذِي يَتَوَفَّاكُمْ بِاللَّيْلِ وَيَعْلَمُ مَا جَرَحْتُمْ بِالنَّهَارِ ثُمَّ يَبْعَثُكُمْ فِيهِ لِيُقْضَىٰ أَجَلٌ مُسَمًّى ۖ ثُمَّ إِلَيْهِ مَرْجِعُكُمْ ثُمَّ يُنَبِّئُكُمْ بِمَا كُنْتُمْ تَعْمَلُونَ","numberInSurah":60,"juz":7,"manzil":2,"page":135,"ruku":108,"hizbQuarter":54,"sajda":false},{"number":850,"text":"وَهُوَ الْقَاهِرُ فَوْقَ عِبَادِهِ ۖ وَيُرْسِلُ عَلَيْكُمْ حَفَظَةً حَتَّىٰ إِذَا جَاءَ أَحَدَكُمُ الْمَوْتُ تَوَفَّتْهُ رُسُلُنَا وَهُمْ لَا يُفَرِّطُونَ","numberInSurah":61,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":851,"text":"ثُمَّ رُدُّوا إِلَى اللَّهِ مَوْلَاهُمُ الْحَقِّ ۚ أَلَا لَهُ الْحُكْمُ وَهُوَ أَسْرَعُ الْحَاسِبِينَ","numberInSurah":62,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":852,"text":"قُلْ مَنْ يُنَجِّيكُمْ مِنْ ظُلُمَاتِ الْبَرِّ وَالْبَحْرِ تَدْعُونَهُ تَضَرُّعًا وَخُفْيَةً لَئِنْ أَنْجَانَا مِنْ هَٰذِهِ لَنَكُونَنَّ مِنَ الشَّاكِرِينَ","numberInSurah":63,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":853,"text":"قُلِ اللَّهُ يُنَجِّيكُمْ مِنْهَا وَمِنْ كُلِّ كَرْبٍ ثُمَّ أَنْتُمْ تُشْرِكُونَ","numberInSurah":64,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":854,"text":"قُلْ هُوَ الْقَادِرُ عَلَىٰ أَنْ يَبْعَثَ عَلَيْكُمْ عَذَابًا مِنْ فَوْقِكُمْ أَوْ مِنْ تَحْتِ أَرْجُلِكُمْ أَوْ يَلْبِسَكُمْ شِيَعًا وَيُذِيقَ بَعْضَكُمْ بَأْسَ بَعْضٍ ۗ انْظُرْ كَيْفَ نُصَرِّفُ الْآيَاتِ لَعَلَّهُمْ يَفْقَهُونَ","numberInSurah":65,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":855,"text":"وَكَذَّبَ بِهِ قَوْمُكَ وَهُوَ الْحَقُّ ۚ قُلْ لَسْتُ عَلَيْكُمْ بِوَكِيلٍ","numberInSurah":66,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":856,"text":"لِكُلِّ نَبَإٍ مُسْتَقَرٌّ ۚ وَسَوْفَ تَعْلَمُونَ","numberInSurah":67,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":857,"text":"وَإِذَا رَأَيْتَ الَّذِينَ يَخُوضُونَ فِي آيَاتِنَا فَأَعْرِضْ عَنْهُمْ حَتَّىٰ يَخُوضُوا فِي حَدِيثٍ غَيْرِهِ ۚ وَإِمَّا يُنْسِيَنَّكَ الشَّيْطَانُ فَلَا تَقْعُدْ بَعْدَ الذِّكْرَىٰ مَعَ الْقَوْمِ الظَّالِمِينَ","numberInSurah":68,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":858,"text":"وَمَا عَلَى الَّذِينَ يَتَّقُونَ مِنْ حِسَابِهِمْ مِنْ شَيْءٍ وَلَٰكِنْ ذِكْرَىٰ لَعَلَّهُمْ يَتَّقُونَ","numberInSurah":69,"juz":7,"manzil":2,"page":136,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":859,"text":"وَذَرِ الَّذِينَ اتَّخَذُوا دِينَهُمْ لَعِبًا وَلَهْوًا وَغَرَّتْهُمُ الْحَيَاةُ الدُّنْيَا ۚ وَذَكِّرْ بِهِ أَنْ تُبْسَلَ نَفْسٌ بِمَا كَسَبَتْ لَيْسَ لَهَا مِنْ دُونِ اللَّهِ وَلِيٌّ وَلَا شَفِيعٌ وَإِنْ تَعْدِلْ كُلَّ عَدْلٍ لَا يُؤْخَذْ مِنْهَا ۗ أُولَٰئِكَ الَّذِينَ أُبْسِلُوا بِمَا كَسَبُوا ۖ لَهُمْ شَرَابٌ مِنْ حَمِيمٍ وَعَذَابٌ أَلِيمٌ بِمَا كَانُوا يَكْفُرُونَ","numberInSurah":70,"juz":7,"manzil":2,"page":136,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":860,"text":"قُلْ أَنَدْعُو مِنْ دُونِ اللَّهِ مَا لَا يَنْفَعُنَا وَلَا يَضُرُّنَا وَنُرَدُّ عَلَىٰ أَعْقَابِنَا بَعْدَ إِذْ هَدَانَا اللَّهُ كَالَّذِي اسْتَهْوَتْهُ الشَّيَاطِينُ فِي الْأَرْضِ حَيْرَانَ لَهُ أَصْحَابٌ يَدْعُونَهُ إِلَى الْهُدَى ائْتِنَا ۗ قُلْ إِنَّ هُدَى اللَّهِ هُوَ الْهُدَىٰ ۖ وَأُمِرْنَا لِنُسْلِمَ لِرَبِّ الْعَالَمِينَ","numberInSurah":71,"juz":7,"manzil":2,"page":136,"ruku":110,"hizbQuarter":54,"sajda":false},{"number":861,"text":"وَأَنْ أَقِيمُوا الصَّلَاةَ وَاتَّقُوهُ ۚ وَهُوَ الَّذِي إِلَيْهِ تُحْشَرُونَ","numberInSurah":72,"juz":7,"manzil":2,"page":136,"ruku":110,"hizbQuarter":54,"sajda":false},{"number":862,"text":"وَهُوَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ بِالْحَقِّ ۖ وَيَوْمَ يَقُولُ كُنْ فَيَكُونُ ۚ قَوْلُهُ الْحَقُّ ۚ وَلَهُ الْمُلْكُ يَوْمَ يُنْفَخُ فِي الصُّورِ ۚ عَالِمُ الْغَيْبِ وَالشَّهَادَةِ ۚ وَهُوَ الْحَكِيمُ الْخَبِيرُ","numberInSurah":73,"juz":7,"manzil":2,"page":136,"ruku":110,"hizbQuarter":54,"sajda":false},{"number":863,"text":"۞ وَإِذْ قَالَ إِبْرَاهِيمُ لِأَبِيهِ آزَرَ أَتَتَّخِذُ أَصْنَامًا آلِهَةً ۖ إِنِّي أَرَاكَ وَقَوْمَكَ فِي ضَلَالٍ مُبِينٍ","numberInSurah":74,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":864,"text":"وَكَذَٰلِكَ نُرِي إِبْرَاهِيمَ مَلَكُوتَ السَّمَاوَاتِ وَالْأَرْضِ وَلِيَكُونَ مِنَ الْمُوقِنِينَ","numberInSurah":75,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":865,"text":"فَلَمَّا جَنَّ عَلَيْهِ اللَّيْلُ رَأَىٰ كَوْكَبًا ۖ قَالَ هَٰذَا رَبِّي ۖ فَلَمَّا أَفَلَ قَالَ لَا أُحِبُّ الْآفِلِينَ","numberInSurah":76,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":866,"text":"فَلَمَّا رَأَى الْقَمَرَ بَازِغًا قَالَ هَٰذَا رَبِّي ۖ فَلَمَّا أَفَلَ قَالَ لَئِنْ لَمْ يَهْدِنِي رَبِّي لَأَكُونَنَّ مِنَ الْقَوْمِ الضَّالِّينَ","numberInSurah":77,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":867,"text":"فَلَمَّا رَأَى الشَّمْسَ بَازِغَةً قَالَ هَٰذَا رَبِّي هَٰذَا أَكْبَرُ ۖ فَلَمَّا أَفَلَتْ قَالَ يَا قَوْمِ إِنِّي بَرِيءٌ مِمَّا تُشْرِكُونَ","numberInSurah":78,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":868,"text":"إِنِّي وَجَّهْتُ وَجْهِيَ لِلَّذِي فَطَرَ السَّمَاوَاتِ وَالْأَرْضَ حَنِيفًا ۖ وَمَا أَنَا مِنَ الْمُشْرِكِينَ","numberInSurah":79,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":869,"text":"وَحَاجَّهُ قَوْمُهُ ۚ قَالَ أَتُحَاجُّونِّي فِي اللَّهِ وَقَدْ هَدَانِ ۚ وَلَا أَخَافُ مَا تُشْرِكُونَ بِهِ إِلَّا أَنْ يَشَاءَ رَبِّي شَيْئًا ۗ وَسِعَ رَبِّي كُلَّ شَيْءٍ عِلْمًا ۗ أَفَلَا تَتَذَكَّرُونَ","numberInSurah":80,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":870,"text":"وَكَيْفَ أَخَافُ مَا أَشْرَكْتُمْ وَلَا تَخَافُونَ أَنَّكُمْ أَشْرَكْتُمْ بِاللَّهِ مَا لَمْ يُنَزِّلْ بِهِ عَلَيْكُمْ سُلْطَانًا ۚ فَأَيُّ الْفَرِيقَيْنِ أَحَقُّ بِالْأَمْنِ ۖ إِنْ كُنْتُمْ تَعْلَمُونَ","numberInSurah":81,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":871,"text":"الَّذِينَ آمَنُوا وَلَمْ يَلْبِسُوا إِيمَانَهُمْ بِظُلْمٍ أُولَٰئِكَ لَهُمُ الْأَمْنُ وَهُمْ مُهْتَدُونَ","numberInSurah":82,"juz":7,"manzil":2,"page":138,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":872,"text":"وَتِلْكَ حُجَّتُنَا آتَيْنَاهَا إِبْرَاهِيمَ عَلَىٰ قَوْمِهِ ۚ نَرْفَعُ دَرَجَاتٍ مَنْ نَشَاءُ ۗ إِنَّ رَبَّكَ حَكِيمٌ عَلِيمٌ","numberInSurah":83,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":873,"text":"وَوَهَبْنَا لَهُ إِسْحَاقَ وَيَعْقُوبَ ۚ كُلًّا هَدَيْنَا ۚ وَنُوحًا هَدَيْنَا مِنْ قَبْلُ ۖ وَمِنْ ذُرِّيَّتِهِ دَاوُودَ وَسُلَيْمَانَ وَأَيُّوبَ وَيُوسُفَ وَمُوسَىٰ وَهَارُونَ ۚ وَكَذَٰلِكَ نَجْزِي الْمُحْسِنِينَ","numberInSurah":84,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":874,"text":"وَزَكَرِيَّا وَيَحْيَىٰ وَعِيسَىٰ وَإِلْيَاسَ ۖ كُلٌّ مِنَ الصَّالِحِينَ","numberInSurah":85,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":875,"text":"وَإِسْمَاعِيلَ وَالْيَسَعَ وَيُونُسَ وَلُوطًا ۚ وَكُلًّا فَضَّلْنَا عَلَى الْعَالَمِينَ","numberInSurah":86,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":876,"text":"وَمِنْ آبَائِهِمْ وَذُرِّيَّاتِهِمْ وَإِخْوَانِهِمْ ۖ وَاجْتَبَيْنَاهُمْ وَهَدَيْنَاهُمْ إِلَىٰ صِرَاطٍ مُسْتَقِيمٍ","numberInSurah":87,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":877,"text":"ذَٰلِكَ هُدَى اللَّهِ يَهْدِي بِهِ مَنْ يَشَاءُ مِنْ عِبَادِهِ ۚ وَلَوْ أَشْرَكُوا لَحَبِطَ عَنْهُمْ مَا كَانُوا يَعْمَلُونَ","numberInSurah":88,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":878,"text":"أُولَٰئِكَ الَّذِينَ آتَيْنَاهُمُ الْكِتَابَ وَالْحُكْمَ وَالنُّبُوَّةَ ۚ فَإِنْ يَكْفُرْ بِهَا هَٰؤُلَاءِ فَقَدْ وَكَّلْنَا بِهَا قَوْمًا لَيْسُوا بِهَا بِكَافِرِينَ","numberInSurah":89,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":879,"text":"أُولَٰئِكَ الَّذِينَ هَدَى اللَّهُ ۖ فَبِهُدَاهُمُ اقْتَدِهْ ۗ قُلْ لَا أَسْأَلُكُمْ عَلَيْهِ أَجْرًا ۖ إِنْ هُوَ إِلَّا ذِكْرَىٰ لِلْعَالَمِينَ","numberInSurah":90,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":880,"text":"وَمَا قَدَرُوا اللَّهَ حَقَّ قَدْرِهِ إِذْ قَالُوا مَا أَنْزَلَ اللَّهُ عَلَىٰ بَشَرٍ مِنْ شَيْءٍ ۗ قُلْ مَنْ أَنْزَلَ الْكِتَابَ الَّذِي جَاءَ بِهِ مُوسَىٰ نُورًا وَهُدًى لِلنَّاسِ ۖ تَجْعَلُونَهُ قَرَاطِيسَ تُبْدُونَهَا وَتُخْفُونَ كَثِيرًا ۖ وَعُلِّمْتُمْ مَا لَمْ تَعْلَمُوا أَنْتُمْ وَلَا آبَاؤُكُمْ ۖ قُلِ اللَّهُ ۖ ثُمَّ ذَرْهُمْ فِي خَوْضِهِمْ يَلْعَبُونَ","numberInSurah":91,"juz":7,"manzil":2,"page":139,"ruku":112,"hizbQuarter":55,"sajda":false},{"number":881,"text":"وَهَٰذَا كِتَابٌ أَنْزَلْنَاهُ مُبَارَكٌ مُصَدِّقُ الَّذِي بَيْنَ يَدَيْهِ وَلِتُنْذِرَ أُمَّ الْقُرَىٰ وَمَنْ حَوْلَهَا ۚ وَالَّذِينَ يُؤْمِنُونَ بِالْآخِرَةِ يُؤْمِنُونَ بِهِ ۖ وَهُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ","numberInSurah":92,"juz":7,"manzil":2,"page":139,"ruku":112,"hizbQuarter":55,"sajda":false},{"number":882,"text":"وَمَنْ أَظْلَمُ مِمَّنِ افْتَرَىٰ عَلَى اللَّهِ كَذِبًا أَوْ قَالَ أُوحِيَ إِلَيَّ وَلَمْ يُوحَ إِلَيْهِ شَيْءٌ وَمَنْ قَالَ سَأُنْزِلُ مِثْلَ مَا أَنْزَلَ اللَّهُ ۗ وَلَوْ تَرَىٰ إِذِ الظَّالِمُونَ فِي غَمَرَاتِ الْمَوْتِ وَالْمَلَائِكَةُ بَاسِطُو أَيْدِيهِمْ أَخْرِجُوا أَنْفُسَكُمُ ۖ الْيَوْمَ تُجْزَوْنَ عَذَابَ الْهُونِ بِمَا كُنْتُمْ تَقُولُونَ عَلَى اللَّهِ غَيْرَ الْحَقِّ وَكُنْتُمْ عَنْ آيَاتِهِ تَسْتَكْبِرُونَ","numberInSurah":93,"juz":7,"manzil":2,"page":139,"ruku":112,"hizbQuarter":55,"sajda":false},{"number":883,"text":"وَلَقَدْ جِئْتُمُونَا فُرَادَىٰ كَمَا خَلَقْنَاكُمْ أَوَّلَ مَرَّةٍ وَتَرَكْتُمْ مَا خَوَّلْنَاكُمْ وَرَاءَ ظُهُورِكُمْ ۖ وَمَا نَرَىٰ مَعَكُمْ شُفَعَاءَكُمُ الَّذِينَ زَعَمْتُمْ أَنَّهُمْ فِيكُمْ شُرَكَاءُ ۚ لَقَدْ تَقَطَّعَ بَيْنَكُمْ وَضَلَّ عَنْكُمْ مَا كُنْتُمْ تَزْعُمُونَ","numberInSurah":94,"juz":7,"manzil":2,"page":139,"ruku":112,"hizbQuarter":55,"sajda":false},{"number":884,"text":"۞ إِنَّ اللَّهَ فَالِقُ الْحَبِّ وَالنَّوَىٰ ۖ يُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَمُخْرِجُ الْمَيِّتِ مِنَ الْحَيِّ ۚ ذَٰلِكُمُ اللَّهُ ۖ فَأَنَّىٰ تُؤْفَكُونَ","numberInSurah":95,"juz":7,"manzil":2,"page":140,"ruku":113,"hizbQuarter":56,"sajda":false},{"number":885,"text":"فَالِقُ الْإِصْبَاحِ وَجَعَلَ اللَّيْلَ سَكَنًا وَالشَّمْسَ وَالْقَمَرَ حُسْبَانًا ۚ ذَٰلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ","numberInSurah":96,"juz":7,"manzil":2,"page":140,"ruku":113,"hizbQuarter":56,"sajda":false},{"number":886,"text":"وَهُوَ الَّذِي جَعَلَ لَكُمُ النُّجُومَ لِتَهْتَدُوا بِهَا فِي ظُلُمَاتِ الْبَرِّ وَالْبَحْرِ ۗ قَدْ فَصَّلْنَا الْآيَاتِ لِقَوْمٍ يَعْلَمُونَ","numberInSurah":97,"juz":7,"manzil":2,"page":140,"ruku":113,"hizbQuarter":56,"sajda":false},{"number":887,"text":"وَهُوَ الَّذِي أَنْشَأَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ فَمُسْتَقَرٌّ وَمُسْتَوْدَعٌ ۗ قَدْ فَصَّلْنَا الْآيَاتِ لِقَوْمٍ يَفْقَهُونَ","numberInSurah":98,"juz":7,"manzil":2,"page":140,"ruku":113,"hizbQuarter":56,"sajda":false},{"number":888,"text":"وَهُوَ الَّذِي أَنْزَلَ مِنَ السَّمَاءِ مَاءً فَأَخْرَجْنَا بِهِ نَبَاتَ كُلِّ شَيْءٍ فَأَخْرَجْنَا مِنْهُ خَضِرًا نُخْرِجُ مِنْهُ حَبًّا مُتَرَاكِبًا وَمِنَ النَّخْلِ مِنْ طَلْعِهَا قِنْوَانٌ دَانِيَةٌ وَجَنَّاتٍ مِنْ أَعْنَابٍ وَالزَّيْتُونَ وَالرُّمَّانَ مُشْتَبِهًا وَغَيْرَ مُتَشَابِهٍ ۗ انْظُرُوا إِلَىٰ ثَمَرِهِ إِذَا أَثْمَرَ وَيَنْعِهِ ۚ إِنَّ فِي ذَٰلِكُمْ لَآيَاتٍ لِقَوْمٍ يُؤْمِنُونَ","numberInSurah":99,"juz":7,"manzil":2,"page":140,"ruku":113,"hizbQuarter":56,"sajda":false},{"number":889,"text":"وَجَعَلُوا لِلَّهِ شُرَكَاءَ الْجِنَّ وَخَلَقَهُمْ ۖ وَخَرَقُوا لَهُ بَنِينَ وَبَنَاتٍ بِغَيْرِ عِلْمٍ ۚ سُبْحَانَهُ وَتَعَالَىٰ عَمَّا يَصِفُونَ","numberInSurah":100,"juz":7,"manzil":2,"page":140,"ruku":113,"hizbQuarter":56,"sajda":false},{"number":890,"text":"بَدِيعُ السَّمَاوَاتِ وَالْأَرْضِ ۖ أَنَّىٰ يَكُونُ لَهُ وَلَدٌ وَلَمْ تَكُنْ لَهُ صَاحِبَةٌ ۖ وَخَلَقَ كُلَّ شَيْءٍ ۖ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ","numberInSurah":101,"juz":7,"manzil":2,"page":140,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":891,"text":"ذَٰلِكُمُ اللَّهُ رَبُّكُمْ ۖ لَا إِلَٰهَ إِلَّا هُوَ ۖ خَالِقُ كُلِّ شَيْءٍ فَاعْبُدُوهُ ۚ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ وَكِيلٌ","numberInSurah":102,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":892,"text":"لَا تُدْرِكُهُ الْأَبْصَارُ وَهُوَ يُدْرِكُ الْأَبْصَارَ ۖ وَهُوَ اللَّطِيفُ الْخَبِيرُ","numberInSurah":103,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":893,"text":"قَدْ جَاءَكُمْ بَصَائِرُ مِنْ رَبِّكُمْ ۖ فَمَنْ أَبْصَرَ فَلِنَفْسِهِ ۖ وَمَنْ عَمِيَ فَعَلَيْهَا ۚ وَمَا أَنَا عَلَيْكُمْ بِحَفِيظٍ","numberInSurah":104,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":894,"text":"وَكَذَٰلِكَ نُصَرِّفُ الْآيَاتِ وَلِيَقُولُوا دَرَسْتَ وَلِنُبَيِّنَهُ لِقَوْمٍ يَعْلَمُونَ","numberInSurah":105,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":895,"text":"اتَّبِعْ مَا أُوحِيَ إِلَيْكَ مِنْ رَبِّكَ ۖ لَا إِلَٰهَ إِلَّا هُوَ ۖ وَأَعْرِضْ عَنِ الْمُشْرِكِينَ","numberInSurah":106,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":896,"text":"وَلَوْ شَاءَ اللَّهُ مَا أَشْرَكُوا ۗ وَمَا جَعَلْنَاكَ عَلَيْهِمْ حَفِيظًا ۖ وَمَا أَنْتَ عَلَيْهِمْ بِوَكِيلٍ","numberInSurah":107,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":897,"text":"وَلَا تَسُبُّوا الَّذِينَ يَدْعُونَ مِنْ دُونِ اللَّهِ فَيَسُبُّوا اللَّهَ عَدْوًا بِغَيْرِ عِلْمٍ ۗ كَذَٰلِكَ زَيَّنَّا لِكُلِّ أُمَّةٍ عَمَلَهُمْ ثُمَّ إِلَىٰ رَبِّهِمْ مَرْجِعُهُمْ فَيُنَبِّئُهُمْ بِمَا كَانُوا يَعْمَلُونَ","numberInSurah":108,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":898,"text":"وَأَقْسَمُوا بِاللَّهِ جَهْدَ أَيْمَانِهِمْ لَئِنْ جَاءَتْهُمْ آيَةٌ لَيُؤْمِنُنَّ بِهَا ۚ قُلْ إِنَّمَا الْآيَاتُ عِنْدَ اللَّهِ ۖ وَمَا يُشْعِرُكُمْ أَنَّهَا إِذَا جَاءَتْ لَا يُؤْمِنُونَ","numberInSurah":109,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":899,"text":"وَنُقَلِّبُ أَفْئِدَتَهُمْ وَأَبْصَارَهُمْ كَمَا لَمْ يُؤْمِنُوا بِهِ أَوَّلَ مَرَّةٍ وَنَذَرُهُمْ فِي طُغْيَانِهِمْ يَعْمَهُونَ","numberInSurah":110,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":900,"text":"۞ وَلَوْ أَنَّنَا نَزَّلْنَا إِلَيْهِمُ الْمَلَائِكَةَ وَكَلَّمَهُمُ الْمَوْتَىٰ وَحَشَرْنَا عَلَيْهِمْ كُلَّ شَيْءٍ قُبُلًا مَا كَانُوا لِيُؤْمِنُوا إِلَّا أَنْ يَشَاءَ اللَّهُ وَلَٰكِنَّ أَكْثَرَهُمْ يَجْهَلُونَ","numberInSurah":111,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":901,"text":"وَكَذَٰلِكَ جَعَلْنَا لِكُلِّ نَبِيٍّ عَدُوًّا شَيَاطِينَ الْإِنْسِ وَالْجِنِّ يُوحِي بَعْضُهُمْ إِلَىٰ بَعْضٍ زُخْرُفَ الْقَوْلِ غُرُورًا ۚ وَلَوْ شَاءَ رَبُّكَ مَا فَعَلُوهُ ۖ فَذَرْهُمْ وَمَا يَفْتَرُونَ","numberInSurah":112,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":902,"text":"وَلِتَصْغَىٰ إِلَيْهِ أَفْئِدَةُ الَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ وَلِيَرْضَوْهُ وَلِيَقْتَرِفُوا مَا هُمْ مُقْتَرِفُونَ","numberInSurah":113,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":903,"text":"أَفَغَيْرَ اللَّهِ أَبْتَغِي حَكَمًا وَهُوَ الَّذِي أَنْزَلَ إِلَيْكُمُ الْكِتَابَ مُفَصَّلًا ۚ وَالَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يَعْلَمُونَ أَنَّهُ مُنَزَّلٌ مِنْ رَبِّكَ بِالْحَقِّ ۖ فَلَا تَكُونَنَّ مِنَ الْمُمْتَرِينَ","numberInSurah":114,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":904,"text":"وَتَمَّتْ كَلِمَتُ رَبِّكَ صِدْقًا وَعَدْلًا ۚ لَا مُبَدِّلَ لِكَلِمَاتِهِ ۚ وَهُوَ السَّمِيعُ الْعَلِيمُ","numberInSurah":115,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":905,"text":"وَإِنْ تُطِعْ أَكْثَرَ مَنْ فِي الْأَرْضِ يُضِلُّوكَ عَنْ سَبِيلِ اللَّهِ ۚ إِنْ يَتَّبِعُونَ إِلَّا الظَّنَّ وَإِنْ هُمْ إِلَّا يَخْرُصُونَ","numberInSurah":116,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":906,"text":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ مَنْ يَضِلُّ عَنْ سَبِيلِهِ ۖ وَهُوَ أَعْلَمُ بِالْمُهْتَدِينَ","numberInSurah":117,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":907,"text":"فَكُلُوا مِمَّا ذُكِرَ اسْمُ اللَّهِ عَلَيْهِ إِنْ كُنْتُمْ بِآيَاتِهِ مُؤْمِنِينَ","numberInSurah":118,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":908,"text":"وَمَا لَكُمْ أَلَّا تَأْكُلُوا مِمَّا ذُكِرَ اسْمُ اللَّهِ عَلَيْهِ وَقَدْ فَصَّلَ لَكُمْ مَا حَرَّمَ عَلَيْكُمْ إِلَّا مَا اضْطُرِرْتُمْ إِلَيْهِ ۗ وَإِنَّ كَثِيرًا لَيُضِلُّونَ بِأَهْوَائِهِمْ بِغَيْرِ عِلْمٍ ۗ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِالْمُعْتَدِينَ","numberInSurah":119,"juz":8,"manzil":2,"page":143,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":909,"text":"وَذَرُوا ظَاهِرَ الْإِثْمِ وَبَاطِنَهُ ۚ إِنَّ الَّذِينَ يَكْسِبُونَ الْإِثْمَ سَيُجْزَوْنَ بِمَا كَانُوا يَقْتَرِفُونَ","numberInSurah":120,"juz":8,"manzil":2,"page":143,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":910,"text":"وَلَا تَأْكُلُوا مِمَّا لَمْ يُذْكَرِ اسْمُ اللَّهِ عَلَيْهِ وَإِنَّهُ لَفِسْقٌ ۗ وَإِنَّ الشَّيَاطِينَ لَيُوحُونَ إِلَىٰ أَوْلِيَائِهِمْ لِيُجَادِلُوكُمْ ۖ وَإِنْ أَطَعْتُمُوهُمْ إِنَّكُمْ لَمُشْرِكُونَ","numberInSurah":121,"juz":8,"manzil":2,"page":143,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":911,"text":"أَوَمَنْ كَانَ مَيْتًا فَأَحْيَيْنَاهُ وَجَعَلْنَا لَهُ نُورًا يَمْشِي بِهِ فِي النَّاسِ كَمَنْ مَثَلُهُ فِي الظُّلُمَاتِ لَيْسَ بِخَارِجٍ مِنْهَا ۚ كَذَٰلِكَ زُيِّنَ لِلْكَافِرِينَ مَا كَانُوا يَعْمَلُونَ","numberInSurah":122,"juz":8,"manzil":2,"page":143,"ruku":116,"hizbQuarter":57,"sajda":false},{"number":912,"text":"وَكَذَٰلِكَ جَعَلْنَا فِي كُلِّ قَرْيَةٍ أَكَابِرَ مُجْرِمِيهَا لِيَمْكُرُوا فِيهَا ۖ وَمَا يَمْكُرُونَ إِلَّا بِأَنْفُسِهِمْ وَمَا يَشْعُرُونَ","numberInSurah":123,"juz":8,"manzil":2,"page":143,"ruku":116,"hizbQuarter":57,"sajda":false},{"number":913,"text":"وَإِذَا جَاءَتْهُمْ آيَةٌ قَالُوا لَنْ نُؤْمِنَ حَتَّىٰ نُؤْتَىٰ مِثْلَ مَا أُوتِيَ رُسُلُ اللَّهِ ۘ اللَّهُ أَعْلَمُ حَيْثُ يَجْعَلُ رِسَالَتَهُ ۗ سَيُصِيبُ الَّذِينَ أَجْرَمُوا صَغَارٌ عِنْدَ اللَّهِ وَعَذَابٌ شَدِيدٌ بِمَا كَانُوا يَمْكُرُونَ","numberInSurah":124,"juz":8,"manzil":2,"page":143,"ruku":116,"hizbQuarter":57,"sajda":false},{"number":914,"text":"فَمَنْ يُرِدِ اللَّهُ أَنْ يَهْدِيَهُ يَشْرَحْ صَدْرَهُ لِلْإِسْلَامِ ۖ وَمَنْ يُرِدْ أَنْ يُضِلَّهُ يَجْعَلْ صَدْرَهُ ضَيِّقًا حَرَجًا كَأَنَّمَا يَصَّعَّدُ فِي السَّمَاءِ ۚ كَذَٰلِكَ يَجْعَلُ اللَّهُ الرِّجْسَ عَلَى الَّذِينَ لَا يُؤْمِنُونَ","numberInSurah":125,"juz":8,"manzil":2,"page":144,"ruku":116,"hizbQuarter":57,"sajda":false},{"number":915,"text":"وَهَٰذَا صِرَاطُ رَبِّكَ مُسْتَقِيمًا ۗ قَدْ فَصَّلْنَا الْآيَاتِ لِقَوْمٍ يَذَّكَّرُونَ","numberInSurah":126,"juz":8,"manzil":2,"page":144,"ruku":116,"hizbQuarter":57,"sajda":false},{"number":916,"text":"۞ لَهُمْ دَارُ السَّلَامِ عِنْدَ رَبِّهِمْ ۖ وَهُوَ وَلِيُّهُمْ بِمَا كَانُوا يَعْمَلُونَ","numberInSurah":127,"juz":8,"manzil":2,"page":144,"ruku":116,"hizbQuarter":58,"sajda":false},{"number":917,"text":"وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا يَا مَعْشَرَ الْجِنِّ قَدِ اسْتَكْثَرْتُمْ مِنَ الْإِنْسِ ۖ وَقَالَ أَوْلِيَاؤُهُمْ مِنَ الْإِنْسِ رَبَّنَا اسْتَمْتَعَ بَعْضُنَا بِبَعْضٍ وَبَلَغْنَا أَجَلَنَا الَّذِي أَجَّلْتَ لَنَا ۚ قَالَ النَّارُ مَثْوَاكُمْ خَالِدِينَ فِيهَا إِلَّا مَا شَاءَ اللَّهُ ۗ إِنَّ رَبَّكَ حَكِيمٌ عَلِيمٌ","numberInSurah":128,"juz":8,"manzil":2,"page":144,"ruku":116,"hizbQuarter":58,"sajda":false},{"number":918,"text":"وَكَذَٰلِكَ نُوَلِّي بَعْضَ الظَّالِمِينَ بَعْضًا بِمَا كَانُوا يَكْسِبُونَ","numberInSurah":129,"juz":8,"manzil":2,"page":144,"ruku":116,"hizbQuarter":58,"sajda":false},{"number":919,"text":"يَا مَعْشَرَ الْجِنِّ وَالْإِنْسِ أَلَمْ يَأْتِكُمْ رُسُلٌ مِنْكُمْ يَقُصُّونَ عَلَيْكُمْ آيَاتِي وَيُنْذِرُونَكُمْ لِقَاءَ يَوْمِكُمْ هَٰذَا ۚ قَالُوا شَهِدْنَا عَلَىٰ أَنْفُسِنَا ۖ وَغَرَّتْهُمُ الْحَيَاةُ الدُّنْيَا وَشَهِدُوا عَلَىٰ أَنْفُسِهِمْ أَنَّهُمْ كَانُوا كَافِرِينَ","numberInSurah":130,"juz":8,"manzil":2,"page":144,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":920,"text":"ذَٰلِكَ أَنْ لَمْ يَكُنْ رَبُّكَ مُهْلِكَ الْقُرَىٰ بِظُلْمٍ وَأَهْلُهَا غَافِلُونَ","numberInSurah":131,"juz":8,"manzil":2,"page":144,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":921,"text":"وَلِكُلٍّ دَرَجَاتٌ مِمَّا عَمِلُوا ۚ وَمَا رَبُّكَ بِغَافِلٍ عَمَّا يَعْمَلُونَ","numberInSurah":132,"juz":8,"manzil":2,"page":145,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":922,"text":"وَرَبُّكَ الْغَنِيُّ ذُو الرَّحْمَةِ ۚ إِنْ يَشَأْ يُذْهِبْكُمْ وَيَسْتَخْلِفْ مِنْ بَعْدِكُمْ مَا يَشَاءُ كَمَا أَنْشَأَكُمْ مِنْ ذُرِّيَّةِ قَوْمٍ آخَرِينَ","numberInSurah":133,"juz":8,"manzil":2,"page":145,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":923,"text":"إِنَّ مَا تُوعَدُونَ لَآتٍ ۖ وَمَا أَنْتُمْ بِمُعْجِزِينَ","numberInSurah":134,"juz":8,"manzil":2,"page":145,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":924,"text":"قُلْ يَا قَوْمِ اعْمَلُوا عَلَىٰ مَكَانَتِكُمْ إِنِّي عَامِلٌ ۖ فَسَوْفَ تَعْلَمُونَ مَنْ تَكُونُ لَهُ عَاقِبَةُ الدَّارِ ۗ إِنَّهُ لَا يُفْلِحُ الظَّالِمُونَ","numberInSurah":135,"juz":8,"manzil":2,"page":145,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":925,"text":"وَجَعَلُوا لِلَّهِ مِمَّا ذَرَأَ مِنَ الْحَرْثِ وَالْأَنْعَامِ نَصِيبًا فَقَالُوا هَٰذَا لِلَّهِ بِزَعْمِهِمْ وَهَٰذَا لِشُرَكَائِنَا ۖ فَمَا كَانَ لِشُرَكَائِهِمْ فَلَا يَصِلُ إِلَى اللَّهِ ۖ وَمَا كَانَ لِلَّهِ فَهُوَ يَصِلُ إِلَىٰ شُرَكَائِهِمْ ۗ سَاءَ مَا يَحْكُمُونَ","numberInSurah":136,"juz":8,"manzil":2,"page":145,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":926,"text":"وَكَذَٰلِكَ زَيَّنَ لِكَثِيرٍ مِنَ الْمُشْرِكِينَ قَتْلَ أَوْلَادِهِمْ شُرَكَاؤُهُمْ لِيُرْدُوهُمْ وَلِيَلْبِسُوا عَلَيْهِمْ دِينَهُمْ ۖ وَلَوْ شَاءَ اللَّهُ مَا فَعَلُوهُ ۖ فَذَرْهُمْ وَمَا يَفْتَرُونَ","numberInSurah":137,"juz":8,"manzil":2,"page":145,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":927,"text":"وَقَالُوا هَٰذِهِ أَنْعَامٌ وَحَرْثٌ حِجْرٌ لَا يَطْعَمُهَا إِلَّا مَنْ نَشَاءُ بِزَعْمِهِمْ وَأَنْعَامٌ حُرِّمَتْ ظُهُورُهَا وَأَنْعَامٌ لَا يَذْكُرُونَ اسْمَ اللَّهِ عَلَيْهَا افْتِرَاءً عَلَيْهِ ۚ سَيَجْزِيهِمْ بِمَا كَانُوا يَفْتَرُونَ","numberInSurah":138,"juz":8,"manzil":2,"page":146,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":928,"text":"وَقَالُوا مَا فِي بُطُونِ هَٰذِهِ الْأَنْعَامِ خَالِصَةٌ لِذُكُورِنَا وَمُحَرَّمٌ عَلَىٰ أَزْوَاجِنَا ۖ وَإِنْ يَكُنْ مَيْتَةً فَهُمْ فِيهِ شُرَكَاءُ ۚ سَيَجْزِيهِمْ وَصْفَهُمْ ۚ إِنَّهُ حَكِيمٌ عَلِيمٌ","numberInSurah":139,"juz":8,"manzil":2,"page":146,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":929,"text":"قَدْ خَسِرَ الَّذِينَ قَتَلُوا أَوْلَادَهُمْ سَفَهًا بِغَيْرِ عِلْمٍ وَحَرَّمُوا مَا رَزَقَهُمُ اللَّهُ افْتِرَاءً عَلَى اللَّهِ ۚ قَدْ ضَلُّوا وَمَا كَانُوا مُهْتَدِينَ","numberInSurah":140,"juz":8,"manzil":2,"page":146,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":930,"text":"۞ وَهُوَ الَّذِي أَنْشَأَ جَنَّاتٍ مَعْرُوشَاتٍ وَغَيْرَ مَعْرُوشَاتٍ وَالنَّخْلَ وَالزَّرْعَ مُخْتَلِفًا أُكُلُهُ وَالزَّيْتُونَ وَالرُّمَّانَ مُتَشَابِهًا وَغَيْرَ مُتَشَابِهٍ ۚ كُلُوا مِنْ ثَمَرِهِ إِذَا أَثْمَرَ وَآتُوا حَقَّهُ يَوْمَ حَصَادِهِ ۖ وَلَا تُسْرِفُوا ۚ إِنَّهُ لَا يُحِبُّ الْمُسْرِفِينَ","numberInSurah":141,"juz":8,"manzil":2,"page":146,"ruku":118,"hizbQuarter":59,"sajda":false},{"number":931,"text":"وَمِنَ الْأَنْعَامِ حَمُولَةً وَفَرْشًا ۚ كُلُوا مِمَّا رَزَقَكُمُ اللَّهُ وَلَا تَتَّبِعُوا خُطُوَاتِ الشَّيْطَانِ ۚ إِنَّهُ لَكُمْ عَدُوٌّ مُبِينٌ","numberInSurah":142,"juz":8,"manzil":2,"page":146,"ruku":118,"hizbQuarter":59,"sajda":false},{"number":932,"text":"ثَمَانِيَةَ أَزْوَاجٍ ۖ مِنَ الضَّأْنِ اثْنَيْنِ وَمِنَ الْمَعْزِ اثْنَيْنِ ۗ قُلْ آلذَّكَرَيْنِ حَرَّمَ أَمِ الْأُنْثَيَيْنِ أَمَّا اشْتَمَلَتْ عَلَيْهِ أَرْحَامُ الْأُنْثَيَيْنِ ۖ نَبِّئُونِي بِعِلْمٍ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":143,"juz":8,"manzil":2,"page":147,"ruku":118,"hizbQuarter":59,"sajda":false},{"number":933,"text":"وَمِنَ الْإِبِلِ اثْنَيْنِ وَمِنَ الْبَقَرِ اثْنَيْنِ ۗ قُلْ آلذَّكَرَيْنِ حَرَّمَ أَمِ الْأُنْثَيَيْنِ أَمَّا اشْتَمَلَتْ عَلَيْهِ أَرْحَامُ الْأُنْثَيَيْنِ ۖ أَمْ كُنْتُمْ شُهَدَاءَ إِذْ وَصَّاكُمُ اللَّهُ بِهَٰذَا ۚ فَمَنْ أَظْلَمُ مِمَّنِ افْتَرَىٰ عَلَى اللَّهِ كَذِبًا لِيُضِلَّ النَّاسَ بِغَيْرِ عِلْمٍ ۗ إِنَّ اللَّهَ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ","numberInSurah":144,"juz":8,"manzil":2,"page":147,"ruku":118,"hizbQuarter":59,"sajda":false},{"number":934,"text":"قُلْ لَا أَجِدُ فِي مَا أُوحِيَ إِلَيَّ مُحَرَّمًا عَلَىٰ طَاعِمٍ يَطْعَمُهُ إِلَّا أَنْ يَكُونَ مَيْتَةً أَوْ دَمًا مَسْفُوحًا أَوْ لَحْمَ خِنْزِيرٍ فَإِنَّهُ رِجْسٌ أَوْ فِسْقًا أُهِلَّ لِغَيْرِ اللَّهِ بِهِ ۚ فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَإِنَّ رَبَّكَ غَفُورٌ رَحِيمٌ","numberInSurah":145,"juz":8,"manzil":2,"page":147,"ruku":119,"hizbQuarter":59,"sajda":false},{"number":935,"text":"وَعَلَى الَّذِينَ هَادُوا حَرَّمْنَا كُلَّ ذِي ظُفُرٍ ۖ وَمِنَ الْبَقَرِ وَالْغَنَمِ حَرَّمْنَا عَلَيْهِمْ شُحُومَهُمَا إِلَّا مَا حَمَلَتْ ظُهُورُهُمَا أَوِ الْحَوَايَا أَوْ مَا اخْتَلَطَ بِعَظْمٍ ۚ ذَٰلِكَ جَزَيْنَاهُمْ بِبَغْيِهِمْ ۖ وَإِنَّا لَصَادِقُونَ","numberInSurah":146,"juz":8,"manzil":2,"page":147,"ruku":119,"hizbQuarter":59,"sajda":false},{"number":936,"text":"فَإِنْ كَذَّبُوكَ فَقُلْ رَبُّكُمْ ذُو رَحْمَةٍ وَاسِعَةٍ وَلَا يُرَدُّ بَأْسُهُ عَنِ الْقَوْمِ الْمُجْرِمِينَ","numberInSurah":147,"juz":8,"manzil":2,"page":148,"ruku":119,"hizbQuarter":59,"sajda":false},{"number":937,"text":"سَيَقُولُ الَّذِينَ أَشْرَكُوا لَوْ شَاءَ اللَّهُ مَا أَشْرَكْنَا وَلَا آبَاؤُنَا وَلَا حَرَّمْنَا مِنْ شَيْءٍ ۚ كَذَٰلِكَ كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ حَتَّىٰ ذَاقُوا بَأْسَنَا ۗ قُلْ هَلْ عِنْدَكُمْ مِنْ عِلْمٍ فَتُخْرِجُوهُ لَنَا ۖ إِنْ تَتَّبِعُونَ إِلَّا الظَّنَّ وَإِنْ أَنْتُمْ إِلَّا تَخْرُصُونَ","numberInSurah":148,"juz":8,"manzil":2,"page":148,"ruku":119,"hizbQuarter":59,"sajda":false},{"number":938,"text":"قُلْ فَلِلَّهِ الْحُجَّةُ الْبَالِغَةُ ۖ فَلَوْ شَاءَ لَهَدَاكُمْ أَجْمَعِينَ","numberInSurah":149,"juz":8,"manzil":2,"page":148,"ruku":119,"hizbQuarter":59,"sajda":false},{"number":939,"text":"قُلْ هَلُمَّ شُهَدَاءَكُمُ الَّذِينَ يَشْهَدُونَ أَنَّ اللَّهَ حَرَّمَ هَٰذَا ۖ فَإِنْ شَهِدُوا فَلَا تَشْهَدْ مَعَهُمْ ۚ وَلَا تَتَّبِعْ أَهْوَاءَ الَّذِينَ كَذَّبُوا بِآيَاتِنَا وَالَّذِينَ لَا يُؤْمِنُونَ بِالْآخِرَةِ وَهُمْ بِرَبِّهِمْ يَعْدِلُونَ","numberInSurah":150,"juz":8,"manzil":2,"page":148,"ruku":119,"hizbQuarter":59,"sajda":false},{"number":940,"text":"۞ قُلْ تَعَالَوْا أَتْلُ مَا حَرَّمَ رَبُّكُمْ عَلَيْكُمْ ۖ أَلَّا تُشْرِكُوا بِهِ شَيْئًا ۖ وَبِالْوَالِدَيْنِ إِحْسَانًا ۖ وَلَا تَقْتُلُوا أَوْلَادَكُمْ مِنْ إِمْلَاقٍ ۖ نَحْنُ نَرْزُقُكُمْ وَإِيَّاهُمْ ۖ وَلَا تَقْرَبُوا الْفَوَاحِشَ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ ۖ وَلَا تَقْتُلُوا النَّفْسَ الَّتِي حَرَّمَ اللَّهُ إِلَّا بِالْحَقِّ ۚ ذَٰلِكُمْ وَصَّاكُمْ بِهِ لَعَلَّكُمْ تَعْقِلُونَ","numberInSurah":151,"juz":8,"manzil":2,"page":148,"ruku":120,"hizbQuarter":60,"sajda":false},{"number":941,"text":"وَلَا تَقْرَبُوا مَالَ الْيَتِيمِ إِلَّا بِالَّتِي هِيَ أَحْسَنُ حَتَّىٰ يَبْلُغَ أَشُدَّهُ ۖ وَأَوْفُوا الْكَيْلَ وَالْمِيزَانَ بِالْقِسْطِ ۖ لَا نُكَلِّفُ نَفْسًا إِلَّا وُسْعَهَا ۖ وَإِذَا قُلْتُمْ فَاعْدِلُوا وَلَوْ كَانَ ذَا قُرْبَىٰ ۖ وَبِعَهْدِ اللَّهِ أَوْفُوا ۚ ذَٰلِكُمْ وَصَّاكُمْ بِهِ لَعَلَّكُمْ تَذَكَّرُونَ","numberInSurah":152,"juz":8,"manzil":2,"page":149,"ruku":120,"hizbQuarter":60,"sajda":false},{"number":942,"text":"وَأَنَّ هَٰذَا صِرَاطِي مُسْتَقِيمًا فَاتَّبِعُوهُ ۖ وَلَا تَتَّبِعُوا السُّبُلَ فَتَفَرَّقَ بِكُمْ عَنْ سَبِيلِهِ ۚ ذَٰلِكُمْ وَصَّاكُمْ بِهِ لَعَلَّكُمْ تَتَّقُونَ","numberInSurah":153,"juz":8,"manzil":2,"page":149,"ruku":120,"hizbQuarter":60,"sajda":false},{"number":943,"text":"ثُمَّ آتَيْنَا مُوسَى الْكِتَابَ تَمَامًا عَلَى الَّذِي أَحْسَنَ وَتَفْصِيلًا لِكُلِّ شَيْءٍ وَهُدًى وَرَحْمَةً لَعَلَّهُمْ بِلِقَاءِ رَبِّهِمْ يُؤْمِنُونَ","numberInSurah":154,"juz":8,"manzil":2,"page":149,"ruku":120,"hizbQuarter":60,"sajda":false},{"number":944,"text":"وَهَٰذَا كِتَابٌ أَنْزَلْنَاهُ مُبَارَكٌ فَاتَّبِعُوهُ وَاتَّقُوا لَعَلَّكُمْ تُرْحَمُونَ","numberInSurah":155,"juz":8,"manzil":2,"page":149,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":945,"text":"أَنْ تَقُولُوا إِنَّمَا أُنْزِلَ الْكِتَابُ عَلَىٰ طَائِفَتَيْنِ مِنْ قَبْلِنَا وَإِنْ كُنَّا عَنْ دِرَاسَتِهِمْ لَغَافِلِينَ","numberInSurah":156,"juz":8,"manzil":2,"page":149,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":946,"text":"أَوْ تَقُولُوا لَوْ أَنَّا أُنْزِلَ عَلَيْنَا الْكِتَابُ لَكُنَّا أَهْدَىٰ مِنْهُمْ ۚ فَقَدْ جَاءَكُمْ بَيِّنَةٌ مِنْ رَبِّكُمْ وَهُدًى وَرَحْمَةٌ ۚ فَمَنْ أَظْلَمُ مِمَّنْ كَذَّبَ بِآيَاتِ اللَّهِ وَصَدَفَ عَنْهَا ۗ سَنَجْزِي الَّذِينَ يَصْدِفُونَ عَنْ آيَاتِنَا سُوءَ الْعَذَابِ بِمَا كَانُوا يَصْدِفُونَ","numberInSurah":157,"juz":8,"manzil":2,"page":149,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":947,"text":"هَلْ يَنْظُرُونَ إِلَّا أَنْ تَأْتِيَهُمُ الْمَلَائِكَةُ أَوْ يَأْتِيَ رَبُّكَ أَوْ يَأْتِيَ بَعْضُ آيَاتِ رَبِّكَ ۗ يَوْمَ يَأْتِي بَعْضُ آيَاتِ رَبِّكَ لَا يَنْفَعُ نَفْسًا إِيمَانُهَا لَمْ تَكُنْ آمَنَتْ مِنْ قَبْلُ أَوْ كَسَبَتْ فِي إِيمَانِهَا خَيْرًا ۗ قُلِ انْتَظِرُوا إِنَّا مُنْتَظِرُونَ","numberInSurah":158,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":948,"text":"إِنَّ الَّذِينَ فَرَّقُوا دِينَهُمْ وَكَانُوا شِيَعًا لَسْتَ مِنْهُمْ فِي شَيْءٍ ۚ إِنَّمَا أَمْرُهُمْ إِلَى اللَّهِ ثُمَّ يُنَبِّئُهُمْ بِمَا كَانُوا يَفْعَلُونَ","numberInSurah":159,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":949,"text":"مَنْ جَاءَ بِالْحَسَنَةِ فَلَهُ عَشْرُ أَمْثَالِهَا ۖ وَمَنْ جَاءَ بِالسَّيِّئَةِ فَلَا يُجْزَىٰ إِلَّا مِثْلَهَا وَهُمْ لَا يُظْلَمُونَ","numberInSurah":160,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":950,"text":"قُلْ إِنَّنِي هَدَانِي رَبِّي إِلَىٰ صِرَاطٍ مُسْتَقِيمٍ دِينًا قِيَمًا مِلَّةَ إِبْرَاهِيمَ حَنِيفًا ۚ وَمَا كَانَ مِنَ الْمُشْرِكِينَ","numberInSurah":161,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":951,"text":"قُلْ إِنَّ صَلَاتِي وَنُسُكِي وَمَحْيَايَ وَمَمَاتِي لِلَّهِ رَبِّ الْعَالَمِينَ","numberInSurah":162,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":952,"text":"لَا شَرِيكَ لَهُ ۖ وَبِذَٰلِكَ أُمِرْتُ وَأَنَا أَوَّلُ الْمُسْلِمِينَ","numberInSurah":163,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":953,"text":"قُلْ أَغَيْرَ اللَّهِ أَبْغِي رَبًّا وَهُوَ رَبُّ كُلِّ شَيْءٍ ۚ وَلَا تَكْسِبُ كُلُّ نَفْسٍ إِلَّا عَلَيْهَا ۚ وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰ ۚ ثُمَّ إِلَىٰ رَبِّكُمْ مَرْجِعُكُمْ فَيُنَبِّئُكُمْ بِمَا كُنْتُمْ فِيهِ تَخْتَلِفُونَ","numberInSurah":164,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":954,"text":"وَهُوَ الَّذِي جَعَلَكُمْ خَلَائِفَ الْأَرْضِ وَرَفَعَ بَعْضَكُمْ فَوْقَ بَعْضٍ دَرَجَاتٍ لِيَبْلُوَكُمْ فِي مَا آتَاكُمْ ۗ إِنَّ رَبَّكَ سَرِيعُ الْعِقَابِ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ","numberInSurah":165,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":6,"name":"سُورَةُ الأَنۡعَامِ","englishName":"En'âm","englishNameTranslation":"The Cattle","revelationType":"Meccan","numberOfAyahs":165,"ayahs":[{"number":790,"text":"Hamd, gökleri ve yeri yaratan, karanlıkları ve aydınlığı vareden Allah'a mahsustur. Öyle iken, inkar edenler Rablerine başkalarını eşit tutuyorlar.","numberInSurah":1,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":791,"text":"O, sizi çamurdan yaratan, sonra size bir ecel tayin edendir. Belirli bir ecel O'nun katındadır; sonra bir de şüphe edersiniz.","numberInSurah":2,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":792,"text":"O, göklerin ve yerin Allah'ı, içinizi dışınızı bilir, kazandıklarınızı da bilir.","numberInSurah":3,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":793,"text":"Onlara Rablerinin ayetlerinden bir ayet geldikçe ondan yüz çevirirlerdi.","numberInSurah":4,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":794,"text":"Gerçek kendilerine gelince onu yalanladılar. Alaya aldıkları şeyin haberleri kendilerine gelecektir.","numberInSurah":5,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":795,"text":"Onlardan önce nice nesilleri yok ettiğimizi görmediler mi? Onları, sizi yerleştirmediğimiz bir şekilde yeryüzüne yerleştirmiş, gökten bol yağmur yağdırmış, altlarından ırmaklar akıtmıştık. Fakat onları günahlarından ötürü yok ettik ve ardlarından başka bir nesil yetiştirdik.","numberInSurah":6,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":796,"text":"Sana Kitap'ı kağıtta yazılı olarak indirmiş olsak da, elleriyle ona dokunsalar, inkar edenler yine de, \"Bu apaçık bir büyüdür\" derlerdi.","numberInSurah":7,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":797,"text":"\"Ona bir melek indirilmeli değil miydi?\" dediler. Bir melek indirmiş olsaydık iş bitmiş olurdu da onlara göz bile açtırılmazdı.","numberInSurah":8,"juz":7,"manzil":2,"page":128,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":798,"text":"Biz onu melek kılsaydık, bir insan şeklinde yapardık da, düştükleri şüpheye onları yine düşürmüş olurduk.","numberInSurah":9,"juz":7,"manzil":2,"page":129,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":799,"text":"And olsun ki, senden önce birçok peygamberler alaya alınmıştı, onlarla eğlenenleri, alaya aldıkları şey mahvetti.","numberInSurah":10,"juz":7,"manzil":2,"page":129,"ruku":102,"hizbQuarter":51,"sajda":false},{"number":800,"text":"De ki: \"Yeryüzünde gezip dolaşın, sonra da, yalanlayanların sonunun nasıl olduğuna bir bakın.\"","numberInSurah":11,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":51,"sajda":false},{"number":801,"text":"De ki: \"göklerde ve yerde olanlar kimindir?\", \"Allah'ındır\" de. O, rahmet etmeyi kendi üzerine almıştır; and olsun ki, sizi vukuu şüphe götürmeyen kıyamet gününde toplayacaktır. Kendilerine yazık ettiler; çünkü onlar inanmazlar.","numberInSurah":12,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":51,"sajda":false},{"number":802,"text":"Gecede ve gündüzde bulunan O'nundur. O işitendir, Bilen'dir.","numberInSurah":13,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":803,"text":"\"Gökleri ve yeri yaratan, beslenmeyip besleyen Allah'tan başka bir dost mu edinirim?\" de. \"Doğrusu ben ilk müslüman olmakla emrolundum\" de; asla ortak koşanlardan olma!","numberInSurah":14,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":804,"text":"\"Ben Rabbime karşı gelirsem, büyük günün azabından korkarım\" de.","numberInSurah":15,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":805,"text":"O gün kim azabdan alıkonursa, şüphesiz o kimse rahmete erişmiştir. Bu, apaçık bir kurtuluştur.","numberInSurah":16,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":806,"text":"Allah sana bir sıkıntı verirse, O'ndan başkası gideremez. Sana bir iyilik verirse başkası onu engelleyemez. O, her şeye Kadir'dir.","numberInSurah":17,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":807,"text":"O, kullarının üstünde yegane tasarruf sahibidir. Hakim'dir, haberdardır.","numberInSurah":18,"juz":7,"manzil":2,"page":129,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":808,"text":"\"Şahit olarak hangi şey daha büyüktür\" de. \"Allah benimle sizin aranızda şahiddir. Bu Kuran bana, sizi ve ulaştığı kimseleri uyarmam için vahyolundu; Allah'la beraber başka tanrılar bulunduğuna siz mi şahidlik ediyorsunuz?\" de. \"Ben şehadet etmem\" de. \"O ancak tek Tanrıdır, doğrusu ben ortak koşmanızdan uzağım\" de.","numberInSurah":19,"juz":7,"manzil":2,"page":130,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":809,"text":"Kendilerine Kitap verdiklerimiz, onu (peygamberi) çocuklarını tanıdıkları gibi tanırlar; fakat kendilerine yazık ettiler, çünkü onlar inanmazlar.","numberInSurah":20,"juz":7,"manzil":2,"page":130,"ruku":103,"hizbQuarter":52,"sajda":false},{"number":810,"text":"Allah'a karşı yalan uyduran veya ayetlerini yalanlayandan daha zalim kimdir? Zalimler bunun için saadete ulaşamazlar.","numberInSurah":21,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":811,"text":"Bir gün hepsini toplarız, sonra ortak koşanlara, \"İddia ettiğiniz ortaklarınız nerede?\" deriz.","numberInSurah":22,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":812,"text":"Sonra, \"Rabbimiz Allah'a and olsun ki bizler ortak koşanlar değildik\" demekten başka çare bulamazlar.","numberInSurah":23,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":813,"text":"Kendilerine karşı nasıl yalan söylediklerine bak; uydurdukları şeyler de onlardan uzaklaştı.","numberInSurah":24,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":814,"text":"Onlardan seni dinleyenler vardır, Kuran'ı anlarlar diye kalblerine örtüler kulaklarına da ağırlık koyduk. Onlar her türlü mucizeyi görseler bile, yine de ona inanmazlar, nihayet sana geldiklerinde de seninle çekişirler. İnkar edenler, \"Bu, öncekilerin masallarından başka bir şey değildir\" derler.","numberInSurah":25,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":815,"text":"Onlar Kuran'dan alıkorlar ve ondan uzaklaşırlar. Böylece yalnız kendilerini mahvederler de farkına varamazlar.","numberInSurah":26,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":816,"text":"Onların, ateşin kenarına getirilip durdurulduklarında, \"keşke dünyaya tekrar döndürülseydik, Rabbimiz'in ayetlerini yalanlamasaydık ve inananlardan olsaydık\" dediklerini bir görsen!","numberInSurah":27,"juz":7,"manzil":2,"page":130,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":817,"text":"Hayır; daha önce gizledikleri onlara göründü. Eğer geri döndürülseler yine kendilerine yasak edilen şeylere dönerler. Doğrusu onlar yalancıdırlar.","numberInSurah":28,"juz":7,"manzil":2,"page":131,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":818,"text":"\"Hayat ancak bu dünyadakinden ibarettir, biz dirilecek değiliz\" dediler.","numberInSurah":29,"juz":7,"manzil":2,"page":131,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":819,"text":"Onları, Rablerinin huzuruna çıkarıldıkları zaman bir görsen! Allah: \"Bu gerçek değil mi?\" der; onlar, \"Evet, Rabbimiz hakkı için gerçektir\" derler. Allah da \"Öyleyse inkar etmenizden ötürü azabı tadın\" der.","numberInSurah":30,"juz":7,"manzil":2,"page":131,"ruku":104,"hizbQuarter":52,"sajda":false},{"number":820,"text":"Allah'a kavuşmayı yalanlayanlar doğrusu kaybedenlerdir ki kıyamet saati onlara ansızın gelince, ağırlıklarını arkalarına yüklenerek, \"Dünyada işlediğimiz büyük kusurlardan ötürü yazıklar olsun bize\" derler. Dikkat edin, yüklendikleri şeyler ne kötüdür!","numberInSurah":31,"juz":7,"manzil":2,"page":131,"ruku":105,"hizbQuarter":52,"sajda":false},{"number":821,"text":"Dünya hayatı sadece oyun ve oyalanmadır; ahiret yurdu, sakınanlar için daha iyidir. Düşünmüyor musunuz?","numberInSurah":32,"juz":7,"manzil":2,"page":131,"ruku":105,"hizbQuarter":52,"sajda":false},{"number":822,"text":"Onların söylediklerinin seni üzeceğini elbette biliyoruz; doğrusu onlar seni yalancı saymıyorlar, fakat zalimler Allah'ın ayetlerini bile bile inkar ediyorlar.","numberInSurah":33,"juz":7,"manzil":2,"page":131,"ruku":105,"hizbQuarter":52,"sajda":false},{"number":823,"text":"Senden önce nice peygamberler yalanlandı ve kendilerine yardımımız gelene kadar yalanlanmalarına ve sıkıştırılmaya katlandılar. Allah'ın sözlerini değiştirebilecek yoktur; and olsun ki peygamberlerin haberi sana da geldi.","numberInSurah":34,"juz":7,"manzil":2,"page":131,"ruku":105,"hizbQuarter":52,"sajda":false},{"number":824,"text":"Onların yüz çevirmesi sana ağır gelince, eğer gücün yeri delmeye veya göğe merdiven dayamağa yetmiş olsaydı, onlara bir mucize göstermek isterdin. Allah dileseydi onları doğru yolda toplardı. Sakın bilmeyenlerden olma.","numberInSurah":35,"juz":7,"manzil":2,"page":131,"ruku":105,"hizbQuarter":52,"sajda":false},{"number":825,"text":"Ancak kulak verenler daveti kabul ederler. Ölüleri Allah diriltir, sonra O'na dönerler.","numberInSurah":36,"juz":7,"manzil":2,"page":132,"ruku":105,"hizbQuarter":53,"sajda":false},{"number":826,"text":"\"Rabbinden ona (Muhammed'e) bir belge indirilseydi ya\" dediler. De ki: \"Doğrusu Allah bir belge indirmeye Kadir'dir, fakat çoğu bilmezler.\"","numberInSurah":37,"juz":7,"manzil":2,"page":132,"ruku":105,"hizbQuarter":53,"sajda":false},{"number":827,"text":"Yerde yürüyen hayvanlar ve kanatlarıyla uçan kuşlar da ancak sizin gibi birer toplulukturlar. Kitap'da Biz hiçbir şeyi eksik bırakmadık; onlar sonra Rablerine toplanacaklardır.","numberInSurah":38,"juz":7,"manzil":2,"page":132,"ruku":105,"hizbQuarter":53,"sajda":false},{"number":828,"text":"Ayetlerimizi yalanlayanlar karanlıklarda kalmış sağır ve dilsizlerdir. Allah kimi dilerse onu saptırır ve kimi dilerse onu doğru yola koyar.","numberInSurah":39,"juz":7,"manzil":2,"page":132,"ruku":105,"hizbQuarter":53,"sajda":false},{"number":829,"text":"De ki, \"Üzerinize Allah'ın azabı gelse veya kıyamet saati size gelse, Allah'tan başkasına mı yalvarırsınız? Doğru iseniz bana bildirin\".","numberInSurah":40,"juz":7,"manzil":2,"page":132,"ruku":105,"hizbQuarter":53,"sajda":false},{"number":830,"text":"Hayır; sadece O'na yalvarırsınız; dilerse yalvardığınız şeyi giderir, siz de O'na koştuğunuz ortakları unutursunuz.","numberInSurah":41,"juz":7,"manzil":2,"page":132,"ruku":105,"hizbQuarter":53,"sajda":false},{"number":831,"text":"Şüphesiz ki, senden önce ümmetlere peygamberler göndermiştik; onları yalvarsınlar diye darlık ve sıkıntıya sokmuştuk.","numberInSurah":42,"juz":7,"manzil":2,"page":132,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":832,"text":"Hiç değilse, onlara şiddetimiz geldiği zaman yalvarıp yakarmalı değil miydiler? Lakin kalbleri katılaştı, şeytan da yaptıklarını onlara güzel gösterdi.","numberInSurah":43,"juz":7,"manzil":2,"page":132,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":833,"text":"Kendilerine hatırlatılanı unuttuklarında, onlara her şeyin kapısını açtık; kendilerine verilene sevinince ansızın onları yakaladık da umutsuz kalıverdiler.","numberInSurah":44,"juz":7,"manzil":2,"page":132,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":834,"text":"Zulmeden milletin kökü böylece kesildi. Hamd, Alemlerin Rabbi Allah'a mahsustur.","numberInSurah":45,"juz":7,"manzil":2,"page":133,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":835,"text":"De ki: \"Gördünüz mü? Allah, işitmenizi, gözlerinizi alsa, kalblerinizi kapasa, Allah'tan başka hangi tanrı onu sizlere getirebilir?\" Ayetleri nasıl türlü türlü açıkladığımıza bir baksana, sonra da onlar yüz çevirirler.","numberInSurah":46,"juz":7,"manzil":2,"page":133,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":836,"text":"De ki: \"Allah'ın azabı size ansızın veya açıkça gelirse, zalimlerden başkası mı yok olur? Bana bildirin.\"","numberInSurah":47,"juz":7,"manzil":2,"page":133,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":837,"text":"Peygamberleri ancak müjdeci ve uyarıcı olarak gönderiyoruz. Kim inanır ve nefsini ıslah ederse onlara korku yoktur, onlar üzülmeyeceklerdir.","numberInSurah":48,"juz":7,"manzil":2,"page":133,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":838,"text":"Ayetlerimizi inkar edenlere yoldan çıkmalarından ötürü azab dokunacaktır.","numberInSurah":49,"juz":7,"manzil":2,"page":133,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":839,"text":"De ki: \"Size Allah'ın hazineleri elimdedir, demiyorum; gaybı da bilmiyorum; size, ben meleğim demiyorum, ben ancak bana vahyolunana uyuyorum.\" De ki: \"Görenle görmeyen bir midir? Düşünmüyor musunuz?\"","numberInSurah":50,"juz":7,"manzil":2,"page":133,"ruku":106,"hizbQuarter":53,"sajda":false},{"number":840,"text":"Rablerine toplanacaklarından korkanları Kuran ile uyar. O'ndan başka bir dost ve aracıları yoktur. Umulur ki Allah'tan sakınalar.","numberInSurah":51,"juz":7,"manzil":2,"page":133,"ruku":107,"hizbQuarter":53,"sajda":false},{"number":841,"text":"Sabah akşam, Rabblerinin rızasını isteyerek O'na yalvaranları kovma. Onların hesabından sana bir sorumluluk yoktur, senin hesabından da onlara bir sorumluluk yoktur ki onları kovarak zulmedenlerden olasın.","numberInSurah":52,"juz":7,"manzil":2,"page":133,"ruku":107,"hizbQuarter":53,"sajda":false},{"number":842,"text":"Böylece, \"Aramızdan Allah bunlara mı iyilikte bulundu?\" demeleri için onları birbiriyle denedik. Allah şükredenleri iyi bilen değil midir?","numberInSurah":53,"juz":7,"manzil":2,"page":134,"ruku":107,"hizbQuarter":53,"sajda":false},{"number":843,"text":"Ayetlerimize inananlar sana gelince: \"Size selam olsun\" de. Rabbiniz, sizden kim bilmeyerek fenalık işler de arkasından tövbe eder ve nefsini düzeltirse, ona rahmet etmeyi kendi üzerine almıştır. O, bağışlar ve merhamet eder.","numberInSurah":54,"juz":7,"manzil":2,"page":134,"ruku":107,"hizbQuarter":53,"sajda":false},{"number":844,"text":"Suçluların yolu belli olsun diye, böylece ayetleri uzun uzun açıklarız.","numberInSurah":55,"juz":7,"manzil":2,"page":134,"ruku":107,"hizbQuarter":53,"sajda":false},{"number":845,"text":"De ki: \"Allah'tan başka, yalvardıklarınıza kulluk etmekten menolundum.\" \"Sizin heveslerinize uymayacağım, yoksa sapıtmış, doğru yolda gidenlerden olmamış olurum\" de.","numberInSurah":56,"juz":7,"manzil":2,"page":134,"ruku":108,"hizbQuarter":53,"sajda":false},{"number":846,"text":"De ki: \"Ben Rabbim'den bir belgeye dayanmaktayım, halbuki siz onu yalanladınız; acele istediğiniz de elimde değildir. Hüküm ancak Allah'ındır. O, hükmedenlerin en iyisi olarak gerçeği anlatır.\"","numberInSurah":57,"juz":7,"manzil":2,"page":134,"ruku":108,"hizbQuarter":53,"sajda":false},{"number":847,"text":"De ki: \"Acele istediğiniz şey elimde olsaydı, benimle aranızdaki iş bitmiş olurdu.\" Allah zulmedenleri en iyi bilendir.","numberInSurah":58,"juz":7,"manzil":2,"page":134,"ruku":108,"hizbQuarter":53,"sajda":false},{"number":848,"text":"Gaybın anahtarları O'nun katındadır, onları ancak O bilir. Karada ve denizde olanı bilir. Düşen yaprağı, yerin karanlıklarında olan taneyi, yaşı kuruyu ki apaçık Kitap'tadır ancak O bilir.","numberInSurah":59,"juz":7,"manzil":2,"page":134,"ruku":108,"hizbQuarter":54,"sajda":false},{"number":849,"text":"Geceleyin sizi ölü gibi uyutan, gündüzün yaptıklarınızı bilen, mukadder olan hayat süreniz doluncaya kadar gündüzleri sizi tekrar kaldıran O'dur. Sonra dönüşünüz O'nadır, işlediklerinizi size bildirecektir.","numberInSurah":60,"juz":7,"manzil":2,"page":135,"ruku":108,"hizbQuarter":54,"sajda":false},{"number":850,"text":"O, kulların üstünde yegane Hakim'dir, size koruyucular gönderir. Artık birinize ölüm gelince elçilerimiz, bir eksiklik yapmaksızın onun canını alırlar, sonra gerçek Mevlalarına döndürürler. Haberiniz olsun, hüküm O'nundur. O, hesap görenlerin en süratlisidir.","numberInSurah":61,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":851,"text":"O, kulların üstünde yegane Hakim'dir, size koruyucular gönderir. Artık birinize ölüm gelince elçilerimiz, bir eksiklik yapmaksızın onun canını alırlar, sonra gerçek Mevlalarına döndürürler. Haberiniz olsun, hüküm O'nundur. O, hesap görenlerin en süratlisidir.","numberInSurah":62,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":852,"text":"De ki: \"Kara ve denizin karanlıklarından sizi kim kurtarır? Bundan bizi kurtarırsan şükredenlerden olacağız diye O'na gizli gizli yalvarır yakarırsınız.\"","numberInSurah":63,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":853,"text":"De ki: \"Allah sizi ondan ve her sıkıntıdan kurtarır, sonra da O'na ortak koşarsınız.\"","numberInSurah":64,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":854,"text":"De ki: \"Üstünüzden ve altınızdan size azab göndermeğe, sizi fırka fırka yapıp kiminize kiminizin hıncını tattırmağa Kadir olan O'dur.\" Anlasınlar diye ayetleri nasıl yerli yerince açıkladığımıza bak.","numberInSurah":65,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":855,"text":"Gerçekten, senin milletin Kuran'ı yalanladı. \"Cezanızı ben verecek değilim\" de.","numberInSurah":66,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":856,"text":"Her haberin gerçekleşeceği bir zaman vardır ki siz onu yakında bileceksiniz.","numberInSurah":67,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":857,"text":"Ayetlerimizi çekişmeye dalanları görünce, başka bir bahse geçmelerine kadar onlardan yüz çevir. Şeytan sana unutturursa hatırladıktan sonra artık zulmedenlerle beraber oturma.","numberInSurah":68,"juz":7,"manzil":2,"page":135,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":858,"text":"Sakınan kimselere, onların hesaplarından bir sorumluluk yoktur. Fakat bir hatırlatmadır; belki sakınırlar.","numberInSurah":69,"juz":7,"manzil":2,"page":136,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":859,"text":"Dinlerini oyun ve eğlenceye alanları, dünya hayatının aldattığı kimseleri bırak. Kuran ile öğüt ver ki, bir kimse kazandığıyla helake düşmeye görsün, o takdirde Allah'dan başka ona ne bir yardımcı, ne de bir kurtarıcı bulunur; her türlü fidyeyi de verse kabul olunmaz. Kazandıklarından ötürü yok olanlar işte bunlardır. İnkar etmelerinden dolayı kızgın içecek ve can yakıcı azab onlaradır.","numberInSurah":70,"juz":7,"manzil":2,"page":136,"ruku":109,"hizbQuarter":54,"sajda":false},{"number":860,"text":"De ki: \"Arkadaşları bize gel diye doğru yola çağırırken, şeytanların yeryüzünde şaşırttıkları bir kimse gibi geriye mi dönelim. Allah bizi doğru yola eriştirdikten sonra, bize faydası olmayan, zarar da veremeyen Allah'tan başka şeylere mi yalvaralım?\" De ki, \"Doğru yol ancak Allah'ın yoludur. Alemlerin Rabbine teslim olarak namaz kılın, Allah'tan sakının diye emrolunduk.\" Kendisine toplanacağınız O'dur.","numberInSurah":71,"juz":7,"manzil":2,"page":136,"ruku":110,"hizbQuarter":54,"sajda":false},{"number":861,"text":"De ki: \"Arkadaşları bize gel diye doğru yola çağırırken, şeytanların yeryüzünde şaşırttıkları bir kimse gibi geriye mi dönelim. Allah bizi doğru yola eriştirdikten sonra, bize faydası olmayan, zarar da veremeyen Allah'tan başka şeylere mi yalvaralım?\" De ki, \"Doğru yol ancak Allah'ın yoludur. Alemlerin Rabbine teslim olarak namaz kılın, Allah'tan sakının diye emrolunduk.\" Kendisine toplanacağınız O'dur.","numberInSurah":72,"juz":7,"manzil":2,"page":136,"ruku":110,"hizbQuarter":54,"sajda":false},{"number":862,"text":"Gökleri ve yeri gerçekle yaratan O'dur ki \"Ol\" dediği gün (an) hemen olur; sözü gerçektir. Sura üfleneceği gün hükümranlık O'nundur. Görülmeyeni de görüleni de bilir. O Hakim'dir, haberdardır.","numberInSurah":73,"juz":7,"manzil":2,"page":136,"ruku":110,"hizbQuarter":54,"sajda":false},{"number":863,"text":"İbrahim, babası Azer'e, \"Putları tanrı olarak mı benimsiyorsun? Doğrusu ben seni ve milletini açık bir sapıklık içinde görüyorum\" demişti.","numberInSurah":74,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":864,"text":"Yakinen bilenlerden olması için İbrahim'e göklerin ve yerin hükümranlığını şöylece gösteriyorduk:","numberInSurah":75,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":865,"text":"Gece basınca bir yıldız gördü, \"işte bu benim Rabbim!\" dedi; yıldız batınca, \"batanları sevmem\" dedi.","numberInSurah":76,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":866,"text":"Ayı doğarken görünce, \"işte bu benim Rabbim!\" dedi, batınca, \"Rabbim beni doğruya eriştirmeseydi and olsun ki sapıklardan olurdum\" dedi.","numberInSurah":77,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":867,"text":"Güneşi doğarken görünce \"işte bu benim Rabbim, bu daha büyük!\" dedi; batınca, \"Ey milletim! Doğrusu ben ortak koştuklarınızdan uzağım\" dedi.","numberInSurah":78,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":868,"text":"\"Doğrusu ben yüzümü, gökleri ve yeri yaratana, doğruya yönelerek çevirdim, ben ortak koşanlardan değilim.\"","numberInSurah":79,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":869,"text":"Milleti onunla tartışmaya girişti. \"Beni doğru yola eriştirmişken, Allah hakkında benimle mi tartışıyorsunuz? O'na ortak koştuklarınızdan korkmuyorum, meğer ki Rabbim bir şeyi dilemiş ola. Rabbim ilimce her şeyi kuşatmıştır; hala öğüt kabul etmez misiniz?\" dedi.","numberInSurah":80,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":870,"text":"\"Allah'a koştuğunuz ortaklardan nasıl korkarım? Oysa siz, Allah'ın hakkında size bir delil indirmediği bir şeyi O'na ortak koşmaktan korkmuyorsunuz. İki taraftan hangisine güvenmek daha gereklidir, bir bilseniz.\"","numberInSurah":81,"juz":7,"manzil":2,"page":137,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":871,"text":"İşte güven; onlara, inanıp haksızlık karıştırmayanlaradır. Onlar doğru yoldadırlar.","numberInSurah":82,"juz":7,"manzil":2,"page":138,"ruku":110,"hizbQuarter":55,"sajda":false},{"number":872,"text":"Bu, İbrahim'e, milletine karşı verdiğimiz hüccetimizdir. Dilediğimizi derecelerle yükseltiriz. Doğrusu Rabbin Hakim'dir, Bilen'dir.","numberInSurah":83,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":873,"text":"Ona İshak'ı, Yakub'u bağışladık, her birini doğru yola eriştirdik. Daha önce Nuh'u ve soyundan Davud'u, Süleyman'ı, Eyyub'u, Yusuf'u, Musa'yı ve Harun'u -ki işlerini iyi yapanlara böylece karşılık veririz-, Zekeriya'yı, Yahya'yı, İsa'yı ve İlyas'ı -ki hepsi iyilerdendir-, İsmail'i, Elyesa'ı, Yunus'u, Lut'u -ki hepsini dünyalara üstün kıldık- doğru yola eriştirdik.","numberInSurah":84,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":874,"text":"Ona İshak'ı, Yakub'u bağışladık, her birini doğru yola eriştirdik. Daha önce Nuh'u ve soyundan Davud'u, Süleyman'ı, Eyyub'u, Yusuf'u, Musa'yı ve Harun'u -ki işlerini iyi yapanlara böylece karşılık veririz-, Zekeriya'yı, Yahya'yı, İsa'yı ve İlyas'ı -ki hepsi iyilerdendir-, İsmail'i, Elyesa'ı, Yunus'u, Lut'u -ki hepsini dünyalara üstün kıldık- doğru yola eriştirdik.","numberInSurah":85,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":875,"text":"Ona İshak'ı, Yakub'u bağışladık, her birini doğru yola eriştirdik. Daha önce Nuh'u ve soyundan Davud'u, Süleyman'ı, Eyyub'u, Yusuf'u, Musa'yı ve Harun'u -ki işlerini iyi yapanlara böylece karşılık veririz-, Zekeriya'yı, Yahya'yı, İsa'yı ve İlyas'ı -ki hepsi iyilerdendir-, İsmail'i, Elyesa'ı, Yunus'u, Lut'u -ki hepsini dünyalara üstün kıldık- doğru yola eriştirdik.","numberInSurah":86,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":876,"text":"Babalarından, soylarından, kardeşlerinden bir kısmını seçtik ve doğru yola eriştirdik.","numberInSurah":87,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":877,"text":"Bu, Allah'ın kullarından dilediğini eriştirdiği yoludur. Eğer ortak koşsalarda amelleri boşa çıkardı.","numberInSurah":88,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":878,"text":"Kendilerine kitap, hüküm ve peygamberlik verdiklerimiz işte bunlardır. Kafirler onları inkar ederlerse, inkar etmeyecek bir milleti onlara vekil kılarız.","numberInSurah":89,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":879,"text":"İşte bunlar Allah'ın doğru yola eriştirdikleridir, onların yoluna uy, \"Sizden buna karşılık bir ücret istemem, bu sadece herkes için bir hatırlatmadır\" de.","numberInSurah":90,"juz":7,"manzil":2,"page":138,"ruku":111,"hizbQuarter":55,"sajda":false},{"number":880,"text":"\"Allah hiçbir insana bir şey indirmemiştir\" demekle Allah'ı gereği gibi değerlendiremediler. De ki: \"Musa'nın insanlara nur ve yol gösterici olarak getirdiği Kitap'ı kim indirdi? Ki siz onu kağıtlara yazıp bir kısmını gösterip çoğunu gizlersiniz, atalarınızın ve sizin bilmediğiniz size onunla öğretilmiştir.\" \"Allah\" de, sonra da onları daldıkları sapıklıkta bırak, oynasınlar.","numberInSurah":91,"juz":7,"manzil":2,"page":139,"ruku":112,"hizbQuarter":55,"sajda":false},{"number":881,"text":"Bu indirdiğimiz, kendinden öncekileri doğrulayan, Mekkelileri ve etrafındakileri uyaran mübarek Kitap'dır. Ahirete inananlar buna inanırlar, namazlarına da devam ederler.","numberInSurah":92,"juz":7,"manzil":2,"page":139,"ruku":112,"hizbQuarter":55,"sajda":false},{"number":882,"text":"Allah'a karşı yalan uydurandan veya kendisine bir şey vahyedilmemişken \"Bana vahyolundu, Allah'ın indirdiği gibi ben de indireceğim\" diyenden daha zalim kim olabilir? Bu zalimleri can çekişirlerken melekler ellerini uzatmış, \"Canlarınızı verin, bugün Allah'a karşı haksız yere söylediklerinizden, O'nun ayetlerine büyüklük taslamanızdan ötürü alçaltıcı azabla cezalandırılacaksınız\" derken bir görsen!","numberInSurah":93,"juz":7,"manzil":2,"page":139,"ruku":112,"hizbQuarter":55,"sajda":false},{"number":883,"text":"Onlara: \"And olsun ki, sizi ilk defa yarattığımız gibi size verdiklerimizi ardınızda bırakarak bize birer birer geldiniz; içinizde Allah'ın ortakları olduğunu sandığınız şefaatçılarınızı beraber görmüyoruz. And olsun ki aranızdaki bağlar kopmuş, ortak sandıklarınız sizden ayrılmışlardır\" denecek.","numberInSurah":94,"juz":7,"manzil":2,"page":139,"ruku":112,"hizbQuarter":55,"sajda":false},{"number":884,"text":"Taneyi ve çekirdeği yaran şüphesiz Allah'tır; ölüyü çıkarır. İşte Allah budur, nasıl yüz çevirirsiniz?","numberInSurah":95,"juz":7,"manzil":2,"page":140,"ruku":113,"hizbQuarter":56,"sajda":false},{"number":885,"text":"Tanyerini ağartan, geceyi dinlenme zamanı, güneş ve ayı vakit ölçüsü kılandır. Bu, Güçlü olan'ın, Bilen'in nizamıdır.","numberInSurah":96,"juz":7,"manzil":2,"page":140,"ruku":113,"hizbQuarter":56,"sajda":false},{"number":886,"text":"O, yıldızları kara ve denizin karanlıklarında yol bulasınız diye sizin için var edendir. Bilen millet için ayetleri uzun uzadıya açıkladık.","numberInSurah":97,"juz":7,"manzil":2,"page":140,"ruku":113,"hizbQuarter":56,"sajda":false},{"number":887,"text":"O, sizi bir tek nefisten, babaların sulbünde kararlaşmış ve anaların rahminde kararlaşmakta olarak yaratandır. Anlayan millet için ayetleri uzun uzadıya açıkladık.","numberInSurah":98,"juz":7,"manzil":2,"page":140,"ruku":113,"hizbQuarter":56,"sajda":false},{"number":888,"text":"O, gökten su indirendir. Her bitkiyi onunla bitirdik, ondan bitirdiğimiz yeşilden, birbirine benzeyen ve benzemeyen yığın yığın taneler, hurmaların tomurcuklarından sarkan salkımlar, üzüm bağları, zeytin ve nar çıkardık. Ürün verdiklerinde ürünlerine, olgunlaşmalarına bir bakın. Bunlarda, inananlar için, şüphesiz, deliller vardır.","numberInSurah":99,"juz":7,"manzil":2,"page":140,"ruku":113,"hizbQuarter":56,"sajda":false},{"number":889,"text":"Cinleri O yaratmışken kafirler Allah'a ortak koştular. Körü körüne O'na oğullar ve kızlar uydurdular. Haşa, O onların vasıflandırmalarından yücedir.","numberInSurah":100,"juz":7,"manzil":2,"page":140,"ruku":113,"hizbQuarter":56,"sajda":false},{"number":890,"text":"O, gökleri ve yeri yoktan yaratandır. Zevcesi olmadan nasıl çocuğu olabilir? Oysa her şeyi O yaratmıştır, her şeyi bilir.","numberInSurah":101,"juz":7,"manzil":2,"page":140,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":891,"text":"İşte Rabbiniz, Allah budur. O'ndan başka tanrı yoktur, her şeyin yaratanıdır. Öyleyse O'na kulluk edin; O her şeye de vekildir.","numberInSurah":102,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":892,"text":"Gözler O'nu görmez, O bütün gözleri görür. O Latif'tir, haberdardır.","numberInSurah":103,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":893,"text":"Doğrusu size Rabbiniz'den açık belgeler gelmiştir; kim görürse kendi lehine ve kim körlük ederse kendi aleyhinedir. Ben sizin bekçiniz değilim.","numberInSurah":104,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":894,"text":"Sana, \"Sen okumuşsun\" derler; oysa Biz, öğrenecek kimselere ayetleri böylece türlü türlü açıklamaktayız.","numberInSurah":105,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":895,"text":"Rabbin'den sana vahyolunana uy, O'ndan başka tanrı yoktur, puta tapanlardan yüz çevir.","numberInSurah":106,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":896,"text":"Allah dileseydi puta tapmazlardı. Seni onlara koruyucu yapmadık, onların vekili de değilsin.","numberInSurah":107,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":897,"text":"Allah'tan başka yalvardıklarına sövmeyin ki, onlar da cahillikle ileri giderek Allah'a sövmesinler. Böylece her ümmete işini güzel gösterdik, sonra dönüşleri Rab'lerinedir. O, işlediklerini haber verir.","numberInSurah":108,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":898,"text":"Kendilerine bir mucize gösterilirse, mutlaka ona inanacaklarına dair bütün güçleriyle Allah'a yemin ederler. De ki: \"Mucizeler, ancak Allah katındadır\"; onların, mucize geldiği zaman da inanmayacaklarını anlamıyor musunuz?","numberInSurah":109,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":899,"text":"Onların kalblerini, gözlerini, ona ilk defa inanmadıkları gibi çeviririz; onları taşkınlıkları içinde şaşkın şaşkın bırakırız.","numberInSurah":110,"juz":7,"manzil":2,"page":141,"ruku":114,"hizbQuarter":56,"sajda":false},{"number":900,"text":"Eğer biz onlara melekleri indirsek, ölüler onlarla konuşsa ve her şeyi karşılarına toplasaydık, Allah dilemedikçe, yine de inanmazlardı; fakat onların çoğu bunu bilmiyorlar.","numberInSurah":111,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":901,"text":"Aldatmak için birbirlerine cazip sözler fısıldayan cin ve insan şeytanlarını her peygambere düşman yaptık. Bu şeytanlar ahirete inanmayanların kalblerinin o sözlere yönelmesi, ondan hoşnut olması ve kendilerinin işledikleri suçları işlemeleri için böyle yaparlar. Rabbin dileseydi bunu yapamazlardı, sen onları iftiraları ile başbaşa bırak;","numberInSurah":112,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":902,"text":"Aldatmak için birbirlerine cazip sözler fısıldayan cin ve insan şeytanlarını her peygambere düşman yaptık. Bu şeytanlar ahirete inanmayanların kalblerinin o sözlere yönelmesi, ondan hoşnut olması ve kendilerinin işledikleri suçları işlemeleri için böyle yaparlar. Rabbin dileseydi bunu yapamazlardı, sen onları iftiraları ile başbaşa bırak;","numberInSurah":113,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":903,"text":"\"Allah size Kitap'ı açık açık indirmişken O'ndan başka bir hakem mi isteyeyim?\" Kendilerine Kitap verdiklerimiz, onun gerçekten Rableri katından indirilmiş olduğunu bilirler. Öyleyse, sen şüpheye düşenlerden olma!","numberInSurah":114,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":904,"text":"Rabbinin sözü, doğruluk ve adaletle tamamlandı. O'nun sözlerini değiştirebilecek yoktur. O, işitir ve bilir.","numberInSurah":115,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":905,"text":"Yeryüzündekilerin çoğunluğuna itaat edersen seni Allah yolundan saptırırlar. Onlar ancak zanna uyarlar, sadece tahminde bulunurlar.","numberInSurah":116,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":906,"text":"Doğrusu Rabbin, yolundan kimin saptığını daha iyi bilir. Doğru yolda olanları da en iyi O bilir.","numberInSurah":117,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":907,"text":"Allah'ın ayetlerine inanıyorsanız, üzerine Allah'ın adı anılmış olan şeyden yiyin.","numberInSurah":118,"juz":8,"manzil":2,"page":142,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":908,"text":"Size ne oluyor ki, Allah size darda kalmanızın dışında, haram olanları genişçe anlatmışken adının üzerine anıldığı şeyden yemiyorsunuz? Doğrusu çoğunluk, heva ve heveslerine uyarak, bilmeden sapıtıyorlar. Aşırı gidenleri en iyi bilen Rabbindir.","numberInSurah":119,"juz":8,"manzil":2,"page":143,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":909,"text":"Günahın açığını da gizlisini de bırakın. Günah kazananlar, kazandıklarına karşılık şüphesiz ceza göreceklerdir.","numberInSurah":120,"juz":8,"manzil":2,"page":143,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":910,"text":"Üzerine Allah'ın adının anılmadığı kesilmiş hayvanları yemeyin, bunu yapmak Allah'ın yolundan çıkmaktır. Doğrusu şeytanlar sizinle tartışmaları için dostlarına fısıldarlar, eğer onlara itaat ederseniz şüphesiz siz müşrik olursunuz.","numberInSurah":121,"juz":8,"manzil":2,"page":143,"ruku":115,"hizbQuarter":57,"sajda":false},{"number":911,"text":"Ölü iken kalbini diriltip, insanlar arasında yürürken önünü aydınlatacak bir nur verdiğimiz kimsenin durumu, karanlıklarda kalıp çıkamayan kimsenin durumu gibi midir? Kafirlere de, işledikleri güzel gösterilmiştir.","numberInSurah":122,"juz":8,"manzil":2,"page":143,"ruku":116,"hizbQuarter":57,"sajda":false},{"number":912,"text":"Bunun gibi, her kasabanın bir takım ileri gelenlerini orada hile yapan suçlular kıldık. Oysa yalnız kendilerine hile yaparlar da farkına varmazlar.","numberInSurah":123,"juz":8,"manzil":2,"page":143,"ruku":116,"hizbQuarter":57,"sajda":false},{"number":913,"text":"Onlara bir ayet geldiği zaman, \"Allah'ın peygamberlerine verilen bize de verilmedikçe inanmayız\" derler. Allah, peygamberliğini vereceği kimseyi daha iyi bilir. Suç işleyenlere Allah katından bir aşağılık ve hilelerinden ötürü de şiddetli bir azab erişecektir.","numberInSurah":124,"juz":8,"manzil":2,"page":143,"ruku":116,"hizbQuarter":57,"sajda":false},{"number":914,"text":"Allah kimi doğru yola koymak isterse onun kalbini İslamiyet'e açar, kimi de saptırmak isterse, göğe yükseliyormuş gibi, kalbini dar ve sıkıntılı kılar. Allah böylece, inanmayanları küfür bataklığında bırakır.","numberInSurah":125,"juz":8,"manzil":2,"page":144,"ruku":116,"hizbQuarter":57,"sajda":false},{"number":915,"text":"Rabbinin, dosdoğru yolu işte budur. İbret alan kimselere ayetleri uzun uzadıya açıkladık.","numberInSurah":126,"juz":8,"manzil":2,"page":144,"ruku":116,"hizbQuarter":57,"sajda":false},{"number":916,"text":"Rablerinin katında selamet yurdu onlarındır. O, işlediklerinden ötürü onların dostudur.","numberInSurah":127,"juz":8,"manzil":2,"page":144,"ruku":116,"hizbQuarter":58,"sajda":false},{"number":917,"text":"Allah hepsini toplayacağı gün, \"Ey cin topluluğu! İnsanların çoğunu yoldan çıkardınız\" der, insanlardan onlara uymuş olanlar, \"Rabbimiz! Bir kısmımız bir kısmımızdan faydalandık ve bize tayin ettiğin sürenin sonuna ulaştık\" derler. \"Cehennem, Allah'ın dilemesine bağlı olarak, temelli kalacağınız durağınızdır\" der. Doğrusu Rabbin hakimdir, bilendir.","numberInSurah":128,"juz":8,"manzil":2,"page":144,"ruku":116,"hizbQuarter":58,"sajda":false},{"number":918,"text":"Zalimlerin bir kısmını, kazandıklarından ötürü diğer bir kısmına böylece musallat ederiz.","numberInSurah":129,"juz":8,"manzil":2,"page":144,"ruku":116,"hizbQuarter":58,"sajda":false},{"number":919,"text":"\"Ey cin ve insan topluluğu! Size ayetlerimi anlatan, bugünle karşılaşmanızdan sizi uyaran peygamberler gelmedi mi?\" \"Kendi hakkımızda şahidiz\" derler. Dünya hayatı onları aldattı da inkarcı olduklarına, kendi aleyhlerinde şahidlik ettiler.","numberInSurah":130,"juz":8,"manzil":2,"page":144,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":920,"text":"Bu, haberleri yokken kasabalar halkını Allah'ın haksız yere yok etmeyeceğinden dolayıdır.","numberInSurah":131,"juz":8,"manzil":2,"page":144,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":921,"text":"İşlediklerine karşılık her birinin dereceleri vardır. Rabbin onların işlediklerinden habersiz değildir.","numberInSurah":132,"juz":8,"manzil":2,"page":145,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":922,"text":"Rabbin müstağni ve rahmet sahibidir. Dilerse, sizi başka bir milletin soyundan getirdiği gibi, sizi yok eder, dilediğini yerinize getirir.","numberInSurah":133,"juz":8,"manzil":2,"page":145,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":923,"text":"Size vadedilen, mutlaka yerine gelecektir; siz O'nu aciz kılamazsınız.","numberInSurah":134,"juz":8,"manzil":2,"page":145,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":924,"text":"De ki, \"Ey milletim! Durumunuzun gerektirdiğini yapın, doğrusu ben de yapacağım. Sonucun kimin için hayırlı olacağını bileceksiniz. Zulmedenler şüphesiz kurtulamazlar.\"","numberInSurah":135,"juz":8,"manzil":2,"page":145,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":925,"text":"Kendi zanlarına göre, \"Bu Allah'ındır, bu da putlarımızındır\" diyerek, Allah'ın yarattığı hayvanlar ve ekinlerden pay ayırdılar. Putları için ayırdıkları Allah için verilmez, ama Allah için ayırdıkları putlarına verilirdi; ne kötü hüküm veriyorlardı!","numberInSurah":136,"juz":8,"manzil":2,"page":145,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":926,"text":"Böylece, putlara hizmet edenler, puta tapanların çoğunu helake sürüklemek, dinlerini karma karışık etmek için çocuklarını öldürmelerini onlara iyi göstermişlerdir. Allah dileseydi bunu yapamazlardı. Sen onları ve iftiralarını bir tarafa bırak.","numberInSurah":137,"juz":8,"manzil":2,"page":145,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":927,"text":"\"Bu hayvanlar ve ekinleri dilediğimizden başkasının yemesi yasaktır; bir kısım hayvanların sırtlarına yük vurmak da haramdır\" iddiasında bulunarak ve bir kısım hayvanları keserken de Allah'ın adını anmamak suretiyle O'na iftira ederler. Allah, yaptıkları iftiralara karşı onları cezalandıracaktır.","numberInSurah":138,"juz":8,"manzil":2,"page":146,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":928,"text":"\"Bu hayvanların karınlarında olan yavrular yalnız erkeklerimize mahsus olup, eşlerimize yasaktır. Ölü doğacak olursa hepsi ona ortak olurlar\" dediler. Allah bu türlü sözlerin cezasını verecektir, çünkü O hakimdir, bilendir.","numberInSurah":139,"juz":8,"manzil":2,"page":146,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":929,"text":"Beyinsizlikleri yüzünden, körü körüne çocuklarını öldürenler ve Allah'ın kendilerine verdiği nimetleri Allah'a iftira ederek haram sayanlar mahvolmuşlardır; onlar sapıtmışlardır, zaten doğru yolda da değillerdi.","numberInSurah":140,"juz":8,"manzil":2,"page":146,"ruku":117,"hizbQuarter":58,"sajda":false},{"number":930,"text":"Çardaklı ve çardaksız bağları inşa eden Allah'tır. Tadları çeşitli ekin ve hurmaları, zeytin ve narı birbirine benzer ve benzemez şekilde yaratan O'dur. Ürün verdiği zaman ürününden yiyin, devşirildiği ve biçildiği gün hakkını verin; israf etmeyin, çünkü Allah müsrifleri sevmez.","numberInSurah":141,"juz":8,"manzil":2,"page":146,"ruku":118,"hizbQuarter":59,"sajda":false},{"number":931,"text":"Hayvanları da yük ve kesim için yaratan Allah'tır. Allah'ın size verdiği rızıktan yiyin, şeytana ayak uydurmayın, o size apaçık bir düşmandır.","numberInSurah":142,"juz":8,"manzil":2,"page":146,"ruku":118,"hizbQuarter":59,"sajda":false},{"number":932,"text":"Sekiz çift: Koyundan iki ve keçiden iki; de ki: \"İki erkeği mi, yoksa iki dişiyi mi veya o iki dişinin rahimlerinde bulunan yavruları mı haram kılmıştır? Doğru sözlü iseniz bana bilgiye dayanarak cevap verin.\"","numberInSurah":143,"juz":8,"manzil":2,"page":147,"ruku":118,"hizbQuarter":59,"sajda":false},{"number":933,"text":"Deveden iki, sığırdan iki yaratmıştır; de ki: \"İki erkeği mi, yoksa iki dişiyi mi veya o iki dişinin rahimlerinde bulunan yavruları mı haram kılmıştır? Yoksa Allah size bunları buyururken orada mı idiniz?\" İnsanları, bilmediklerinden sapıtmak için Allah'a karşı yalan uyduranlardan daha zalim kimdir? Allah, zalim milleti doğru yola eriştirmez.","numberInSurah":144,"juz":8,"manzil":2,"page":147,"ruku":118,"hizbQuarter":59,"sajda":false},{"number":934,"text":"De ki: \"Bana vahyolunanda, leş, akıtılmış kan, domuz eti ki pistir ve günah işlenerek Allah'tan başkası adına kesilen hayvandan başkasını yemenin haram olduğuna dair bir emir bulamıyorum; fakat darda kalan, başkasının payına el uzatmamak ve zaruret miktarını aşmamak üzere bunlardan da yiyebilir.\" Doğrusu Rabbin bağışlar ve merhamet eder.","numberInSurah":145,"juz":8,"manzil":2,"page":147,"ruku":119,"hizbQuarter":59,"sajda":false},{"number":935,"text":"Yahudilere tırnaklı her hayvanı haram kıldık. Onlara sığır ve davarın sırt, bağırsak ve kemik yağları hariç, iç yağlarını da haram kıldık. Aşırı gitmelerinden ötürü onları bu şekilde cezalandırdık. Biz şüphesiz doğru sözlüyüzdür.","numberInSurah":146,"juz":8,"manzil":2,"page":147,"ruku":119,"hizbQuarter":59,"sajda":false},{"number":936,"text":"Seni yalanlarlarsa, \"Rabbinizin rahmeti geniştir; O'nun azabı suçlu milletten geri çevrilemez\" de.","numberInSurah":147,"juz":8,"manzil":2,"page":148,"ruku":119,"hizbQuarter":59,"sajda":false},{"number":937,"text":"Puta tapanlar, \"Allah dileseydi babalarımız ve biz puta tapmaz ve hiçbir şeyi haram kılmazdık\" diyecekler; onlardan öncekiler de, Bizim şiddetli azabımızı tadana kadar böyle demişlerdi. Onlara \"Bize karşı çıkarabileceğiniz bir bilginiz var mı? Siz ancak zanna uyuyorsunuz ve sadece tahminde bulunuyorsunuz\" de.","numberInSurah":148,"juz":8,"manzil":2,"page":148,"ruku":119,"hizbQuarter":59,"sajda":false},{"number":938,"text":"\"Üstün delil Allah'ın delilidir. O dileseydi hepinizi doğru yola eriştirirdi\" de.","numberInSurah":149,"juz":8,"manzil":2,"page":148,"ruku":119,"hizbQuarter":59,"sajda":false},{"number":939,"text":"De ki: \"Allah'ın bunu haram kıldığına şahidlik edecek şahidlerinizi getirin\". Şahidlik ederlerse, onlarla beraber olup sözlerini kabullenme; ayetlerimizi yalanlayanların ve ahirete inanmayanların heveslerine uyma; onlar Rablerine başkalarını eşit tutuyorlar.","numberInSurah":150,"juz":8,"manzil":2,"page":148,"ruku":119,"hizbQuarter":59,"sajda":false},{"number":940,"text":"De ki: \"Gelin size Rabbinizin haram kıldığı şeyleri söyleyeyim: O'na hiçbir şeyi ortak koşmayın, anaya babaya iyilik yapın, yoksulluk korkusuyla çocuklarınızı öldürmeyin, sizin ve onların rızkını veren Biziz, gizli ve açık kötülüklere yaklaşmayın, Allah'ın haram kıldığı cana haksız yere kıymayın. Allah bunları size düşünesiniz diye buyurmaktadır.\"","numberInSurah":151,"juz":8,"manzil":2,"page":148,"ruku":120,"hizbQuarter":60,"sajda":false},{"number":941,"text":"Yetim malına, erginlik çağına erişene kadar en iyi şeklin dışında yaklaşmayın; ölçüyü ve tartıyı doğru yapın. Biz kişiye ancak gücünün yeteceği kadar yükleriz. Konuştuğunuzda, akraba bile olsa sözünüzde adil olun. Allah'ın ahdini yerine getirin. Allah size bunları öğüt almanız için buyurmaktadır.","numberInSurah":152,"juz":8,"manzil":2,"page":149,"ruku":120,"hizbQuarter":60,"sajda":false},{"number":942,"text":"Bu, dosdoğru olan yoluma uyun. Sizi Allah yolundan ayrı düşürecek yollara uymayın. Allah size bunları sakınasınız diye buyurmaktadır.","numberInSurah":153,"juz":8,"manzil":2,"page":149,"ruku":120,"hizbQuarter":60,"sajda":false},{"number":943,"text":"Sonra, iyilik işleyenlere nimeti tamamlamak, her şeyi uzun uzadıya açıklamak, doğruyu göstermek ve rahmet olmak üzere Musa'ya Kitap'ı verdik. Rablerine kavuşacaklarına belki artık inanırlar.","numberInSurah":154,"juz":8,"manzil":2,"page":149,"ruku":120,"hizbQuarter":60,"sajda":false},{"number":944,"text":"Bu, indirdiğimiz kutsal Kitap'dır, ona uyun. \"Bizden önce iki topluluğa kitap indirildi, bizim onların okuduklarından haberimiz yok\" demekten veya \"Bize kitap indirilseydi onlardan daha doğru yolda olurduk\" demekten sakının ki merhamet olunasınız. Şüphesiz o, size Rabbinizden belge, yol gösteren ve rahmet olarak gelmiştir. Allah'ın ayetlerini yalanlayandan ve onlardan yüz çevirenden daha zalim kimdir? Ayetlerimizden yüz çevirenleri, yüz çevirmelerinden ötürü, kötü bir azabla cezalandıracağız.","numberInSurah":155,"juz":8,"manzil":2,"page":149,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":945,"text":"Bu, indirdiğimiz kutsal Kitap'dır, ona uyun. \"Bizden önce iki topluluğa kitap indirildi, bizim onların okuduklarından haberimiz yok\" demekten veya \"Bize kitap indirilseydi onlardan daha doğru yolda olurduk\" demekten sakının ki merhamet olunasınız. Şüphesiz o, size Rabbinizden belge, yol gösteren ve rahmet olarak gelmiştir. Allah'ın ayetlerini yalanlayandan ve onlardan yüz çevirenden daha zalim kimdir? Ayetlerimizden yüz çevirenleri, yüz çevirmelerinden ötürü, kötü bir azabla cezalandıracağız.","numberInSurah":156,"juz":8,"manzil":2,"page":149,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":946,"text":"Bu, indirdiğimiz kutsal Kitap'dır, ona uyun. \"Bizden önce iki topluluğa kitap indirildi, bizim onların okuduklarından haberimiz yok\" demekten veya \"Bize kitap indirilseydi onlardan daha doğru yolda olurduk\" demekten sakının ki merhamet olunasınız. Şüphesiz o, size Rabbinizden belge, yol gösteren ve rahmet olarak gelmiştir. Allah'ın ayetlerini yalanlayandan ve onlardan yüz çevirenden daha zalim kimdir? Ayetlerimizden yüz çevirenleri, yüz çevirmelerinden ötürü, kötü bir azabla cezalandıracağız.","numberInSurah":157,"juz":8,"manzil":2,"page":149,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":947,"text":"Onlar kendilerine meleklerin gelmesini mi, yoksa Rabbinin gelmesini mi, yahut Rablerinden bir takım mucizelerin gelmesini mi bekliyorlar? Rabbinin bir takım mucizeleri geldiği gün, bir kimse daha önce inanmamışsa veya imaniyle bir iyilik kazanmamışsa, imanı ona fayda vermez. Onlara: \"Bekleyin, doğrusu biz de bekliyoruz\" de.","numberInSurah":158,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":948,"text":"Fırka fırka olup dinlerini parçalayanlarla senin hiçbir ilişiğin olamaz. Onların işi Allah'a kalmıştır, yaptıklarını onlara sonra bildirecektir.","numberInSurah":159,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":949,"text":"Kim ortaya bir iyilik koyarsa ona on katı verilir; ortaya bir kötülük koyan ise ancak misliyle cezalandırılır; onlara haksızlık yapılmaz.","numberInSurah":160,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":950,"text":"\"Şüphesiz Rabbim beni doğru yola, gerçek dine, doğruya yönelen ve puta tapanlardan olmayan İbrahim'in dinine iletmiştir\" de.","numberInSurah":161,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":951,"text":"De ki: \"Namazım, ibadetlerim, hayatım ve ölümüm, alemlerin Rabbi Allah içindir.","numberInSurah":162,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":952,"text":"O'nun hiçbir ortağı yoktur; böyle emrolundum ve ben Müslümanların ilkiyim.\"","numberInSurah":163,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":953,"text":"De ki: \"Allah her şeyin Rabbi iken O'ndan başka bir rab mi arayayım? Herkesin kazandığı kendisinedir, kimse başkasının yükünü taşımaz; sonunda dönüşünüz Rabbinizedir, ayrılığa düştüğünüz şeyleri size bildirecektir.\"","numberInSurah":164,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false},{"number":954,"text":"Verdikleriyle denemek için sizi yeryüzünün halifeleri kılan ve kiminizi kiminize derecelerle üstün yapan O'dur. Doğrusu Rabbinin cezalandırması süratlidir. Şüphesiz O bağışlar, merhamet eder.","numberInSurah":165,"juz":8,"manzil":2,"page":150,"ruku":121,"hizbQuarter":60,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}