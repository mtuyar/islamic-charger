{"arabic":{"number":2,"name":"سُورَةُ البَقَرَةِ","englishName":"Bakara","englishNameTranslation":"The Cow","revelationType":"Medinan","numberOfAyahs":286,"ayahs":[{"number":8,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الم","numberInSurah":1,"juz":1,"manzil":1,"page":2,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":9,"text":"ذَٰلِكَ الْكِتَابُ لَا رَيْبَ ۛ فِيهِ ۛ هُدًى لِلْمُتَّقِينَ","numberInSurah":2,"juz":1,"manzil":1,"page":2,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":10,"text":"الَّذِينَ يُؤْمِنُونَ بِالْغَيْبِ وَيُقِيمُونَ الصَّلَاةَ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ","numberInSurah":3,"juz":1,"manzil":1,"page":2,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":11,"text":"وَالَّذِينَ يُؤْمِنُونَ بِمَا أُنْزِلَ إِلَيْكَ وَمَا أُنْزِلَ مِنْ قَبْلِكَ وَبِالْآخِرَةِ هُمْ يُوقِنُونَ","numberInSurah":4,"juz":1,"manzil":1,"page":2,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":12,"text":"أُولَٰئِكَ عَلَىٰ هُدًى مِنْ رَبِّهِمْ ۖ وَأُولَٰئِكَ هُمُ الْمُفْلِحُونَ","numberInSurah":5,"juz":1,"manzil":1,"page":2,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":13,"text":"إِنَّ الَّذِينَ كَفَرُوا سَوَاءٌ عَلَيْهِمْ أَأَنْذَرْتَهُمْ أَمْ لَمْ تُنْذِرْهُمْ لَا يُؤْمِنُونَ","numberInSurah":6,"juz":1,"manzil":1,"page":3,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":14,"text":"خَتَمَ اللَّهُ عَلَىٰ قُلُوبِهِمْ وَعَلَىٰ سَمْعِهِمْ ۖ وَعَلَىٰ أَبْصَارِهِمْ غِشَاوَةٌ ۖ وَلَهُمْ عَذَابٌ عَظِيمٌ","numberInSurah":7,"juz":1,"manzil":1,"page":3,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":15,"text":"وَمِنَ النَّاسِ مَنْ يَقُولُ آمَنَّا بِاللَّهِ وَبِالْيَوْمِ الْآخِرِ وَمَا هُمْ بِمُؤْمِنِينَ","numberInSurah":8,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":16,"text":"يُخَادِعُونَ اللَّهَ وَالَّذِينَ آمَنُوا وَمَا يَخْدَعُونَ إِلَّا أَنْفُسَهُمْ وَمَا يَشْعُرُونَ","numberInSurah":9,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":17,"text":"فِي قُلُوبِهِمْ مَرَضٌ فَزَادَهُمُ اللَّهُ مَرَضًا ۖ وَلَهُمْ عَذَابٌ أَلِيمٌ بِمَا كَانُوا يَكْذِبُونَ","numberInSurah":10,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":18,"text":"وَإِذَا قِيلَ لَهُمْ لَا تُفْسِدُوا فِي الْأَرْضِ قَالُوا إِنَّمَا نَحْنُ مُصْلِحُونَ","numberInSurah":11,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":19,"text":"أَلَا إِنَّهُمْ هُمُ الْمُفْسِدُونَ وَلَٰكِنْ لَا يَشْعُرُونَ","numberInSurah":12,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":20,"text":"وَإِذَا قِيلَ لَهُمْ آمِنُوا كَمَا آمَنَ النَّاسُ قَالُوا أَنُؤْمِنُ كَمَا آمَنَ السُّفَهَاءُ ۗ أَلَا إِنَّهُمْ هُمُ السُّفَهَاءُ وَلَٰكِنْ لَا يَعْلَمُونَ","numberInSurah":13,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":21,"text":"وَإِذَا لَقُوا الَّذِينَ آمَنُوا قَالُوا آمَنَّا وَإِذَا خَلَوْا إِلَىٰ شَيَاطِينِهِمْ قَالُوا إِنَّا مَعَكُمْ إِنَّمَا نَحْنُ مُسْتَهْزِئُونَ","numberInSurah":14,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":22,"text":"اللَّهُ يَسْتَهْزِئُ بِهِمْ وَيَمُدُّهُمْ فِي طُغْيَانِهِمْ يَعْمَهُونَ","numberInSurah":15,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":23,"text":"أُولَٰئِكَ الَّذِينَ اشْتَرَوُا الضَّلَالَةَ بِالْهُدَىٰ فَمَا رَبِحَتْ تِجَارَتُهُمْ وَمَا كَانُوا مُهْتَدِينَ","numberInSurah":16,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":24,"text":"مَثَلُهُمْ كَمَثَلِ الَّذِي اسْتَوْقَدَ نَارًا فَلَمَّا أَضَاءَتْ مَا حَوْلَهُ ذَهَبَ اللَّهُ بِنُورِهِمْ وَتَرَكَهُمْ فِي ظُلُمَاتٍ لَا يُبْصِرُونَ","numberInSurah":17,"juz":1,"manzil":1,"page":4,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":25,"text":"صُمٌّ بُكْمٌ عُمْيٌ فَهُمْ لَا يَرْجِعُونَ","numberInSurah":18,"juz":1,"manzil":1,"page":4,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":26,"text":"أَوْ كَصَيِّبٍ مِنَ السَّمَاءِ فِيهِ ظُلُمَاتٌ وَرَعْدٌ وَبَرْقٌ يَجْعَلُونَ أَصَابِعَهُمْ فِي آذَانِهِمْ مِنَ الصَّوَاعِقِ حَذَرَ الْمَوْتِ ۚ وَاللَّهُ مُحِيطٌ بِالْكَافِرِينَ","numberInSurah":19,"juz":1,"manzil":1,"page":4,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":27,"text":"يَكَادُ الْبَرْقُ يَخْطَفُ أَبْصَارَهُمْ ۖ كُلَّمَا أَضَاءَ لَهُمْ مَشَوْا فِيهِ وَإِذَا أَظْلَمَ عَلَيْهِمْ قَامُوا ۚ وَلَوْ شَاءَ اللَّهُ لَذَهَبَ بِسَمْعِهِمْ وَأَبْصَارِهِمْ ۚ إِنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":20,"juz":1,"manzil":1,"page":4,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":28,"text":"يَا أَيُّهَا النَّاسُ اعْبُدُوا رَبَّكُمُ الَّذِي خَلَقَكُمْ وَالَّذِينَ مِنْ قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ","numberInSurah":21,"juz":1,"manzil":1,"page":4,"ruku":4,"hizbQuarter":1,"sajda":false},{"number":29,"text":"الَّذِي جَعَلَ لَكُمُ الْأَرْضَ فِرَاشًا وَالسَّمَاءَ بِنَاءً وَأَنْزَلَ مِنَ السَّمَاءِ مَاءً فَأَخْرَجَ بِهِ مِنَ الثَّمَرَاتِ رِزْقًا لَكُمْ ۖ فَلَا تَجْعَلُوا لِلَّهِ أَنْدَادًا وَأَنْتُمْ تَعْلَمُونَ","numberInSurah":22,"juz":1,"manzil":1,"page":4,"ruku":4,"hizbQuarter":1,"sajda":false},{"number":30,"text":"وَإِنْ كُنْتُمْ فِي رَيْبٍ مِمَّا نَزَّلْنَا عَلَىٰ عَبْدِنَا فَأْتُوا بِسُورَةٍ مِنْ مِثْلِهِ وَادْعُوا شُهَدَاءَكُمْ مِنْ دُونِ اللَّهِ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":23,"juz":1,"manzil":1,"page":4,"ruku":4,"hizbQuarter":1,"sajda":false},{"number":31,"text":"فَإِنْ لَمْ تَفْعَلُوا وَلَنْ تَفْعَلُوا فَاتَّقُوا النَّارَ الَّتِي وَقُودُهَا النَّاسُ وَالْحِجَارَةُ ۖ أُعِدَّتْ لِلْكَافِرِينَ","numberInSurah":24,"juz":1,"manzil":1,"page":4,"ruku":4,"hizbQuarter":1,"sajda":false},{"number":32,"text":"وَبَشِّرِ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ أَنَّ لَهُمْ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ ۖ كُلَّمَا رُزِقُوا مِنْهَا مِنْ ثَمَرَةٍ رِزْقًا ۙ قَالُوا هَٰذَا الَّذِي رُزِقْنَا مِنْ قَبْلُ ۖ وَأُتُوا بِهِ مُتَشَابِهًا ۖ وَلَهُمْ فِيهَا أَزْوَاجٌ مُطَهَّرَةٌ ۖ وَهُمْ فِيهَا خَالِدُونَ","numberInSurah":25,"juz":1,"manzil":1,"page":5,"ruku":4,"hizbQuarter":1,"sajda":false},{"number":33,"text":"۞ إِنَّ اللَّهَ لَا يَسْتَحْيِي أَنْ يَضْرِبَ مَثَلًا مَا بَعُوضَةً فَمَا فَوْقَهَا ۚ فَأَمَّا الَّذِينَ آمَنُوا فَيَعْلَمُونَ أَنَّهُ الْحَقُّ مِنْ رَبِّهِمْ ۖ وَأَمَّا الَّذِينَ كَفَرُوا فَيَقُولُونَ مَاذَا أَرَادَ اللَّهُ بِهَٰذَا مَثَلًا ۘ يُضِلُّ بِهِ كَثِيرًا وَيَهْدِي بِهِ كَثِيرًا ۚ وَمَا يُضِلُّ بِهِ إِلَّا الْفَاسِقِينَ","numberInSurah":26,"juz":1,"manzil":1,"page":5,"ruku":4,"hizbQuarter":2,"sajda":false},{"number":34,"text":"الَّذِينَ يَنْقُضُونَ عَهْدَ اللَّهِ مِنْ بَعْدِ مِيثَاقِهِ وَيَقْطَعُونَ مَا أَمَرَ اللَّهُ بِهِ أَنْ يُوصَلَ وَيُفْسِدُونَ فِي الْأَرْضِ ۚ أُولَٰئِكَ هُمُ الْخَاسِرُونَ","numberInSurah":27,"juz":1,"manzil":1,"page":5,"ruku":4,"hizbQuarter":2,"sajda":false},{"number":35,"text":"كَيْفَ تَكْفُرُونَ بِاللَّهِ وَكُنْتُمْ أَمْوَاتًا فَأَحْيَاكُمْ ۖ ثُمَّ يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ ثُمَّ إِلَيْهِ تُرْجَعُونَ","numberInSurah":28,"juz":1,"manzil":1,"page":5,"ruku":4,"hizbQuarter":2,"sajda":false},{"number":36,"text":"هُوَ الَّذِي خَلَقَ لَكُمْ مَا فِي الْأَرْضِ جَمِيعًا ثُمَّ اسْتَوَىٰ إِلَى السَّمَاءِ فَسَوَّاهُنَّ سَبْعَ سَمَاوَاتٍ ۚ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ","numberInSurah":29,"juz":1,"manzil":1,"page":5,"ruku":4,"hizbQuarter":2,"sajda":false},{"number":37,"text":"وَإِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي جَاعِلٌ فِي الْأَرْضِ خَلِيفَةً ۖ قَالُوا أَتَجْعَلُ فِيهَا مَنْ يُفْسِدُ فِيهَا وَيَسْفِكُ الدِّمَاءَ وَنَحْنُ نُسَبِّحُ بِحَمْدِكَ وَنُقَدِّسُ لَكَ ۖ قَالَ إِنِّي أَعْلَمُ مَا لَا تَعْلَمُونَ","numberInSurah":30,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":38,"text":"وَعَلَّمَ آدَمَ الْأَسْمَاءَ كُلَّهَا ثُمَّ عَرَضَهُمْ عَلَى الْمَلَائِكَةِ فَقَالَ أَنْبِئُونِي بِأَسْمَاءِ هَٰؤُلَاءِ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":31,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":39,"text":"قَالُوا سُبْحَانَكَ لَا عِلْمَ لَنَا إِلَّا مَا عَلَّمْتَنَا ۖ إِنَّكَ أَنْتَ الْعَلِيمُ الْحَكِيمُ","numberInSurah":32,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":40,"text":"قَالَ يَا آدَمُ أَنْبِئْهُمْ بِأَسْمَائِهِمْ ۖ فَلَمَّا أَنْبَأَهُمْ بِأَسْمَائِهِمْ قَالَ أَلَمْ أَقُلْ لَكُمْ إِنِّي أَعْلَمُ غَيْبَ السَّمَاوَاتِ وَالْأَرْضِ وَأَعْلَمُ مَا تُبْدُونَ وَمَا كُنْتُمْ تَكْتُمُونَ","numberInSurah":33,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":41,"text":"وَإِذْ قُلْنَا لِلْمَلَائِكَةِ اسْجُدُوا لِآدَمَ فَسَجَدُوا إِلَّا إِبْلِيسَ أَبَىٰ وَاسْتَكْبَرَ وَكَانَ مِنَ الْكَافِرِينَ","numberInSurah":34,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":42,"text":"وَقُلْنَا يَا آدَمُ اسْكُنْ أَنْتَ وَزَوْجُكَ الْجَنَّةَ وَكُلَا مِنْهَا رَغَدًا حَيْثُ شِئْتُمَا وَلَا تَقْرَبَا هَٰذِهِ الشَّجَرَةَ فَتَكُونَا مِنَ الظَّالِمِينَ","numberInSurah":35,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":43,"text":"فَأَزَلَّهُمَا الشَّيْطَانُ عَنْهَا فَأَخْرَجَهُمَا مِمَّا كَانَا فِيهِ ۖ وَقُلْنَا اهْبِطُوا بَعْضُكُمْ لِبَعْضٍ عَدُوٌّ ۖ وَلَكُمْ فِي الْأَرْضِ مُسْتَقَرٌّ وَمَتَاعٌ إِلَىٰ حِينٍ","numberInSurah":36,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":44,"text":"فَتَلَقَّىٰ آدَمُ مِنْ رَبِّهِ كَلِمَاتٍ فَتَابَ عَلَيْهِ ۚ إِنَّهُ هُوَ التَّوَّابُ الرَّحِيمُ","numberInSurah":37,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":45,"text":"قُلْنَا اهْبِطُوا مِنْهَا جَمِيعًا ۖ فَإِمَّا يَأْتِيَنَّكُمْ مِنِّي هُدًى فَمَنْ تَبِعَ هُدَايَ فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ","numberInSurah":38,"juz":1,"manzil":1,"page":7,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":46,"text":"وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَٰئِكَ أَصْحَابُ النَّارِ ۖ هُمْ فِيهَا خَالِدُونَ","numberInSurah":39,"juz":1,"manzil":1,"page":7,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":47,"text":"يَا بَنِي إِسْرَائِيلَ اذْكُرُوا نِعْمَتِيَ الَّتِي أَنْعَمْتُ عَلَيْكُمْ وَأَوْفُوا بِعَهْدِي أُوفِ بِعَهْدِكُمْ وَإِيَّايَ فَارْهَبُونِ","numberInSurah":40,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":2,"sajda":false},{"number":48,"text":"وَآمِنُوا بِمَا أَنْزَلْتُ مُصَدِّقًا لِمَا مَعَكُمْ وَلَا تَكُونُوا أَوَّلَ كَافِرٍ بِهِ ۖ وَلَا تَشْتَرُوا بِآيَاتِي ثَمَنًا قَلِيلًا وَإِيَّايَ فَاتَّقُونِ","numberInSurah":41,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":2,"sajda":false},{"number":49,"text":"وَلَا تَلْبِسُوا الْحَقَّ بِالْبَاطِلِ وَتَكْتُمُوا الْحَقَّ وَأَنْتُمْ تَعْلَمُونَ","numberInSurah":42,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":2,"sajda":false},{"number":50,"text":"وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَارْكَعُوا مَعَ الرَّاكِعِينَ","numberInSurah":43,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":2,"sajda":false},{"number":51,"text":"۞ أَتَأْمُرُونَ النَّاسَ بِالْبِرِّ وَتَنْسَوْنَ أَنْفُسَكُمْ وَأَنْتُمْ تَتْلُونَ الْكِتَابَ ۚ أَفَلَا تَعْقِلُونَ","numberInSurah":44,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":3,"sajda":false},{"number":52,"text":"وَاسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ ۚ وَإِنَّهَا لَكَبِيرَةٌ إِلَّا عَلَى الْخَاشِعِينَ","numberInSurah":45,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":3,"sajda":false},{"number":53,"text":"الَّذِينَ يَظُنُّونَ أَنَّهُمْ مُلَاقُو رَبِّهِمْ وَأَنَّهُمْ إِلَيْهِ رَاجِعُونَ","numberInSurah":46,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":3,"sajda":false},{"number":54,"text":"يَا بَنِي إِسْرَائِيلَ اذْكُرُوا نِعْمَتِيَ الَّتِي أَنْعَمْتُ عَلَيْكُمْ وَأَنِّي فَضَّلْتُكُمْ عَلَى الْعَالَمِينَ","numberInSurah":47,"juz":1,"manzil":1,"page":7,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":55,"text":"وَاتَّقُوا يَوْمًا لَا تَجْزِي نَفْسٌ عَنْ نَفْسٍ شَيْئًا وَلَا يُقْبَلُ مِنْهَا شَفَاعَةٌ وَلَا يُؤْخَذُ مِنْهَا عَدْلٌ وَلَا هُمْ يُنْصَرُونَ","numberInSurah":48,"juz":1,"manzil":1,"page":7,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":56,"text":"وَإِذْ نَجَّيْنَاكُمْ مِنْ آلِ فِرْعَوْنَ يَسُومُونَكُمْ سُوءَ الْعَذَابِ يُذَبِّحُونَ أَبْنَاءَكُمْ وَيَسْتَحْيُونَ نِسَاءَكُمْ ۚ وَفِي ذَٰلِكُمْ بَلَاءٌ مِنْ رَبِّكُمْ عَظِيمٌ","numberInSurah":49,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":57,"text":"وَإِذْ فَرَقْنَا بِكُمُ الْبَحْرَ فَأَنْجَيْنَاكُمْ وَأَغْرَقْنَا آلَ فِرْعَوْنَ وَأَنْتُمْ تَنْظُرُونَ","numberInSurah":50,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":58,"text":"وَإِذْ وَاعَدْنَا مُوسَىٰ أَرْبَعِينَ لَيْلَةً ثُمَّ اتَّخَذْتُمُ الْعِجْلَ مِنْ بَعْدِهِ وَأَنْتُمْ ظَالِمُونَ","numberInSurah":51,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":59,"text":"ثُمَّ عَفَوْنَا عَنْكُمْ مِنْ بَعْدِ ذَٰلِكَ لَعَلَّكُمْ تَشْكُرُونَ","numberInSurah":52,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":60,"text":"وَإِذْ آتَيْنَا مُوسَى الْكِتَابَ وَالْفُرْقَانَ لَعَلَّكُمْ تَهْتَدُونَ","numberInSurah":53,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":61,"text":"وَإِذْ قَالَ مُوسَىٰ لِقَوْمِهِ يَا قَوْمِ إِنَّكُمْ ظَلَمْتُمْ أَنْفُسَكُمْ بِاتِّخَاذِكُمُ الْعِجْلَ فَتُوبُوا إِلَىٰ بَارِئِكُمْ فَاقْتُلُوا أَنْفُسَكُمْ ذَٰلِكُمْ خَيْرٌ لَكُمْ عِنْدَ بَارِئِكُمْ فَتَابَ عَلَيْكُمْ ۚ إِنَّهُ هُوَ التَّوَّابُ الرَّحِيمُ","numberInSurah":54,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":62,"text":"وَإِذْ قُلْتُمْ يَا مُوسَىٰ لَنْ نُؤْمِنَ لَكَ حَتَّىٰ نَرَى اللَّهَ جَهْرَةً فَأَخَذَتْكُمُ الصَّاعِقَةُ وَأَنْتُمْ تَنْظُرُونَ","numberInSurah":55,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":63,"text":"ثُمَّ بَعَثْنَاكُمْ مِنْ بَعْدِ مَوْتِكُمْ لَعَلَّكُمْ تَشْكُرُونَ","numberInSurah":56,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":64,"text":"وَظَلَّلْنَا عَلَيْكُمُ الْغَمَامَ وَأَنْزَلْنَا عَلَيْكُمُ الْمَنَّ وَالسَّلْوَىٰ ۖ كُلُوا مِنْ طَيِّبَاتِ مَا رَزَقْنَاكُمْ ۖ وَمَا ظَلَمُونَا وَلَٰكِنْ كَانُوا أَنْفُسَهُمْ يَظْلِمُونَ","numberInSurah":57,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":65,"text":"وَإِذْ قُلْنَا ادْخُلُوا هَٰذِهِ الْقَرْيَةَ فَكُلُوا مِنْهَا حَيْثُ شِئْتُمْ رَغَدًا وَادْخُلُوا الْبَابَ سُجَّدًا وَقُولُوا حِطَّةٌ نَغْفِرْ لَكُمْ خَطَايَاكُمْ ۚ وَسَنَزِيدُ الْمُحْسِنِينَ","numberInSurah":58,"juz":1,"manzil":1,"page":9,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":66,"text":"فَبَدَّلَ الَّذِينَ ظَلَمُوا قَوْلًا غَيْرَ الَّذِي قِيلَ لَهُمْ فَأَنْزَلْنَا عَلَى الَّذِينَ ظَلَمُوا رِجْزًا مِنَ السَّمَاءِ بِمَا كَانُوا يَفْسُقُونَ","numberInSurah":59,"juz":1,"manzil":1,"page":9,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":67,"text":"۞ وَإِذِ اسْتَسْقَىٰ مُوسَىٰ لِقَوْمِهِ فَقُلْنَا اضْرِبْ بِعَصَاكَ الْحَجَرَ ۖ فَانْفَجَرَتْ مِنْهُ اثْنَتَا عَشْرَةَ عَيْنًا ۖ قَدْ عَلِمَ كُلُّ أُنَاسٍ مَشْرَبَهُمْ ۖ كُلُوا وَاشْرَبُوا مِنْ رِزْقِ اللَّهِ وَلَا تَعْثَوْا فِي الْأَرْضِ مُفْسِدِينَ","numberInSurah":60,"juz":1,"manzil":1,"page":9,"ruku":8,"hizbQuarter":4,"sajda":false},{"number":68,"text":"وَإِذْ قُلْتُمْ يَا مُوسَىٰ لَنْ نَصْبِرَ عَلَىٰ طَعَامٍ وَاحِدٍ فَادْعُ لَنَا رَبَّكَ يُخْرِجْ لَنَا مِمَّا تُنْبِتُ الْأَرْضُ مِنْ بَقْلِهَا وَقِثَّائِهَا وَفُومِهَا وَعَدَسِهَا وَبَصَلِهَا ۖ قَالَ أَتَسْتَبْدِلُونَ الَّذِي هُوَ أَدْنَىٰ بِالَّذِي هُوَ خَيْرٌ ۚ اهْبِطُوا مِصْرًا فَإِنَّ لَكُمْ مَا سَأَلْتُمْ ۗ وَضُرِبَتْ عَلَيْهِمُ الذِّلَّةُ وَالْمَسْكَنَةُ وَبَاءُوا بِغَضَبٍ مِنَ اللَّهِ ۗ ذَٰلِكَ بِأَنَّهُمْ كَانُوا يَكْفُرُونَ بِآيَاتِ اللَّهِ وَيَقْتُلُونَ النَّبِيِّينَ بِغَيْرِ الْحَقِّ ۗ ذَٰلِكَ بِمَا عَصَوْا وَكَانُوا يَعْتَدُونَ","numberInSurah":61,"juz":1,"manzil":1,"page":9,"ruku":8,"hizbQuarter":4,"sajda":false},{"number":69,"text":"إِنَّ الَّذِينَ آمَنُوا وَالَّذِينَ هَادُوا وَالنَّصَارَىٰ وَالصَّابِئِينَ مَنْ آمَنَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَعَمِلَ صَالِحًا فَلَهُمْ أَجْرُهُمْ عِنْدَ رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ","numberInSurah":62,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":70,"text":"وَإِذْ أَخَذْنَا مِيثَاقَكُمْ وَرَفَعْنَا فَوْقَكُمُ الطُّورَ خُذُوا مَا آتَيْنَاكُمْ بِقُوَّةٍ وَاذْكُرُوا مَا فِيهِ لَعَلَّكُمْ تَتَّقُونَ","numberInSurah":63,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":71,"text":"ثُمَّ تَوَلَّيْتُمْ مِنْ بَعْدِ ذَٰلِكَ ۖ فَلَوْلَا فَضْلُ اللَّهِ عَلَيْكُمْ وَرَحْمَتُهُ لَكُنْتُمْ مِنَ الْخَاسِرِينَ","numberInSurah":64,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":72,"text":"وَلَقَدْ عَلِمْتُمُ الَّذِينَ اعْتَدَوْا مِنْكُمْ فِي السَّبْتِ فَقُلْنَا لَهُمْ كُونُوا قِرَدَةً خَاسِئِينَ","numberInSurah":65,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":73,"text":"فَجَعَلْنَاهَا نَكَالًا لِمَا بَيْنَ يَدَيْهَا وَمَا خَلْفَهَا وَمَوْعِظَةً لِلْمُتَّقِينَ","numberInSurah":66,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":74,"text":"وَإِذْ قَالَ مُوسَىٰ لِقَوْمِهِ إِنَّ اللَّهَ يَأْمُرُكُمْ أَنْ تَذْبَحُوا بَقَرَةً ۖ قَالُوا أَتَتَّخِذُنَا هُزُوًا ۖ قَالَ أَعُوذُ بِاللَّهِ أَنْ أَكُونَ مِنَ الْجَاهِلِينَ","numberInSurah":67,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":75,"text":"قَالُوا ادْعُ لَنَا رَبَّكَ يُبَيِّنْ لَنَا مَا هِيَ ۚ قَالَ إِنَّهُ يَقُولُ إِنَّهَا بَقَرَةٌ لَا فَارِضٌ وَلَا بِكْرٌ عَوَانٌ بَيْنَ ذَٰلِكَ ۖ فَافْعَلُوا مَا تُؤْمَرُونَ","numberInSurah":68,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":76,"text":"قَالُوا ادْعُ لَنَا رَبَّكَ يُبَيِّنْ لَنَا مَا لَوْنُهَا ۚ قَالَ إِنَّهُ يَقُولُ إِنَّهَا بَقَرَةٌ صَفْرَاءُ فَاقِعٌ لَوْنُهَا تَسُرُّ النَّاظِرِينَ","numberInSurah":69,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":77,"text":"قَالُوا ادْعُ لَنَا رَبَّكَ يُبَيِّنْ لَنَا مَا هِيَ إِنَّ الْبَقَرَ تَشَابَهَ عَلَيْنَا وَإِنَّا إِنْ شَاءَ اللَّهُ لَمُهْتَدُونَ","numberInSurah":70,"juz":1,"manzil":1,"page":11,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":78,"text":"قَالَ إِنَّهُ يَقُولُ إِنَّهَا بَقَرَةٌ لَا ذَلُولٌ تُثِيرُ الْأَرْضَ وَلَا تَسْقِي الْحَرْثَ مُسَلَّمَةٌ لَا شِيَةَ فِيهَا ۚ قَالُوا الْآنَ جِئْتَ بِالْحَقِّ ۚ فَذَبَحُوهَا وَمَا كَادُوا يَفْعَلُونَ","numberInSurah":71,"juz":1,"manzil":1,"page":11,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":79,"text":"وَإِذْ قَتَلْتُمْ نَفْسًا فَادَّارَأْتُمْ فِيهَا ۖ وَاللَّهُ مُخْرِجٌ مَا كُنْتُمْ تَكْتُمُونَ","numberInSurah":72,"juz":1,"manzil":1,"page":11,"ruku":10,"hizbQuarter":4,"sajda":false},{"number":80,"text":"فَقُلْنَا اضْرِبُوهُ بِبَعْضِهَا ۚ كَذَٰلِكَ يُحْيِي اللَّهُ الْمَوْتَىٰ وَيُرِيكُمْ آيَاتِهِ لَعَلَّكُمْ تَعْقِلُونَ","numberInSurah":73,"juz":1,"manzil":1,"page":11,"ruku":10,"hizbQuarter":4,"sajda":false},{"number":81,"text":"ثُمَّ قَسَتْ قُلُوبُكُمْ مِنْ بَعْدِ ذَٰلِكَ فَهِيَ كَالْحِجَارَةِ أَوْ أَشَدُّ قَسْوَةً ۚ وَإِنَّ مِنَ الْحِجَارَةِ لَمَا يَتَفَجَّرُ مِنْهُ الْأَنْهَارُ ۚ وَإِنَّ مِنْهَا لَمَا يَشَّقَّقُ فَيَخْرُجُ مِنْهُ الْمَاءُ ۚ وَإِنَّ مِنْهَا لَمَا يَهْبِطُ مِنْ خَشْيَةِ اللَّهِ ۗ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ","numberInSurah":74,"juz":1,"manzil":1,"page":11,"ruku":10,"hizbQuarter":4,"sajda":false},{"number":82,"text":"۞ أَفَتَطْمَعُونَ أَنْ يُؤْمِنُوا لَكُمْ وَقَدْ كَانَ فَرِيقٌ مِنْهُمْ يَسْمَعُونَ كَلَامَ اللَّهِ ثُمَّ يُحَرِّفُونَهُ مِنْ بَعْدِ مَا عَقَلُوهُ وَهُمْ يَعْلَمُونَ","numberInSurah":75,"juz":1,"manzil":1,"page":11,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":83,"text":"وَإِذَا لَقُوا الَّذِينَ آمَنُوا قَالُوا آمَنَّا وَإِذَا خَلَا بَعْضُهُمْ إِلَىٰ بَعْضٍ قَالُوا أَتُحَدِّثُونَهُمْ بِمَا فَتَحَ اللَّهُ عَلَيْكُمْ لِيُحَاجُّوكُمْ بِهِ عِنْدَ رَبِّكُمْ ۚ أَفَلَا تَعْقِلُونَ","numberInSurah":76,"juz":1,"manzil":1,"page":11,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":84,"text":"أَوَلَا يَعْلَمُونَ أَنَّ اللَّهَ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ","numberInSurah":77,"juz":1,"manzil":1,"page":12,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":85,"text":"وَمِنْهُمْ أُمِّيُّونَ لَا يَعْلَمُونَ الْكِتَابَ إِلَّا أَمَانِيَّ وَإِنْ هُمْ إِلَّا يَظُنُّونَ","numberInSurah":78,"juz":1,"manzil":1,"page":12,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":86,"text":"فَوَيْلٌ لِلَّذِينَ يَكْتُبُونَ الْكِتَابَ بِأَيْدِيهِمْ ثُمَّ يَقُولُونَ هَٰذَا مِنْ عِنْدِ اللَّهِ لِيَشْتَرُوا بِهِ ثَمَنًا قَلِيلًا ۖ فَوَيْلٌ لَهُمْ مِمَّا كَتَبَتْ أَيْدِيهِمْ وَوَيْلٌ لَهُمْ مِمَّا يَكْسِبُونَ","numberInSurah":79,"juz":1,"manzil":1,"page":12,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":87,"text":"وَقَالُوا لَنْ تَمَسَّنَا النَّارُ إِلَّا أَيَّامًا مَعْدُودَةً ۚ قُلْ أَتَّخَذْتُمْ عِنْدَ اللَّهِ عَهْدًا فَلَنْ يُخْلِفَ اللَّهُ عَهْدَهُ ۖ أَمْ تَقُولُونَ عَلَى اللَّهِ مَا لَا تَعْلَمُونَ","numberInSurah":80,"juz":1,"manzil":1,"page":12,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":88,"text":"بَلَىٰ مَنْ كَسَبَ سَيِّئَةً وَأَحَاطَتْ بِهِ خَطِيئَتُهُ فَأُولَٰئِكَ أَصْحَابُ النَّارِ ۖ هُمْ فِيهَا خَالِدُونَ","numberInSurah":81,"juz":1,"manzil":1,"page":12,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":89,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ أُولَٰئِكَ أَصْحَابُ الْجَنَّةِ ۖ هُمْ فِيهَا خَالِدُونَ","numberInSurah":82,"juz":1,"manzil":1,"page":12,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":90,"text":"وَإِذْ أَخَذْنَا مِيثَاقَ بَنِي إِسْرَائِيلَ لَا تَعْبُدُونَ إِلَّا اللَّهَ وَبِالْوَالِدَيْنِ إِحْسَانًا وَذِي الْقُرْبَىٰ وَالْيَتَامَىٰ وَالْمَسَاكِينِ وَقُولُوا لِلنَّاسِ حُسْنًا وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ ثُمَّ تَوَلَّيْتُمْ إِلَّا قَلِيلًا مِنْكُمْ وَأَنْتُمْ مُعْرِضُونَ","numberInSurah":83,"juz":1,"manzil":1,"page":12,"ruku":11,"hizbQuarter":5,"sajda":false},{"number":91,"text":"وَإِذْ أَخَذْنَا مِيثَاقَكُمْ لَا تَسْفِكُونَ دِمَاءَكُمْ وَلَا تُخْرِجُونَ أَنْفُسَكُمْ مِنْ دِيَارِكُمْ ثُمَّ أَقْرَرْتُمْ وَأَنْتُمْ تَشْهَدُونَ","numberInSurah":84,"juz":1,"manzil":1,"page":13,"ruku":11,"hizbQuarter":5,"sajda":false},{"number":92,"text":"ثُمَّ أَنْتُمْ هَٰؤُلَاءِ تَقْتُلُونَ أَنْفُسَكُمْ وَتُخْرِجُونَ فَرِيقًا مِنْكُمْ مِنْ دِيَارِهِمْ تَظَاهَرُونَ عَلَيْهِمْ بِالْإِثْمِ وَالْعُدْوَانِ وَإِنْ يَأْتُوكُمْ أُسَارَىٰ تُفَادُوهُمْ وَهُوَ مُحَرَّمٌ عَلَيْكُمْ إِخْرَاجُهُمْ ۚ أَفَتُؤْمِنُونَ بِبَعْضِ الْكِتَابِ وَتَكْفُرُونَ بِبَعْضٍ ۚ فَمَا جَزَاءُ مَنْ يَفْعَلُ ذَٰلِكَ مِنْكُمْ إِلَّا خِزْيٌ فِي الْحَيَاةِ الدُّنْيَا ۖ وَيَوْمَ الْقِيَامَةِ يُرَدُّونَ إِلَىٰ أَشَدِّ الْعَذَابِ ۗ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ","numberInSurah":85,"juz":1,"manzil":1,"page":13,"ruku":11,"hizbQuarter":5,"sajda":false},{"number":93,"text":"أُولَٰئِكَ الَّذِينَ اشْتَرَوُا الْحَيَاةَ الدُّنْيَا بِالْآخِرَةِ ۖ فَلَا يُخَفَّفُ عَنْهُمُ الْعَذَابُ وَلَا هُمْ يُنْصَرُونَ","numberInSurah":86,"juz":1,"manzil":1,"page":13,"ruku":11,"hizbQuarter":5,"sajda":false},{"number":94,"text":"وَلَقَدْ آتَيْنَا مُوسَى الْكِتَابَ وَقَفَّيْنَا مِنْ بَعْدِهِ بِالرُّسُلِ ۖ وَآتَيْنَا عِيسَى ابْنَ مَرْيَمَ الْبَيِّنَاتِ وَأَيَّدْنَاهُ بِرُوحِ الْقُدُسِ ۗ أَفَكُلَّمَا جَاءَكُمْ رَسُولٌ بِمَا لَا تَهْوَىٰ أَنْفُسُكُمُ اسْتَكْبَرْتُمْ فَفَرِيقًا كَذَّبْتُمْ وَفَرِيقًا تَقْتُلُونَ","numberInSurah":87,"juz":1,"manzil":1,"page":13,"ruku":12,"hizbQuarter":5,"sajda":false},{"number":95,"text":"وَقَالُوا قُلُوبُنَا غُلْفٌ ۚ بَلْ لَعَنَهُمُ اللَّهُ بِكُفْرِهِمْ فَقَلِيلًا مَا يُؤْمِنُونَ","numberInSurah":88,"juz":1,"manzil":1,"page":13,"ruku":12,"hizbQuarter":5,"sajda":false},{"number":96,"text":"وَلَمَّا جَاءَهُمْ كِتَابٌ مِنْ عِنْدِ اللَّهِ مُصَدِّقٌ لِمَا مَعَهُمْ وَكَانُوا مِنْ قَبْلُ يَسْتَفْتِحُونَ عَلَى الَّذِينَ كَفَرُوا فَلَمَّا جَاءَهُمْ مَا عَرَفُوا كَفَرُوا بِهِ ۚ فَلَعْنَةُ اللَّهِ عَلَى الْكَافِرِينَ","numberInSurah":89,"juz":1,"manzil":1,"page":14,"ruku":12,"hizbQuarter":5,"sajda":false},{"number":97,"text":"بِئْسَمَا اشْتَرَوْا بِهِ أَنْفُسَهُمْ أَنْ يَكْفُرُوا بِمَا أَنْزَلَ اللَّهُ بَغْيًا أَنْ يُنَزِّلَ اللَّهُ مِنْ فَضْلِهِ عَلَىٰ مَنْ يَشَاءُ مِنْ عِبَادِهِ ۖ فَبَاءُوا بِغَضَبٍ عَلَىٰ غَضَبٍ ۚ وَلِلْكَافِرِينَ عَذَابٌ مُهِينٌ","numberInSurah":90,"juz":1,"manzil":1,"page":14,"ruku":12,"hizbQuarter":5,"sajda":false},{"number":98,"text":"وَإِذَا قِيلَ لَهُمْ آمِنُوا بِمَا أَنْزَلَ اللَّهُ قَالُوا نُؤْمِنُ بِمَا أُنْزِلَ عَلَيْنَا وَيَكْفُرُونَ بِمَا وَرَاءَهُ وَهُوَ الْحَقُّ مُصَدِّقًا لِمَا مَعَهُمْ ۗ قُلْ فَلِمَ تَقْتُلُونَ أَنْبِيَاءَ اللَّهِ مِنْ قَبْلُ إِنْ كُنْتُمْ مُؤْمِنِينَ","numberInSurah":91,"juz":1,"manzil":1,"page":14,"ruku":12,"hizbQuarter":5,"sajda":false},{"number":99,"text":"۞ وَلَقَدْ جَاءَكُمْ مُوسَىٰ بِالْبَيِّنَاتِ ثُمَّ اتَّخَذْتُمُ الْعِجْلَ مِنْ بَعْدِهِ وَأَنْتُمْ ظَالِمُونَ","numberInSurah":92,"juz":1,"manzil":1,"page":14,"ruku":12,"hizbQuarter":6,"sajda":false},{"number":100,"text":"وَإِذْ أَخَذْنَا مِيثَاقَكُمْ وَرَفَعْنَا فَوْقَكُمُ الطُّورَ خُذُوا مَا آتَيْنَاكُمْ بِقُوَّةٍ وَاسْمَعُوا ۖ قَالُوا سَمِعْنَا وَعَصَيْنَا وَأُشْرِبُوا فِي قُلُوبِهِمُ الْعِجْلَ بِكُفْرِهِمْ ۚ قُلْ بِئْسَمَا يَأْمُرُكُمْ بِهِ إِيمَانُكُمْ إِنْ كُنْتُمْ مُؤْمِنِينَ","numberInSurah":93,"juz":1,"manzil":1,"page":14,"ruku":12,"hizbQuarter":6,"sajda":false},{"number":101,"text":"قُلْ إِنْ كَانَتْ لَكُمُ الدَّارُ الْآخِرَةُ عِنْدَ اللَّهِ خَالِصَةً مِنْ دُونِ النَّاسِ فَتَمَنَّوُا الْمَوْتَ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":94,"juz":1,"manzil":1,"page":15,"ruku":12,"hizbQuarter":6,"sajda":false},{"number":102,"text":"وَلَنْ يَتَمَنَّوْهُ أَبَدًا بِمَا قَدَّمَتْ أَيْدِيهِمْ ۗ وَاللَّهُ عَلِيمٌ بِالظَّالِمِينَ","numberInSurah":95,"juz":1,"manzil":1,"page":15,"ruku":12,"hizbQuarter":6,"sajda":false},{"number":103,"text":"وَلَتَجِدَنَّهُمْ أَحْرَصَ النَّاسِ عَلَىٰ حَيَاةٍ وَمِنَ الَّذِينَ أَشْرَكُوا ۚ يَوَدُّ أَحَدُهُمْ لَوْ يُعَمَّرُ أَلْفَ سَنَةٍ وَمَا هُوَ بِمُزَحْزِحِهِ مِنَ الْعَذَابِ أَنْ يُعَمَّرَ ۗ وَاللَّهُ بَصِيرٌ بِمَا يَعْمَلُونَ","numberInSurah":96,"juz":1,"manzil":1,"page":15,"ruku":12,"hizbQuarter":6,"sajda":false},{"number":104,"text":"قُلْ مَنْ كَانَ عَدُوًّا لِجِبْرِيلَ فَإِنَّهُ نَزَّلَهُ عَلَىٰ قَلْبِكَ بِإِذْنِ اللَّهِ مُصَدِّقًا لِمَا بَيْنَ يَدَيْهِ وَهُدًى وَبُشْرَىٰ لِلْمُؤْمِنِينَ","numberInSurah":97,"juz":1,"manzil":1,"page":15,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":105,"text":"مَنْ كَانَ عَدُوًّا لِلَّهِ وَمَلَائِكَتِهِ وَرُسُلِهِ وَجِبْرِيلَ وَمِيكَالَ فَإِنَّ اللَّهَ عَدُوٌّ لِلْكَافِرِينَ","numberInSurah":98,"juz":1,"manzil":1,"page":15,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":106,"text":"وَلَقَدْ أَنْزَلْنَا إِلَيْكَ آيَاتٍ بَيِّنَاتٍ ۖ وَمَا يَكْفُرُ بِهَا إِلَّا الْفَاسِقُونَ","numberInSurah":99,"juz":1,"manzil":1,"page":15,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":107,"text":"أَوَكُلَّمَا عَاهَدُوا عَهْدًا نَبَذَهُ فَرِيقٌ مِنْهُمْ ۚ بَلْ أَكْثَرُهُمْ لَا يُؤْمِنُونَ","numberInSurah":100,"juz":1,"manzil":1,"page":15,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":108,"text":"وَلَمَّا جَاءَهُمْ رَسُولٌ مِنْ عِنْدِ اللَّهِ مُصَدِّقٌ لِمَا مَعَهُمْ نَبَذَ فَرِيقٌ مِنَ الَّذِينَ أُوتُوا الْكِتَابَ كِتَابَ اللَّهِ وَرَاءَ ظُهُورِهِمْ كَأَنَّهُمْ لَا يَعْلَمُونَ","numberInSurah":101,"juz":1,"manzil":1,"page":15,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":109,"text":"وَاتَّبَعُوا مَا تَتْلُو الشَّيَاطِينُ عَلَىٰ مُلْكِ سُلَيْمَانَ ۖ وَمَا كَفَرَ سُلَيْمَانُ وَلَٰكِنَّ الشَّيَاطِينَ كَفَرُوا يُعَلِّمُونَ النَّاسَ السِّحْرَ وَمَا أُنْزِلَ عَلَى الْمَلَكَيْنِ بِبَابِلَ هَارُوتَ وَمَارُوتَ ۚ وَمَا يُعَلِّمَانِ مِنْ أَحَدٍ حَتَّىٰ يَقُولَا إِنَّمَا نَحْنُ فِتْنَةٌ فَلَا تَكْفُرْ ۖ فَيَتَعَلَّمُونَ مِنْهُمَا مَا يُفَرِّقُونَ بِهِ بَيْنَ الْمَرْءِ وَزَوْجِهِ ۚ وَمَا هُمْ بِضَارِّينَ بِهِ مِنْ أَحَدٍ إِلَّا بِإِذْنِ اللَّهِ ۚ وَيَتَعَلَّمُونَ مَا يَضُرُّهُمْ وَلَا يَنْفَعُهُمْ ۚ وَلَقَدْ عَلِمُوا لَمَنِ اشْتَرَاهُ مَا لَهُ فِي الْآخِرَةِ مِنْ خَلَاقٍ ۚ وَلَبِئْسَ مَا شَرَوْا بِهِ أَنْفُسَهُمْ ۚ لَوْ كَانُوا يَعْلَمُونَ","numberInSurah":102,"juz":1,"manzil":1,"page":16,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":110,"text":"وَلَوْ أَنَّهُمْ آمَنُوا وَاتَّقَوْا لَمَثُوبَةٌ مِنْ عِنْدِ اللَّهِ خَيْرٌ ۖ لَوْ كَانُوا يَعْلَمُونَ","numberInSurah":103,"juz":1,"manzil":1,"page":16,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":111,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَقُولُوا رَاعِنَا وَقُولُوا انْظُرْنَا وَاسْمَعُوا ۗ وَلِلْكَافِرِينَ عَذَابٌ أَلِيمٌ","numberInSurah":104,"juz":1,"manzil":1,"page":16,"ruku":14,"hizbQuarter":6,"sajda":false},{"number":112,"text":"مَا يَوَدُّ الَّذِينَ كَفَرُوا مِنْ أَهْلِ الْكِتَابِ وَلَا الْمُشْرِكِينَ أَنْ يُنَزَّلَ عَلَيْكُمْ مِنْ خَيْرٍ مِنْ رَبِّكُمْ ۗ وَاللَّهُ يَخْتَصُّ بِرَحْمَتِهِ مَنْ يَشَاءُ ۚ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ","numberInSurah":105,"juz":1,"manzil":1,"page":16,"ruku":14,"hizbQuarter":6,"sajda":false},{"number":113,"text":"۞ مَا نَنْسَخْ مِنْ آيَةٍ أَوْ نُنْسِهَا نَأْتِ بِخَيْرٍ مِنْهَا أَوْ مِثْلِهَا ۗ أَلَمْ تَعْلَمْ أَنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":106,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":114,"text":"أَلَمْ تَعْلَمْ أَنَّ اللَّهَ لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ۗ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ","numberInSurah":107,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":115,"text":"أَمْ تُرِيدُونَ أَنْ تَسْأَلُوا رَسُولَكُمْ كَمَا سُئِلَ مُوسَىٰ مِنْ قَبْلُ ۗ وَمَنْ يَتَبَدَّلِ الْكُفْرَ بِالْإِيمَانِ فَقَدْ ضَلَّ سَوَاءَ السَّبِيلِ","numberInSurah":108,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":116,"text":"وَدَّ كَثِيرٌ مِنْ أَهْلِ الْكِتَابِ لَوْ يَرُدُّونَكُمْ مِنْ بَعْدِ إِيمَانِكُمْ كُفَّارًا حَسَدًا مِنْ عِنْدِ أَنْفُسِهِمْ مِنْ بَعْدِ مَا تَبَيَّنَ لَهُمُ الْحَقُّ ۖ فَاعْفُوا وَاصْفَحُوا حَتَّىٰ يَأْتِيَ اللَّهُ بِأَمْرِهِ ۗ إِنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":109,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":117,"text":"وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ ۚ وَمَا تُقَدِّمُوا لِأَنْفُسِكُمْ مِنْ خَيْرٍ تَجِدُوهُ عِنْدَ اللَّهِ ۗ إِنَّ اللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ","numberInSurah":110,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":118,"text":"وَقَالُوا لَنْ يَدْخُلَ الْجَنَّةَ إِلَّا مَنْ كَانَ هُودًا أَوْ نَصَارَىٰ ۗ تِلْكَ أَمَانِيُّهُمْ ۗ قُلْ هَاتُوا بُرْهَانَكُمْ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":111,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":119,"text":"بَلَىٰ مَنْ أَسْلَمَ وَجْهَهُ لِلَّهِ وَهُوَ مُحْسِنٌ فَلَهُ أَجْرُهُ عِنْدَ رَبِّهِ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ","numberInSurah":112,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":120,"text":"وَقَالَتِ الْيَهُودُ لَيْسَتِ النَّصَارَىٰ عَلَىٰ شَيْءٍ وَقَالَتِ النَّصَارَىٰ لَيْسَتِ الْيَهُودُ عَلَىٰ شَيْءٍ وَهُمْ يَتْلُونَ الْكِتَابَ ۗ كَذَٰلِكَ قَالَ الَّذِينَ لَا يَعْلَمُونَ مِثْلَ قَوْلِهِمْ ۚ فَاللَّهُ يَحْكُمُ بَيْنَهُمْ يَوْمَ الْقِيَامَةِ فِيمَا كَانُوا فِيهِ يَخْتَلِفُونَ","numberInSurah":113,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":121,"text":"وَمَنْ أَظْلَمُ مِمَّنْ مَنَعَ مَسَاجِدَ اللَّهِ أَنْ يُذْكَرَ فِيهَا اسْمُهُ وَسَعَىٰ فِي خَرَابِهَا ۚ أُولَٰئِكَ مَا كَانَ لَهُمْ أَنْ يَدْخُلُوهَا إِلَّا خَائِفِينَ ۚ لَهُمْ فِي الدُّنْيَا خِزْيٌ وَلَهُمْ فِي الْآخِرَةِ عَذَابٌ عَظِيمٌ","numberInSurah":114,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":122,"text":"وَلِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ ۚ فَأَيْنَمَا تُوَلُّوا فَثَمَّ وَجْهُ اللَّهِ ۚ إِنَّ اللَّهَ وَاسِعٌ عَلِيمٌ","numberInSurah":115,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":123,"text":"وَقَالُوا اتَّخَذَ اللَّهُ وَلَدًا ۗ سُبْحَانَهُ ۖ بَلْ لَهُ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ ۖ كُلٌّ لَهُ قَانِتُونَ","numberInSurah":116,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":124,"text":"بَدِيعُ السَّمَاوَاتِ وَالْأَرْضِ ۖ وَإِذَا قَضَىٰ أَمْرًا فَإِنَّمَا يَقُولُ لَهُ كُنْ فَيَكُونُ","numberInSurah":117,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":125,"text":"وَقَالَ الَّذِينَ لَا يَعْلَمُونَ لَوْلَا يُكَلِّمُنَا اللَّهُ أَوْ تَأْتِينَا آيَةٌ ۗ كَذَٰلِكَ قَالَ الَّذِينَ مِنْ قَبْلِهِمْ مِثْلَ قَوْلِهِمْ ۘ تَشَابَهَتْ قُلُوبُهُمْ ۗ قَدْ بَيَّنَّا الْآيَاتِ لِقَوْمٍ يُوقِنُونَ","numberInSurah":118,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":126,"text":"إِنَّا أَرْسَلْنَاكَ بِالْحَقِّ بَشِيرًا وَنَذِيرًا ۖ وَلَا تُسْأَلُ عَنْ أَصْحَابِ الْجَحِيمِ","numberInSurah":119,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":127,"text":"وَلَنْ تَرْضَىٰ عَنْكَ الْيَهُودُ وَلَا النَّصَارَىٰ حَتَّىٰ تَتَّبِعَ مِلَّتَهُمْ ۗ قُلْ إِنَّ هُدَى اللَّهِ هُوَ الْهُدَىٰ ۗ وَلَئِنِ اتَّبَعْتَ أَهْوَاءَهُمْ بَعْدَ الَّذِي جَاءَكَ مِنَ الْعِلْمِ ۙ مَا لَكَ مِنَ اللَّهِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ","numberInSurah":120,"juz":1,"manzil":1,"page":19,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":128,"text":"الَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يَتْلُونَهُ حَقَّ تِلَاوَتِهِ أُولَٰئِكَ يُؤْمِنُونَ بِهِ ۗ وَمَنْ يَكْفُرْ بِهِ فَأُولَٰئِكَ هُمُ الْخَاسِرُونَ","numberInSurah":121,"juz":1,"manzil":1,"page":19,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":129,"text":"يَا بَنِي إِسْرَائِيلَ اذْكُرُوا نِعْمَتِيَ الَّتِي أَنْعَمْتُ عَلَيْكُمْ وَأَنِّي فَضَّلْتُكُمْ عَلَى الْعَالَمِينَ","numberInSurah":122,"juz":1,"manzil":1,"page":19,"ruku":16,"hizbQuarter":7,"sajda":false},{"number":130,"text":"وَاتَّقُوا يَوْمًا لَا تَجْزِي نَفْسٌ عَنْ نَفْسٍ شَيْئًا وَلَا يُقْبَلُ مِنْهَا عَدْلٌ وَلَا تَنْفَعُهَا شَفَاعَةٌ وَلَا هُمْ يُنْصَرُونَ","numberInSurah":123,"juz":1,"manzil":1,"page":19,"ruku":16,"hizbQuarter":7,"sajda":false},{"number":131,"text":"۞ وَإِذِ ابْتَلَىٰ إِبْرَاهِيمَ رَبُّهُ بِكَلِمَاتٍ فَأَتَمَّهُنَّ ۖ قَالَ إِنِّي جَاعِلُكَ لِلنَّاسِ إِمَامًا ۖ قَالَ وَمِنْ ذُرِّيَّتِي ۖ قَالَ لَا يَنَالُ عَهْدِي الظَّالِمِينَ","numberInSurah":124,"juz":1,"manzil":1,"page":19,"ruku":16,"hizbQuarter":8,"sajda":false},{"number":132,"text":"وَإِذْ جَعَلْنَا الْبَيْتَ مَثَابَةً لِلنَّاسِ وَأَمْنًا وَاتَّخِذُوا مِنْ مَقَامِ إِبْرَاهِيمَ مُصَلًّى ۖ وَعَهِدْنَا إِلَىٰ إِبْرَاهِيمَ وَإِسْمَاعِيلَ أَنْ طَهِّرَا بَيْتِيَ لِلطَّائِفِينَ وَالْعَاكِفِينَ وَالرُّكَّعِ السُّجُودِ","numberInSurah":125,"juz":1,"manzil":1,"page":19,"ruku":16,"hizbQuarter":8,"sajda":false},{"number":133,"text":"وَإِذْ قَالَ إِبْرَاهِيمُ رَبِّ اجْعَلْ هَٰذَا بَلَدًا آمِنًا وَارْزُقْ أَهْلَهُ مِنَ الثَّمَرَاتِ مَنْ آمَنَ مِنْهُمْ بِاللَّهِ وَالْيَوْمِ الْآخِرِ ۖ قَالَ وَمَنْ كَفَرَ فَأُمَتِّعُهُ قَلِيلًا ثُمَّ أَضْطَرُّهُ إِلَىٰ عَذَابِ النَّارِ ۖ وَبِئْسَ الْمَصِيرُ","numberInSurah":126,"juz":1,"manzil":1,"page":19,"ruku":16,"hizbQuarter":8,"sajda":false},{"number":134,"text":"وَإِذْ يَرْفَعُ إِبْرَاهِيمُ الْقَوَاعِدَ مِنَ الْبَيْتِ وَإِسْمَاعِيلُ رَبَّنَا تَقَبَّلْ مِنَّا ۖ إِنَّكَ أَنْتَ السَّمِيعُ الْعَلِيمُ","numberInSurah":127,"juz":1,"manzil":1,"page":20,"ruku":16,"hizbQuarter":8,"sajda":false},{"number":135,"text":"رَبَّنَا وَاجْعَلْنَا مُسْلِمَيْنِ لَكَ وَمِنْ ذُرِّيَّتِنَا أُمَّةً مُسْلِمَةً لَكَ وَأَرِنَا مَنَاسِكَنَا وَتُبْ عَلَيْنَا ۖ إِنَّكَ أَنْتَ التَّوَّابُ الرَّحِيمُ","numberInSurah":128,"juz":1,"manzil":1,"page":20,"ruku":16,"hizbQuarter":8,"sajda":false},{"number":136,"text":"رَبَّنَا وَابْعَثْ فِيهِمْ رَسُولًا مِنْهُمْ يَتْلُو عَلَيْهِمْ آيَاتِكَ وَيُعَلِّمُهُمُ الْكِتَابَ وَالْحِكْمَةَ وَيُزَكِّيهِمْ ۚ إِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ","numberInSurah":129,"juz":1,"manzil":1,"page":20,"ruku":16,"hizbQuarter":8,"sajda":false},{"number":137,"text":"وَمَنْ يَرْغَبُ عَنْ مِلَّةِ إِبْرَاهِيمَ إِلَّا مَنْ سَفِهَ نَفْسَهُ ۚ وَلَقَدِ اصْطَفَيْنَاهُ فِي الدُّنْيَا ۖ وَإِنَّهُ فِي الْآخِرَةِ لَمِنَ الصَّالِحِينَ","numberInSurah":130,"juz":1,"manzil":1,"page":20,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":138,"text":"إِذْ قَالَ لَهُ رَبُّهُ أَسْلِمْ ۖ قَالَ أَسْلَمْتُ لِرَبِّ الْعَالَمِينَ","numberInSurah":131,"juz":1,"manzil":1,"page":20,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":139,"text":"وَوَصَّىٰ بِهَا إِبْرَاهِيمُ بَنِيهِ وَيَعْقُوبُ يَا بَنِيَّ إِنَّ اللَّهَ اصْطَفَىٰ لَكُمُ الدِّينَ فَلَا تَمُوتُنَّ إِلَّا وَأَنْتُمْ مُسْلِمُونَ","numberInSurah":132,"juz":1,"manzil":1,"page":20,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":140,"text":"أَمْ كُنْتُمْ شُهَدَاءَ إِذْ حَضَرَ يَعْقُوبَ الْمَوْتُ إِذْ قَالَ لِبَنِيهِ مَا تَعْبُدُونَ مِنْ بَعْدِي قَالُوا نَعْبُدُ إِلَٰهَكَ وَإِلَٰهَ آبَائِكَ إِبْرَاهِيمَ وَإِسْمَاعِيلَ وَإِسْحَاقَ إِلَٰهًا وَاحِدًا وَنَحْنُ لَهُ مُسْلِمُونَ","numberInSurah":133,"juz":1,"manzil":1,"page":20,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":141,"text":"تِلْكَ أُمَّةٌ قَدْ خَلَتْ ۖ لَهَا مَا كَسَبَتْ وَلَكُمْ مَا كَسَبْتُمْ ۖ وَلَا تُسْأَلُونَ عَمَّا كَانُوا يَعْمَلُونَ","numberInSurah":134,"juz":1,"manzil":1,"page":20,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":142,"text":"وَقَالُوا كُونُوا هُودًا أَوْ نَصَارَىٰ تَهْتَدُوا ۗ قُلْ بَلْ مِلَّةَ إِبْرَاهِيمَ حَنِيفًا ۖ وَمَا كَانَ مِنَ الْمُشْرِكِينَ","numberInSurah":135,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":143,"text":"قُولُوا آمَنَّا بِاللَّهِ وَمَا أُنْزِلَ إِلَيْنَا وَمَا أُنْزِلَ إِلَىٰ إِبْرَاهِيمَ وَإِسْمَاعِيلَ وَإِسْحَاقَ وَيَعْقُوبَ وَالْأَسْبَاطِ وَمَا أُوتِيَ مُوسَىٰ وَعِيسَىٰ وَمَا أُوتِيَ النَّبِيُّونَ مِنْ رَبِّهِمْ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِنْهُمْ وَنَحْنُ لَهُ مُسْلِمُونَ","numberInSurah":136,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":144,"text":"فَإِنْ آمَنُوا بِمِثْلِ مَا آمَنْتُمْ بِهِ فَقَدِ اهْتَدَوْا ۖ وَإِنْ تَوَلَّوْا فَإِنَّمَا هُمْ فِي شِقَاقٍ ۖ فَسَيَكْفِيكَهُمُ اللَّهُ ۚ وَهُوَ السَّمِيعُ الْعَلِيمُ","numberInSurah":137,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":145,"text":"صِبْغَةَ اللَّهِ ۖ وَمَنْ أَحْسَنُ مِنَ اللَّهِ صِبْغَةً ۖ وَنَحْنُ لَهُ عَابِدُونَ","numberInSurah":138,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":146,"text":"قُلْ أَتُحَاجُّونَنَا فِي اللَّهِ وَهُوَ رَبُّنَا وَرَبُّكُمْ وَلَنَا أَعْمَالُنَا وَلَكُمْ أَعْمَالُكُمْ وَنَحْنُ لَهُ مُخْلِصُونَ","numberInSurah":139,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":147,"text":"أَمْ تَقُولُونَ إِنَّ إِبْرَاهِيمَ وَإِسْمَاعِيلَ وَإِسْحَاقَ وَيَعْقُوبَ وَالْأَسْبَاطَ كَانُوا هُودًا أَوْ نَصَارَىٰ ۗ قُلْ أَأَنْتُمْ أَعْلَمُ أَمِ اللَّهُ ۗ وَمَنْ أَظْلَمُ مِمَّنْ كَتَمَ شَهَادَةً عِنْدَهُ مِنَ اللَّهِ ۗ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ","numberInSurah":140,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":148,"text":"تِلْكَ أُمَّةٌ قَدْ خَلَتْ ۖ لَهَا مَا كَسَبَتْ وَلَكُمْ مَا كَسَبْتُمْ ۖ وَلَا تُسْأَلُونَ عَمَّا كَانُوا يَعْمَلُونَ","numberInSurah":141,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":149,"text":"۞ سَيَقُولُ السُّفَهَاءُ مِنَ النَّاسِ مَا وَلَّاهُمْ عَنْ قِبْلَتِهِمُ الَّتِي كَانُوا عَلَيْهَا ۚ قُلْ لِلَّهِ الْمَشْرِقُ وَالْمَغْرِبُ ۚ يَهْدِي مَنْ يَشَاءُ إِلَىٰ صِرَاطٍ مُسْتَقِيمٍ","numberInSurah":142,"juz":2,"manzil":1,"page":22,"ruku":18,"hizbQuarter":9,"sajda":false},{"number":150,"text":"وَكَذَٰلِكَ جَعَلْنَاكُمْ أُمَّةً وَسَطًا لِتَكُونُوا شُهَدَاءَ عَلَى النَّاسِ وَيَكُونَ الرَّسُولُ عَلَيْكُمْ شَهِيدًا ۗ وَمَا جَعَلْنَا الْقِبْلَةَ الَّتِي كُنْتَ عَلَيْهَا إِلَّا لِنَعْلَمَ مَنْ يَتَّبِعُ الرَّسُولَ مِمَّنْ يَنْقَلِبُ عَلَىٰ عَقِبَيْهِ ۚ وَإِنْ كَانَتْ لَكَبِيرَةً إِلَّا عَلَى الَّذِينَ هَدَى اللَّهُ ۗ وَمَا كَانَ اللَّهُ لِيُضِيعَ إِيمَانَكُمْ ۚ إِنَّ اللَّهَ بِالنَّاسِ لَرَءُوفٌ رَحِيمٌ","numberInSurah":143,"juz":2,"manzil":1,"page":22,"ruku":18,"hizbQuarter":9,"sajda":false},{"number":151,"text":"قَدْ نَرَىٰ تَقَلُّبَ وَجْهِكَ فِي السَّمَاءِ ۖ فَلَنُوَلِّيَنَّكَ قِبْلَةً تَرْضَاهَا ۚ فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ ۚ وَحَيْثُ مَا كُنْتُمْ فَوَلُّوا وُجُوهَكُمْ شَطْرَهُ ۗ وَإِنَّ الَّذِينَ أُوتُوا الْكِتَابَ لَيَعْلَمُونَ أَنَّهُ الْحَقُّ مِنْ رَبِّهِمْ ۗ وَمَا اللَّهُ بِغَافِلٍ عَمَّا يَعْمَلُونَ","numberInSurah":144,"juz":2,"manzil":1,"page":22,"ruku":18,"hizbQuarter":9,"sajda":false},{"number":152,"text":"وَلَئِنْ أَتَيْتَ الَّذِينَ أُوتُوا الْكِتَابَ بِكُلِّ آيَةٍ مَا تَبِعُوا قِبْلَتَكَ ۚ وَمَا أَنْتَ بِتَابِعٍ قِبْلَتَهُمْ ۚ وَمَا بَعْضُهُمْ بِتَابِعٍ قِبْلَةَ بَعْضٍ ۚ وَلَئِنِ اتَّبَعْتَ أَهْوَاءَهُمْ مِنْ بَعْدِ مَا جَاءَكَ مِنَ الْعِلْمِ ۙ إِنَّكَ إِذًا لَمِنَ الظَّالِمِينَ","numberInSurah":145,"juz":2,"manzil":1,"page":22,"ruku":18,"hizbQuarter":9,"sajda":false},{"number":153,"text":"الَّذِينَ آتَيْنَاهُمُ الْكِتَابَ يَعْرِفُونَهُ كَمَا يَعْرِفُونَ أَبْنَاءَهُمْ ۖ وَإِنَّ فَرِيقًا مِنْهُمْ لَيَكْتُمُونَ الْحَقَّ وَهُمْ يَعْلَمُونَ","numberInSurah":146,"juz":2,"manzil":1,"page":23,"ruku":18,"hizbQuarter":9,"sajda":false},{"number":154,"text":"الْحَقُّ مِنْ رَبِّكَ ۖ فَلَا تَكُونَنَّ مِنَ الْمُمْتَرِينَ","numberInSurah":147,"juz":2,"manzil":1,"page":23,"ruku":18,"hizbQuarter":9,"sajda":false},{"number":155,"text":"وَلِكُلٍّ وِجْهَةٌ هُوَ مُوَلِّيهَا ۖ فَاسْتَبِقُوا الْخَيْرَاتِ ۚ أَيْنَ مَا تَكُونُوا يَأْتِ بِكُمُ اللَّهُ جَمِيعًا ۚ إِنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":148,"juz":2,"manzil":1,"page":23,"ruku":19,"hizbQuarter":9,"sajda":false},{"number":156,"text":"وَمِنْ حَيْثُ خَرَجْتَ فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ ۖ وَإِنَّهُ لَلْحَقُّ مِنْ رَبِّكَ ۗ وَمَا اللَّهُ بِغَافِلٍ عَمَّا تَعْمَلُونَ","numberInSurah":149,"juz":2,"manzil":1,"page":23,"ruku":19,"hizbQuarter":9,"sajda":false},{"number":157,"text":"وَمِنْ حَيْثُ خَرَجْتَ فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ ۚ وَحَيْثُ مَا كُنْتُمْ فَوَلُّوا وُجُوهَكُمْ شَطْرَهُ لِئَلَّا يَكُونَ لِلنَّاسِ عَلَيْكُمْ حُجَّةٌ إِلَّا الَّذِينَ ظَلَمُوا مِنْهُمْ فَلَا تَخْشَوْهُمْ وَاخْشَوْنِي وَلِأُتِمَّ نِعْمَتِي عَلَيْكُمْ وَلَعَلَّكُمْ تَهْتَدُونَ","numberInSurah":150,"juz":2,"manzil":1,"page":23,"ruku":19,"hizbQuarter":9,"sajda":false},{"number":158,"text":"كَمَا أَرْسَلْنَا فِيكُمْ رَسُولًا مِنْكُمْ يَتْلُو عَلَيْكُمْ آيَاتِنَا وَيُزَكِّيكُمْ وَيُعَلِّمُكُمُ الْكِتَابَ وَالْحِكْمَةَ وَيُعَلِّمُكُمْ مَا لَمْ تَكُونُوا تَعْلَمُونَ","numberInSurah":151,"juz":2,"manzil":1,"page":23,"ruku":19,"hizbQuarter":9,"sajda":false},{"number":159,"text":"فَاذْكُرُونِي أَذْكُرْكُمْ وَاشْكُرُوا لِي وَلَا تَكْفُرُونِ","numberInSurah":152,"juz":2,"manzil":1,"page":23,"ruku":19,"hizbQuarter":9,"sajda":false},{"number":160,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ ۚ إِنَّ اللَّهَ مَعَ الصَّابِرِينَ","numberInSurah":153,"juz":2,"manzil":1,"page":23,"ruku":20,"hizbQuarter":9,"sajda":false},{"number":161,"text":"وَلَا تَقُولُوا لِمَنْ يُقْتَلُ فِي سَبِيلِ اللَّهِ أَمْوَاتٌ ۚ بَلْ أَحْيَاءٌ وَلَٰكِنْ لَا تَشْعُرُونَ","numberInSurah":154,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":9,"sajda":false},{"number":162,"text":"وَلَنَبْلُوَنَّكُمْ بِشَيْءٍ مِنَ الْخَوْفِ وَالْجُوعِ وَنَقْصٍ مِنَ الْأَمْوَالِ وَالْأَنْفُسِ وَالثَّمَرَاتِ ۗ وَبَشِّرِ الصَّابِرِينَ","numberInSurah":155,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":9,"sajda":false},{"number":163,"text":"الَّذِينَ إِذَا أَصَابَتْهُمْ مُصِيبَةٌ قَالُوا إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ","numberInSurah":156,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":9,"sajda":false},{"number":164,"text":"أُولَٰئِكَ عَلَيْهِمْ صَلَوَاتٌ مِنْ رَبِّهِمْ وَرَحْمَةٌ ۖ وَأُولَٰئِكَ هُمُ الْمُهْتَدُونَ","numberInSurah":157,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":9,"sajda":false},{"number":165,"text":"۞ إِنَّ الصَّفَا وَالْمَرْوَةَ مِنْ شَعَائِرِ اللَّهِ ۖ فَمَنْ حَجَّ الْبَيْتَ أَوِ اعْتَمَرَ فَلَا جُنَاحَ عَلَيْهِ أَنْ يَطَّوَّفَ بِهِمَا ۚ وَمَنْ تَطَوَّعَ خَيْرًا فَإِنَّ اللَّهَ شَاكِرٌ عَلِيمٌ","numberInSurah":158,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":10,"sajda":false},{"number":166,"text":"إِنَّ الَّذِينَ يَكْتُمُونَ مَا أَنْزَلْنَا مِنَ الْبَيِّنَاتِ وَالْهُدَىٰ مِنْ بَعْدِ مَا بَيَّنَّاهُ لِلنَّاسِ فِي الْكِتَابِ ۙ أُولَٰئِكَ يَلْعَنُهُمُ اللَّهُ وَيَلْعَنُهُمُ اللَّاعِنُونَ","numberInSurah":159,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":10,"sajda":false},{"number":167,"text":"إِلَّا الَّذِينَ تَابُوا وَأَصْلَحُوا وَبَيَّنُوا فَأُولَٰئِكَ أَتُوبُ عَلَيْهِمْ ۚ وَأَنَا التَّوَّابُ الرَّحِيمُ","numberInSurah":160,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":10,"sajda":false},{"number":168,"text":"إِنَّ الَّذِينَ كَفَرُوا وَمَاتُوا وَهُمْ كُفَّارٌ أُولَٰئِكَ عَلَيْهِمْ لَعْنَةُ اللَّهِ وَالْمَلَائِكَةِ وَالنَّاسِ أَجْمَعِينَ","numberInSurah":161,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":10,"sajda":false},{"number":169,"text":"خَالِدِينَ فِيهَا ۖ لَا يُخَفَّفُ عَنْهُمُ الْعَذَابُ وَلَا هُمْ يُنْظَرُونَ","numberInSurah":162,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":10,"sajda":false},{"number":170,"text":"وَإِلَٰهُكُمْ إِلَٰهٌ وَاحِدٌ ۖ لَا إِلَٰهَ إِلَّا هُوَ الرَّحْمَٰنُ الرَّحِيمُ","numberInSurah":163,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":10,"sajda":false},{"number":171,"text":"إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ وَالْفُلْكِ الَّتِي تَجْرِي فِي الْبَحْرِ بِمَا يَنْفَعُ النَّاسَ وَمَا أَنْزَلَ اللَّهُ مِنَ السَّمَاءِ مِنْ مَاءٍ فَأَحْيَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِنْ كُلِّ دَابَّةٍ وَتَصْرِيفِ الرِّيَاحِ وَالسَّحَابِ الْمُسَخَّرِ بَيْنَ السَّمَاءِ وَالْأَرْضِ لَآيَاتٍ لِقَوْمٍ يَعْقِلُونَ","numberInSurah":164,"juz":2,"manzil":1,"page":25,"ruku":21,"hizbQuarter":10,"sajda":false},{"number":172,"text":"وَمِنَ النَّاسِ مَنْ يَتَّخِذُ مِنْ دُونِ اللَّهِ أَنْدَادًا يُحِبُّونَهُمْ كَحُبِّ اللَّهِ ۖ وَالَّذِينَ آمَنُوا أَشَدُّ حُبًّا لِلَّهِ ۗ وَلَوْ يَرَى الَّذِينَ ظَلَمُوا إِذْ يَرَوْنَ الْعَذَابَ أَنَّ الْقُوَّةَ لِلَّهِ جَمِيعًا وَأَنَّ اللَّهَ شَدِيدُ الْعَذَابِ","numberInSurah":165,"juz":2,"manzil":1,"page":25,"ruku":21,"hizbQuarter":10,"sajda":false},{"number":173,"text":"إِذْ تَبَرَّأَ الَّذِينَ اتُّبِعُوا مِنَ الَّذِينَ اتَّبَعُوا وَرَأَوُا الْعَذَابَ وَتَقَطَّعَتْ بِهِمُ الْأَسْبَابُ","numberInSurah":166,"juz":2,"manzil":1,"page":25,"ruku":21,"hizbQuarter":10,"sajda":false},{"number":174,"text":"وَقَالَ الَّذِينَ اتَّبَعُوا لَوْ أَنَّ لَنَا كَرَّةً فَنَتَبَرَّأَ مِنْهُمْ كَمَا تَبَرَّءُوا مِنَّا ۗ كَذَٰلِكَ يُرِيهِمُ اللَّهُ أَعْمَالَهُمْ حَسَرَاتٍ عَلَيْهِمْ ۖ وَمَا هُمْ بِخَارِجِينَ مِنَ النَّارِ","numberInSurah":167,"juz":2,"manzil":1,"page":25,"ruku":21,"hizbQuarter":10,"sajda":false},{"number":175,"text":"يَا أَيُّهَا النَّاسُ كُلُوا مِمَّا فِي الْأَرْضِ حَلَالًا طَيِّبًا وَلَا تَتَّبِعُوا خُطُوَاتِ الشَّيْطَانِ ۚ إِنَّهُ لَكُمْ عَدُوٌّ مُبِينٌ","numberInSurah":168,"juz":2,"manzil":1,"page":25,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":176,"text":"إِنَّمَا يَأْمُرُكُمْ بِالسُّوءِ وَالْفَحْشَاءِ وَأَنْ تَقُولُوا عَلَى اللَّهِ مَا لَا تَعْلَمُونَ","numberInSurah":169,"juz":2,"manzil":1,"page":25,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":177,"text":"وَإِذَا قِيلَ لَهُمُ اتَّبِعُوا مَا أَنْزَلَ اللَّهُ قَالُوا بَلْ نَتَّبِعُ مَا أَلْفَيْنَا عَلَيْهِ آبَاءَنَا ۗ أَوَلَوْ كَانَ آبَاؤُهُمْ لَا يَعْقِلُونَ شَيْئًا وَلَا يَهْتَدُونَ","numberInSurah":170,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":178,"text":"وَمَثَلُ الَّذِينَ كَفَرُوا كَمَثَلِ الَّذِي يَنْعِقُ بِمَا لَا يَسْمَعُ إِلَّا دُعَاءً وَنِدَاءً ۚ صُمٌّ بُكْمٌ عُمْيٌ فَهُمْ لَا يَعْقِلُونَ","numberInSurah":171,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":179,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا كُلُوا مِنْ طَيِّبَاتِ مَا رَزَقْنَاكُمْ وَاشْكُرُوا لِلَّهِ إِنْ كُنْتُمْ إِيَّاهُ تَعْبُدُونَ","numberInSurah":172,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":180,"text":"إِنَّمَا حَرَّمَ عَلَيْكُمُ الْمَيْتَةَ وَالدَّمَ وَلَحْمَ الْخِنْزِيرِ وَمَا أُهِلَّ بِهِ لِغَيْرِ اللَّهِ ۖ فَمَنِ اضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَلَا إِثْمَ عَلَيْهِ ۚ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","numberInSurah":173,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":181,"text":"إِنَّ الَّذِينَ يَكْتُمُونَ مَا أَنْزَلَ اللَّهُ مِنَ الْكِتَابِ وَيَشْتَرُونَ بِهِ ثَمَنًا قَلِيلًا ۙ أُولَٰئِكَ مَا يَأْكُلُونَ فِي بُطُونِهِمْ إِلَّا النَّارَ وَلَا يُكَلِّمُهُمُ اللَّهُ يَوْمَ الْقِيَامَةِ وَلَا يُزَكِّيهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ","numberInSurah":174,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":182,"text":"أُولَٰئِكَ الَّذِينَ اشْتَرَوُا الضَّلَالَةَ بِالْهُدَىٰ وَالْعَذَابَ بِالْمَغْفِرَةِ ۚ فَمَا أَصْبَرَهُمْ عَلَى النَّارِ","numberInSurah":175,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":183,"text":"ذَٰلِكَ بِأَنَّ اللَّهَ نَزَّلَ الْكِتَابَ بِالْحَقِّ ۗ وَإِنَّ الَّذِينَ اخْتَلَفُوا فِي الْكِتَابِ لَفِي شِقَاقٍ بَعِيدٍ","numberInSurah":176,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":184,"text":"۞ لَيْسَ الْبِرَّ أَنْ تُوَلُّوا وُجُوهَكُمْ قِبَلَ الْمَشْرِقِ وَالْمَغْرِبِ وَلَٰكِنَّ الْبِرَّ مَنْ آمَنَ بِاللَّهِ وَالْيَوْمِ الْآخِرِ وَالْمَلَائِكَةِ وَالْكِتَابِ وَالنَّبِيِّينَ وَآتَى الْمَالَ عَلَىٰ حُبِّهِ ذَوِي الْقُرْبَىٰ وَالْيَتَامَىٰ وَالْمَسَاكِينَ وَابْنَ السَّبِيلِ وَالسَّائِلِينَ وَفِي الرِّقَابِ وَأَقَامَ الصَّلَاةَ وَآتَى الزَّكَاةَ وَالْمُوفُونَ بِعَهْدِهِمْ إِذَا عَاهَدُوا ۖ وَالصَّابِرِينَ فِي الْبَأْسَاءِ وَالضَّرَّاءِ وَحِينَ الْبَأْسِ ۗ أُولَٰئِكَ الَّذِينَ صَدَقُوا ۖ وَأُولَٰئِكَ هُمُ الْمُتَّقُونَ","numberInSurah":177,"juz":2,"manzil":1,"page":27,"ruku":23,"hizbQuarter":11,"sajda":false},{"number":185,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا كُتِبَ عَلَيْكُمُ الْقِصَاصُ فِي الْقَتْلَى ۖ الْحُرُّ بِالْحُرِّ وَالْعَبْدُ بِالْعَبْدِ وَالْأُنْثَىٰ بِالْأُنْثَىٰ ۚ فَمَنْ عُفِيَ لَهُ مِنْ أَخِيهِ شَيْءٌ فَاتِّبَاعٌ بِالْمَعْرُوفِ وَأَدَاءٌ إِلَيْهِ بِإِحْسَانٍ ۗ ذَٰلِكَ تَخْفِيفٌ مِنْ رَبِّكُمْ وَرَحْمَةٌ ۗ فَمَنِ اعْتَدَىٰ بَعْدَ ذَٰلِكَ فَلَهُ عَذَابٌ أَلِيمٌ","numberInSurah":178,"juz":2,"manzil":1,"page":27,"ruku":23,"hizbQuarter":11,"sajda":false},{"number":186,"text":"وَلَكُمْ فِي الْقِصَاصِ حَيَاةٌ يَا أُولِي الْأَلْبَابِ لَعَلَّكُمْ تَتَّقُونَ","numberInSurah":179,"juz":2,"manzil":1,"page":27,"ruku":23,"hizbQuarter":11,"sajda":false},{"number":187,"text":"كُتِبَ عَلَيْكُمْ إِذَا حَضَرَ أَحَدَكُمُ الْمَوْتُ إِنْ تَرَكَ خَيْرًا الْوَصِيَّةُ لِلْوَالِدَيْنِ وَالْأَقْرَبِينَ بِالْمَعْرُوفِ ۖ حَقًّا عَلَى الْمُتَّقِينَ","numberInSurah":180,"juz":2,"manzil":1,"page":27,"ruku":23,"hizbQuarter":11,"sajda":false},{"number":188,"text":"فَمَنْ بَدَّلَهُ بَعْدَمَا سَمِعَهُ فَإِنَّمَا إِثْمُهُ عَلَى الَّذِينَ يُبَدِّلُونَهُ ۚ إِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ","numberInSurah":181,"juz":2,"manzil":1,"page":27,"ruku":23,"hizbQuarter":11,"sajda":false},{"number":189,"text":"فَمَنْ خَافَ مِنْ مُوصٍ جَنَفًا أَوْ إِثْمًا فَأَصْلَحَ بَيْنَهُمْ فَلَا إِثْمَ عَلَيْهِ ۚ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","numberInSurah":182,"juz":2,"manzil":1,"page":28,"ruku":23,"hizbQuarter":11,"sajda":false},{"number":190,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا كُتِبَ عَلَيْكُمُ الصِّيَامُ كَمَا كُتِبَ عَلَى الَّذِينَ مِنْ قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ","numberInSurah":183,"juz":2,"manzil":1,"page":28,"ruku":24,"hizbQuarter":11,"sajda":false},{"number":191,"text":"أَيَّامًا مَعْدُودَاتٍ ۚ فَمَنْ كَانَ مِنْكُمْ مَرِيضًا أَوْ عَلَىٰ سَفَرٍ فَعِدَّةٌ مِنْ أَيَّامٍ أُخَرَ ۚ وَعَلَى الَّذِينَ يُطِيقُونَهُ فِدْيَةٌ طَعَامُ مِسْكِينٍ ۖ فَمَنْ تَطَوَّعَ خَيْرًا فَهُوَ خَيْرٌ لَهُ ۚ وَأَنْ تَصُومُوا خَيْرٌ لَكُمْ ۖ إِنْ كُنْتُمْ تَعْلَمُونَ","numberInSurah":184,"juz":2,"manzil":1,"page":28,"ruku":24,"hizbQuarter":11,"sajda":false},{"number":192,"text":"شَهْرُ رَمَضَانَ الَّذِي أُنْزِلَ فِيهِ الْقُرْآنُ هُدًى لِلنَّاسِ وَبَيِّنَاتٍ مِنَ الْهُدَىٰ وَالْفُرْقَانِ ۚ فَمَنْ شَهِدَ مِنْكُمُ الشَّهْرَ فَلْيَصُمْهُ ۖ وَمَنْ كَانَ مَرِيضًا أَوْ عَلَىٰ سَفَرٍ فَعِدَّةٌ مِنْ أَيَّامٍ أُخَرَ ۗ يُرِيدُ اللَّهُ بِكُمُ الْيُسْرَ وَلَا يُرِيدُ بِكُمُ الْعُسْرَ وَلِتُكْمِلُوا الْعِدَّةَ وَلِتُكَبِّرُوا اللَّهَ عَلَىٰ مَا هَدَاكُمْ وَلَعَلَّكُمْ تَشْكُرُونَ","numberInSurah":185,"juz":2,"manzil":1,"page":28,"ruku":24,"hizbQuarter":11,"sajda":false},{"number":193,"text":"وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ ۖ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ ۖ فَلْيَسْتَجِيبُوا لِي وَلْيُؤْمِنُوا بِي لَعَلَّهُمْ يَرْشُدُونَ","numberInSurah":186,"juz":2,"manzil":1,"page":28,"ruku":24,"hizbQuarter":11,"sajda":false},{"number":194,"text":"أُحِلَّ لَكُمْ لَيْلَةَ الصِّيَامِ الرَّفَثُ إِلَىٰ نِسَائِكُمْ ۚ هُنَّ لِبَاسٌ لَكُمْ وَأَنْتُمْ لِبَاسٌ لَهُنَّ ۗ عَلِمَ اللَّهُ أَنَّكُمْ كُنْتُمْ تَخْتَانُونَ أَنْفُسَكُمْ فَتَابَ عَلَيْكُمْ وَعَفَا عَنْكُمْ ۖ فَالْآنَ بَاشِرُوهُنَّ وَابْتَغُوا مَا كَتَبَ اللَّهُ لَكُمْ ۚ وَكُلُوا وَاشْرَبُوا حَتَّىٰ يَتَبَيَّنَ لَكُمُ الْخَيْطُ الْأَبْيَضُ مِنَ الْخَيْطِ الْأَسْوَدِ مِنَ الْفَجْرِ ۖ ثُمَّ أَتِمُّوا الصِّيَامَ إِلَى اللَّيْلِ ۚ وَلَا تُبَاشِرُوهُنَّ وَأَنْتُمْ عَاكِفُونَ فِي الْمَسَاجِدِ ۗ تِلْكَ حُدُودُ اللَّهِ فَلَا تَقْرَبُوهَا ۗ كَذَٰلِكَ يُبَيِّنُ اللَّهُ آيَاتِهِ لِلنَّاسِ لَعَلَّهُمْ يَتَّقُونَ","numberInSurah":187,"juz":2,"manzil":1,"page":29,"ruku":24,"hizbQuarter":11,"sajda":false},{"number":195,"text":"وَلَا تَأْكُلُوا أَمْوَالَكُمْ بَيْنَكُمْ بِالْبَاطِلِ وَتُدْلُوا بِهَا إِلَى الْحُكَّامِ لِتَأْكُلُوا فَرِيقًا مِنْ أَمْوَالِ النَّاسِ بِالْإِثْمِ وَأَنْتُمْ تَعْلَمُونَ","numberInSurah":188,"juz":2,"manzil":1,"page":29,"ruku":24,"hizbQuarter":11,"sajda":false},{"number":196,"text":"۞ يَسْأَلُونَكَ عَنِ الْأَهِلَّةِ ۖ قُلْ هِيَ مَوَاقِيتُ لِلنَّاسِ وَالْحَجِّ ۗ وَلَيْسَ الْبِرُّ بِأَنْ تَأْتُوا الْبُيُوتَ مِنْ ظُهُورِهَا وَلَٰكِنَّ الْبِرَّ مَنِ اتَّقَىٰ ۗ وَأْتُوا الْبُيُوتَ مِنْ أَبْوَابِهَا ۚ وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُفْلِحُونَ","numberInSurah":189,"juz":2,"manzil":1,"page":29,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":197,"text":"وَقَاتِلُوا فِي سَبِيلِ اللَّهِ الَّذِينَ يُقَاتِلُونَكُمْ وَلَا تَعْتَدُوا ۚ إِنَّ اللَّهَ لَا يُحِبُّ الْمُعْتَدِينَ","numberInSurah":190,"juz":2,"manzil":1,"page":29,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":198,"text":"وَاقْتُلُوهُمْ حَيْثُ ثَقِفْتُمُوهُمْ وَأَخْرِجُوهُمْ مِنْ حَيْثُ أَخْرَجُوكُمْ ۚ وَالْفِتْنَةُ أَشَدُّ مِنَ الْقَتْلِ ۚ وَلَا تُقَاتِلُوهُمْ عِنْدَ الْمَسْجِدِ الْحَرَامِ حَتَّىٰ يُقَاتِلُوكُمْ فِيهِ ۖ فَإِنْ قَاتَلُوكُمْ فَاقْتُلُوهُمْ ۗ كَذَٰلِكَ جَزَاءُ الْكَافِرِينَ","numberInSurah":191,"juz":2,"manzil":1,"page":30,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":199,"text":"فَإِنِ انْتَهَوْا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","numberInSurah":192,"juz":2,"manzil":1,"page":30,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":200,"text":"وَقَاتِلُوهُمْ حَتَّىٰ لَا تَكُونَ فِتْنَةٌ وَيَكُونَ الدِّينُ لِلَّهِ ۖ فَإِنِ انْتَهَوْا فَلَا عُدْوَانَ إِلَّا عَلَى الظَّالِمِينَ","numberInSurah":193,"juz":2,"manzil":1,"page":30,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":201,"text":"الشَّهْرُ الْحَرَامُ بِالشَّهْرِ الْحَرَامِ وَالْحُرُمَاتُ قِصَاصٌ ۚ فَمَنِ اعْتَدَىٰ عَلَيْكُمْ فَاعْتَدُوا عَلَيْهِ بِمِثْلِ مَا اعْتَدَىٰ عَلَيْكُمْ ۚ وَاتَّقُوا اللَّهَ وَاعْلَمُوا أَنَّ اللَّهَ مَعَ الْمُتَّقِينَ","numberInSurah":194,"juz":2,"manzil":1,"page":30,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":202,"text":"وَأَنْفِقُوا فِي سَبِيلِ اللَّهِ وَلَا تُلْقُوا بِأَيْدِيكُمْ إِلَى التَّهْلُكَةِ ۛ وَأَحْسِنُوا ۛ إِنَّ اللَّهَ يُحِبُّ الْمُحْسِنِينَ","numberInSurah":195,"juz":2,"manzil":1,"page":30,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":203,"text":"وَأَتِمُّوا الْحَجَّ وَالْعُمْرَةَ لِلَّهِ ۚ فَإِنْ أُحْصِرْتُمْ فَمَا اسْتَيْسَرَ مِنَ الْهَدْيِ ۖ وَلَا تَحْلِقُوا رُءُوسَكُمْ حَتَّىٰ يَبْلُغَ الْهَدْيُ مَحِلَّهُ ۚ فَمَنْ كَانَ مِنْكُمْ مَرِيضًا أَوْ بِهِ أَذًى مِنْ رَأْسِهِ فَفِدْيَةٌ مِنْ صِيَامٍ أَوْ صَدَقَةٍ أَوْ نُسُكٍ ۚ فَإِذَا أَمِنْتُمْ فَمَنْ تَمَتَّعَ بِالْعُمْرَةِ إِلَى الْحَجِّ فَمَا اسْتَيْسَرَ مِنَ الْهَدْيِ ۚ فَمَنْ لَمْ يَجِدْ فَصِيَامُ ثَلَاثَةِ أَيَّامٍ فِي الْحَجِّ وَسَبْعَةٍ إِذَا رَجَعْتُمْ ۗ تِلْكَ عَشَرَةٌ كَامِلَةٌ ۗ ذَٰلِكَ لِمَنْ لَمْ يَكُنْ أَهْلُهُ حَاضِرِي الْمَسْجِدِ الْحَرَامِ ۚ وَاتَّقُوا اللَّهَ وَاعْلَمُوا أَنَّ اللَّهَ شَدِيدُ الْعِقَابِ","numberInSurah":196,"juz":2,"manzil":1,"page":30,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":204,"text":"الْحَجُّ أَشْهُرٌ مَعْلُومَاتٌ ۚ فَمَنْ فَرَضَ فِيهِنَّ الْحَجَّ فَلَا رَفَثَ وَلَا فُسُوقَ وَلَا جِدَالَ فِي الْحَجِّ ۗ وَمَا تَفْعَلُوا مِنْ خَيْرٍ يَعْلَمْهُ اللَّهُ ۗ وَتَزَوَّدُوا فَإِنَّ خَيْرَ الزَّادِ التَّقْوَىٰ ۚ وَاتَّقُونِ يَا أُولِي الْأَلْبَابِ","numberInSurah":197,"juz":2,"manzil":1,"page":31,"ruku":26,"hizbQuarter":12,"sajda":false},{"number":205,"text":"لَيْسَ عَلَيْكُمْ جُنَاحٌ أَنْ تَبْتَغُوا فَضْلًا مِنْ رَبِّكُمْ ۚ فَإِذَا أَفَضْتُمْ مِنْ عَرَفَاتٍ فَاذْكُرُوا اللَّهَ عِنْدَ الْمَشْعَرِ الْحَرَامِ ۖ وَاذْكُرُوهُ كَمَا هَدَاكُمْ وَإِنْ كُنْتُمْ مِنْ قَبْلِهِ لَمِنَ الضَّالِّينَ","numberInSurah":198,"juz":2,"manzil":1,"page":31,"ruku":26,"hizbQuarter":12,"sajda":false},{"number":206,"text":"ثُمَّ أَفِيضُوا مِنْ حَيْثُ أَفَاضَ النَّاسُ وَاسْتَغْفِرُوا اللَّهَ ۚ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","numberInSurah":199,"juz":2,"manzil":1,"page":31,"ruku":26,"hizbQuarter":12,"sajda":false},{"number":207,"text":"فَإِذَا قَضَيْتُمْ مَنَاسِكَكُمْ فَاذْكُرُوا اللَّهَ كَذِكْرِكُمْ آبَاءَكُمْ أَوْ أَشَدَّ ذِكْرًا ۗ فَمِنَ النَّاسِ مَنْ يَقُولُ رَبَّنَا آتِنَا فِي الدُّنْيَا وَمَا لَهُ فِي الْآخِرَةِ مِنْ خَلَاقٍ","numberInSurah":200,"juz":2,"manzil":1,"page":31,"ruku":26,"hizbQuarter":12,"sajda":false},{"number":208,"text":"وَمِنْهُمْ مَنْ يَقُولُ رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ","numberInSurah":201,"juz":2,"manzil":1,"page":31,"ruku":26,"hizbQuarter":12,"sajda":false},{"number":209,"text":"أُولَٰئِكَ لَهُمْ نَصِيبٌ مِمَّا كَسَبُوا ۚ وَاللَّهُ سَرِيعُ الْحِسَابِ","numberInSurah":202,"juz":2,"manzil":1,"page":31,"ruku":26,"hizbQuarter":12,"sajda":false},{"number":210,"text":"۞ وَاذْكُرُوا اللَّهَ فِي أَيَّامٍ مَعْدُودَاتٍ ۚ فَمَنْ تَعَجَّلَ فِي يَوْمَيْنِ فَلَا إِثْمَ عَلَيْهِ وَمَنْ تَأَخَّرَ فَلَا إِثْمَ عَلَيْهِ ۚ لِمَنِ اتَّقَىٰ ۗ وَاتَّقُوا اللَّهَ وَاعْلَمُوا أَنَّكُمْ إِلَيْهِ تُحْشَرُونَ","numberInSurah":203,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":211,"text":"وَمِنَ النَّاسِ مَنْ يُعْجِبُكَ قَوْلُهُ فِي الْحَيَاةِ الدُّنْيَا وَيُشْهِدُ اللَّهَ عَلَىٰ مَا فِي قَلْبِهِ وَهُوَ أَلَدُّ الْخِصَامِ","numberInSurah":204,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":212,"text":"وَإِذَا تَوَلَّىٰ سَعَىٰ فِي الْأَرْضِ لِيُفْسِدَ فِيهَا وَيُهْلِكَ الْحَرْثَ وَالنَّسْلَ ۗ وَاللَّهُ لَا يُحِبُّ الْفَسَادَ","numberInSurah":205,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":213,"text":"وَإِذَا قِيلَ لَهُ اتَّقِ اللَّهَ أَخَذَتْهُ الْعِزَّةُ بِالْإِثْمِ ۚ فَحَسْبُهُ جَهَنَّمُ ۚ وَلَبِئْسَ الْمِهَادُ","numberInSurah":206,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":214,"text":"وَمِنَ النَّاسِ مَنْ يَشْرِي نَفْسَهُ ابْتِغَاءَ مَرْضَاتِ اللَّهِ ۗ وَاللَّهُ رَءُوفٌ بِالْعِبَادِ","numberInSurah":207,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":215,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا ادْخُلُوا فِي السِّلْمِ كَافَّةً وَلَا تَتَّبِعُوا خُطُوَاتِ الشَّيْطَانِ ۚ إِنَّهُ لَكُمْ عَدُوٌّ مُبِينٌ","numberInSurah":208,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":216,"text":"فَإِنْ زَلَلْتُمْ مِنْ بَعْدِ مَا جَاءَتْكُمُ الْبَيِّنَاتُ فَاعْلَمُوا أَنَّ اللَّهَ عَزِيزٌ حَكِيمٌ","numberInSurah":209,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":217,"text":"هَلْ يَنْظُرُونَ إِلَّا أَنْ يَأْتِيَهُمُ اللَّهُ فِي ظُلَلٍ مِنَ الْغَمَامِ وَالْمَلَائِكَةُ وَقُضِيَ الْأَمْرُ ۚ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","numberInSurah":210,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":218,"text":"سَلْ بَنِي إِسْرَائِيلَ كَمْ آتَيْنَاهُمْ مِنْ آيَةٍ بَيِّنَةٍ ۗ وَمَنْ يُبَدِّلْ نِعْمَةَ اللَّهِ مِنْ بَعْدِ مَا جَاءَتْهُ فَإِنَّ اللَّهَ شَدِيدُ الْعِقَابِ","numberInSurah":211,"juz":2,"manzil":1,"page":33,"ruku":27,"hizbQuarter":13,"sajda":false},{"number":219,"text":"زُيِّنَ لِلَّذِينَ كَفَرُوا الْحَيَاةُ الدُّنْيَا وَيَسْخَرُونَ مِنَ الَّذِينَ آمَنُوا ۘ وَالَّذِينَ اتَّقَوْا فَوْقَهُمْ يَوْمَ الْقِيَامَةِ ۗ وَاللَّهُ يَرْزُقُ مَنْ يَشَاءُ بِغَيْرِ حِسَابٍ","numberInSurah":212,"juz":2,"manzil":1,"page":33,"ruku":27,"hizbQuarter":13,"sajda":false},{"number":220,"text":"كَانَ النَّاسُ أُمَّةً وَاحِدَةً فَبَعَثَ اللَّهُ النَّبِيِّينَ مُبَشِّرِينَ وَمُنْذِرِينَ وَأَنْزَلَ مَعَهُمُ الْكِتَابَ بِالْحَقِّ لِيَحْكُمَ بَيْنَ النَّاسِ فِيمَا اخْتَلَفُوا فِيهِ ۚ وَمَا اخْتَلَفَ فِيهِ إِلَّا الَّذِينَ أُوتُوهُ مِنْ بَعْدِ مَا جَاءَتْهُمُ الْبَيِّنَاتُ بَغْيًا بَيْنَهُمْ ۖ فَهَدَى اللَّهُ الَّذِينَ آمَنُوا لِمَا اخْتَلَفُوا فِيهِ مِنَ الْحَقِّ بِإِذْنِهِ ۗ وَاللَّهُ يَهْدِي مَنْ يَشَاءُ إِلَىٰ صِرَاطٍ مُسْتَقِيمٍ","numberInSurah":213,"juz":2,"manzil":1,"page":33,"ruku":27,"hizbQuarter":13,"sajda":false},{"number":221,"text":"أَمْ حَسِبْتُمْ أَنْ تَدْخُلُوا الْجَنَّةَ وَلَمَّا يَأْتِكُمْ مَثَلُ الَّذِينَ خَلَوْا مِنْ قَبْلِكُمْ ۖ مَسَّتْهُمُ الْبَأْسَاءُ وَالضَّرَّاءُ وَزُلْزِلُوا حَتَّىٰ يَقُولَ الرَّسُولُ وَالَّذِينَ آمَنُوا مَعَهُ مَتَىٰ نَصْرُ اللَّهِ ۗ أَلَا إِنَّ نَصْرَ اللَّهِ قَرِيبٌ","numberInSurah":214,"juz":2,"manzil":1,"page":33,"ruku":27,"hizbQuarter":13,"sajda":false},{"number":222,"text":"يَسْأَلُونَكَ مَاذَا يُنْفِقُونَ ۖ قُلْ مَا أَنْفَقْتُمْ مِنْ خَيْرٍ فَلِلْوَالِدَيْنِ وَالْأَقْرَبِينَ وَالْيَتَامَىٰ وَالْمَسَاكِينِ وَابْنِ السَّبِيلِ ۗ وَمَا تَفْعَلُوا مِنْ خَيْرٍ فَإِنَّ اللَّهَ بِهِ عَلِيمٌ","numberInSurah":215,"juz":2,"manzil":1,"page":33,"ruku":27,"hizbQuarter":13,"sajda":false},{"number":223,"text":"كُتِبَ عَلَيْكُمُ الْقِتَالُ وَهُوَ كُرْهٌ لَكُمْ ۖ وَعَسَىٰ أَنْ تَكْرَهُوا شَيْئًا وَهُوَ خَيْرٌ لَكُمْ ۖ وَعَسَىٰ أَنْ تُحِبُّوا شَيْئًا وَهُوَ شَرٌّ لَكُمْ ۗ وَاللَّهُ يَعْلَمُ وَأَنْتُمْ لَا تَعْلَمُونَ","numberInSurah":216,"juz":2,"manzil":1,"page":34,"ruku":27,"hizbQuarter":13,"sajda":false},{"number":224,"text":"يَسْأَلُونَكَ عَنِ الشَّهْرِ الْحَرَامِ قِتَالٍ فِيهِ ۖ قُلْ قِتَالٌ فِيهِ كَبِيرٌ ۖ وَصَدٌّ عَنْ سَبِيلِ اللَّهِ وَكُفْرٌ بِهِ وَالْمَسْجِدِ الْحَرَامِ وَإِخْرَاجُ أَهْلِهِ مِنْهُ أَكْبَرُ عِنْدَ اللَّهِ ۚ وَالْفِتْنَةُ أَكْبَرُ مِنَ الْقَتْلِ ۗ وَلَا يَزَالُونَ يُقَاتِلُونَكُمْ حَتَّىٰ يَرُدُّوكُمْ عَنْ دِينِكُمْ إِنِ اسْتَطَاعُوا ۚ وَمَنْ يَرْتَدِدْ مِنْكُمْ عَنْ دِينِهِ فَيَمُتْ وَهُوَ كَافِرٌ فَأُولَٰئِكَ حَبِطَتْ أَعْمَالُهُمْ فِي الدُّنْيَا وَالْآخِرَةِ ۖ وَأُولَٰئِكَ أَصْحَابُ النَّارِ ۖ هُمْ فِيهَا خَالِدُونَ","numberInSurah":217,"juz":2,"manzil":1,"page":34,"ruku":28,"hizbQuarter":13,"sajda":false},{"number":225,"text":"إِنَّ الَّذِينَ آمَنُوا وَالَّذِينَ هَاجَرُوا وَجَاهَدُوا فِي سَبِيلِ اللَّهِ أُولَٰئِكَ يَرْجُونَ رَحْمَتَ اللَّهِ ۚ وَاللَّهُ غَفُورٌ رَحِيمٌ","numberInSurah":218,"juz":2,"manzil":1,"page":34,"ruku":28,"hizbQuarter":13,"sajda":false},{"number":226,"text":"۞ يَسْأَلُونَكَ عَنِ الْخَمْرِ وَالْمَيْسِرِ ۖ قُلْ فِيهِمَا إِثْمٌ كَبِيرٌ وَمَنَافِعُ لِلنَّاسِ وَإِثْمُهُمَا أَكْبَرُ مِنْ نَفْعِهِمَا ۗ وَيَسْأَلُونَكَ مَاذَا يُنْفِقُونَ قُلِ الْعَفْوَ ۗ كَذَٰلِكَ يُبَيِّنُ اللَّهُ لَكُمُ الْآيَاتِ لَعَلَّكُمْ تَتَفَكَّرُونَ","numberInSurah":219,"juz":2,"manzil":1,"page":34,"ruku":28,"hizbQuarter":14,"sajda":false},{"number":227,"text":"فِي الدُّنْيَا وَالْآخِرَةِ ۗ وَيَسْأَلُونَكَ عَنِ الْيَتَامَىٰ ۖ قُلْ إِصْلَاحٌ لَهُمْ خَيْرٌ ۖ وَإِنْ تُخَالِطُوهُمْ فَإِخْوَانُكُمْ ۚ وَاللَّهُ يَعْلَمُ الْمُفْسِدَ مِنَ الْمُصْلِحِ ۚ وَلَوْ شَاءَ اللَّهُ لَأَعْنَتَكُمْ ۚ إِنَّ اللَّهَ عَزِيزٌ حَكِيمٌ","numberInSurah":220,"juz":2,"manzil":1,"page":35,"ruku":28,"hizbQuarter":14,"sajda":false},{"number":228,"text":"وَلَا تَنْكِحُوا الْمُشْرِكَاتِ حَتَّىٰ يُؤْمِنَّ ۚ وَلَأَمَةٌ مُؤْمِنَةٌ خَيْرٌ مِنْ مُشْرِكَةٍ وَلَوْ أَعْجَبَتْكُمْ ۗ وَلَا تُنْكِحُوا الْمُشْرِكِينَ حَتَّىٰ يُؤْمِنُوا ۚ وَلَعَبْدٌ مُؤْمِنٌ خَيْرٌ مِنْ مُشْرِكٍ وَلَوْ أَعْجَبَكُمْ ۗ أُولَٰئِكَ يَدْعُونَ إِلَى النَّارِ ۖ وَاللَّهُ يَدْعُو إِلَى الْجَنَّةِ وَالْمَغْفِرَةِ بِإِذْنِهِ ۖ وَيُبَيِّنُ آيَاتِهِ لِلنَّاسِ لَعَلَّهُمْ يَتَذَكَّرُونَ","numberInSurah":221,"juz":2,"manzil":1,"page":35,"ruku":28,"hizbQuarter":14,"sajda":false},{"number":229,"text":"وَيَسْأَلُونَكَ عَنِ الْمَحِيضِ ۖ قُلْ هُوَ أَذًى فَاعْتَزِلُوا النِّسَاءَ فِي الْمَحِيضِ ۖ وَلَا تَقْرَبُوهُنَّ حَتَّىٰ يَطْهُرْنَ ۖ فَإِذَا تَطَهَّرْنَ فَأْتُوهُنَّ مِنْ حَيْثُ أَمَرَكُمُ اللَّهُ ۚ إِنَّ اللَّهَ يُحِبُّ التَّوَّابِينَ وَيُحِبُّ الْمُتَطَهِّرِينَ","numberInSurah":222,"juz":2,"manzil":1,"page":35,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":230,"text":"نِسَاؤُكُمْ حَرْثٌ لَكُمْ فَأْتُوا حَرْثَكُمْ أَنَّىٰ شِئْتُمْ ۖ وَقَدِّمُوا لِأَنْفُسِكُمْ ۚ وَاتَّقُوا اللَّهَ وَاعْلَمُوا أَنَّكُمْ مُلَاقُوهُ ۗ وَبَشِّرِ الْمُؤْمِنِينَ","numberInSurah":223,"juz":2,"manzil":1,"page":35,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":231,"text":"وَلَا تَجْعَلُوا اللَّهَ عُرْضَةً لِأَيْمَانِكُمْ أَنْ تَبَرُّوا وَتَتَّقُوا وَتُصْلِحُوا بَيْنَ النَّاسِ ۗ وَاللَّهُ سَمِيعٌ عَلِيمٌ","numberInSurah":224,"juz":2,"manzil":1,"page":35,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":232,"text":"لَا يُؤَاخِذُكُمُ اللَّهُ بِاللَّغْوِ فِي أَيْمَانِكُمْ وَلَٰكِنْ يُؤَاخِذُكُمْ بِمَا كَسَبَتْ قُلُوبُكُمْ ۗ وَاللَّهُ غَفُورٌ حَلِيمٌ","numberInSurah":225,"juz":2,"manzil":1,"page":36,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":233,"text":"لِلَّذِينَ يُؤْلُونَ مِنْ نِسَائِهِمْ تَرَبُّصُ أَرْبَعَةِ أَشْهُرٍ ۖ فَإِنْ فَاءُوا فَإِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","numberInSurah":226,"juz":2,"manzil":1,"page":36,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":234,"text":"وَإِنْ عَزَمُوا الطَّلَاقَ فَإِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ","numberInSurah":227,"juz":2,"manzil":1,"page":36,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":235,"text":"وَالْمُطَلَّقَاتُ يَتَرَبَّصْنَ بِأَنْفُسِهِنَّ ثَلَاثَةَ قُرُوءٍ ۚ وَلَا يَحِلُّ لَهُنَّ أَنْ يَكْتُمْنَ مَا خَلَقَ اللَّهُ فِي أَرْحَامِهِنَّ إِنْ كُنَّ يُؤْمِنَّ بِاللَّهِ وَالْيَوْمِ الْآخِرِ ۚ وَبُعُولَتُهُنَّ أَحَقُّ بِرَدِّهِنَّ فِي ذَٰلِكَ إِنْ أَرَادُوا إِصْلَاحًا ۚ وَلَهُنَّ مِثْلُ الَّذِي عَلَيْهِنَّ بِالْمَعْرُوفِ ۚ وَلِلرِّجَالِ عَلَيْهِنَّ دَرَجَةٌ ۗ وَاللَّهُ عَزِيزٌ حَكِيمٌ","numberInSurah":228,"juz":2,"manzil":1,"page":36,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":236,"text":"الطَّلَاقُ مَرَّتَانِ ۖ فَإِمْسَاكٌ بِمَعْرُوفٍ أَوْ تَسْرِيحٌ بِإِحْسَانٍ ۗ وَلَا يَحِلُّ لَكُمْ أَنْ تَأْخُذُوا مِمَّا آتَيْتُمُوهُنَّ شَيْئًا إِلَّا أَنْ يَخَافَا أَلَّا يُقِيمَا حُدُودَ اللَّهِ ۖ فَإِنْ خِفْتُمْ أَلَّا يُقِيمَا حُدُودَ اللَّهِ فَلَا جُنَاحَ عَلَيْهِمَا فِيمَا افْتَدَتْ بِهِ ۗ تِلْكَ حُدُودُ اللَّهِ فَلَا تَعْتَدُوهَا ۚ وَمَنْ يَتَعَدَّ حُدُودَ اللَّهِ فَأُولَٰئِكَ هُمُ الظَّالِمُونَ","numberInSurah":229,"juz":2,"manzil":1,"page":36,"ruku":30,"hizbQuarter":14,"sajda":false},{"number":237,"text":"فَإِنْ طَلَّقَهَا فَلَا تَحِلُّ لَهُ مِنْ بَعْدُ حَتَّىٰ تَنْكِحَ زَوْجًا غَيْرَهُ ۗ فَإِنْ طَلَّقَهَا فَلَا جُنَاحَ عَلَيْهِمَا أَنْ يَتَرَاجَعَا إِنْ ظَنَّا أَنْ يُقِيمَا حُدُودَ اللَّهِ ۗ وَتِلْكَ حُدُودُ اللَّهِ يُبَيِّنُهَا لِقَوْمٍ يَعْلَمُونَ","numberInSurah":230,"juz":2,"manzil":1,"page":36,"ruku":30,"hizbQuarter":14,"sajda":false},{"number":238,"text":"وَإِذَا طَلَّقْتُمُ النِّسَاءَ فَبَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ سَرِّحُوهُنَّ بِمَعْرُوفٍ ۚ وَلَا تُمْسِكُوهُنَّ ضِرَارًا لِتَعْتَدُوا ۚ وَمَنْ يَفْعَلْ ذَٰلِكَ فَقَدْ ظَلَمَ نَفْسَهُ ۚ وَلَا تَتَّخِذُوا آيَاتِ اللَّهِ هُزُوًا ۚ وَاذْكُرُوا نِعْمَتَ اللَّهِ عَلَيْكُمْ وَمَا أَنْزَلَ عَلَيْكُمْ مِنَ الْكِتَابِ وَالْحِكْمَةِ يَعِظُكُمْ بِهِ ۚ وَاتَّقُوا اللَّهَ وَاعْلَمُوا أَنَّ اللَّهَ بِكُلِّ شَيْءٍ عَلِيمٌ","numberInSurah":231,"juz":2,"manzil":1,"page":37,"ruku":30,"hizbQuarter":14,"sajda":false},{"number":239,"text":"وَإِذَا طَلَّقْتُمُ النِّسَاءَ فَبَلَغْنَ أَجَلَهُنَّ فَلَا تَعْضُلُوهُنَّ أَنْ يَنْكِحْنَ أَزْوَاجَهُنَّ إِذَا تَرَاضَوْا بَيْنَهُمْ بِالْمَعْرُوفِ ۗ ذَٰلِكَ يُوعَظُ بِهِ مَنْ كَانَ مِنْكُمْ يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ ۗ ذَٰلِكُمْ أَزْكَىٰ لَكُمْ وَأَطْهَرُ ۗ وَاللَّهُ يَعْلَمُ وَأَنْتُمْ لَا تَعْلَمُونَ","numberInSurah":232,"juz":2,"manzil":1,"page":37,"ruku":31,"hizbQuarter":14,"sajda":false},{"number":240,"text":"۞ وَالْوَالِدَاتُ يُرْضِعْنَ أَوْلَادَهُنَّ حَوْلَيْنِ كَامِلَيْنِ ۖ لِمَنْ أَرَادَ أَنْ يُتِمَّ الرَّضَاعَةَ ۚ وَعَلَى الْمَوْلُودِ لَهُ رِزْقُهُنَّ وَكِسْوَتُهُنَّ بِالْمَعْرُوفِ ۚ لَا تُكَلَّفُ نَفْسٌ إِلَّا وُسْعَهَا ۚ لَا تُضَارَّ وَالِدَةٌ بِوَلَدِهَا وَلَا مَوْلُودٌ لَهُ بِوَلَدِهِ ۚ وَعَلَى الْوَارِثِ مِثْلُ ذَٰلِكَ ۗ فَإِنْ أَرَادَا فِصَالًا عَنْ تَرَاضٍ مِنْهُمَا وَتَشَاوُرٍ فَلَا جُنَاحَ عَلَيْهِمَا ۗ وَإِنْ أَرَدْتُمْ أَنْ تَسْتَرْضِعُوا أَوْلَادَكُمْ فَلَا جُنَاحَ عَلَيْكُمْ إِذَا سَلَّمْتُمْ مَا آتَيْتُمْ بِالْمَعْرُوفِ ۗ وَاتَّقُوا اللَّهَ وَاعْلَمُوا أَنَّ اللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ","numberInSurah":233,"juz":2,"manzil":1,"page":37,"ruku":31,"hizbQuarter":15,"sajda":false},{"number":241,"text":"وَالَّذِينَ يُتَوَفَّوْنَ مِنْكُمْ وَيَذَرُونَ أَزْوَاجًا يَتَرَبَّصْنَ بِأَنْفُسِهِنَّ أَرْبَعَةَ أَشْهُرٍ وَعَشْرًا ۖ فَإِذَا بَلَغْنَ أَجَلَهُنَّ فَلَا جُنَاحَ عَلَيْكُمْ فِيمَا فَعَلْنَ فِي أَنْفُسِهِنَّ بِالْمَعْرُوفِ ۗ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","numberInSurah":234,"juz":2,"manzil":1,"page":38,"ruku":31,"hizbQuarter":15,"sajda":false},{"number":242,"text":"وَلَا جُنَاحَ عَلَيْكُمْ فِيمَا عَرَّضْتُمْ بِهِ مِنْ خِطْبَةِ النِّسَاءِ أَوْ أَكْنَنْتُمْ فِي أَنْفُسِكُمْ ۚ عَلِمَ اللَّهُ أَنَّكُمْ سَتَذْكُرُونَهُنَّ وَلَٰكِنْ لَا تُوَاعِدُوهُنَّ سِرًّا إِلَّا أَنْ تَقُولُوا قَوْلًا مَعْرُوفًا ۚ وَلَا تَعْزِمُوا عُقْدَةَ النِّكَاحِ حَتَّىٰ يَبْلُغَ الْكِتَابُ أَجَلَهُ ۚ وَاعْلَمُوا أَنَّ اللَّهَ يَعْلَمُ مَا فِي أَنْفُسِكُمْ فَاحْذَرُوهُ ۚ وَاعْلَمُوا أَنَّ اللَّهَ غَفُورٌ حَلِيمٌ","numberInSurah":235,"juz":2,"manzil":1,"page":38,"ruku":31,"hizbQuarter":15,"sajda":false},{"number":243,"text":"لَا جُنَاحَ عَلَيْكُمْ إِنْ طَلَّقْتُمُ النِّسَاءَ مَا لَمْ تَمَسُّوهُنَّ أَوْ تَفْرِضُوا لَهُنَّ فَرِيضَةً ۚ وَمَتِّعُوهُنَّ عَلَى الْمُوسِعِ قَدَرُهُ وَعَلَى الْمُقْتِرِ قَدَرُهُ مَتَاعًا بِالْمَعْرُوفِ ۖ حَقًّا عَلَى الْمُحْسِنِينَ","numberInSurah":236,"juz":2,"manzil":1,"page":38,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":244,"text":"وَإِنْ طَلَّقْتُمُوهُنَّ مِنْ قَبْلِ أَنْ تَمَسُّوهُنَّ وَقَدْ فَرَضْتُمْ لَهُنَّ فَرِيضَةً فَنِصْفُ مَا فَرَضْتُمْ إِلَّا أَنْ يَعْفُونَ أَوْ يَعْفُوَ الَّذِي بِيَدِهِ عُقْدَةُ النِّكَاحِ ۚ وَأَنْ تَعْفُوا أَقْرَبُ لِلتَّقْوَىٰ ۚ وَلَا تَنْسَوُا الْفَضْلَ بَيْنَكُمْ ۚ إِنَّ اللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ","numberInSurah":237,"juz":2,"manzil":1,"page":38,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":245,"text":"حَافِظُوا عَلَى الصَّلَوَاتِ وَالصَّلَاةِ الْوُسْطَىٰ وَقُومُوا لِلَّهِ قَانِتِينَ","numberInSurah":238,"juz":2,"manzil":1,"page":39,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":246,"text":"فَإِنْ خِفْتُمْ فَرِجَالًا أَوْ رُكْبَانًا ۖ فَإِذَا أَمِنْتُمْ فَاذْكُرُوا اللَّهَ كَمَا عَلَّمَكُمْ مَا لَمْ تَكُونُوا تَعْلَمُونَ","numberInSurah":239,"juz":2,"manzil":1,"page":39,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":247,"text":"وَالَّذِينَ يُتَوَفَّوْنَ مِنْكُمْ وَيَذَرُونَ أَزْوَاجًا وَصِيَّةً لِأَزْوَاجِهِمْ مَتَاعًا إِلَى الْحَوْلِ غَيْرَ إِخْرَاجٍ ۚ فَإِنْ خَرَجْنَ فَلَا جُنَاحَ عَلَيْكُمْ فِي مَا فَعَلْنَ فِي أَنْفُسِهِنَّ مِنْ مَعْرُوفٍ ۗ وَاللَّهُ عَزِيزٌ حَكِيمٌ","numberInSurah":240,"juz":2,"manzil":1,"page":39,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":248,"text":"وَلِلْمُطَلَّقَاتِ مَتَاعٌ بِالْمَعْرُوفِ ۖ حَقًّا عَلَى الْمُتَّقِينَ","numberInSurah":241,"juz":2,"manzil":1,"page":39,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":249,"text":"كَذَٰلِكَ يُبَيِّنُ اللَّهُ لَكُمْ آيَاتِهِ لَعَلَّكُمْ تَعْقِلُونَ","numberInSurah":242,"juz":2,"manzil":1,"page":39,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":250,"text":"۞ أَلَمْ تَرَ إِلَى الَّذِينَ خَرَجُوا مِنْ دِيَارِهِمْ وَهُمْ أُلُوفٌ حَذَرَ الْمَوْتِ فَقَالَ لَهُمُ اللَّهُ مُوتُوا ثُمَّ أَحْيَاهُمْ ۚ إِنَّ اللَّهَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلَٰكِنَّ أَكْثَرَ النَّاسِ لَا يَشْكُرُونَ","numberInSurah":243,"juz":2,"manzil":1,"page":39,"ruku":33,"hizbQuarter":16,"sajda":false},{"number":251,"text":"وَقَاتِلُوا فِي سَبِيلِ اللَّهِ وَاعْلَمُوا أَنَّ اللَّهَ سَمِيعٌ عَلِيمٌ","numberInSurah":244,"juz":2,"manzil":1,"page":39,"ruku":33,"hizbQuarter":16,"sajda":false},{"number":252,"text":"مَنْ ذَا الَّذِي يُقْرِضُ اللَّهَ قَرْضًا حَسَنًا فَيُضَاعِفَهُ لَهُ أَضْعَافًا كَثِيرَةً ۚ وَاللَّهُ يَقْبِضُ وَيَبْسُطُ وَإِلَيْهِ تُرْجَعُونَ","numberInSurah":245,"juz":2,"manzil":1,"page":39,"ruku":33,"hizbQuarter":16,"sajda":false},{"number":253,"text":"أَلَمْ تَرَ إِلَى الْمَلَإِ مِنْ بَنِي إِسْرَائِيلَ مِنْ بَعْدِ مُوسَىٰ إِذْ قَالُوا لِنَبِيٍّ لَهُمُ ابْعَثْ لَنَا مَلِكًا نُقَاتِلْ فِي سَبِيلِ اللَّهِ ۖ قَالَ هَلْ عَسَيْتُمْ إِنْ كُتِبَ عَلَيْكُمُ الْقِتَالُ أَلَّا تُقَاتِلُوا ۖ قَالُوا وَمَا لَنَا أَلَّا نُقَاتِلَ فِي سَبِيلِ اللَّهِ وَقَدْ أُخْرِجْنَا مِنْ دِيَارِنَا وَأَبْنَائِنَا ۖ فَلَمَّا كُتِبَ عَلَيْهِمُ الْقِتَالُ تَوَلَّوْا إِلَّا قَلِيلًا مِنْهُمْ ۗ وَاللَّهُ عَلِيمٌ بِالظَّالِمِينَ","numberInSurah":246,"juz":2,"manzil":1,"page":40,"ruku":33,"hizbQuarter":16,"sajda":false},{"number":254,"text":"وَقَالَ لَهُمْ نَبِيُّهُمْ إِنَّ اللَّهَ قَدْ بَعَثَ لَكُمْ طَالُوتَ مَلِكًا ۚ قَالُوا أَنَّىٰ يَكُونُ لَهُ الْمُلْكُ عَلَيْنَا وَنَحْنُ أَحَقُّ بِالْمُلْكِ مِنْهُ وَلَمْ يُؤْتَ سَعَةً مِنَ الْمَالِ ۚ قَالَ إِنَّ اللَّهَ اصْطَفَاهُ عَلَيْكُمْ وَزَادَهُ بَسْطَةً فِي الْعِلْمِ وَالْجِسْمِ ۖ وَاللَّهُ يُؤْتِي مُلْكَهُ مَنْ يَشَاءُ ۚ وَاللَّهُ وَاسِعٌ عَلِيمٌ","numberInSurah":247,"juz":2,"manzil":1,"page":40,"ruku":33,"hizbQuarter":16,"sajda":false},{"number":255,"text":"وَقَالَ لَهُمْ نَبِيُّهُمْ إِنَّ آيَةَ مُلْكِهِ أَنْ يَأْتِيَكُمُ التَّابُوتُ فِيهِ سَكِينَةٌ مِنْ رَبِّكُمْ وَبَقِيَّةٌ مِمَّا تَرَكَ آلُ مُوسَىٰ وَآلُ هَارُونَ تَحْمِلُهُ الْمَلَائِكَةُ ۚ إِنَّ فِي ذَٰلِكَ لَآيَةً لَكُمْ إِنْ كُنْتُمْ مُؤْمِنِينَ","numberInSurah":248,"juz":2,"manzil":1,"page":40,"ruku":33,"hizbQuarter":16,"sajda":false},{"number":256,"text":"فَلَمَّا فَصَلَ طَالُوتُ بِالْجُنُودِ قَالَ إِنَّ اللَّهَ مُبْتَلِيكُمْ بِنَهَرٍ فَمَنْ شَرِبَ مِنْهُ فَلَيْسَ مِنِّي وَمَنْ لَمْ يَطْعَمْهُ فَإِنَّهُ مِنِّي إِلَّا مَنِ اغْتَرَفَ غُرْفَةً بِيَدِهِ ۚ فَشَرِبُوا مِنْهُ إِلَّا قَلِيلًا مِنْهُمْ ۚ فَلَمَّا جَاوَزَهُ هُوَ وَالَّذِينَ آمَنُوا مَعَهُ قَالُوا لَا طَاقَةَ لَنَا الْيَوْمَ بِجَالُوتَ وَجُنُودِهِ ۚ قَالَ الَّذِينَ يَظُنُّونَ أَنَّهُمْ مُلَاقُو اللَّهِ كَمْ مِنْ فِئَةٍ قَلِيلَةٍ غَلَبَتْ فِئَةً كَثِيرَةً بِإِذْنِ اللَّهِ ۗ وَاللَّهُ مَعَ الصَّابِرِينَ","numberInSurah":249,"juz":2,"manzil":1,"page":41,"ruku":34,"hizbQuarter":16,"sajda":false},{"number":257,"text":"وَلَمَّا بَرَزُوا لِجَالُوتَ وَجُنُودِهِ قَالُوا رَبَّنَا أَفْرِغْ عَلَيْنَا صَبْرًا وَثَبِّتْ أَقْدَامَنَا وَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ","numberInSurah":250,"juz":2,"manzil":1,"page":41,"ruku":34,"hizbQuarter":16,"sajda":false},{"number":258,"text":"فَهَزَمُوهُمْ بِإِذْنِ اللَّهِ وَقَتَلَ دَاوُودُ جَالُوتَ وَآتَاهُ اللَّهُ الْمُلْكَ وَالْحِكْمَةَ وَعَلَّمَهُ مِمَّا يَشَاءُ ۗ وَلَوْلَا دَفْعُ اللَّهِ النَّاسَ بَعْضَهُمْ بِبَعْضٍ لَفَسَدَتِ الْأَرْضُ وَلَٰكِنَّ اللَّهَ ذُو فَضْلٍ عَلَى الْعَالَمِينَ","numberInSurah":251,"juz":2,"manzil":1,"page":41,"ruku":34,"hizbQuarter":16,"sajda":false},{"number":259,"text":"تِلْكَ آيَاتُ اللَّهِ نَتْلُوهَا عَلَيْكَ بِالْحَقِّ ۚ وَإِنَّكَ لَمِنَ الْمُرْسَلِينَ","numberInSurah":252,"juz":2,"manzil":1,"page":41,"ruku":34,"hizbQuarter":16,"sajda":false},{"number":260,"text":"۞ تِلْكَ الرُّسُلُ فَضَّلْنَا بَعْضَهُمْ عَلَىٰ بَعْضٍ ۘ مِنْهُمْ مَنْ كَلَّمَ اللَّهُ ۖ وَرَفَعَ بَعْضَهُمْ دَرَجَاتٍ ۚ وَآتَيْنَا عِيسَى ابْنَ مَرْيَمَ الْبَيِّنَاتِ وَأَيَّدْنَاهُ بِرُوحِ الْقُدُسِ ۗ وَلَوْ شَاءَ اللَّهُ مَا اقْتَتَلَ الَّذِينَ مِنْ بَعْدِهِمْ مِنْ بَعْدِ مَا جَاءَتْهُمُ الْبَيِّنَاتُ وَلَٰكِنِ اخْتَلَفُوا فَمِنْهُمْ مَنْ آمَنَ وَمِنْهُمْ مَنْ كَفَرَ ۚ وَلَوْ شَاءَ اللَّهُ مَا اقْتَتَلُوا وَلَٰكِنَّ اللَّهَ يَفْعَلُ مَا يُرِيدُ","numberInSurah":253,"juz":3,"manzil":1,"page":42,"ruku":34,"hizbQuarter":17,"sajda":false},{"number":261,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا أَنْفِقُوا مِمَّا رَزَقْنَاكُمْ مِنْ قَبْلِ أَنْ يَأْتِيَ يَوْمٌ لَا بَيْعٌ فِيهِ وَلَا خُلَّةٌ وَلَا شَفَاعَةٌ ۗ وَالْكَافِرُونَ هُمُ الظَّالِمُونَ","numberInSurah":254,"juz":3,"manzil":1,"page":42,"ruku":35,"hizbQuarter":17,"sajda":false},{"number":262,"text":"اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ ۚ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ ۚ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ مَنْ ذَا الَّذِي يَشْفَعُ عِنْدَهُ إِلَّا بِإِذْنِهِ ۚ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ ۖ وَلَا يُحِيطُونَ بِشَيْءٍ مِنْ عِلْمِهِ إِلَّا بِمَا شَاءَ ۚ وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ ۖ وَلَا يَئُودُهُ حِفْظُهُمَا ۚ وَهُوَ الْعَلِيُّ الْعَظِيمُ","numberInSurah":255,"juz":3,"manzil":1,"page":42,"ruku":35,"hizbQuarter":17,"sajda":false},{"number":263,"text":"لَا إِكْرَاهَ فِي الدِّينِ ۖ قَدْ تَبَيَّنَ الرُّشْدُ مِنَ الْغَيِّ ۚ فَمَنْ يَكْفُرْ بِالطَّاغُوتِ وَيُؤْمِنْ بِاللَّهِ فَقَدِ اسْتَمْسَكَ بِالْعُرْوَةِ الْوُثْقَىٰ لَا انْفِصَامَ لَهَا ۗ وَاللَّهُ سَمِيعٌ عَلِيمٌ","numberInSurah":256,"juz":3,"manzil":1,"page":42,"ruku":35,"hizbQuarter":17,"sajda":false},{"number":264,"text":"اللَّهُ وَلِيُّ الَّذِينَ آمَنُوا يُخْرِجُهُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ ۖ وَالَّذِينَ كَفَرُوا أَوْلِيَاؤُهُمُ الطَّاغُوتُ يُخْرِجُونَهُمْ مِنَ النُّورِ إِلَى الظُّلُمَاتِ ۗ أُولَٰئِكَ أَصْحَابُ النَّارِ ۖ هُمْ فِيهَا خَالِدُونَ","numberInSurah":257,"juz":3,"manzil":1,"page":43,"ruku":35,"hizbQuarter":17,"sajda":false},{"number":265,"text":"أَلَمْ تَرَ إِلَى الَّذِي حَاجَّ إِبْرَاهِيمَ فِي رَبِّهِ أَنْ آتَاهُ اللَّهُ الْمُلْكَ إِذْ قَالَ إِبْرَاهِيمُ رَبِّيَ الَّذِي يُحْيِي وَيُمِيتُ قَالَ أَنَا أُحْيِي وَأُمِيتُ ۖ قَالَ إِبْرَاهِيمُ فَإِنَّ اللَّهَ يَأْتِي بِالشَّمْسِ مِنَ الْمَشْرِقِ فَأْتِ بِهَا مِنَ الْمَغْرِبِ فَبُهِتَ الَّذِي كَفَرَ ۗ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الظَّالِمِينَ","numberInSurah":258,"juz":3,"manzil":1,"page":43,"ruku":36,"hizbQuarter":17,"sajda":false},{"number":266,"text":"أَوْ كَالَّذِي مَرَّ عَلَىٰ قَرْيَةٍ وَهِيَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا قَالَ أَنَّىٰ يُحْيِي هَٰذِهِ اللَّهُ بَعْدَ مَوْتِهَا ۖ فَأَمَاتَهُ اللَّهُ مِائَةَ عَامٍ ثُمَّ بَعَثَهُ ۖ قَالَ كَمْ لَبِثْتَ ۖ قَالَ لَبِثْتُ يَوْمًا أَوْ بَعْضَ يَوْمٍ ۖ قَالَ بَلْ لَبِثْتَ مِائَةَ عَامٍ فَانْظُرْ إِلَىٰ طَعَامِكَ وَشَرَابِكَ لَمْ يَتَسَنَّهْ ۖ وَانْظُرْ إِلَىٰ حِمَارِكَ وَلِنَجْعَلَكَ آيَةً لِلنَّاسِ ۖ وَانْظُرْ إِلَى الْعِظَامِ كَيْفَ نُنْشِزُهَا ثُمَّ نَكْسُوهَا لَحْمًا ۚ فَلَمَّا تَبَيَّنَ لَهُ قَالَ أَعْلَمُ أَنَّ اللَّهَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":259,"juz":3,"manzil":1,"page":43,"ruku":36,"hizbQuarter":17,"sajda":false},{"number":267,"text":"وَإِذْ قَالَ إِبْرَاهِيمُ رَبِّ أَرِنِي كَيْفَ تُحْيِي الْمَوْتَىٰ ۖ قَالَ أَوَلَمْ تُؤْمِنْ ۖ قَالَ بَلَىٰ وَلَٰكِنْ لِيَطْمَئِنَّ قَلْبِي ۖ قَالَ فَخُذْ أَرْبَعَةً مِنَ الطَّيْرِ فَصُرْهُنَّ إِلَيْكَ ثُمَّ اجْعَلْ عَلَىٰ كُلِّ جَبَلٍ مِنْهُنَّ جُزْءًا ثُمَّ ادْعُهُنَّ يَأْتِينَكَ سَعْيًا ۚ وَاعْلَمْ أَنَّ اللَّهَ عَزِيزٌ حَكِيمٌ","numberInSurah":260,"juz":3,"manzil":1,"page":44,"ruku":36,"hizbQuarter":17,"sajda":false},{"number":268,"text":"مَثَلُ الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ كَمَثَلِ حَبَّةٍ أَنْبَتَتْ سَبْعَ سَنَابِلَ فِي كُلِّ سُنْبُلَةٍ مِائَةُ حَبَّةٍ ۗ وَاللَّهُ يُضَاعِفُ لِمَنْ يَشَاءُ ۗ وَاللَّهُ وَاسِعٌ عَلِيمٌ","numberInSurah":261,"juz":3,"manzil":1,"page":44,"ruku":37,"hizbQuarter":17,"sajda":false},{"number":269,"text":"الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ فِي سَبِيلِ اللَّهِ ثُمَّ لَا يُتْبِعُونَ مَا أَنْفَقُوا مَنًّا وَلَا أَذًى ۙ لَهُمْ أَجْرُهُمْ عِنْدَ رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ","numberInSurah":262,"juz":3,"manzil":1,"page":44,"ruku":37,"hizbQuarter":17,"sajda":false},{"number":270,"text":"۞ قَوْلٌ مَعْرُوفٌ وَمَغْفِرَةٌ خَيْرٌ مِنْ صَدَقَةٍ يَتْبَعُهَا أَذًى ۗ وَاللَّهُ غَنِيٌّ حَلِيمٌ","numberInSurah":263,"juz":3,"manzil":1,"page":44,"ruku":37,"hizbQuarter":18,"sajda":false},{"number":271,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تُبْطِلُوا صَدَقَاتِكُمْ بِالْمَنِّ وَالْأَذَىٰ كَالَّذِي يُنْفِقُ مَالَهُ رِئَاءَ النَّاسِ وَلَا يُؤْمِنُ بِاللَّهِ وَالْيَوْمِ الْآخِرِ ۖ فَمَثَلُهُ كَمَثَلِ صَفْوَانٍ عَلَيْهِ تُرَابٌ فَأَصَابَهُ وَابِلٌ فَتَرَكَهُ صَلْدًا ۖ لَا يَقْدِرُونَ عَلَىٰ شَيْءٍ مِمَّا كَسَبُوا ۗ وَاللَّهُ لَا يَهْدِي الْقَوْمَ الْكَافِرِينَ","numberInSurah":264,"juz":3,"manzil":1,"page":44,"ruku":37,"hizbQuarter":18,"sajda":false},{"number":272,"text":"وَمَثَلُ الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمُ ابْتِغَاءَ مَرْضَاتِ اللَّهِ وَتَثْبِيتًا مِنْ أَنْفُسِهِمْ كَمَثَلِ جَنَّةٍ بِرَبْوَةٍ أَصَابَهَا وَابِلٌ فَآتَتْ أُكُلَهَا ضِعْفَيْنِ فَإِنْ لَمْ يُصِبْهَا وَابِلٌ فَطَلٌّ ۗ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","numberInSurah":265,"juz":3,"manzil":1,"page":45,"ruku":37,"hizbQuarter":18,"sajda":false},{"number":273,"text":"أَيَوَدُّ أَحَدُكُمْ أَنْ تَكُونَ لَهُ جَنَّةٌ مِنْ نَخِيلٍ وَأَعْنَابٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ لَهُ فِيهَا مِنْ كُلِّ الثَّمَرَاتِ وَأَصَابَهُ الْكِبَرُ وَلَهُ ذُرِّيَّةٌ ضُعَفَاءُ فَأَصَابَهَا إِعْصَارٌ فِيهِ نَارٌ فَاحْتَرَقَتْ ۗ كَذَٰلِكَ يُبَيِّنُ اللَّهُ لَكُمُ الْآيَاتِ لَعَلَّكُمْ تَتَفَكَّرُونَ","numberInSurah":266,"juz":3,"manzil":1,"page":45,"ruku":37,"hizbQuarter":18,"sajda":false},{"number":274,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا أَنْفِقُوا مِنْ طَيِّبَاتِ مَا كَسَبْتُمْ وَمِمَّا أَخْرَجْنَا لَكُمْ مِنَ الْأَرْضِ ۖ وَلَا تَيَمَّمُوا الْخَبِيثَ مِنْهُ تُنْفِقُونَ وَلَسْتُمْ بِآخِذِيهِ إِلَّا أَنْ تُغْمِضُوا فِيهِ ۚ وَاعْلَمُوا أَنَّ اللَّهَ غَنِيٌّ حَمِيدٌ","numberInSurah":267,"juz":3,"manzil":1,"page":45,"ruku":38,"hizbQuarter":18,"sajda":false},{"number":275,"text":"الشَّيْطَانُ يَعِدُكُمُ الْفَقْرَ وَيَأْمُرُكُمْ بِالْفَحْشَاءِ ۖ وَاللَّهُ يَعِدُكُمْ مَغْفِرَةً مِنْهُ وَفَضْلًا ۗ وَاللَّهُ وَاسِعٌ عَلِيمٌ","numberInSurah":268,"juz":3,"manzil":1,"page":45,"ruku":38,"hizbQuarter":18,"sajda":false},{"number":276,"text":"يُؤْتِي الْحِكْمَةَ مَنْ يَشَاءُ ۚ وَمَنْ يُؤْتَ الْحِكْمَةَ فَقَدْ أُوتِيَ خَيْرًا كَثِيرًا ۗ وَمَا يَذَّكَّرُ إِلَّا أُولُو الْأَلْبَابِ","numberInSurah":269,"juz":3,"manzil":1,"page":45,"ruku":38,"hizbQuarter":18,"sajda":false},{"number":277,"text":"وَمَا أَنْفَقْتُمْ مِنْ نَفَقَةٍ أَوْ نَذَرْتُمْ مِنْ نَذْرٍ فَإِنَّ اللَّهَ يَعْلَمُهُ ۗ وَمَا لِلظَّالِمِينَ مِنْ أَنْصَارٍ","numberInSurah":270,"juz":3,"manzil":1,"page":46,"ruku":38,"hizbQuarter":18,"sajda":false},{"number":278,"text":"إِنْ تُبْدُوا الصَّدَقَاتِ فَنِعِمَّا هِيَ ۖ وَإِنْ تُخْفُوهَا وَتُؤْتُوهَا الْفُقَرَاءَ فَهُوَ خَيْرٌ لَكُمْ ۚ وَيُكَفِّرُ عَنْكُمْ مِنْ سَيِّئَاتِكُمْ ۗ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","numberInSurah":271,"juz":3,"manzil":1,"page":46,"ruku":38,"hizbQuarter":18,"sajda":false},{"number":279,"text":"۞ لَيْسَ عَلَيْكَ هُدَاهُمْ وَلَٰكِنَّ اللَّهَ يَهْدِي مَنْ يَشَاءُ ۗ وَمَا تُنْفِقُوا مِنْ خَيْرٍ فَلِأَنْفُسِكُمْ ۚ وَمَا تُنْفِقُونَ إِلَّا ابْتِغَاءَ وَجْهِ اللَّهِ ۚ وَمَا تُنْفِقُوا مِنْ خَيْرٍ يُوَفَّ إِلَيْكُمْ وَأَنْتُمْ لَا تُظْلَمُونَ","numberInSurah":272,"juz":3,"manzil":1,"page":46,"ruku":38,"hizbQuarter":19,"sajda":false},{"number":280,"text":"لِلْفُقَرَاءِ الَّذِينَ أُحْصِرُوا فِي سَبِيلِ اللَّهِ لَا يَسْتَطِيعُونَ ضَرْبًا فِي الْأَرْضِ يَحْسَبُهُمُ الْجَاهِلُ أَغْنِيَاءَ مِنَ التَّعَفُّفِ تَعْرِفُهُمْ بِسِيمَاهُمْ لَا يَسْأَلُونَ النَّاسَ إِلْحَافًا ۗ وَمَا تُنْفِقُوا مِنْ خَيْرٍ فَإِنَّ اللَّهَ بِهِ عَلِيمٌ","numberInSurah":273,"juz":3,"manzil":1,"page":46,"ruku":38,"hizbQuarter":19,"sajda":false},{"number":281,"text":"الَّذِينَ يُنْفِقُونَ أَمْوَالَهُمْ بِاللَّيْلِ وَالنَّهَارِ سِرًّا وَعَلَانِيَةً فَلَهُمْ أَجْرُهُمْ عِنْدَ رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ","numberInSurah":274,"juz":3,"manzil":1,"page":46,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":282,"text":"الَّذِينَ يَأْكُلُونَ الرِّبَا لَا يَقُومُونَ إِلَّا كَمَا يَقُومُ الَّذِي يَتَخَبَّطُهُ الشَّيْطَانُ مِنَ الْمَسِّ ۚ ذَٰلِكَ بِأَنَّهُمْ قَالُوا إِنَّمَا الْبَيْعُ مِثْلُ الرِّبَا ۗ وَأَحَلَّ اللَّهُ الْبَيْعَ وَحَرَّمَ الرِّبَا ۚ فَمَنْ جَاءَهُ مَوْعِظَةٌ مِنْ رَبِّهِ فَانْتَهَىٰ فَلَهُ مَا سَلَفَ وَأَمْرُهُ إِلَى اللَّهِ ۖ وَمَنْ عَادَ فَأُولَٰئِكَ أَصْحَابُ النَّارِ ۖ هُمْ فِيهَا خَالِدُونَ","numberInSurah":275,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":283,"text":"يَمْحَقُ اللَّهُ الرِّبَا وَيُرْبِي الصَّدَقَاتِ ۗ وَاللَّهُ لَا يُحِبُّ كُلَّ كَفَّارٍ أَثِيمٍ","numberInSurah":276,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":284,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَأَقَامُوا الصَّلَاةَ وَآتَوُا الزَّكَاةَ لَهُمْ أَجْرُهُمْ عِنْدَ رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ","numberInSurah":277,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":285,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَذَرُوا مَا بَقِيَ مِنَ الرِّبَا إِنْ كُنْتُمْ مُؤْمِنِينَ","numberInSurah":278,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":286,"text":"فَإِنْ لَمْ تَفْعَلُوا فَأْذَنُوا بِحَرْبٍ مِنَ اللَّهِ وَرَسُولِهِ ۖ وَإِنْ تُبْتُمْ فَلَكُمْ رُءُوسُ أَمْوَالِكُمْ لَا تَظْلِمُونَ وَلَا تُظْلَمُونَ","numberInSurah":279,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":287,"text":"وَإِنْ كَانَ ذُو عُسْرَةٍ فَنَظِرَةٌ إِلَىٰ مَيْسَرَةٍ ۚ وَأَنْ تَصَدَّقُوا خَيْرٌ لَكُمْ ۖ إِنْ كُنْتُمْ تَعْلَمُونَ","numberInSurah":280,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":288,"text":"وَاتَّقُوا يَوْمًا تُرْجَعُونَ فِيهِ إِلَى اللَّهِ ۖ ثُمَّ تُوَفَّىٰ كُلُّ نَفْسٍ مَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ","numberInSurah":281,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":289,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِذَا تَدَايَنْتُمْ بِدَيْنٍ إِلَىٰ أَجَلٍ مُسَمًّى فَاكْتُبُوهُ ۚ وَلْيَكْتُبْ بَيْنَكُمْ كَاتِبٌ بِالْعَدْلِ ۚ وَلَا يَأْبَ كَاتِبٌ أَنْ يَكْتُبَ كَمَا عَلَّمَهُ اللَّهُ ۚ فَلْيَكْتُبْ وَلْيُمْلِلِ الَّذِي عَلَيْهِ الْحَقُّ وَلْيَتَّقِ اللَّهَ رَبَّهُ وَلَا يَبْخَسْ مِنْهُ شَيْئًا ۚ فَإِنْ كَانَ الَّذِي عَلَيْهِ الْحَقُّ سَفِيهًا أَوْ ضَعِيفًا أَوْ لَا يَسْتَطِيعُ أَنْ يُمِلَّ هُوَ فَلْيُمْلِلْ وَلِيُّهُ بِالْعَدْلِ ۚ وَاسْتَشْهِدُوا شَهِيدَيْنِ مِنْ رِجَالِكُمْ ۖ فَإِنْ لَمْ يَكُونَا رَجُلَيْنِ فَرَجُلٌ وَامْرَأَتَانِ مِمَّنْ تَرْضَوْنَ مِنَ الشُّهَدَاءِ أَنْ تَضِلَّ إِحْدَاهُمَا فَتُذَكِّرَ إِحْدَاهُمَا الْأُخْرَىٰ ۚ وَلَا يَأْبَ الشُّهَدَاءُ إِذَا مَا دُعُوا ۚ وَلَا تَسْأَمُوا أَنْ تَكْتُبُوهُ صَغِيرًا أَوْ كَبِيرًا إِلَىٰ أَجَلِهِ ۚ ذَٰلِكُمْ أَقْسَطُ عِنْدَ اللَّهِ وَأَقْوَمُ لِلشَّهَادَةِ وَأَدْنَىٰ أَلَّا تَرْتَابُوا ۖ إِلَّا أَنْ تَكُونَ تِجَارَةً حَاضِرَةً تُدِيرُونَهَا بَيْنَكُمْ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَلَّا تَكْتُبُوهَا ۗ وَأَشْهِدُوا إِذَا تَبَايَعْتُمْ ۚ وَلَا يُضَارَّ كَاتِبٌ وَلَا شَهِيدٌ ۚ وَإِنْ تَفْعَلُوا فَإِنَّهُ فُسُوقٌ بِكُمْ ۗ وَاتَّقُوا اللَّهَ ۖ وَيُعَلِّمُكُمُ اللَّهُ ۗ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ","numberInSurah":282,"juz":3,"manzil":1,"page":48,"ruku":40,"hizbQuarter":19,"sajda":false},{"number":290,"text":"۞ وَإِنْ كُنْتُمْ عَلَىٰ سَفَرٍ وَلَمْ تَجِدُوا كَاتِبًا فَرِهَانٌ مَقْبُوضَةٌ ۖ فَإِنْ أَمِنَ بَعْضُكُمْ بَعْضًا فَلْيُؤَدِّ الَّذِي اؤْتُمِنَ أَمَانَتَهُ وَلْيَتَّقِ اللَّهَ رَبَّهُ ۗ وَلَا تَكْتُمُوا الشَّهَادَةَ ۚ وَمَنْ يَكْتُمْهَا فَإِنَّهُ آثِمٌ قَلْبُهُ ۗ وَاللَّهُ بِمَا تَعْمَلُونَ عَلِيمٌ","numberInSurah":283,"juz":3,"manzil":1,"page":49,"ruku":40,"hizbQuarter":20,"sajda":false},{"number":291,"text":"لِلَّهِ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ وَإِنْ تُبْدُوا مَا فِي أَنْفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُمْ بِهِ اللَّهُ ۖ فَيَغْفِرُ لِمَنْ يَشَاءُ وَيُعَذِّبُ مَنْ يَشَاءُ ۗ وَاللَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":284,"juz":3,"manzil":1,"page":49,"ruku":41,"hizbQuarter":20,"sajda":false},{"number":292,"text":"آمَنَ الرَّسُولُ بِمَا أُنْزِلَ إِلَيْهِ مِنْ رَبِّهِ وَالْمُؤْمِنُونَ ۚ كُلٌّ آمَنَ بِاللَّهِ وَمَلَائِكَتِهِ وَكُتُبِهِ وَرُسُلِهِ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِنْ رُسُلِهِ ۚ وَقَالُوا سَمِعْنَا وَأَطَعْنَا ۖ غُفْرَانَكَ رَبَّنَا وَإِلَيْكَ الْمَصِيرُ","numberInSurah":285,"juz":3,"manzil":1,"page":49,"ruku":41,"hizbQuarter":20,"sajda":false},{"number":293,"text":"لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا ۚ لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا اكْتَسَبَتْ ۗ رَبَّنَا لَا تُؤَاخِذْنَا إِنْ نَسِينَا أَوْ أَخْطَأْنَا ۚ رَبَّنَا وَلَا تَحْمِلْ عَلَيْنَا إِصْرًا كَمَا حَمَلْتَهُ عَلَى الَّذِينَ مِنْ قَبْلِنَا ۚ رَبَّنَا وَلَا تُحَمِّلْنَا مَا لَا طَاقَةَ لَنَا بِهِ ۖ وَاعْفُ عَنَّا وَاغْفِرْ لَنَا وَارْحَمْنَا ۚ أَنْتَ مَوْلَانَا فَانْصُرْنَا عَلَى الْقَوْمِ الْكَافِرِينَ","numberInSurah":286,"juz":3,"manzil":1,"page":49,"ruku":41,"hizbQuarter":20,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":2,"name":"سُورَةُ البَقَرَةِ","englishName":"Bakara","englishNameTranslation":"The Cow","revelationType":"Medinan","numberOfAyahs":286,"ayahs":[{"number":8,"text":"Elif, Lam, Mim.","numberInSurah":1,"juz":1,"manzil":1,"page":2,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":9,"text":"Bu, doğruluğu şüphe götürmeyen ve Allah'a karşı gelmekten sakınanlara yol gösteren Kitap'dır.","numberInSurah":2,"juz":1,"manzil":1,"page":2,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":10,"text":"Onlar, gaybe inanırlar, namazı kılarlar, kendilerine verdiğimiz rızıktan yerli yerince sarfederler.","numberInSurah":3,"juz":1,"manzil":1,"page":2,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":11,"text":"Onlar, sana indirilen Kitap'a da, senden önce indirilenlere de inanırlar; ahirete de yalnız onlar kesinlikle inanırlar.","numberInSurah":4,"juz":1,"manzil":1,"page":2,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":12,"text":"İşte Rab'lerinin yolunda olanlar ve saadete erişenler bunlardır.","numberInSurah":5,"juz":1,"manzil":1,"page":2,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":13,"text":"Şüphe yok ki, inkar edenleri, başlarına gelecekle uyarsan da uyarmasan da birdir, inanmazlar.","numberInSurah":6,"juz":1,"manzil":1,"page":3,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":14,"text":"Allah onların kalblerini ve kulaklarını mühürlemiştir, gözlerinde de perde vardır ve büyük azab onlar içindir.","numberInSurah":7,"juz":1,"manzil":1,"page":3,"ruku":2,"hizbQuarter":1,"sajda":false},{"number":15,"text":"İnsanlardan, inanmadıkları halde, \"Allah'a ve ahiret gününe inandık\" diyenler vardır.","numberInSurah":8,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":16,"text":"Bunlar Allah'ı ve inananları aldatmaya çalışırlar, oysa sadece kendilerini aldatırlar da farkında değildirler.","numberInSurah":9,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":17,"text":"Kalblerinde hastalık vardır, Allah hastalıklarını artırmıştır. Yalan söyleye geldikleri için onlara elem verici azab vardır.","numberInSurah":10,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":18,"text":"Kendilerine: \"Yeryüzünde bozgunculuk yapmayın\" dendiği zaman, \"Bizler sadece ıslah edicileriz\" derler.","numberInSurah":11,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":19,"text":"İyi bilin ki, asıl bozguncular kendileridir, lakin farkında değillerdir.","numberInSurah":12,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":20,"text":"Onlara \"Müslümanların inandığı gibi siz de inanın\" denilince de, \"Beyinsizlerin inandığı gibi mi inanalım?\" derler; iyi bilin ki asıl beyinsizler kendileridir, fakat bilmezler.","numberInSurah":13,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":21,"text":"İnananlara rastladıkları zaman, \"İnandık\" derler, elebaşılarıyla baş başa kaldıklarında, \"Biz şüphesiz sizinleyiz, onlarla sadece alay etmekteyiz\" derler.","numberInSurah":14,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":22,"text":"Onlarla Allah alay eder ve taşkınlıkları içinde bocalar durumda bırakır.","numberInSurah":15,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":23,"text":"Onlar, doğruluk yerine sapıklığı aldılar da alışverişleri kar getirmedi; doğru yolu bulamamışlardı.","numberInSurah":16,"juz":1,"manzil":1,"page":3,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":24,"text":"Onlar, çevresini aydınlatmak için ateş yakan kimseye benzerler ki, Allah ışıklarını yok edince, onları karanlıklar içinde görmez bir halde bırakmıştır.","numberInSurah":17,"juz":1,"manzil":1,"page":4,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":25,"text":"Sağırdırlar, dilsizdirler, kördürler, bu yüzden doğru yola dönmezler.","numberInSurah":18,"juz":1,"manzil":1,"page":4,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":26,"text":"Bir kısmı da, karanlıklarda, gök gürlemeleri ve şimşek arasında gökten boşanan sağanağa tutulup, yıldırımlardan ölmek korkusu ile parmaklarını kulaklarına tıkayan kimseye benzer.","numberInSurah":19,"juz":1,"manzil":1,"page":4,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":27,"text":"Şimşeğin çakması neredeyse gözlerini alır; onları aydınlattıkça ışığında yürürler ve üzerlerine karanlık basınca durakalırlar. Allah dileseydi işitme ve görmelerini giderirdi. Doğrusu Allah her şeye Kadir'dir.","numberInSurah":20,"juz":1,"manzil":1,"page":4,"ruku":3,"hizbQuarter":1,"sajda":false},{"number":28,"text":"Ey insanlar! Sizi ve sizden öncekileri yaratan Rabbinize kulluk ediniz ki, O'na karşı gelmekten korunmuş olabilesiniz.","numberInSurah":21,"juz":1,"manzil":1,"page":4,"ruku":4,"hizbQuarter":1,"sajda":false},{"number":29,"text":"O, yeryüzünü size bir döşek ve göğü de bir bina kıldı. Gökten su indirip onunla size rızık olmak üzere ürünler meydana getirdi; artık Allah'a, bile bile eş koşmayın.","numberInSurah":22,"juz":1,"manzil":1,"page":4,"ruku":4,"hizbQuarter":1,"sajda":false},{"number":30,"text":"Kulumuza indirdiğimiz Kuran'dan şüphe ediyorsanız, siz de onun benzeri bir sure meydana getirin; eğer doğru sözlü iseniz, Allah'tan başka, güvendiklerinizi de yardıma çağırın.","numberInSurah":23,"juz":1,"manzil":1,"page":4,"ruku":4,"hizbQuarter":1,"sajda":false},{"number":31,"text":"Yapamazsanız ki yapamayacaksınız o takdirde, inkar edenler için hazırlanan ve yakıtı insanlarla taş olan ateşten sakının.","numberInSurah":24,"juz":1,"manzil":1,"page":4,"ruku":4,"hizbQuarter":1,"sajda":false},{"number":32,"text":"İnananlar ve yararlı işler yapanlara, kendilerine altlarından ırmaklar akan cennetler olduğunu müjdele. Onlara buranın bir ürünü rızık olarak verildiğinde, \"Bu daha önce de rızıklandığımızdır\" derler. Bunlar, söylediklerinin benzerleri olarak sunulmuştur. Onlara orada tertemiz eşler vardır ve orada temelli kalırlar.","numberInSurah":25,"juz":1,"manzil":1,"page":5,"ruku":4,"hizbQuarter":1,"sajda":false},{"number":33,"text":"Allah sivrisineği ve onun üstününü misal olarak vermekten çekinmez. İnananlar bunun Rablerinden bir gerçek olduğunu bilirler. İnkar edenler ise \"Allah bu misalle neyi murad etti?\" derler, O, bu misalle birçoğunu saptırır, birçoğunu da yola getirir. Onunla saptırdığı yalnız fasıklardır ki onlar Allah'la yapılan sözleşmeyi kabulden sonra bozarlar. Allah'ın birleştirilmesini buyurduğu şeyi ayırırlar ve yeryüzünde bozgunculuk yaparlar; zarara uğrayanlar işte onlardır.","numberInSurah":26,"juz":1,"manzil":1,"page":5,"ruku":4,"hizbQuarter":2,"sajda":false},{"number":34,"text":"Onlar, Allah'a verdikleri sözü, pekiştirilmesinden sonra bozan, Allah'ın korunmasını emrettiği bağları (iman, akrabalık, beşeri ve ahlâki bütün ilişkileri) koparan ve yeryüzünde bozgunculuk yapan kimselerdir. İşte onlar ziyana uğrayanların ta kendileridir.","numberInSurah":27,"juz":1,"manzil":1,"page":5,"ruku":4,"hizbQuarter":2,"sajda":false},{"number":35,"text":"Ölü idiniz sizleri diriltti, sonra öldürecek sonra tekrar diriltecek ve sonunda O'na döneceksiniz; öyleyken Allah'ı nasıl inkar edersiniz?","numberInSurah":28,"juz":1,"manzil":1,"page":5,"ruku":4,"hizbQuarter":2,"sajda":false},{"number":36,"text":"Yerde olanların hepsini; sizin için yaratan O'dur. Sonra, göğe doğru yönelerek yedi gök olarak onları düzenlemiştir. O her şeyi bilir.","numberInSurah":29,"juz":1,"manzil":1,"page":5,"ruku":4,"hizbQuarter":2,"sajda":false},{"number":37,"text":"Rabbin meleklere \"Ben yeryüzünde bir halife var edeceğim\" demişti; melekler, \"Orada bozgunculuk yapacak, kanlar akıtacak birini mi var edeceksin? Oysa biz Seni överek yüceltiyor ve Seni devamlı takdis ediyoruz\" dediler; Allah \"Ben şüphesiz sizin bilmediklerinizi bilirim\" dedi.","numberInSurah":30,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":38,"text":"Ve Adem'e bütün isimleri öğretti, sonra eşyayı meleklere gösterdi. \"Eğer sözünüzde samimi iseniz bunların isimlerini bana söyleyin\" dedi.","numberInSurah":31,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":39,"text":"Cevap verdiler: \"Sen münezzehsin, öğrettiğinden başka bizim bir bilgimiz yoktur. Şüphesiz Sen hem bilensin, hem Hakim'sin\".","numberInSurah":32,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":40,"text":"Allah \"Ey Adem onlara isimlerini söyle\" dedi. Adem isimlerini söyleyince, Allah \"Ben gökler ve yerde görünmeyeni biliyorum, sizin açıkladığınızı ve gizlemekte olduğunuzu da bilirim, diye size söylememiş miydim?\" dedi.","numberInSurah":33,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":41,"text":"Meleklere, \"Adem'e secde edin\" demiştik, İblis müstesna hepsi secde ettiler, o ise kaçındı, büyüklük tasladı ve inkar edenlerden oldu.","numberInSurah":34,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":42,"text":"\"Ey Adem! Eşin ve sen cennette kal, orada olandan istediğiniz yerde bol bol yiyin, yalnız şu ağaca yaklaşmayın; yoksa zalimlerden olursunuz\" dedik.","numberInSurah":35,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":43,"text":"Şeytan oradan ikisinin de ayağını kaydırttı, onları bulundukları yerden çıkardı, onlara \"Birbirinize düşman olarak inin, yeryüzünde bir müddet için yerleşip geçineceksiniz\" dedik.","numberInSurah":36,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":44,"text":"Adem, Rabbi'nden emirler aldı; onları yerine getirdi. Rabb'i de bunun üzerine tevbesini kabul etti. Şüphesiz o tevbeleri daima kabul edendir, merhametli olandır.","numberInSurah":37,"juz":1,"manzil":1,"page":6,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":45,"text":"\"İnin oradan hepiniz, tarafımdan size bir yol gösteren gelecektir; Benim yoluma uyanlar için artık korku yoktur, onlar üzülmeyeceklerdir\" dedik.","numberInSurah":38,"juz":1,"manzil":1,"page":7,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":46,"text":"İnkar eden kimseler ve ayetlerimizi yalan sayanlar cehennemlik olanlardır, onlar orada temelli kalacaklardır.","numberInSurah":39,"juz":1,"manzil":1,"page":7,"ruku":5,"hizbQuarter":2,"sajda":false},{"number":47,"text":"Ey İsrailoğulları! Size verdiğim nimeti hatırlayın ve ahdimi yerine getirin ki Ben de yerine getireyim; yoksa benden korkun.","numberInSurah":40,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":2,"sajda":false},{"number":48,"text":"Yanınızdaki Tevrat'ı tasdik ederek indirdiğim Kuran'a, inanın; onu ilk inkar edenler siz olmayın, ayetlerimi hiçbir değere karşılık değiştirmeyin ve bile bile hakkı gizlemeyin.","numberInSurah":41,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":2,"sajda":false},{"number":49,"text":"Hakkı batıla karıştırmayın ve bile bile hakkı gizlemeyin.","numberInSurah":42,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":2,"sajda":false},{"number":50,"text":"Namazı kılın, zekatı verin, rüku edenlerle birlikte rüku edin.","numberInSurah":43,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":2,"sajda":false},{"number":51,"text":"Kitap'ı okuyup durduğunuz halde kendinizi unutur da başkalarına mı iyilikle emredersiniz? Düşünmez misiniz?","numberInSurah":44,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":3,"sajda":false},{"number":52,"text":"Sabır ve namazla Allah'a sığınıp yardım isteyin; Rablerine kavuşacaklarını ve Ona döneceklerini umanlar ve huşu duyanlardan başkasına namaz elbette ağır gelir.","numberInSurah":45,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":3,"sajda":false},{"number":53,"text":"Sabır ve namazla Allah'a sığınıp yardım isteyin; Rablerine kavuşacaklarını ve Ona döneceklerini umanlar ve huşu duyanlardan başkasına namaz elbette ağır gelir.","numberInSurah":46,"juz":1,"manzil":1,"page":7,"ruku":6,"hizbQuarter":3,"sajda":false},{"number":54,"text":"Ey İsrailoğulları! Size verdiğim nimeti ve sizi bir zamanlar alemlere üstün kıldığımı hatırlayın.","numberInSurah":47,"juz":1,"manzil":1,"page":7,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":55,"text":"Kimsenin kimseden faydalanamayacağı, kimseden bir şefaat kabul edilmeyeceği, kimseden bir fidye alınmayacağı ve yardım görülmeyeceği günden korunun.","numberInSurah":48,"juz":1,"manzil":1,"page":7,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":56,"text":"Size işkence eden, kadınlarınızı sağ bırakıp oğullarınızı boğazlayan Firavun ailesinden sizi kurtarmıştık; bu Rabbinizin büyük bir imtihanı idi.","numberInSurah":49,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":57,"text":"Denizi yarıp sizi kurtarmış ve gözlerinizin önünde Firavun ailesini batırmıştık.","numberInSurah":50,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":58,"text":"Musa'ya kırk gece vade vermiştik. Sonra onun arkasından, kendinize yazık ederek, buzağıyı tanrı edinmiştiniz.","numberInSurah":51,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":59,"text":"Sonra bunun ardından, şükredersiniz diye, sizi bağışlamıştık.","numberInSurah":52,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":60,"text":"Doğru yola gidesiniz diye Musa'ya hakkı batıldan ayıran Kitabı vermiştik.","numberInSurah":53,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":61,"text":"Musa milletine \"Ey milletim! Buzağıyı tanrı olarak benimsemekle kendinize yazık ettiniz. Yaratanınıza tevbe edin ve nefislerinizi öldürün, bu Yaratanınız katında sizin için hayırlı olur; O daima tevbeleri kabul ve merhamet eden olduğu için tevbenizikabul eder\" demişti.","numberInSurah":54,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":62,"text":"\"Ya Musa! Allah'ı apaçık görmedikçe sana inanmayacağız\" demiştiniz de gözleriniz göre göre sizi yıldırım çarpmıştı.","numberInSurah":55,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":63,"text":"Ölümünüzden sonra, şükredesiniz diye sizi tekrar diriltmiştik.","numberInSurah":56,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":64,"text":"Bulutla sizi gölgelendirdik, kudret helvası ve bıldırcın indirdik, \"Verdiğimiz rızıkların iyi ve güzel olanlarından yiyin\" dedik. Onlar Bize değil, fakat kendilerine yazık ediyorlardı.","numberInSurah":57,"juz":1,"manzil":1,"page":8,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":65,"text":"\"Şu şehre girin, orada dilediğiniz gibi, bol bol yiyin, secde ederek kapısından girin, \"bağışla!\" deyin, Biz de yanılmalarınızı bağışlarız, iyilere daha da artırırız\" demiştik.","numberInSurah":58,"juz":1,"manzil":1,"page":9,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":66,"text":"Ama zulmedenler, kendilerine söylenmiş olan sözü başka sözle değiştirdiler. Biz de, zalimlere, yoldan çıkmalarından dolayı gökten azab indirdik.","numberInSurah":59,"juz":1,"manzil":1,"page":9,"ruku":7,"hizbQuarter":3,"sajda":false},{"number":67,"text":"Musa, milleti için su aramıştı; \"Asanla taşa vur\" dedik; ondan on iki pınar fışkırdı, herkes içeceği yeri bildi. Allah'ın rızkından yiyin, için, yalnız yeryüzünde bozgunculuk yaparak karışıklık çıkarmayın.","numberInSurah":60,"juz":1,"manzil":1,"page":9,"ruku":8,"hizbQuarter":4,"sajda":false},{"number":68,"text":"\"Ey Musa! Bir çeşit yemeğe dayanamayacağız, bizim için Rabbine yalvar, bize, yerin bitirdiği sebze, hıyar, sarımsak, mercimek ve soğan yetiştirsin\" demiştiniz de, \"Hayırlı olanı daha düşük şeyle mi değiştirmek istiyorsunuz? Bir şehre inin, şüphesiz orada istediğiniz vardır\" demişti. Onlara yoksulluk ve düşkünlük damgası vuruldu, Allah'ın gazabına uğradılar. Bu, Allah'ın ayetlerini inkar etmeleri ve haksız yere peygamberleri öldürmelerindendi; bu, karşı gelmeleri ve taşkınlık yapmalarındandı.","numberInSurah":61,"juz":1,"manzil":1,"page":9,"ruku":8,"hizbQuarter":4,"sajda":false},{"number":69,"text":"Şüphesiz, inananlar, Yahudi olanlar, Hıristiyanlar ve Sabiilerden Allah'a ve ahiret gününe inanıp yararlı iş yapanların ecirleri Rablerinin katındadır. Onlar için artık korku yoktur. Onlar üzülmeyeceklerdir.","numberInSurah":62,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":70,"text":"Sizden kesin söz almıştık. Tur dağını yükselterek tepenize dikmiştik. \"Allah'a karşı gelmekten sakınanlardan olabilmeniz için, size verdiğimiz Kitab'a kuvvetle sarılın, onda bulunanları hatırda tutun\" demiştik.","numberInSurah":63,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":71,"text":"Bundan sonra yine yüz çevirdiniz; eğer Allah'ın size bol nimeti ve merhameti olmasaydı, muhakkak zarara uğrayanlardan olurdunuz.","numberInSurah":64,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":72,"text":"İçinizden cumartesi günü azgınlık edenleri elbette biliyorsunuz. Onlara \"Aşağılık birer maymun olunuz\" dedik; bunu, çağdaşlarına ve sonradan geleceklere bir ceza örneği ve Allah'a karşı gelmekten sakınanlara öğüt olsun diye yaptık.","numberInSurah":65,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":73,"text":"İçinizden cumartesi günü azgınlık edenleri elbette biliyorsunuz. Onlara \"Aşağılık birer maymun olunuz\" dedik; bunu, çağdaşlarına ve sonradan geleceklere bir ceza örneği ve Allah'a karşı gelmekten sakınanlara öğüt olsun diye yaptık.","numberInSurah":66,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":74,"text":"Musa milletine: \"Allah muhakkak bir sığır boğazlamanızı buyuruyor\" demişti; \"Bizi alaya mı alıyorsun?\" dediklerinde de: \"Cahillerden olmaktan Allah'a sığınırım\" dedi.","numberInSurah":67,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":75,"text":"\"Rabbine bizim adımıza yalvar da onun mahiyetini bize bildirsin\" dediler, \"O, onun ne pek kart, ne pek körpe, ikisi ortası bir sığır olduğunu söylüyor, size emrolunanı yapın\" dedi.","numberInSurah":68,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":76,"text":"\"Rabbine bizim adımıza yalvar da ne renk olduğunu bize bildirsin\" dediler. \"O, onun, bakanların içini açan parlak sarı renkli bir sığır olduğunu söylüyor\" dedi.","numberInSurah":69,"juz":1,"manzil":1,"page":10,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":77,"text":"\"Rabbine bizim adımıza yalvar da, mahiyetini bize bildirsin, çünkü sığırlar, bizce, birbirine benzemektedir. Allah dilerse biz şüphesiz doğruyu bulmuş oluruz\" dediler.","numberInSurah":70,"juz":1,"manzil":1,"page":11,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":78,"text":"\"Yeri sürüp, ekini sulayarak boyunduruk altında ezilmemiş, kusursuz, alacasız bir sığır olduğunu söylüyor\" dedi. \"Şimdi gerçeği bildirdin\" deyip sığırı boğazladılar; az kalsın bunu yapmayacaklardı.","numberInSurah":71,"juz":1,"manzil":1,"page":11,"ruku":9,"hizbQuarter":4,"sajda":false},{"number":79,"text":"Siz bir kimseyi öldürmüş ve bunu birbirinize atmıştınız; oysa Allah gizlemekte olduğunuzu ortaya çıkaracaktı.","numberInSurah":72,"juz":1,"manzil":1,"page":11,"ruku":10,"hizbQuarter":4,"sajda":false},{"number":80,"text":"\"Sığırın bir parçasıyla ona vurun\" dedik. İşte böylece Allah ölüleri diriltir ve aklınızı kullanasınız diye size ayetlerini gösterir.","numberInSurah":73,"juz":1,"manzil":1,"page":11,"ruku":10,"hizbQuarter":4,"sajda":false},{"number":81,"text":"Sonra kalbleriniz yine katılaştı, taş gibi, hatta daha da katı oldu. Nitekim taşlar arasında kendisinden ırmaklar fışkıran vardır; yarılıp su çıkan vardır; Allah korkusundan yuvarlananlar vardır. Allah yaptıklarınızı bilmez değildir.","numberInSurah":74,"juz":1,"manzil":1,"page":11,"ruku":10,"hizbQuarter":4,"sajda":false},{"number":82,"text":"Size inanacaklarını umuyor musunuz? Oysa onlardan bir takımı Allah'ın sözünü işitiyor, ona akılları yattıktan sonra, bile bile onu tahrif ediyorlardı.","numberInSurah":75,"juz":1,"manzil":1,"page":11,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":83,"text":"İnananlarla karşılaştıkları zaman, \"İnandık\" derlerdi; birbirleriyle yalnız kaldıklarında, \"Rabbinizin katında size karşı hüccet göstersinler diye mi Allah'ın size açıkladığını onlara anlatıyorsunuz? Bunu akletmiyor musunuz?\" derlerdi.","numberInSurah":76,"juz":1,"manzil":1,"page":11,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":84,"text":"Gizlediklerini de, açıkladıklarını da Allah'ın bildiğini bilmiyorlar mı?","numberInSurah":77,"juz":1,"manzil":1,"page":12,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":85,"text":"Onların bir kısmının okuyup yazması yoktu. Kitab'ı bilmezlerdi; bildikleri sadece bir takım yalan ve kuruntulardı. Onlar ancak vehim içindedirler.","numberInSurah":78,"juz":1,"manzil":1,"page":12,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":86,"text":"Vay, Kitabı elleriyle yazıp, sonra da onu az bir değere satmak için, \"Bu Allah katındandır\" diyenlere! Vay ellerinin yazdıklarına! Vay kazandıklarına!","numberInSurah":79,"juz":1,"manzil":1,"page":12,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":87,"text":"\"Ateş bize sadece sayılı birkaç gün değecektir\", derler; sor, \"Allah katından siz söz mü aldınız?\", eğer öyle ise Allah sözünden caymayacaktır. \"Yoksa Allah'a karşı bilmediğiniz bir şey mi söylüyorsunuz?\"","numberInSurah":80,"juz":1,"manzil":1,"page":12,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":88,"text":"Hayır öyle değil; kötülük işleyip suçu kendisini kuşatmış olan kimseler; cehennemlikler işte onlardır. Onlar orada temellidirler.","numberInSurah":81,"juz":1,"manzil":1,"page":12,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":89,"text":"İnanıp yararlı işler yapan kimseler cennetlik olanlardır, onlar da orada temellidirler.","numberInSurah":82,"juz":1,"manzil":1,"page":12,"ruku":10,"hizbQuarter":5,"sajda":false},{"number":90,"text":"İsrailoğullarından, \"Allah'tan başkasına kulluk etmeyin, anne babaya, yakınlara, yetimlere, düşkünlere iyilik edin, insanlarla güzel güzel konuşun, namazı kılın, zekatı verin\" diye söz almıştık. Sonra siz pek azınız müstesna, döndünüz; hala da yüz çevirip duruyorsunuz.","numberInSurah":83,"juz":1,"manzil":1,"page":12,"ruku":11,"hizbQuarter":5,"sajda":false},{"number":91,"text":"Kanınızı dökmeyin, birbirinizi yurdunuzdan sürmeyin diye sizden söz almıştık, sonra bunu böylece kabul etmiştiniz, buna siz şahidsiniz.","numberInSurah":84,"juz":1,"manzil":1,"page":13,"ruku":11,"hizbQuarter":5,"sajda":false},{"number":92,"text":"Sonra siz, birbirinizi öldüren, aranızdan bir takımı memleketlerinden süren, onlara karşı günah ve düşmanlıkta birleşen, onları çıkarmak haramken size esir olarak geldiklerinde fidyelerini vermeye kalkan kimselersiniz. Kitabın bir kısmına inanıp, bir kısmını inkar mı ediyorsunuz? Aranızda böyle yapanın cezası ancak dünya hayatında rezil olmaktır. Ahiret gününde de azabın en şiddetlisine onlar uğratılırlar. Allah yaptıklarınızdan gafil değildir.","numberInSurah":85,"juz":1,"manzil":1,"page":13,"ruku":11,"hizbQuarter":5,"sajda":false},{"number":93,"text":"Onlar ahiret karşılığında dünya hayatını satın alan kimselerdir, bu yüzden azabları hafifletilmez, onlar yardım da görmezler.","numberInSurah":86,"juz":1,"manzil":1,"page":13,"ruku":11,"hizbQuarter":5,"sajda":false},{"number":94,"text":"And olsun ki, Musa'ya kitap verdik, ondan sonra ardarda peygamberler gönderdik. Meryem oğlu İsa'ya belgeler verdik, onu Ruhul Kudüs ile destekledik. Size bir peygamber nefsinizin hoşlanmadığı bir şey getirdikçe, büyüklük taslayarak, bir kısmını yalancı sayıp, bir kısmını öldürür müsünüz?","numberInSurah":87,"juz":1,"manzil":1,"page":13,"ruku":12,"hizbQuarter":5,"sajda":false},{"number":95,"text":"\"Kalplerimiz perdelidir\" dediler, hayır, Allah inkarlarından dolayı onları lanetlemiştir. Onların pek azı inanırlar.","numberInSurah":88,"juz":1,"manzil":1,"page":13,"ruku":12,"hizbQuarter":5,"sajda":false},{"number":96,"text":"Vaktaki Allah katından onlara, kendilerinde olanı tasdik eden Kitap geldi ki onlar bundan önceleri, inkar edenlere karşı kendilerine yardım gelmesini beklerlerdi, bildikleri gelince onu inkar ettiler. Allah'ın laneti, inkar edenlerin üzerine olsun.","numberInSurah":89,"juz":1,"manzil":1,"page":14,"ruku":12,"hizbQuarter":5,"sajda":false},{"number":97,"text":"Allah'ın kullarından dilediğine, bol ihsanından indirmesini çekemeyerek, Allah'ın indirdiğini inkar etmekle, kendilerini ne kötü bir şey karşılığında sattılar. Bu yüzden gazab üstüne gazaba uğradılar. Kafirlere alçaltıcı bir azab vardır.","numberInSurah":90,"juz":1,"manzil":1,"page":14,"ruku":12,"hizbQuarter":5,"sajda":false},{"number":98,"text":"Onlara, \"Allah'ın indirdiğine inanın\" denildiğinde \"Bize indirilene inanırız\" deyip ondan sonra gelen Kuran'ı inkar ederler; halbuki o, ellerinde bulunan Tevrat'ı tasdik eden hak bir Kitap'dır. Onlara \"Eğer inanıyor idiyseniz niçin daha önce Allah'ın peygamberlerini öldürüyordunuz?\" diye sor.","numberInSurah":91,"juz":1,"manzil":1,"page":14,"ruku":12,"hizbQuarter":5,"sajda":false},{"number":99,"text":"And olsun ki, Musa size mucizeler getirdi, sonra ardından kendinize yazık ederek buzağıyı tanrı olarak benimsediniz.","numberInSurah":92,"juz":1,"manzil":1,"page":14,"ruku":12,"hizbQuarter":6,"sajda":false},{"number":100,"text":"Sizden kesin söz almış ve Tur'u tepenize dikmiştik, \"Size verdiğimize kuvvetle sarılın ve dinleyin\" demiştik \"İşittik ve karşı geldik\" dediler de inkarları yüzünden buzağı sevgisi kalblerine sindirildi. De ki, \"Eğer inanmışsanız, imanınız size ne kötü şey emrediyor?\"","numberInSurah":93,"juz":1,"manzil":1,"page":14,"ruku":12,"hizbQuarter":6,"sajda":false},{"number":101,"text":"De ki, \"Eğer ahiret yurdu Allah katında başkalarına değil de yalnız size mahsus ise ve eğer doğru sözlü iseniz, ölümü dilesenize!\"","numberInSurah":94,"juz":1,"manzil":1,"page":15,"ruku":12,"hizbQuarter":6,"sajda":false},{"number":102,"text":"Bunu, önceden işlediklerinden ötürü, asla dilemeyeceklerdir. Allah zalimleri bilir.","numberInSurah":95,"juz":1,"manzil":1,"page":15,"ruku":12,"hizbQuarter":6,"sajda":false},{"number":103,"text":"And olsun ki, onların hayata diğer insanlardan ve hatta Allah'a eş koşanlardan da daha düşkün olduklarını görürsün. Her biri ömrünün bin yıl olmasını ister. Oysa uzun ömürlü olması onu azabdan uzaklaştırmaz. Allah onların yaptıklarını görür.","numberInSurah":96,"juz":1,"manzil":1,"page":15,"ruku":12,"hizbQuarter":6,"sajda":false},{"number":104,"text":"De ki, \"Cebrail'e düşman olan kimse Allah'a düşmandır\", çünkü O, Kuran'ı Allah'ın izniyle kendinden öncekini tasdik ederek, yol gösterici ve inananlara müjdeci olarak senin kalbine indirmiştir.","numberInSurah":97,"juz":1,"manzil":1,"page":15,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":105,"text":"Allah'a, meleklerine, peygamberlerine, Cebrail'e ve Mikail'e düşman olan kimse inkar etmiş olur. Allah şüphesiz, inkar edenlerin düşmanıdır.","numberInSurah":98,"juz":1,"manzil":1,"page":15,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":106,"text":"And olsun ki, sana apaçık ayetler indirdik. Onları sadece yoldan çıkmışlar inkar eder.","numberInSurah":99,"juz":1,"manzil":1,"page":15,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":107,"text":"Onlar, her ne zaman bir ahidde bulunmuşlarsa içlerinden bir takımı onu bozmamış mıdır? Zaten onların çoğu inanmazlar.","numberInSurah":100,"juz":1,"manzil":1,"page":15,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":108,"text":"Yanlarındakini doğrulayan bir Peygamber, Allah katından onlara gelince Kitap verilenlerden bir takımı, bilmiyorlarmış gibi, Allah'ın Kitabı'nı arkalarına attılar.","numberInSurah":101,"juz":1,"manzil":1,"page":15,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":109,"text":"Şeytanların Süleyman'ın hükümdarlığı hakkında söylediklerine uydular. Oysa Süleyman kafir değildi, ama insanlara sihri öğreten şeytanlar kafir olmuşlardı. Babil'de, melek denilen Harut ve Marut'a bir şey indirilmemişti. Bu ikisi \"Biz sadece imtihan ediyoruz, sakın inkar etme\" demedikçe kimseye bir şey öğretmezlerdi. Halbuki bu ikisinden, koca ile karısının arasını ayıracak şeyler öğreniyorlardı. Oysa Allah'ın izni olmadıkça onlar kimseye zarar veremezlerdi. Kendilerine zarar verecek, faydalı olmayacak şeyler öğreniyorlardı. And olsun ki, onu satın alanın ahiretten bir nasibi olmadığını biliyorlardı. Kendilerini karşılığında sattıkları şeyin ne kötü olduğunu keşke bilselerdi!","numberInSurah":102,"juz":1,"manzil":1,"page":16,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":110,"text":"Onlar inanıp, Allah'a karşı gelmekten sakınsalardı, Allah katından olan sevab daha hayırlı olurdu. Keşke bilselerdi!","numberInSurah":103,"juz":1,"manzil":1,"page":16,"ruku":13,"hizbQuarter":6,"sajda":false},{"number":111,"text":"Ey inananlar! Peygamber'e, \"Bizi de dinle\" (raina; kötü anlama gelebilecek söz) demeyin, \"Bizi gözet\" (unzurna) deyin ve dinleyin, inkar edenlere elem verici azab vardır.","numberInSurah":104,"juz":1,"manzil":1,"page":16,"ruku":14,"hizbQuarter":6,"sajda":false},{"number":112,"text":"Kitap ehlinden ve Allah'a eş koşanlardan inkar edenler, Rabbinizden size bir iyilik gelmesini istemezler. Allah, rahmetini dilediğine tahsis eder. Allah büyük nimet sahibidir.","numberInSurah":105,"juz":1,"manzil":1,"page":16,"ruku":14,"hizbQuarter":6,"sajda":false},{"number":113,"text":"Herhangi bir ayetin hükmünü yürürlükten kaldırır veya unutturursak, onun yerine daha hayırlısını veya onun benzerini getiririz. Allah'ın her şeye kadir olduğunu bilmez misin?","numberInSurah":106,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":114,"text":"Göklerin ve yerin Hükümdarlığının Allah'a aid olduğunu bilmez misin? Allah'tan başka dost ve yardımcınız yoktur.","numberInSurah":107,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":115,"text":"Yoksa, daha önce Musa'nın sorguya çekildiği gibi, siz de peygamberinizi sorguya mı çekmek istiyorsunuz? İmanı inkarla değiştiren, şüphesiz doğru yoldan sapmış olur.","numberInSurah":108,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":116,"text":"Kitap ehlinin çoğu, hak kendilerine apaçık belli olduktan sonra, içlerindeki çekememezlikten ötürü, sizi, inandıktan sonra küfre döndürmeyi isterler. Allah'ın emri gelene kadar onları affedin, geçin. Allah muhakkak her şeye Kadir'dir.","numberInSurah":109,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":117,"text":"Namazı kılın, zekatı verin, kendiniz için önden gönderdiğiniz her hayrı Allah katında bulacaksınız. Allah yaptıklarınızı şüphesiz görür.","numberInSurah":110,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":118,"text":"\"Yahudi veya Hıristiyan olmayan kimse elbette cennete girmeyecek\" dediler; bu onların kuruntularıdır. De ki: \"Sözünüz doğru ise delillerinizi getirin\".","numberInSurah":111,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":119,"text":"Hayır, öyle değil; iyilik yaparak kendini Allah'a veren kimsenin ecri Rabbi'nin katındadır. Onlara korku yoktur, onlar üzülmeyeceklerdir.","numberInSurah":112,"juz":1,"manzil":1,"page":17,"ruku":14,"hizbQuarter":7,"sajda":false},{"number":120,"text":"Yahudiler \"Hıristiyanlar bir temel üzerinde değil\" dediler, Hıristiyanlar da \"Yahudiler bir temel üzerinde değil\" dediler; oysa onlar Kitaplarını da okuyorlar. Bilgisizler de tıpkı onların söylediklerini söylemiştir. Allah, kıyamet günü, anlaşmazlığa düştükleri şeylerde onların arasında hüküm verecektir.","numberInSurah":113,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":121,"text":"Allah'ın mescidlerinde O'nun isminin anılmasını yasak eden ve oraların yıkılmasına çalışan kimseden daha zalim kim vardır? Onların oralara korkmadan girememeleri gerekir. Dünyada rezillik onlaradır, ahirette büyük azab da onlaradır.","numberInSurah":114,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":122,"text":"Doğu da batı da Allah'ındır, nereye dönerseniz Allah'ın yönü orasıdır. Doğrusu Allah her yeri kaplar ve her şeyi bilir.","numberInSurah":115,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":123,"text":"\"Allah oğul edindi\" dediler; haşa, oysa, göklerde ve yerde olanlar O'nundur. Hepsi O'na boyun eğmişlerdir.","numberInSurah":116,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":124,"text":"Gökleri ve yeri yoktan var eden Allah'tır. O, bir işin olmasını dilerse, ona ancak \"ol\" der ve olur.","numberInSurah":117,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":125,"text":"Bilmeyenler: \"Allah bizimle konuşmalı veya bize bir ayet gelmeli değil miydi?\" dediler. Onlardan öncekiler de onların söylediklerinin tıpkısını söylemişlerdi. Kalbleri birbirine benzedi. Kesinlikle inanan kimseler için ayetleri açıklamışızdır.","numberInSurah":118,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":126,"text":"Doğrusu Biz, seni hak ile, müjdeci ve uyarıcı olarak göndermişizdir. Sen, cehennemliklerden sorumlu tutulmayacaksın.","numberInSurah":119,"juz":1,"manzil":1,"page":18,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":127,"text":"Kendi dinlerine uymadıkça, Yahudi ve Hıristiyanlar senden asla hoşnud olmayacaklardır. De ki: \"Doğru yol, ancak Allah'ın yoludur\". Sana gelen ilimden sonra onların heveslerine uyarsan, and olsun ki, Allah'tan sana ne bir dost ve ne de bir yardımcı olur.","numberInSurah":120,"juz":1,"manzil":1,"page":19,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":128,"text":"Kendilerine verdiğimiz Kitabı gereğince okuyanlar var ya, işte ona ancak onlar inanırlar. Onu inkar edenler ise kaybedenlerdir.","numberInSurah":121,"juz":1,"manzil":1,"page":19,"ruku":15,"hizbQuarter":7,"sajda":false},{"number":129,"text":"Ey İsrailoğulları! Size verdiğim nimeti ve sizi bir zamanlar alemlere üstün tuttuğumu hatırlayın.","numberInSurah":122,"juz":1,"manzil":1,"page":19,"ruku":16,"hizbQuarter":7,"sajda":false},{"number":130,"text":"Kimsenin kimse namına bir şey ödemeyeceği, hiç kimseden fidye alınmayacağı, kimseye şefaatin yarar sağlamayacağı ve onların yardım görmeyeceği günden korunun.","numberInSurah":123,"juz":1,"manzil":1,"page":19,"ruku":16,"hizbQuarter":7,"sajda":false},{"number":131,"text":"Rabbi İbrahim'i bir takım emirlerle denemiş, o da onları yerine getirmişti. Allah, \"seni insanlara önder kılacağım\" demişti. O \"soyumdan da\" deyince, \"zalimler benim ahdime erişemez\" buyurmuştu.","numberInSurah":124,"juz":1,"manzil":1,"page":19,"ruku":16,"hizbQuarter":8,"sajda":false},{"number":132,"text":"Kabeyi, insanlar için toplanma ve güven yeri kılmıştık. İbrahim'in makamını namaz yeri edinin, dedik. Evimi ziyaret edenler, kendini ibadete verenler, rüku ve secde edenler için temiz tutun diye İbrahim ve İsmail'e ahd verdik.","numberInSurah":125,"juz":1,"manzil":1,"page":19,"ruku":16,"hizbQuarter":8,"sajda":false},{"number":133,"text":"İbrahim: \"Rabbim! Burasını emin bir şehir kıl, halkından, Allah'a ve ahiret gününe inananları ürünlerle rızıklandır\" demişti. Allah da: \"İnkar edeni de az bir müddet geçindirir, sonra da onu ateşin azabına uğramak zorunda bırakırım, ne kötü sonuç\" buyurmuştu.","numberInSurah":126,"juz":1,"manzil":1,"page":19,"ruku":16,"hizbQuarter":8,"sajda":false},{"number":134,"text":"İbrahim ve İsmail, Kabenin temellerini yükseltiyordu: \"Rabbimiz! Yaptığımızı kabul buyur. Şüphesiz ki, Sen hem işitir hem bilirsin\"","numberInSurah":127,"juz":1,"manzil":1,"page":20,"ruku":16,"hizbQuarter":8,"sajda":false},{"number":135,"text":"\"Rabbimiz! İkimizi Sana teslim olanlardan kıl, soyumuzdan da Sana teslim olanlardan bir ümmet yetiştir. Bize ibadet yollarımızı göster, tevbemizi kabul buyur, çünkü tevbeleri daima kabul eden, merhametli olan ancak Sensin\".","numberInSurah":128,"juz":1,"manzil":1,"page":20,"ruku":16,"hizbQuarter":8,"sajda":false},{"number":136,"text":"\"Rabbimiz! İçlerinden onlara Senin ayetlerini okuyan, Kitabı ve hikmeti öğreten, onları her kötülükten arıtan bir peygamber gönder. Doğrusu güçlü ve Hakim olan ancak Sensin\".","numberInSurah":129,"juz":1,"manzil":1,"page":20,"ruku":16,"hizbQuarter":8,"sajda":false},{"number":137,"text":"Kendini bilmezden başkası İbrahim'in dininden yüz çevirmez. And olsun ki, dünyada onu seçtik, şüphesiz o, ahirette de iyilerdendir.","numberInSurah":130,"juz":1,"manzil":1,"page":20,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":138,"text":"Rabbi ona: \"Teslim ol\" buyurduğunda, \"Alemlerin Rabbine teslim oldum\" demişti.","numberInSurah":131,"juz":1,"manzil":1,"page":20,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":139,"text":"İbrahim bunu oğullarına vasiyet etti. Yakub da: \"Oğullarım! Allah dini size seçti, siz de ancak O'na teslim olmuş olarak can verin\" dedi.","numberInSurah":132,"juz":1,"manzil":1,"page":20,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":140,"text":"Yoksa Yakub can verirken sizler yanında mı idiniz? O, oğullarına: \"Benden sonra kime kulluk edeceksiniz?\" diye sormuştu; Onlar da: \"Senin Tanrına ve ataların İbrahim, İsmail, İshak'ın Tanrısı olan tek Tanrıya kulluk edeceğiz, bizler O'na teslim olmuşuzdur\" demişlerdi.","numberInSurah":133,"juz":1,"manzil":1,"page":20,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":141,"text":"Onlar geçmiş birer ümmettir. Kazandıkları kendilerine, sizin kazandıklarınız da sizedir. Onların yapmış olduklarından sorumlu değilsiniz.","numberInSurah":134,"juz":1,"manzil":1,"page":20,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":142,"text":"\"Yahudi veya Hıristiyan olun ki doğru yolu bulasınız\" dediler. \"Doğruya yönelmiş olan ve Allah'a eş koşanlardan olmayan İbrahim'in dinine uyarız\" de.","numberInSurah":135,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":143,"text":"\"Allah'a, bize gönderilene, İbrahim'e, İsmail'e, İshak'a, Yakub'a ve torunlarına gönderilene, Musa ve İsa'ya verilene, Rableri tarafından peygamberlere verilene, onları birbirinden ayırt etmeyerek inandık, biz O'na teslim olanlarız\" deyin.","numberInSurah":136,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":144,"text":"Sizin inandığınız gibi inanmış olsalar, doğru yolu bulmuş olurlar. Yüz çevirirlerse, şüphesiz onlar çıkmazdadırlar. Onlara karşı sana Allah yetecektir. O, işitir ve bilir.","numberInSurah":137,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":145,"text":"Allah'ın verdiği renge uyun; rengi Allah'ınkinden daha güzel olan kim vardır? \"Biz O'na kulluk edenleriz\" deyin.","numberInSurah":138,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":146,"text":"De ki: \"Bizim ve sizin Rabbiniz olan Allah hakkında bize karşı hüccet mi gösteriyorsunuz? Bizim yaptıklarımız kendimize, sizin yaptıklarınız de kendinize aittir. Biz O'na karşı samimiyiz\".","numberInSurah":139,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":147,"text":"Yoksa İbrahim, İsmail, İshak, Yakub ve torunlarının Yahudi veya Hıristiyan olduklarını mı söylüyorsunuz? Peki, siz mi yoksa Allah mı daha iyi bilir? de. Allah tarafından kendisine bildirilen bir gerçeği gizleyenden daha zalim kim vardır? Allah yaptıklarınızdan gafil değildir.","numberInSurah":140,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":148,"text":"Onlar geçmiş birer ümmettir. Kazandıkları kendilerine, sizin kazandıklarınız da sizedir. Onların yapmış olduklarından sorumlu değilsiniz.","numberInSurah":141,"juz":1,"manzil":1,"page":21,"ruku":17,"hizbQuarter":8,"sajda":false},{"number":149,"text":"İnsanların beyinsizleri, \"Yöneldikleri kıbleden onları çeviren nedir?\" diyecekler; de ki: \"Doğu ve batı Allah'ındır. O, dilediğini doğru yola eriştirir\".","numberInSurah":142,"juz":2,"manzil":1,"page":22,"ruku":18,"hizbQuarter":9,"sajda":false},{"number":150,"text":"Böylece sizi insanlara şahid ve örnek olmanız için tam ortada bulunan bir ümmet kıldık. Peygamber de size şahid ve örnektir. Senin yöneldiğin yönü, Peygambere uyanları, cayacaklardan ayırdetmek için kıble yaptık. Doğrusu Allah'ın yola koyduğu kimselerden başkasına bu ağır bir şeydir. Allah ibadetlerinizi boşa çıkaracak değildir. Doğrusu Allah insanlara şefkat gösterir, merhamet eder.","numberInSurah":143,"juz":2,"manzil":1,"page":22,"ruku":18,"hizbQuarter":9,"sajda":false},{"number":151,"text":"Yüzünü göğe çevirip durduğunu görüyoruz. Hoşnud olacağın kıbleye seni elbette çevireceğiz. Artık yüzünü Mescid-i Haram semtine çevir; bulunduğunuz yerde yüzlerinizi o yöne çevirin. Doğrusu Kitap verilenler, bunun Rab'lerinden bir gerçek olduğunu bilirler. Allah onların yaptıklarından gafil değildir.","numberInSurah":144,"juz":2,"manzil":1,"page":22,"ruku":18,"hizbQuarter":9,"sajda":false},{"number":152,"text":"Sen, Kitap verilenlere her türlü delili getirsen, yine de kıblene uymazlar; sen de onların kıblesine uyacak değilsin. Onlar birbirlerinin kıblesine de uymazlar. And olsun ki, eğer sana gelen ilimden sonra onların heveslerine uyarsan, şüphesiz o zaman zulmedenlerden olursun.","numberInSurah":145,"juz":2,"manzil":1,"page":22,"ruku":18,"hizbQuarter":9,"sajda":false},{"number":153,"text":"Kendilerine Kitap verdiklerimiz, onu (peygamberi) oğullarını tanıdıkları gibi tanırlar. Onlardan bir takımı, doğrusu bile bile hakkı gizlerler.","numberInSurah":146,"juz":2,"manzil":1,"page":23,"ruku":18,"hizbQuarter":9,"sajda":false},{"number":154,"text":"Gerçek Rabb'indendir, sakın şüphelenenlerden olma.","numberInSurah":147,"juz":2,"manzil":1,"page":23,"ruku":18,"hizbQuarter":9,"sajda":false},{"number":155,"text":"Herkesin yöneldiği bir yön vardır. Hayırlı işlerde birbirinizle yarışın. Nerede olursanız olun Allah sizi bir araya toplar, Allah şüphesiz her şeye Kadir'dir.","numberInSurah":148,"juz":2,"manzil":1,"page":23,"ruku":19,"hizbQuarter":9,"sajda":false},{"number":156,"text":"Her nereden yola çıkarsan, yüzünü Mescid-i Haram semtine çevir, şüphesiz bu Rabbinden bir haktır. Allah, yaptıklarınızdan gafil değildir.","numberInSurah":149,"juz":2,"manzil":1,"page":23,"ruku":19,"hizbQuarter":9,"sajda":false},{"number":157,"text":"Her nereden çıkarsan, yüzünü Mescid-i Haram semtine çevir. İnsanların zulmedenlerinden başkalarının size karşı gösterecekleri bir hüccet olmaması için, her nerede olursanız, yüzlerinizi oranın semtine çevirin, bu hususta onlardan korkmayın. Benden korkun da size olan nimetimi tamamlayayım. Böylece doğru yolu bulursunuz.","numberInSurah":150,"juz":2,"manzil":1,"page":23,"ruku":19,"hizbQuarter":9,"sajda":false},{"number":158,"text":"Nitekim Biz size, ayetlerimizi okuyacak, sizi her kötülükten arıtacak, size kitabı ve hikmeti öğretecek ve bilmediklerinizi bildirecek aranızdan, bir Peygamber gönderdik.","numberInSurah":151,"juz":2,"manzil":1,"page":23,"ruku":19,"hizbQuarter":9,"sajda":false},{"number":159,"text":"Artık Beni anın, Ben de sizi anayım; Bana şükredin, nankörlük etmeyin.","numberInSurah":152,"juz":2,"manzil":1,"page":23,"ruku":19,"hizbQuarter":9,"sajda":false},{"number":160,"text":"Ey İnananlar! Sabır ve namazla yardım dileyin. Allah, muhakkak ki sabredenlerle beraberdir.","numberInSurah":153,"juz":2,"manzil":1,"page":23,"ruku":20,"hizbQuarter":9,"sajda":false},{"number":161,"text":"Allah yolunda öldürülenlere \"Ölüler\" demeyin, zira onlar diridirler, fakat siz farkında değilsiniz.","numberInSurah":154,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":9,"sajda":false},{"number":162,"text":"Muhakkak sizi biraz korku, biraz açlık ve mallardan, canlardan, ürünlerden biraz eksiltmekle deneriz, sabredenleri müjdele.","numberInSurah":155,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":9,"sajda":false},{"number":163,"text":"Onlara bir musibet geldiğinde: \"Biz Allah'ınız ve elbette O'na döneceğiz\" derler.","numberInSurah":156,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":9,"sajda":false},{"number":164,"text":"Rablerinin mağfiret ve rahmeti onlaradır. O'nun yolunda olanlar da onlardır.","numberInSurah":157,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":9,"sajda":false},{"number":165,"text":"Şüphesiz Safa ile Merve Allah'ın nişanelerindendir. Kim Kabe'yi hacceder veya umre yaparsa, bu ikisini de tavaf etmesinde bir beis yoktur. Kim gönülden iyilik yaparsa, karşılığını görür. Doğrusu Allah şükrün karşılığını verendir ve bilendir.","numberInSurah":158,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":10,"sajda":false},{"number":166,"text":"İndirdiğimiz belgeleri ve doğru yolu Kitab'da insanlara açıkladıktan sonra, gizleyen kimseler var ya, onlara hem Allah lanet eder, hem lanetçiler lanet eder, ancak tevbe edenler, ıslah olanlar ve gerçeği ortaya koyanlar müstesna; işte onların tevbesini kabul ederim. Ben, tevbeleri daima kabul ve merhamet edenim.","numberInSurah":159,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":10,"sajda":false},{"number":167,"text":"Ancak tövbe edip durumlarını düzeltenler ve gerçeği açıkça ortaya koyanlar (lanetlenmekten) kurtulmuşlardır. Çünkü ben onların tövbelerini kabul ederim. Zira ben tövbeleri çok kabul edenim, çok merhamet edenim.","numberInSurah":160,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":10,"sajda":false},{"number":168,"text":"İnkar edip de o halde ölenler var ya, işte, Allah'ın, meleklerin, insanların hepsinin laneti onlaradır.","numberInSurah":161,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":10,"sajda":false},{"number":169,"text":"Lanette temellidirler, onlardan azab hafifletilmez ve onların azabı geciktirilmez.","numberInSurah":162,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":10,"sajda":false},{"number":170,"text":"Tanrınız bir tek Tanrıdır. O, merhamet eden, merhametli olandan başka Tanrı yoktur.","numberInSurah":163,"juz":2,"manzil":1,"page":24,"ruku":20,"hizbQuarter":10,"sajda":false},{"number":171,"text":"Göklerin ve yerin yaratılmasında, gece ile gündüzün birbiri ardınca gelmesinde, insanlara yararlı şeylerle denizde süzülen gemilerde, Allah'ın gökten indirip yeri ölümünden sonra dirilttiği suda, her türlü canlıyı orada yaymasında, rüzgarları ve yerle gök arasında emre amade duran bulutları döndürmesinde, düşünen kimseler için deliller vardır.","numberInSurah":164,"juz":2,"manzil":1,"page":25,"ruku":21,"hizbQuarter":10,"sajda":false},{"number":172,"text":"İnsanlar arasında, Allah'ı bırakıp, O'na koştukları eşleri tanrı olarak benimseyenler ve onları, Allah'ı severcesine sevenler vardır. Müminlerin Allah'ı sevmesi ise hepsinden kuvvetlidir. Zalimler azabı gördükleri zaman, bütün kuvvetin Allah'a aid bulunacağını ve Allah'ın azabının şiddetli olduğunu keşke bilselerdi!","numberInSurah":165,"juz":2,"manzil":1,"page":25,"ruku":21,"hizbQuarter":10,"sajda":false},{"number":173,"text":"Nitekim, kendilerine uyulanlar, azabı görünce uyanlardan uzaklaşacaklar ve aralarındaki bağlar kopacaktır.","numberInSurah":166,"juz":2,"manzil":1,"page":25,"ruku":21,"hizbQuarter":10,"sajda":false},{"number":174,"text":"Uyanlar: \"Keşke bizim için dünyaya bir dönüş olsa da, bizden uzaklaştıkları gibi biz de onlardan uzaklaşsak\" derler. Böylece Allah onlara, hasretini çekecekleri işlerini gösterir. Onlar cehennemden çıkmayacaklardır.","numberInSurah":167,"juz":2,"manzil":1,"page":25,"ruku":21,"hizbQuarter":10,"sajda":false},{"number":175,"text":"Ey İnsanlar! Yeryüzündeki temiz ve helal şeylerden yiyin, şeytana ayak uydurmayın, zira o sizin için apaçık bir düşmandır.","numberInSurah":168,"juz":2,"manzil":1,"page":25,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":176,"text":"Muhakkak size, kötülüğü, hayasızlığı, Allah'a karşı da bilmediğiniz şeyi söylemenizi emreder.","numberInSurah":169,"juz":2,"manzil":1,"page":25,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":177,"text":"Onlara: \"Allah'ın indirdiğine uyun\" denilince, \"Hayır, atalarımızı yapar bulduğumuz şeye uyarız\" derler; ya ataları bir şey akledemeyen ve doğru olmayan kimseler idiyseler?","numberInSurah":170,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":178,"text":"İnkar edenlerin durumu, çağırma ve bağırmadan başkasını duymayarak haykıran gibidir. Sağırdırlar, dilsizdirler, kördürler, bu yüzden akledemezler.","numberInSurah":171,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":179,"text":"Ey İnananlar! Sizi rızıklandırdığımızın temizlerinden yiyin; yalnız Allah'a kulluk ediyorsanız, O'na şükredin.","numberInSurah":172,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":180,"text":"Şüphesiz size ölü hayvan etini, kanı, domuz etini, Allah'tan başkası için kesilen hayvanı haram kılmıştır; fakat, darda kalana, başkasının payına el uzatmamak ve zaruret miktarını aşmamak üzere günah sayılmaz. Çünkü Allah bağışlayandır, merhamet edendir.","numberInSurah":173,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":181,"text":"Gerçekten, Allah'ın indirdiği Kitap'tan bir şeyi gizlemede bulunup onu az bir değere değişenler var ya, onların karınlarına tıkındıkları ancak ateştir. Allah kıyamet günü onlarla konuşmaz ve onları günahlardan arıtmaz. Onlara elem verici azab vardır.","numberInSurah":174,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":182,"text":"Onlar doğruluk yerine sapıklığı, mağfiret yerine azabı alanlardır.","numberInSurah":175,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":183,"text":"Bu da, Allah'ın Kitab'ı doğru olarak indirmesinden ileri geliyor. Kitap hakkında ayrılığa düşenler doğrusu derin bir çıkmazdadırlar.","numberInSurah":176,"juz":2,"manzil":1,"page":26,"ruku":22,"hizbQuarter":10,"sajda":false},{"number":184,"text":"Yüzlerinizi doğudan yana ve batıdan yana çevirmeniz iyi olmak demek değildir; Lakin iyi olan, Allah'a, ahiret gününe, meleklere, Kitap'a, peygamberlere inanan, O'nun sevgisiyle, yakınlarına, yetimlere, düşkünlere, yolculara, yoksullara ve köleler uğrunda mal veren, namaz kılan, zekat veren ve ahidleştiklerinde ahidlerine vefa gösterenler, zorda, darda ve savaş alanında sabredenlerdir. İşte onlar doğru olanlardır ve sakınanlar ancak onlardır.","numberInSurah":177,"juz":2,"manzil":1,"page":27,"ruku":23,"hizbQuarter":11,"sajda":false},{"number":185,"text":"Ey İnananlar! Öldürülenler hakkında size kısas farz kılındı: Hür ile hür insan, köle ile köle ve kadın ile kadın. Öldüren, ölenin kardeşi tarafından bağışlanmışsa, kendisine örfe uymak ve bağışlayana güzellikle diyet ödemek gerekir. Bu, Rabbiniz'den bir hafifletme ve rahmettir. Bundan sonra tecavüzde bulunana elem verici azab vardır.","numberInSurah":178,"juz":2,"manzil":1,"page":27,"ruku":23,"hizbQuarter":11,"sajda":false},{"number":186,"text":"Ey akıl sahibleri! Kısasta sizin için hayat vardır. Artık, Allah'a karşı gelmekten sakınırsınız.","numberInSurah":179,"juz":2,"manzil":1,"page":27,"ruku":23,"hizbQuarter":11,"sajda":false},{"number":187,"text":"Birinize ölüm geldiği zaman, eğer mal bırakıyorsa, ana babaya, yakınlara, uygun bir tarzda vasiyet etmesi Allah'a karşı gelmekten sakınanlara bir borç olarak size farz kılındı.","numberInSurah":180,"juz":2,"manzil":1,"page":27,"ruku":23,"hizbQuarter":11,"sajda":false},{"number":188,"text":"Vasiyeti işittikten sonra değiştiren olursa, bunun günahı değiştirenin üzerinedir. Allah şüphesiz işitir ve bilir.","numberInSurah":181,"juz":2,"manzil":1,"page":27,"ruku":23,"hizbQuarter":11,"sajda":false},{"number":189,"text":"Vasiyet edenin yanılacağından veya günaha gireceğinden endişe duyan kimse, ilgililerin arasını düzeltirse ona günah yoktur. Allah şüphesiz bağışlar ve merhamet eder.","numberInSurah":182,"juz":2,"manzil":1,"page":28,"ruku":23,"hizbQuarter":11,"sajda":false},{"number":190,"text":"Ey İnananlar! Oruç, sizden öncekilere farz kılındığı gibi, Allah'a karşı gelmekten sakınasınız diye, size sayılı günlerde farz kılındı. İçinizden hasta olan veya yolculukta bulunan, tutamadığı günlerin sayısınca diğer günlerde tutar. Oruca dayanamıyanlar, bir düşkünü doyuracak kadar fidye verir. Kim gönülden iyilik yaparsa o iyilik kendisinedir. Oruç tutmanız eğer bilirseniz sizin için hayırlıdır.","numberInSurah":183,"juz":2,"manzil":1,"page":28,"ruku":24,"hizbQuarter":11,"sajda":false},{"number":191,"text":"Ey İnananlar! Oruç, sizden öncekilere farz kılındığı gibi, Allah'a karşı gelmekten sakınasınız diye, size sayılı günlerde farz kılındı. İçinizden hasta olan veya yolculukta bulunan, tutamadığı günlerin sayısınca diğer günlerde tutar. Oruca dayanamıyanlar, bir düşkünü doyuracak kadar fidye verir. Kim gönülden iyilik yaparsa o iyilik kendisinedir. Oruç tutmanız eğer bilirseniz sizin için hayırlıdır.","numberInSurah":184,"juz":2,"manzil":1,"page":28,"ruku":24,"hizbQuarter":11,"sajda":false},{"number":192,"text":"Ramazan ayı, ki onda Kuran, insanlara yol gösterici ve doğruyu yanlıştan ayırıcı belgeler olarak indirildi. Sizden bu ayı idrak eden, onda oruç tutsun; hasta veya yolculukta olan, tutamadığı günlerin sayısınca diğer günlerde tutsun. Allah size kolaylık ister, zorluk istemez. Bu kolaylıkları, sayıyı tamamlamanız ve size yol gösterdiğine karşılık O'nu ululamanız için meşru kılmıştır; ola ki şükredersiniz.","numberInSurah":185,"juz":2,"manzil":1,"page":28,"ruku":24,"hizbQuarter":11,"sajda":false},{"number":193,"text":"Kullarım sana Beni sorarlarsa, bilsinler ki Ben, şüphesiz onlara yakınım. Benden isteyenin, dua ettiğinde duasını kabul ederim. Artık onlar da davetimi kabul edip Bana inansınlar ki doğru yolda yürüyenlerden olsunlar.","numberInSurah":186,"juz":2,"manzil":1,"page":28,"ruku":24,"hizbQuarter":11,"sajda":false},{"number":194,"text":"Oruç tuttuğunuz günlerin gecesi kadınlarınıza yaklaşmanız size helal kılındı, onlar sizin örtünüz, siz de onların örtülerisiniz. Allah, nefsinize güvenemiyeceğinizi biliyordu, bu sebeple tevbenizi kabul edip sizi affetti; artık onlara yaklaşabilirsiniz. Allah'ın sizin için takdir ettiğini dileyin. Tan yerinde, beyaz iplik siyah iplikten sizce ayırdedilinceye kadar, yiyin için, sonra orucu geceye kadar tamamlayın. Mescidlerde itikafa çekildiğinizde kadınlarınıza yaklaşmayın. Allah insanlara yasaklardan sakınsınlar diye ayetlerini böylece apaçık bildirir.","numberInSurah":187,"juz":2,"manzil":1,"page":29,"ruku":24,"hizbQuarter":11,"sajda":false},{"number":195,"text":"Aranızda mallarınızı haksızlıkla yemeyin; bildiğiniz halde günaha girerek insanların mallarından bir kısmını yemek için onu hakimlere aktarmayın.","numberInSurah":188,"juz":2,"manzil":1,"page":29,"ruku":24,"hizbQuarter":11,"sajda":false},{"number":196,"text":"Sana hilal halindeki ayları sorarlar. De ki: \"Onlar, insanların ve hac vakitlerinin ölçüsüdür\". Evlere arkalarından girmeniz iyilik değildir; iyi kimse kötülükten sakınan kimsedir. Evlere kapılarından girin; Allah'tan sakının ki muradınıza erersiniz.","numberInSurah":189,"juz":2,"manzil":1,"page":29,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":197,"text":"Sizinle savaşanlarla Allah yolunda savaşın, aşırı gitmeyin; doğrusu Allah aşırı gidenleri sevmez.","numberInSurah":190,"juz":2,"manzil":1,"page":29,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":198,"text":"Onları bulduğunuz yerde öldürün. Sizi çıkardıkları yerden siz de onları çıkarın. Fitne çıkarmak, adam öldürmekten daha kötüdür. Mescidi Haram'ın yanında, onlar savaşmadıkça siz de onlarla savaşmayın. Sizinle savaşırlarsa onları öldürün. İnkar edenlerin cezası böyledir.","numberInSurah":191,"juz":2,"manzil":1,"page":30,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":199,"text":"Vazgeçerlerse onları bağışlayın; şüphesiz Allah bağışlar ve merhamet eder.","numberInSurah":192,"juz":2,"manzil":1,"page":30,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":200,"text":"Fitne kalmayıp, yalnız Allah'ın dini ortada kalana kadar onlarla savaşın. Eğer vazgeçerlerse sataşmayın. Zulmedenlerden başkasına düşmanlık yoktur.","numberInSurah":193,"juz":2,"manzil":1,"page":30,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":201,"text":"Hürmetli ay, hürmetli aya mukabildir, hürmetler karşılıklıdır; o halde, size tecavüz edene (saldırana), size saldırdıkları gibi saldırın. Allah'tan sakının ve Allah'ın sakınanlarla beraber olduğunu bilin.","numberInSurah":194,"juz":2,"manzil":1,"page":30,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":202,"text":"Allah yolunda sarf edin, kendinizi kendi elinizle tehlikeye atmayın, işlerinizi iyi yapın. Şüphesiz Allah iyi iş yapanları sever.","numberInSurah":195,"juz":2,"manzil":1,"page":30,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":203,"text":"Başladığınız hac ve umreyi Allah için tamamlayın. Alıkonursanız, kolayınıza gelen bir kurban gönderin. Kurban, yerine ulaşıncaya kadar, başlarınızı tıraş etmeyin. İçinizde hasta olan veya başından rahatsız bulunan varsa fidye olarak ya oruç tutması, ya sadaka vermesi ya da kurban kesmesi gerekir. Güven içinde olursanız, hacca kadar umreden faydalanabilen kimseye kolayına gelen bir kurban kesmek, bulamayana, hac esnasında üç gün ve döndüğünüzde yedi gün, ki o tam on gündür oruç tutmak gerekir. Bu, ailesi Mescidi Haram'da oturmayan kimseler içindir. Allah'tan sakının ve Allah'ın cezasının şiddetli olacağını bilin.","numberInSurah":196,"juz":2,"manzil":1,"page":30,"ruku":25,"hizbQuarter":12,"sajda":false},{"number":204,"text":"Hac bilinen aylardadır. O aylarda hacca girişen kimse bilmelidir ki, hacda kadına yaklaşmak, sövüşmek, dövüşmek yoktur. Ne iyilik yaparsanız Allah onu bilir. Kendinize azık edinin, şüphe yok ki azığın en iyisi Allah korkusudur. Ey akıl sahibleri! Benden korkun.","numberInSurah":197,"juz":2,"manzil":1,"page":31,"ruku":26,"hizbQuarter":12,"sajda":false},{"number":205,"text":"Rabbiniz'den refah istemenizde bir engel yoktur. Arafat'tan indiğinizde, Allah'ı Meşari Haram'da anın; O'nu, size gösterdiği şekilde zikredin. Nitekim siz önceleri hiç şüphesiz sapıklardandınız.","numberInSurah":198,"juz":2,"manzil":1,"page":31,"ruku":26,"hizbQuarter":12,"sajda":false},{"number":206,"text":"Sonra, insanların toplu olarak akın ettiği yerden, siz de akın edin. Allah'tan mağfiret dileyin. Allah bağışlar ve merhamet eder.","numberInSurah":199,"juz":2,"manzil":1,"page":31,"ruku":26,"hizbQuarter":12,"sajda":false},{"number":207,"text":"Hac ibadetinizi bitirdiğinizde, babalarınızı andığınız gibi, hatta ondan daha kuvvetli bir anışla Allah'ı anın. \"Rabbimiz! Bize sadece dünyada ver\" diyen insanlar vardır, öylesine, ahirette bir pay yoktur.","numberInSurah":200,"juz":2,"manzil":1,"page":31,"ruku":26,"hizbQuarter":12,"sajda":false},{"number":208,"text":"\"Rabbimiz! Bize dünyada iyiyi, ahirette de iyiyi ver, bizi ateşin azabından koru\" diyenler vardır.","numberInSurah":201,"juz":2,"manzil":1,"page":31,"ruku":26,"hizbQuarter":12,"sajda":false},{"number":209,"text":"İşte onlara, kazançlarından ötürü karşılık vardır. Allah hesabı çabuk görür.","numberInSurah":202,"juz":2,"manzil":1,"page":31,"ruku":26,"hizbQuarter":12,"sajda":false},{"number":210,"text":"Allah'ı sayılı günlerde anın. Günahtan sakınan kimseye, acele edip, Mina'daki ibadeti iki günde bitirirse günah yoktur, geri kalsa da günah yoktur. Allah'tan sakının. O'nun katında toplanacağınızı bilin.","numberInSurah":203,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":211,"text":"Dünya hayatına dair konuşması senin hoşuna giden, pek azılı düşman iken, kalbinde olana Allah'ı şahid tutan, işbaşına geçince, yeryüzünde bozgunculuk yapmaya, ekin ve nesli yok etmeğe çabalayan insanlar vardır. Allah bozgunculuğu sevmez.","numberInSurah":204,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":212,"text":"Dünya hayatına dair konuşması senin hoşuna giden, pek azılı düşman iken, kalbinde olana Allah'ı şahid tutan, işbaşına geçince, yeryüzünde bozgunculuk yapmaya, ekin ve nesli yok etmeğe çabalayan insanlar vardır. Allah bozgunculuğu sevmez.","numberInSurah":205,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":213,"text":"Ona: \"Allah'tan sakın\" denince, gururu kendisine günah işletir, artık ona cehennem yetişir, ne kötü yataktır!..","numberInSurah":206,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":214,"text":"İnsanlar arasında, Allah'ın rızasını kazanmak için canını verenler vardır. Allah kullarına karşı şefkatlidir.","numberInSurah":207,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":215,"text":"Ey İnananlar! Hep birden barışa girin, şeytana ayak uydurmayın, o sizin apaçık düşmanınızdır.","numberInSurah":208,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":216,"text":"Size belgeler geldikten sonra kayarsanız, biliniz ki Allah güçlüdür, Hakim'dir.","numberInSurah":209,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":217,"text":"Onlar, bulut gölgeleri içinde, Allah'ın azabının ve meleklerin tepelerine inip işin bitmesini mi bekliyorlar? Bütün işler Allah'a dönecektir.","numberInSurah":210,"juz":2,"manzil":1,"page":32,"ruku":26,"hizbQuarter":13,"sajda":false},{"number":218,"text":"İsrailoğullarına sor; onlara apaçık nice ayetler verdik, Allah'ın nimetini, kendisine geldikten sonra kim değiştirirse, bilsin ki, Allah'ın cezası şüphesiz şiddetlidir.","numberInSurah":211,"juz":2,"manzil":1,"page":33,"ruku":27,"hizbQuarter":13,"sajda":false},{"number":219,"text":"İnkar edenlere, dünya hayatı güzel görünür, onlar, inananlarla alay ederler, oysa, Allah'a karşı gelmekten sakınanlar kıyamet günü onların üstünde olacaklardır. Allah dilediğini hesabsız şekilde rızıklandırır.","numberInSurah":212,"juz":2,"manzil":1,"page":33,"ruku":27,"hizbQuarter":13,"sajda":false},{"number":220,"text":"İnsanlar bir tek ümmetti. Allah peygamberleri müjdeci ve uyarıcı olarak gönderdi; insanların ayrılığa düşecekleri hususlarda aralarında hüküm vermek için onlarla birlikte hak Kitaplar indirdi. Ancak Kitap verilenler, kendilerine belgeler geldikten sonra, aralarındaki ihtiras yüzünden onda ayrılığa düştüler. Allah, inananları, ayrılığa düştükleri gerçeğe kendi izni ile eriştirdi. Allah dilediğini doğru yola eriştirir.","numberInSurah":213,"juz":2,"manzil":1,"page":33,"ruku":27,"hizbQuarter":13,"sajda":false},{"number":221,"text":"Sizden önce gelenlerin durumu sizin başınıza gelmeden cennete gireceğinizi mi zannettiniz? Peygamber ve onunla beraber müminler: \"Allah'ın yardımı ne zaman?\" diyecek kadar darlığa ve zorluğa uğramışlar ve sarsılmışlardı; iyi bilin ki Allah'ın yardımı şüphesiz yakındır.","numberInSurah":214,"juz":2,"manzil":1,"page":33,"ruku":27,"hizbQuarter":13,"sajda":false},{"number":222,"text":"Sana, ne sarfedeceklerini sorarlar, de ki: \"Sarfedeceğiniz mal, ana baba, yakınlar, yetimler, düşkünler, yolcular içindir. Yaptığınız her iyiliği Allah şüphesiz bilir\".","numberInSurah":215,"juz":2,"manzil":1,"page":33,"ruku":27,"hizbQuarter":13,"sajda":false},{"number":223,"text":"Savaş, hoşunuza gitmediği halde size farz kılındı. İhtimal ki hoşlanmadığınız şey sizin iyiliğinizedir ve ihtimal ki sevdiğiniz bir şey sizin kötülüğünüzedir. Siz bilmezsiniz, Allah bilir.","numberInSurah":216,"juz":2,"manzil":1,"page":34,"ruku":27,"hizbQuarter":13,"sajda":false},{"number":224,"text":"Sana hürmet edilen ayı, o aydaki savaşı sorarlar. De ki: \"O ayda savaşmak büyük suçtur. Allah yolundan alıkoymak, O'nu inkar etmek, Mescidi Haram'a engel olmak ve halkını oradan çıkarmak Allah katında daha büyük suçtur. Fitne çıkarmak ise öldürmekten daha büyüktür\". Güçleri yeterse, dininizden döndürünceye kadar sizinle savaşa devam ederler. İçinizden dininden dönüp kafir olarak ölen olursa, bunların işleri dünya ve ahirette boşa gitmiş olur. İşte cehennemlikler onlardır, onlar orada temellidirler.","numberInSurah":217,"juz":2,"manzil":1,"page":34,"ruku":28,"hizbQuarter":13,"sajda":false},{"number":225,"text":"İnananlar, hicret edenler ve Allah yolunda cihad edenler Allah'ın rahmetini umarlar. Allah bağışlar ve merhamet eder.","numberInSurah":218,"juz":2,"manzil":1,"page":34,"ruku":28,"hizbQuarter":13,"sajda":false},{"number":226,"text":"Sana içki ve kumarı sorarlar, de ki: \"İkisinde hem büyük günah ve hem insanlara bazı faydalar vardır. Günahları faydasından daha büyüktür\". Ne sarfedeceklerini sana sorarlar, de ki: \"Artanı\". Böylece Allah, dünya ve ahiret hususunda düşünesiniz diye size ayetleri açıklar.","numberInSurah":219,"juz":2,"manzil":1,"page":34,"ruku":28,"hizbQuarter":14,"sajda":false},{"number":227,"text":"Sana yetimleri sorarlar, de ki: \"Onların işlerini düzeltmek hayırlıdır\". Eğer onlarla bir arada yaşarsanız, artık onlar sizin kardeşlerinizdir. Allah düzeltenden bozanı ayırdetmesini bilir. Allah dileseydi sizi zora sokardı. Allah şüphesiz güçlüdür, Hakim'dir.","numberInSurah":220,"juz":2,"manzil":1,"page":35,"ruku":28,"hizbQuarter":14,"sajda":false},{"number":228,"text":"Allah'a eş koşan kadınlarla onlar imana gelinceye kadar evlenmeyin. İnanan bir cariye, hoşunuza gitse de ortak koşan bir kadından daha iyidir. İnanmalarına kadar; ortak koşan erkeklerle mümin kadınları evlendirmeyin. İnanan bir köle, hoşunuza gitmiş olsa da, ortak koşan bir erkekten daha iyidir. İşte onlar ateşe çağırırlar, Allah ise izniyle cennete ve mağfirete çağırır ve insanlara ibret alsınlar diye ayetlerini açıklar.","numberInSurah":221,"juz":2,"manzil":1,"page":35,"ruku":28,"hizbQuarter":14,"sajda":false},{"number":229,"text":"Sana, kadınların aybaşı hali hakkında da sorarlar, de ki: \"O bir ezadır (rahatsızlıktır)\". Aybaşı halinde iken kadınlardan el çekin, temizlenmelerine kadar onlara yaklaşmayın. Temizlendikleri zaman, Allah'ın size buyurduğu yoldan yaklaşın. Allah şüphesiz daima tevbe edenleri sever, temizlenenleri de sever.","numberInSurah":222,"juz":2,"manzil":1,"page":35,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":230,"text":"Kadınlarınız sizin tarlanızdır, tarlanıza istediğiniz gibi gelin. İstikbal için hazırlıklı olun, Allah'tan sakının. O'na, hiç şüphesiz kavuşacağınızı bilin, bunu inananlara müjdele.","numberInSurah":223,"juz":2,"manzil":1,"page":35,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":231,"text":"İnsanların arasını düzeltmeniz, günahtan sakınmanız ve iyi olmanız için, Allah'a yaptığınız yeminleri engel kılmayın, Allah işitir ve bilir.","numberInSurah":224,"juz":2,"manzil":1,"page":35,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":232,"text":"Allah sizi rastgele yeminlerinizden dolayı değil, fakat kalblerinizin kasdettiği yeminlerden dolayı sorumlu tutar. Allah bağışlayandır, Halim'dir.","numberInSurah":225,"juz":2,"manzil":1,"page":36,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":233,"text":"Kadınlarına yaklaşmamaya yemin edenler, dört ay bekleyebilirler; eğer yeminlerinden dönerlerse, bilsinler ki Allah bağışlar ve merhamet eder.","numberInSurah":226,"juz":2,"manzil":1,"page":36,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":234,"text":"Şayet boşanmaya kararlı iseler, bilsinler ki Allah şüphesiz işitir ve bilir.","numberInSurah":227,"juz":2,"manzil":1,"page":36,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":235,"text":"Boşanan kadınlar, kendi kendilerine üç aybaşı hali beklerler, eğer Allah'a ve ahiret gününe inanmışlarsa, rahimlerinde Allah'ın yarattığını gizlemeleri kendilerine helal değildir. Kocaları bu arada barışmak isterlerse, karılarını geri almakta daha çok hak sahibidirler. Kadınların hakları, örfe uygun bir şekilde vazifelerine denktir. Erkeklerin onlardan bir üstün derecesi vardır. Allah güçlüdür. Hakim'dir.","numberInSurah":228,"juz":2,"manzil":1,"page":36,"ruku":29,"hizbQuarter":14,"sajda":false},{"number":236,"text":"Boşanma iki defadır. Ya iyilikle tutma ya da iyilik yaparak bırakmadır. İkisi Allah'ın yasalarını koruyamamaktan korkmadıkça kadınlara verdiklerinizden (mehirden) bir şey almanız size helal değildir. Eğer Allah'ın yasalarını ikisi koruyamıyacaklar diye korkarsanız, o zaman kadının fidye vermesinde (mehrinden vazgeçerse) ikisine de günah yoktur. Bunlar Allah'ın yasalarıdır, onları bozmayın. Allah'ın yasalarını bozanlar ancak zalimlerdir.","numberInSurah":229,"juz":2,"manzil":1,"page":36,"ruku":30,"hizbQuarter":14,"sajda":false},{"number":237,"text":"Bundan sonra kadını boşarsa, kadın başka birisiyle evlenmedikçe bir daha kendisine helal olmaz. Eğer ikinci koca da onu boşarsa, Allah'ın yasalarını koruyacaklarını sanırlarsa eski karı kocanın birbirlerine dönmelerine bir engel yoktur. Bunlar, bilenkimseler için Allah'ın açıkladığı yasalardır.","numberInSurah":230,"juz":2,"manzil":1,"page":36,"ruku":30,"hizbQuarter":14,"sajda":false},{"number":238,"text":"Kadınları boşadığınızda, müddetleri sona ererken, onları güzellikle tutun, ya da güzellikle bırakın, haklarına tecavüz etmek için onlara zararlı olacak şekilde tutmayın; böyle yapan şüphesiz kendisine yazık etmiş olur. Allah'ın ayetlerini de alaya almayın; Allah'ın üzerinize olan nimetini, öğüt vermek üzere size indirdiği Kitap ve hikmeti anın, Allah'tan sakının, Allah'ın her şeyi bildiğini bilin.","numberInSurah":231,"juz":2,"manzil":1,"page":37,"ruku":30,"hizbQuarter":14,"sajda":false},{"number":239,"text":"Kadınları boşadığınızda, müddetleri sona ermişse, kocaları ile birbirleriyle güzellikle anlaşmışlarsa evlenmelerine engel olmayın. İçinizden Allah'a ve ahiret gününe inanan kimse bundan ibret alır. Bu sizin için daha nezih ve daha paktır. Allah bilir, siz bilmezsiniz.","numberInSurah":232,"juz":2,"manzil":1,"page":37,"ruku":31,"hizbQuarter":14,"sajda":false},{"number":240,"text":"Anneler çocuklarını, emzirmeyi tamamlatmak isteyen baba için, tam iki sene emzirirler. Anaların yiyecek ve giyeceğini uygun bir şekilde sağlamak çocuk kendisinin olan babaya borçtur. Herkese ancak gücü nisbetinde teklifte bulunulur. Ana çocuğundan, çocuk kendisinin olan baba da çocuğundan dolayı zarara sokulmasın. Mirasçıya da aynı şeyi yapmak borçtur. Ana baba aralarında danışarak ve anlaşarak sütten kesmek isterlerse, ikisine de sorumluluk yoktur. Çocuklarınızı sütanneye emzirtmek isterseniz, vereceğinizi örfe uygun bir şekilde öderseniz, size sorumluluk yoktur. Allah'tan sakının, yaptıklarınızı gördüğünü bilin.","numberInSurah":233,"juz":2,"manzil":1,"page":37,"ruku":31,"hizbQuarter":15,"sajda":false},{"number":241,"text":"İçinizden ölenlerin bırakmış olduğu eşler kendi kendilerine dört ay on gün beklerler; müddetleri sona erdiğinde, onların kendi haklarında uygun şekilde yaptıklarından dolayı size sorumluluk yoktur. Allah işlediklerinizden haberdardır.","numberInSurah":234,"juz":2,"manzil":1,"page":38,"ruku":31,"hizbQuarter":15,"sajda":false},{"number":242,"text":"Böyle kadınlara kapalı bir şekilde evlenme teklif etmenizde veya içinizden onlarla evlenmeyi geçirmenizde size sorumluluk yoktur. Allah onları anacağınızı bilir. Sakın meşru sözler dışında onlarla gizlice sözleşmeyin, müddet sona erene kadar nikah akdine kalkışmayın. İçinizde olanı Allah'ın bildiğini bilin de O'ndan çekinin. Allah'ın bağışlayan ve Halim olduğunu bilin.","numberInSurah":235,"juz":2,"manzil":1,"page":38,"ruku":31,"hizbQuarter":15,"sajda":false},{"number":243,"text":"Kadınlara el sürmeden ve mehirlerini biçmeden onları boşarsanız size sorumluluk yoktur. Onları zengin kendi çapına, fakir kendi çapına uygun bir şekilde faydalandırın. Bu iyi davrananların şanına yakışır bir borçtur.","numberInSurah":236,"juz":2,"manzil":1,"page":38,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":244,"text":"Eğer onlara mehir biçer de el sürmeden onları boşarsanız, kendileri veya nikah akdi elinde olan erkeğin bağışlaması hali müstesna biçtiğinizin yarısını verin, bağışlamanız Allah'tan sakınmaya daha uygundur. Aranızdaki iyiliği unutmayın. Allah şüphesiz işlediklerinizi görür.","numberInSurah":237,"juz":2,"manzil":1,"page":38,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":245,"text":"Namazlara ve orta namaza devam edin; gönülden boyun eğerek Allah için namaza durun.","numberInSurah":238,"juz":2,"manzil":1,"page":39,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":246,"text":"Eğer korkarsanız, yaya yahut binekte iken kılın, güvene erişince, bilmediklerinizi öğrettiği gibi Allah'ı anın.","numberInSurah":239,"juz":2,"manzil":1,"page":39,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":247,"text":"İçinizden ölüp, eşler bırakacak olanlar, evlerinden çıkarılmaksızın, senesine kadar eşlerinin geçimini sağlayacak şeyi vasiyet etsinler; eğer çıkarlarsa kendilerinin meşru olarak yaptıklarından dolayı size sorumluluk yoktur. Allah güçlüdür, Hakim'dir.","numberInSurah":240,"juz":2,"manzil":1,"page":39,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":248,"text":"Boşanan kadınları, haksızlıktan sakınanlara bir borç olmak üzere, uygun bir surette faydalandırma vardır.","numberInSurah":241,"juz":2,"manzil":1,"page":39,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":249,"text":"Allah ayetlerini düşünesiniz diye böylece açıklamaktadır.","numberInSurah":242,"juz":2,"manzil":1,"page":39,"ruku":32,"hizbQuarter":15,"sajda":false},{"number":250,"text":"Binlerce kişinin memleketlerinden ölüm korkusuyla çıktıklarını görmedin mi? Allah onlara \"Ölün\" dedi. Sonra onları diriltti. Allah insanlara bol nimet verir, fakat insanların çoğu şükretmezler.","numberInSurah":243,"juz":2,"manzil":1,"page":39,"ruku":33,"hizbQuarter":16,"sajda":false},{"number":251,"text":"Allah yolunda savaşın; bilin ki Allah işitir ve bilir.","numberInSurah":244,"juz":2,"manzil":1,"page":39,"ruku":33,"hizbQuarter":16,"sajda":false},{"number":252,"text":"Allah'a, kat kat karşılığını arttıracağı güzel bir ödünç takdiminde kim bulunur? Allah hem darlaştırır, hem bollaştırır; O'na döneceksiniz.","numberInSurah":245,"juz":2,"manzil":1,"page":39,"ruku":33,"hizbQuarter":16,"sajda":false},{"number":253,"text":"Musa'dan sonra İsrailoğullarının ileri gelenlerini görmedin mi? Peygamberlerinden birine, \"Bize bir hükümdar gönder de Allah yolunda savaşalım\" demişlerdi. \"Ya savaş size farz kılındığında gitmeyecek olursanız?\" demişti. \"Memleketimizden ve çocuklarımızdan uzaklaştırıldığımıza göre niye Allah yolunda savaşmıyalım?\" demişlerdi. Ama savaş onlara farz kılınınca, az bir kısmı müstesna yüz cevirdiler. Allah zalimleri bilir.","numberInSurah":246,"juz":2,"manzil":1,"page":40,"ruku":33,"hizbQuarter":16,"sajda":false},{"number":254,"text":"Peygamberleri onlara \"Allah size şüphesiz, Talut'u hükümdar olarak gönderdi\" dedi. \"Biz hükümdarlığa ondan layık iken ve ona malca da bir bolluk verilmemişken bize hükümdar olmağa o nasıl layık olabilir?\" dediler, \"Doğrusu Allah size onu seçti, bilgice ve vücutça gücünü artırdı\" dedi. Allah mülkü dilediğine verir. Allah her şeyi kaplar ve bilir.","numberInSurah":247,"juz":2,"manzil":1,"page":40,"ruku":33,"hizbQuarter":16,"sajda":false},{"number":255,"text":"Peygamberleri onlara, \"Onun hükümdarlığının alameti, size sandığın gelmesidir, onda Rabbinizden gelen gönül rahatlığı ve Musa ailesinin ve Harun ailesinin bıraktıklarından kalanlar var; onu melekler taşır, eğer inanmışsanız bunda sizin için delil vardır\" dedi.","numberInSurah":248,"juz":2,"manzil":1,"page":40,"ruku":33,"hizbQuarter":16,"sajda":false},{"number":256,"text":"Talut orduyla birlikte ayrıldıktan sonra, \"Doğrusu Allah sizi bir ırmakla deneyecektir, ondan içen benden değildir, onu tatmayan eliyle sadece bir avuç avuçlayan müstesna şüphesiz bendendir\" dedi. Onlardan pek azı hariç, sudan içtiler. Kendisi ve kendisiyle olan inananlar ırmağı geçince, \"Bugün Calut ve ordusuna karşı koyacak gücümüz yok\" dediler. Kendilerinin Allah'a kavuşacağını bilenler ise: \"Nice az topluluk çok topluluğa Allah'ın izniyle üstün gelmiştir, Allah sabredenlerle beraberdir\" dediler.","numberInSurah":249,"juz":2,"manzil":1,"page":41,"ruku":34,"hizbQuarter":16,"sajda":false},{"number":257,"text":"Calut ve ordusuna karşı çıktıklarında, \"Rabbimiz! Bize sabır ver, sebatımızı artır, inkar eden millete karşı bize yardım et\" dediler.","numberInSurah":250,"juz":2,"manzil":1,"page":41,"ruku":34,"hizbQuarter":16,"sajda":false},{"number":258,"text":"Onları Allah'ın izniyle bozguna uğrattılar; Davud Calut'u öldürdü, Allah Davud'a hükümranlık ve hikmet verdi ve ona dilediğinden öğretti. Allah'ın insanları birbiriyle savması olmasaydı yeryüzünün düzeni bozulurdu. Fakat Allah alemlere lütufkardır.","numberInSurah":251,"juz":2,"manzil":1,"page":41,"ruku":34,"hizbQuarter":16,"sajda":false},{"number":259,"text":"İşte bunlar Allah'ın ayetleridir. Biz onları sana doğru olarak okuyoruz. Şüphesiz sen peygamberlerden birisin.","numberInSurah":252,"juz":2,"manzil":1,"page":41,"ruku":34,"hizbQuarter":16,"sajda":false},{"number":260,"text":"İşte bu peygamberlerden bir kısmını diğerlerinden üstün kıldık. Onlardan Allah'ın kendilerine hitabettiği, derecelerle yükselttikleri vardır. Meryem oğlu İsa'ya belgeler verdik, onu Ruhul Kudüs'le destekledik. Allah dileseydi, belgeler kendilerine geldikten sonra, peygamberlerin ardından birbirlerini öldürmezlerdi. Fakat ayrılığa düştüler, kimi inandı, kimi inkar etti. Allah dileseydi birbirlerini öldürmezlerdi, lakin Allah istediğini yapar.","numberInSurah":253,"juz":3,"manzil":1,"page":42,"ruku":34,"hizbQuarter":17,"sajda":false},{"number":261,"text":"Ey inananlar! Alışverişin, dostluğun, şefaatin olmayacağı günün gelmesinden önce sizi rızıklandırdığımızdan hayra sarfedin. İnkar edenler ancak yazık edenlerdir.","numberInSurah":254,"juz":3,"manzil":1,"page":42,"ruku":35,"hizbQuarter":17,"sajda":false},{"number":262,"text":"Allah, O'ndan başka tanrı olmayan, kendisini uyuklama ve uyku tutmayan, diri, her an yaratıklarını gözetip durandır. Göklerde olan ve yerde olan ancak O'nundur. O'nun izni olmadan katında şefaat edecek kimdir? Onların işlediklerini ve işleyeceklerini bilir, dilediğinden başka ilminden hiçbir şeyi kavrayamazlar. Hükümranlığı gökleri ve yeri kaplamıştır, onların gözetilmesi O'na ağır gelmez. O yücedir, büyüktür.","numberInSurah":255,"juz":3,"manzil":1,"page":42,"ruku":35,"hizbQuarter":17,"sajda":false},{"number":263,"text":"Dinde zorlama yoktur; Artık hak ile batıl iyice ayrılmıştır. Tağutu (saptırıcıları) inkar edip Allah'a inanan kimse, kopmak bilmeyen sağlam bir kulpa sarılmıştır. Allah işitendir, bilendir.","numberInSurah":256,"juz":3,"manzil":1,"page":42,"ruku":35,"hizbQuarter":17,"sajda":false},{"number":264,"text":"Allah inananların dostudur, onları karanlıklardan aydınlığa çıkarır. İnkar edenlerin ise dostları tağuttur. Onları aydınlıktan karanlıklara sürüklerler. İşte onlar cehennemliklerdir, onlar orada temelli kalacaklardır.","numberInSurah":257,"juz":3,"manzil":1,"page":43,"ruku":35,"hizbQuarter":17,"sajda":false},{"number":265,"text":"Allah kendisine mülk verdi diye İbrahim ile Rabbi hakkında tartışanı görmedin mi? İbrahim: \"Rabbim, dirilten ve öldürendir\" demişti. \"Ben de diriltir ve öldürürüm\" dedi; İbrahim, \"Şüphesiz Allah güneşi doğudan getiriyor, sen de batıdan getirsene\" dedi. İnkar eden şaşırıp kaldı. Allah zulmeden kimseleri doğru yola eriştirmez.","numberInSurah":258,"juz":3,"manzil":1,"page":43,"ruku":36,"hizbQuarter":17,"sajda":false},{"number":266,"text":"Yahut altı üstüne gelmiş bir kasabaya uğrayan kimseyi görmedin mi? \"Allah burayı ölümünden sonra acaba nasıl diriltecek?\" dedi. Bunun üzerine Allah onu yüz yıl ölü bıraktı, sonra diriltti, \"Ne kadar kaldın?\" dedi, \"Bir gün veya bir günden az kaldım\" dedi, \"Hayır yüz yıl kaldın, yiyeceğine içeceğine bak, bozulmamış; eşeğine bak ve hem seni insanlar için bir ibret kılacağız, kemiklere bak, onları nasıl birleştirip, sonra onlara et giydiriyoruz\" dedi; bu ona apaçık belli olunca, \"Artık Allah'ın her şeye Kadir olduğuna inanmış bulunuyorum\" dedi.","numberInSurah":259,"juz":3,"manzil":1,"page":43,"ruku":36,"hizbQuarter":17,"sajda":false},{"number":267,"text":"İbrahim: \"Rabbim! Ölüleri nasıl dirilttiğini bana göster\" dediğinde, \"İnanmıyor musun?\" deyince de, \"Hayır öyle değil, fakat kalbim iyice kansın\" demişti. \"Öyleyse dört çeşit kuş al, onları kendine alıştır, sonra onları parçalayıp her dağın üzerine bir parça koy, sonra onları çağır; koşarak sana gelirler. O halde Allah'ın güçlü ve Hakim olduğunu bil\" demişti.","numberInSurah":260,"juz":3,"manzil":1,"page":44,"ruku":36,"hizbQuarter":17,"sajda":false},{"number":268,"text":"Mallarını Allah yolunda sarfedenlerin durumu, her başağında yüz tane olmak üzere yedi başak veren tanenin durumu gibidir. Allah dilediğine kat kat verir. Allah'ın lütfü geniştir, O her şeyi bilendir.","numberInSurah":261,"juz":3,"manzil":1,"page":44,"ruku":37,"hizbQuarter":17,"sajda":false},{"number":269,"text":"Mallarını Allah yolunda sarfedip sonra sarfettikleri şeyin ardından başa kakmayan ve eza etmeyenlerin ecirleri Rablerinin katındadır. Onlara korku yoktur ve onlar üzülmeyeceklerdir.","numberInSurah":262,"juz":3,"manzil":1,"page":44,"ruku":37,"hizbQuarter":17,"sajda":false},{"number":270,"text":"Güzel bir söz ve bağışlama, peşinden eza gelen bir sadakadan daha iyidir. Allah müstağnidir, Halim'dir.","numberInSurah":263,"juz":3,"manzil":1,"page":44,"ruku":37,"hizbQuarter":18,"sajda":false},{"number":271,"text":"Ey İnananlar! Allah'a ve ahiret gününe inanmayıp, insanlara gösteriş için malını sarfeden kimse gibi, sadakalarınızı başa kakma ve eza etmekle boşa çıkarmayın. Onun durumu, üzerinde toprak bulunan kayanın durumu gibidir, üzerine bol yağmur yağdığındaonu cascavlak bırakır. Kazandıklarından hiçbir şey elde edemezler. Allah inkar eden kimseleri doğru yola eriştirmez.","numberInSurah":264,"juz":3,"manzil":1,"page":44,"ruku":37,"hizbQuarter":18,"sajda":false},{"number":272,"text":"Allah'ın rızasını kazanmak ve kalblerini sağlamlaştırmak için mallarını sarfedenlerin durumu, yüksekçe bir tepede bulunan, bol yağmur aldığında yemişlerini iki kat veren, bol yağmur yağmasa bile çisentisi düşen bir bahçenin durumu gibidir. Allah işlediklerinizi görür.","numberInSurah":265,"juz":3,"manzil":1,"page":45,"ruku":37,"hizbQuarter":18,"sajda":false},{"number":273,"text":"Hangi biriniz, kendisi ihtiyarlamış ve çocukları da güçsüzken, altlarından ırmaklar akan, hurma, üzüm ve her çeşit meyveleri bulunan bahçesinin, ateşli bir kasırganın kopmasıyla yanmasını ister? Düşünesiniz diye Allah size ayetlerini böylece açıklar.","numberInSurah":266,"juz":3,"manzil":1,"page":45,"ruku":37,"hizbQuarter":18,"sajda":false},{"number":274,"text":"Ey İnananlar! Kazandıklarınızın temizlerinden ve size yerden çıkardıklarımızdan sarfedin; iğrenmeden alamıyacağınız pis şeyleri vermeye kalkmayın. Allah'ın müstağni ve övülmeye layık olduğunu bilin.","numberInSurah":267,"juz":3,"manzil":1,"page":45,"ruku":38,"hizbQuarter":18,"sajda":false},{"number":275,"text":"Şeytan sizi fakirlikle korkutarak cimriliği ve hayasızlığı emreder; Allah ise kendisinden mağfiret ve bol nimet vadeder. Allah'ın lütfü boldur, O her şeyi bilir.","numberInSurah":268,"juz":3,"manzil":1,"page":45,"ruku":38,"hizbQuarter":18,"sajda":false},{"number":276,"text":"Hikmeti dilediğine verir. Kime hikmet verilmişse şüphesiz ona çokça hayır verilmiştir. Bundan ancak akıl sahipleri ibret alır.","numberInSurah":269,"juz":3,"manzil":1,"page":45,"ruku":38,"hizbQuarter":18,"sajda":false},{"number":277,"text":"Sarfettiğiniz harcı ve adadığınız adağı şüphesiz Allah bilir. Zulmedenlerin hiç yardımcıları yoktur.","numberInSurah":270,"juz":3,"manzil":1,"page":46,"ruku":38,"hizbQuarter":18,"sajda":false},{"number":278,"text":"Sadakaları açıkça verirseniz o ne güzel! Eğer onları yoksullara gizlice verirseniz sizin için daha iyidir. Allah onları kötülüklerinizden bir kısmına karşı tutar. Allah işlediklerinizden haberdardır.","numberInSurah":271,"juz":3,"manzil":1,"page":46,"ruku":38,"hizbQuarter":18,"sajda":false},{"number":279,"text":"Onların doğru yola iletilmeleri sana düşmez, fakat Allah dilediğini doğru yola eriştirir. Sarfettiğiniz iyi şey kendinizedir, zaten ancak Allah'ın rızasını kazanmak için sarfedersiniz. Sarfettiğiniz iyi bir şeyin karşılığı haksızlığa uğratılmaksızın size verilir.","numberInSurah":272,"juz":3,"manzil":1,"page":46,"ruku":38,"hizbQuarter":19,"sajda":false},{"number":280,"text":"Sadakalarınızı, kendilerini Allah yoluna adayıp yeryüzünde dolaşamayanlara, hayalarından dolayı, kendilerini tanımayanların zengin saydıkları yoksullara verin. Onları yüzlerinden tanırsın, insanlardan yüzsüzlük ederek bir şey istemezler. Sarfettiğiniz iyi bir şeyi Allah şüphesiz bilir.","numberInSurah":273,"juz":3,"manzil":1,"page":46,"ruku":38,"hizbQuarter":19,"sajda":false},{"number":281,"text":"Gece gündüz, açık gizli, mallarını sarfedenlerin mükafatlarını Rab'leri verecektir. Onlara korku yoktur ve onlar üzülmeyeceklerdir.","numberInSurah":274,"juz":3,"manzil":1,"page":46,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":282,"text":"Faiz yiyenler mahşerde ancak şeytanın çarptığı kimsenin kalktığı gibi kalkarlar. Bu, onların, \"Zaten alışveriş de faiz gibidir\" demelerindendir. Oysa Allah alışverişi helal, faizi haram kıldı. Kime Rabb'inden bir öğüt gelir de faizcilikten geri durursa, geçmişi kendisinedir, onun işi Allah'a aittir. Kim faizciliğe dönerse, işte onlar cehennemliktir, onlar orada temelli kalacaklardır.","numberInSurah":275,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":283,"text":"Allah faizi eksiltir, sadakaları bereketlendirir. Allah pek nankör olan hiçbir günahkarı sevmez.","numberInSurah":276,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":284,"text":"İnanıp yararlı işler işleyenlerin, namaz kılıp, zekat verenlerin Rab'leri katında ecirleri vardır. Onlara korku yoktur ve onlar üzülmeyeceklerdir.","numberInSurah":277,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":285,"text":"Ey İnananlar! Allah'tan sakının, inanmışsanız, faizden arta kalmış hesabdan vazgeçin.","numberInSurah":278,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":286,"text":"Böyle yapmazsanız, bunun Allah'a ve Peygamberine karşı açılmış bir savaş olduğunu bilin. Eğer tevbe ederseniz sermayeniz sizindir. Böylece haksızlık etmemiş ve haksızlığa uğramamış olursunuz.","numberInSurah":279,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":287,"text":"Borçlu darda ise, eli genişleyinceye kadar ona mühlet verin. Bilmiş olsanız borcu bağışlamanız sizin için daha hayırlıdır.","numberInSurah":280,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":288,"text":"Allah'a döneceğiniz ve sonra haksızlığa uğramadan herkesin kazancının kendisine eksiksiz verileceği günden korkunuz.","numberInSurah":281,"juz":3,"manzil":1,"page":47,"ruku":39,"hizbQuarter":19,"sajda":false},{"number":289,"text":"Ey İnananlar! Birbirinize belirli bir süre için borçlandığınız zaman onu yazınız. İçinizden bir katip doğru olarak yazsın; katip onu Allah'ın kendisine öğrettiği gibi yazmaktan çekinmesin, yazsın. Borçlu olan da yazdırsın, Rabbi olan Allah'tan sakınsın, ondan bir şey eksiltmesin. Eğer borçlu, aptal veya aciz, ya da yazdıramıyacak durumda ise, velisi, doğru olarak yazdırsın. Erkeklerinizden iki şahid tutun; eğer iki erkek bulunmazsa, şahidlerden razı olacağınız bir erkek, biri unuttuğunda diğeri ona hatırlatacak iki kadın olabilir. Şahidler çağırıldıklarında çekinmesinler. Borç büyük veya küçük olsun, onu süresiyle beraber yazmaya üşenmeyin; bu, Allah katında en doğru, şahidlik için en sağlam ve şüphelenmenizden en uzak olandır. Ancak aranızdaki alışveriş peşin olursa, onu yazmamanızda size bir sorumluluk yoktur. Alışveriş yaptığınızda şahid tutun. Katibe de şahide de zarar verilmesin; eğer zarar verirseniz, o zaman doğru yoldan çıkmış olursunuz. Allah'tan sakının, Allah size öğretiyor; Allah her şeyi bilir.","numberInSurah":282,"juz":3,"manzil":1,"page":48,"ruku":40,"hizbQuarter":19,"sajda":false},{"number":290,"text":"Eğer yolculukta olup katip bulamazsanız alınan rehin yeter. Şayet birbirinize güvenirseniz, güvenilen kimse borcunu ödesin. Rabbi olan Allah'tan sakınsın. Şahidliği gizlemeyin, onu kim gizlerse şüphesiz kalbi günah işlemiş olur. Allah işlediklerinizi bilir.","numberInSurah":283,"juz":3,"manzil":1,"page":49,"ruku":40,"hizbQuarter":20,"sajda":false},{"number":291,"text":"Göklerde ve yerde olanlar Allah'ındır. İçinizdekini açıklasanız da gizleseniz de Allah sizi onunla hesaba çeker ve dilediğini bağışlar, dilediğine azabeder. Allah her şeye Kadir'dir.","numberInSurah":284,"juz":3,"manzil":1,"page":49,"ruku":41,"hizbQuarter":20,"sajda":false},{"number":292,"text":"Peygamber ve inananlar, ona Rabb'inden indirilene inandı. Hepsi Allah'a, meleklerine, kitaplarına, peygamberlerine inandı. \"Peygamberleri arasından hiçbirini ayırdetmeyiz, işittik, itaat ettik, Rabbimiz! Affını dileriz, dönüş Sanadır\" dediler.","numberInSurah":285,"juz":3,"manzil":1,"page":49,"ruku":41,"hizbQuarter":20,"sajda":false},{"number":293,"text":"Allah kişiye ancak gücünün yeteceği kadar yükler; kazandığı iyilik lehine, ettiği kötülük de aleyhinedir. Rabbimiz! Eğer unutacak veya yanılacak olursak bizi sorumlu tutma. Rabbimiz bizden öncekilere yüklediğin gibi, bize de ağır yük yükleme. Rabbimiz! Bize gücümüzün yetmeyeceği şeyi taşıtma, bizi affet, bizi bağışla, bize acı. Sen Mevlamızsın, kafirlere karşı bize yardım et.","numberInSurah":286,"juz":3,"manzil":1,"page":49,"ruku":41,"hizbQuarter":20,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}