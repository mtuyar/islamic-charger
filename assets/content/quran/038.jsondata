{"arabic":{"number":38,"name":"سُورَةُ صٓ","englishName":"Sâd","englishNameTranslation":"The letter Saad","revelationType":"Meccan","numberOfAyahs":88,"ayahs":[{"number":3971,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ ص ۚ وَالْقُرْآنِ ذِي الذِّكْرِ","numberInSurah":1,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3972,"text":"بَلِ الَّذِينَ كَفَرُوا فِي عِزَّةٍ وَشِقَاقٍ","numberInSurah":2,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3973,"text":"كَمْ أَهْلَكْنَا مِنْ قَبْلِهِمْ مِنْ قَرْنٍ فَنَادَوْا وَلَاتَ حِينَ مَنَاصٍ","numberInSurah":3,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3974,"text":"وَعَجِبُوا أَنْ جَاءَهُمْ مُنْذِرٌ مِنْهُمْ ۖ وَقَالَ الْكَافِرُونَ هَٰذَا سَاحِرٌ كَذَّابٌ","numberInSurah":4,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3975,"text":"أَجَعَلَ الْآلِهَةَ إِلَٰهًا وَاحِدًا ۖ إِنَّ هَٰذَا لَشَيْءٌ عُجَابٌ","numberInSurah":5,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3976,"text":"وَانْطَلَقَ الْمَلَأُ مِنْهُمْ أَنِ امْشُوا وَاصْبِرُوا عَلَىٰ آلِهَتِكُمْ ۖ إِنَّ هَٰذَا لَشَيْءٌ يُرَادُ","numberInSurah":6,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3977,"text":"مَا سَمِعْنَا بِهَٰذَا فِي الْمِلَّةِ الْآخِرَةِ إِنْ هَٰذَا إِلَّا اخْتِلَاقٌ","numberInSurah":7,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3978,"text":"أَأُنْزِلَ عَلَيْهِ الذِّكْرُ مِنْ بَيْنِنَا ۚ بَلْ هُمْ فِي شَكٍّ مِنْ ذِكْرِي ۖ بَلْ لَمَّا يَذُوقُوا عَذَابِ","numberInSurah":8,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3979,"text":"أَمْ عِنْدَهُمْ خَزَائِنُ رَحْمَةِ رَبِّكَ الْعَزِيزِ الْوَهَّابِ","numberInSurah":9,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3980,"text":"أَمْ لَهُمْ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَيْنَهُمَا ۖ فَلْيَرْتَقُوا فِي الْأَسْبَابِ","numberInSurah":10,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3981,"text":"جُنْدٌ مَا هُنَالِكَ مَهْزُومٌ مِنَ الْأَحْزَابِ","numberInSurah":11,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3982,"text":"كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَعَادٌ وَفِرْعَوْنُ ذُو الْأَوْتَادِ","numberInSurah":12,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3983,"text":"وَثَمُودُ وَقَوْمُ لُوطٍ وَأَصْحَابُ الْأَيْكَةِ ۚ أُولَٰئِكَ الْأَحْزَابُ","numberInSurah":13,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3984,"text":"إِنْ كُلٌّ إِلَّا كَذَّبَ الرُّسُلَ فَحَقَّ عِقَابِ","numberInSurah":14,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3985,"text":"وَمَا يَنْظُرُ هَٰؤُلَاءِ إِلَّا صَيْحَةً وَاحِدَةً مَا لَهَا مِنْ فَوَاقٍ","numberInSurah":15,"juz":23,"manzil":6,"page":453,"ruku":392,"hizbQuarter":181,"sajda":false},{"number":3986,"text":"وَقَالُوا رَبَّنَا عَجِّلْ لَنَا قِطَّنَا قَبْلَ يَوْمِ الْحِسَابِ","numberInSurah":16,"juz":23,"manzil":6,"page":453,"ruku":392,"hizbQuarter":181,"sajda":false},{"number":3987,"text":"اصْبِرْ عَلَىٰ مَا يَقُولُونَ وَاذْكُرْ عَبْدَنَا دَاوُودَ ذَا الْأَيْدِ ۖ إِنَّهُ أَوَّابٌ","numberInSurah":17,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":181,"sajda":false},{"number":3988,"text":"إِنَّا سَخَّرْنَا الْجِبَالَ مَعَهُ يُسَبِّحْنَ بِالْعَشِيِّ وَالْإِشْرَاقِ","numberInSurah":18,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":181,"sajda":false},{"number":3989,"text":"وَالطَّيْرَ مَحْشُورَةً ۖ كُلٌّ لَهُ أَوَّابٌ","numberInSurah":19,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":181,"sajda":false},{"number":3990,"text":"وَشَدَدْنَا مُلْكَهُ وَآتَيْنَاهُ الْحِكْمَةَ وَفَصْلَ الْخِطَابِ","numberInSurah":20,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":181,"sajda":false},{"number":3991,"text":"۞ وَهَلْ أَتَاكَ نَبَأُ الْخَصْمِ إِذْ تَسَوَّرُوا الْمِحْرَابَ","numberInSurah":21,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":182,"sajda":false},{"number":3992,"text":"إِذْ دَخَلُوا عَلَىٰ دَاوُودَ فَفَزِعَ مِنْهُمْ ۖ قَالُوا لَا تَخَفْ ۖ خَصْمَانِ بَغَىٰ بَعْضُنَا عَلَىٰ بَعْضٍ فَاحْكُمْ بَيْنَنَا بِالْحَقِّ وَلَا تُشْطِطْ وَاهْدِنَا إِلَىٰ سَوَاءِ الصِّرَاطِ","numberInSurah":22,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":182,"sajda":false},{"number":3993,"text":"إِنَّ هَٰذَا أَخِي لَهُ تِسْعٌ وَتِسْعُونَ نَعْجَةً وَلِيَ نَعْجَةٌ وَاحِدَةٌ فَقَالَ أَكْفِلْنِيهَا وَعَزَّنِي فِي الْخِطَابِ","numberInSurah":23,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":182,"sajda":false},{"number":3994,"text":"قَالَ لَقَدْ ظَلَمَكَ بِسُؤَالِ نَعْجَتِكَ إِلَىٰ نِعَاجِهِ ۖ وَإِنَّ كَثِيرًا مِنَ الْخُلَطَاءِ لَيَبْغِي بَعْضُهُمْ عَلَىٰ بَعْضٍ إِلَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَقَلِيلٌ مَا هُمْ ۗ وَظَنَّ دَاوُودُ أَنَّمَا فَتَنَّاهُ فَاسْتَغْفَرَ رَبَّهُ وَخَرَّ رَاكِعًا وَأَنَابَ ۩","numberInSurah":24,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":182,"sajda":{"id":11,"recommended":true,"obligatory":false}},{"number":3995,"text":"فَغَفَرْنَا لَهُ ذَٰلِكَ ۖ وَإِنَّ لَهُ عِنْدَنَا لَزُلْفَىٰ وَحُسْنَ مَآبٍ","numberInSurah":25,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":182,"sajda":false},{"number":3996,"text":"يَا دَاوُودُ إِنَّا جَعَلْنَاكَ خَلِيفَةً فِي الْأَرْضِ فَاحْكُمْ بَيْنَ النَّاسِ بِالْحَقِّ وَلَا تَتَّبِعِ الْهَوَىٰ فَيُضِلَّكَ عَنْ سَبِيلِ اللَّهِ ۚ إِنَّ الَّذِينَ يَضِلُّونَ عَنْ سَبِيلِ اللَّهِ لَهُمْ عَذَابٌ شَدِيدٌ بِمَا نَسُوا يَوْمَ الْحِسَابِ","numberInSurah":26,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":182,"sajda":false},{"number":3997,"text":"وَمَا خَلَقْنَا السَّمَاءَ وَالْأَرْضَ وَمَا بَيْنَهُمَا بَاطِلًا ۚ ذَٰلِكَ ظَنُّ الَّذِينَ كَفَرُوا ۚ فَوَيْلٌ لِلَّذِينَ كَفَرُوا مِنَ النَّارِ","numberInSurah":27,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":3998,"text":"أَمْ نَجْعَلُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ كَالْمُفْسِدِينَ فِي الْأَرْضِ أَمْ نَجْعَلُ الْمُتَّقِينَ كَالْفُجَّارِ","numberInSurah":28,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":3999,"text":"كِتَابٌ أَنْزَلْنَاهُ إِلَيْكَ مُبَارَكٌ لِيَدَّبَّرُوا آيَاتِهِ وَلِيَتَذَكَّرَ أُولُو الْأَلْبَابِ","numberInSurah":29,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4000,"text":"وَوَهَبْنَا لِدَاوُودَ سُلَيْمَانَ ۚ نِعْمَ الْعَبْدُ ۖ إِنَّهُ أَوَّابٌ","numberInSurah":30,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4001,"text":"إِذْ عُرِضَ عَلَيْهِ بِالْعَشِيِّ الصَّافِنَاتُ الْجِيَادُ","numberInSurah":31,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4002,"text":"فَقَالَ إِنِّي أَحْبَبْتُ حُبَّ الْخَيْرِ عَنْ ذِكْرِ رَبِّي حَتَّىٰ تَوَارَتْ بِالْحِجَابِ","numberInSurah":32,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4003,"text":"رُدُّوهَا عَلَيَّ ۖ فَطَفِقَ مَسْحًا بِالسُّوقِ وَالْأَعْنَاقِ","numberInSurah":33,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4004,"text":"وَلَقَدْ فَتَنَّا سُلَيْمَانَ وَأَلْقَيْنَا عَلَىٰ كُرْسِيِّهِ جَسَدًا ثُمَّ أَنَابَ","numberInSurah":34,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4005,"text":"قَالَ رَبِّ اغْفِرْ لِي وَهَبْ لِي مُلْكًا لَا يَنْبَغِي لِأَحَدٍ مِنْ بَعْدِي ۖ إِنَّكَ أَنْتَ الْوَهَّابُ","numberInSurah":35,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4006,"text":"فَسَخَّرْنَا لَهُ الرِّيحَ تَجْرِي بِأَمْرِهِ رُخَاءً حَيْثُ أَصَابَ","numberInSurah":36,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4007,"text":"وَالشَّيَاطِينَ كُلَّ بَنَّاءٍ وَغَوَّاصٍ","numberInSurah":37,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4008,"text":"وَآخَرِينَ مُقَرَّنِينَ فِي الْأَصْفَادِ","numberInSurah":38,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4009,"text":"هَٰذَا عَطَاؤُنَا فَامْنُنْ أَوْ أَمْسِكْ بِغَيْرِ حِسَابٍ","numberInSurah":39,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4010,"text":"وَإِنَّ لَهُ عِنْدَنَا لَزُلْفَىٰ وَحُسْنَ مَآبٍ","numberInSurah":40,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4011,"text":"وَاذْكُرْ عَبْدَنَا أَيُّوبَ إِذْ نَادَىٰ رَبَّهُ أَنِّي مَسَّنِيَ الشَّيْطَانُ بِنُصْبٍ وَعَذَابٍ","numberInSurah":41,"juz":23,"manzil":6,"page":455,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4012,"text":"ارْكُضْ بِرِجْلِكَ ۖ هَٰذَا مُغْتَسَلٌ بَارِدٌ وَشَرَابٌ","numberInSurah":42,"juz":23,"manzil":6,"page":455,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4013,"text":"وَوَهَبْنَا لَهُ أَهْلَهُ وَمِثْلَهُمْ مَعَهُمْ رَحْمَةً مِنَّا وَذِكْرَىٰ لِأُولِي الْأَلْبَابِ","numberInSurah":43,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4014,"text":"وَخُذْ بِيَدِكَ ضِغْثًا فَاضْرِبْ بِهِ وَلَا تَحْنَثْ ۗ إِنَّا وَجَدْنَاهُ صَابِرًا ۚ نِعْمَ الْعَبْدُ ۖ إِنَّهُ أَوَّابٌ","numberInSurah":44,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4015,"text":"وَاذْكُرْ عِبَادَنَا إِبْرَاهِيمَ وَإِسْحَاقَ وَيَعْقُوبَ أُولِي الْأَيْدِي وَالْأَبْصَارِ","numberInSurah":45,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4016,"text":"إِنَّا أَخْلَصْنَاهُمْ بِخَالِصَةٍ ذِكْرَى الدَّارِ","numberInSurah":46,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4017,"text":"وَإِنَّهُمْ عِنْدَنَا لَمِنَ الْمُصْطَفَيْنَ الْأَخْيَارِ","numberInSurah":47,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4018,"text":"وَاذْكُرْ إِسْمَاعِيلَ وَالْيَسَعَ وَذَا الْكِفْل