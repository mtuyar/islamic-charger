ext":"إِذْ قَالَ رَبُّكَ لِلْمَلَائِكَةِ إِنِّي خَالِقٌ بَشَرًا مِنْ طِينٍ","numberInSurah":71,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4042,"text":"فَإِذَا سَوَّيْتُهُ وَنَفَخْتُ فِيهِ مِنْ رُوحِي فَقَعُوا لَهُ سَاجِدِينَ","numberInSurah":72,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4043,"text":"فَسَجَدَ الْمَلَائِكَةُ كُلُّهُمْ أَجْمَعُونَ","numberInSurah":73,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4044,"text":"إِلَّا إِبْلِيسَ اسْتَكْبَرَ وَكَانَ مِنَ الْكَافِرِينَ","numberInSurah":74,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4045,"text":"قَالَ يَا إِبْلِيسُ مَا مَنَعَكَ أَنْ تَسْجُدَ لِمَا خَلَقْتُ بِيَدَيَّ ۖ أَسْتَكْبَرْتَ أَمْ كُنْتَ مِنَ الْعَالِينَ","numberInSurah":75,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4046,"text":"قَالَ أَنَا خَيْرٌ مِنْهُ ۖ خَلَقْتَنِي مِنْ نَارٍ وَخَلَقْتَهُ مِنْ طِينٍ","numberInSurah":76,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4047,"text":"قَالَ فَاخْرُجْ مِنْهَا فَإِنَّكَ رَجِيمٌ","numberInSurah":77,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4048,"text":"وَإِنَّ عَلَيْكَ لَعْنَتِي إِلَىٰ يَوْمِ الدِّينِ","numberInSurah":78,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4049,"text":"قَالَ رَبِّ فَأَنْظِرْنِي إِلَىٰ يَوْمِ يُبْعَثُونَ","numberInSurah":79,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4050,"text":"قَالَ فَإِنَّكَ مِنَ الْمُنْظَرِينَ","numberInSurah":80,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4051,"text":"إِلَىٰ يَوْمِ الْوَقْتِ الْمَعْلُومِ","numberInSurah":81,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4052,"text":"قَالَ فَبِعِزَّتِكَ لَأُغْوِيَنَّهُمْ أَجْمَعِينَ","numberInSurah":82,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4053,"text":"إِلَّا عِبَادَكَ مِنْهُمُ الْمُخْلَصِينَ","numberInSurah":83,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4054,"text":"قَالَ فَالْحَقُّ وَالْحَقَّ أَقُولُ","numberInSurah":84,"juz":23,"manzil":6,"page":458,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4055,"text":"لَأَمْلَأَنَّ جَهَنَّمَ مِنْكَ وَمِمَّنْ تَبِعَكَ مِنْهُمْ أَجْمَعِينَ","numberInSurah":85,"juz":23,"manzil":6,"page":458,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4056,"text":"قُلْ مَا أَسْأَلُكُمْ عَلَيْهِ مِنْ أَجْرٍ وَمَا أَنَا مِنَ الْمُتَكَلِّفِينَ","numberInSurah":86,"juz":23,"manzil":6,"page":458,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4057,"text":"إِنْ هُوَ إِلَّا ذِكْرٌ لِلْعَالَمِينَ","numberInSurah":87,"juz":23,"manzil":6,"page":458,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4058,"text":"وَلَتَعْلَمُنَّ نَبَأَهُ بَعْدَ حِينٍ","numberInSurah":88,"juz":23,"manzil":6,"page":458,"ruku":395,"hizbQuarter":183,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":38,"name":"سُورَةُ صٓ","englishName":"Sâd","englishNameTranslation":"The letter Saad","revelationType":"Meccan","numberOfAyahs":88,"ayahs":[{"number":3971,"text":"Sad. Öğüt veren Kuran'a and olsun ki, inkar edenler gurur ve ayrılık içindedirler.","numberInSurah":1,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3972,"text":"Sad. Öğüt veren Kuran'a and olsun ki, inkar edenler gurur ve ayrılık içindedirler.","numberInSurah":2,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3973,"text":"Onlardan önce nice nesilleri yok ettik. Feryat ediyorlardı; oysa artık kurtulma zamanı değildi.","numberInSurah":3,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3974,"text":"Aralarından bir uyarıcının gelmesine şaşmışlardı. İnkarcılar: \"Bu, pek yalancı bir sihirbazdır; tanrıları tek bir tanrı mı yaptı? Doğrusu bu tuhaf bir şeydir\" demişlerdi.","numberInSurah":4,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3975,"text":"Aralarından bir uyarıcının gelmesine şaşmışlardı. İnkarcılar: \"Bu, pek yalancı bir sihirbazdır; tanrıları tek bir tanrı mı yaptı? Doğrusu bu tuhaf bir şeydir\" demişlerdi.","numberInSurah":5,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3976,"text":"Onlardan ileri gelenler: \"Yürüyün, tanrılarınıza bağlılıkta direnin, sizden istenen şüphesiz budur. Başka dinde de bunu işitmedik; bu ancak bir uydurmadır. Kuran, aramızda ona mı indirilmeliydi?\" dediler. Hayır, bunlar Kuran'ımızdan şüphededirler. Hayır, azabımızı henüz tatmamışlardır.","numberInSurah":6,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3977,"text":"Onlardan ileri gelenler: \"Yürüyün, tanrılarınıza bağlılıkta direnin, sizden istenen şüphesiz budur. Başka dinde de bunu işitmedik; bu ancak bir uydurmadır. Kuran, aramızda ona mı indirilmeliydi?\" dediler. Hayır, bunlar Kuran'ımızdan şüphededirler. Hayır, azabımızı henüz tatmamışlardır.","numberInSurah":7,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3978,"text":"Onlardan ileri gelenler: \"Yürüyün, tanrılarınıza bağlılıkta direnin, sizden istenen şüphesiz budur. Başka dinde de bunu işitmedik; bu ancak bir uydurmadır. Kuran, aramızda ona mı indirilmeliydi?\" dediler. Hayır, bunlar Kuran'ımızdan şüphededirler. Hayır, azabımızı henüz tatmamışlardır.","numberInSurah":8,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3979,"text":"Yoksa, güçlü ve çok ihsan sahibi olan Rabbinin rahmet hazineleri onların yanında mıdır?","numberInSurah":9,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3980,"text":"Yahut, göklerin, yerin ve ikisi arasında bulunanların hükümranlığı onların elinde midir? Öyle ise sebeplere tevessül edip göğe yükselsinler!","numberInSurah":10,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3981,"text":"Onlar burada takım takım bozguna uğramış perişan bir ordudur.","numberInSurah":11,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3982,"text":"Onlardan önce Nuh milleti, Ad, sarsılmaz bir saltanatın sahibi Firavun, Semud, Lut milleti, Eykeliler de peygamberleri yalanlamıştı. İşte bunlar da peygamberlerine karşı birleşen topluluklardır.","numberInSurah":12,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3983,"text":"Onlardan önce Nuh milleti, Ad, sarsılmaz bir saltanatın sahibi Firavun, Semud, Lut milleti, Eykeliler de peygamberleri yalanlamıştı. İşte bunlar da peygamberlerine karşı birleşen topluluklardır.","numberInSurah":13,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3984,"text":"Hepsi peygamberleri yalanladı da azabımı hakettiler.","numberInSurah":14,"juz":23,"manzil":6,"page":453,"ruku":391,"hizbQuarter":181,"sajda":false},{"number":3985,"text":"Bunlar da ancak, bir an gecikmesi olmayan tek bir çığlık beklemektedirler.","numberInSurah":15,"juz":23,"manzil":6,"page":453,"ruku":392,"hizbQuarter":181,"sajda":false},{"number":3986,"text":"Onlar ise \"Rabbimiz! Bizim payımızı hesap gününden önce ver\" derler.","numberInSurah":16,"juz":23,"manzil":6,"page":453,"ruku":392,"hizbQuarter":181,"sajda":false},{"number":3987,"text":"Onların söylediklerine sabret; güçlü kulumuz Davud'u an; o, daima Allah'a yönelirdi.","numberInSurah":17,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":181,"sajda":false},{"number":3988,"text":"Doğrusu Biz, akşam sabah onunla beraber tesbih eden dağları, kuşları da toplu halde onun buyruğu altına vermiştik. Her biri ona yönelmekteydi.","numberInSurah":18,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":181,"sajda":false},{"number":3989,"text":"Doğrusu Biz, akşam sabah onunla beraber tesbih eden dağları, kuşları da toplu halde onun buyruğu altına vermiştik. Her biri ona yönelmekteydi.","numberInSurah":19,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":181,"sajda":false},{"number":3990,"text":"Onun hükümranlığını kuvvetlendirmiştik. Ona hikmet ve kesin hüküm selahiyeti vermiştik.","numberInSurah":20,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":181,"sajda":false},{"number":3991,"text":"Sana davacıların haberi ulaştı mı? Mabedin duvarına tırmanıp Davud'un yanına girmişlerdi de, o onlardan ürkmüştü. Şöyle demişlerdi: \"Korkma, birbirinin hakkına tecavüz etmiş iki davacıyız; aramızda adaletle hükmet, ondan ayrılma, bizi doğru yola çıkar.\"","numberInSurah":21,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":182,"sajda":false},{"number":3992,"text":"Sana davacıların haberi ulaştı mı? Mabedin duvarına tırmanıp Davud'un yanına girmişlerdi de, o onlardan ürkmüştü. Şöyle demişlerdi: \"Korkma, birbirinin hakkına tecavüz etmiş iki davacıyız; aramızda adaletle hükmet, ondan ayrılma, bizi doğru yola çıkar.\"","numberInSurah":22,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":182,"sajda":false},{"number":3993,"text":"\"Bu kardeşimin doksan dokuz dişi koyunu, benim de bir tek dişi koyunum vardır; O'nu da bana ver dedi ve tartışmada beni yendi.\"","numberInSurah":23,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":182,"sajda":false},{"number":3994,"text":"Davud: \"And olsun ki, senin dişi koyununu kendi dişi koyunlarına katmak istemekle sana haksızlıkta bulunmuştur. Doğrusu ortakçıların çoğu birbirlerinin haklarına tecavüz ederler. İnanıp yararlı iş işleyenler bunun dışındadır ki sayıları da ne kadar azdır!\" demişti. Davud, Kendisini denediğimizi sanmıştı da, Rabbinden mağfiret dileyerek eğilip secdeye kapanmış, tevbe etmiş, Allah'a yönelmişti.","numberInSurah":24,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":182,"sajda":{"id":11,"recommended":true,"obligatory":false}},{"number":3995,"text":"Böylece onu bağışlamıştık. Katımızda onun yakınlığı ve güzel bir geleceği vardır.","numberInSurah":25,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":182,"sajda":false},{"number":3996,"text":"Ey Davud! Seni şüphesiz yeryüzünde hükümran kıldık, o halde insanlar arasında adaletle hükmet, hevese uyma yoksa seni Allah'ın yolundan saptırır. Doğrusu, Allah'ın yolundan sapanlara, onlara, hesap gününü unutmalarına karşılık çetin azap vardır.","numberInSurah":26,"juz":23,"manzil":6,"page":454,"ruku":392,"hizbQuarter":182,"sajda":false},{"number":3997,"text":"Göğü, yeri ve ikisinin arasında bulunanları boşuna yaratmadık. Bunun boşuna olduğu, inkar edenlerin sanısıdır. Vay ateşe uğrayacak inkarcıların haline!","numberInSurah":27,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":3998,"text":"Yoksa, inanıp yararlı iş işleyenleri, yeryüzünde, bozguncular gibi mi tutarız? Yoksa, Allah'a karşı gelmekten sakınanları yoldan çıkanlar gibi mi tutarız?","numberInSurah":28,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":3999,"text":"Sana indirdiğimiz bu Kitap mübarektir; ayetlerini düşünsünler, aklı olanlar da öğüt alsınlar.","numberInSurah":29,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4000,"text":"Davud'a Süleyman'ı bahşettik; o ne güzel bir kuldu! Doğrusu o daima Allah'a yönelirdi.","numberInSurah":30,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4001,"text":"Ona bir akşam üstü, çalımlı, cins koşu atları sunulmuştu.","numberInSurah":31,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4002,"text":"Süleyman: \"Doğrusu ben bu iyi malları, Rabbimi anmayı sağladıkları için severim\" demişti. Koşup, toz perdesi arkasında kayboldukları zaman: \"onları bana getirin\" dedi. Bacaklarını ve boyunlarını sıvazlamaya başlamıştı.","numberInSurah":32,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4003,"text":"Süleyman: \"Doğrusu ben bu iyi malları, Rabbimi anmayı sağladıkları için severim\" demişti. Koşup, toz perdesi arkasında kayboldukları zaman: \"onları bana getirin\" dedi. Bacaklarını ve boyunlarını sıvazlamaya başlamıştı.","numberInSurah":33,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4004,"text":"And olsun ki Süleyman'ı denedik, hükümranlığını zayıf düşürdük; sonra eski haline döndü.","numberInSurah":34,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4005,"text":"Süleyman: \"Rabbim! Beni bağışla, bana benden sonra kimsenin ulaşamayacağı bir hükümranlık ver; Sen şüphesiz, daima bağışta bulunansın\" dedi.","numberInSurah":35,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4006,"text":"Bunun üzerine Biz de, istediği yere onun buyruğu ile kolayca giden rüzgarı, bina kuran ve dalgıçlık yapan şeytanları, demir halkalarla bağlı diğerlerini onun buyruğu altına verdik.","numberInSurah":36,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4007,"text":"Bunun üzerine Biz de, istediği yere onun buyruğu ile kolayca giden rüzgarı, bina kuran ve dalgıçlık yapan şeytanları, demir halkalarla bağlı diğerlerini onun buyruğu altına verdik.","numberInSurah":37,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4008,"text":"Bunun üzerine Biz de, istediği yere onun buyruğu ile kolayca giden rüzgarı, bina kuran ve dalgıçlık yapan şeytanları, demir halkalarla bağlı diğerlerini onun buyruğu altına verdik.","numberInSurah":38,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4009,"text":"\"İşte Bizim bağışımız budur; ister ver, ister tut, hesapsızdır.\" dedik.","numberInSurah":39,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4010,"text":"Doğrusu onun katımızda yakınlığı ve güzel bir istikbali vardır.","numberInSurah":40,"juz":23,"manzil":6,"page":455,"ruku":393,"hizbQuarter":182,"sajda":false},{"number":4011,"text":"Kulumuz Eyyub'u da an; Rabbine: \"Doğrusu şeytan bana yorgunluk ve azap verdi\" diye seslenmişti.","numberInSurah":41,"juz":23,"manzil":6,"page":455,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4012,"text":"\"Ayağını yere vur! İşte yıkanacak ve içilecek soğuk bir su\" dedik.","numberInSurah":42,"juz":23,"manzil":6,"page":455,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4013,"text":"Katımızdan bir rahmet ve akıl sahiplerine bir öğüt olmak üzere, ona tekrar ailesini ve geçmiş olanlarla bir mislini daha vermiştik.","numberInSurah":43,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4014,"text":"\"Ey Eyyub! Eline bir demet sap alıp onunla vur, yeminini bozma\" demiştik. Doğrusu Biz onu sabırlı bulmuştuk. Ne iyi kuldu, daima Allah'a yönelirdi.","numberInSurah":44,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4015,"text":"Güçlü ve anlayışlı olan kullarımız İbrahim, İshak ve Yakub'u da an.","numberInSurah":45,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4016,"text":"Biz onları ahiret yurdunu düşünen, içten bağlı kimseler kıldık.","numberInSurah":46,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4017,"text":"Doğrusu onlar katımızda seçkin, iyi kimselerdendirler.","numberInSurah":47,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4018,"text":"İsmail'i, Elyesa'ı, Zülkifl'i de an. Hepsi iyilerdendir.","numberInSurah":48,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4019,"text":"İşte bu güzel bir anmadır. Doğrusu Allah'a karşı gelmekten sakınanlara güzel bir gelecek vardır.","numberInSurah":49,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4020,"text":"Kapıları onlara açılmış Adn cennetleri vardır.","numberInSurah":50,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4021,"text":"Orada tahtlara yaslanmış olarak türlü meyveler ve içecekler isterler.","numberInSurah":51,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":182,"sajda":false},{"number":4022,"text":"Yanlarında, gözlerini eşlerine dikmiş yaşıt güzeller vardır.","numberInSurah":52,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":183,"sajda":false},{"number":4023,"text":"İşte bu hesap günü için, size söz verilenlerdir.","numberInSurah":53,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":183,"sajda":false},{"number":4024,"text":"Doğrusu, verdiğimiz bu rızıklar tükenecek değildir.","numberInSurah":54,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":183,"sajda":false},{"number":4025,"text":"Bu böyle; ama azgınlara kötü bir gelecek vardır.","numberInSurah":55,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":183,"sajda":false},{"number":4026,"text":"Cehenneme girerler; ne kötü bir konaktır!","numberInSurah":56,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":183,"sajda":false},{"number":4027,"text":"İşte bu kaynar su ve irindir, artık onu tatsınlar.","numberInSurah":57,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":183,"sajda":false},{"number":4028,"text":"Bunlara benzer daha başkaları da vardır...","numberInSurah":58,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":183,"sajda":false},{"number":4029,"text":"(İnkarcıların ileri gelenlerine denir ki;) \"İşte şunlar sizinle beraber girecek olanlardır.\" (Derler ki;) \"Onlar rahat yüzü görmesin. Behemehal ateşe gireceklerdir\"","numberInSurah":59,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":183,"sajda":false},{"number":4030,"text":"(Onlara uyanlar;) \"Hayır, asıl siz rahat yüzü görmeyin; bunu başımıza getiren sizsiniz; ne kötü bir duraktır!\" derler.","numberInSurah":60,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":183,"sajda":false},{"number":4031,"text":"\"Rabbimiz! Bunu kim başımıza getirdiyse, ateşte onun azabını kat kat artır\" derler.","numberInSurah":61,"juz":23,"manzil":6,"page":456,"ruku":394,"hizbQuarter":183,"sajda":false},{"number":4032,"text":"Şöyle derler: \"Kendilerini dünyada iken kötü saydığımız kimseleri burada niçin görmüyoruz?\"","numberInSurah":62,"juz":23,"manzil":6,"page":457,"ruku":394,"hizbQuarter":183,"sajda":false},{"number":4033,"text":"\"Onları alaya alırdık; yoksa şimdi gözlere görünmezler mi?\"","numberInSurah":63,"juz":23,"manzil":6,"page":457,"ruku":394,"hizbQuarter":183,"sajda":false},{"number":4034,"text":"İşte cehennemliklerin bu şekilde tartışması gerçektir.","numberInSurah":64,"juz":23,"manzil":6,"page":457,"ruku":394,"hizbQuarter":183,"sajda":false},{"number":4035,"text":"De ki: \"Ben sadece bir uyarıcıyım. Gücü her şeye yeten tek Allah'tan başka tanrı yoktur.\"","numberInSurah":65,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4036,"text":"\"Göklerin, yerin ve ikisi arasında bulunanların Rabbi, güçlüdür, çok bağışlayandır.\"","numberInSurah":66,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4037,"text":"De ki: \"Bu Kuran büyük bir haberdir, ama siz ondan yüz çeviriyorsunuz.\"","numberInSurah":67,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4038,"text":"De ki: \"Bu Kuran büyük bir haberdir, ama siz ondan yüz çeviriyorsunuz.\"","numberInSurah":68,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4039,"text":"\"Onlar tartışırlarken Melei Ala'daki bu olanlar hakkında bir bilgim yoktu.\"","numberInSurah":69,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4040,"text":"\"Bana sadece vahyolunuyor; doğrusu ben ancak apaçık bir uyarıcıyım.\"","numberInSurah":70,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4041,"text":"Rabbin meleklere şöyle demişti: \"Ben çamurdan bir insan yaratacağım. Onu yapıp ruhumdan ona üflediğim zaman ona secdeye kapanın.\"","numberInSurah":71,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4042,"text":"Rabbin meleklere şöyle demişti: \"Ben çamurdan bir insan yaratacağım. Onu yapıp ruhumdan ona üflediğim zaman ona secdeye kapanın.\"","numberInSurah":72,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4043,"text":"Bütün melekler secde etmişlerdi, fakat İblis; o, büyüklük taslamış ve inkarcılardan olmuştu.","numberInSurah":73,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4044,"text":"Bütün melekler secde etmişlerdi, fakat İblis; o, büyüklük taslamış ve inkarcılardan olmuştu.","numberInSurah":74,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4045,"text":"Allah: \"Ey İblis, ellerimle (kudretimle) yarattığıma secde etmekten seni alıkoyan nedir? Böbürlendin mi? Yoksa gururlananlardan mısın?\" dedi.","numberInSurah":75,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4046,"text":"İblis: \"Ben ondan daha üstünüm. Beni ateşten yarattın, onu çamurdan yarattın\" dedi.","numberInSurah":76,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4047,"text":"Allah: \"Defol oradan, sen artık kovulmuş birisin. Din (kıyamet/ceza) gününe kadar lanetim senin üzerinedir\" dedi.","numberInSurah":77,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4048,"text":"Allah: \"Defol oradan, sen artık kovulmuş birisin. Din (kıyamet/ceza) gününe kadar lanetim senin üzerinedir\" dedi.","numberInSurah":78,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4049,"text":"\"Rabbim! Dirilecekleri güne kadar beni (canımı almayı) ertele\" dedi.","numberInSurah":79,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4050,"text":"Allah: \"Sen bilinen güne kadar erteye bırakılanlardansın\" dedi.","numberInSurah":80,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4051,"text":"Allah: \"Sen bilinen güne kadar erteye bırakılanlardansın\" dedi.","numberInSurah":81,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4052,"text":"İblis: \"Senin kudretine and olsun ki, onlardan, sana içten bağlı olan kulların bir yana, hepsini azdıracağım\" dedi.","numberInSurah":82,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4053,"text":"İblis: \"Senin kudretine and olsun ki, onlardan, sana içten bağlı olan kulların bir yana, hepsini azdıracağım\" dedi.","numberInSurah":83,"juz":23,"manzil":6,"page":457,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4054,"text":"Allah: \"Doğrudur; işte Ben hakikati söylüyorum, sen ve sana uyanların hepsiyle cehennemi dolduracağım\" dedi.","numberInSurah":84,"juz":23,"manzil":6,"page":458,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4055,"text":"Allah: \"Doğrudur; işte Ben hakikati söylüyorum, sen ve sana uyanların hepsiyle cehennemi dolduracağım\" dedi.","numberInSurah":85,"juz":23,"manzil":6,"page":458,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4056,"text":"De ki: \"Buna karşılık sizden bir ücret istemiyorum. Kendiliğimden bir şey iddia eden kimselerden de değilim.\"","numberInSurah":86,"juz":23,"manzil":6,"page":458,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4057,"text":"\"Bu Kuran, ancak dünyalar için bir öğüttür.\"","numberInSurah":87,"juz":23,"manzil":6,"page":458,"ruku":395,"hizbQuarter":183,"sajda":false},{"number":4058,"text":"\"Onun verdiği haberin doğruluğunu bir zaman sonra öğreneceksiniz.\"","numberInSurah":88,"juz":23,"manzil":6,"page":458,"ruku":395,"hizbQuarter":183,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}