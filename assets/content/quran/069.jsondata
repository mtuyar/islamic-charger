{"arabic":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Hâkka","englishNameTranslation":"The Reality","revelationType":"Meccan","numberOfAyahs":52,"ayahs":[{"number":5324,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الْحَاقَّةُ","numberInSurah":1,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5325,"text":"مَا الْحَاقَّةُ","numberInSurah":2,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5326,"text":"وَمَا أَدْرَاكَ مَا الْحَاقَّةُ","numberInSurah":3,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5327,"text":"كَذَّبَتْ ثَمُودُ وَعَادٌ بِالْقَارِعَةِ","numberInSurah":4,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5328,"text":"فَأَمَّا ثَمُودُ فَأُهْلِكُوا بِالطَّاغِيَةِ","numberInSurah":5,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5329,"text":"وَأَمَّا عَادٌ فَأُهْلِكُوا بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ","numberInSurah":6,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5330,"text":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَانِيَةَ أَيَّامٍ حُسُومًا فَتَرَى الْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ","numberInSurah":7,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5331,"text":"فَهَلْ تَرَىٰ لَهُمْ مِنْ بَاقِيَةٍ","numberInSurah":8,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5332,"text":"وَجَاءَ فِرْعَوْنُ وَمَنْ قَبْلَهُ وَالْمُؤْتَفِكَاتُ بِالْخَاطِئَةِ","numberInSurah":9,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5333,"text":"فَعَصَوْا رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَابِيَةً","numberInSurah":10,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5334,"text":"إِنَّا لَمَّا طَغَى الْمَاءُ حَمَلْنَاكُمْ فِي الْجَارِيَةِ","numberInSurah":11,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5335,"text":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَا أُذُنٌ وَاعِيَةٌ","numberInSurah":12,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5336,"text":"فَإِذَا نُفِخَ فِي الصُّورِ نَفْخَةٌ وَاحِدَةٌ","numberInSurah":13,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5337,"text":"وَحُمِلَتِ الْأَرْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةً وَاحِدَةً","numberInSurah":14,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5338,"text":"فَيَوْمَئِذٍ وَقَعَتِ الْوَاقِعَةُ","numberInSurah":15,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5339,"text":"وَانْشَقَّتِ السَّمَاءُ فَهِيَ يَوْمَئِذٍ وَاهِيَةٌ","numberInSurah":16,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5340,"text":"وَالْمَلَكُ عَلَىٰ أَرْجَائِهَا ۚ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَانِيَةٌ","numberInSurah":17,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5341,"text":"يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَىٰ مِنْكُمْ خَافِيَةٌ","numberInSurah":18,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5342,"text":"فَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِيَمِينِهِ فَيَقُولُ هَاؤُمُ اقْرَءُوا كِتَابِيَهْ","numberInSurah":19,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5343,"text":"إِنِّي ظَنَنْتُ أَنِّي مُلَاقٍ حِسَابِيَهْ","numberInSurah":20,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5344,"text":"فَهُوَ فِي عِيشَةٍ رَاضِيَةٍ","numberInSurah":21,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5345,"text":"فِي جَنَّةٍ عَالِيَةٍ","numberInSurah":22,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5346,"text":"قُطُوفُهَا دَانِيَةٌ","numberInSurah":23,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5347,"text":"كُلُوا وَاشْرَبُوا هَنِيئًا بِمَا أَسْلَفْتُمْ فِي الْأَيَّامِ الْخَالِيَةِ","numberInSurah":24,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5348,"text":"وَأَمَّا مَنْ أُوتِيَ كِتَابَهُ بِشِمَالِهِ فَيَقُولُ يَا لَيْتَنِي لَمْ أُوتَ كِتَابِيَهْ","numberInSurah":25,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5349,"text":"وَلَمْ أَدْرِ مَا حِسَابِيَهْ","numberInSurah":26,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5350,"text":"يَا لَيْتَهَا كَانَتِ الْقَاضِيَةَ","numberInSurah":27,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5351,"text":"مَا أَغْنَىٰ عَنِّي مَالِيَهْ ۜ","numberInSurah":28,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5352,"text":"هَلَكَ عَنِّي سُلْطَانِيَهْ","numberInSurah":29,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5353,"text":"خُذُوهُ فَغُلُّوهُ","numberInSurah":30,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5354,"text":"ثُمَّ الْجَحِيمَ صَلُّوهُ","numberInSurah":31,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5355,"text":"ثُمَّ فِي سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَاسْلُكُوهُ","numberInSurah":32,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5356,"text":"إِنَّهُ كَانَ لَا يُؤْمِنُ بِاللَّهِ الْعَظِيمِ","numberInSurah":33,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5357,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ الْمِسْكِينِ","numberInSurah":34,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5358,"text":"فَلَيْسَ لَهُ الْيَوْمَ هَاهُنَا حَمِيمٌ","numberInSurah":35,"juz":29,"manzil":7,"page":568,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5359,"text":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ","numberInSurah":36,"juz":29,"manzil":7,"page":568,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5360,"text":"لَا يَأْكُلُهُ إِلَّا الْخَاطِئُونَ","numberInSurah":37,"juz":29,"manzil":7,"page":568,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5361,"text":"فَلَا أُقْسِمُ بِمَا تُبْصِرُونَ","numberInSurah":38,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5362,"text":"وَمَا لَا تُبْصِرُونَ","numberInSurah":39,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5363,"text":"إِنَّهُ لَقَوْلُ رَسُولٍ كَرِيمٍ","numberInSurah":40,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5364,"text":"وَمَا هُوَ بِقَوْلِ شَاعِرٍ ۚ قَلِيلًا مَا تُؤْمِنُونَ","numberInSurah":41,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5365,"text":"وَلَا بِقَوْلِ كَاهِنٍ ۚ قَلِيلًا مَا تَذَكَّرُونَ","numberInSurah":42,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5366,"text":"تَنْزِيلٌ مِنْ رَبِّ الْعَالَمِينَ","numberInSurah":43,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5367,"text":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ الْأَقَاوِيلِ","numberInSurah":44,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5368,"text":"لَأَخَذْنَا مِنْهُ بِالْيَمِينِ","numberInSurah":45,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5369,"text":"ثُمَّ لَقَطَعْنَا مِنْهُ الْوَتِينَ","numberInSurah":46,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5370,"text":"فَمَا مِنْكُمْ مِنْ أَحَدٍ عَنْهُ حَاجِزِينَ","numberInSurah":47,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5371,"text":"وَإِنَّهُ لَتَذْكِرَةٌ لِلْمُتَّقِينَ","numberInSurah":48,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5372,"text":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنْكُمْ مُكَذِّبِينَ","numberInSurah":49,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5373,"text":"وَإِنَّهُ لَحَسْرَةٌ عَلَى الْكَافِرِينَ","numberInSurah":50,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5374,"text":"وَإِنَّهُ لَحَقُّ الْيَقِينِ","numberInSurah":51,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5375,"text":"فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيمِ","numberInSurah":52,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":69,"name":"سُورَةُ الحَاقَّةِ","englishName":"Hâkka","englishNameTranslation":"The Reality","revelationType":"Meccan","numberOfAyahs":52,"ayahs":[{"number":5324,"text":"Gerçekleşecek olan!","numberInSurah":1,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5325,"text":"Nedir o gerçekleşecek olan gün?","numberInSurah":2,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5326,"text":"Gerçekleşecek olanın ne olduğunu sana ne bildirir?","numberInSurah":3,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5327,"text":"Semud ve Ad milletleri tepelerine inecek bu gerçeği yalanladılar.","numberInSurah":4,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5328,"text":"Bu yüzden Semud milleti zorlu bir sarsıntı ile yok edildi.","numberInSurah":5,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5329,"text":"Ad milleti de bu yüzden önünde durulmaz, dondurucu bir rüzgarla yok edildi.","numberInSurah":6,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5330,"text":"Allah onların kökünü kesmek üzere, üzerlerine o rüzgarı yedi gece sekiz gün, estirdi. Halkın, kökünden çıkarılmış hurma kütükleri gibi yere yıkıldıklarını görürsün.","numberInSurah":7,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5331,"text":"Onlardan arda kalmış bir şey görür müsün?","numberInSurah":8,"juz":29,"manzil":7,"page":566,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5332,"text":"Firavun, ondan öncekiler ve alt üst olmuş kasabalarda oturanlar da suç işlemişlerdi.","numberInSurah":9,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5333,"text":"Rabbinin peygamberine baş kaldırmışlardı. Bunun üzerine Rableri onları şiddeti arttıkça artan bir şekilde yakaladı.","numberInSurah":10,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5334,"text":"Su taştığı vakit, size bir ibret olmak üzere, anlayışlı kulaklar anlasın diye süzülen gemide, sizi Biz taşımışızdır.","numberInSurah":11,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5335,"text":"Su taştığı vakit, size bir ibret olmak üzere, anlayışlı kulaklar anlasın diye süzülen gemide, sizi Biz taşımışızdır.","numberInSurah":12,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5336,"text":"Sura bir üfürüş üfürüldüğü, yer ve dağlar kaldırılıp bir vuruşla birbirine çarpıldığı zaman, işte o gün olacak olur, kıyamet kopar.","numberInSurah":13,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5337,"text":"Sura bir üfürüş üfürüldüğü, yer ve dağlar kaldırılıp bir vuruşla birbirine çarpıldığı zaman, işte o gün olacak olur, kıyamet kopar.","numberInSurah":14,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5338,"text":"Sura bir üfürüş üfürüldüğü, yer ve dağlar kaldırılıp bir vuruşla birbirine çarpıldığı zaman, işte o gün olacak olur, kıyamet kopar.","numberInSurah":15,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5339,"text":"Gök yarılır; o gün düzeni bozulur.","numberInSurah":16,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5340,"text":"Melekler onun çevresindedirler; o gün Rabbinin arşını onlardan başka sekiz tanesi yüklenir.","numberInSurah":17,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5341,"text":"O gün siz huzura alınırsınız, hiçbir şeyiniz gizli kalmaz.","numberInSurah":18,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5342,"text":"Kitabı sağından verilen; \"Alın, kitabımı okuyun, doğrusu bir hesaplaşma ile karşılaşacağımı umuyordum\" der.","numberInSurah":19,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5343,"text":"Kitabı sağından verilen; \"Alın, kitabımı okuyun, doğrusu bir hesaplaşma ile karşılaşacağımı umuyordum\" der.","numberInSurah":20,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5344,"text":"Artık o, meyveleri sarkmış, yüksek bir bahçede, hoş bir yaşayış içindedir.","numberInSurah":21,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5345,"text":"Artık o, meyveleri sarkmış, yüksek bir bahçede, hoş bir yaşayış içindedir.","numberInSurah":22,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5346,"text":"Artık o, meyveleri sarkmış, yüksek bir bahçede, hoş bir yaşayış içindedir.","numberInSurah":23,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5347,"text":"Onlara şöyle denir: \"Geçmiş günlerde, peşinen işlediklerinize karşılık afiyetle yiyiniz içiniz.\"","numberInSurah":24,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5348,"text":"Fakat kitabı kendisine solundan verilen kimse: \"Kitabım keşke bana verilmeseydi; keşke hesabımın ne olduğunu bilmeseydim; bu iş keşke son bulmuş olsaydı; malım bana fayda vermedi; gücüm de kalmadı\" der.","numberInSurah":25,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5349,"text":"Fakat kitabı kendisine solundan verilen kimse: \"Kitabım keşke bana verilmeseydi; keşke hesabımın ne olduğunu bilmeseydim; bu iş keşke son bulmuş olsaydı; malım bana fayda vermedi; gücüm de kalmadı\" der.","numberInSurah":26,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5350,"text":"Fakat kitabı kendisine solundan verilen kimse: \"Kitabım keşke bana verilmeseydi; keşke hesabımın ne olduğunu bilmeseydim; bu iş keşke son bulmuş olsaydı; malım bana fayda vermedi; gücüm de kalmadı\" der.","numberInSurah":27,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5351,"text":"Fakat kitabı kendisine solundan verilen kimse: \"Kitabım keşke bana verilmeseydi; keşke hesabımın ne olduğunu bilmeseydim; bu iş keşke son bulmuş olsaydı; malım bana fayda vermedi; gücüm de kalmadı\" der.","numberInSurah":28,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5352,"text":"Fakat kitabı kendisine solundan verilen kimse: \"Kitabım keşke bana verilmeseydi; keşke hesabımın ne olduğunu bilmeseydim; bu iş keşke son bulmuş olsaydı; malım bana fayda vermedi; gücüm de kalmadı\" der.","numberInSurah":29,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5353,"text":"İlgililere şöyle buyurulur: \"O'nu alın, bağlayın.\"","numberInSurah":30,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5354,"text":"\"Sonra cehenneme yaslayın\"","numberInSurah":31,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5355,"text":"\"Sonra onu boyu yetmiş arşın olan zincire vurun\";","numberInSurah":32,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5356,"text":"\"Çünkü, o, yüce Allah'a inanmazdı.\"","numberInSurah":33,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5357,"text":"\"Yoksulun yiyeceği ile ilgilenmezdi.\"","numberInSurah":34,"juz":29,"manzil":7,"page":567,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5358,"text":"\"Bu sebeple burada bugün onun bir acıyanı yoktur.\"","numberInSurah":35,"juz":29,"manzil":7,"page":568,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5359,"text":"\"Günahkarların yiyeceği olan kanlı irinden başka bir yiyeceği de yoktur.\"","numberInSurah":36,"juz":29,"manzil":7,"page":568,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5360,"text":"\"Günahkarların yiyeceği olan kanlı irinden başka bir yiyeceği de yoktur.\"","numberInSurah":37,"juz":29,"manzil":7,"page":568,"ruku":500,"hizbQuarter":227,"sajda":false},{"number":5361,"text":"Görebildikleriniz ve göremedikleriniz üzerine yemin ederim ki, Kuran şerefli bir elçinin getirdiği sözdür.","numberInSurah":38,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5362,"text":"Görebildikleriniz ve göremedikleriniz üzerine yemin ederim ki, Kuran şerefli bir elçinin getirdiği sözdür.","numberInSurah":39,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5363,"text":"Görebildikleriniz ve göremedikleriniz üzerine yemin ederim ki, Kuran şerefli bir elçinin getirdiği sözdür.","numberInSurah":40,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5364,"text":"O, şair sözü değildir; ne az inanıyorsunuz!","numberInSurah":41,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5365,"text":"Kahin sözü de değildir; ne az düşünüyorsunuz!","numberInSurah":42,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5366,"text":"Kuran, Alemlerin Rabbinden indirilmedir.","numberInSurah":43,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5367,"text":"Eğer o (Muhammed), Bize karşı, ona bazı sözler katmış olsaydı, Biz onu kuvvetle yakalardık, sonra onun şah damarını koparırdık.","numberInSurah":44,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5368,"text":"Eğer o (Muhammed), Bize karşı, ona bazı sözler katmış olsaydı, Biz onu kuvvetle yakalardık, sonra onun şah damarını koparırdık.","numberInSurah":45,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5369,"text":"Eğer o (Muhammed), Bize karşı, ona bazı sözler katmış olsaydı, Biz onu kuvvetle yakalardık, sonra onun şah damarını koparırdık.","numberInSurah":46,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5370,"text":"Hiçbiriniz de onu koruyamazdınız.","numberInSurah":47,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5371,"text":"Doğrusu Kuran Allah'a karşı gelmekten sakınanlara bir öğüttür.","numberInSurah":48,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5372,"text":"İçinizde yalanlayanlar bulunduğunu şüphesiz bilmekteyiz.","numberInSurah":49,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5373,"text":"Doğrusu Kuran, inkarcılar için bir üzüntüdür.","numberInSurah":50,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5374,"text":"O, şüphesiz kesin gerçektir.","numberInSurah":51,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false},{"number":5375,"text":"Öyleyse çok büyük olan Rabbinin adını tesbih et.","numberInSurah":52,"juz":29,"manzil":7,"page":568,"ruku":501,"hizbQuarter":227,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}