{"arabic":{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"İhlâs","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6222,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ قُلْ هُوَ اللَّهُ أَحَدٌ","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6223,"text":"اللَّهُ الصَّمَدُ","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6224,"text":"لَمْ يَلِدْ وَلَمْ يُولَدْ","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6225,"text":"وَلَمْ يَكُنْ لَهُ كُفُوًا أَحَدٌ","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":112,"name":"سُورَةُ الإِخۡلَاصِ","englishName":"İhlâs","englishNameTranslation":"Sincerity","revelationType":"Meccan","numberOfAyahs":4,"ayahs":[{"number":6222,"text":"De ki: O Allah bir tektir.","numberInSurah":1,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6223,"text":"Allah her şeyden müstağni ve her şey O'na muhtaçtır.","numberInSurah":2,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6224,"text":"O doğurmamış ve doğmamıştır.","numberInSurah":3,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false},{"number":6225,"text":"Hiçbir şey O'na denk değildir.","numberInSurah":4,"juz":30,"manzil":7,"page":604,"ruku":554,"hizbQuarter":240,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}