{"arabic":{"number":57,"name":"سُورَةُ الحَدِيدِ","englishName":"Hadîd","englishNameTranslation":"The Iron","revelationType":"Medinan","numberOfAyahs":29,"ayahs":[{"number":5076,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ سَبَّحَ لِلَّهِ مَا فِي السَّمَاوَاتِ وَالْأَرْضِ ۖ وَهُوَ الْعَزِيزُ الْحَكِيمُ","numberInSurah":1,"juz":27,"manzil":7,"page":537,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5077,"text":"لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ۖ يُحْيِي وَيُمِيتُ ۖ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":2,"juz":27,"manzil":7,"page":537,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5078,"text":"هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ ۖ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ","numberInSurah":3,"juz":27,"manzil":7,"page":537,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5079,"text":"هُوَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَىٰ عَلَى الْعَرْشِ ۚ يَعْلَمُ مَا يَلِجُ فِي الْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنْزِلُ مِنَ السَّمَاءِ وَمَا يَعْرُجُ فِيهَا ۖ وَهُوَ مَعَكُمْ أَيْنَ مَا كُنْتُمْ ۚ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","numberInSurah":4,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5080,"text":"لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ۚ وَإِلَى اللَّهِ تُرْجَعُ الْأُمُورُ","numberInSurah":5,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5081,"text":"يُولِجُ اللَّيْلَ فِي النَّهَارِ وَيُولِجُ النَّهَارَ فِي اللَّيْلِ ۚ وَهُوَ عَلِيمٌ بِذَاتِ الصُّدُورِ","numberInSurah":6,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5082,"text":"آمِنُوا بِاللَّهِ وَرَسُولِهِ وَأَنْفِقُوا مِمَّا جَعَلَكُمْ مُسْتَخْلَفِينَ فِيهِ ۖ فَالَّذِينَ آمَنُوا مِنْكُمْ وَأَنْفَقُوا لَهُمْ أَجْرٌ كَبِيرٌ","numberInSurah":7,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5083,"text":"وَمَا لَكُمْ لَا تُؤْمِنُونَ بِاللَّهِ ۙ وَالرَّسُولُ يَدْعُوكُمْ لِتُؤْمِنُوا بِرَبِّكُمْ وَقَدْ أَخَذَ مِيثَاقَكُمْ إِنْ كُنْتُمْ مُؤْمِنِينَ","numberInSurah":8,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5084,"text":"هُوَ الَّذِي يُنَزِّلُ عَلَىٰ عَبْدِهِ آيَاتٍ بَيِّنَاتٍ لِيُخْرِجَكُمْ مِنَ الظُّلُمَاتِ إِلَى النُّورِ ۚ وَإِنَّ اللَّهَ بِكُمْ لَرَءُوفٌ رَحِيمٌ","numberInSurah":9,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5085,"text":"وَمَا لَكُمْ أَلَّا تُنْفِقُوا فِي سَبِيلِ اللَّهِ وَلِلَّهِ مِيرَاثُ السَّمَاوَاتِ وَالْأَرْضِ ۚ لَا يَسْتَوِي مِنْكُمْ مَنْ أَنْفَقَ مِنْ قَبْلِ الْفَتْحِ وَقَاتَلَ ۚ أُولَٰئِكَ أَعْظَمُ دَرَجَةً مِنَ الَّذِينَ أَنْفَقُوا مِنْ بَعْدُ وَقَاتَلُوا ۚ وَكُلًّا وَعَدَ اللَّهُ الْحُسْنَىٰ ۚ وَاللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ","numberInSurah":10,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5086,"text":"مَنْ ذَا الَّذِي يُقْرِضُ اللَّهَ قَرْضًا حَسَنًا فَيُضَاعِفَهُ لَهُ وَلَهُ أَجْرٌ كَرِيمٌ","numberInSurah":11,"juz":27,"manzil":7,"page":538,"ruku":473,"hizbQuarter":215,"sajda":false},{"number":5087,"text":"يَوْمَ تَرَى الْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ يَسْعَىٰ نُورُهُمْ بَيْنَ أَيْدِيهِمْ وَبِأَيْمَانِهِمْ بُشْرَاكُمُ الْيَوْمَ جَنَّاتٌ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ خَالِدِينَ فِيهَا ۚ ذَٰلِكَ هُوَ الْفَوْزُ الْعَظِيمُ","numberInSurah":12,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":215,"sajda":false},{"number":5088,"text":"يَوْمَ يَقُولُ الْمُنَافِقُونَ وَالْمُنَافِقَاتُ لِلَّذِينَ آمَنُوا انْظُرُونَا نَقْتَبِسْ مِنْ نُورِكُمْ قِيلَ ارْجِعُوا وَرَاءَكُمْ فَالْتَمِسُوا نُورًا فَضُرِبَ بَيْنَهُمْ بِسُورٍ لَهُ بَابٌ بَاطِنُهُ فِيهِ الرَّحْمَةُ وَظَاهِرُهُ مِنْ قِبَلِهِ الْعَذَابُ","numberInSurah":13,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":215,"sajda":false},{"number":5089,"text":"يُنَادُونَهُمْ أَلَمْ نَكُنْ مَعَكُمْ ۖ قَالُوا بَلَىٰ وَلَٰكِنَّكُمْ فَتَنْتُمْ أَنْفُسَكُمْ وَتَرَبَّصْتُمْ وَارْتَبْتُمْ وَغَرَّتْكُمُ الْأَمَانِيُّ حَتَّىٰ جَاءَ أَمْرُ اللَّهِ وَغَرَّكُمْ بِاللَّهِ الْغَرُورُ","numberInSurah":14,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":215,"sajda":false},{"number":5090,"text":"فَالْيَوْمَ لَا يُؤْخَذُ مِنْكُمْ فِدْيَةٌ وَلَا مِنَ الَّذِينَ كَفَرُوا ۚ مَأْوَاكُمُ النَّارُ ۖ هِيَ مَوْلَاكُمْ ۖ وَبِئْسَ الْمَصِيرُ","numberInSurah":15,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":215,"sajda":false},{"number":5091,"text":"۞ أَلَمْ يَأْنِ لِلَّذِينَ آمَنُوا أَنْ تَخْشَعَ قُلُوبُهُمْ لِذِكْرِ اللَّهِ وَمَا نَزَلَ مِنَ الْحَقِّ وَلَا يَكُونُوا كَالَّذِينَ أُوتُوا الْكِتَابَ مِنْ قَبْلُ فَطَالَ عَلَيْهِمُ الْأَمَدُ فَقَسَتْ قُلُوبُهُمْ ۖ وَكَثِيرٌ مِنْهُمْ فَاسِقُونَ","numberInSurah":16,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":216,"sajda":false},{"number":5092,"text":"اعْلَمُوا أَنَّ اللَّهَ يُحْيِي الْأَرْضَ بَعْدَ مَوْتِهَا ۚ قَدْ بَيَّنَّا لَكُمُ الْآيَاتِ لَعَلَّكُمْ تَعْقِلُونَ","numberInSurah":17,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":216,"sajda":false},{"number":5093,"text":"إِنَّ الْمُصَّدِّقِينَ وَالْمُصَّدِّقَاتِ وَأَقْرَضُوا اللَّهَ قَرْضًا حَسَنًا يُضَاعَفُ لَهُمْ وَلَهُمْ أَجْرٌ كَرِيمٌ","numberInSurah":18,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":216,"sajda":false},{"number":5094,"text":"وَالَّذِينَ آمَنُوا بِاللَّهِ وَرُسُلِهِ أُولَٰئِكَ هُمُ الصِّدِّيقُونَ ۖ وَالشُّهَدَاءُ عِنْدَ رَبِّهِمْ لَهُمْ أَجْرُهُمْ وَنُورُهُمْ ۖ وَالَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا أُولَٰئِكَ أَصْحَابُ الْجَحِيمِ","numberInSurah":19,"juz":27,"manzil":7,"page":540,"ruku":473,"hizbQuarter":216,"sajda":false},{"number":5095,"text":"اعْلَمُوا أَنَّمَا الْحَيَاةُ الدُّنْيَا لَعِبٌ وَلَهْوٌ وَزِينَةٌ وَتَفَاخُرٌ بَيْنَكُمْ وَتَكَاثُرٌ فِي الْأَمْوَالِ وَالْأَوْلَادِ ۖ كَمَثَلِ غَيْثٍ أَعْجَبَ الْكُفَّارَ نَبَاتُهُ ثُمَّ يَهِيجُ فَتَرَاهُ مُصْفَرًّا ثُمَّ يَكُونُ حُطَامًا ۖ وَفِي الْآخِرَةِ عَذَابٌ شَدِيدٌ وَمَغْفِرَةٌ مِنَ اللَّهِ وَرِضْوَانٌ ۚ وَمَا الْحَيَاةُ الدُّنْيَا إِلَّا مَتَاعُ الْغُرُورِ","numberInSurah":20,"juz":27,"manzil":7,"page":540,"ruku":474,"hizbQuarter":216,"sajda":false},{"number":5096,"text":"سَابِقُوا إِلَىٰ مَغْفِرَةٍ مِنْ رَبِّكُمْ وَجَنَّةٍ عَرْضُهَا كَعَرْضِ السَّمَاءِ وَالْأَرْضِ أُعِدَّتْ لِلَّذِينَ آمَنُوا بِاللَّهِ وَرُسُلِهِ ۚ ذَٰلِكَ فَضْلُ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ ۚ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ","numberInSurah":21,"juz":27,"manzil":7,"page":540,"ruku":474,"hizbQuarter":216,"sajda":false},{"number":5097,"text":"مَا أَصَابَ مِنْ مُصِيبَةٍ فِي الْأَرْضِ وَلَا فِي أَنْفُسِكُمْ إِلَّا فِي كِتَابٍ مِنْ قَبْلِ أَنْ نَبْرَأَهَا ۚ إِنَّ ذَٰلِكَ عَلَى اللَّهِ يَسِيرٌ","numberInSurah":22,"juz":27,"manzil":7,"page":540,"ruku":474,"hizbQuarter":216,"sajda":false},{"number":5098,"text":"لِكَيْلَا تَأْسَوْا عَلَىٰ مَا فَاتَكُمْ وَلَا تَفْرَحُوا بِمَا آتَاكُمْ ۗ وَاللَّهُ لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ","numberInSurah":23,"juz":27,"manzil":7,"page":540,"ruku":474,"hizbQuarter":216,"sajda":false},{"number":5099,"text":"الَّذِينَ يَبْخَلُونَ وَيَأْمُرُونَ النَّاسَ بِالْبُخْلِ ۗ وَمَنْ يَتَوَلَّ فَإِنَّ اللَّهَ هُوَ الْغَنِيُّ الْحَمِيدُ","numberInSurah":24,"juz":27,"manzil":7,"page":540,"ruku":474,"hizbQuarter":216,"sajda":false},{"number":5100,"text":"لَقَدْ أَرْسَلْنَا رُسُلَنَا بِالْبَيِّنَاتِ وَأَنْزَلْنَا مَعَهُمُ الْكِتَابَ وَالْمِيزَانَ لِيَقُومَ النَّاسُ بِالْقِسْطِ ۖ وَأَنْزَلْنَا الْحَدِيدَ فِيهِ بَأْسٌ شَدِيدٌ وَمَنَافِعُ لِلنَّاسِ وَلِيَعْلَمَ اللَّهُ مَنْ يَنْصُرُهُ وَرُسُلَهُ بِالْغَيْبِ ۚ إِنَّ اللَّهَ قَوِيٌّ عَزِيزٌ","numberInSurah":25,"juz":27,"manzil":7,"page":541,"ruku":474,"hizbQuarter":216,"sajda":false},{"number":5101,"text":"وَلَقَدْ أَرْسَلْنَا نُوحًا وَإِبْرَاهِيمَ وَجَعَلْنَا فِي ذُرِّيَّتِهِمَا النُّبُوَّةَ وَالْكِتَابَ ۖ فَمِنْهُمْ مُهْتَدٍ ۖ وَكَثِيرٌ مِنْهُمْ فَاسِقُونَ","numberInSurah":26,"juz":27,"manzil":7,"page":541,"ruku":475,"hizbQuarter":216,"sajda":false},{"number":5102,"text":"ثُمَّ قَفَّيْنَا عَلَىٰ آثَارِهِمْ بِرُسُلِنَا وَقَفَّيْنَا بِعِيسَى ابْنِ مَرْيَمَ وَآتَيْنَاهُ الْإِنْجِيلَ وَجَعَلْنَا فِي قُلُوبِ الَّذِينَ اتَّبَعُوهُ رَأْفَةً وَرَحْمَةً وَرَهْبَانِيَّةً ابْتَدَعُوهَا مَا كَتَبْنَاهَا عَلَيْهِمْ إِلَّا ابْتِغَاءَ رِضْوَانِ اللَّهِ فَمَا رَعَوْهَا حَقَّ رِعَايَتِهَا ۖ فَآتَيْنَا الَّذِينَ آمَنُوا مِنْهُمْ أَجْرَهُمْ ۖ وَكَثِيرٌ مِنْهُمْ فَاسِقُونَ","numberInSurah":27,"juz":27,"manzil":7,"page":541,"ruku":475,"hizbQuarter":216,"sajda":false},{"number":5103,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اتَّقُوا اللَّهَ وَآمِنُوا بِرَسُولِهِ يُؤْتِكُمْ كِفْلَيْنِ مِنْ رَحْمَتِهِ وَيَجْعَلْ لَكُمْ نُورًا تَمْشُونَ بِهِ وَيَغْفِرْ لَكُمْ ۚ وَاللَّهُ غَفُورٌ رَحِيمٌ","numberInSurah":28,"juz":27,"manzil":7,"page":541,"ruku":475,"hizbQuarter":216,"sajda":false},{"number":5104,"text":"لِئَلَّا يَعْلَمَ أَهْلُ الْكِتَابِ أَلَّا يَقْدِرُونَ عَلَىٰ شَيْءٍ مِنْ فَضْلِ اللَّهِ ۙ وَأَنَّ الْفَضْلَ بِيَدِ اللَّهِ يُؤْتِيهِ مَنْ يَشَاءُ ۚ وَاللَّهُ ذُو الْفَضْلِ الْعَظِيمِ","numberInSurah":29,"juz":27,"manzil":7,"page":541,"ruku":475,"hizbQuarter":216,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":57,"name":"سُورَةُ الحَدِيدِ","englishName":"Hadîd","englishNameTranslation":"The Iron","revelationType":"Medinan","numberOfAyahs":29,"ayahs":[{"number":5076,"text":"Göklerde ve yerde olanlar Allah'ı tesbih ederler. O güçlüdür, Hakim'dir.","numberInSurah":1,"juz":27,"manzil":7,"page":537,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5077,"text":"Göklerin ve yerin hükümranlığı O'nundur; diriltir, öldürür. O, her şeye Kadir'dir.","numberInSurah":2,"juz":27,"manzil":7,"page":537,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5078,"text":"O her şeyden öncedir; kendisinden sonraya hiçbir şeyin kalmayacağı son'dur; varlığı aşikardır; gerçek mahiyeti insan için gizlidir. O her şeyi bilir.","numberInSurah":3,"juz":27,"manzil":7,"page":537,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5079,"text":"Gökleri ve yeri altı günde yaratan, sonra arşa hükmeden, yere gireni ve ondan çıkanı, gökten ineni ve oraya yükseleni bilen O'dur. Nerede olursanız olun, O, sizinle beraberdir. Allah yaptıklarınızı görür.","numberInSurah":4,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5080,"text":"Göklerin ve yerin hükümranlığı O'nundur. Bütün işler Allah'a döndürülür.","numberInSurah":5,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5081,"text":"Geceyi gündüze katar, gündüzü geceye katar; O kalblerde olanı bilendir.","numberInSurah":6,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5082,"text":"Ey insanlar! Allah'a ve Peygamberine inanın; sizi varis kıldığı şeylerden sarfedin; aranızdan, inanıp da sarfeden kimselere büyük ecir vardır","numberInSurah":7,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5083,"text":"Peygamber sizi, Rabbinize inanmaya çağırdığı halde, Allah'a niçin inanmazsınız? Hem O, sizden söz almıştı, inanmışlar iseniz; bu çağrıya koşun.","numberInSurah":8,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5084,"text":"Sizi karanlıklardan aydınlığa çıkarmak için kuluna, apaçık ayetler indiren O'dur. Doğrusu Allah size karşı şefkatlidir, merhametlidir.","numberInSurah":9,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5085,"text":"Göklerin ve yerin mirasçısı Allah olduğu halde, Allah yolunda siz niçin sarf etmiyorsunuz? İçinizden Mekke'nin fethinden önce sarfeden ve savaşan kimseler, daha sonra sarfedip savaşan kimselerle bir değildirler, öncekiler daha üstün derecededirler. Allah, hepsine cenneti vadetmiştir. Allah, işlediklerinizden haberdardır.","numberInSurah":10,"juz":27,"manzil":7,"page":538,"ruku":472,"hizbQuarter":215,"sajda":false},{"number":5086,"text":"Allah'a kim güzel bir ödünç takdiminde bulunursa, Allah karşılığını kat kat verir, ona cömertçe verilecek bir ecir de vardır.","numberInSurah":11,"juz":27,"manzil":7,"page":538,"ruku":473,"hizbQuarter":215,"sajda":false},{"number":5087,"text":"İnanmış erkek ve kadınları, defterleri sağdan verilmiş ve ışıkları önlerinde olarak giderken gördüğün gün onlara şöyle denecektir: \"Müjde; bugün içlerinden ırmaklar akan, içinde temelli kalacağınız cennetler sizindir.\" İşte bu büyük kurtuluştur.","numberInSurah":12,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":215,"sajda":false},{"number":5088,"text":"İkiyüzlü erkek ve kadınlar müminlere: \"Bizi de gözetin; ışığınızdan faydalanalım\" dedikleri gün, onlara: \"Ardınıza dönün de ışık arayın\" denir; inananlarla ikiyüzlüler arasına, kapısının içinde rahmet ve dışında azap olan bir sur çekilir.","numberInSurah":13,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":215,"sajda":false},{"number":5089,"text":"İkiyüzlüler, inananlara: \"Biz sizinle beraber değil miydik\" diye seslenirler. Onlar: \"Evet öyle; fakat sizler kendinizi aldattınız, bize pusu kurdunuz, Allah'ın buyruğu gelene kadar dinde şüpheye düştünüz; sizi kuruntular aldattı; sizi şeytanlar Allah'a karşı da ayarttı.\"","numberInSurah":14,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":215,"sajda":false},{"number":5090,"text":"Bugün sizden ve inkar edenlerden fidye kabul edilmez; varacağınız yer ateştir, layığınız orasıdır; ne kötü bir dönüştür!","numberInSurah":15,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":215,"sajda":false},{"number":5091,"text":"İnananların gönüllerinin Allah'ı anması ve O'ndan inen gerçeğe içten bağlanması zamanı daha gelmedi mi? Onlar, daha önce kendilerine kitap verilenler gibi olmasınlar; onların üzerinden uzun zaman geçti de kalbleri katılaştı; çoğu, yoldan çıkmış kimselerdir.","numberInSurah":16,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":216,"sajda":false},{"number":5092,"text":"Allah'ın, yeryüzünü ölümünden sonra dirilttiğini bilin; size, akledesiniz diye açık açık deliller anlattık.","numberInSurah":17,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":216,"sajda":false},{"number":5093,"text":"Doğrusu, sadaka veren erkek ve kadınlara, Allah'a güzel bir takdimde bulunanlara kat kat karşılık verilir; onlara cömertçe verilecek bir ecir vardır.","numberInSurah":18,"juz":27,"manzil":7,"page":539,"ruku":473,"hizbQuarter":216,"sajda":false},{"number":5094,"text":"Allah'a ve peygamberlerine inananlara, dosdoğru olanlara ve Allah yolunda şehit düşenlere, işte onlara, Rableri katında nur ve ecir vardır. İnkar edip ayetlerimizi yalanlayanlar, işte onlar da, cehennemlik olanlardır.","numberInSurah":19,"juz":27,"manzil":7,"page":540,"ruku":473,"hizbQuarter":216,"sajda":false},{"number":5095,"text":"Bilin ki, dünya hayatı oyun, oyalanma, süslenme, aranızda övünme ve daha çok mal ve çocuk sahibi olmaktan ibarettir. Bu, yağmurun bitirdiği, ekicilerin de hoşuna giden bir bitkiye benzer; sonra kurur, sapsarı olduğu görülür, sonra çerçöp olur. Ahirette çetin azap da vardır. Allah'ın hoşnudluğu ve bağışlaması da vardır; dünya hayatı ise sadece aldatıcı bir geçinmedir.","numberInSurah":20,"juz":27,"manzil":7,"page":540,"ruku":474,"hizbQuarter":216,"sajda":false},{"number":5096,"text":"Ey İnsanlar! Rabbiniz tarafından bağışlanmaya, Allah'a ve Peygamberine inananlar için hazırlanmış, genişliği yerle göğün genişliği kadar olan cennete koşusun; bu Allah'ın dilediğine verdiği lütfudur. Allah, büyük lütuf sahibidir.","numberInSurah":21,"juz":27,"manzil":7,"page":540,"ruku":474,"hizbQuarter":216,"sajda":false},{"number":5097,"text":"Yeryüzüne ve sizin başınıza gelen herhangi bir musibet yoktur ki biz onu yaratmadan önce o, Kitap'da bulunmasın. Doğrusu bu Allah'a kolaydır.","numberInSurah":22,"juz":27,"manzil":7,"page":540,"ruku":474,"hizbQuarter":216,"sajda":false},{"number":5098,"text":"Bu, kaybettiğinize üzülmemeniz ve Allah'ın size verdiği nimetlerle şımarmamanız içindir. Allah, kendini beğenip öğünen hiç kimseyi sevmez;","numberInSurah":23,"juz":27,"manzil":7,"page":540,"ruku":474,"hizbQuarter":216,"sajda":false},{"number":5099,"text":"Bunlar cimrilik ederler ve insanlara da cimrilik yapmalarını söylerler. Allah'ın buyruğundan kim yüz çevirirse bilsin ki, Allah şüphesiz müstağni ve övülmeğe layık olandır.","numberInSurah":24,"juz":27,"manzil":7,"page":540,"ruku":474,"hizbQuarter":216,"sajda":false},{"number":5100,"text":"And olsun ki peygamberlerimizi belgelerle gönderdik; insanların doğru (adaletli) hareket etmeleri için peygamberlere kitap ve ölçü indirdik; pek sert olan ve insanlara birçok faydası bulunan demiri de indirdik. Bu, Allah'ın dinine ve peygamberlerine görmeksizin yardım edenleri meydana çıkarması içindir. Doğrusu Allah kuvvetlidir, güçlüdür.","numberInSurah":25,"juz":27,"manzil":7,"page":541,"ruku":474,"hizbQuarter":216,"sajda":false},{"number":5101,"text":"And olsun ki Nuh'u ve İbrahim'i Biz gönderdik; ikisinin soyundan gelenlere peygamberlik ve kitap verdik; soylarından gelenlerin kimi doğru yoldadır, birçoğu da yoldan çıkmıştır.","numberInSurah":26,"juz":27,"manzil":7,"page":541,"ruku":475,"hizbQuarter":216,"sajda":false},{"number":5102,"text":"Onların izleri üzerinden peygamberlerimizi ard arda gönderdik; Meryem oğlu İsa'yı da ardlarından gönderdik ve ona İncil'i verdik; ona uyanların gönüllerine şefkat ve merhamet duyguları koyduk; üzerlerine bizim gerekli kılmadığımız fakat kendilerinin güya Allah'ın rızasını kazanmak için ortaya attıkları ruhbaniyete bile gereği gibi riayet etmediler; içlerinde inanmış olan kimselere ecirlerini verdik; ama çoğu yoldan çıkmışlardır.","numberInSurah":27,"juz":27,"manzil":7,"page":541,"ruku":475,"hizbQuarter":216,"sajda":false},{"number":5103,"text":"Ey inananlar! Allah'tan sakının, Peygamberine inanın ki, Allah size rahmetini iki kat versin; size ışığında yürüyeceğiniz bir ışık var etsin; sizi bağışlasın; Allah bağışlayandır, acıyandır.","numberInSurah":28,"juz":27,"manzil":7,"page":541,"ruku":475,"hizbQuarter":216,"sajda":false},{"number":5104,"text":"Kitap ehli bilsinler ki, Allah'ın lütfundan hiçbir şey elde edemezler (bu lütfa malik değillerdir); lütuf Allah'ın elindedir, onu dilediğine verir; Allah büyük lütuf sahibidir.","numberInSurah":29,"juz":27,"manzil":7,"page":541,"ruku":475,"hizbQuarter":216,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}