{"arabic":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Müzzemmil","englishNameTranslation":"The Enshrouded One","revelationType":"Meccan","numberOfAyahs":20,"ayahs":[{"number":5476,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ يَا أَيُّهَا الْمُزَّمِّلُ","numberInSurah":1,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5477,"text":"قُمِ اللَّيْلَ إِلَّا قَلِيلًا","numberInSurah":2,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5478,"text":"نِصْفَهُ أَوِ انْقُصْ مِنْهُ قَلِيلًا","numberInSurah":3,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5479,"text":"أَوْ زِدْ عَلَيْهِ وَرَتِّلِ الْقُرْآنَ تَرْتِيلًا","numberInSurah":4,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5480,"text":"إِنَّا سَنُلْقِي عَلَيْكَ قَوْلًا ثَقِيلًا","numberInSurah":5,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5481,"text":"إِنَّ نَاشِئَةَ اللَّيْلِ هِيَ أَشَدُّ وَطْئًا وَأَقْوَمُ قِيلًا","numberInSurah":6,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5482,"text":"إِنَّ لَكَ فِي النَّهَارِ سَبْحًا طَوِيلًا","numberInSurah":7,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5483,"text":"وَاذْكُرِ اسْمَ رَبِّكَ وَتَبَتَّلْ إِلَيْهِ تَبْتِيلًا","numberInSurah":8,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5484,"text":"رَبُّ الْمَشْرِقِ وَالْمَغْرِبِ لَا إِلَٰهَ إِلَّا هُوَ فَاتَّخِذْهُ وَكِيلًا","numberInSurah":9,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5485,"text":"وَاصْبِرْ عَلَىٰ مَا يَقُولُونَ وَاهْجُرْهُمْ هَجْرًا جَمِيلًا","numberInSurah":10,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5486,"text":"وَذَرْنِي وَالْمُكَذِّبِينَ أُولِي النَّعْمَةِ وَمَهِّلْهُمْ قَلِيلًا","numberInSurah":11,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5487,"text":"إِنَّ لَدَيْنَا أَنْكَالًا وَجَحِيمًا","numberInSurah":12,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5488,"text":"وَطَعَامًا ذَا غُصَّةٍ وَعَذَابًا أَلِيمًا","numberInSurah":13,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5489,"text":"يَوْمَ تَرْجُفُ الْأَرْضُ وَالْجِبَالُ وَكَانَتِ الْجِبَالُ كَثِيبًا مَهِيلًا","numberInSurah":14,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5490,"text":"إِنَّا أَرْسَلْنَا إِلَيْكُمْ رَسُولًا شَاهِدًا عَلَيْكُمْ كَمَا أَرْسَلْنَا إِلَىٰ فِرْعَوْنَ رَسُولًا","numberInSurah":15,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5491,"text":"فَعَصَىٰ فِرْعَوْنُ الرَّسُولَ فَأَخَذْنَاهُ أَخْذًا وَبِيلًا","numberInSurah":16,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5492,"text":"فَكَيْفَ تَتَّقُونَ إِنْ كَفَرْتُمْ يَوْمًا يَجْعَلُ الْوِلْدَانَ شِيبًا","numberInSurah":17,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5493,"text":"السَّمَاءُ مُنْفَطِرٌ بِهِ ۚ كَانَ وَعْدُهُ مَفْعُولًا","numberInSurah":18,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5494,"text":"إِنَّ هَٰذِهِ تَذْكِرَةٌ ۖ فَمَنْ شَاءَ اتَّخَذَ إِلَىٰ رَبِّهِ سَبِيلًا","numberInSurah":19,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5495,"text":"۞ إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَىٰ مِنْ ثُلُثَيِ اللَّيْلِ وَنِصْفَهُ وَثُلُثَهُ وَطَائِفَةٌ مِنَ الَّذِينَ مَعَكَ ۚ وَاللَّهُ يُقَدِّرُ اللَّيْلَ وَالنَّهَارَ ۚ عَلِمَ أَنْ لَنْ تُحْصُوهُ فَتَابَ عَلَيْكُمْ ۖ فَاقْرَءُوا مَا تَيَسَّرَ مِنَ الْقُرْآنِ ۚ عَلِمَ أَنْ سَيَكُونُ مِنْكُمْ مَرْضَىٰ ۙ وَآخَرُونَ يَضْرِبُونَ فِي الْأَرْضِ يَبْتَغُونَ مِنْ فَضْلِ اللَّهِ ۙ وَآخَرُونَ يُقَاتِلُونَ فِي سَبِيلِ اللَّهِ ۖ فَاقْرَءُوا مَا تَيَسَّرَ مِنْهُ ۚ وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ وَأَقْرِضُوا اللَّهَ قَرْضًا حَسَنًا ۚ وَمَا تُقَدِّمُوا لِأَنْفُسِكُمْ مِنْ خَيْرٍ تَجِدُوهُ عِنْدَ اللَّهِ هُوَ خَيْرًا وَأَعْظَمَ أَجْرًا ۚ وَاسْتَغْفِرُوا اللَّهَ ۖ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","numberInSurah":20,"juz":29,"manzil":7,"page":575,"ruku":509,"hizbQuarter":230,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":73,"name":"سُورَةُ المُزَّمِّلِ","englishName":"Müzzemmil","englishNameTranslation":"The Enshrouded One","revelationType":"Meccan","numberOfAyahs":20,"ayahs":[{"number":5476,"text":"Ey örtünüp bürünen! Gecenin yarısında, istersen biraz sonra, istersen biraz önce bir müddet için kalk ve ağır ağır Kuran oku.","numberInSurah":1,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5477,"text":"Ey örtünüp bürünen! Gecenin yarısında, istersen biraz sonra, istersen biraz önce bir müddet için kalk ve ağır ağır Kuran oku.","numberInSurah":2,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5478,"text":"Ey örtünüp bürünen! Gecenin yarısında, istersen biraz sonra, istersen biraz önce bir müddet için kalk ve ağır ağır Kuran oku.","numberInSurah":3,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5479,"text":"Ey örtünüp bürünen! Gecenin yarısında, istersen biraz sonra, istersen biraz önce bir müddet için kalk ve ağır ağır Kuran oku.","numberInSurah":4,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5480,"text":"Doğrusu Biz, sana, taşıması ağır bir söz vahyedeceğiz.","numberInSurah":5,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5481,"text":"şüphesiz, gece kalkışı daha tesirli ve o zaman okumak daha elverişlidir.","numberInSurah":6,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5482,"text":"Çünkü gündüz, seni uzun uzun alıkoyacak işler vardır.","numberInSurah":7,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5483,"text":"Rabbinin adını an; herşeyi bırakıp yalnız O'na yönel,","numberInSurah":8,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5484,"text":"O, doğunun ve batının Rabbidir; O'ndan başka tanrı yoktur. Öyleyse O'nu vekil tut.","numberInSurah":9,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5485,"text":"Onların söylediklerine sabret, yanlarından güzellikle ayrıl.","numberInSurah":10,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5486,"text":"Varlık sahibi olup da seni yalanlayanları Bana bırak; onlara az bir mehil ver.","numberInSurah":11,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5487,"text":"Şüphesiz katımızda onlar için ağır boyunduruklar, cehennem, boğazı tıkayan bir yiyecek ve can yakan azap vardır.","numberInSurah":12,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5488,"text":"Şüphesiz katımızda onlar için ağır boyunduruklar, cehennem, boğazı tıkayan bir yiyecek ve can yakan azap vardır.","numberInSurah":13,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5489,"text":"Kıyametin koptuğu gün, yeryüzü ve dağlar sarsılır; dağlar, yumuşak kum yığını haline gelir.","numberInSurah":14,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5490,"text":"Firavun'a bir peygamber gönderdiğimiz gibi, size de, hakkınızda şahidlik edecek bir peygamber gönderdik.","numberInSurah":15,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5491,"text":"Ama Firavun o peygambere karşı gelmişti de onu çok ağır bir şekilde tutup cezalandırmıştık.","numberInSurah":16,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5492,"text":"Eğer inkar ederseniz, gençleri ihtiyarlatan günden nasıl korunursunuz?","numberInSurah":17,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5493,"text":"O günün şiddetiyle gök bile parçalanır. O'nun sözü yerine gelir.","numberInSurah":18,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5494,"text":"Doğrusu bu anlatılanlar birer öğüttür. Dileyen kimse, Rabbine doğru giden bir yol tutar.","numberInSurah":19,"juz":29,"manzil":7,"page":574,"ruku":508,"hizbQuarter":229,"sajda":false},{"number":5495,"text":"Şüphesiz Rabbin, senin ve beraberinde bulunanlardan bir topluluğun gecenin üçte ikisinden biraz az, yarısı ve üçte biri kadar vakit içinde kalktığını bilir. Gece ve gündüzü Allah ölçer; sizin bu vakitleri takdir edemeyeceğinizi bildiğinden tevbenizi kabul etmiştir. Artık, Kuran'dan kolayınıza geleni okuyun; Allah, içinizden, hasta olanları, Allah'ın lütfundan rızık aramak üzere yeryüzünde dolaşacak olan kimseleri ve Allah yolunda savaşacak olanları şüphesiz bilir. Kuran'dan kolayınıza geleni okuyun; namazı kılın; zekatı verin; Allah'a güzel ödünç takdiminde bulunun; kendiniz için yaptığınız iyiliği daha iyi ve daha büyük ecir olarak Allah katında bulursunuz. Allah'tan bağışlanma dileyin; Allah elbette bağışlar ve merhamet eder.","numberInSurah":20,"juz":29,"manzil":7,"page":575,"ruku":509,"hizbQuarter":230,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}