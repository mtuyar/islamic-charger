{"arabic":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"A'râf","englishNameTranslation":"The Heights","revelationType":"Meccan","numberOfAyahs":206,"ayahs":[{"number":955,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ المص","numberInSurah":1,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":956,"text":"كِتَابٌ أُنْزِلَ إِلَيْكَ فَلَا يَكُنْ فِي صَدْرِكَ حَرَجٌ مِنْهُ لِتُنْذِرَ بِهِ وَذِكْرَىٰ لِلْمُؤْمِنِينَ","numberInSurah":2,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":957,"text":"اتَّبِعُوا مَا أُنْزِلَ إِلَيْكُمْ مِنْ رَبِّكُمْ وَلَا تَتَّبِعُوا مِنْ دُونِهِ أَوْلِيَاءَ ۗ قَلِيلًا مَا تَذَكَّرُونَ","numberInSurah":3,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":958,"text":"وَكَمْ مِنْ قَرْيَةٍ أَهْلَكْنَاهَا فَجَاءَهَا بَأْسُنَا بَيَاتًا أَوْ هُمْ قَائِلُونَ","numberInSurah":4,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":959,"text":"فَمَا كَانَ دَعْوَاهُمْ إِذْ جَاءَهُمْ بَأْسُنَا إِلَّا أَنْ قَالُوا إِنَّا كُنَّا ظَالِمِينَ","numberInSurah":5,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":960,"text":"فَلَنَسْأَلَنَّ الَّذِينَ أُرْسِلَ إِلَيْهِمْ وَلَنَسْأَلَنَّ الْمُرْسَلِينَ","numberInSurah":6,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":961,"text":"فَلَنَقُصَّنَّ عَلَيْهِمْ بِعِلْمٍ ۖ وَمَا كُنَّا غَائِبِينَ","numberInSurah":7,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":962,"text":"وَالْوَزْنُ يَوْمَئِذٍ الْحَقُّ ۚ فَمَنْ ثَقُلَتْ مَوَازِينُهُ فَأُولَٰئِكَ هُمُ الْمُفْلِحُونَ","numberInSurah":8,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":963,"text":"وَمَنْ خَفَّتْ مَوَازِينُهُ فَأُولَٰئِكَ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ بِمَا كَانُوا بِآيَاتِنَا يَظْلِمُونَ","numberInSurah":9,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":964,"text":"وَلَقَدْ مَكَّنَّاكُمْ فِي الْأَرْضِ وَجَعَلْنَا لَكُمْ فِيهَا مَعَايِشَ ۗ قَلِيلًا مَا تَشْكُرُونَ","numberInSurah":10,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":965,"text":"وَلَقَدْ خَلَقْنَاكُمْ ثُمَّ صَوَّرْنَاكُمْ ثُمَّ قُلْنَا لِلْمَلَائِكَةِ اسْجُدُوا لِآدَمَ فَسَجَدُوا إِلَّا إِبْلِيسَ لَمْ يَكُنْ مِنَ السَّاجِدِينَ","numberInSurah":11,"juz":8,"manzil":2,"page":151,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":966,"text":"قَالَ مَا مَنَعَكَ أَلَّا تَسْجُدَ إِذْ أَمَرْتُكَ ۖ قَالَ أَنَا خَيْرٌ مِنْهُ خَلَقْتَنِي مِنْ نَارٍ وَخَلَقْتَهُ مِنْ طِينٍ","numberInSurah":12,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":967,"text":"قَالَ فَاهْبِطْ مِنْهَا فَمَا يَكُونُ لَكَ أَنْ تَتَكَبَّرَ فِيهَا فَاخْرُجْ إِنَّكَ مِنَ الصَّاغِرِينَ","numberInSurah":13,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":968,"text":"قَالَ أَنْظِرْنِي إِلَىٰ يَوْمِ يُبْعَثُونَ","numberInSurah":14,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":969,"text":"قَالَ إِنَّكَ مِنَ الْمُنْظَرِينَ","numberInSurah":15,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":970,"text":"قَالَ فَبِمَا أَغْوَيْتَنِي لَأَقْعُدَنَّ لَهُمْ صِرَاطَكَ الْمُسْتَقِيمَ","numberInSurah":16,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":971,"text":"ثُمَّ لَآتِيَنَّهُمْ مِنْ بَيْنِ أَيْدِيهِمْ وَمِنْ خَلْفِهِمْ وَعَنْ أَيْمَانِهِمْ وَعَنْ شَمَائِلِهِمْ ۖ وَلَا تَجِدُ أَكْثَرَهُمْ شَاكِرِينَ","numberInSurah":17,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":972,"text":"قَالَ اخْرُجْ مِنْهَا مَذْءُومًا مَدْحُورًا ۖ لَمَنْ تَبِعَكَ مِنْهُمْ لَأَمْلَأَنَّ جَهَنَّمَ مِنْكُمْ أَجْمَعِينَ","numberInSurah":18,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":973,"text":"وَيَا آدَمُ اسْكُنْ أَنْتَ وَزَوْجُكَ الْجَنَّةَ فَكُلَا مِنْ حَيْثُ شِئْتُمَا وَلَا تَقْرَبَا هَٰذِهِ الشَّجَرَةَ فَتَكُونَا مِنَ الظَّالِمِينَ","numberInSurah":19,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":974,"text":"فَوَسْوَسَ لَهُمَا الشَّيْطَانُ لِيُبْدِيَ لَهُمَا مَا وُورِيَ عَنْهُمَا مِنْ سَوْآتِهِمَا وَقَالَ مَا نَهَاكُمَا رَبُّكُمَا عَنْ هَٰذِهِ الشَّجَرَةِ إِلَّا أَنْ تَكُونَا مَلَكَيْنِ أَوْ تَكُونَا مِنَ الْخَالِدِينَ","numberInSurah":20,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":975,"text":"وَقَاسَمَهُمَا إِنِّي لَكُمَا لَمِنَ النَّاصِحِينَ","numberInSurah":21,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":976,"text":"فَدَلَّاهُمَا بِغُرُورٍ ۚ فَلَمَّا ذَاقَا الشَّجَرَةَ بَدَتْ لَهُمَا سَوْآتُهُمَا وَطَفِقَا يَخْصِفَانِ عَلَيْهِمَا مِنْ وَرَقِ الْجَنَّةِ ۖ وَنَادَاهُمَا رَبُّهُمَا أَلَمْ أَنْهَكُمَا عَنْ تِلْكُمَا الشَّجَرَةِ وَأَقُلْ لَكُمَا إِنَّ الشَّيْطَانَ لَكُمَا عَدُوٌّ مُبِينٌ","numberInSurah":22,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":977,"text":"قَالَا رَبَّنَا ظَلَمْنَا أَنْفُسَنَا وَإِنْ لَمْ تَغْفِرْ لَنَا وَتَرْحَمْنَا لَنَكُونَنَّ مِنَ الْخَاسِرِينَ","numberInSurah":23,"juz":8,"manzil":2,"page":153,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":978,"text":"قَالَ اهْبِطُوا بَعْضُكُمْ لِبَعْضٍ عَدُوٌّ ۖ وَلَكُمْ فِي الْأَرْضِ مُسْتَقَرٌّ وَمَتَاعٌ إِلَىٰ حِينٍ","numberInSurah":24,"juz":8,"manzil":2,"page":153,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":979,"text":"قَالَ فِيهَا تَحْيَوْنَ وَفِيهَا تَمُوتُونَ وَمِنْهَا تُخْرَجُونَ","numberInSurah":25,"juz":8,"manzil":2,"page":153,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":980,"text":"يَا بَنِي آدَمَ قَدْ أَنْزَلْنَا عَلَيْكُمْ لِبَاسًا يُوَارِي سَوْآتِكُمْ وَرِيشًا ۖ وَلِبَاسُ التَّقْوَىٰ ذَٰلِكَ خَيْرٌ ۚ ذَٰلِكَ مِنْ آيَاتِ اللَّهِ لَعَلَّهُمْ يَذَّكَّرُونَ","numberInSurah":26,"juz":8,"manzil":2,"page":153,"ruku":124,"hizbQuarter":61,"sajda":false},{"number":981,"text":"يَا بَنِي آدَمَ لَا يَفْتِنَنَّكُمُ الشَّيْطَانُ كَمَا أَخْرَجَ أَبَوَيْكُمْ مِنَ الْجَنَّةِ يَنْزِعُ عَنْهُمَا لِبَاسَهُمَا لِيُرِيَهُمَا سَوْآتِهِمَا ۗ إِنَّهُ يَرَاكُمْ هُوَ وَقَبِيلُهُ مِنْ حَيْثُ لَا تَرَوْنَهُمْ ۗ إِنَّا جَعَلْنَا الشَّيَاطِينَ أَوْلِيَاءَ لِلَّذِينَ لَا يُؤْمِنُونَ","numberInSurah":27,"juz":8,"manzil":2,"page":153,"ruku":124,"hizbQuarter":61,"sajda":false},{"number":982,"text":"وَإِذَا فَعَلُوا فَاحِشَةً قَالُوا وَجَدْنَا عَلَيْهَا آبَاءَنَا وَاللَّهُ أَمَرَنَا بِهَا ۗ قُلْ إِنَّ اللَّهَ لَا يَأْمُرُ بِالْفَحْشَاءِ ۖ أَتَقُولُونَ عَلَى اللَّهِ مَا لَا تَعْلَمُونَ","numberInSurah":28,"juz":8,"manzil":2,"page":153,"ruku":124,"hizbQuarter":61,"sajda":false},{"number":983,"text":"قُلْ أَمَرَ رَبِّي بِالْقِسْطِ ۖ وَأَقِيمُوا وُجُوهَكُمْ عِنْدَ كُلِّ مَسْجِدٍ وَادْعُوهُ مُخْلِصِينَ لَهُ الدِّينَ ۚ كَمَا بَدَأَكُمْ تَعُودُونَ","numberInSurah":29,"juz":8,"manzil":2,"page":153,"ruku":124,"hizbQuarter":61,"sajda":false},{"number":984,"text":"فَرِيقًا هَدَىٰ وَفَرِيقًا حَقَّ عَلَيْهِمُ الضَّلَالَةُ ۗ إِنَّهُمُ اتَّخَذُوا الشَّيَاطِينَ أَوْلِيَاءَ مِنْ دُونِ اللَّهِ وَيَحْسَبُونَ أَنَّهُمْ مُهْتَدُونَ","numberInSurah":30,"juz":8,"manzil":2,"page":153,"ruku":124,"hizbQuarter":61,"sajda":false},{"number":985,"text":"۞ يَا بَنِي آدَمَ خُذُوا زِينَتَكُمْ عِنْدَ كُلِّ مَسْجِدٍ وَكُلُوا وَاشْرَبُوا وَلَا تُسْرِفُوا ۚ إِنَّهُ لَا يُحِبُّ الْمُسْرِفِينَ","numberInSurah":31,"juz":8,"manzil":2,"page":154,"ruku":124,"hizbQuarter":62,"sajda":false},{"number":986,"text":"قُلْ مَنْ حَرَّمَ زِينَةَ اللَّهِ الَّتِي أَخْرَجَ لِعِبَادِهِ وَالطَّيِّبَاتِ مِنَ الرِّزْقِ ۚ قُلْ هِيَ لِلَّذِينَ آمَنُوا فِي الْحَيَاةِ الدُّنْيَا خَالِصَةً يَوْمَ الْقِيَامَةِ ۗ كَذَٰلِكَ نُفَصِّلُ الْآيَاتِ لِقَوْمٍ يَعْلَمُونَ","numberInSurah":32,"juz":8,"manzil":2,"page":154,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":987,"text":"قُلْ إِنَّمَا حَرَّمَ رَبِّيَ الْفَوَاحِشَ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَ وَالْإِثْمَ وَالْبَغْيَ بِغَيْرِ الْحَقِّ وَأَنْ تُشْرِكُوا بِاللَّهِ مَا لَمْ يُنَزِّلْ بِهِ سُلْطَانًا وَأَنْ تَقُولُوا عَلَى اللَّهِ مَا لَا تَعْلَمُونَ","numberInSurah":33,"juz":8,"manzil":2,"page":154,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":988,"text":"وَلِكُلِّ أُمَّةٍ أَجَلٌ ۖ فَإِذَا جَاءَ أَجَلُهُمْ لَا يَسْتَأْخِرُونَ سَاعَةً ۖ وَلَا يَسْتَقْدِمُونَ","numberInSurah":34,"juz":8,"manzil":2,"page":154,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":989,"text":"يَا بَنِي آدَمَ إِمَّا يَأْتِيَنَّكُمْ رُسُلٌ مِنْكُمْ يَقُصُّونَ عَلَيْكُمْ آيَاتِي ۙ فَمَنِ اتَّقَىٰ وَأَصْلَحَ فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ","numberInSurah":35,"juz":8,"manzil":2,"page":154,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":990,"text":"وَالَّذِينَ كَذَّبُوا بِآيَاتِنَا وَاسْتَكْبَرُوا عَنْهَا أُولَٰئِكَ أَصْحَابُ النَّارِ ۖ هُمْ فِيهَا خَالِدُونَ","numberInSurah":36,"juz":8,"manzil":2,"page":154,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":991,"text":"فَمَنْ أَظْلَمُ مِمَّنِ افْتَرَىٰ عَلَى اللَّهِ كَذِبًا أَوْ كَذَّبَ بِآيَاتِهِ ۚ أُولَٰئِكَ يَنَالُهُمْ نَصِيبُهُمْ مِنَ الْكِتَابِ ۖ حَتَّىٰ إِذَا جَاءَتْهُمْ رُسُلُنَا يَتَوَفَّوْنَهُمْ قَالُوا أَيْنَ مَا كُنْتُمْ تَدْعُونَ مِنْ دُونِ اللَّهِ ۖ قَالُوا ضَلُّوا عَنَّا وَشَهِدُوا عَلَىٰ أَنْفُسِهِمْ أَنَّهُمْ كَانُوا كَافِرِينَ","numberInSurah":37,"juz":8,"manzil":2,"page":154,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":992,"text":"قَالَ ادْخُلُوا فِي أُمَمٍ قَدْ خَلَتْ مِنْ قَبْلِكُمْ مِنَ الْجِنِّ وَالْإِنْسِ فِي النَّارِ ۖ كُلَّمَا دَخَلَتْ أُمَّةٌ لَعَنَتْ أُخْتَهَا ۖ حَتَّىٰ إِذَا ادَّارَكُوا فِيهَا جَمِيعًا قَالَتْ أُخْرَاهُمْ لِأُولَاهُمْ رَبَّنَا هَٰؤُلَاءِ أَضَلُّونَا فَآتِهِمْ عَذَابًا ضِعْفًا مِنَ النَّارِ ۖ قَالَ لِكُلٍّ ضِعْفٌ وَلَٰكِنْ لَا تَعْلَمُونَ","numberInSurah":38,"juz":8,"manzil":2,"page":155,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":993,"text":"وَقَالَتْ أُولَاهُمْ لِأُخْرَاهُمْ فَمَا كَانَ لَكُمْ عَلَيْنَا مِنْ فَضْلٍ فَذُوقُوا الْعَذَابَ بِمَا كُنْتُمْ تَكْسِبُونَ","numberInSurah":39,"juz":8,"manzil":2,"page":155,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":994,"text":"إِنَّ الَّذِينَ كَذَّبُوا بِآيَاتِنَا وَاسْتَكْبَرُوا عَنْهَا لَا تُفَتَّحُ لَهُمْ أَبْوَابُ السَّمَاءِ وَلَا يَدْخُلُونَ الْجَنَّةَ حَتَّىٰ يَلِجَ الْجَمَلُ فِي سَمِّ الْخِيَاطِ ۚ وَكَذَٰلِكَ نَجْزِي الْمُجْرِمِينَ","numberInSurah":40,"juz":8,"manzil":2,"page":155,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":995,"text":"لَهُمْ مِنْ جَهَنَّمَ مِهَادٌ وَمِنْ فَوْقِهِمْ غَوَاشٍ ۚ وَكَذَٰلِكَ نَجْزِي الظَّالِمِينَ","numberInSurah":41,"juz":8,"manzil":2,"page":155,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":996,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَا نُكَلِّفُ نَفْسًا إِلَّا وُسْعَهَا أُولَٰئِكَ أَصْحَابُ الْجَنَّةِ ۖ هُمْ فِيهَا خَالِدُونَ","numberInSurah":42,"juz":8,"manzil":2,"page":155,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":997,"text":"وَنَزَعْنَا مَا فِي صُدُورِهِمْ مِنْ غِلٍّ تَجْرِي مِنْ تَحْتِهِمُ الْأَنْهَارُ ۖ وَقَالُوا الْحَمْدُ لِلَّهِ الَّذِي هَدَانَا لِهَٰذَا وَمَا كُنَّا لِنَهْتَدِيَ لَوْلَا أَنْ هَدَانَا اللَّهُ ۖ لَقَدْ جَاءَتْ رُسُلُ رَبِّنَا بِالْحَقِّ ۖ وَنُودُوا أَنْ تِلْكُمُ الْجَنَّةُ أُورِثْتُمُوهَا بِمَا كُنْتُمْ تَعْمَلُونَ","numberInSurah":43,"juz":8,"manzil":2,"page":155,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":998,"text":"وَنَادَىٰ أَصْحَابُ الْجَنَّةِ أَصْحَابَ النَّارِ أَنْ قَدْ وَجَدْنَا مَا وَعَدَنَا رَبُّنَا حَقًّا فَهَلْ وَجَدْتُمْ مَا وَعَدَ رَبُّكُمْ حَقًّا ۖ قَالُوا نَعَمْ ۚ فَأَذَّنَ مُؤَذِّنٌ بَيْنَهُمْ أَنْ لَعْنَةُ اللَّهِ عَلَى الظَّالِمِينَ","numberInSurah":44,"juz":8,"manzil":2,"page":156,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":999,"text":"الَّذِينَ يَصُدُّونَ عَنْ سَبِيلِ اللَّهِ وَيَبْغُونَهَا عِوَجًا وَهُمْ بِالْآخِرَةِ كَافِرُونَ","numberInSurah":45,"juz":8,"manzil":2,"page":156,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":1000,"text":"وَبَيْنَهُمَا حِجَابٌ ۚ وَعَلَى الْأَعْرَافِ رِجَالٌ يَعْرِفُونَ كُلًّا بِسِيمَاهُمْ ۚ وَنَادَوْا أَصْحَابَ الْجَنَّةِ أَنْ سَلَامٌ عَلَيْكُمْ ۚ لَمْ يَدْخُلُوهَا وَهُمْ يَطْمَعُونَ","numberInSurah":46,"juz":8,"manzil":2,"page":156,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":1001,"text":"۞ وَإِذَا صُرِفَتْ أَبْصَارُهُمْ تِلْقَاءَ أَصْحَابِ النَّارِ قَالُوا رَبَّنَا لَا تَجْعَلْنَا مَعَ الْقَوْمِ الظَّالِمِينَ","numberInSurah":47,"juz":8,"manzil":2,"page":156,"ruku":126,"hizbQuarter":63,"sajda":false},{"number":1002,"text":"وَنَادَىٰ أَصْحَابُ الْأَعْرَافِ رِجَالًا يَعْرِفُونَهُمْ بِسِيمَاهُمْ قَالُوا مَا أَغْنَىٰ عَنْكُمْ جَمْعُكُمْ وَمَا كُنْتُمْ تَسْتَكْبِرُونَ","numberInSurah":48,"juz":8,"manzil":2,"page":156,"ruku":127,"hizbQuarter":63,"sajda":false},{"number":1003,"text":"أَهَٰؤُلَاءِ الَّذِينَ أَقْسَمْتُمْ لَا يَنَالُهُمُ اللَّهُ بِرَحْمَةٍ ۚ ادْخُلُوا الْجَنَّةَ لَا خَوْفٌ عَلَيْكُمْ وَلَا أَنْتُمْ تَحْزَنُونَ","numberInSurah":49,"juz":8,"manzil":2,"page":156,"ruku":127,"hizbQuarter":63,"sajda":false},{"number":1004,"text":"وَنَادَىٰ أَصْحَابُ النَّارِ أَصْحَابَ الْجَنَّةِ أَنْ أَفِيضُوا عَلَيْنَا مِنَ الْمَاءِ أَوْ مِمَّا رَزَقَكُمُ اللَّهُ ۚ قَالُوا إِنَّ اللَّهَ حَرَّمَهُمَا عَلَى الْكَافِرِينَ","numberInSurah":50,"juz":8,"manzil":2,"page":156,"ruku":127,"hizbQuarter":63,"sajda":false},{"number":1005,"text":"الَّذِينَ اتَّخَذُوا دِينَهُمْ لَهْوًا وَلَعِبًا وَغَرَّتْهُمُ الْحَيَاةُ الدُّنْيَا ۚ فَالْيَوْمَ نَنْسَاهُمْ كَمَا نَسُوا لِقَاءَ يَوْمِهِمْ هَٰذَا وَمَا كَانُوا بِآيَاتِنَا يَجْحَدُونَ","numberInSurah":51,"juz":8,"manzil":2,"page":156,"ruku":127,"hizbQuarter":63,"sajda":false},{"number":1006,"text":"وَلَقَدْ جِئْنَاهُمْ بِكِتَابٍ فَصَّلْنَاهُ عَلَىٰ عِلْمٍ هُدًى وَرَحْمَةً لِقَوْمٍ يُؤْمِنُونَ","numberInSurah":52,"juz":8,"manzil":2,"page":157,"ruku":127,"hizbQuarter":63,"sajda":false},{"number":1007,"text":"هَلْ يَنْظُرُونَ إِلَّا تَأْوِيلَهُ ۚ يَوْمَ يَأْتِي تَأْوِيلُهُ يَقُولُ الَّذِينَ نَسُوهُ مِنْ قَبْلُ قَدْ جَاءَتْ رُسُلُ رَبِّنَا بِالْحَقِّ فَهَلْ لَنَا مِنْ شُفَعَاءَ فَيَشْفَعُوا لَنَا أَوْ نُرَدُّ فَنَعْمَلَ غَيْرَ الَّذِي كُنَّا نَعْمَلُ ۚ قَدْ خَسِرُوا أَنْفُسَهُمْ وَضَلَّ عَنْهُمْ مَا كَانُوا يَفْتَرُونَ","numberInSurah":53,"juz":8,"manzil":2,"page":157,"ruku":127,"hizbQuarter":63,"sajda":false},{"number":1008,"text":"إِنَّ رَبَّكُمُ اللَّهُ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ فِي سِتَّةِ أَيَّامٍ ثُمَّ اسْتَوَىٰ عَلَى الْعَرْشِ يُغْشِي اللَّيْلَ النَّهَارَ يَطْلُبُهُ حَثِيثًا وَالشَّمْسَ وَالْقَمَرَ وَالنُّجُومَ مُسَخَّرَاتٍ بِأَمْرِهِ ۗ أَلَا لَهُ الْخَلْقُ وَالْأَمْرُ ۗ تَبَارَكَ اللَّهُ رَبُّ الْعَالَمِينَ","numberInSurah":54,"juz":8,"manzil":2,"page":157,"ruku":128,"hizbQuarter":63,"sajda":false},{"number":1009,"text":"ادْعُوا رَبَّكُمْ تَضَرُّعًا وَخُفْيَةً ۚ إِنَّهُ لَا يُحِبُّ الْمُعْتَدِينَ","numberInSurah":55,"juz":8,"manzil":2,"page":157,"ruku":128,"hizbQuarter":63,"sajda":false},{"number":1010,"text":"وَلَا تُفْسِدُوا فِي الْأَرْضِ بَعْدَ إِصْلَاحِهَا وَادْعُوهُ خَوْفًا وَطَمَعًا ۚ إِنَّ رَحْمَتَ اللَّهِ قَرِيبٌ مِنَ الْمُحْسِنِينَ","numberInSurah":56,"juz":8,"manzil":2,"page":157,"ruku":128,"hizbQuarter":63,"sajda":false},{"number":1011,"text":"وَهُوَ الَّذِي يُرْسِلُ الرِّيَاحَ بُشْرًا بَيْنَ يَدَيْ رَحْمَتِهِ ۖ حَتَّىٰ إِذَا أَقَلَّتْ سَحَابًا ثِقَالًا سُقْنَاهُ لِبَلَدٍ مَيِّتٍ فَأَنْزَلْنَا بِهِ الْمَاءَ فَأَخْرَجْنَا بِهِ مِنْ كُلِّ الثَّمَرَاتِ ۚ كَذَٰلِكَ نُخْرِجُ الْمَوْتَىٰ لَعَلَّكُمْ تَذَكَّرُونَ","numberInSurah":57,"juz":8,"manzil":2,"page":157,"ruku":128,"hizbQuarter":63,"sajda":false},{"number":1012,"text":"وَالْبَلَدُ الطَّيِّبُ يَخْرُجُ نَبَاتُهُ بِإِذْنِ رَبِّهِ ۖ وَالَّذِي خَبُثَ لَا يَخْرُجُ إِلَّا نَكِدًا ۚ كَذَٰلِكَ نُصَرِّفُ الْآيَاتِ لِقَوْمٍ يَشْكُرُونَ","numberInSurah":58,"juz":8,"manzil":2,"page":158,"ruku":128,"hizbQuarter":63,"sajda":false},{"number":1013,"text":"لَقَدْ أَرْسَلْنَا نُوحًا إِلَىٰ قَوْمِهِ فَقَالَ يَا قَوْمِ اعْبُدُوا اللَّهَ مَا لَكُمْ مِنْ إِلَٰهٍ غَيْرُهُ إِنِّي أَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيمٍ","numberInSurah":59,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1014,"text":"قَالَ الْمَلَأُ مِنْ قَوْمِهِ إِنَّا لَنَرَاكَ فِي ضَلَالٍ مُبِينٍ","numberInSurah":60,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1015,"text":"قَالَ يَا قَوْمِ لَيْسَ بِي ضَلَالَةٌ وَلَٰكِنِّي رَسُولٌ مِنْ رَبِّ الْعَالَمِينَ","numberInSurah":61,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1016,"text":"أُبَلِّغُكُمْ رِسَالَاتِ رَبِّي وَأَنْصَحُ لَكُمْ وَأَعْلَمُ مِنَ اللَّهِ مَا لَا تَعْلَمُونَ","numberInSurah":62,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1017,"text":"أَوَعَجِبْتُمْ أَنْ جَاءَكُمْ ذِكْرٌ مِنْ رَبِّكُمْ عَلَىٰ رَجُلٍ مِنْكُمْ لِيُنْذِرَكُمْ وَلِتَتَّقُوا وَلَعَلَّكُمْ تُرْحَمُونَ","numberInSurah":63,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1018,"text":"فَكَذَّبُوهُ فَأَنْجَيْنَاهُ وَالَّذِينَ مَعَهُ فِي الْفُلْكِ وَأَغْرَقْنَا الَّذِينَ كَذَّبُوا بِآيَاتِنَا ۚ إِنَّهُمْ كَانُوا قَوْمًا عَمِينَ","numberInSurah":64,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1019,"text":"۞ وَإِلَىٰ عَادٍ أَخَاهُمْ هُودًا ۗ قَالَ يَا قَوْمِ اعْبُدُوا اللَّهَ مَا لَكُمْ مِنْ إِلَٰهٍ غَيْرُهُ ۚ أَفَلَا تَتَّقُونَ","numberInSurah":65,"juz":8,"manzil":2,"page":158,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1020,"text":"قَالَ الْمَلَأُ الَّذِينَ كَفَرُوا مِنْ قَوْمِهِ إِنَّا لَنَرَاكَ فِي سَفَاهَةٍ وَإِنَّا لَنَظُنُّكَ مِنَ الْكَاذِبِينَ","numberInSurah":66,"juz":8,"manzil":2,"page":158,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1021,"text":"قَالَ يَا قَوْمِ لَيْسَ بِي سَفَاهَةٌ وَلَٰكِنِّي رَسُولٌ مِنْ رَبِّ الْعَالَمِينَ","numberInSurah":67,"juz":8,"manzil":2,"page":158,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1022,"text":"أُبَلِّغُكُمْ رِسَالَاتِ رَبِّي وَأَنَا لَكُمْ نَاصِحٌ أَمِينٌ","numberInSurah":68,"juz":8,"manzil":2,"page":159,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1023,"text":"أَوَعَجِبْتُمْ أَنْ جَاءَكُمْ ذِكْرٌ مِنْ رَبِّكُمْ عَلَىٰ رَجُلٍ مِنْكُمْ لِيُنْذِرَكُمْ ۚ وَاذْكُرُوا إِذْ جَعَلَكُمْ خُلَفَاءَ مِنْ بَعْدِ قَوْمِ نُوحٍ وَزَادَكُمْ فِي الْخَلْقِ بَسْطَةً ۖ فَاذْكُرُوا آلَاءَ اللَّهِ لَعَلَّكُمْ تُفْلِحُونَ","numberInSurah":69,"juz":8,"manzil":2,"page":159,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1024,"text":"قَالُوا أَجِئْتَنَا لِنَعْبُدَ اللَّهَ وَحْدَهُ وَنَذَرَ مَا كَانَ يَعْبُدُ آبَاؤُنَا ۖ فَأْتِنَا بِمَا تَعِدُنَا إِنْ كُنْتَ مِنَ الصَّادِقِينَ","numberInSurah":70,"juz":8,"manzil":2,"page":159,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1025,"text":"قَالَ قَدْ وَقَعَ عَلَيْكُمْ مِنْ رَبِّكُمْ رِجْسٌ وَغَضَبٌ ۖ أَتُجَادِلُونَنِي فِي أَسْمَاءٍ سَمَّيْتُمُوهَا أَنْتُمْ وَآبَاؤُكُمْ مَا نَزَّلَ اللَّهُ بِهَا مِنْ سُلْطَانٍ ۚ فَانْتَظِرُوا إِنِّي مَعَكُمْ مِنَ الْمُنْتَظِرِينَ","numberInSurah":71,"juz":8,"manzil":2,"page":159,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1026,"text":"فَأَنْجَيْنَاهُ وَالَّذِينَ مَعَهُ بِرَحْمَةٍ مِنَّا وَقَطَعْنَا دَابِرَ الَّذِينَ كَذَّبُوا بِآيَاتِنَا ۖ وَمَا كَانُوا مُؤْمِنِينَ","numberInSurah":72,"juz":8,"manzil":2,"page":159,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1027,"text":"وَإِلَىٰ ثَمُودَ أَخَاهُمْ صَالِحًا ۗ قَالَ يَا قَوْمِ اعْبُدُوا اللَّهَ مَا لَكُمْ مِنْ إِلَٰهٍ غَيْرُهُ ۖ قَدْ جَاءَتْكُمْ بَيِّنَةٌ مِنْ رَبِّكُمْ ۖ هَٰذِهِ نَاقَةُ اللَّهِ لَكُمْ آيَةً ۖ فَذَرُوهَا تَأْكُلْ فِي أَرْضِ اللَّهِ ۖ وَلَا تَمَسُّوهَا بِسُوءٍ فَيَأْخُذَكُمْ عَذَابٌ أَلِيمٌ","numberInSurah":73,"juz":8,"manzil":2,"page":159,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1028,"text":"وَاذْكُرُوا إِذْ جَعَلَكُمْ خُلَفَاءَ مِنْ بَعْدِ عَادٍ وَبَوَّأَكُمْ فِي الْأَرْضِ تَتَّخِذُونَ مِنْ سُهُولِهَا قُصُورًا وَتَنْحِتُونَ الْجِبَالَ بُيُوتًا ۖ فَاذْكُرُوا آلَاءَ اللَّهِ وَلَا تَعْثَوْا فِي الْأَرْضِ مُفْسِدِينَ","numberInSurah":74,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1029,"text":"قَالَ الْمَلَأُ الَّذِينَ اسْتَكْبَرُوا مِنْ قَوْمِهِ لِلَّذِينَ اسْتُضْعِفُوا لِمَنْ آمَنَ مِنْهُمْ أَتَعْلَمُونَ أَنَّ صَالِحًا مُرْسَلٌ مِنْ رَبِّهِ ۚ قَالُوا إِنَّا بِمَا أُرْسِلَ بِهِ مُؤْمِنُونَ","numberInSurah":75,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1030,"text":"قَالَ الَّذِينَ اسْتَكْبَرُوا إِنَّا بِالَّذِي آمَنْتُمْ بِهِ كَافِرُونَ","numberInSurah":76,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1031,"text":"فَعَقَرُوا النَّاقَةَ وَعَتَوْا عَنْ أَمْرِ رَبِّهِمْ وَقَالُوا يَا صَالِحُ ائْتِنَا بِمَا تَعِدُنَا إِنْ كُنْتَ مِنَ الْمُرْسَلِينَ","numberInSurah":77,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1032,"text":"فَأَخَذَتْهُمُ الرَّجْفَةُ فَأَصْبَحُوا فِي دَارِهِمْ جَاثِمِينَ","numberInSurah":78,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1033,"text":"فَتَوَلَّىٰ عَنْهُمْ وَقَالَ يَا قَوْمِ لَقَدْ أَبْلَغْتُكُمْ رِسَالَةَ رَبِّي وَنَصَحْتُ لَكُمْ وَلَٰكِنْ لَا تُحِبُّونَ النَّاصِحِينَ","numberInSurah":79,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1034,"text":"وَلُوطًا إِذْ قَالَ لِقَوْمِهِ أَتَأْتُونَ الْفَاحِشَةَ مَا سَبَقَكُمْ بِهَا مِنْ أَحَدٍ مِنَ الْعَالَمِينَ","numberInSurah":80,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1035,"text":"إِنَّكُمْ لَتَأْتُونَ الرِّجَالَ شَهْوَةً مِنْ دُونِ النِّسَاءِ ۚ بَلْ أَنْتُمْ قَوْمٌ مُسْرِفُونَ","numberInSurah":81,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1036,"text":"وَمَا كَانَ جَوَابَ قَوْمِهِ إِلَّا أَنْ قَالُوا أَخْرِجُوهُمْ مِنْ قَرْيَتِكُمْ ۖ إِنَّهُمْ أُنَاسٌ يَتَطَهَّرُونَ","numberInSurah":82,"juz":8,"manzil":2,"page":161,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1037,"text":"فَأَنْجَيْنَاهُ وَأَهْلَهُ إِلَّا امْرَأَتَهُ كَانَتْ مِنَ الْغَابِرِينَ","numberInSurah":83,"juz":8,"manzil":2,"page":161,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1038,"text":"وَأَمْطَرْنَا عَلَيْهِمْ مَطَرًا ۖ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُجْرِمِينَ","numberInSurah":84,"juz":8,"manzil":2,"page":161,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1039,"text":"وَإِلَىٰ مَدْيَنَ أَخَاهُمْ شُعَيْبًا ۗ قَالَ يَا قَوْمِ اعْبُدُوا اللَّهَ مَا لَكُمْ مِنْ إِلَٰهٍ غَيْرُهُ ۖ قَدْ جَاءَتْكُمْ بَيِّنَةٌ مِنْ رَبِّكُمْ ۖ فَأَوْفُوا الْكَيْلَ وَالْمِيزَانَ وَلَا تَبْخَسُوا النَّاسَ أَشْيَاءَهُمْ وَلَا تُفْسِدُوا فِي الْأَرْضِ بَعْدَ إِصْلَاحِهَا ۚ ذَٰلِكُمْ خَيْرٌ لَكُمْ إِنْ كُنْتُمْ مُؤْمِنِينَ","numberInSurah":85,"juz":8,"manzil":2,"page":161,"ruku":132,"hizbQuarter":64,"sajda":false},{"number":1040,"text":"وَلَا تَقْعُدُوا بِكُلِّ صِرَاطٍ تُوعِدُونَ وَتَصُدُّونَ عَنْ سَبِيلِ اللَّهِ مَنْ آمَنَ بِهِ وَتَبْغُونَهَا عِوَجًا ۚ وَاذْكُرُوا إِذْ كُنْتُمْ قَلِيلًا فَكَثَّرَكُمْ ۖ وَانْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الْمُفْسِدِينَ","numberInSurah":86,"juz":8,"manzil":2,"page":161,"ruku":132,"hizbQuarter":64,"sajda":false},{"number":1041,"text":"وَإِنْ كَانَ طَائِفَةٌ مِنْكُمْ آمَنُوا بِالَّذِي أُرْسِلْتُ بِهِ وَطَائِفَةٌ لَمْ يُؤْمِنُوا فَاصْبِرُوا حَتَّىٰ يَحْكُمَ اللَّهُ بَيْنَنَا ۚ وَهُوَ خَيْرُ الْحَاكِمِينَ","numberInSurah":87,"juz":8,"manzil":2,"page":161,"ruku":132,"hizbQuarter":64,"sajda":false},{"number":1042,"text":"۞ قَالَ الْمَلَأُ الَّذِينَ اسْتَكْبَرُوا مِنْ قَوْمِهِ لَنُخْرِجَنَّكَ يَا شُعَيْبُ وَالَّذِينَ آمَنُوا مَعَكَ مِنْ قَرْيَتِنَا أَوْ لَتَعُودُنَّ فِي مِلَّتِنَا ۚ قَالَ أَوَلَوْ كُنَّا كَارِهِينَ","numberInSurah":88,"juz":9,"manzil":2,"page":162,"ruku":132,"hizbQuarter":65,"sajda":false},{"number":1043,"text":"قَدِ افْتَرَيْنَا عَلَى اللَّهِ كَذِبًا إِنْ عُدْنَا فِي مِلَّتِكُمْ بَعْدَ إِذْ نَجَّانَا اللَّهُ مِنْهَا ۚ وَمَا يَكُونُ لَنَا أَنْ نَعُودَ فِيهَا إِلَّا أَنْ يَشَاءَ اللَّهُ رَبُّنَا ۚ وَسِعَ رَبُّنَا كُلَّ شَيْءٍ عِلْمًا ۚ عَلَى اللَّهِ تَوَكَّلْنَا ۚ رَبَّنَا افْتَحْ بَيْنَنَا وَبَيْنَ قَوْمِنَا بِالْحَقِّ وَأَنْتَ خَيْرُ الْفَاتِحِينَ","numberInSurah":89,"juz":9,"manzil":2,"page":162,"ruku":132,"hizbQuarter":65,"sajda":false},{"number":1044,"text":"وَقَالَ الْمَلَأُ الَّذِينَ كَفَرُوا مِنْ قَوْمِهِ لَئِنِ اتَّبَعْتُمْ شُعَيْبًا إِنَّكُمْ إِذًا لَخَاسِرُونَ","numberInSurah":90,"juz":9,"manzil":2,"page":162,"ruku":132,"hizbQuarter":65,"sajda":false},{"number":1045,"text":"فَأَخَذَتْهُمُ الرَّجْفَةُ فَأَصْبَحُوا فِي دَارِهِمْ جَاثِمِينَ","numberInSurah":91,"juz":9,"manzil":2,"page":162,"ruku":132,"hizbQuarter":65,"sajda":false},{"number":1046,"text":"الَّذِينَ كَذَّبُوا شُعَيْبًا كَأَنْ لَمْ يَغْنَوْا فِيهَا ۚ الَّذِينَ كَذَّبُوا شُعَيْبًا كَانُوا هُمُ الْخَاسِرِينَ","numberInSurah":92,"juz":9,"manzil":2,"page":162,"ruku":132,"hizbQuarter":65,"sajda":false},{"number":1047,"text":"فَتَوَلَّىٰ عَنْهُمْ وَقَالَ يَا قَوْمِ لَقَدْ أَبْلَغْتُكُمْ رِسَالَاتِ رَبِّي وَنَصَحْتُ لَكُمْ ۖ فَكَيْفَ آسَىٰ عَلَىٰ قَوْمٍ كَافِرِينَ","numberInSurah":93,"juz":9,"manzil":2,"page":162,"ruku":132,"hizbQuarter":65,"sajda":false},{"number":1048,"text":"وَمَا أَرْسَلْنَا فِي قَرْيَةٍ مِنْ نَبِيٍّ إِلَّا أَخَذْنَا أَهْلَهَا بِالْبَأْسَاءِ وَالضَّرَّاءِ لَعَلَّهُمْ يَضَّرَّعُونَ","numberInSurah":94,"juz":9,"manzil":2,"page":162,"ruku":133,"hizbQuarter":65,"sajda":false},{"number":1049,"text":"ثُمَّ بَدَّلْنَا مَكَانَ السَّيِّئَةِ الْحَسَنَةَ حَتَّىٰ عَفَوْا وَقَالُوا قَدْ مَسَّ آبَاءَنَا الضَّرَّاءُ وَالسَّرَّاءُ فَأَخَذْنَاهُمْ بَغْتَةً وَهُمْ لَا يَشْعُرُونَ","numberInSurah":95,"juz":9,"manzil":2,"page":162,"ruku":133,"hizbQuarter":65,"sajda":false},{"number":1050,"text":"وَلَوْ أَنَّ أَهْلَ الْقُرَىٰ آمَنُوا وَاتَّقَوْا لَفَتَحْنَا عَلَيْهِمْ بَرَكَاتٍ مِنَ السَّمَاءِ وَالْأَرْضِ وَلَٰكِنْ كَذَّبُوا فَأَخَذْنَاهُمْ بِمَا كَانُوا يَكْسِبُونَ","numberInSurah":96,"juz":9,"manzil":2,"page":163,"ruku":133,"hizbQuarter":65,"sajda":false},{"number":1051,"text":"أَفَأَمِنَ أَهْلُ الْقُرَىٰ أَنْ يَأْتِيَهُمْ بَأْسُنَا بَيَاتًا وَهُمْ نَائِمُونَ","numberInSurah":97,"juz":9,"manzil":2,"page":163,"ruku":133,"hizbQuarter":65,"sajda":false},{"number":1052,"text":"أَوَأَمِنَ أَهْلُ الْقُرَىٰ أَنْ يَأْتِيَهُمْ بَأْسُنَا ضُحًى وَهُمْ يَلْعَبُونَ","numberInSurah":98,"juz":9,"manzil":2,"page":163,"ruku":133,"hizbQuarter":65,"sajda":false},{"number":1053,"text":"أَفَأَمِنُوا مَكْرَ اللَّهِ ۚ فَلَا يَأْمَنُ مَكْرَ اللَّهِ إِلَّا الْقَوْمُ الْخَاسِرُونَ","numberInSurah":99,"juz":9,"manzil":2,"page":163,"ruku":133,"hizbQuarter":65,"sajda":false},{"number":1054,"text":"أَوَلَمْ يَهْدِ لِلَّذِينَ يَرِثُونَ الْأَرْضَ مِنْ بَعْدِ أَهْلِهَا أَنْ لَوْ نَشَاءُ أَصَبْنَاهُمْ بِذُنُوبِهِمْ ۚ وَنَطْبَعُ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَسْمَعُونَ","numberInSurah":100,"juz":9,"manzil":2,"page":163,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1055,"text":"تِلْكَ الْقُرَىٰ نَقُصُّ عَلَيْكَ مِنْ أَنْبَائِهَا ۚ وَلَقَدْ جَاءَتْهُمْ رُسُلُهُمْ بِالْبَيِّنَاتِ فَمَا كَانُوا لِيُؤْمِنُوا بِمَا كَذَّبُوا مِنْ قَبْلُ ۚ كَذَٰلِكَ يَطْبَعُ اللَّهُ عَلَىٰ قُلُوبِ الْكَافِرِينَ","numberInSurah":101,"juz":9,"manzil":2,"page":163,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1056,"text":"وَمَا وَجَدْنَا لِأَكْثَرِهِمْ مِنْ عَهْدٍ ۖ وَإِنْ وَجَدْنَا أَكْثَرَهُمْ لَفَاسِقِينَ","numberInSurah":102,"juz":9,"manzil":2,"page":163,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1057,"text":"ثُمَّ بَعَثْنَا مِنْ بَعْدِهِمْ مُوسَىٰ بِآيَاتِنَا إِلَىٰ فِرْعَوْنَ وَمَلَئِهِ فَظَلَمُوا بِهَا ۖ فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُفْسِدِينَ","numberInSurah":103,"juz":9,"manzil":2,"page":163,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1058,"text":"وَقَالَ مُوسَىٰ يَا فِرْعَوْنُ إِنِّي رَسُولٌ مِنْ رَبِّ الْعَالَمِينَ","numberInSurah":104,"juz":9,"manzil":2,"page":163,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1059,"text":"حَقِيقٌ عَلَىٰ أَنْ لَا أَقُولَ عَلَى اللَّهِ إِلَّا الْحَقَّ ۚ قَدْ جِئْتُكُمْ بِبَيِّنَةٍ مِنْ رَبِّكُمْ فَأَرْسِلْ مَعِيَ بَنِي إِسْرَائِيلَ","numberInSurah":105,"juz":9,"manzil":2,"page":164,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1060,"text":"قَالَ إِنْ كُنْتَ جِئْتَ بِآيَةٍ فَأْتِ بِهَا إِنْ كُنْتَ مِنَ الصَّادِقِينَ","numberInSurah":106,"juz":9,"manzil":2,"page":164,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1061,"text":"فَأَلْقَىٰ عَصَاهُ فَإِذَا هِيَ ثُعْبَانٌ مُبِينٌ","numberInSurah":107,"juz":9,"manzil":2,"page":164,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1062,"text":"وَنَزَعَ يَدَهُ فَإِذَا هِيَ بَيْضَاءُ لِلنَّاظِرِينَ","numberInSurah":108,"juz":9,"manzil":2,"page":164,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1063,"text":"قَالَ الْمَلَأُ مِنْ قَوْمِ فِرْعَوْنَ إِنَّ هَٰذَا لَسَاحِرٌ عَلِيمٌ","numberInSurah":109,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1064,"text":"يُرِيدُ أَنْ يُخْرِجَكُمْ مِنْ أَرْضِكُمْ ۖ فَمَاذَا تَأْمُرُونَ","numberInSurah":110,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1065,"text":"قَالُوا أَرْجِهْ وَأَخَاهُ وَأَرْسِلْ فِي الْمَدَائِنِ حَاشِرِينَ","numberInSurah":111,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1066,"text":"يَأْتُوكَ بِكُلِّ سَاحِرٍ عَلِيمٍ","numberInSurah":112,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1067,"text":"وَجَاءَ السَّحَرَةُ فِرْعَوْنَ قَالُوا إِنَّ لَنَا لَأَجْرًا إِنْ كُنَّا نَحْنُ الْغَالِبِينَ","numberInSurah":113,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1068,"text":"قَالَ نَعَمْ وَإِنَّكُمْ لَمِنَ الْمُقَرَّبِينَ","numberInSurah":114,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1069,"text":"قَالُوا يَا مُوسَىٰ إِمَّا أَنْ تُلْقِيَ وَإِمَّا أَنْ نَكُونَ نَحْنُ الْمُلْقِينَ","numberInSurah":115,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1070,"text":"قَالَ أَلْقُوا ۖ فَلَمَّا أَلْقَوْا سَحَرُوا أَعْيُنَ النَّاسِ وَاسْتَرْهَبُوهُمْ وَجَاءُوا بِسِحْرٍ عَظِيمٍ","numberInSurah":116,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1071,"text":"۞ وَأَوْحَيْنَا إِلَىٰ مُوسَىٰ أَنْ أَلْقِ عَصَاكَ ۖ فَإِذَا هِيَ تَلْقَفُ مَا يَأْفِكُونَ","numberInSurah":117,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1072,"text":"فَوَقَعَ الْحَقُّ وَبَطَلَ مَا كَانُوا يَعْمَلُونَ","numberInSurah":118,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1073,"text":"فَغُلِبُوا هُنَالِكَ وَانْقَلَبُوا صَاغِرِينَ","numberInSurah":119,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1074,"text":"وَأُلْقِيَ السَّحَرَةُ سَاجِدِينَ","numberInSurah":120,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1075,"text":"قَالُوا آمَنَّا بِرَبِّ الْعَالَمِينَ","numberInSurah":121,"juz":9,"manzil":2,"page":165,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1076,"text":"رَبِّ مُوسَىٰ وَهَارُونَ","numberInSurah":122,"juz":9,"manzil":2,"page":165,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1077,"text":"قَالَ فِرْعَوْنُ آمَنْتُمْ بِهِ قَبْلَ أَنْ آذَنَ لَكُمْ ۖ إِنَّ هَٰذَا لَمَكْرٌ مَكَرْتُمُوهُ فِي الْمَدِينَةِ لِتُخْرِجُوا مِنْهَا أَهْلَهَا ۖ فَسَوْفَ تَعْلَمُونَ","numberInSurah":123,"juz":9,"manzil":2,"page":165,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1078,"text":"لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُمْ مِنْ خِلَافٍ ثُمَّ لَأُصَلِّبَنَّكُمْ أَجْمَعِينَ","numberInSurah":124,"juz":9,"manzil":2,"page":165,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1079,"text":"قَالُوا إِنَّا إِلَىٰ رَبِّنَا مُنْقَلِبُونَ","numberInSurah":125,"juz":9,"manzil":2,"page":165,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1080,"text":"وَمَا تَنْقِمُ مِنَّا إِلَّا أَنْ آمَنَّا بِآيَاتِ رَبِّنَا لَمَّا جَاءَتْنَا ۚ رَبَّنَا أَفْرِغْ عَلَيْنَا صَبْرًا وَتَوَفَّنَا مُسْلِمِينَ","numberInSurah":126,"juz":9,"manzil":2,"page":165,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1081,"text":"وَقَالَ الْمَلَأُ مِنْ قَوْمِ فِرْعَوْنَ أَتَذَرُ مُوسَىٰ وَقَوْمَهُ لِيُفْسِدُوا فِي الْأَرْضِ وَيَذَرَكَ وَآلِهَتَكَ ۚ قَالَ سَنُقَتِّلُ أَبْنَاءَهُمْ وَنَسْتَحْيِي نِسَاءَهُمْ وَإِنَّا فَوْقَهُمْ قَاهِرُونَ","numberInSurah":127,"juz":9,"manzil":2,"page":165,"ruku":136,"hizbQuarter":66,"sajda":false},{"number":1082,"text":"قَالَ مُوسَىٰ لِقَوْمِهِ اسْتَعِينُوا بِاللَّهِ وَاصْبِرُوا ۖ إِنَّ الْأَرْضَ لِلَّهِ يُورِثُهَا مَنْ يَشَاءُ مِنْ عِبَادِهِ ۖ وَالْعَاقِبَةُ لِلْمُتَّقِينَ","numberInSurah":128,"juz":9,"manzil":2,"page":165,"ruku":136,"hizbQuarter":66,"sajda":false},{"number":1083,"text":"قَالُوا أُوذِينَا مِنْ قَبْلِ أَنْ تَأْتِيَنَا وَمِنْ بَعْدِ مَا جِئْتَنَا ۚ قَالَ عَسَىٰ رَبُّكُمْ أَنْ يُهْلِكَ عَدُوَّكُمْ وَيَسْتَخْلِفَكُمْ فِي الْأَرْضِ فَيَنْظُرَ كَيْفَ تَعْمَلُونَ","numberInSurah":129,"juz":9,"manzil":2,"page":165,"ruku":136,"hizbQuarter":66,"sajda":false},{"number":1084,"text":"وَلَقَدْ أَخَذْنَا آلَ فِرْعَوْنَ بِالسِّنِينَ وَنَقْصٍ مِنَ الثَّمَرَاتِ لَعَلَّهُمْ يَذَّكَّرُونَ","numberInSurah":130,"juz":9,"manzil":2,"page":165,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1085,"text":"فَإِذَا جَاءَتْهُمُ الْحَسَنَةُ قَالُوا لَنَا هَٰذِهِ ۖ وَإِنْ تُصِبْهُمْ سَيِّئَةٌ يَطَّيَّرُوا بِمُوسَىٰ وَمَنْ مَعَهُ ۗ أَلَا إِنَّمَا طَائِرُهُمْ عِنْدَ اللَّهِ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ","numberInSurah":131,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1086,"text":"وَقَالُوا مَهْمَا تَأْتِنَا بِهِ مِنْ آيَةٍ لِتَسْحَرَنَا بِهَا فَمَا نَحْنُ لَكَ بِمُؤْمِنِينَ","numberInSurah":132,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1087,"text":"فَأَرْسَلْنَا عَلَيْهِمُ الطُّوفَانَ وَالْجَرَادَ وَالْقُمَّلَ وَالضَّفَادِعَ وَالدَّمَ آيَاتٍ مُفَصَّلَاتٍ فَاسْتَكْبَرُوا وَكَانُوا قَوْمًا مُجْرِمِينَ","numberInSurah":133,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1088,"text":"وَلَمَّا وَقَعَ عَلَيْهِمُ الرِّجْزُ قَالُوا يَا مُوسَى ادْعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِنْدَكَ ۖ لَئِنْ كَشَفْتَ عَنَّا الرِّجْزَ لَنُؤْمِنَنَّ لَكَ وَلَنُرْسِلَنَّ مَعَكَ بَنِي إِسْرَائِيلَ","numberInSurah":134,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1089,"text":"فَلَمَّا كَشَفْنَا عَنْهُمُ الرِّجْزَ إِلَىٰ أَجَلٍ هُمْ بَالِغُوهُ إِذَا هُمْ يَنْكُثُونَ","numberInSurah":135,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1090,"text":"فَانْتَقَمْنَا مِنْهُمْ فَأَغْرَقْنَاهُمْ فِي الْيَمِّ بِأَنَّهُمْ كَذَّبُوا بِآيَاتِنَا وَكَانُوا عَنْهَا غَافِلِينَ","numberInSurah":136,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1091,"text":"وَأَوْرَثْنَا الْقَوْمَ الَّذِينَ كَانُوا يُسْتَضْعَفُونَ مَشَارِقَ الْأَرْضِ وَمَغَارِبَهَا الَّتِي بَارَكْنَا فِيهَا ۖ وَتَمَّتْ كَلِمَتُ رَبِّكَ الْحُسْنَىٰ عَلَىٰ بَنِي إِسْرَائِيلَ بِمَا صَبَرُوا ۖ وَدَمَّرْنَا مَا كَانَ يَصْنَعُ فِرْعَوْنُ وَقَوْمُهُ وَمَا كَانُوا يَعْرِشُونَ","numberInSurah":137,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1092,"text":"وَجَاوَزْنَا بِبَنِي إِسْرَائِيلَ الْبَحْرَ فَأَتَوْا عَلَىٰ قَوْمٍ يَعْكُفُونَ عَلَىٰ أَصْنَامٍ لَهُمْ ۚ قَالُوا يَا مُوسَى اجْعَلْ لَنَا إِلَٰهًا كَمَا لَهُمْ آلِهَةٌ ۚ قَالَ إِنَّكُمْ قَوْمٌ تَجْهَلُونَ","numberInSurah":138,"juz":9,"manzil":2,"page":167,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1093,"text":"إِنَّ هَٰؤُلَاءِ مُتَبَّرٌ مَا هُمْ فِيهِ وَبَاطِلٌ مَا كَانُوا يَعْمَلُونَ","numberInSurah":139,"juz":9,"manzil":2,"page":167,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1094,"text":"قَالَ أَغَيْرَ اللَّهِ أَبْغِيكُمْ إِلَٰهًا وَهُوَ فَضَّلَكُمْ عَلَى الْعَالَمِينَ","numberInSurah":140,"juz":9,"manzil":2,"page":167,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1095,"text":"وَإِذْ أَنْجَيْنَاكُمْ مِنْ آلِ فِرْعَوْنَ يَسُومُونَكُمْ سُوءَ الْعَذَابِ ۖ يُقَتِّلُونَ أَبْنَاءَكُمْ وَيَسْتَحْيُونَ نِسَاءَكُمْ ۚ وَفِي ذَٰلِكُمْ بَلَاءٌ مِنْ رَبِّكُمْ عَظِيمٌ","numberInSurah":141,"juz":9,"manzil":2,"page":167,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1096,"text":"۞ وَوَاعَدْنَا مُوسَىٰ ثَلَاثِينَ لَيْلَةً وَأَتْمَمْنَاهَا بِعَشْرٍ فَتَمَّ مِيقَاتُ رَبِّهِ أَرْبَعِينَ لَيْلَةً ۚ وَقَالَ مُوسَىٰ لِأَخِيهِ هَارُونَ اخْلُفْنِي فِي قَوْمِي وَأَصْلِحْ وَلَا تَتَّبِعْ سَبِيلَ الْمُفْسِدِينَ","numberInSurah":142,"juz":9,"manzil":2,"page":167,"ruku":138,"hizbQuarter":67,"sajda":false},{"number":1097,"text":"وَلَمَّا جَاءَ مُوسَىٰ لِمِيقَاتِنَا وَكَلَّمَهُ رَبُّهُ قَالَ رَبِّ أَرِنِي أَنْظُرْ إِلَيْكَ ۚ قَالَ لَنْ تَرَانِي وَلَٰكِنِ انْظُرْ إِلَى الْجَبَلِ فَإِنِ اسْتَقَرَّ مَكَانَهُ فَسَوْفَ تَرَانِي ۚ فَلَمَّا تَجَلَّىٰ رَبُّهُ لِلْجَبَلِ جَعَلَهُ دَكًّا وَخَرَّ مُوسَىٰ صَعِقًا ۚ فَلَمَّا أَفَاقَ قَالَ سُبْحَانَكَ تُبْتُ إِلَيْكَ وَأَنَا أَوَّلُ الْمُؤْمِنِينَ","numberInSurah":143,"juz":9,"manzil":2,"page":167,"ruku":138,"hizbQuarter":67,"sajda":false},{"number":1098,"text":"قَالَ يَا مُوسَىٰ إِنِّي اصْطَفَيْتُكَ عَلَى النَّاسِ بِرِسَالَاتِي وَبِكَلَامِي فَخُذْ مَا آتَيْتُكَ وَكُنْ مِنَ الشَّاكِرِينَ","numberInSurah":144,"juz":9,"manzil":2,"page":168,"ruku":138,"hizbQuarter":67,"sajda":false},{"number":1099,"text":"وَكَتَبْنَا لَهُ فِي الْأَلْوَاحِ مِنْ كُلِّ شَيْءٍ مَوْعِظَةً وَتَفْصِيلًا لِكُلِّ شَيْءٍ فَخُذْهَا بِقُوَّةٍ وَأْمُرْ قَوْمَكَ يَأْخُذُوا بِأَحْسَنِهَا ۚ سَأُرِيكُمْ دَارَ الْفَاسِقِينَ","numberInSurah":145,"juz":9,"manzil":2,"page":168,"ruku":138,"hizbQuarter":67,"sajda":false},{"number":1100,"text":"سَأَصْرِفُ عَنْ آيَاتِيَ الَّذِينَ يَتَكَبَّرُونَ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ وَإِنْ يَرَوْا كُلَّ آيَةٍ لَا يُؤْمِنُوا بِهَا وَإِنْ يَرَوْا سَبِيلَ الرُّشْدِ لَا يَتَّخِذُوهُ سَبِيلًا وَإِنْ يَرَوْا سَبِيلَ الْغَيِّ يَتَّخِذُوهُ سَبِيلًا ۚ ذَٰلِكَ بِأَنَّهُمْ كَذَّبُوا بِآيَاتِنَا وَكَانُوا عَنْهَا غَافِلِينَ","numberInSurah":146,"juz":9,"manzil":2,"page":168,"ruku":138,"hizbQuarter":67,"sajda":false},{"number":1101,"text":"وَالَّذِينَ كَذَّبُوا بِآيَاتِنَا وَلِقَاءِ الْآخِرَةِ حَبِطَتْ أَعْمَالُهُمْ ۚ هَلْ يُجْزَوْنَ إِلَّا مَا كَانُوا يَعْمَلُونَ","numberInSurah":147,"juz":9,"manzil":2,"page":168,"ruku":138,"hizbQuarter":67,"sajda":false},{"number":1102,"text":"وَاتَّخَذَ قَوْمُ مُوسَىٰ مِنْ بَعْدِهِ مِنْ حُلِيِّهِمْ عِجْلًا جَسَدًا لَهُ خُوَارٌ ۚ أَلَمْ يَرَوْا أَنَّهُ لَا يُكَلِّمُهُمْ وَلَا يَهْدِيهِمْ سَبِيلًا ۘ اتَّخَذُوهُ وَكَانُوا ظَالِمِينَ","numberInSurah":148,"juz":9,"manzil":2,"page":168,"ruku":139,"hizbQuarter":67,"sajda":false},{"number":1103,"text":"وَلَمَّا سُقِطَ فِي أَيْدِيهِمْ وَرَأَوْا أَنَّهُمْ قَدْ ضَلُّوا قَالُوا لَئِنْ لَمْ يَرْحَمْنَا رَبُّنَا وَيَغْفِرْ لَنَا لَنَكُونَنَّ مِنَ الْخَاسِرِينَ","numberInSurah":149,"juz":9,"manzil":2,"page":168,"ruku":139,"hizbQuarter":67,"sajda":false},{"number":1104,"text":"وَلَمَّا رَجَعَ مُوسَىٰ إِلَىٰ قَوْمِهِ غَضْبَانَ أَسِفًا قَالَ بِئْسَمَا خَلَفْتُمُونِي مِنْ بَعْدِي ۖ أَعَجِلْتُمْ أَمْرَ رَبِّكُمْ ۖ وَأَلْقَى الْأَلْوَاحَ وَأَخَذَ بِرَأْسِ أَخِيهِ يَجُرُّهُ إِلَيْهِ ۚ قَالَ ابْنَ أُمَّ إِنَّ الْقَوْمَ اسْتَضْعَفُونِي وَكَادُوا يَقْتُلُونَنِي فَلَا تُشْمِتْ بِيَ الْأَعْدَاءَ وَلَا تَجْعَلْنِي مَعَ الْقَوْمِ الظَّالِمِينَ","numberInSurah":150,"juz":9,"manzil":2,"page":169,"ruku":139,"hizbQuarter":67,"sajda":false},{"number":1105,"text":"قَالَ رَبِّ اغْفِرْ لِي وَلِأَخِي وَأَدْخِلْنَا فِي رَحْمَتِكَ ۖ وَأَنْتَ أَرْحَمُ الرَّاحِمِينَ","numberInSurah":151,"juz":9,"manzil":2,"page":169,"ruku":139,"hizbQuarter":67,"sajda":false},{"number":1106,"text":"إِنَّ الَّذِينَ اتَّخَذُوا الْعِجْلَ سَيَنَالُهُمْ غَضَبٌ مِنْ رَبِّهِمْ وَذِلَّةٌ فِي الْحَيَاةِ الدُّنْيَا ۚ وَكَذَٰلِكَ نَجْزِي الْمُفْتَرِينَ","numberInSurah":152,"juz":9,"manzil":2,"page":169,"ruku":140,"hizbQuarter":67,"sajda":false},{"number":1107,"text":"وَالَّذِينَ عَمِلُوا السَّيِّئَاتِ ثُمَّ تَابُوا مِنْ بَعْدِهَا وَآمَنُوا إِنَّ رَبَّكَ مِنْ بَعْدِهَا لَغَفُورٌ رَحِيمٌ","numberInSurah":153,"juz":9,"manzil":2,"page":169,"ruku":140,"hizbQuarter":67,"sajda":false},{"number":1108,"text":"وَلَمَّا سَكَتَ عَنْ مُوسَى الْغَضَبُ أَخَذَ الْأَلْوَاحَ ۖ وَفِي نُسْخَتِهَا هُدًى وَرَحْمَةٌ لِلَّذِينَ هُمْ لِرَبِّهِمْ يَرْهَبُونَ","numberInSurah":154,"juz":9,"manzil":2,"page":169,"ruku":140,"hizbQuarter":67,"sajda":false},{"number":1109,"text":"وَاخْتَارَ مُوسَىٰ قَوْمَهُ سَبْعِينَ رَجُلًا لِمِيقَاتِنَا ۖ فَلَمَّا أَخَذَتْهُمُ الرَّجْفَةُ قَالَ رَبِّ لَوْ شِئْتَ أَهْلَكْتَهُمْ مِنْ قَبْلُ وَإِيَّايَ ۖ أَتُهْلِكُنَا بِمَا فَعَلَ السُّفَهَاءُ مِنَّا ۖ إِنْ هِيَ إِلَّا فِتْنَتُكَ تُضِلُّ بِهَا مَنْ تَشَاءُ وَتَهْدِي مَنْ تَشَاءُ ۖ أَنْتَ وَلِيُّنَا فَاغْفِرْ لَنَا وَارْحَمْنَا ۖ وَأَنْتَ خَيْرُ الْغَافِرِينَ","numberInSurah":155,"juz":9,"manzil":2,"page":169,"ruku":140,"hizbQuarter":67,"sajda":false},{"number":1110,"text":"۞ وَاكْتُبْ لَنَا فِي هَٰذِهِ الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ إِنَّا هُدْنَا إِلَيْكَ ۚ قَالَ عَذَابِي أُصِيبُ بِهِ مَنْ أَشَاءُ ۖ وَرَحْمَتِي وَسِعَتْ كُلَّ شَيْءٍ ۚ فَسَأَكْتُبُهَا لِلَّذِينَ يَتَّقُونَ وَيُؤْتُونَ الزَّكَاةَ وَالَّذِينَ هُمْ بِآيَاتِنَا يُؤْمِنُونَ","numberInSurah":156,"juz":9,"manzil":2,"page":170,"ruku":140,"hizbQuarter":68,"sajda":false},{"number":1111,"text":"الَّذِينَ يَتَّبِعُونَ الرَّسُولَ النَّبِيَّ الْأُمِّيَّ الَّذِي يَجِدُونَهُ مَكْتُوبًا عِنْدَهُمْ فِي التَّوْرَاةِ وَالْإِنْجِيلِ يَأْمُرُهُمْ بِالْمَعْرُوفِ وَيَنْهَاهُمْ عَنِ الْمُنْكَرِ وَيُحِلُّ لَهُمُ الطَّيِّبَاتِ وَيُحَرِّمُ عَلَيْهِمُ الْخَبَائِثَ وَيَضَعُ عَنْهُمْ إِصْرَهُمْ وَالْأَغْلَالَ الَّتِي كَانَتْ عَلَيْهِمْ ۚ فَالَّذِينَ آمَنُوا بِهِ وَعَزَّرُوهُ وَنَصَرُوهُ وَاتَّبَعُوا النُّورَ الَّذِي أُنْزِلَ مَعَهُ ۙ أُولَٰئِكَ هُمُ الْمُفْلِحُونَ","numberInSurah":157,"juz":9,"manzil":2,"page":170,"ruku":140,"hizbQuarter":68,"sajda":false},{"number":1112,"text":"قُلْ يَا أَيُّهَا النَّاسُ إِنِّي رَسُولُ اللَّهِ إِلَيْكُمْ جَمِيعًا الَّذِي لَهُ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ۖ لَا إِلَٰهَ إِلَّا هُوَ يُحْيِي وَيُمِيتُ ۖ فَآمِنُوا بِاللَّهِ وَرَسُولِهِ النَّبِيِّ الْأُمِّيِّ الَّذِي يُؤْمِنُ بِاللَّهِ وَكَلِمَاتِهِ وَاتَّبِعُوهُ لَعَلَّكُمْ تَهْتَدُونَ","numberInSurah":158,"juz":9,"manzil":2,"page":170,"ruku":141,"hizbQuarter":68,"sajda":false},{"number":1113,"text":"وَمِنْ قَوْمِ مُوسَىٰ أُمَّةٌ يَهْدُونَ بِالْحَقِّ وَبِهِ يَعْدِلُونَ","numberInSurah":159,"juz":9,"manzil":2,"page":170,"ruku":141,"hizbQuarter":68,"sajda":false},{"number":1114,"text":"وَقَطَّعْنَاهُمُ اثْنَتَيْ عَشْرَةَ أَسْبَاطًا أُمَمًا ۚ وَأَوْحَيْنَا إِلَىٰ مُوسَىٰ إِذِ اسْتَسْقَاهُ قَوْمُهُ أَنِ اضْرِبْ بِعَصَاكَ الْحَجَرَ ۖ فَانْبَجَسَتْ مِنْهُ اثْنَتَا عَشْرَةَ عَيْنًا ۖ قَدْ عَلِمَ كُلُّ أُنَاسٍ مَشْرَبَهُمْ ۚ وَظَلَّلْنَا عَلَيْهِمُ الْغَمَامَ وَأَنْزَلْنَا عَلَيْهِمُ الْمَنَّ وَالسَّلْوَىٰ ۖ كُلُوا مِنْ طَيِّبَاتِ مَا رَزَقْنَاكُمْ ۚ وَمَا ظَلَمُونَا وَلَٰكِنْ كَانُوا أَنْفُسَهُمْ يَظْلِمُونَ","numberInSurah":160,"juz":9,"manzil":2,"page":171,"ruku":141,"hizbQuarter":68,"sajda":false},{"number":1115,"text":"وَإِذْ قِيلَ لَهُمُ اسْكُنُوا هَٰذِهِ الْقَرْيَةَ وَكُلُوا مِنْهَا حَيْثُ شِئْتُمْ وَقُولُوا حِطَّةٌ وَادْخُلُوا الْبَابَ سُجَّدًا نَغْفِرْ لَكُمْ خَطِيئَاتِكُمْ ۚ سَنَزِيدُ الْمُحْسِنِينَ","numberInSurah":161,"juz":9,"manzil":2,"page":171,"ruku":141,"hizbQuarter":68,"sajda":false},{"number":1116,"text":"فَبَدَّلَ الَّذِينَ ظَلَمُوا مِنْهُمْ قَوْلًا غَيْرَ الَّذِي قِيلَ لَهُمْ فَأَرْسَلْنَا عَلَيْهِمْ رِجْزًا مِنَ السَّمَاءِ بِمَا كَانُوا يَظْلِمُونَ","numberInSurah":162,"juz":9,"manzil":2,"page":171,"ruku":141,"hizbQuarter":68,"sajda":false},{"number":1117,"text":"وَاسْأَلْهُمْ عَنِ الْقَرْيَةِ الَّتِي كَانَتْ حَاضِرَةَ الْبَحْرِ إِذْ يَعْدُونَ فِي السَّبْتِ إِذْ تَأْتِيهِمْ حِيتَانُهُمْ يَوْمَ سَبْتِهِمْ شُرَّعًا وَيَوْمَ لَا يَسْبِتُونَ ۙ لَا تَأْتِيهِمْ ۚ كَذَٰلِكَ نَبْلُوهُمْ بِمَا كَانُوا يَفْسُقُونَ","numberInSurah":163,"juz":9,"manzil":2,"page":171,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1118,"text":"وَإِذْ قَالَتْ أُمَّةٌ مِنْهُمْ لِمَ تَعِظُونَ قَوْمًا ۙ اللَّهُ مُهْلِكُهُمْ أَوْ مُعَذِّبُهُمْ عَذَابًا شَدِيدًا ۖ قَالُوا مَعْذِرَةً إِلَىٰ رَبِّكُمْ وَلَعَلَّهُمْ يَتَّقُونَ","numberInSurah":164,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1119,"text":"فَلَمَّا نَسُوا مَا ذُكِّرُوا بِهِ أَنْجَيْنَا الَّذِينَ يَنْهَوْنَ عَنِ السُّوءِ وَأَخَذْنَا الَّذِينَ ظَلَمُوا بِعَذَابٍ بَئِيسٍ بِمَا كَانُوا يَفْسُقُونَ","numberInSurah":165,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1120,"text":"فَلَمَّا عَتَوْا عَنْ مَا نُهُوا عَنْهُ قُلْنَا لَهُمْ كُونُوا قِرَدَةً خَاسِئِينَ","numberInSurah":166,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1121,"text":"وَإِذْ تَأَذَّنَ رَبُّكَ لَيَبْعَثَنَّ عَلَيْهِمْ إِلَىٰ يَوْمِ الْقِيَامَةِ مَنْ يَسُومُهُمْ سُوءَ الْعَذَابِ ۗ إِنَّ رَبَّكَ لَسَرِيعُ الْعِقَابِ ۖ وَإِنَّهُ لَغَفُورٌ رَحِيمٌ","numberInSurah":167,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1122,"text":"وَقَطَّعْنَاهُمْ فِي الْأَرْضِ أُمَمًا ۖ مِنْهُمُ الصَّالِحُونَ وَمِنْهُمْ دُونَ ذَٰلِكَ ۖ وَبَلَوْنَاهُمْ بِالْحَسَنَاتِ وَالسَّيِّئَاتِ لَعَلَّهُمْ يَرْجِعُونَ","numberInSurah":168,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1123,"text":"فَخَلَفَ مِنْ بَعْدِهِمْ خَلْفٌ وَرِثُوا الْكِتَابَ يَأْخُذُونَ عَرَضَ هَٰذَا الْأَدْنَىٰ وَيَقُولُونَ سَيُغْفَرُ لَنَا وَإِنْ يَأْتِهِمْ عَرَضٌ مِثْلُهُ يَأْخُذُوهُ ۚ أَلَمْ يُؤْخَذْ عَلَيْهِمْ مِيثَاقُ الْكِتَابِ أَنْ لَا يَقُولُوا عَلَى اللَّهِ إِلَّا الْحَقَّ وَدَرَسُوا مَا فِيهِ ۗ وَالدَّارُ الْآخِرَةُ خَيْرٌ لِلَّذِينَ يَتَّقُونَ ۗ أَفَلَا تَعْقِلُونَ","numberInSurah":169,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1124,"text":"وَالَّذِينَ يُمَسِّكُونَ بِالْكِتَابِ وَأَقَامُوا الصَّلَاةَ إِنَّا لَا نُضِيعُ أَجْرَ الْمُصْلِحِينَ","numberInSurah":170,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1125,"text":"۞ وَإِذْ نَتَقْنَا الْجَبَلَ فَوْقَهُمْ كَأَنَّهُ ظُلَّةٌ وَظَنُّوا أَنَّهُ وَاقِعٌ بِهِمْ خُذُوا مَا آتَيْنَاكُمْ بِقُوَّةٍ وَاذْكُرُوا مَا فِيهِ لَعَلَّكُمْ تَتَّقُونَ","numberInSurah":171,"juz":9,"manzil":2,"page":173,"ruku":142,"hizbQuarter":69,"sajda":false},{"number":1126,"text":"وَإِذْ أَخَذَ رَبُّكَ مِنْ بَنِي آدَمَ مِنْ ظُهُورِهِمْ ذُرِّيَّتَهُمْ وَأَشْهَدَهُمْ عَلَىٰ أَنْفُسِهِمْ أَلَسْتُ بِرَبِّكُمْ ۖ قَالُوا بَلَىٰ ۛ شَهِدْنَا ۛ أَنْ تَقُولُوا يَوْمَ الْقِيَامَةِ إِنَّا كُنَّا عَنْ هَٰذَا غَافِلِينَ","numberInSurah":172,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1127,"text":"أَوْ تَقُولُوا إِنَّمَا أَشْرَكَ آبَاؤُنَا مِنْ قَبْلُ وَكُنَّا ذُرِّيَّةً مِنْ بَعْدِهِمْ ۖ أَفَتُهْلِكُنَا بِمَا فَعَلَ الْمُبْطِلُونَ","numberInSurah":173,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1128,"text":"وَكَذَٰلِكَ نُفَصِّلُ الْآيَاتِ وَلَعَلَّهُمْ يَرْجِعُونَ","numberInSurah":174,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1129,"text":"وَاتْلُ عَلَيْهِمْ نَبَأَ الَّذِي آتَيْنَاهُ آيَاتِنَا فَانْسَلَخَ مِنْهَا فَأَتْبَعَهُ الشَّيْطَانُ فَكَانَ مِنَ الْغَاوِينَ","numberInSurah":175,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1130,"text":"وَلَوْ شِئْنَا لَرَفَعْنَاهُ بِهَا وَلَٰكِنَّهُ أَخْلَدَ إِلَى الْأَرْضِ وَاتَّبَعَ هَوَاهُ ۚ فَمَثَلُهُ كَمَثَلِ الْكَلْبِ إِنْ تَحْمِلْ عَلَيْهِ يَلْهَثْ أَوْ تَتْرُكْهُ يَلْهَثْ ۚ ذَٰلِكَ مَثَلُ الْقَوْمِ الَّذِينَ كَذَّبُوا بِآيَاتِنَا ۚ فَاقْصُصِ الْقَصَصَ لَعَلَّهُمْ يَتَفَكَّرُونَ","numberInSurah":176,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1131,"text":"سَاءَ مَثَلًا الْقَوْمُ الَّذِينَ كَذَّبُوا بِآيَاتِنَا وَأَنْفُسَهُمْ كَانُوا يَظْلِمُونَ","numberInSurah":177,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1132,"text":"مَنْ يَهْدِ اللَّهُ فَهُوَ الْمُهْتَدِي ۖ وَمَنْ يُضْلِلْ فَأُولَٰئِكَ هُمُ الْخَاسِرُونَ","numberInSurah":178,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1133,"text":"وَلَقَدْ ذَرَأْنَا لِجَهَنَّمَ كَثِيرًا مِنَ الْجِنِّ وَالْإِنْسِ ۖ لَهُمْ قُلُوبٌ لَا يَفْقَهُونَ بِهَا وَلَهُمْ أَعْيُنٌ لَا يُبْصِرُونَ بِهَا وَلَهُمْ آذَانٌ لَا يَسْمَعُونَ بِهَا ۚ أُولَٰئِكَ كَالْأَنْعَامِ بَلْ هُمْ أَضَلُّ ۚ أُولَٰئِكَ هُمُ الْغَافِلُونَ","numberInSurah":179,"juz":9,"manzil":2,"page":174,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1134,"text":"وَلِلَّهِ الْأَسْمَاءُ الْحُسْنَىٰ فَادْعُوهُ بِهَا ۖ وَذَرُوا الَّذِينَ يُلْحِدُونَ فِي أَسْمَائِهِ ۚ سَيُجْزَوْنَ مَا كَانُوا يَعْمَلُونَ","numberInSurah":180,"juz":9,"manzil":2,"page":174,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1135,"text":"وَمِمَّنْ خَلَقْنَا أُمَّةٌ يَهْدُونَ بِالْحَقِّ وَبِهِ يَعْدِلُونَ","numberInSurah":181,"juz":9,"manzil":2,"page":174,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1136,"text":"وَالَّذِينَ كَذَّبُوا بِآيَاتِنَا سَنَسْتَدْرِجُهُمْ مِنْ حَيْثُ لَا يَعْلَمُونَ","numberInSurah":182,"juz":9,"manzil":2,"page":174,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1137,"text":"وَأُمْلِي لَهُمْ ۚ إِنَّ كَيْدِي مَتِينٌ","numberInSurah":183,"juz":9,"manzil":2,"page":174,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1138,"text":"أَوَلَمْ يَتَفَكَّرُوا ۗ مَا بِصَاحِبِهِمْ مِنْ جِنَّةٍ ۚ إِنْ هُوَ إِلَّا نَذِيرٌ مُبِينٌ","numberInSurah":184,"juz":9,"manzil":2,"page":174,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1139,"text":"أَوَلَمْ يَنْظُرُوا فِي مَلَكُوتِ السَّمَاوَاتِ وَالْأَرْضِ وَمَا خَلَقَ اللَّهُ مِنْ شَيْءٍ وَأَنْ عَسَىٰ أَنْ يَكُونَ قَدِ اقْتَرَبَ أَجَلُهُمْ ۖ فَبِأَيِّ حَدِيثٍ بَعْدَهُ يُؤْمِنُونَ","numberInSurah":185,"juz":9,"manzil":2,"page":174,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1140,"text":"مَنْ يُضْلِلِ اللَّهُ فَلَا هَادِيَ لَهُ ۚ وَيَذَرُهُمْ فِي طُغْيَانِهِمْ يَعْمَهُونَ","numberInSurah":186,"juz":9,"manzil":2,"page":174,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1141,"text":"يَسْأَلُونَكَ عَنِ السَّاعَةِ أَيَّانَ مُرْسَاهَا ۖ قُلْ إِنَّمَا عِلْمُهَا عِنْدَ رَبِّي ۖ لَا يُجَلِّيهَا لِوَقْتِهَا إِلَّا هُوَ ۚ ثَقُلَتْ فِي السَّمَاوَاتِ وَالْأَرْضِ ۚ لَا تَأْتِيكُمْ إِلَّا بَغْتَةً ۗ يَسْأَلُونَكَ كَأَنَّكَ حَفِيٌّ عَنْهَا ۖ قُلْ إِنَّمَا عِلْمُهَا عِنْدَ اللَّهِ وَلَٰكِنَّ أَكْثَرَ النَّاسِ لَا يَعْلَمُونَ","numberInSurah":187,"juz":9,"manzil":2,"page":174,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1142,"text":"قُلْ لَا أَمْلِكُ لِنَفْسِي نَفْعًا وَلَا ضَرًّا إِلَّا مَا شَاءَ اللَّهُ ۚ وَلَوْ كُنْتُ أَعْلَمُ الْغَيْبَ لَاسْتَكْثَرْتُ مِنَ الْخَيْرِ وَمَا مَسَّنِيَ السُّوءُ ۚ إِنْ أَنَا إِلَّا نَذِيرٌ وَبَشِيرٌ لِقَوْمٍ يُؤْمِنُونَ","numberInSurah":188,"juz":9,"manzil":2,"page":175,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1143,"text":"۞ هُوَ الَّذِي خَلَقَكُمْ مِنْ نَفْسٍ وَاحِدَةٍ وَجَعَلَ مِنْهَا زَوْجَهَا لِيَسْكُنَ إِلَيْهَا ۖ فَلَمَّا تَغَشَّاهَا حَمَلَتْ حَمْلًا خَفِيفًا فَمَرَّتْ بِهِ ۖ فَلَمَّا أَثْقَلَتْ دَعَوَا اللَّهَ رَبَّهُمَا لَئِنْ آتَيْتَنَا صَالِحًا لَنَكُونَنَّ مِنَ الشَّاكِرِينَ","numberInSurah":189,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1144,"text":"فَلَمَّا آتَاهُمَا صَالِحًا جَعَلَا لَهُ شُرَكَاءَ فِيمَا آتَاهُمَا ۚ فَتَعَالَى اللَّهُ عَمَّا يُشْرِكُونَ","numberInSurah":190,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1145,"text":"أَيُشْرِكُونَ مَا لَا يَخْلُقُ شَيْئًا وَهُمْ يُخْلَقُونَ","numberInSurah":191,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1146,"text":"وَلَا يَسْتَطِيعُونَ لَهُمْ نَصْرًا وَلَا أَنْفُسَهُمْ يَنْصُرُونَ","numberInSurah":192,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1147,"text":"وَإِنْ تَدْعُوهُمْ إِلَى الْهُدَىٰ لَا يَتَّبِعُوكُمْ ۚ سَوَاءٌ عَلَيْكُمْ أَدَعَوْتُمُوهُمْ أَمْ أَنْتُمْ صَامِتُونَ","numberInSurah":193,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1148,"text":"إِنَّ الَّذِينَ تَدْعُونَ مِنْ دُونِ اللَّهِ عِبَادٌ أَمْثَالُكُمْ ۖ فَادْعُوهُمْ فَلْيَسْتَجِيبُوا لَكُمْ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":194,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1149,"text":"أَلَهُمْ أَرْجُلٌ يَمْشُونَ بِهَا ۖ أَمْ لَهُمْ أَيْدٍ يَبْطِشُونَ بِهَا ۖ أَمْ لَهُمْ أَعْيُنٌ يُبْصِرُونَ بِهَا ۖ أَمْ لَهُمْ آذَانٌ يَسْمَعُونَ بِهَا ۗ قُلِ ادْعُوا شُرَكَاءَكُمْ ثُمَّ كِيدُونِ فَلَا تُنْظِرُونِ","numberInSurah":195,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1150,"text":"إِنَّ وَلِيِّيَ اللَّهُ الَّذِي نَزَّلَ الْكِتَابَ ۖ وَهُوَ يَتَوَلَّى الصَّالِحِينَ","numberInSurah":196,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1151,"text":"وَالَّذِينَ تَدْعُونَ مِنْ دُونِهِ لَا يَسْتَطِيعُونَ نَصْرَكُمْ وَلَا أَنْفُسَهُمْ يَنْصُرُونَ","numberInSurah":197,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1152,"text":"وَإِنْ تَدْعُوهُمْ إِلَى الْهُدَىٰ لَا يَسْمَعُوا ۖ وَتَرَاهُمْ يَنْظُرُونَ إِلَيْكَ وَهُمْ لَا يُبْصِرُونَ","numberInSurah":198,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1153,"text":"خُذِ الْعَفْوَ وَأْمُرْ بِالْعُرْفِ وَأَعْرِضْ عَنِ الْجَاهِلِينَ","numberInSurah":199,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1154,"text":"وَإِمَّا يَنْزَغَنَّكَ مِنَ الشَّيْطَانِ نَزْغٌ فَاسْتَعِذْ بِاللَّهِ ۚ إِنَّهُ سَمِيعٌ عَلِيمٌ","numberInSurah":200,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1155,"text":"إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا فَإِذَا هُمْ مُبْصِرُونَ","numberInSurah":201,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1156,"text":"وَإِخْوَانُهُمْ يَمُدُّونَهُمْ فِي الْغَيِّ ثُمَّ لَا يُقْصِرُونَ","numberInSurah":202,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1157,"text":"وَإِذَا لَمْ تَأْتِهِمْ بِآيَةٍ قَالُوا لَوْلَا اجْتَبَيْتَهَا ۚ قُلْ إِنَّمَا أَتَّبِعُ مَا يُوحَىٰ إِلَيَّ مِنْ رَبِّي ۚ هَٰذَا بَصَائِرُ مِنْ رَبِّكُمْ وَهُدًى وَرَحْمَةٌ لِقَوْمٍ يُؤْمِنُونَ","numberInSurah":203,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1158,"text":"وَإِذَا قُرِئَ الْقُرْآنُ فَاسْتَمِعُوا لَهُ وَأَنْصِتُوا لَعَلَّكُمْ تُرْحَمُونَ","numberInSurah":204,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1159,"text":"وَاذْكُرْ رَبَّكَ فِي نَفْسِكَ تَضَرُّعًا وَخِيفَةً وَدُونَ الْجَهْرِ مِنَ الْقَوْلِ بِالْغُدُوِّ وَالْآصَالِ وَلَا تَكُنْ مِنَ الْغَافِلِينَ","numberInSurah":205,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1160,"text":"إِنَّ الَّذِينَ عِنْدَ رَبِّكَ لَا يَسْتَكْبِرُونَ عَنْ عِبَادَتِهِ وَيُسَبِّحُونَهُ وَلَهُ يَسْجُدُونَ ۩","numberInSurah":206,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":{"id":1,"recommended":true,"obligatory":false}}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":7,"name":"سُورَةُ الأَعۡرَافِ","englishName":"A'râf","englishNameTranslation":"The Heights","revelationType":"Meccan","numberOfAyahs":206,"ayahs":[{"number":955,"text":"Elif, Lam, Mim, Sad.","numberInSurah":1,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":956,"text":"Sana bir Kitap indirildi. Onunla insanları uyarman ve inananlara öğüt vermen için kalbine bir darlık gelmesin.","numberInSurah":2,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":957,"text":"Rabbinizden size indirilen Kitap'a uyun, O'ndan başka dostlar edinerek onlara uymayın. Pek az öğüt dinliyorsunuz.","numberInSurah":3,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":958,"text":"Biz nice kentleri yok etmişizdir; geceleyin veya gündüz uykularında iken baskınımıza uğramışlardır.","numberInSurah":4,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":959,"text":"Baskınımıza uğradıklarında, sözleri, \"Gerçekten biz haksızdık\" demekten ibaret kalmıştır.","numberInSurah":5,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":960,"text":"And olsun ki, kendilerine peygamber gönderilenlere soracağız, peygamberlere de soracağız.","numberInSurah":6,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":961,"text":"And olsun ki, yaptıklarını kendilerine bir bir anlatacağız, zira onlardan uzak değildik.","numberInSurah":7,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":962,"text":"Gerçek tartı kıyamet günündedir. Tartıları ağır gelenler, işte onlar kurtulanlardır.","numberInSurah":8,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":963,"text":"Tartıları hafif gelenler, ayetlerimize yaptıkları haksızlıklardan ötürü kendilerini mahvetmiş olanlardır.","numberInSurah":9,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":964,"text":"Sizi yeryüzünde yerleştirdik ve orada size geçimlikler yarattık. Öyleyken pek az şükrediyorsunuz.","numberInSurah":10,"juz":8,"manzil":2,"page":151,"ruku":122,"hizbQuarter":61,"sajda":false},{"number":965,"text":"And olsun ki, sizi yarattık, sonra şekil verdik, sonra meleklere, \"Adem'e secde edin\" dedik; İblis'ten başka hepsi secde etti, o secde edenlerden olmadı.","numberInSurah":11,"juz":8,"manzil":2,"page":151,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":966,"text":"Allah, \"Sana emrettiğim halde, seni secdeden alıkoyan nedir?\" dedi, \"Beni ateşten onu çamurdan yarattın, ben ondan üstünüm\" cevabını verdi.","numberInSurah":12,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":967,"text":"Ona, \"İn oradan, orada büyüklenmek sana düşmez, defol, sen alçağın birisin\" dedi.","numberInSurah":13,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":968,"text":"Ona, \"İnsanların tekrar dirilecekleri güne kadar beni ertele\" dedi.","numberInSurah":14,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":969,"text":"Allah; \"Sen erteye bırakılanlardansın\" dedi.","numberInSurah":15,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":970,"text":"\"Beni azdırdığın için, and olsun ki, Senin doğru yolun üzerinde onlara karşı duracağım; sonra önlerinden, ardlarından, sağ ve sollarından onlara sokulacağım; çoğunu Sana şükreder bulamayacaksın\" dedi.","numberInSurah":16,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":971,"text":"\"Beni azdırdığın için, and olsun ki, Senin doğru yolun üzerinde onlara karşı duracağım; sonra önlerinden, ardlarından, sağ ve sollarından onlara sokulacağım; çoğunu Sana şükreder bulamayacaksın\" dedi.","numberInSurah":17,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":972,"text":"Allah, \"Yerilmiş ve kovulmuşsun, oradan defol; and olsun ki insanlardan sana kim uyarsa, hepinizi cehenneme dolduracağım\" dedi.","numberInSurah":18,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":973,"text":"\"Ey Adem! Sen ve eşin cennette kalın ve istediğiniz yerden yiyin, yalnız şu ağaca yaklaşmayın yoksa zalimlerden olursunuz.\"","numberInSurah":19,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":974,"text":"Şeytan, ayıp yerlerini kendilerine göstermek için onlara fısıldadı: \"Rabbinizin sizi bu ağaçtan menetmesi melek olmanız veya burada temelli kalmanızı önlemek içindir.\"","numberInSurah":20,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":975,"text":"\"Doğrusu ben size öğüt verenlerdenim\" diye ikisine yemin etti.","numberInSurah":21,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":976,"text":"Böylece onların yanılmalarını sağladı. Ağaçtan meyve tattıklarında kendilerine ayıp yerleri göründü, cennet yapraklarından oralarına örtmeğe koyuldular. Rableri onlara, \"Ben sizi o ağaçtan menetmemiş miydim? Şeytanın size apaçık bir düşman olduğunu söylememiş miydim?\" diye seslendi.","numberInSurah":22,"juz":8,"manzil":2,"page":152,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":977,"text":"Her ikisi, \"Rabbimiz! Kendimize yazık ettik; bizi bağışlamaz ve bize merhamet etmezsen biz kaybedenlerden oluruz\" dediler.","numberInSurah":23,"juz":8,"manzil":2,"page":153,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":978,"text":"\"Birbirinize düşman olarak inin, siz yeryüzünde bir müddet için yerleşip geçineceksiniz.\"","numberInSurah":24,"juz":8,"manzil":2,"page":153,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":979,"text":"\"Orada yaşar, orada ölür ve oradan dirilip çıkarılırsınız\" dedi.","numberInSurah":25,"juz":8,"manzil":2,"page":153,"ruku":123,"hizbQuarter":61,"sajda":false},{"number":980,"text":"Ey İnsanoğulları! Ayıp yerlerinizi örtecek giyimlikle sizi süsleyecek elbiseler gönderdik. Takva örtüsü ise bunlardan daha hayırlıdır. Allah'ın bu ayetleri öğüt almanız içindir.","numberInSurah":26,"juz":8,"manzil":2,"page":153,"ruku":124,"hizbQuarter":61,"sajda":false},{"number":981,"text":"Ey İnsanoğulları! Şeytan, ayıp yerlerini kendilerine göstermek için elbiselerini soyarak ananızı babanızı cennetten çıkardığı gibi sizi de şaşırtmasın. Sizin onları görmediğiniz yerlerden o ve taraftarları sizi görürler. Biz şeytanları, inanmayanlara dost kılarız.","numberInSurah":27,"juz":8,"manzil":2,"page":153,"ruku":124,"hizbQuarter":61,"sajda":false},{"number":982,"text":"Onlar bir fenalık yaptıkları zaman, \"Babalarımızı bu yolda bulduk, Allah da bize bunu emretti\" derler. De ki: \"Allah fenalığı emretmez. Bilmediğiniz şeyi Allah'a karşı mı söylüyorsunuz?\"","numberInSurah":28,"juz":8,"manzil":2,"page":153,"ruku":124,"hizbQuarter":61,"sajda":false},{"number":983,"text":"De ki: \"Rabbim adaleti emretti; her secde yerinde yüzünüzü O'na doğrultun; dinde samimi olarak O'na yalvarın. Sizi yarattığı gibi yine O'na döneceksiniz.\"","numberInSurah":29,"juz":8,"manzil":2,"page":153,"ruku":124,"hizbQuarter":61,"sajda":false},{"number":984,"text":"Allah insanlardan bir takımını doğru yola eriştirdi, fakat bir takımı da sapıklığı haketti, çünkü bunlar Allah'ı bırakıp şeytanları dost edinmiş ve kendilerini doğru yolda sanmışlardı.","numberInSurah":30,"juz":8,"manzil":2,"page":153,"ruku":124,"hizbQuarter":61,"sajda":false},{"number":985,"text":"Ey Ademoğulları! Her mescide güzel elbiselerinizi giyinerek gidin; yiyin için fakat israf etmeyin, çünkü Allah müsrifleri sevmez.","numberInSurah":31,"juz":8,"manzil":2,"page":154,"ruku":124,"hizbQuarter":62,"sajda":false},{"number":986,"text":"\"Allah'ın kulları için yarattığı ziynet ve temiz rızıkları haram kılan kimdir?\" \"Bunlar, dünya hayatında inananlarındır, kıyamet gününde de yalnız onlar içindir\" de. Bilen kimseler için ayetlerimizi böylece uzun uzun açıklıyoruz.","numberInSurah":32,"juz":8,"manzil":2,"page":154,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":987,"text":"De ki: \"Rabbim sadece, açık ve gizli fenalıkları, günahı, haksız yere tecavüzü, hakkında hiçbir delil indirmediği şeyi Allah'a ortak koşmanızı, Allah'a karşı bilmediğiniz şeyleri söylemenizi haram kılmıştır.\"","numberInSurah":33,"juz":8,"manzil":2,"page":154,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":988,"text":"Her ümmet için belirli bir süre vardır; vakitleri dolunca ne bir saat gecikebilir ne de öne geçebilirler.","numberInSurah":34,"juz":8,"manzil":2,"page":154,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":989,"text":"Ey Adem oğulları! Size aranızdan ayetlerimizi okuyan peygamberler geldiğinde, onların bildirdiklerine karşı gelmekten sakınan ve gidişini düzeltenlere, işte onlara korku yoktur ve onlar üzülmeyeceklerdir.","numberInSurah":35,"juz":8,"manzil":2,"page":154,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":990,"text":"Ayetlerimizi yalanlayıp onlara karşı büyüklük taslayanlara gelince, işte onlar cehennemliklerdir, orada temelli kalacaklardır.","numberInSurah":36,"juz":8,"manzil":2,"page":154,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":991,"text":"Allah'a karşı yalan uyduran veya ayetlerini yalan sayandan daha zalim kimdir? Kitap'daki payları kendilerine erişecek olanlar onlardır. Elçilerimiz canlarını almak üzere geldiklerinde onlara, \"Allah'tan başka taptıklarınız nerede?\" deyince, \"Bizi koyup kaçtılar\" derler, böylece inkarcı olduklarına kendi aleyhlerine şahidlik ederler.","numberInSurah":37,"juz":8,"manzil":2,"page":154,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":992,"text":"Allah, \" Sizden önce geçmiş cin ve insan ümmetleriyle beraber ateşe girin\" der. Her ümmet girdikçe kendi yoldaşına lanet eder. Hepsi birbiri ardından cehennemde toplanınca, sonrakiler öncekiler için, \"Rabbimiz! Bizi sapıtanlar işte bunlardır, onlara ateş azabını kat kat ver\" derler, Allah, \"Hepsinin kat kattır, ama bilmezsiniz\" der.","numberInSurah":38,"juz":8,"manzil":2,"page":155,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":993,"text":"Öncekiler sonrakilere, \"Sizin bizden bir üstünlüğünüz yoktu, kazandığınıza karşılık azabı tadın\" derler.","numberInSurah":39,"juz":8,"manzil":2,"page":155,"ruku":125,"hizbQuarter":62,"sajda":false},{"number":994,"text":"Doğrusu ayetlerimizi yalan sayıp, onlara karşı büyüklük taslayanlara, göğün kapıları açılmaz; deve iğnenin deliğinden geçmedikçe cennete de giremezler. Suçluları böyle cezalandırırız.","numberInSurah":40,"juz":8,"manzil":2,"page":155,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":995,"text":"Onlar için cehennemden bir yatak ve üstlerine de örtüler vardır. Zalimleri böyle cezalandırırız.","numberInSurah":41,"juz":8,"manzil":2,"page":155,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":996,"text":"İnanan ve yararlı iş işleyenler ki kişiye ancak gücünün yeteceği kadar yükleriz işte cennetlikler onlardır, orada temelli kalacaklardır.","numberInSurah":42,"juz":8,"manzil":2,"page":155,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":997,"text":"Cennette altlarından ırmaklar akarken gönüllerinden kini çıkarıp atarız. \"Bizi buraya eriştiren Allah'a hamdolsun. Eğer Allah bizi doğru yola iletmeseydi, biz doğru yolu bulamazdık. And olsun ki Rabbimizin peygamberleri bize gerçeği getirmiştir\" derler. Onlara, \"İşlediğinize karşılık işte mirasçısı olduğunuz cennet\" diye seslenilir.","numberInSurah":43,"juz":8,"manzil":2,"page":155,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":998,"text":"Cennetlikler, cehennemliklere: \"Biz Rabbimizin bize vadettiğini gerçek bulduk, Rabbinizin size de vadettiğini gerçek buldunuz mu?\" diye seslenirler, \"Evet\" derler. Aralarında bir münadi, \"Allah'ın laneti Allah yolundan alıkoyan, o yolun eğriliğini isteyen ve ahireti inkar eden zalimleredir\" diye seslenir.","numberInSurah":44,"juz":8,"manzil":2,"page":156,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":999,"text":"Cennetlikler, cehennemliklere: \"Biz Rabbimizin bize vadettiğini gerçek bulduk, Rabbinizin size de vadettiğini gerçek buldunuz mu?\" diye seslenirler, \"Evet\" derler. Aralarında bir münadi, \"Allah'ın laneti Allah yolundan alıkoyan, o yolun eğriliğini isteyen ve ahireti inkar eden zalimleredir\" diye seslenir.","numberInSurah":45,"juz":8,"manzil":2,"page":156,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":1000,"text":"İki taraf arasında bir perde ve burçlar üzerinde her iki tarafı da simalarından tanıyan adamlar vardır; cennetliklere, \"Size selam olsun\" derler. Bunlar henüz girmeyen fakat cenneti uman kimselerdir.","numberInSurah":46,"juz":8,"manzil":2,"page":156,"ruku":126,"hizbQuarter":62,"sajda":false},{"number":1001,"text":"Gözleri cehennemlikler yönüne çevrilince: \"Rabbimiz! Bizi zalimlerle beraber bulundurma\" derler.","numberInSurah":47,"juz":8,"manzil":2,"page":156,"ruku":126,"hizbQuarter":63,"sajda":false},{"number":1002,"text":"Burçlarda olanlar, simalarından tanıdıkları adamlara; Topluluğunuz, topladığınız mal ve büyüklük taslamalarınız size fayda vermedi. Allah'ın rahmetine erdirmeyeceğine yemin ettikleriniz bunlar mıydı? Oysa Allah onlara şöyle der: \"Cennete girin, size korku yoktur, sizler mahzun da olmayacaksınız.\"","numberInSurah":48,"juz":8,"manzil":2,"page":156,"ruku":127,"hizbQuarter":63,"sajda":false},{"number":1003,"text":"Burçlarda olanlar, simalarından tanıdıkları adamlara; Topluluğunuz, topladığınız mal ve büyüklük taslamalarınız size fayda vermedi. Allah'ın rahmetine erdirmeyeceğine yemin ettikleriniz bunlar mıydı? Oysa Allah onlara şöyle der: \"Cennete girin, size korku yoktur, sizler mahzun da olmayacaksınız.\"","numberInSurah":49,"juz":8,"manzil":2,"page":156,"ruku":127,"hizbQuarter":63,"sajda":false},{"number":1004,"text":"Cehennemlikler cennetliklere, \"Bize biraz su veya Allah'ın size verdiği rızıktan gönderin\" diye seslenirler, onlar da, \"Doğrusu Allah dinlerini alay ve eğlenceye alan, dünya hayatına aldanan inkarcılara ikisini de haram etmiştir\" derler. Bugünle karşılaşacaklarını unuttukları, ayetlerimizi bile bile inkar ettikleri gibi biz de onları unutuyoruz.","numberInSurah":50,"juz":8,"manzil":2,"page":156,"ruku":127,"hizbQuarter":63,"sajda":false},{"number":1005,"text":"Cehennemlikler cennetliklere, \"Bize biraz su veya Allah'ın size verdiği rızıktan gönderin\" diye seslenirler, onlar da, \"Doğrusu Allah dinlerini alay ve eğlenceye alan, dünya hayatına aldanan inkarcılara ikisini de haram etmiştir\" derler. Bugünle karşılaşacaklarını unuttukları, ayetlerimizi bile bile inkar ettikleri gibi biz de onları unutuyoruz.","numberInSurah":51,"juz":8,"manzil":2,"page":156,"ruku":127,"hizbQuarter":63,"sajda":false},{"number":1006,"text":"And olsun ki Biz onlara bir Kitap getirdik, inanan bir millet için yol gösterici ve rahmet olarak onu bilgiyle uzun uzun açıkladık.","numberInSurah":52,"juz":8,"manzil":2,"page":157,"ruku":127,"hizbQuarter":63,"sajda":false},{"number":1007,"text":"Kitap'ın haber verdiği sonuçtan başka bir şey mi bekliyorlar? Sonuç gelip çattığı gün, önceleri onu unutmuş olanlar, \"Rabbimizin peygamberleri şüphesiz bize gerçeği getirmişti, şimdi bize şefaat etsin, yahut geriye çevrilsek de işlediklerimizin başka türlüsünü işlesek\" derler. Doğrusu kendilerini mahvetmişlerdir, uydurdukları şeyler onları koyup kaçmışlardır.","numberInSurah":53,"juz":8,"manzil":2,"page":157,"ruku":127,"hizbQuarter":63,"sajda":false},{"number":1008,"text":"Rabbiniz, gökleri ve yeri altı günde yaratan ve sonra arşa hükmeden, gündüzü durmadan kovalayan gece ile bürüyen; güneşi, ayı, yıldızları, hepsini buyruğuna baş eğdirerek var eden Allah'tır. Bilin ki yaratma da emir de O'nun hakkıdır. Alemlerin Rabbiolan Allah Yüce'dir.","numberInSurah":54,"juz":8,"manzil":2,"page":157,"ruku":128,"hizbQuarter":63,"sajda":false},{"number":1009,"text":"Rabbinize gönülden ve gizlice yalvarın. Doğrusu O aşırı gidenleri sevmez.","numberInSurah":55,"juz":8,"manzil":2,"page":157,"ruku":128,"hizbQuarter":63,"sajda":false},{"number":1010,"text":"Düzeltilmişken, yeryüzünde bozgunculuk yapmayın. Allah'a korkarak ve umutla yalvarın. Doğrusu Allah'ın rahmeti iyi davrananlara yakındır.","numberInSurah":56,"juz":8,"manzil":2,"page":157,"ruku":128,"hizbQuarter":63,"sajda":false},{"number":1011,"text":"Rahmetinin önünde, müjdeci olarak rüzgarları gönderen Allah'tır. Rüzgarlar, yağmur yüklü bulutları taşıdığında, onu ölü bir memlekete gönderir, su indirir ve onunla her türlü ürünü yetiştiririz; ölüleri de bunun gibi diriltip, çıkarırız; belki bundan ibret alırsınız.","numberInSurah":57,"juz":8,"manzil":2,"page":157,"ruku":128,"hizbQuarter":63,"sajda":false},{"number":1012,"text":"İyi toprak Rabbinin izniyle bitki verir, çorak toprak kavruk bitki çıkarır. Şükredecek millet için böylece ayetleri yerli yerince açıklarız.","numberInSurah":58,"juz":8,"manzil":2,"page":158,"ruku":128,"hizbQuarter":63,"sajda":false},{"number":1013,"text":"And olsun ki Nuh'u milletine gönderdik. \"Ey milletim! Allah'a kulluk edin, O'ndan başka tanrınız yoktur; doğrusu sizin için büyük günün azabından korkuyorum\" dedi.","numberInSurah":59,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1014,"text":"Milletinin ileri gelenleri: \"Biz senin apaçık sapıklıkta olduğunu görüyoruz\" dediler.","numberInSurah":60,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1015,"text":"\"Ey milletim! Bende bir sapıklık yoktur, ancak ben Alemlerin Rabbinin peygamberiyim, Rabbimin sözlerini size bildiriyor, öğüt veriyorum. Sizin bilmediğinizi Allah katından ben biliyorum. Sakınmanızı ve böylece merhamete uğramanızı sağlamak üzere sizi uyarmak için aranızdan biri vasıtasıyla Rabbinizden size haber gelmesine mi şaşıyorsunuz?\" dedi.","numberInSurah":61,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1016,"text":"\"Ey milletim! Bende bir sapıklık yoktur, ancak ben Alemlerin Rabbinin peygamberiyim, Rabbimin sözlerini size bildiriyor, öğüt veriyorum. Sizin bilmediğinizi Allah katından ben biliyorum. Sakınmanızı ve böylece merhamete uğramanızı sağlamak üzere sizi uyarmak için aranızdan biri vasıtasıyla Rabbinizden size haber gelmesine mi şaşıyorsunuz?\" dedi.","numberInSurah":62,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1017,"text":"\"Ey milletim! Bende bir sapıklık yoktur, ancak ben Alemlerin Rabbinin peygamberiyim, Rabbimin sözlerini size bildiriyor, öğüt veriyorum. Sizin bilmediğinizi Allah katından ben biliyorum. Sakınmanızı ve böylece merhamete uğramanızı sağlamak üzere sizi uyarmak için aranızdan biri vasıtasıyla Rabbinizden size haber gelmesine mi şaşıyorsunuz?\" dedi.","numberInSurah":63,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1018,"text":"Onu yalanladılar; biz de onu ve gemide beraberinde olanları kurtardık, ayetlerimizi yalan sayanları suda boğduk, çünkü onlar kör bir milletti.","numberInSurah":64,"juz":8,"manzil":2,"page":158,"ruku":129,"hizbQuarter":63,"sajda":false},{"number":1019,"text":"Ad milletine de, kardeşleri Hud'u gönderdik \"Ey milletim! Allah'a kulluk edin, O'ndan başka tanrınız yoktur, karşı gelmekten sakınmaz mısınız?\" dedi.","numberInSurah":65,"juz":8,"manzil":2,"page":158,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1020,"text":"Milletinin inkarcı ileri gelenleri, \"Biz senin beyinsiz olduğunu görüyor ve seni yalancılardan sanıyoruz\" dediler.","numberInSurah":66,"juz":8,"manzil":2,"page":158,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1021,"text":"\"Ey milletim! Ben beyinsiz değil, Alemlerin Rabbinin peygamberiyim.","numberInSurah":67,"juz":8,"manzil":2,"page":158,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1022,"text":"Size Rabbimin sözlerini bildiriyorum. Ben sizin için güvenilir bir öğütçüyüm; sizi uyarmak üzere, aranızdan bir adam vasıtasiyle Rabbinizden size bir haber gelmesine mi şaşıyorsunuz? Allah'ın sizi Nuh'un milleti yerine getirdiğini ve vücutça da onlardan üstün kıldığını hatırlayın, başarıya erişebilmeniz için Allah'ın nimetlerini anın\" dedi.","numberInSurah":68,"juz":8,"manzil":2,"page":159,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1023,"text":"Size Rabbimin sözlerini bildiriyorum. Ben sizin için güvenilir bir öğütçüyüm; sizi uyarmak üzere, aranızdan bir adam vasıtasiyle Rabbinizden size bir haber gelmesine mi şaşıyorsunuz? Allah'ın sizi Nuh'un milleti yerine getirdiğini ve vücutça da onlardan üstün kıldığını hatırlayın, başarıya erişebilmeniz için Allah'ın nimetlerini anın\" dedi.","numberInSurah":69,"juz":8,"manzil":2,"page":159,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1024,"text":"\"Bize yalnız Allah'a kulluk etmemizi, babalarımızın taptıklarını bırakmamızı söylemek için mi geldin? Doğru sözlülerden isen haydi bizi tehdit ettiğin azaba uğrat\" dediler.","numberInSurah":70,"juz":8,"manzil":2,"page":159,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1025,"text":"\"Hiç şüphesiz artık Rabbinizin azab ve öfkesini hakettiniz. Allah'ın hiçbir delil indirmediği, isimlerini de siz ve babalarınızın koyduğu putlar hakkında mı benimle tartışıyorsunuz? Bekleyin, doğrusu ben de sizinle beraber bekleyenlerdenim\" dedi.","numberInSurah":71,"juz":8,"manzil":2,"page":159,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1026,"text":"Biz, rahmetimizle, Hud'u ve beraberinde bulunanları kurtardık, ayetlerimizi yalan sayarak inanmayanların kökünü kestik.","numberInSurah":72,"juz":8,"manzil":2,"page":159,"ruku":130,"hizbQuarter":64,"sajda":false},{"number":1027,"text":"Semud milletine de kardeşleri Salih'i gönderdik. \"Ey milletim! Allah'a kulluk edin, O'ndan başka tanrınız yoktur. Rabbinizden size bir belge geldi: Allah'ın bu dişi devesi size bir delildir, onu bırakın, Allah'ın toprağında otlasın; ona kötülük etmeyin, yoksa can yakıcı azaba uğrarsınız.","numberInSurah":73,"juz":8,"manzil":2,"page":159,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1028,"text":"Allah'ın sizi Ad milleti yerine getirdiğini, ovalarında köşkler kurup dağlarında kayadan evler yonttuğunuz yeryüzünde yerleştirdiğini hatırlayın; Allah'ın nimetlerini anın, yeryüzünde bozgunculuk yaparak karışıklık çıkarmayın\" dedi.","numberInSurah":74,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1029,"text":"Milletinin büyüklük taslayan ileri gelenleri, aralarından iman eden ve bu sebeple hor gördükleri kimselere, \"Salih'in Rabbi tarafından gönderildiğini sahiden biliyor musunuz?\" dediler, onlar da, \"Doğrusu biz onunla gönderilene inanıyoruz\" dediler.","numberInSurah":75,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1030,"text":"Büyüklük taslayanlar, \"Sizin inandığınızı biz inkar ediyoruz\" dediler ve dişi deveyi kesip devirdiler; Rablerinin buyruğuna baş kaldırdılar, \"Ey Salih, eğer sen peygambersen bizi tehdit ettiğin azaba uğrat bakalım\" dediler.","numberInSurah":76,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1031,"text":"Büyüklük taslayanlar, \"Sizin inandığınızı biz inkar ediyoruz\" dediler ve dişi deveyi kesip devirdiler; Rablerinin buyruğuna baş kaldırdılar, \"Ey Salih, eğer sen peygambersen bizi tehdit ettiğin azaba uğrat bakalım\" dediler.","numberInSurah":77,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1032,"text":"Bu yüzden onları bir sarsıntı tuttu ve oldukları yerde diz üstü çöküverdiler.","numberInSurah":78,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1033,"text":"Salih de onlardan yüz çevirdi ve \"Ey milletim! And olsun ki ben size Rabbimin sözünü bildirmiş ve öğüt vermiştim; fakat siz öğüt verenleri sevmiyorsunuz\" dedi.","numberInSurah":79,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1034,"text":"Lut'u da gönderdik, milletine \"Dünyalarda hiç kimsenin sizden önce yapmadığı bir hayasızlığı mı yapıyorsunuz? Siz kadınları bırakıp erkeklere yaklaşıyorsunuz, doğrusu çok aşırı giden bir milletsiniz\" dedi.","numberInSurah":80,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1035,"text":"Lut'u da gönderdik, milletine \"Dünyalarda hiç kimsenin sizden önce yapmadığı bir hayasızlığı mı yapıyorsunuz? Siz kadınları bırakıp erkeklere yaklaşıyorsunuz, doğrusu çok aşırı giden bir milletsiniz\" dedi.","numberInSurah":81,"juz":8,"manzil":2,"page":160,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1036,"text":"Milletinin cevabı sadece, \"Onları kasabanızdan çıkarın, güya onlar temiz kalmaya uğraşan insanlarmış\" demek oldu.","numberInSurah":82,"juz":8,"manzil":2,"page":161,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1037,"text":"Bunun üzerine Lut'u ve taraftarlarını kurtardık; yalnız karısı, geride kalıp helake uğrayanlardan oldu.","numberInSurah":83,"juz":8,"manzil":2,"page":161,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1038,"text":"Geriye kalanların üzerine öyle bir yağmur yağdırdık ki! Suçluların sonunun nasıl olduğuna bir bak!","numberInSurah":84,"juz":8,"manzil":2,"page":161,"ruku":131,"hizbQuarter":64,"sajda":false},{"number":1039,"text":"Medyen halkına da kardeşleri Şuayb'ı gönderdik, onlara şöyle dedi: \"Ey milletim! Allah'a kulluk edin, O'ndan başka tanrınız yoktur. Rabbinizden size bir belge geldi. Ölçü ve tartıyı tam yapın, insanların eşyasını eksik vermeyin, düzelttikten sonra yeryüzünde bozgunculuk etmeyin; inanıyorsanız bilin ki, bunlar sizin için hayırlıdır.\"","numberInSurah":85,"juz":8,"manzil":2,"page":161,"ruku":132,"hizbQuarter":64,"sajda":false},{"number":1040,"text":"\"Allah'a inananları yolundan alıkoyup ve o yolun eğriliğini dileyerek tehdit edip her yolda pusu kurup oturmayın. Azken, Allah'ın sizi çoğalttığını hatırlayın; bozguncuların sonunun nasıl olduğuna bir bakın.\"","numberInSurah":86,"juz":8,"manzil":2,"page":161,"ruku":132,"hizbQuarter":64,"sajda":false},{"number":1041,"text":"\"İçinizde mademki benimle gönderilene inanan bir topluluk ve inanmayan bir topluluk var, o halde Allah'ın aramızda hükmünü bildirmesine kadar sabredin. Allah hükmedenlerin en iyisidir.\"","numberInSurah":87,"juz":8,"manzil":2,"page":161,"ruku":132,"hizbQuarter":64,"sajda":false},{"number":1042,"text":"Milletinin büyüklük taslayan ileri gelenleri, \"Ey Şuayb! Ya dinimize dönersiniz ya da, and olsun ki seni ve inananları seninle beraber kentimizden çıkarırız\" dediler. Şuayb, onlara: \"İstemezsek de mi? Allah bizi dininizden kurtardıktan sonra ona dönecek olursak, doğrusu Allah'a karşı yalan uydurmuş oluruz. Rabbimizin dilemesi bir yana, dininize dönmek bize yakışmaz. Rabbimizin ilmi her şeyi kuşatmıştır. Biz yalnız Allah'a güvendik. Rabbimiz! Bizimle milletimiz arasında hak ile Sen hüküm ver, Sen hükmedenlerin en hayırlısısın\" dedi.","numberInSurah":88,"juz":9,"manzil":2,"page":162,"ruku":132,"hizbQuarter":65,"sajda":false},{"number":1043,"text":"Milletinin büyüklük taslayan ileri gelenleri, \"Ey Şuayb! Ya dinimize dönersiniz ya da, and olsun ki seni ve inananları seninle beraber kentimizden çıkarırız\" dediler. Şuayb, onlara: \"İstemezsek de mi? Allah bizi dininizden kurtardıktan sonra ona dönecek olursak, doğrusu Allah'a karşı yalan uydurmuş oluruz. Rabbimizin dilemesi bir yana, dininize dönmek bize yakışmaz. Rabbimizin ilmi her şeyi kuşatmıştır. Biz yalnız Allah'a güvendik. Rabbimiz! Bizimle milletimiz arasında hak ile Sen hüküm ver, Sen hükmedenlerin en hayırlısısın\" dedi.","numberInSurah":89,"juz":9,"manzil":2,"page":162,"ruku":132,"hizbQuarter":65,"sajda":false},{"number":1044,"text":"Milletinin inkar eden ileri gelenleri, \"Şuayb'a uyarsanız, and olsun ki siz kaybedersiniz\" dediler.","numberInSurah":90,"juz":9,"manzil":2,"page":162,"ruku":132,"hizbQuarter":65,"sajda":false},{"number":1045,"text":"Bu yüzden onları bir sarsıntı tuttu ve oldukları yerde diz üstü çöküverdiler.","numberInSurah":91,"juz":9,"manzil":2,"page":162,"ruku":132,"hizbQuarter":65,"sajda":false},{"number":1046,"text":"Şuayb'ı yalanlayanlar, yurtlarında sanki hiç yaşamamışlar gibi oldular, izleri bile kalmadı. Mahvolanlar, Şuayb'ı yalanlayanlar oldu.","numberInSurah":92,"juz":9,"manzil":2,"page":162,"ruku":132,"hizbQuarter":65,"sajda":false},{"number":1047,"text":"Şuayb onlardan döndü de, \"Ey milletim! And olsun ki, Rabbimin sözlerini size bildirdim, öğüt verdim; inkarcı millet için niçin üzüleyim?\" dedi.","numberInSurah":93,"juz":9,"manzil":2,"page":162,"ruku":132,"hizbQuarter":65,"sajda":false},{"number":1048,"text":"Biz hangi kente (ülkeye) bir peygamber gönderdikse, ora halkını, yalvarıp yakarsınlar diye, darlık ve sıkıntıya uğratmışızdır.","numberInSurah":94,"juz":9,"manzil":2,"page":162,"ruku":133,"hizbQuarter":65,"sajda":false},{"number":1049,"text":"Sonra kötülüğün yerine iyiliği koyduk, öyle ki, çoğalıp, \"babalarımız da darlığa uğramış, bolluğa kavuşmuşlardı\" dediler. Bu yüzden onları haberleri olmadan, ansızın yakalayıverdik.","numberInSurah":95,"juz":9,"manzil":2,"page":162,"ruku":133,"hizbQuarter":65,"sajda":false},{"number":1050,"text":"Eğer kentlerin halkı inanmış ve Bize karşı gelmekten sakınmış olsalardı, onlara göğün ve yerin bolluklarını verirdik. Ama yalanladılar; bu yüzden onları, yaptıklarına karşılık yakalayıverdik.","numberInSurah":96,"juz":9,"manzil":2,"page":163,"ruku":133,"hizbQuarter":65,"sajda":false},{"number":1051,"text":"Kentlerin halkı, geceleyin uyurlarken azabımızın kendilerine gelmesinden güvende miydiler?","numberInSurah":97,"juz":9,"manzil":2,"page":163,"ruku":133,"hizbQuarter":65,"sajda":false},{"number":1052,"text":"Yahut kentlerin halkı, kuşluk vakti eğlenirlerken azabımızın kendilerine gelmesinden güvende miydiler?","numberInSurah":98,"juz":9,"manzil":2,"page":163,"ruku":133,"hizbQuarter":65,"sajda":false},{"number":1053,"text":"Onlar Allah'ın düzeninden güvende miydiler? Allah'ın düzeninden ancak mahvolacak millet güvende olur. Sahiplerinden sonra yeryüzüne mirasçı olan kimselere hala şu açıkça anlaşılmadı mı ki Biz dileseydik onları da suçlarının cezasına uğratırdık.","numberInSurah":99,"juz":9,"manzil":2,"page":163,"ruku":133,"hizbQuarter":65,"sajda":false},{"number":1054,"text":"Kalblerini kapatıp mühürleriz de birşey duymazlar.","numberInSurah":100,"juz":9,"manzil":2,"page":163,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1055,"text":"İşte o kentlerin haberlerini sana anlatıyoruz. And olsun ki onlara peygamberler belgeler getirdi; önceleri yalanladıklarından ötürü inanamadılar. Allah kafirlerin kalblerini böylece kapatıp mühürler.","numberInSurah":101,"juz":9,"manzil":2,"page":163,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1056,"text":"Onların çoğunda ahde bağlılık görmedik, çoğunu fasık kimseler olarak bulduk.","numberInSurah":102,"juz":9,"manzil":2,"page":163,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1057,"text":"Sonra peygamberlerin ardından Musa'yı ayetlerimizle Firavun ve erkanına gönderdik. Ayetlerimize karşı haksızlık ettiler. Bozguncuların sonunun nasıl olduğuna bir bak.","numberInSurah":103,"juz":9,"manzil":2,"page":163,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1058,"text":"Musa, \"Ey Firavun! Ben alemlerin Rabbinin peygamberiyim.","numberInSurah":104,"juz":9,"manzil":2,"page":163,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1059,"text":"Bana Allah'a karşı ancak gerçeği söylemek yaraşır. Size Rabbinizden bir mucize getirdim, İsrailoğullarını benimle beraber gönder\" dedi.","numberInSurah":105,"juz":9,"manzil":2,"page":164,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1060,"text":"Firavun: \"Bir mucize getirdiysen ortaya koy bakalım, doğru sözlülerden isen bunu yaparsın\" dedi.","numberInSurah":106,"juz":9,"manzil":2,"page":164,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1061,"text":"Musa, asasını yere atar atmaz apaçık bir yılan (ejderha) oluverdi; elini çıkardı, bakanlar bembeyaz olduğunu gördüler.","numberInSurah":107,"juz":9,"manzil":2,"page":164,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1062,"text":"Musa, asasını yere atar atmaz apaçık bir yılan (ejderha) oluverdi; elini çıkardı, bakanlar bembeyaz olduğunu gördüler.","numberInSurah":108,"juz":9,"manzil":2,"page":164,"ruku":134,"hizbQuarter":65,"sajda":false},{"number":1063,"text":"Firavun milletinin ileri gelenleri, \"Doğrusu bu bilgin bir sihirbazdır, sizi memleketinizden çıkarmak istiyor\" dediler. Firavun: \"Ne buyurursunuz?\" dedi.","numberInSurah":109,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1064,"text":"Firavun milletinin ileri gelenleri, \"Doğrusu bu bilgin bir sihirbazdır, sizi memleketinizden çıkarmak istiyor\" dediler. Firavun: \"Ne buyurursunuz?\" dedi.","numberInSurah":110,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1065,"text":"\"Onu ve kardeşini eğle; şehirlere toplayıcılar gönder, bütün bilgin sihirbazları sana getirsinler\" dediler.","numberInSurah":111,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1066,"text":"\"Onu ve kardeşini eğle; şehirlere toplayıcılar gönder, bütün bilgin sihirbazları sana getirsinler\" dediler.","numberInSurah":112,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1067,"text":"Sihirbazlar Firavun'a geldi, \"Yenecek olursak bize şüphesiz bir mükafat var değil mi?\" dediler.","numberInSurah":113,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1068,"text":"Firavun, \"Evet, yenerseniz gözdelerden olacaksınız\" dedi.","numberInSurah":114,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1069,"text":"Sihirbazlar: \"Ey Musa! Marifetini ya sen ortaya koy veya biz koyalım\" dediler.","numberInSurah":115,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1070,"text":"Musa: \"Siz koyun\" dedi. Sihirbazlar marifetlerini ortaya koyunca insanların gözlerini sihirlediler ve onları ürküttüler, büyük bir sihir yaptılar.","numberInSurah":116,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":65,"sajda":false},{"number":1071,"text":"Biz de Musa'ya, \"Asanı koyuver\" dedik, o da koydu; hemen onların uydurduklarını yutmaya başladı.","numberInSurah":117,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1072,"text":"Hak tahakkuk etti, onların yaptıkları boşa gitti.","numberInSurah":118,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1073,"text":"İşte orada yenildiler, küçük düştüler.","numberInSurah":119,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1074,"text":"Sihirbazlar secdeye kapanıp, \"Alemlerin Rabbine, Musa ve Harun'un Rabbine inandık\" dediler.","numberInSurah":120,"juz":9,"manzil":2,"page":164,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1075,"text":"Sihirbazlar secdeye kapanıp, \"Alemlerin Rabbine, Musa ve Harun'un Rabbine inandık\" dediler.","numberInSurah":121,"juz":9,"manzil":2,"page":165,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1076,"text":"Sihirbazlar secdeye kapanıp, \"Alemlerin Rabbine, Musa ve Harun'un Rabbine inandık\" dediler.","numberInSurah":122,"juz":9,"manzil":2,"page":165,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1077,"text":"Firavun: \"Ben size izin vermeden mi O'na inandınız? Doğrusu bu, halkı şehirden çıkarmak için düzdüğünüz bir hiledir, fakat siz göreceksiniz. And olsun ki, ellerinizi ayaklarınızı çaprazlama keseceğim, sonra da hepinizi asacağım\" dedi.","numberInSurah":123,"juz":9,"manzil":2,"page":165,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1078,"text":"Firavun: \"Ben size izin vermeden mi O'na inandınız? Doğrusu bu, halkı şehirden çıkarmak için düzdüğünüz bir hiledir, fakat siz göreceksiniz. And olsun ki, ellerinizi ayaklarınızı çaprazlama keseceğim, sonra da hepinizi asacağım\" dedi.","numberInSurah":124,"juz":9,"manzil":2,"page":165,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1079,"text":"Onlar da: \"Doğrusu biz ancak Rabbimize döneriz. Rabbimizin ayetleri gelince, onlara inanmamızdan ötürü bizden öç alıyorsun. Rabbimiz! Bize sabır ver ve canımızı müslim olarak al\" dediler.","numberInSurah":125,"juz":9,"manzil":2,"page":165,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1080,"text":"Onlar da: \"Doğrusu biz ancak Rabbimize döneriz. Rabbimizin ayetleri gelince, onlara inanmamızdan ötürü bizden öç alıyorsun. Rabbimiz! Bize sabır ver ve canımızı müslim olarak al\" dediler.","numberInSurah":126,"juz":9,"manzil":2,"page":165,"ruku":135,"hizbQuarter":66,"sajda":false},{"number":1081,"text":"Firavun milletinin ileri gelenleri: \"Musa'yı ve milletini yeryüzünde bozgunculuk yapsınlar, seni ve tanrılarını bıraksınlar diye mi koyveriyorsun?\" dediler. Firavun: \"Onların oğullarını öldüreceğiz, kadınlarını sağ bırakacağız. Elbette biz onları ezecek üstünlükteyiz\" dedi.","numberInSurah":127,"juz":9,"manzil":2,"page":165,"ruku":136,"hizbQuarter":66,"sajda":false},{"number":1082,"text":"Musa milletine: \"Allah'tan yardım dileyin ve sabredin; yeryüzü şüphesiz Allah'ındır, kullarından dilediğini ona mirasçı kılar; sonuç Allah'a karşı gelmekten sakınanlarındır\" dedi.","numberInSurah":128,"juz":9,"manzil":2,"page":165,"ruku":136,"hizbQuarter":66,"sajda":false},{"number":1083,"text":"Milleti: \"Sen bize gelmeden önce de, geldikten sonra da eziyet çektik\" dediler. Musa da: \"Rabbinizin düşmanlarınızı yok etmesi ve yeryüzünde sizi onların yerine geçirmesi umulur. O zaman nasıl davranacağınıza bakar\" dedi.","numberInSurah":129,"juz":9,"manzil":2,"page":165,"ruku":136,"hizbQuarter":66,"sajda":false},{"number":1084,"text":"And olsun ki, Biz de Firavun ailesini, ders alsınlar diye, yıllarca kuraklığa ve ürün kıtlığına uğrattık.","numberInSurah":130,"juz":9,"manzil":2,"page":165,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1085,"text":"Onlara bir iyilik geldiği zaman; \"Bu bizden ötürüdür\" derler, bir fenalığa uğrarlarsa da, Musa ve onunla beraber olanların uğursuzluğuna verirlerdi. Bilin ki, kendilerinin uğradığı uğursuzluk Allah katındandır, fakat çoğu bunu bilmezler.","numberInSurah":131,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1086,"text":"Firavun ailesi: \"Bizi sihirlemek için ne mucize gösterirsen göster, sana inanmayacağız\" dediler.","numberInSurah":132,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1087,"text":"Bunun üzerine su baskınını, çekirgeyi, haşeratı, kurbağaları ve kanı birbirinden ayrı mucizeler olarak onlara musallat kıldık; yine de büyüklük taslayıp suçlu bir millet oldular.","numberInSurah":133,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1088,"text":"Azab başlarına çökünce, \"Ey Musa! Rabbine, sana verdiği ahde göre bizim için yalvar. Bizden azabı kaldırırsan sana, and olsun ki, inanacağız ve İsrailoğullarını seninle beraber göndereceğiz\"dediler.","numberInSurah":134,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1089,"text":"Azabı nasıl olsa sonuna gelecekleri bir müddet için üzerlerinden kaldırınca, hemen sözlerinden cayıyorlardı.","numberInSurah":135,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1090,"text":"Bu sebeple onlardan öç aldık, ayetlerimizi yalan sayıp umursamadıkları için onları denizde boğduk.","numberInSurah":136,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1091,"text":"Hor görülen yahudileri, bereketlendirdiğimiz yerin doğularına ve batılarına mirasçı kıldık. Rabbinin İsrailoğullarına verdiği güzel söz, sabırlarına karşılık yerine geldi. Firavun ve milletinin yaptığını ve yükselttiklerini yıktık.","numberInSurah":137,"juz":9,"manzil":2,"page":166,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1092,"text":"İsrailoğullarının denizden geçmelerini sağladık. Puta gönülden tapan bir millete rastladılar. \"Ey Musa! Onların tanrıları gibi bize de bir tanrı yap\" dediler, Musa: \" Doğrusu siz bilgisiz bir milletsiniz, bunlar yok olacaklar ve işledikleri boşa gidecektir\" dedi.","numberInSurah":138,"juz":9,"manzil":2,"page":167,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1093,"text":"İsrailoğullarının denizden geçmelerini sağladık. Puta gönülden tapan bir millete rastladılar. \"Ey Musa! Onların tanrıları gibi bize de bir tanrı yap\" dediler, Musa: \" Doğrusu siz bilgisiz bir milletsiniz, bunlar yok olacaklar ve işledikleri boşa gidecektir\" dedi.","numberInSurah":139,"juz":9,"manzil":2,"page":167,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1094,"text":"\"Sizi alemlere üstün kılmış olan Allah'tan başka bir tanrı mı arayacağım?\" dedi.","numberInSurah":140,"juz":9,"manzil":2,"page":167,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1095,"text":"Sizi kötü azaba sokan, kadınlarınızı sağ bırakıp oğullarınızı öldüren Firavun ailesinden kurtarmıştık. Bunda, size Rabbiniz tarafından büyük bir imtihan vardı.","numberInSurah":141,"juz":9,"manzil":2,"page":167,"ruku":137,"hizbQuarter":66,"sajda":false},{"number":1096,"text":"Musa'ya otuz gece vade verip sonra buna on gece daha kattık; böylece Rabbinin tayin ettiği müddet kırk geceye tamamlandı. Musa, kardeşi Harun'a, \"Milletim içinde benim yerime geç, onları ıslah et, bozguncuların yoluna gitme\" dedi.","numberInSurah":142,"juz":9,"manzil":2,"page":167,"ruku":138,"hizbQuarter":67,"sajda":false},{"number":1097,"text":"Musa, tayin ettiğimiz vakitte gelip Rabbi onunla konuşunca, Musa: \"Rabbim! Bana Kendini göster, Sana bakayım\" dedi. Allah: \"Sen Beni göremezsin ama dağa bak, eğer o yerinde kalırsa sen de Beni göreceksin\" buyurdu. Rabbi dağa tecelli edince onu yerlebir etti ve Musa da baygın düştü; ayılınca: \"Yarabbi, münezzehsin, Sana tevbe ettim, ben inananların ilkiyim\" dedi.","numberInSurah":143,"juz":9,"manzil":2,"page":167,"ruku":138,"hizbQuarter":67,"sajda":false},{"number":1098,"text":"\"Ey Musa! Verdiklerimle ve seninle konuşmamla seni insanlar arasından seçtim; sana verdiğimi al ve şükret\" dedi.","numberInSurah":144,"juz":9,"manzil":2,"page":168,"ruku":138,"hizbQuarter":67,"sajda":false},{"number":1099,"text":"Ona levhalarda her şeyden bir öğüt yazdık ve her şeyi uzun uzadıya açıkladık; onlara sıkıca sarıl, milletine de emret en güzel şekilde tutsunlar. Size Allah'a karşı gelenlerin yurdunu göstereceğim.","numberInSurah":145,"juz":9,"manzil":2,"page":168,"ruku":138,"hizbQuarter":67,"sajda":false},{"number":1100,"text":"Yeryüzünde haksız yere büyüklük taslayanları, ayetlerimden yüz çevirteceğim. Onlar bütün ayetleri görseler yine de inanmazlar; doğru yolu görseler, yol olarak benimsemezler; azgınlık yolunu görseler, hemen onu yol edinirler. Bu, onların mucizelerimizi yalan saymaları ve onlardan habersiz görünmelerinden ileri gelir.","numberInSurah":146,"juz":9,"manzil":2,"page":168,"ruku":138,"hizbQuarter":67,"sajda":false},{"number":1101,"text":"Ayetlerimizi ve ahirete kavuşmayı yalan sayan kimselerin işleri boşa gitmiştir. Onlar işlediklerinin karşılığından başka bir şeyle mi cezalanırlar?","numberInSurah":147,"juz":9,"manzil":2,"page":168,"ruku":138,"hizbQuarter":67,"sajda":false},{"number":1102,"text":"Musa'nın ardından milleti, ziynet takımlarından, canlıymış gibi böğüren bir buzağı heykeli yaparak onu tanrı edindiler. O buzağının kendileriyle konuşmadığını ve yol da göstermediğini görmediler mi? Onu tanrı olarak benimseyip kendilerine yazık ettiler.","numberInSurah":148,"juz":9,"manzil":2,"page":168,"ruku":139,"hizbQuarter":67,"sajda":false},{"number":1103,"text":"Elleri böğründe, çaresiz kalıp, kendilerinin sapıtmış olduklarını görünce: \"Eğer Rabbimiz bize acımaz ve bizi bağışlamazsa, and olsun ki mahvoluruz\" dediler.","numberInSurah":149,"juz":9,"manzil":2,"page":168,"ruku":139,"hizbQuarter":67,"sajda":false},{"number":1104,"text":"Musa, milletine, kızgın ve üzgün olarak dönünce \"Benim arkamdan ne kötü olmuşsunuz! Rabbinizin emrinin çabucak gelmesini mi istiyorsunuz?\" dedi, levhaları attı ve kardeşinin başından tutup kendine doğru çekti. Harun: \"Ey annem oğlu! Bu millet beni küçümsedi; az kalsın öldürüyorlardı. Bana, düşmanları sevindirecek şekilde davranma, beni bu zalim milletle bir sayma\" dedi.","numberInSurah":150,"juz":9,"manzil":2,"page":169,"ruku":139,"hizbQuarter":67,"sajda":false},{"number":1105,"text":"Musa \"Rabbim! Beni ve kardeşimi bağışla, bize acı, Sen merhametlilerin merhametlisisin\" dedi.","numberInSurah":151,"juz":9,"manzil":2,"page":169,"ruku":139,"hizbQuarter":67,"sajda":false},{"number":1106,"text":"Buzağıyı tanrı olarak benimseyenler Rablerinin öfkesine ve dünya hayatında alçaklığa uğrayacaklardır; iftira edenleri böylece cezalandırırız.","numberInSurah":152,"juz":9,"manzil":2,"page":169,"ruku":140,"hizbQuarter":67,"sajda":false},{"number":1107,"text":"Kötülük işleyip ardından tevbe edenler ve inananlar bilsinler ki Rabbin, bu hareketlerinin ardından onları şüphesiz bağışlar ve merhamet eder.","numberInSurah":153,"juz":9,"manzil":2,"page":169,"ruku":140,"hizbQuarter":67,"sajda":false},{"number":1108,"text":"Musa, öfkesi yatışınca, bir nüshasında Rablerinden korkanlar için doğru yol ve rahmet yazılı olan levhaları aldı.","numberInSurah":154,"juz":9,"manzil":2,"page":169,"ruku":140,"hizbQuarter":67,"sajda":false},{"number":1109,"text":"Musa, tayin ettiğimiz müddette milletinden yetmiş kişi seçti; onları sarsıntı tutunca dedi ki: \"Rabbim! Dileseydin daha önce beni ve onları yok ederdin, aramızdaki beyinsizlerin yaptıklarından ötürü bizi yok eder misin? Bu, Senin imtihanından başka birşey değildir, bununla dilediğini saptırır, dilediğini doğru yola iletirsin; bizim dostumuz Sensin; bizi bağışla, bize merhamet et. Sen bağışlayanların en iyisisin.\"","numberInSurah":155,"juz":9,"manzil":2,"page":169,"ruku":140,"hizbQuarter":67,"sajda":false},{"number":1110,"text":"\"Bu dünyada ve ahirette bizim için güzel olanı yaz; biz Sana yöneldik\" dedi. Allah: \"Azabıma dilediğim kimseyi uğratırım, rahmetim herşeyi kaplamıştır; bunu Allah'a karşı gelmekten sakınanlara, zekat verenlere, ayetlerimize inanıp, yanlarındaki Tevrat ve İncil'de yazılı buldukları, okuyup yazması olmayan peygambere uyanlara yazacağız. O peygamber, onlara, uygun olanı emreder ve fenalıktan meneder, temiz şeyleri helal, murdar şeyleri haram kılar, onların ağır yüklerini indirir, zor tekliflerini hafifletir. Bu peygambere inanan, hürmet eden, yardım eden, onunla gönderilen nura uyanlar yok mu? İşte onlar saadete erenlerdir\" dedi.","numberInSurah":156,"juz":9,"manzil":2,"page":170,"ruku":140,"hizbQuarter":68,"sajda":false},{"number":1111,"text":"\"Bu dünyada ve ahirette bizim için güzel olanı yaz; biz Sana yöneldik\" dedi. Allah: \"Azabıma dilediğim kimseyi uğratırım, rahmetim herşeyi kaplamıştır; bunu Allah'a karşı gelmekten sakınanlara, zekat verenlere, ayetlerimize inanıp, yanlarındaki Tevrat ve İncil'de yazılı buldukları, okuyup yazması olmayan peygambere uyanlara yazacağız. O peygamber, onlara, uygun olanı emreder ve fenalıktan meneder, temiz şeyleri helal, murdar şeyleri haram kılar, onların ağır yüklerini indirir, zor tekliflerini hafifletir. Bu peygambere inanan, hürmet eden, yardım eden, onunla gönderilen nura uyanlar yok mu? İşte onlar saadete erenlerdir\" dedi.","numberInSurah":157,"juz":9,"manzil":2,"page":170,"ruku":140,"hizbQuarter":68,"sajda":false},{"number":1112,"text":"De ki: \"Ey insanlar! Doğrusu ben, göklerin ve yerin hükümranı, O'ndan başka tanrı bulunmayan, dirilten ve öldüren Allah'ın, hepiniz için gönderdiği peygamberiyim. Allah'a ve okuyup yazması olmayan, haber getiren peygamberine -ki o da Allah'a ve sözlerine inanmıştır- inanın; ona uyun ki doğru yolu bulasınız.\"","numberInSurah":158,"juz":9,"manzil":2,"page":170,"ruku":141,"hizbQuarter":68,"sajda":false},{"number":1113,"text":"Musa'nın milletinden bir topluluk hakkı gösterirler ve onunla hükmederlerdi.","numberInSurah":159,"juz":9,"manzil":2,"page":170,"ruku":141,"hizbQuarter":68,"sajda":false},{"number":1114,"text":"Biz İsrailoğullarını oymaklar halinde on iki topluluğa ayırdık. Milleti Musa'dan su isteyince ona: \"Asanla taşa vur\" diye bildirdik; ondan on iki pınar fışkırdı. Herkes içeceği yeri öğrendi. Bulutla üzerlerine gölge yaptık, onlara kudret helvası ve bıldırcın indirdik, \"Size verdiğimiz rızıkların temiz olanlarından yiyin\" dedik. Onlar, karşı gelmekle, Bize değil kendilerine zulmediyorlardı.","numberInSurah":160,"juz":9,"manzil":2,"page":171,"ruku":141,"hizbQuarter":68,"sajda":false},{"number":1115,"text":"Onlara: \"Şu şehirde oturun, dilediğiniz gibi yiyip için, \"affet!\" deyin ve secde ederek kapısından girin; Biz de yanılmalarınızı bağışlarız. İyi davrananlara daha da artıracağız\" denmişti.","numberInSurah":161,"juz":9,"manzil":2,"page":171,"ruku":141,"hizbQuarter":68,"sajda":false},{"number":1116,"text":"Onların zulmedenleri, kendilerine söylenen sözü başkasiyle değiştirdiler. Biz de, o zalimlere, zulümlerinden ötürü gökten azab indirdik.","numberInSurah":162,"juz":9,"manzil":2,"page":171,"ruku":141,"hizbQuarter":68,"sajda":false},{"number":1117,"text":"Onlara, deniz kıyısındaki kasabanın durumunu sor. Cumartesi yasaklarına tecavüz ediyorlardı. Cumartesileri balıklar sürüyle geliyor, başka günler gelmiyorlardı. Biz onları, yoldan çıkmaları sebebiyle böylece deniyorduk.","numberInSurah":163,"juz":9,"manzil":2,"page":171,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1118,"text":"Aralarından bir topluluk: \"Allah'ın yok edeceği veya şiddetli azaba uğratacağı bir millete niçin öğüt veriyorsunuz?\" dediler. Öğüt verenler: \"Rabbinize, hiç değilse bir özür beyan edebilmemiz içindir, belki Allah'a karşı gelmekten sakınırlar\" dediler.","numberInSurah":164,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1119,"text":"Kendilerine yapılan öğütleri unutunca, Biz fenalıktan menedenleri kurtardık ve zalimleri, Allah'a karşı gelmelerinden ötürü şiddetli azaba uğrattık.","numberInSurah":165,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1120,"text":"Kendilerine edilen yasakları aşınca, onlara: \"Aşağılık birer maymun olun\" dedik.","numberInSurah":166,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1121,"text":"Rabbin, kıyamet gününe kadar, onları, kötü azaba uğratacak kimseleri üzerlerine göndereceğini bildirmişti. Doğrusu Rabbin, cezayı çabuk verir. Doğrusu O bağışlar ve merhamet eder.","numberInSurah":167,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1122,"text":"Biz onları yeryüzünde iyiler ve aşağılıklar olarak bölük bölük ayırdık; iyiliğe dönerler diye onları güzellikler ve kötülüklerle sınadık.","numberInSurah":168,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1123,"text":"Ardlarından yerlerine gelen bir takım kötüler, Kitap'a mirasçı oldular. \"Biz nasıl olsa affedileceğiz\" diyerek Kitap'ın hükümlerini değiştirme karşılığı bu değersiz dünyanın mallarını alırlar; yine ona benzer geçici bir şey kendilerine gelince onu da kabul ederlerdi. Onlardan, Allah'a karşı ancak gerçeği söyleyeceklerine dair Kitap üzerine söz alınmamış mıydı? Kitap'da olanları okumamışlar mıydı? Allah'a karşı gelmekten sakınanlar için, ahiret yurdu vardır, düşünmüyor musunuz? Biz, iyiliğe çalışanların ecrini elbette zayi etmeyiz.","numberInSurah":169,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1124,"text":"Ardlarından yerlerine gelen bir takım kötüler, Kitap'a mirasçı oldular. \"Biz nasıl olsa affedileceğiz\" diyerek Kitap'ın hükümlerini değiştirme karşılığı bu değersiz dünyanın mallarını alırlar; yine ona benzer geçici bir şey kendilerine gelince onu da kabul ederlerdi. Onlardan, Allah'a karşı ancak gerçeği söyleyeceklerine dair Kitap üzerine söz alınmamış mıydı? Kitap'da olanları okumamışlar mıydı? Allah'a karşı gelmekten sakınanlar için, ahiret yurdu vardır, düşünmüyor musunuz? Biz, iyiliğe çalışanların ecrini elbette zayi etmeyiz.","numberInSurah":170,"juz":9,"manzil":2,"page":172,"ruku":142,"hizbQuarter":68,"sajda":false},{"number":1125,"text":"Tur dağını, gölgelik gibi onların üzerlerine yükseltmiştik, onlar tepelerine düşeceğini sanmışlardı. Onlara: \"Size verdiğimiz Kitap'a sıkıca sarılın, içinde olanı düşünün ki sakınanlardan olasınız\" demiştik.","numberInSurah":171,"juz":9,"manzil":2,"page":173,"ruku":142,"hizbQuarter":69,"sajda":false},{"number":1126,"text":"Rabbin, insanoğlunun sulbünden soyunu alıp devam ettirmiş, onlara: \"Ben sizin Rabbiniz değil miyim\" demiş ve buna kendilerini şahit tutmuştu. Onlar da: \"Evet şahidiz\" demişlerdi. Bu, kıyamet günü, \"Bizim bundan haberimiz yoktu\" dersiniz veya \"Daha önce babalarımız Allah'a ortak koşmuşlardı, biz de onlardan sonra gelen bir soyuz, bizi, boşa çalışanların yaptıklarından ötürü yok eder misin?\" dersiniz diyedir.","numberInSurah":172,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1127,"text":"Rabbin, insanoğlunun sulbünden soyunu alıp devam ettirmiş, onlara: \"Ben sizin Rabbiniz değil miyim\" demiş ve buna kendilerini şahit tutmuştu. Onlar da: \"Evet şahidiz\" demişlerdi. Bu, kıyamet günü, \"Bizim bundan haberimiz yoktu\" dersiniz veya \"Daha önce babalarımız Allah'a ortak koşmuşlardı, biz de onlardan sonra gelen bir soyuz, bizi, boşa çalışanların yaptıklarından ötürü yok eder misin?\" dersiniz diyedir.","numberInSurah":173,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1128,"text":"Belki doğru yola dönerler diye ayetleri böylece uzun uzadıya açıklıyoruz.","numberInSurah":174,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1129,"text":"Onlara, şeytanın peşine takdığı ve kendisine verdiğimiz ayetlerden sıyrılarak azgınlıklardan olan kişinin olayını anlat.","numberInSurah":175,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1130,"text":"Dileseydik, onu ayetlerimizle üstün kılardık; fakat o, dünyaya meyletti ve hevesine uydu. Durumu, üstüne varsan da, kendi haline bıraksan da, dilini sarkıtıp soluyan köpeğin durumu gibidir. İşte ayetlerimizi yalan sayan kimselerin hali böyledir. Sen onlara bu kıssayı anlat, belki üzerinde düşünürler.","numberInSurah":176,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1131,"text":"Ayetlerimizi yalan sayan, kendine zulmeden millet ne kötü bir misaldir!","numberInSurah":177,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1132,"text":"Allah'ın doğru yola sevkettiği kimse doğru yolda olur. Saptırdığı kimseler ise, işte onlar mahvolanlardır.","numberInSurah":178,"juz":9,"manzil":2,"page":173,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1133,"text":"And olsun ki, cehennem için de birçok cin ve insan yarattık; onların kalbleri vardır ama anlamazlar; gözleri vardır ama görmezler; kulakları vardır ama işitmezler. İşte bunlar hayvanlar gibi hatta daha sapıktırlar. İşte bunlar gafillerdir.","numberInSurah":179,"juz":9,"manzil":2,"page":174,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1134,"text":"En güzel isimler Allah'ındır, O'na o isimlerle dua edin, O'nun isimleri konusunda eğriliğe sapanları bırakın. Onlar yaptıklarının cezasını göreceklerdir.","numberInSurah":180,"juz":9,"manzil":2,"page":174,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1135,"text":"Yarattıklarımızdan bir topluluk hakkı gösterirler ve onunla hükmederler.","numberInSurah":181,"juz":9,"manzil":2,"page":174,"ruku":143,"hizbQuarter":69,"sajda":false},{"number":1136,"text":"Ayetlerimizi yalan sayanları, bilmedikleri yönden, ağır ağır sonuçlarına yaklaştıracağız.","numberInSurah":182,"juz":9,"manzil":2,"page":174,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1137,"text":"Onlara mahsustan mühlet veririm, çünkü Benim düzenim çetindir.","numberInSurah":183,"juz":9,"manzil":2,"page":174,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1138,"text":"Düşünmüyorlar mı ki, arkadaşları olan peygamberde deliliğin eseri yoktur. O ancak açıkça uyaran bir kimsedir.","numberInSurah":184,"juz":9,"manzil":2,"page":174,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1139,"text":"Göklerin ve yerin hükümranlığını, Allah'ın yarattığı her şeyi ve ecellerinin yaklaşmış olması ihtimalini düşünmüyorlar mı? Bundan sonra hangi söze inanacaklar?","numberInSurah":185,"juz":9,"manzil":2,"page":174,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1140,"text":"Allah'ın saptırdığını yola getirecek yoktur. O, sapanları taşkınlıkları içinde bocalayıp dururlarken bırakır.","numberInSurah":186,"juz":9,"manzil":2,"page":174,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1141,"text":"Sana, kıyamet saatinin ne zaman gelip çatacağını soruyorlar, de ki: \"Onu ancak Rabbim bilir, onun vaktini, O'ndan başka belirtecek yoktur. Göklerin ve yerin, ağırlığını kaldıramayacağı o saat, sizlere ansızın gelecektir.\" Sen sanki öğrenmişsin gibi sana soruyorlar, de ki: \"Onu bilmek ancak Allah'a mahsustur, ama insanların çoğu bu gerçeği bilmezler.\"","numberInSurah":187,"juz":9,"manzil":2,"page":174,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1142,"text":"De ki: \"Allah'ın dilemesi dışında ben kendime bir fayda ve zarar verecek durumda değilim. Görülmeyeni bileydim, daha çok iyilik yapardım ve bana kötülük de gelmezdi. Ben sadece, inanan bir milleti uyaran ve müjdeleyen bir peygamberim.\"","numberInSurah":188,"juz":9,"manzil":2,"page":175,"ruku":144,"hizbQuarter":69,"sajda":false},{"number":1143,"text":"Sizi bir nefisten yaratan ve gönlünün huzura kavuşacağı eşini de ondan var eden Allah'tır. Eşine yaklaşınca, eşi hafif bir yük yüklendi ve bu halde bir müddet taşıdı. Hamileliği ağırlaşınca, karı-koca, Rableri olan Allah'a: \"Bize kusursuz bir çocuk verirsen, and olsun ki şükredenlerden oluruz\" diye yalvardılar.","numberInSurah":189,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1144,"text":"Allah onlara kusursuz bir çocuk verince, kendilerine verdiği şey hakkında Allah'a ortaklar koştular. Allah, onların ortak koştukları şeylerden yücedir.","numberInSurah":190,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1145,"text":"Kendileri yaratılmışken, bir şey yaratamayan putları mı ortak koşuyorlar?","numberInSurah":191,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1146,"text":"Oysa putlar ne onlara yardım edebilir ve ne de kendilerine bir yardımları olur.","numberInSurah":192,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1147,"text":"Onları doğru yola çağırırsanız, size uymazlar; çağırmanız da, susmanız da onlar için birdir.","numberInSurah":193,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1148,"text":"Allah'tan başka taptıklarınız putlar da, sizin gibi yaratıklardır. Eğer doğru sözlü iseniz, onları çağırın da size cevap versinler bakalım.","numberInSurah":194,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1149,"text":"Onların yürüyecek ayakları mı var, yoksa tutacak elleri mi var, ya da görecek gözleri mi var, veya işitecek kulakları mı var? De ki: \"Ortaklarınızı çağırın elinizden gelirse bana tuzak kurun, göz açtırmayın.\"","numberInSurah":195,"juz":9,"manzil":2,"page":175,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1150,"text":"\"Çünkü benim dostum, Kitap'ı indiren Allah'tır. O, iyileri dost edinir.\"","numberInSurah":196,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1151,"text":"\"O'nu bırakıp da taptıklarınız, kendilerine yardım edemezler ki size yardım etsinler.\"","numberInSurah":197,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1152,"text":"Onları doğru yola çağırırsanız duymazlar. Sana baktıklarını görürsün, oysa görmezler.","numberInSurah":198,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1153,"text":"Sen af yolunu tut, bağışla, uygun olanı emret, bilgisizlere aldırış etme.","numberInSurah":199,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1154,"text":"Şeytan seni dürtecek olursa Allah'a sığın, doğrusu O işitir ve bilir.","numberInSurah":200,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1155,"text":"Allah'a karşı gelmekten sakınanlar, şeytan tarafından bir vesveseye uğrayınca, Allah'ı anarlar ve hemen gerçeği görürler.","numberInSurah":201,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1156,"text":"Şeytanın kardeşleri onları azgınlığa sürüklerler ve bundan hiç geri durmazlar.","numberInSurah":202,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1157,"text":"Onlara bir ayet getirmediğin zaman, \"Sen bir tane yapsaydın ya\" derler. De ki: \"Ben ancak Rabbim tarafından bana vahyolunana uyarım. Bu Kitap inanan millete Rabbinizden açık belgeler, yol gösterme ve rahmettir.\"","numberInSurah":203,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1158,"text":"Kuran okunduğu zaman ona kulak verin, dinleyin ki merhamet olunasınız.","numberInSurah":204,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1159,"text":"Rabbini gönülden ve korkarak içinden hafif bir sesle sabah akşam an, gafillerden olma.","numberInSurah":205,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":false},{"number":1160,"text":"Doğrusu Rabbinin katında olanlar, O'na kulluk etmekten büyüklenmezler, O'nu tenzih ederler ve yalnız O'na secde ederler.","numberInSurah":206,"juz":9,"manzil":2,"page":176,"ruku":145,"hizbQuarter":70,"sajda":{"id":1,"recommended":true,"obligatory":false}}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}