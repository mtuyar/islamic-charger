{"arabic":{"number":42,"name":"سُورَةُ الشُّورَىٰ","englishName":"Şûrâ","englishNameTranslation":"Consultation","revelationType":"Meccan","numberOfAyahs":53,"ayahs":[{"number":4273,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ حم","numberInSurah":1,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4274,"text":"عسق","numberInSurah":2,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4275,"text":"كَذَٰلِكَ يُوحِي إِلَيْكَ وَإِلَى الَّذِينَ مِنْ قَبْلِكَ اللَّهُ الْعَزِيزُ الْحَكِيمُ","numberInSurah":3,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4276,"text":"لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۖ وَهُوَ الْعَلِيُّ الْعَظِيمُ","numberInSurah":4,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4277,"text":"تَكَادُ السَّمَاوَاتُ يَتَفَطَّرْنَ مِنْ فَوْقِهِنَّ ۚ وَالْمَلَائِكَةُ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيَسْتَغْفِرُونَ لِمَنْ فِي الْأَرْضِ ۗ أَلَا إِنَّ اللَّهَ هُوَ الْغَفُورُ الرَّحِيمُ","numberInSurah":5,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4278,"text":"وَالَّذِينَ اتَّخَذُوا مِنْ دُونِهِ أَوْلِيَاءَ اللَّهُ حَفِيظٌ عَلَيْهِمْ وَمَا أَنْتَ عَلَيْهِمْ بِوَكِيلٍ","numberInSurah":6,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4279,"text":"وَكَذَٰلِكَ أَوْحَيْنَا إِلَيْكَ قُرْآنًا عَرَبِيًّا لِتُنْذِرَ أُمَّ الْقُرَىٰ وَمَنْ حَوْلَهَا وَتُنْذِرَ يَوْمَ الْجَمْعِ لَا رَيْبَ فِيهِ ۚ فَرِيقٌ فِي الْجَنَّةِ وَفَرِيقٌ فِي السَّعِيرِ","numberInSurah":7,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4280,"text":"وَلَوْ شَاءَ اللَّهُ لَجَعَلَهُمْ أُمَّةً وَاحِدَةً وَلَٰكِنْ يُدْخِلُ مَنْ يَشَاءُ فِي رَحْمَتِهِ ۚ وَالظَّالِمُونَ مَا لَهُمْ مِنْ وَلِيٍّ وَلَا نَصِيرٍ","numberInSurah":8,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4281,"text":"أَمِ اتَّخَذُوا مِنْ دُونِهِ أَوْلِيَاءَ ۖ فَاللَّهُ هُوَ الْوَلِيُّ وَهُوَ يُحْيِي الْمَوْتَىٰ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":9,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4282,"text":"وَمَا اخْتَلَفْتُمْ فِيهِ مِنْ شَيْءٍ فَحُكْمُهُ إِلَى اللَّهِ ۚ ذَٰلِكُمُ اللَّهُ رَبِّي عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ","numberInSurah":10,"juz":25,"manzil":6,"page":483,"ruku":420,"hizbQuarter":193,"sajda":false},{"number":4283,"text":"فَاطِرُ السَّمَاوَاتِ وَالْأَرْضِ ۚ جَعَلَ لَكُمْ مِنْ أَنْفُسِكُمْ أَزْوَاجًا وَمِنَ الْأَنْعَامِ أَزْوَاجًا ۖ يَذْرَؤُكُمْ فِيهِ ۚ لَيْسَ كَمِثْلِهِ شَيْءٌ ۖ وَهُوَ السَّمِيعُ الْبَصِيرُ","numberInSurah":11,"juz":25,"manzil":6,"page":484,"ruku":420,"hizbQuarter":193,"sajda":false},{"number":4284,"text":"لَهُ مَقَالِيدُ السَّمَاوَاتِ وَالْأَرْضِ ۖ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ ۚ إِنَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ","numberInSurah":12,"juz":25,"manzil":6,"page":484,"ruku":420,"hizbQuarter":193,"sajda":false},{"number":4285,"text":"۞ شَرَعَ لَكُمْ مِنَ الدِّينِ مَا وَصَّىٰ بِهِ نُوحًا وَالَّذِي أَوْحَيْنَا إِلَيْكَ وَمَا وَصَّيْنَا بِهِ إِبْرَاهِيمَ وَمُوسَىٰ وَعِيسَىٰ ۖ أَنْ أَقِيمُوا الدِّينَ وَلَا تَتَفَرَّقُوا فِيهِ ۚ كَبُرَ عَلَى الْمُشْرِكِينَ مَا تَدْعُوهُمْ إِلَيْهِ ۚ اللَّهُ يَجْتَبِي إِلَيْهِ مَنْ يَشَاءُ وَيَهْدِي إِلَيْهِ مَنْ يُنِيبُ","numberInSurah":13,"juz":25,"manzil":6,"page":484,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4286,"text":"وَمَا تَفَرَّقُوا إِلَّا مِنْ بَعْدِ مَا جَاءَهُمُ الْعِلْمُ بَغْيًا بَيْنَهُمْ ۚ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ إِلَىٰ أَجَلٍ مُسَمًّى لَقُضِيَ بَيْنَهُمْ ۚ وَإِنَّ الَّذِينَ أُورِثُوا الْكِتَابَ مِنْ بَعْدِهِمْ لَفِي شَكٍّ مِنْهُ مُرِيبٍ","numberInSurah":14,"juz":25,"manzil":6,"page":484,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4287,"text":"فَلِذَٰلِكَ فَادْعُ ۖ وَاسْتَقِمْ كَمَا أُمِرْتَ ۖ وَلَا تَتَّبِعْ أَهْوَاءَهُمْ ۖ وَقُلْ آمَنْتُ بِمَا أَنْزَلَ اللَّهُ مِنْ كِتَابٍ ۖ وَأُمِرْتُ لِأَعْدِلَ بَيْنَكُمُ ۖ اللَّهُ رَبُّنَا وَرَبُّكُمْ ۖ لَنَا أَعْمَالُنَا وَلَكُمْ أَعْمَالُكُمْ ۖ لَا حُجَّةَ بَيْنَنَا وَبَيْنَكُمُ ۖ اللَّهُ يَجْمَعُ بَيْنَنَا ۖ وَإِلَيْهِ الْمَصِيرُ","numberInSurah":15,"juz":25,"manzil":6,"page":484,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4288,"text":"وَالَّذِينَ يُحَاجُّونَ فِي اللَّهِ مِنْ بَعْدِ مَا اسْتُجِيبَ لَهُ حُجَّتُهُمْ دَاحِضَةٌ عِنْدَ رَبِّهِمْ وَعَلَيْهِمْ غَضَبٌ وَلَهُمْ عَذَابٌ شَدِيدٌ","numberInSurah":16,"juz":25,"manzil":6,"page":485,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4289,"text":"اللَّهُ الَّذِي أَنْزَلَ الْكِتَابَ بِالْحَقِّ وَالْمِيزَانَ ۗ وَمَا يُدْرِيكَ لَعَلَّ السَّاعَةَ قَرِيبٌ","numberInSurah":17,"juz":25,"manzil":6,"page":485,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4290,"text":"يَسْتَعْجِلُ بِهَا الَّذِينَ لَا يُؤْمِنُونَ بِهَا ۖ وَالَّذِينَ آمَنُوا مُشْفِقُونَ مِنْهَا وَيَعْلَمُونَ أَنَّهَا الْحَقُّ ۗ أَلَا إِنَّ الَّذِينَ يُمَارُونَ فِي السَّاعَةِ لَفِي ضَلَالٍ بَعِيدٍ","numberInSurah":18,"juz":25,"manzil":6,"page":485,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4291,"text":"اللَّهُ لَطِيفٌ بِعِبَادِهِ يَرْزُقُ مَنْ يَشَاءُ ۖ وَهُوَ الْقَوِيُّ الْعَزِيزُ","numberInSurah":19,"juz":25,"manzil":6,"page":485,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4292,"text":"مَنْ كَانَ يُرِيدُ حَرْثَ الْآخِرَةِ نَزِدْ لَهُ فِي حَرْثِهِ ۖ وَمَنْ كَانَ يُرِيدُ حَرْثَ الدُّنْيَا نُؤْتِهِ مِنْهَا وَمَا لَهُ فِي الْآخِرَةِ مِنْ نَصِيبٍ","numberInSurah":20,"juz":25,"manzil":6,"page":485,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4293,"text":"أَمْ لَهُمْ شُرَكَاءُ شَرَعُوا لَهُمْ مِنَ الدِّينِ مَا لَمْ يَأْذَنْ بِهِ اللَّهُ ۚ وَلَوْلَا كَلِمَةُ الْفَصْلِ لَقُضِيَ بَيْنَهُمْ ۗ وَإِنَّ الظَّالِمِينَ لَهُمْ عَذَابٌ أَلِيمٌ","numberInSurah":21,"juz":25,"manzil":6,"page":485,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4294,"text":"تَرَى الظَّالِمِينَ مُشْفِقِينَ مِمَّا كَسَبُوا وَهُوَ وَاقِعٌ بِهِمْ ۗ وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فِي رَوْضَاتِ الْجَنَّاتِ ۖ لَهُمْ مَا يَشَاءُونَ عِنْدَ رَبِّهِمْ ۚ ذَٰلِكَ هُوَ الْفَضْلُ الْكَبِيرُ","numberInSurah":22,"juz":25,"manzil":6,"page":485,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4295,"text":"ذَٰلِكَ الَّذِي يُبَشِّرُ اللَّهُ عِبَادَهُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ ۗ قُلْ لَا أَسْأَلُكُمْ عَلَيْهِ أَجْرًا إِلَّا الْمَوَدَّةَ فِي الْقُرْبَىٰ ۗ وَمَنْ يَقْتَرِفْ حَسَنَةً نَزِدْ لَهُ فِيهَا حُسْنًا ۚ إِنَّ اللَّهَ غَفُورٌ شَكُورٌ","numberInSurah":23,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4296,"text":"أَمْ يَقُولُونَ افْتَرَىٰ عَلَى اللَّهِ كَذِبًا ۖ فَإِنْ يَشَإِ اللَّهُ يَخْتِمْ عَلَىٰ قَلْبِكَ ۗ وَيَمْحُ اللَّهُ الْبَاطِلَ وَيُحِقُّ الْحَقَّ بِكَلِمَاتِهِ ۚ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","numberInSurah":24,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4297,"text":"وَهُوَ الَّذِي يَقْبَلُ التَّوْبَةَ عَنْ عِبَادِهِ وَيَعْفُو عَنِ السَّيِّئَاتِ وَيَعْلَمُ مَا تَفْعَلُونَ","numberInSurah":25,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4298,"text":"وَيَسْتَجِيبُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَيَزِيدُهُمْ مِنْ فَضْلِهِ ۚ وَالْكَافِرُونَ لَهُمْ عَذَابٌ شَدِيدٌ","numberInSurah":26,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4299,"text":"۞ وَلَوْ بَسَطَ اللَّهُ الرِّزْقَ لِعِبَادِهِ لَبَغَوْا فِي الْأَرْضِ وَلَٰكِنْ يُنَزِّلُ بِقَدَرٍ مَا يَشَاءُ ۚ إِنَّهُ بِعِبَادِهِ خَبِيرٌ بَصِيرٌ","numberInSurah":27,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":195,"sajda":false},{"number":4300,"text":"وَهُوَ الَّذِي يُنَزِّلُ الْغَيْثَ مِنْ بَعْدِ مَا قَنَطُوا وَيَنْشُرُ رَحْمَتَهُ ۚ وَهُوَ الْوَلِيُّ الْحَمِيدُ","numberInSurah":28,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":195,"sajda":false},{"number":4301,"text":"وَمِنْ آيَاتِهِ خَلْقُ السَّمَاوَاتِ وَالْأَرْضِ وَمَا بَثَّ فِيهِمَا مِنْ دَابَّةٍ ۚ وَهُوَ عَلَىٰ جَمْعِهِمْ إِذَا يَشَاءُ قَدِيرٌ","numberInSurah":29,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":195,"sajda":false},{"number":4302,"text":"وَمَا أَصَابَكُمْ مِنْ مُصِيبَةٍ فَبِمَا كَسَبَتْ أَيْدِيكُمْ وَيَعْفُو عَنْ كَثِيرٍ","numberInSurah":30,"juz":25,"manzil":6,"page":486,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4303,"text":"وَمَا أَنْتُمْ بِمُعْجِزِينَ فِي الْأَرْضِ ۖ وَمَا لَكُمْ مِنْ دُونِ اللَّهِ مِنْ وَلِيٍّ وَلَا نَصِيرٍ","numberInSurah":31,"juz":25,"manzil":6,"page":486,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4304,"text":"وَمِنْ آيَاتِهِ الْجَوَارِ فِي الْبَحْرِ كَالْأَعْلَامِ","numberInSurah":32,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4305,"text":"إِنْ يَشَأْ يُسْكِنِ الرِّيحَ فَيَظْلَلْنَ رَوَاكِدَ عَلَىٰ ظَهْرِهِ ۚ إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِكُلِّ صَبَّارٍ شَكُورٍ","numberInSurah":33,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4306,"text":"أَوْ يُوبِقْهُنَّ بِمَا كَسَبُوا وَيَعْفُ عَنْ كَثِيرٍ","numberInSurah":34,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4307,"text":"وَيَعْلَمَ الَّذِينَ يُجَادِلُونَ فِي آيَاتِنَا مَا لَهُمْ مِنْ مَحِيصٍ","numberInSurah":35,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4308,"text":"فَمَا أُوتِيتُمْ مِنْ شَيْءٍ فَمَتَاعُ الْحَيَاةِ الدُّنْيَا ۖ وَمَا عِنْدَ اللَّهِ خَيْرٌ وَأَبْقَىٰ لِلَّذِينَ آمَنُوا وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ","numberInSurah":36,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4309,"text":"وَالَّذِينَ يَجْتَنِبُونَ كَبَائِرَ الْإِثْمِ وَالْفَوَاحِشَ وَإِذَا مَا غَضِبُوا هُمْ يَغْفِرُونَ","numberInSurah":37,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4310,"text":"وَالَّذِينَ اسْتَجَابُوا لِرَبِّهِمْ وَأَقَامُوا الصَّلَاةَ وَأَمْرُهُمْ شُورَىٰ بَيْنَهُمْ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ","numberInSurah":38,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4311,"text":"وَالَّذِينَ إِذَا أَصَابَهُمُ الْبَغْيُ هُمْ يَنْتَصِرُونَ","numberInSurah":39,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4312,"text":"وَجَزَاءُ سَيِّئَةٍ سَيِّئَةٌ مِثْلُهَا ۖ فَمَنْ عَفَا وَأَصْلَحَ فَأَجْرُهُ عَلَى اللَّهِ ۚ إِنَّهُ لَا يُحِبُّ الظَّالِمِينَ","numberInSurah":40,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4313,"text":"وَلَمَنِ انْتَصَرَ بَعْدَ ظُلْمِهِ فَأُولَٰئِكَ مَا عَلَيْهِمْ مِنْ سَبِيلٍ","numberInSurah":41,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4314,"text":"إِنَّمَا السَّبِيلُ عَلَى الَّذِينَ يَظْلِمُونَ النَّاسَ وَيَبْغُونَ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ ۚ أُولَٰئِكَ لَهُمْ عَذَابٌ أَلِيمٌ","numberInSurah":42,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4315,"text":"وَلَمَنْ صَبَرَ وَغَفَرَ إِنَّ ذَٰلِكَ لَمِنْ عَزْمِ الْأُمُورِ","numberInSurah":43,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4316,"text":"وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ وَلِيٍّ مِنْ بَعْدِهِ ۗ وَتَرَى الظَّالِمِينَ لَمَّا رَأَوُا الْعَذَابَ يَقُولُونَ هَلْ إِلَىٰ مَرَدٍّ مِنْ سَبِيلٍ","numberInSurah":44,"juz":25,"manzil":6,"page":487,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4317,"text":"وَتَرَاهُمْ يُعْرَضُونَ عَلَيْهَا خَاشِعِينَ مِنَ الذُّلِّ يَنْظُرُونَ مِنْ طَرْفٍ خَفِيٍّ ۗ وَقَالَ الَّذِينَ آمَنُوا إِنَّ الْخَاسِرِينَ الَّذِينَ خَسِرُوا أَنْفُسَهُمْ وَأَهْلِيهِمْ يَوْمَ الْقِيَامَةِ ۗ أَلَا إِنَّ الظَّالِمِينَ فِي عَذَابٍ مُقِيمٍ","numberInSurah":45,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4318,"text":"وَمَا كَانَ لَهُمْ مِنْ أَوْلِيَاءَ يَنْصُرُونَهُمْ مِنْ دُونِ اللَّهِ ۗ وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ سَبِيلٍ","numberInSurah":46,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4319,"text":"اسْتَجِيبُوا لِرَبِّكُمْ مِنْ قَبْلِ أَنْ يَأْتِيَ يَوْمٌ لَا مَرَدَّ لَهُ مِنَ اللَّهِ ۚ مَا لَكُمْ مِنْ مَلْجَإٍ يَوْمَئِذٍ وَمَا لَكُمْ مِنْ نَكِيرٍ","numberInSurah":47,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4320,"text":"فَإِنْ أَعْرَضُوا فَمَا أَرْسَلْنَاكَ عَلَيْهِمْ حَفِيظًا ۖ إِنْ عَلَيْكَ إِلَّا الْبَلَاغُ ۗ وَإِنَّا إِذَا أَذَقْنَا الْإِنْسَانَ مِنَّا رَحْمَةً فَرِحَ بِهَا ۖ وَإِنْ تُصِبْهُمْ سَيِّئَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ فَإِنَّ الْإِنْسَانَ كَفُورٌ","numberInSurah":48,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4321,"text":"لِلَّهِ مُلْكُ السَّمَاوَاتِ وَالْأَرْضِ ۚ يَخْلُقُ مَا يَشَاءُ ۚ يَهَبُ لِمَنْ يَشَاءُ إِنَاثًا وَيَهَبُ لِمَنْ يَشَاءُ الذُّكُورَ","numberInSurah":49,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4322,"text":"أَوْ يُزَوِّجُهُمْ ذُكْرَانًا وَإِنَاثًا ۖ وَيَجْعَلُ مَنْ يَشَاءُ عَقِيمًا ۚ إِنَّهُ عَلِيمٌ قَدِيرٌ","numberInSurah":50,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4323,"text":"۞ وَمَا كَانَ لِبَشَرٍ أَنْ يُكَلِّمَهُ اللَّهُ إِلَّا وَحْيًا أَوْ مِنْ وَرَاءِ حِجَابٍ أَوْ يُرْسِلَ رَسُولًا فَيُوحِيَ بِإِذْنِهِ مَا يَشَاءُ ۚ إِنَّهُ عَلِيٌّ حَكِيمٌ","numberInSurah":51,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":196,"sajda":false},{"number":4324,"text":"وَكَذَٰلِكَ أَوْحَيْنَا إِلَيْكَ رُوحًا مِنْ أَمْرِنَا ۚ مَا كُنْتَ تَدْرِي مَا الْكِتَابُ وَلَا الْإِيمَانُ وَلَٰكِنْ جَعَلْنَاهُ نُورًا نَهْدِي بِهِ مَنْ نَشَاءُ مِنْ عِبَادِنَا ۚ وَإِنَّكَ لَتَهْدِي إِلَىٰ صِرَاطٍ مُسْتَقِيمٍ","numberInSurah":52,"juz":25,"manzil":6,"page":489,"ruku":423,"hizbQuarter":196,"sajda":false},{"number":4325,"text":"صِرَاطِ اللَّهِ الَّذِي لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ أَلَا إِلَى اللَّهِ تَصِيرُ الْأُمُورُ","numberInSurah":53,"juz":25,"manzil":6,"page":489,"ruku":423,"hizbQuarter":196,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":42,"name":"سُورَةُ الشُّورَىٰ","englishName":"Şûrâ","englishNameTranslation":"Consultation","revelationType":"Meccan","numberOfAyahs":53,"ayahs":[{"number":4273,"text":"Ha, Mim.","numberInSurah":1,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4274,"text":"Ayn, Sin, Kaf,","numberInSurah":2,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4275,"text":"Güçlü olan, Hakim olan Allah, sana da, senden öncekilere de böyle vahyeder.","numberInSurah":3,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4276,"text":"Göklerde olanlar da, yerde olanlar da O'nundur. O, çok yücedir ve büyüktür.","numberInSurah":4,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4277,"text":"Gökler neredeyse üstlerinden çatlayacak. Melekler Rablerini överek tesbih eder ve yeryüzünde bulunanlar için O'ndan bağışlanma dilerler. İyi bilin ki Allah Şüphesiz bağışlayandır, merhametli olandır.","numberInSurah":5,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4278,"text":"Allah'ı bırakıp da dostlar edinenlerin işlediklerini Allah gözetlemektedir. Sen, onlara vekil olmağa memur değilsin.","numberInSurah":6,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4279,"text":"Böylece şehirlerin anası olan Mekke'de ve çevresinde bulunanları uyarman, şüphe götürmeyen toplanma günü ile uyarman için sana Arapça okunan bir Kitap vahyettik. İnsanların bir takımı cennete, bir takımı da çılgın alevli cehenneme girer.","numberInSurah":7,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4280,"text":"Eğer dilemiş olsaydı hepsini bir tek ümmet yapardı. Ama, O, rahmetine dilediğini kavuşturur. Zalimlerin ise bir dost ve yardımcısı olmaz.","numberInSurah":8,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4281,"text":"Demek onlar Allah'tan başka dostlar edindiler? Oysa dost, ancak Allah'tır. O, ölüleri diriltir. Her şeye Kadir'dir.","numberInSurah":9,"juz":25,"manzil":6,"page":483,"ruku":419,"hizbQuarter":193,"sajda":false},{"number":4282,"text":"Ayrılığa düştüğünüz herhangi bir şeyde hüküm vermek, Allah'a aittir; \"İşte bu Allah, benim Rabbimdir. O'na güvenirim ve O'na yönelirim.\" (demek gerekir)","numberInSurah":10,"juz":25,"manzil":6,"page":483,"ruku":420,"hizbQuarter":193,"sajda":false},{"number":4283,"text":"Göklerin ve yerin yaratanı, size içinizden eşler, çift çift hayvanlar var etmiştir. Bu suretle, çoğalmanızı sağlamıştır. O'nun benzeri hiçbir şey yoktur. O, işitendir, görendir.","numberInSurah":11,"juz":25,"manzil":6,"page":484,"ruku":420,"hizbQuarter":193,"sajda":false},{"number":4284,"text":"Göklerin ve yerin kilitleri O'nundur. Dilediğine rızkı yayar ve isterse kısar, bir ölçüye göre verir. Doğrusu O herşeyi bilendir.","numberInSurah":12,"juz":25,"manzil":6,"page":484,"ruku":420,"hizbQuarter":193,"sajda":false},{"number":4285,"text":"Allah Nuh'a buyurduğu şeyleri size de din olarak buyurmuştur. Sana vahyettik; İbrahim'e, Musa'ya ve İsa'ya da buyurduk ki: \"Dine bağlı kalın, onda ayrılığa düşmeyin.\" Ortak koşanları çağırdığın şey onların gözünde büyümektedir. Allah dilediğini kendine seçer, kendisine yöneleni de doğru yola eriştirir.","numberInSurah":13,"juz":25,"manzil":6,"page":484,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4286,"text":"Kendilerine ilim geldikten sonra ayrılığa düşmeleri, ancak, birbirini çekememekten oldu. Eğer belirli bir süre için Rabbinin verilmiş bir sözü olmasaydı, aralarında hemen hükmedilirdi. Arkalarından Kitaba varis kılınanlar da ondan şüphe ve endişe içindedirler.","numberInSurah":14,"juz":25,"manzil":6,"page":484,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4287,"text":"Bundan ötürü sen birliğe çağır ve emrolunduğun gibi doğru ol; onların heveslerine uyma ve şöyle söyle: \"Allah'ın indirdiği Kitap'a inandım; aranızda adaletle hükmetmek ile emrolundum; Allah bizim de Rabbimiz, sizin de Rabbinizdir; bizim işlediklerimiz bize, sizin işledikleriniz kendinizedir. Bizimle sizin aranızda tartışılacak bir şey yoktur. Allah hepimizi bir araya toplar; dönüş O'nadır.\"","numberInSurah":15,"juz":25,"manzil":6,"page":484,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4288,"text":"Allah'ın çağrısına icabet eden bulunduktan sonra, O'nun hakkında tartışmağa girişenlerin delilleri Rableri katında hükümsüzdür. Onlara bir gazap vardır, çetin bir azap da onlar içindir.","numberInSurah":16,"juz":25,"manzil":6,"page":485,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4289,"text":"Gerçekten Kitap'ı ve ölçüyü indiren Allah'tır. Ne bilirsin, belki de kıyamet saati yakındır.","numberInSurah":17,"juz":25,"manzil":6,"page":485,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4290,"text":"O'na inanmayanlar, acele olmasını beklerler; inananlar ise korku ile titrerler ve onun gerçek olduğunu bilirler. İyi bilin ki kıyamet günü hakkında tartışanlar derin bir sapıklık içindedirler.","numberInSurah":18,"juz":25,"manzil":6,"page":485,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4291,"text":"Allah, kullarına lütufta bulunandır. Dilediğini rızıklandırır. Kuvvetli olan da güçlü olan da O'dur.","numberInSurah":19,"juz":25,"manzil":6,"page":485,"ruku":420,"hizbQuarter":194,"sajda":false},{"number":4292,"text":"Ahiret kazancını isteyenin kazancını artırırız; dünya kazancını isteyene de ondan veririz; ama ahirette bir payı bulunmaz.","numberInSurah":20,"juz":25,"manzil":6,"page":485,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4293,"text":"Yoksa, Allah'ın dinde izin vermediği bir şeyi onlara meşru kılacak ortakları mı vardır? Eğer kesin yargı bulunmayacak olsaydı aralarında hemen hükmedilirdi. Doğrusu, zalimlere can yakıcı azap vardır.","numberInSurah":21,"juz":25,"manzil":6,"page":485,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4294,"text":"Yaptıkları şeyler başlarına gelirken, zalimlerin korkudan titrediklerini görürsün. İnanıp yararlı işler işleyenler cennet bahçelerindedirler. Rablerinin katında, onlara diledikleri verilir. İşte büyük lütuf budur.","numberInSurah":22,"juz":25,"manzil":6,"page":485,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4295,"text":"Allah, inanıp yararlı işler işleyen kullarını bununla müjdeler. De ki: \"Ben sizden buna karşı yakınlara sevgiden (veya Allah'a yaklaşmaktan) başka bir ücret istemem.\" Kim güzel bir iş işlerse onun güzelliğini arttırırız. Doğrusu Allah bağışlayandır, şükrün karşılığını verendir.","numberInSurah":23,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4296,"text":"Yoksa senin için \"Allah'a karşı yalan yere iftira etti\" mi derler? Allah dilerse senin kalbini mühürler, batılı da yok eder, hakkı sözleriyle gerçekleştirir. Doğrusu O, kalplerde olanı bilendir.","numberInSurah":24,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4297,"text":"Kullarının tevbesini kabul eden, kötülükleri affeden, yaptıklarınızı bilen, inanıp yararlı işler işleyenlerin duasını kabul eden, lütfuyla onların ecrini arttıran O'dur. Ama, inkarcılar için çetin azap vardır.","numberInSurah":25,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4298,"text":"Kullarının tevbesini kabul eden, kötülükleri affeden, yaptıklarınızı bilen, inanıp yararlı işler işleyenlerin duasını kabul eden, lütfuyla onların ecrini arttıran O'dur. Ama, inkarcılar için çetin azap vardır.","numberInSurah":26,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":194,"sajda":false},{"number":4299,"text":"Eğer Allah rızkı kullarının hepsine bol bol verseydi, yeryüzünde azgınlık ederlerdi. Ama O, dilediğini bir ölçüye göre indirir. Doğrusu O, kullarından haberdardır, onları görendir.","numberInSurah":27,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":195,"sajda":false},{"number":4300,"text":"Umutsuzluğa düşmelerinin ardından yağmuru indiren, rahmetini yayan O'dur. O, övülmeğe layık olan dosttur.","numberInSurah":28,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":195,"sajda":false},{"number":4301,"text":"Gökleri, yeri ve ikisinde yaydığı canlıları yaratması varlığının delillerindendir.","numberInSurah":29,"juz":25,"manzil":6,"page":486,"ruku":421,"hizbQuarter":195,"sajda":false},{"number":4302,"text":"Başınıza gelen herhangi bir musibet ellerinizle işlediklerinizden ötürüdür. O, yine de çoğunu affeder.","numberInSurah":30,"juz":25,"manzil":6,"page":486,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4303,"text":"Yeryüzünde O'nu aciz bırakamazsınız. Allah'tan başka bir dostunuz da yardımcınız da yoktur.","numberInSurah":31,"juz":25,"manzil":6,"page":486,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4304,"text":"Denizde yüce dağlar gibi gemilerin yürümesi O'nun varlığının delillerindendir.","numberInSurah":32,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4305,"text":"O, dilerse rüzgarı durdurur, yelkenle giden gemiler o zaman denizin yüzünde durakalır. Bunlarda, sabırlı olan ve çok şükreden kimseler için deliller vardır.","numberInSurah":33,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4306,"text":"Yahut yaptıklarına karşılık onları ortadan kaldırır, bir çoğunu da bağışlar.","numberInSurah":34,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4307,"text":"Ayetlerimiz üzerinde tartışanlar, kendilerine kaçacak yer olmadığını bilsinler.","numberInSurah":35,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4308,"text":"Size verilen herhangi bir şey, sadece dünya hayatının bir geçimliğidir. Allah katında olan; inanıp Rablerine güvenen, büyük günahlardan ve hayasızlıklardan çekinen, öfkelendiklerinde bile bağışlayanlar, Rablerinin çağrısına cevap verenler ve namaz kılanlar için daha iyi ve daha süreklidir. Onların işleri aralarında danışma iledir. Kendilerine verdiğimiz rızıktan da sarfederler.","numberInSurah":36,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4309,"text":"Size verilen herhangi bir şey, sadece dünya hayatının bir geçimliğidir. Allah katında olan; inanıp Rablerine güvenen, büyük günahlardan ve hayasızlıklardan çekinen, öfkelendiklerinde bile bağışlayanlar, Rablerinin çağrısına cevap verenler ve namaz kılanlar için daha iyi ve daha süreklidir. Onların işleri aralarında danışma iledir. Kendilerine verdiğimiz rızıktan da sarfederler.","numberInSurah":37,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4310,"text":"Size verilen herhangi bir şey, sadece dünya hayatının bir geçimliğidir. Allah katında olan; inanıp Rablerine güvenen, büyük günahlardan ve hayasızlıklardan çekinen, öfkelendiklerinde bile bağışlayanlar, Rablerinin çağrısına cevap verenler ve namaz kılanlar için daha iyi ve daha süreklidir. Onların işleri aralarında danışma iledir. Kendilerine verdiğimiz rızıktan da sarfederler.","numberInSurah":38,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4311,"text":"Bir haksızlığa uğradıklarında, üstün gelmek için aralarında yardımlaşırlar.","numberInSurah":39,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4312,"text":"Bir kötülüğün karşılığı, aynı şekilde bir kötülüktür. Ama kim affeder ve barışırsa, onun ecri Allah'a aittir. Doğrusu O, zulmedenleri sevmez.","numberInSurah":40,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4313,"text":"Zulüm gördükten sonra hakkını alan kimselere, işte onların aleyhine bir yol yoktur.","numberInSurah":41,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4314,"text":"İnsanlara zulmedenlere, yeryüzünde haksız yere taşkınlık edenlere karşı durulmalıdır. İşte, can yakıcı azap bunlaradır.","numberInSurah":42,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4315,"text":"Ama sabredip bağışlayanın işi, işte bu, azmedilmeye değer işlerdendir.","numberInSurah":43,"juz":25,"manzil":6,"page":487,"ruku":422,"hizbQuarter":195,"sajda":false},{"number":4316,"text":"Allah kimi saptırırsa, artık onun bundan sonra bir dostu olmaz. Azabı gördüklerinde, zalimlerin: \"Dönecek bir yol yok mudur?\" dediklerini görürsün.","numberInSurah":44,"juz":25,"manzil":6,"page":487,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4317,"text":"Aşağılıktan başları öne eğilmiş, göz ucuyla gizli gizli etrafa bakarken, ateşe sunulduklarını görürsün. İnananlar: \"Hüsranda olanlar, kıyamet günü kendilerini de, ailelerini de hüsranda bırakanlardır\" derler. İyi bilin ki, zalimler sürekli bir azap içindedirler.","numberInSurah":45,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4318,"text":"Onların, Allah'tan başka kendilerine yardım edecek dostları da yoktur. Allah'ın saptırdığı kimsenin çıkar yolu olmaz.","numberInSurah":46,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4319,"text":"Allah katından, geri çevrilemeyecek günün gelmesinden önce Rabbinizin çağrısına cevap verin. O gün hiçbirinize sığınacak yer bulunmaz, inkar de edemezsiniz.","numberInSurah":47,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4320,"text":"Eğer yüz çevirirlerse bilsinler ki, Biz seni onlara bekçi göndermedik; sana düşen sadece tebliğdir. Doğrusu Biz insana katımızdan bir rahmet tattırırsak ona sevinir; ama elleriyle yaptıkları yüzünden başlarına bir kötülük gelirse işte o zaman görürsün ki insan gerçekten pek nankördür.","numberInSurah":48,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4321,"text":"Göklerin ve yerin hükümranlığı Allah'ındır. Dilediğini yaratır, dilediğine kız çocuk, dilediğine de erkek çocuk verir.","numberInSurah":49,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4322,"text":"Yahut hem kız hem erkek çocuk verir, dilediğini de kısır kılar. O, bilendir, her şeye Kadir'dir.","numberInSurah":50,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":195,"sajda":false},{"number":4323,"text":"Allah bir insanla ancak vahiy suretiyle veya perde arkasından konuşur, yahut bir elçi gönderir; izniyle, dilediğini vahyeder. Doğrusu O yücedir, Hakim'dir.","numberInSurah":51,"juz":25,"manzil":6,"page":488,"ruku":423,"hizbQuarter":196,"sajda":false},{"number":4324,"text":"İşte sana da buyruğumuzla Cebrail'i gönderdik; sen Kitap nedir, iman nedir önceleri bilmezdin, fakat Biz onu, kullarımızdan dilediğimizi onunla doğru yola eriştirdiğimiz bir nur kıldık. Şüphesiz sen de insanlara, göklerde ve yerde ne varsa kendisininolan Allah'ın yolunu, doğru yolu göstermektesin. İyi bilin ki işler sonunda Allah'a döner.","numberInSurah":52,"juz":25,"manzil":6,"page":489,"ruku":423,"hizbQuarter":196,"sajda":false},{"number":4325,"text":"İşte sana da buyruğumuzla Cebrail'i gönderdik; sen Kitap nedir, iman nedir önceleri bilmezdin, fakat Biz onu, kullarımızdan dilediğimizi onunla doğru yola eriştirdiğimiz bir nur kıldık. Şüphesiz sen de insanlara, göklerde ve yerde ne varsa kendisininolan Allah'ın yolunu, doğru yolu göstermektesin. İyi bilin ki işler sonunda Allah'a döner.","numberInSurah":53,"juz":25,"manzil":6,"page":489,"ruku":423,"hizbQuarter":196,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}