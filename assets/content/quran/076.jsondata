{"arabic":{"number":76,"name":"سُورَةُ الإِنسَانِ","englishName":"İnsân","englishNameTranslation":"Man","revelationType":"Medinan","numberOfAyahs":31,"ayahs":[{"number":5592,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ هَلْ أَتَىٰ عَلَى الْإِنْسَانِ حِينٌ مِنَ الدَّهْرِ لَمْ يَكُنْ شَيْئًا مَذْكُورًا","numberInSurah":1,"juz":29,"manzil":7,"page":578,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5593,"text":"إِنَّا خَلَقْنَا الْإِنْسَانَ مِنْ نُطْفَةٍ أَمْشَاجٍ نَبْتَلِيهِ فَجَعَلْنَاهُ سَمِيعًا بَصِيرًا","numberInSurah":2,"juz":29,"manzil":7,"page":578,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5594,"text":"إِنَّا هَدَيْنَاهُ السَّبِيلَ إِمَّا شَاكِرًا وَإِمَّا كَفُورًا","numberInSurah":3,"juz":29,"manzil":7,"page":578,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5595,"text":"إِنَّا أَعْتَدْنَا لِلْكَافِرِينَ سَلَاسِلَ وَأَغْلَالًا وَسَعِيرًا","numberInSurah":4,"juz":29,"manzil":7,"page":578,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5596,"text":"إِنَّ الْأَبْرَارَ يَشْرَبُونَ مِنْ كَأْسٍ كَانَ مِزَاجُهَا كَافُورًا","numberInSurah":5,"juz":29,"manzil":7,"page":578,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5597,"text":"عَيْنًا يَشْرَبُ بِهَا عِبَادُ اللَّهِ يُفَجِّرُونَهَا تَفْجِيرًا","numberInSurah":6,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5598,"text":"يُوفُونَ بِالنَّذْرِ وَيَخَافُونَ يَوْمًا كَانَ شَرُّهُ مُسْتَطِيرًا","numberInSurah":7,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5599,"text":"وَيُطْعِمُونَ الطَّعَامَ عَلَىٰ حُبِّهِ مِسْكِينًا وَيَتِيمًا وَأَسِيرًا","numberInSurah":8,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5600,"text":"إِنَّمَا نُطْعِمُكُمْ لِوَجْهِ اللَّهِ لَا نُرِيدُ مِنْكُمْ جَزَاءً وَلَا شُكُورًا","numberInSurah":9,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5601,"text":"إِنَّا نَخَافُ مِنْ رَبِّنَا يَوْمًا عَبُوسًا قَمْطَرِيرًا","numberInSurah":10,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5602,"text":"فَوَقَاهُمُ اللَّهُ شَرَّ ذَٰلِكَ الْيَوْمِ وَلَقَّاهُمْ نَضْرَةً وَسُرُورًا","numberInSurah":11,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5603,"text":"وَجَزَاهُمْ بِمَا صَبَرُوا جَنَّةً وَحَرِيرًا","numberInSurah":12,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5604,"text":"مُتَّكِئِينَ فِيهَا عَلَى الْأَرَائِكِ ۖ لَا يَرَوْنَ فِيهَا شَمْسًا وَلَا زَمْهَرِيرًا","numberInSurah":13,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5605,"text":"وَدَانِيَةً عَلَيْهِمْ ظِلَالُهَا وَذُلِّلَتْ قُطُوفُهَا تَذْلِيلًا","numberInSurah":14,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5606,"text":"وَيُطَافُ عَلَيْهِمْ بِآنِيَةٍ مِنْ فِضَّةٍ وَأَكْوَابٍ كَانَتْ قَوَارِيرَا","numberInSurah":15,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5607,"text":"قَوَارِيرَ مِنْ فِضَّةٍ قَدَّرُوهَا تَقْدِيرًا","numberInSurah":16,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5608,"text":"وَيُسْقَوْنَ فِيهَا كَأْسًا كَانَ مِزَاجُهَا زَنْجَبِيلًا","numberInSurah":17,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5609,"text":"عَيْنًا فِيهَا تُسَمَّىٰ سَلْسَبِيلًا","numberInSurah":18,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5610,"text":"۞ وَيَطُوفُ عَلَيْهِمْ وِلْدَانٌ مُخَلَّدُونَ إِذَا رَأَيْتَهُمْ حَسِبْتَهُمْ لُؤْلُؤًا مَنْثُورًا","numberInSurah":19,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":232,"sajda":false},{"number":5611,"text":"وَإِذَا رَأَيْتَ ثَمَّ رَأَيْتَ نَعِيمًا وَمُلْكًا كَبِيرًا","numberInSurah":20,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":232,"sajda":false},{"number":5612,"text":"عَالِيَهُمْ ثِيَابُ سُنْدُسٍ خُضْرٌ وَإِسْتَبْرَقٌ ۖ وَحُلُّوا أَسَاوِرَ مِنْ فِضَّةٍ وَسَقَاهُمْ رَبُّهُمْ شَرَابًا طَهُورًا","numberInSurah":21,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":232,"sajda":false},{"number":5613,"text":"إِنَّ هَٰذَا كَانَ لَكُمْ جَزَاءً وَكَانَ سَعْيُكُمْ مَشْكُورًا","numberInSurah":22,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":232,"sajda":false},{"number":5614,"text":"إِنَّا نَحْنُ نَزَّلْنَا عَلَيْكَ الْقُرْآنَ تَنْزِيلًا","numberInSurah":23,"juz":29,"manzil":7,"page":579,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5615,"text":"فَاصْبِرْ لِحُكْمِ رَبِّكَ وَلَا تُطِعْ مِنْهُمْ آثِمًا أَوْ كَفُورًا","numberInSurah":24,"juz":29,"manzil":7,"page":579,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5616,"text":"وَاذْكُرِ اسْمَ رَبِّكَ بُكْرَةً وَأَصِيلًا","numberInSurah":25,"juz":29,"manzil":7,"page":579,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5617,"text":"وَمِنَ اللَّيْلِ فَاسْجُدْ لَهُ وَسَبِّحْهُ لَيْلًا طَوِيلًا","numberInSurah":26,"juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5618,"text":"إِنَّ هَٰؤُلَاءِ يُحِبُّونَ الْعَاجِلَةَ وَيَذَرُونَ وَرَاءَهُمْ يَوْمًا ثَقِيلًا","numberInSurah":27,"juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5619,"text":"نَحْنُ خَلَقْنَاهُمْ وَشَدَدْنَا أَسْرَهُمْ ۖ وَإِذَا شِئْنَا بَدَّلْنَا أَمْثَالَهُمْ تَبْدِيلًا","numberInSurah":28,"juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5620,"text":"إِنَّ هَٰذِهِ تَذْكِرَةٌ ۖ فَمَنْ شَاءَ اتَّخَذَ إِلَىٰ رَبِّهِ سَبِيلًا","numberInSurah":29,"juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5621,"text":"وَمَا تَشَاءُونَ إِلَّا أَنْ يَشَاءَ اللَّهُ ۚ إِنَّ اللَّهَ كَانَ عَلِيمًا حَكِيمًا","numberInSurah":30,"juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5622,"text":"يُدْخِلُ مَنْ يَشَاءُ فِي رَحْمَتِهِ ۚ وَالظَّالِمِينَ أَعَدَّ لَهُمْ عَذَابًا أَلِيمًا","numberInSurah":31,"juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":76,"name":"سُورَةُ الإِنسَانِ","englishName":"İnsân","englishNameTranslation":"Man","revelationType":"Medinan","numberOfAyahs":31,"ayahs":[{"number":5592,"text":"İnsanoğlu, var edilip bahse değer bir şey olana kadar, şüphesiz, uzun bir zaman geçmemiş midir?","numberInSurah":1,"juz":29,"manzil":7,"page":578,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5593,"text":"Biz insanı katışık bir nutfeden yaratmışızdır; onu deneriz; bu yüzden, onun işitmesini ve görmesini sağlamışızdır.","numberInSurah":2,"juz":29,"manzil":7,"page":578,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5594,"text":"Şüphesiz ona yol gösterdik; buna kimi şükreder, kimi de nankörlük.","numberInSurah":3,"juz":29,"manzil":7,"page":578,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5595,"text":"Doğrusu, inkarcılar için zincirler, demir halkalar ve çılgın alevli cehennem hazırladık.","numberInSurah":4,"juz":29,"manzil":7,"page":578,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5596,"text":"Şüphesiz iyiler kafur katılmış bir tastan içerler.","numberInSurah":5,"juz":29,"manzil":7,"page":578,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5597,"text":"Bu ancak Allah'ın kullarının taşıra taşıra içebileceği bir pınardır.","numberInSurah":6,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5598,"text":"Onlar verdikleri sözleri yerine getirirler, fenalığı yaygın olan bir günden korkarlar.","numberInSurah":7,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5599,"text":"Onlar içleri çektiği halde, yiyeceği yoksula, öksüze ve esire yedirirler.","numberInSurah":8,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5600,"text":"\"Biz sizi ancak Allah rızası için doyuruyoruz, bir karşılık ve teşekkür beklemiyoruz. Doğrusu biz çok asık suratların bulunacağı bir günde Rabbimizden korkarız\" derler.","numberInSurah":9,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5601,"text":"\"Biz sizi ancak Allah rızası için doyuruyoruz, bir karşılık ve teşekkür beklemiyoruz. Doğrusu biz çok asık suratların bulunacağı bir günde Rabbimizden korkarız\" derler.","numberInSurah":10,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5602,"text":"Allah da onları bu yüzden o günün fenalığından korur; onların yüzüne parlaklık ve neşe verir.","numberInSurah":11,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5603,"text":"Sabırlarının karşılığı, cennet ve oradaki ipeklerdir.","numberInSurah":12,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5604,"text":"Orada tahtlara yaslanırlar; orada yakıcı sıcak ve dondurucu soğuk görmezler.","numberInSurah":13,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5605,"text":"Meyve ağaçlarının gölgeleri üzerlerine sarkmış ve onların koparılması kolaylaştırılmıştır.","numberInSurah":14,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5606,"text":"Çevrelerinde gümüş kaplar ve billur kaseler dolaştırılır.","numberInSurah":15,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5607,"text":"Billurları gümüş gibi parlaktır, onları ölçüp ölçüp dağıtırlar.","numberInSurah":16,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5608,"text":"Orada, zencefil karışık bir tasla içirilirler.","numberInSurah":17,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5609,"text":"O pınara \"Selsebil\" denir.","numberInSurah":18,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":231,"sajda":false},{"number":5610,"text":"Yanlarında ölümsüz gençler dolaşır; onları gördüğünde saçılmış birer inci sanırsın.","numberInSurah":19,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":232,"sajda":false},{"number":5611,"text":"Oranın neresine baksan, nimet ve büyük bir saltanat görürsün.","numberInSurah":20,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":232,"sajda":false},{"number":5612,"text":"Üzerlerinde ince yeşil ipekli, parlak atlastan elbiseler vardır; gümüş bileziklerle süslenmişlerdir Rableri onlara tertemiz içecekler içirir.","numberInSurah":21,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":232,"sajda":false},{"number":5613,"text":"\"İşte bu sizin işlediklerinizin karşılığıdır, çalışmalarınız şükre değer\" denir.","numberInSurah":22,"juz":29,"manzil":7,"page":579,"ruku":514,"hizbQuarter":232,"sajda":false},{"number":5614,"text":"Kuran'ı sana indiren şüphesiz Biziz.","numberInSurah":23,"juz":29,"manzil":7,"page":579,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5615,"text":"Rabbinin hükmüne kadar sabret; onların günah işleyen ve inkarcı olanlarına uyma.","numberInSurah":24,"juz":29,"manzil":7,"page":579,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5616,"text":"Rabbinin adını sabah akşam an.","numberInSurah":25,"juz":29,"manzil":7,"page":579,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5617,"text":"Geceleyin O'na secde et; O'nu geceleri uzun uzun tesbih et.","numberInSurah":26,"juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5618,"text":"Doğrusu insanlar, çabuk elde edilen dünya nimetlerini severler de ağırlığı çekilmez günü arkalarında bırakırlar.","numberInSurah":27,"juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5619,"text":"Onları yaratan, mafsallarını pekiştiren Biziz; dilersek onları benzerleri ile değiştiriveririz.","numberInSurah":28,"juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5620,"text":"Bu sadece bir öğüttür; dileyen, Rabbine giden yolu tutar.","numberInSurah":29,"juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5621,"text":"Allah dilemedikçe siz dileyemezsiniz. Doğrusu Allah, bilendir, Hakim'dir.","numberInSurah":30,"juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false},{"number":5622,"text":"Dilediğine rahmet eder. Zalimlere, işte onlara, can yakıcı bir azap hazırlamıştır.","numberInSurah":31,"juz":29,"manzil":7,"page":580,"ruku":515,"hizbQuarter":232,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}