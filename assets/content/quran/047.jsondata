{"arabic":{"number":47,"name":"سُورَةُ مُحَمَّدٍ","englishName":"Muhammed","englishNameTranslation":"Muhammad","revelationType":"Medinan","numberOfAyahs":38,"ayahs":[{"number":4546,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الَّذِينَ كَفَرُوا وَصَدُّوا عَنْ سَبِيلِ اللَّهِ أَضَلَّ أَعْمَالَهُمْ","numberInSurah":1,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4547,"text":"وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَآمَنُوا بِمَا نُزِّلَ عَلَىٰ مُحَمَّدٍ وَهُوَ الْحَقُّ مِنْ رَبِّهِمْ ۙ كَفَّرَ عَنْهُمْ سَيِّئَاتِهِمْ وَأَصْلَحَ بَالَهُمْ","numberInSurah":2,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4548,"text":"ذَٰلِكَ بِأَنَّ الَّذِينَ كَفَرُوا اتَّبَعُوا الْبَاطِلَ وَأَنَّ الَّذِينَ آمَنُوا اتَّبَعُوا الْحَقَّ مِنْ رَبِّهِمْ ۚ كَذَٰلِكَ يَضْرِبُ اللَّهُ لِلنَّاسِ أَمْثَالَهُمْ","numberInSurah":3,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4549,"text":"فَإِذَا لَقِيتُمُ الَّذِينَ كَفَرُوا فَضَرْبَ الرِّقَابِ حَتَّىٰ إِذَا أَثْخَنْتُمُوهُمْ فَشُدُّوا الْوَثَاقَ فَإِمَّا مَنًّا بَعْدُ وَإِمَّا فِدَاءً حَتَّىٰ تَضَعَ الْحَرْبُ أَوْزَارَهَا ۚ ذَٰلِكَ وَلَوْ يَشَاءُ اللَّهُ لَانْتَصَرَ مِنْهُمْ وَلَٰكِنْ لِيَبْلُوَ بَعْضَكُمْ بِبَعْضٍ ۗ وَالَّذِينَ قُتِلُوا فِي سَبِيلِ اللَّهِ فَلَنْ يُضِلَّ أَعْمَالَهُمْ","numberInSurah":4,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4550,"text":"سَيَهْدِيهِمْ وَيُصْلِحُ بَالَهُمْ","numberInSurah":5,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4551,"text":"وَيُدْخِلُهُمُ الْجَنَّةَ عَرَّفَهَا لَهُمْ","numberInSurah":6,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4552,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَنْصُرُوا اللَّهَ يَنْصُرْكُمْ وَيُثَبِّتْ أَقْدَامَكُمْ","numberInSurah":7,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4553,"text":"وَالَّذِينَ كَفَرُوا فَتَعْسًا لَهُمْ وَأَضَلَّ أَعْمَالَهُمْ","numberInSurah":8,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4554,"text":"ذَٰلِكَ بِأَنَّهُمْ كَرِهُوا مَا أَنْزَلَ اللَّهُ فَأَحْبَطَ أَعْمَالَهُمْ","numberInSurah":9,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4555,"text":"۞ أَفَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلِهِمْ ۚ دَمَّرَ اللَّهُ عَلَيْهِمْ ۖ وَلِلْكَافِرِينَ أَمْثَالُهَا","numberInSurah":10,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":203,"sajda":false},{"number":4556,"text":"ذَٰلِكَ بِأَنَّ اللَّهَ مَوْلَى الَّذِينَ آمَنُوا وَأَنَّ الْكَافِرِينَ لَا مَوْلَىٰ لَهُمْ","numberInSurah":11,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":203,"sajda":false},{"number":4557,"text":"إِنَّ اللَّهَ يُدْخِلُ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ جَنَّاتٍ تَجْرِي مِنْ تَحْتِهَا الْأَنْهَارُ ۖ وَالَّذِينَ كَفَرُوا يَتَمَتَّعُونَ وَيَأْكُلُونَ كَمَا تَأْكُلُ الْأَنْعَامُ وَالنَّارُ مَثْوًى لَهُمْ","numberInSurah":12,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4558,"text":"وَكَأَيِّنْ مِنْ قَرْيَةٍ هِيَ أَشَدُّ قُوَّةً مِنْ قَرْيَتِكَ الَّتِي أَخْرَجَتْكَ أَهْلَكْنَاهُمْ فَلَا نَاصِرَ لَهُمْ","numberInSurah":13,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4559,"text":"أَفَمَنْ كَانَ عَلَىٰ بَيِّنَةٍ مِنْ رَبِّهِ كَمَنْ زُيِّنَ لَهُ سُوءُ عَمَلِهِ وَاتَّبَعُوا أَهْوَاءَهُمْ","numberInSurah":14,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4560,"text":"مَثَلُ الْجَنَّةِ الَّتِي وُعِدَ الْمُتَّقُونَ ۖ فِيهَا أَنْهَارٌ مِنْ مَاءٍ غَيْرِ آسِنٍ وَأَنْهَارٌ مِنْ لَبَنٍ لَمْ يَتَغَيَّرْ طَعْمُهُ وَأَنْهَارٌ مِنْ خَمْرٍ لَذَّةٍ لِلشَّارِبِينَ وَأَنْهَارٌ مِنْ عَسَلٍ مُصَفًّى ۖ وَلَهُمْ فِيهَا مِنْ كُلِّ الثَّمَرَاتِ وَمَغْفِرَةٌ مِنْ رَبِّهِمْ ۖ كَمَنْ هُوَ خَالِدٌ فِي النَّارِ وَسُقُوا مَاءً حَمِيمًا فَقَطَّعَ أَمْعَاءَهُمْ","numberInSurah":15,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4561,"text":"وَمِنْهُمْ مَنْ يَسْتَمِعُ إِلَيْكَ حَتَّىٰ إِذَا خَرَجُوا مِنْ عِنْدِكَ قَالُوا لِلَّذِينَ أُوتُوا الْعِلْمَ مَاذَا قَالَ آنِفًا ۚ أُولَٰئِكَ الَّذِينَ طَبَعَ اللَّهُ عَلَىٰ قُلُوبِهِمْ وَاتَّبَعُوا أَهْوَاءَهُمْ","numberInSurah":16,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4562,"text":"وَالَّذِينَ اهْتَدَوْا زَادَهُمْ هُدًى وَآتَاهُمْ تَقْوَاهُمْ","numberInSurah":17,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4563,"text":"فَهَلْ يَنْظُرُونَ إِلَّا السَّاعَةَ أَنْ تَأْتِيَهُمْ بَغْتَةً ۖ فَقَدْ جَاءَ أَشْرَاطُهَا ۚ فَأَنَّىٰ لَهُمْ إِذَا جَاءَتْهُمْ ذِكْرَاهُمْ","numberInSurah":18,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4564,"text":"فَاعْلَمْ أَنَّهُ لَا إِلَٰهَ إِلَّا اللَّهُ وَاسْتَغْفِرْ لِذَنْبِكَ وَلِلْمُؤْمِنِينَ وَالْمُؤْمِنَاتِ ۗ وَاللَّهُ يَعْلَمُ مُتَقَلَّبَكُمْ وَمَثْوَاكُمْ","numberInSurah":19,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4565,"text":"وَيَقُولُ الَّذِينَ آمَنُوا لَوْلَا نُزِّلَتْ سُورَةٌ ۖ فَإِذَا أُنْزِلَتْ سُورَةٌ مُحْكَمَةٌ وَذُكِرَ فِيهَا الْقِتَالُ ۙ رَأَيْتَ الَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ يَنْظُرُونَ إِلَيْكَ نَظَرَ الْمَغْشِيِّ عَلَيْهِ مِنَ الْمَوْتِ ۖ فَأَوْلَىٰ لَهُمْ","numberInSurah":20,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4566,"text":"طَاعَةٌ وَقَوْلٌ مَعْرُوفٌ ۚ فَإِذَا عَزَمَ الْأَمْرُ فَلَوْ صَدَقُوا اللَّهَ لَكَانَ خَيْرًا لَهُمْ","numberInSurah":21,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4567,"text":"فَهَلْ عَسَيْتُمْ إِنْ تَوَلَّيْتُمْ أَنْ تُفْسِدُوا فِي الْأَرْضِ وَتُقَطِّعُوا أَرْحَامَكُمْ","numberInSurah":22,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4568,"text":"أُولَٰئِكَ الَّذِينَ لَعَنَهُمُ اللَّهُ فَأَصَمَّهُمْ وَأَعْمَىٰ أَبْصَارَهُمْ","numberInSurah":23,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4569,"text":"أَفَلَا يَتَدَبَّرُونَ الْقُرْآنَ أَمْ عَلَىٰ قُلُوبٍ أَقْفَالُهَا","numberInSurah":24,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4570,"text":"إِنَّ الَّذِينَ ارْتَدُّوا عَلَىٰ أَدْبَارِهِمْ مِنْ بَعْدِ مَا تَبَيَّنَ لَهُمُ الْهُدَى ۙ الشَّيْطَانُ سَوَّلَ لَهُمْ وَأَمْلَىٰ لَهُمْ","numberInSurah":25,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4571,"text":"ذَٰلِكَ بِأَنَّهُمْ قَالُوا لِلَّذِينَ كَرِهُوا مَا نَزَّلَ اللَّهُ سَنُطِيعُكُمْ فِي بَعْضِ الْأَمْرِ ۖ وَاللَّهُ يَعْلَمُ إِسْرَارَهُمْ","numberInSurah":26,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4572,"text":"فَكَيْفَ إِذَا تَوَفَّتْهُمُ الْمَلَائِكَةُ يَضْرِبُونَ وُجُوهَهُمْ وَأَدْبَارَهُمْ","numberInSurah":27,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4573,"text":"ذَٰلِكَ بِأَنَّهُمُ اتَّبَعُوا مَا أَسْخَطَ اللَّهَ وَكَرِهُوا رِضْوَانَهُ فَأَحْبَطَ أَعْمَالَهُمْ","numberInSurah":28,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4574,"text":"أَمْ حَسِبَ الَّذِينَ فِي قُلُوبِهِمْ مَرَضٌ أَنْ لَنْ يُخْرِجَ اللَّهُ أَضْغَانَهُمْ","numberInSurah":29,"juz":26,"manzil":6,"page":509,"ruku":445,"hizbQuarter":203,"sajda":false},{"number":4575,"text":"وَلَوْ نَشَاءُ لَأَرَيْنَاكَهُمْ فَلَعَرَفْتَهُمْ بِسِيمَاهُمْ ۚ وَلَتَعْرِفَنَّهُمْ فِي لَحْنِ الْقَوْلِ ۚ وَاللَّهُ يَعْلَمُ أَعْمَالَكُمْ","numberInSurah":30,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":203,"sajda":false},{"number":4576,"text":"وَلَنَبْلُوَنَّكُمْ حَتَّىٰ نَعْلَمَ الْمُجَاهِدِينَ مِنْكُمْ وَالصَّابِرِينَ وَنَبْلُوَ أَخْبَارَكُمْ","numberInSurah":31,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":203,"sajda":false},{"number":4577,"text":"إِنَّ الَّذِينَ كَفَرُوا وَصَدُّوا عَنْ سَبِيلِ اللَّهِ وَشَاقُّوا الرَّسُولَ مِنْ بَعْدِ مَا تَبَيَّنَ لَهُمُ الْهُدَىٰ لَنْ يَضُرُّوا اللَّهَ شَيْئًا وَسَيُحْبِطُ أَعْمَالَهُمْ","numberInSurah":32,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":203,"sajda":false},{"number":4578,"text":"۞ يَا أَيُّهَا الَّذِينَ آمَنُوا أَطِيعُوا اللَّهَ وَأَطِيعُوا الرَّسُولَ وَلَا تُبْطِلُوا أَعْمَالَكُمْ","numberInSurah":33,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":204,"sajda":false},{"number":4579,"text":"إِنَّ الَّذِينَ كَفَرُوا وَصَدُّوا عَنْ سَبِيلِ اللَّهِ ثُمَّ مَاتُوا وَهُمْ كُفَّارٌ فَلَنْ يَغْفِرَ اللَّهُ لَهُمْ","numberInSurah":34,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":204,"sajda":false},{"number":4580,"text":"فَلَا تَهِنُوا وَتَدْعُوا إِلَى السَّلْمِ وَأَنْتُمُ الْأَعْلَوْنَ وَاللَّهُ مَعَكُمْ وَلَنْ يَتِرَكُمْ أَعْمَالَكُمْ","numberInSurah":35,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":204,"sajda":false},{"number":4581,"text":"إِنَّمَا الْحَيَاةُ الدُّنْيَا لَعِبٌ وَلَهْوٌ ۚ وَإِنْ تُؤْمِنُوا وَتَتَّقُوا يُؤْتِكُمْ أُجُورَكُمْ وَلَا يَسْأَلْكُمْ أَمْوَالَكُمْ","numberInSurah":36,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":204,"sajda":false},{"number":4582,"text":"إِنْ يَسْأَلْكُمُوهَا فَيُحْفِكُمْ تَبْخَلُوا وَيُخْرِجْ أَضْغَانَكُمْ","numberInSurah":37,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":204,"sajda":false},{"number":4583,"text":"هَا أَنْتُمْ هَٰؤُلَاءِ تُدْعَوْنَ لِتُنْفِقُوا فِي سَبِيلِ اللَّهِ فَمِنْكُمْ مَنْ يَبْخَلُ ۖ وَمَنْ يَبْخَلْ فَإِنَّمَا يَبْخَلُ عَنْ نَفْسِهِ ۚ وَاللَّهُ الْغَنِيُّ وَأَنْتُمُ الْفُقَرَاءُ ۚ وَإِنْ تَتَوَلَّوْا يَسْتَبْدِلْ قَوْمًا غَيْرَكُمْ ثُمَّ لَا يَكُونُوا أَمْثَالَكُمْ","numberInSurah":38,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":204,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":47,"name":"سُورَةُ مُحَمَّدٍ","englishName":"Muhammed","englishNameTranslation":"Muhammad","revelationType":"Medinan","numberOfAyahs":38,"ayahs":[{"number":4546,"text":"Allah, inkar edenlerin ve kendi yolundan alıkoyanların işlerini boşa çıkarır.","numberInSurah":1,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4547,"text":"İnanıp yararlı iş işleyenlerin ve Muhammed'e, Rablerinden bir gerçek olarak indirilene inananların kötülüklerini Allah örter ve durumlarını düzeltir.","numberInSurah":2,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4548,"text":"Bu, inkar edenlerin batıla uymaları ve inananların Rablerinden gelen gerçeğe uymalarından ötürü böyledir. Allah böylece insanlara kendilerinin misallerini anlatır.","numberInSurah":3,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4549,"text":"Savaşta inkar edenlerle karşılaştığınızda boyunlarını vurun; sonunda onlara üstün geldiğinizde onları esir alın; savaş sona erince onları ya karşılıksız, ya da fidye ile salıverin; Allah dilemiş olsaydı, onlardan başka türlü öç alabilirdi, bunun böyle olması, kiminizi kiminizle denemek içindir. Allah, kendi yolunda öldürülenlerin işlerini boşa çıkarmaz.","numberInSurah":4,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4550,"text":"Onları doğru yola eriştirir, durumlarını düzeltir.","numberInSurah":5,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4551,"text":"Onları, kendilerine anlattığı cennete koyar.","numberInSurah":6,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4552,"text":"Ey inananlar! Siz Allah'ın dinine yardım ederseniz, O da size yardım eder, ayaklarınızı savaşta sabit kılar.","numberInSurah":7,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4553,"text":"İnkar edenlere ise, yıkım ve yokluk olsun! Allah onların işlerini boşa çıkarır.","numberInSurah":8,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4554,"text":"Bu, Allah'ın indirdiğini beğenmediklerinden ötürüdür. İşlerini Allah bunun için boşa çıkarmıştır.","numberInSurah":9,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":202,"sajda":false},{"number":4555,"text":"Yeryüzünde dolaşıp kendilerinden öncekilerin sonlarının nasıl olduğuna bakmazlar mı? Allah onları yere geçirmiştir; inkarcılara da onların başına gelenin benzerleri vardır.","numberInSurah":10,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":203,"sajda":false},{"number":4556,"text":"Çünkü Allah inananların sahibidir. Kafirlerin ise sahibi yoktur.","numberInSurah":11,"juz":26,"manzil":6,"page":507,"ruku":442,"hizbQuarter":203,"sajda":false},{"number":4557,"text":"Doğrusu Allah, inanıp yararlı işler işleyenleri içlerinden ırmaklar akan cennetlere koyar. Durakları ateş olduğu halde kafirler, zevklenirler ve hayvanlar gibi yerler.","numberInSurah":12,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4558,"text":"Seni sürüp çıkaran şehirden daha kuvvetli olan nice şehirler yok ettik. Yardım edenleri bulunmadı.","numberInSurah":13,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4559,"text":"Rabbinin katından bir belgesi olan kimse, kötü işi kendisine güzel gösterilen kimseye benzer mi? Bunlar heveslerine uymuşlardır.","numberInSurah":14,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4560,"text":"Allah'a karşı gelmekten sakınanlara söz verilen cennet şöyledir: Orada temiz su ırmakları, tadı bozulmayan süt ırmakları, içenlere zevk veren şarap ırmakları, süzme bal ırmakları vardır. Onlara orada her türlü ürün ve Rablerinden mağfiret vardır. Bunların durumu, ateşte temelli kalan ve bağırsaklarını parça parça edecek kaynar su içirilen kimselerin durumu gibi olur mu?","numberInSurah":15,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4561,"text":"Onların içinde seni dinleyenler vardır; sonra senin yanından çıkınca, bilgili kimselere \"Az önce ne demişti?\" diye sorarlar. İşte bunlar, Allah'ın kalblerini mühürlemiş olduğu, kendi heveslerine uyan kimselerdir.","numberInSurah":16,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4562,"text":"Doğru yolu bulanların ise Allah doğruluklarını artırır, onların karşı gelmekten sakınmalarını sağlar.","numberInSurah":17,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4563,"text":"Onlar kıyamet gününün kendilerine ansızın gelmesini mi bekliyorlar. Şüphesiz onun alametleri belirmiştir. Kendilerine gelip çatınca ibret almaları neye yarar?","numberInSurah":18,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4564,"text":"Bil ki, Allah'tan başka tanrı yoktur; kendinin, inanmış erkek ve kadınların günahlarının bağışlanmasını dile. Allah, gezip dolaştığınız ve duracağınız yerleri bilir.","numberInSurah":19,"juz":26,"manzil":6,"page":508,"ruku":443,"hizbQuarter":203,"sajda":false},{"number":4565,"text":"İnananlar: \"Keşke bir süre indirilse de cihada çıksak\" derlerdi. Fakat hükmü açık bir süre inip, orada savaş zikredilince, kalblerinde hastalık olanların, ölüm korkusuyla bayılmış kimselerin bakışları gibi, sana baktıklarını gördün. Oysa onlara itaat etmek ve uygun olanı söylemek yaraşırdı. İş ciddileşince Allah'a verdikleri yeminde doğruluk gösterselerdi, onların iyiliğine olurdu.","numberInSurah":20,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4566,"text":"İnananlar: \"Keşke bir süre indirilse de cihada çıksak\" derlerdi. Fakat hükmü açık bir süre inip, orada savaş zikredilince, kalblerinde hastalık olanların, ölüm korkusuyla bayılmış kimselerin bakışları gibi, sana baktıklarını gördün. Oysa onlara itaat etmek ve uygun olanı söylemek yaraşırdı. İş ciddileşince Allah'a verdikleri yeminde doğruluk gösterselerdi, onların iyiliğine olurdu.","numberInSurah":21,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4567,"text":"Geri dönerseniz yeryüzünde bozgunculuk yapmanız ve akrabalık bağlarını kesmeniz beklenmez mi sizden?","numberInSurah":22,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4568,"text":"İşte, Allah'ın lanetlediği, sağır kıldığı ve gözlerini kör ettiği bunlardır.","numberInSurah":23,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4569,"text":"Bunlar Kuran'ı düşünmezler mi? Yoksa kalbleri kilitli midir?","numberInSurah":24,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4570,"text":"Kendileri için doğru yol belli olduktan sonra ardlarına dönenleri, bu işi yapmaya şeytan sürüklemiş, onlara ümit vermiştir.","numberInSurah":25,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4571,"text":"Bu, Allah'ın indirdiğini beğenmeyen kimselerin: \"Biz bazı işlerde size itaat edeceğiz\" demelerindendir. Allah onların gizlediklerini bilir.","numberInSurah":26,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4572,"text":"Melekler, onların yüzlerine ve sırtlarına vurarak canlarını alırken durumları nice olur?","numberInSurah":27,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4573,"text":"Bu, Allah'ı gazablandıran şeye uymaları ve O'nun rızasından hoşnut olmamalarından ötürüdür. Allah da onların işlerini boşa çıkarmıştır.","numberInSurah":28,"juz":26,"manzil":6,"page":509,"ruku":444,"hizbQuarter":203,"sajda":false},{"number":4574,"text":"Yoksa, kalblerinde hastalık olanlar, Allah'ın onların kinlerini dışarı vurmayacağını mı sandılar?","numberInSurah":29,"juz":26,"manzil":6,"page":509,"ruku":445,"hizbQuarter":203,"sajda":false},{"number":4575,"text":"Eğer dileseydik, Biz onları sana gösterirdik; sen de onları yüzlerinden tanırdın. And olsun ki sen, onları konuşmalarından da tanırsın; Allah işlediklerinizi bilir.","numberInSurah":30,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":203,"sajda":false},{"number":4576,"text":"And olsun ki sizi, içinizden cihada çıkanları ve sabredenleri meydana çıkarana ve haberlerinizi açıklayana kadar deneyeceğiz.","numberInSurah":31,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":203,"sajda":false},{"number":4577,"text":"Şüphesiz, inkar edenler, Allah yolundan alıkoyanlar ve kendilerine doğru yol belli olduktan sonra Peygambere karşı gelenler Allah'a hiçbir zarar veremezler. O, onların işlerini boşa çıkaracaktır.","numberInSurah":32,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":203,"sajda":false},{"number":4578,"text":"Ey inananlar! Allah'a itaat edin, Peygambere itaat edin; işlerinizi boşa çıkarmayın.","numberInSurah":33,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":204,"sajda":false},{"number":4579,"text":"İnkar edip Allah yolundan alıkoyanları, sonra da inkarcı olarak ölenleri Allah şüphesiz ki bağışlamayacaktır.","numberInSurah":34,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":204,"sajda":false},{"number":4580,"text":"Ey inananlar! Sizler daha üstün olduğunuz halde düşman karşısında gevşemeyin ki barış istemek zorunda kalmayasınız; Allah sizinle beraberdir; sizin işlerinizi eksiltmeyecektir.","numberInSurah":35,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":204,"sajda":false},{"number":4581,"text":"Doğrusu dünya hayatı oyun ve oyalanmadır. Eğer inanır ve Allah'a karşı gelmekten sakınırsanız, O, size ecirlerinizi verir; O, sizin mallarınızı tamamen sarfetmenizi istemez.","numberInSurah":36,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":204,"sajda":false},{"number":4582,"text":"Eğer sizden onları isteyip de sizi zorlarsa, cimrilik edecektiniz, O da kinlerinizi ortaya çıkaracaktı.","numberInSurah":37,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":204,"sajda":false},{"number":4583,"text":"İşte sizler, Allah yolunda sarfetmeye çağırılan kimselersiniz. Kiminiz cimrilik yapıyor ama, cimrilik yapan bilsin ki, ancak kendine karşı cimrilik etmiş olur. Allah zengindir, siz ise fakirsiniz. Eğer O'ndan yüz çevirirseniz sizi ortadan kaldırır, sizin gibi olmayacak bir milleti yerinize getirir.","numberInSurah":38,"juz":26,"manzil":6,"page":510,"ruku":445,"hizbQuarter":204,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}