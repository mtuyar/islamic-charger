{"arabic":{"number":36,"name":"سُورَةُ يسٓ","englishName":"Yâsîn","englishNameTranslation":"Yaseen","revelationType":"Meccan","numberOfAyahs":83,"ayahs":[{"number":3706,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ يس","numberInSurah":1,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3707,"text":"وَالْقُرْآنِ الْحَكِيمِ","numberInSurah":2,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3708,"text":"إِنَّكَ لَمِنَ الْمُرْسَلِينَ","numberInSurah":3,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3709,"text":"عَلَىٰ صِرَاطٍ مُسْتَقِيمٍ","numberInSurah":4,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3710,"text":"تَنْزِيلَ الْعَزِيزِ الرَّحِيمِ","numberInSurah":5,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3711,"text":"لِتُنْذِرَ قَوْمًا مَا أُنْذِرَ آبَاؤُهُمْ فَهُمْ غَافِلُونَ","numberInSurah":6,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3712,"text":"لَقَدْ حَقَّ الْقَوْلُ عَلَىٰ أَكْثَرِهِمْ فَهُمْ لَا يُؤْمِنُونَ","numberInSurah":7,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3713,"text":"إِنَّا جَعَلْنَا فِي أَعْنَاقِهِمْ أَغْلَالًا فَهِيَ إِلَى الْأَذْقَانِ فَهُمْ مُقْمَحُونَ","numberInSurah":8,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3714,"text":"وَجَعَلْنَا مِنْ بَيْنِ أَيْدِيهِمْ سَدًّا وَمِنْ خَلْفِهِمْ سَدًّا فَأَغْشَيْنَاهُمْ فَهُمْ لَا يُبْصِرُونَ","numberInSurah":9,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3715,"text":"وَسَوَاءٌ عَلَيْهِمْ أَأَنْذَرْتَهُمْ أَمْ لَمْ تُنْذِرْهُمْ لَا يُؤْمِنُونَ","numberInSurah":10,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3716,"text":"إِنَّمَا تُنْذِرُ مَنِ اتَّبَعَ الذِّكْرَ وَخَشِيَ الرَّحْمَٰنَ بِالْغَيْبِ ۖ فَبَشِّرْهُ بِمَغْفِرَةٍ وَأَجْرٍ كَرِيمٍ","numberInSurah":11,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3717,"text":"إِنَّا نَحْنُ نُحْيِي الْمَوْتَىٰ وَنَكْتُبُ مَا قَدَّمُوا وَآثَارَهُمْ ۚ وَكُلَّ شَيْءٍ أَحْصَيْنَاهُ فِي إِمَامٍ مُبِينٍ","numberInSurah":12,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3718,"text":"وَاضْرِبْ لَهُمْ مَثَلًا أَصْحَابَ الْقَرْيَةِ إِذْ جَاءَهَا الْمُرْسَلُونَ","numberInSurah":13,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3719,"text":"إِذْ أَرْسَلْنَا إِلَيْهِمُ اثْنَيْنِ فَكَذَّبُوهُمَا فَعَزَّزْنَا بِثَالِثٍ فَقَالُوا إِنَّا إِلَيْكُمْ مُرْسَلُونَ","numberInSurah":14,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3720,"text":"قَالُوا مَا أَنْتُمْ إِلَّا بَشَرٌ مِثْلُنَا وَمَا أَنْزَلَ الرَّحْمَٰنُ مِنْ شَيْءٍ إِنْ أَنْتُمْ إِلَّا تَكْذِبُونَ","numberInSurah":15,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3721,"text":"قَالُوا رَبُّنَا يَعْلَمُ إِنَّا إِلَيْكُمْ لَمُرْسَلُونَ","numberInSurah":16,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3722,"text":"وَمَا عَلَيْنَا إِلَّا الْبَلَاغُ الْمُبِينُ","numberInSurah":17,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3723,"text":"قَالُوا إِنَّا تَطَيَّرْنَا بِكُمْ ۖ لَئِنْ لَمْ تَنْتَهُوا لَنَرْجُمَنَّكُمْ وَلَيَمَسَّنَّكُمْ مِنَّا عَذَابٌ أَلِيمٌ","numberInSurah":18,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3724,"text":"قَالُوا طَائِرُكُمْ مَعَكُمْ ۚ أَئِنْ ذُكِّرْتُمْ ۚ بَلْ أَنْتُمْ قَوْمٌ مُسْرِفُونَ","numberInSurah":19,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3725,"text":"وَجَاءَ مِنْ أَقْصَى الْمَدِينَةِ رَجُلٌ يَسْعَىٰ قَالَ يَا قَوْمِ اتَّبِعُوا الْمُرْسَلِينَ","numberInSurah":20,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3726,"text":"اتَّبِعُوا مَنْ لَا يَسْأَلُكُمْ أَجْرًا وَهُمْ مُهْتَدُونَ","numberInSurah":21,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3727,"text":"وَمَا لِيَ لَا أَعْبُدُ الَّذِي فَطَرَنِي وَإِلَيْهِ تُرْجَعُونَ","numberInSurah":22,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3728,"text":"أَأَتَّخِذُ مِنْ دُونِهِ آلِهَةً إِنْ يُرِدْنِ الرَّحْمَٰنُ بِضُرٍّ لَا تُغْنِ عَنِّي شَفَاعَتُهُمْ شَيْئًا وَلَا يُنْقِذُونِ","numberInSurah":23,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3729,"text":"إِنِّي إِذًا لَفِي ضَلَالٍ مُبِينٍ","numberInSurah":24,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3730,"text":"إِنِّي آمَنْتُ بِرَبِّكُمْ فَاسْمَعُونِ","numberInSurah":25,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3731,"text":"قِيلَ ادْخُلِ الْجَنَّةَ ۖ قَالَ يَا لَيْتَ قَوْمِي يَعْلَمُونَ","numberInSurah":26,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3732,"text":"بِمَا غَفَرَ لِي رَبِّي وَجَعَلَنِي مِنَ الْمُكْرَمِينَ","numberInSurah":27,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3733,"text":"۞ وَمَا أَنْزَلْنَا عَلَىٰ قَوْمِهِ مِنْ بَعْدِهِ مِنْ جُنْدٍ مِنَ السَّمَاءِ وَمَا كُنَّا مُنْزِلِينَ","numberInSurah":28,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3734,"text":"إِنْ كَانَتْ إِلَّا صَيْحَةً وَاحِدَةً فَإِذَا هُمْ خَامِدُونَ","numberInSurah":29,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3735,"text":"يَا حَسْرَةً عَلَى الْعِبَادِ ۚ مَا يَأْتِيهِمْ مِنْ رَسُولٍ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ","numberInSurah":30,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3736,"text":"أَلَمْ يَرَوْا كَمْ أَهْلَكْنَا قَبْلَهُمْ مِنَ الْقُرُونِ أَنَّهُمْ إِلَيْهِمْ لَا يَرْجِعُونَ","numberInSurah":31,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3737,"text":"وَإِنْ كُلٌّ لَمَّا جَمِيعٌ لَدَيْنَا مُحْضَرُونَ","numberInSurah":32,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3738,"text":"وَآيَةٌ لَهُمُ الْأَرْضُ الْمَيْتَةُ أَحْيَيْنَاهَا وَأَخْرَجْنَا مِنْهَا حَبًّا فَمِنْهُ يَأْكُلُونَ","numberInSurah":33,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3739,"text":"وَجَعَلْنَا فِيهَا جَنَّاتٍ مِنْ نَخِيلٍ وَأَعْنَابٍ وَفَجَّرْنَا فِيهَا مِنَ الْعُيُونِ","numberInSurah":34,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3740,"text":"لِيَأْكُلُوا مِنْ ثَمَرِهِ وَمَا عَمِلَتْهُ أَيْدِيهِمْ ۖ أَفَلَا يَشْكُرُونَ","numberInSurah":35,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3741,"text":"سُبْحَانَ الَّذِي خَلَقَ الْأَزْوَاجَ كُلَّهَا مِمَّا تُنْبِتُ الْأَرْضُ وَمِنْ أَنْفُسِهِمْ وَمِمَّا لَا يَعْلَمُونَ","numberInSurah":36,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3742,"text":"وَآيَةٌ لَهُمُ اللَّيْلُ نَسْلَخُ مِنْهُ النَّهَارَ فَإِذَا هُمْ مُظْلِمُونَ","numberInSurah":37,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3743,"text":"وَالشَّمْسُ تَجْرِي لِمُسْتَقَرٍّ لَهَا ۚ ذَٰلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ","numberInSurah":38,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3744,"text":"وَالْقَمَرَ قَدَّرْنَاهُ مَنَازِلَ حَتَّىٰ عَادَ كَالْعُرْجُونِ الْقَدِيمِ","numberInSurah":39,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3745,"text":"لَا الشَّمْسُ يَنْبَغِي لَهَا أَنْ تُدْرِكَ الْقَمَرَ وَلَا اللَّيْلُ سَابِقُ النَّهَارِ ۚ وَكُلٌّ فِي فَلَكٍ يَسْبَحُونَ","numberInSurah":40,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3746,"text":"وَآيَةٌ لَهُمْ أَنَّا حَمَلْنَا ذُرِّيَّتَهُمْ فِي الْفُلْكِ الْمَشْحُونِ","numberInSurah":41,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3747,"text":"وَخَلَقْنَا لَهُمْ مِنْ مِثْلِهِ مَا يَرْكَبُونَ","numberInSurah":42,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3748,"text":"وَإِنْ نَشَأْ نُغْرِقْهُمْ فَلَا صَرِيخَ لَهُمْ وَلَا هُمْ يُنْقَذُونَ","numberInSurah":43,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3749,"text":"إِلَّا رَحْمَةً مِنَّا وَمَتَاعًا إِلَىٰ حِينٍ","numberInSurah":44,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3750,"text":"وَإِذَا قِيلَ لَهُمُ اتَّقُوا مَا بَيْنَ أَيْدِيكُمْ وَمَا خَلْفَكُمْ لَعَلَّكُمْ تُرْحَمُونَ","numberInSurah":45,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3751,"text":"وَمَا تَأْتِيهِمْ مِنْ آيَةٍ مِنْ آيَاتِ رَبِّهِمْ إِلَّا كَانُوا عَنْهَا مُعْرِضِينَ","numberInSurah":46,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3752,"text":"وَإِذَا قِيلَ لَهُمْ أَنْفِقُوا مِمَّا رَزَقَكُمُ اللَّهُ قَالَ الَّذِينَ كَفَرُوا لِلَّذِينَ آمَنُوا أَنُطْعِمُ مَنْ لَوْ يَشَاءُ اللَّهُ أَطْعَمَهُ إِنْ أَنْتُمْ إِلَّا فِي ضَلَالٍ مُبِينٍ","numberInSurah":47,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3753,"text":"وَيَقُولُونَ مَتَىٰ هَٰذَا الْوَعْدُ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":48,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3754,"text":"مَا يَنْظُرُونَ إِلَّا صَيْحَةً وَاحِدَةً تَأْخُذُهُمْ وَهُمْ يَخِصِّمُونَ","numberInSurah":49,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3755,"text":"فَلَا يَسْتَطِيعُونَ تَوْصِيَةً وَلَا إِلَىٰ أَهْلِهِمْ يَرْجِعُونَ","numberInSurah":50,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3756,"text":"وَنُفِخَ فِي الصُّورِ فَإِذَا هُمْ مِنَ الْأَجْدَاثِ إِلَىٰ رَبِّهِمْ يَنْسِلُونَ","numberInSurah":51,"juz":23,"manzil":5,"page":443,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3757,"text":"قَالُوا يَا وَيْلَنَا مَنْ بَعَثَنَا مِنْ مَرْقَدِنَا ۜ ۗ هَٰذَا مَا وَعَدَ الرَّحْمَٰنُ وَصَدَقَ الْمُرْسَلُونَ","numberInSurah":52,"juz":23,"manzil":5,"page":443,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3758,"text":"إِنْ كَانَتْ إِلَّا صَيْحَةً وَاحِدَةً فَإِذَا هُمْ جَمِيعٌ لَدَيْنَا مُحْضَرُونَ","numberInSurah":53,"juz":23,"manzil":5,"page":443,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3759,"text":"فَالْيَوْمَ لَا تُظْلَمُ نَفْسٌ شَيْئًا وَلَا تُجْزَوْنَ إِلَّا مَا كُنْتُمْ تَعْمَلُونَ","numberInSurah":54,"juz":23,"manzil":5,"page":443,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3760,"text":"إِنَّ أَصْحَابَ الْجَنَّةِ الْيَوْمَ فِي شُغُلٍ فَاكِهُونَ","numberInSurah":55,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3761,"text":"هُمْ وَأَزْوَاجُهُمْ فِي ظِلَالٍ عَلَى الْأَرَائِكِ مُتَّكِئُونَ","numberInSurah":56,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3762,"text":"لَهُمْ فِيهَا فَاكِهَةٌ وَلَهُمْ مَا يَدَّعُونَ","numberInSurah":57,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3763,"text":"سَلَامٌ قَوْلًا مِنْ رَبٍّ رَحِيمٍ","numberInSurah":58,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3764,"text":"وَامْتَازُوا الْيَوْمَ أَيُّهَا الْمُجْرِمُونَ","numberInSurah":59,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3765,"text":"۞ أَلَمْ أَعْهَدْ إِلَيْكُمْ يَا بَنِي آدَمَ أَنْ لَا تَعْبُدُوا الشَّيْطَانَ ۖ إِنَّهُ لَكُمْ عَدُوٌّ مُبِينٌ","numberInSurah":60,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3766,"text":"وَأَنِ اعْبُدُونِي ۚ هَٰذَا صِرَاطٌ مُسْتَقِيمٌ","numberInSurah":61,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3767,"text":"وَلَقَدْ أَضَلَّ مِنْكُمْ جِبِلًّا كَثِيرًا ۖ أَفَلَمْ تَكُونُوا تَعْقِلُونَ","numberInSurah":62,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3768,"text":"هَٰذِهِ جَهَنَّمُ الَّتِي كُنْتُمْ تُوعَدُونَ","numberInSurah":63,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3769,"text":"اصْلَوْهَا الْيَوْمَ بِمَا كُنْتُمْ تَكْفُرُونَ","numberInSurah":64,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3770,"text":"الْيَوْمَ نَخْتِمُ عَلَىٰ أَفْوَاهِهِمْ وَتُكَلِّمُنَا أَيْدِيهِمْ وَتَشْهَدُ أَرْجُلُهُمْ بِمَا كَانُوا يَكْسِبُونَ","numberInSurah":65,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3771,"text":"وَلَوْ نَشَاءُ لَطَمَسْنَا عَلَىٰ أَعْيُنِهِمْ فَاسْتَبَقُوا الصِّرَاطَ فَأَنَّىٰ يُبْصِرُونَ","numberInSurah":66,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3772,"text":"وَلَوْ نَشَاءُ لَمَسَخْنَاهُمْ عَلَىٰ مَكَانَتِهِمْ فَمَا اسْتَطَاعُوا مُضِيًّا وَلَا يَرْجِعُونَ","numberInSurah":67,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3773,"text":"وَمَنْ نُعَمِّرْهُ نُنَكِّسْهُ فِي الْخَلْقِ ۖ أَفَلَا يَعْقِلُونَ","numberInSurah":68,"juz":23,"manzil":5,"page":444,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3774,"text":"وَمَا عَلَّمْنَاهُ الشِّعْرَ وَمَا يَنْبَغِي لَهُ ۚ إِنْ هُوَ إِلَّا ذِكْرٌ وَقُرْآنٌ مُبِينٌ","numberInSurah":69,"juz":23,"manzil":5,"page":444,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3775,"text":"لِيُنْذِرَ مَنْ كَانَ حَيًّا وَيَحِقَّ الْقَوْلُ عَلَى الْكَافِرِينَ","numberInSurah":70,"juz":23,"manzil":5,"page":444,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3776,"text":"أَوَلَمْ يَرَوْا أَنَّا خَلَقْنَا لَهُمْ مِمَّا عَمِلَتْ أَيْدِينَا أَنْعَامًا فَهُمْ لَهَا مَالِكُونَ","numberInSurah":71,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3777,"text":"وَذَلَّلْنَاهَا لَهُمْ فَمِنْهَا رَكُوبُهُمْ وَمِنْهَا يَأْكُلُونَ","numberInSurah":72,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3778,"text":"وَلَهُمْ فِيهَا مَنَافِعُ وَمَشَارِبُ ۖ أَفَلَا يَشْكُرُونَ","numberInSurah":73,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3779,"text":"وَاتَّخَذُوا مِنْ دُونِ اللَّهِ آلِهَةً لَعَلَّهُمْ يُنْصَرُونَ","numberInSurah":74,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3780,"text":"لَا يَسْتَطِيعُونَ نَصْرَهُمْ وَهُمْ لَهُمْ جُنْدٌ مُحْضَرُونَ","numberInSurah":75,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3781,"text":"فَلَا يَحْزُنْكَ قَوْلُهُمْ ۘ إِنَّا نَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ","numberInSurah":76,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3782,"text":"أَوَلَمْ يَرَ الْإِنْسَانُ أَنَّا خَلَقْنَاهُ مِنْ نُطْفَةٍ فَإِذَا هُوَ خَصِيمٌ مُبِينٌ","numberInSurah":77,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3783,"text":"وَضَرَبَ لَنَا مَثَلًا وَنَسِيَ خَلْقَهُ ۖ قَالَ مَنْ يُحْيِي الْعِظَامَ وَهِيَ رَمِيمٌ","numberInSurah":78,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3784,"text":"قُلْ يُحْيِيهَا الَّذِي أَنْشَأَهَا أَوَّلَ مَرَّةٍ ۖ وَهُوَ بِكُلِّ خَلْقٍ عَلِيمٌ","numberInSurah":79,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3785,"text":"الَّذِي جَعَلَ لَكُمْ مِنَ الشَّجَرِ الْأَخْضَرِ نَارًا فَإِذَا أَنْتُمْ مِنْهُ تُوقِدُونَ","numberInSurah":80,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3786,"text":"أَوَلَيْسَ الَّذِي خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ بِقَادِرٍ عَلَىٰ أَنْ يَخْلُقَ مِثْلَهُمْ ۚ بَلَىٰ وَهُوَ الْخَلَّاقُ الْعَلِيمُ","numberInSurah":81,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3787,"text":"إِنَّمَا أَمْرُهُ إِذَا أَرَادَ شَيْئًا أَنْ يَقُولَ لَهُ كُنْ فَيَكُونُ","numberInSurah":82,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3788,"text":"فَسُبْحَانَ الَّذِي بِيَدِهِ مَلَكُوتُ كُلِّ شَيْءٍ وَإِلَيْهِ تُرْجَعُونَ","numberInSurah":83,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":36,"name":"سُورَةُ يسٓ","englishName":"Yâsîn","englishNameTranslation":"Yaseen","revelationType":"Meccan","numberOfAyahs":83,"ayahs":[{"number":3706,"text":"Ya, Sin.","numberInSurah":1,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3707,"text":"Kuran'ı Hakim'e and olsun ki, sen doğru yol üzere gönderilmiş peygamberlerdensin.","numberInSurah":2,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3708,"text":"Kuran'ı Hakim'e and olsun ki, sen doğru yol üzere gönderilmiş peygamberlerdensin.","numberInSurah":3,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3709,"text":"Kuran'ı Hakim'e and olsun ki, sen doğru yol üzere gönderilmiş peygamberlerdensin.","numberInSurah":4,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3710,"text":"Bu, babaları uyarılmadığından gafil kalmış bir milleti uyarman için güçlü ve merhametli olan Allah'ın indirdiği Kuran'dır.","numberInSurah":5,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3711,"text":"Bu, babaları uyarılmadığından gafil kalmış bir milleti uyarman için güçlü ve merhametli olan Allah'ın indirdiği Kuran'dır.","numberInSurah":6,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3712,"text":"And olsun ki, hüküm çoğunun aleyhine gerçekleşmiştir, bunun için artık inanmazlar.","numberInSurah":7,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3713,"text":"Boyunlarına, çenelerine kadar varan demir halkalar geçirmişizdir, bunun için başları yukarı kalkıktır.","numberInSurah":8,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3714,"text":"Önlerine ve arkalarına sed çekmişizdir. Gözlerini perdelediğimizden artık göremezler.","numberInSurah":9,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3715,"text":"Onları uyarsan da uyarmasan da birdir, inanmazlar.","numberInSurah":10,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3716,"text":"Sen ancak, Kuran'a uyan ve görmediği halde Rahman'dan korkan kimseyi uyarabilirsin. Artık o kimseyi, bağışlanma ve cömertçe verilecek bir ecirle müjdele.","numberInSurah":11,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3717,"text":"Şüphesiz ölüleri dirilten, işlediklerini ve eserlerini yazan Biziz; herşeyi, apaçık bir kitabda saymışızdır.","numberInSurah":12,"juz":22,"manzil":5,"page":440,"ruku":381,"hizbQuarter":176,"sajda":false},{"number":3718,"text":"İnsanlara, halkına elçiler gelen şehri mesel olarak anlat:","numberInSurah":13,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3719,"text":"Onlara iki elçi göndermiştik; onu yalanladıkları için üçüncü biriyle desteklemiştik. Onlar: \"Biz size gönderildik\" demişlerdi.","numberInSurah":14,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3720,"text":"\"Siz de ancak bizim gibi birer insansınız. Rahman da bir şey indirmemiştir. Sadece yalan söylüyorsunuz\" dediler.","numberInSurah":15,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3721,"text":"Elçiler: \"Doğrusu Rabbimiz bizim size gönderildiğimizi bilir; bize düşen ancak apaçık tebliğdir\" demişlerdi.","numberInSurah":16,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3722,"text":"Elçiler: \"Doğrusu Rabbimiz bizim size gönderildiğimizi bilir; bize düşen ancak apaçık tebliğdir\" demişlerdi.","numberInSurah":17,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3723,"text":"\"Doğrusu sizin yüzünüzden uğursuzluğa uğradık; vazgeçmezseniz and olsun ki sizi taşlayacağız ve bizden size can yakıcı bir azap dokunacaktır\" dediler.","numberInSurah":18,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3724,"text":"Elçiler: \"Uğursuzluğunuz kendinizdendir. Bu uğursuzluk size öğüt verildiği için mi? Hayır; siz, aşırı giden bir milletsiniz\" demişlerdi.","numberInSurah":19,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3725,"text":"Şehrin öbür ucundan koşarak bir adam gelmiş ve şöyle demişti: \"Ey Milletim! Gönderilen elçilere uyun.\"","numberInSurah":20,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3726,"text":"\"Sizden bir ücret istemeyenlere uyun, onlar doğru yoldadırlar.\"","numberInSurah":21,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3727,"text":"\"Beni yaratana ne diye kulluk etmeyeyim? Siz de O'na döneceksiniz.\"","numberInSurah":22,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3728,"text":"\"O'nu bırakıp da tanrılar edinir miyim? Eğer Rahman olan Allah bana bir zarar vermek isterse, o tanrıların şefaati bana fayda vermez, beni kurtaramazlar.\"","numberInSurah":23,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3729,"text":"\"Doğrusu o takdirde apaçık bir sapıklık içinde olurum.\"","numberInSurah":24,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3730,"text":"\"Şüphesiz ben Rabbinize inandım, beni dinleyin.\"","numberInSurah":25,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3731,"text":"Ona \"Cennete gir\" denince, \"Keşke milletim Rabbimin beni bağışladığını ve beni ikrama mazhar olanlardan kıldığını bilseydi!\" demişti.","numberInSurah":26,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3732,"text":"Ona \"Cennete gir\" denince, \"Keşke milletim Rabbimin beni bağışladığını ve beni ikrama mazhar olanlardan kıldığını bilseydi!\" demişti.","numberInSurah":27,"juz":22,"manzil":5,"page":441,"ruku":382,"hizbQuarter":176,"sajda":false},{"number":3733,"text":"Ondan sonra milleti üzerine gökten bir ordu indirmedik; zaten indirecek de değildik; sadece tek bir çığlık.. o kadar, hemen sönüp gittiler.","numberInSurah":28,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3734,"text":"Ondan sonra milleti üzerine gökten bir ordu indirmedik; zaten indirecek de değildik; sadece tek bir çığlık.. o kadar, hemen sönüp gittiler.","numberInSurah":29,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3735,"text":"Kullara yazıklar olsun! Kendilerine hangi elçi gelse, onu alaya alıyorlardı.","numberInSurah":30,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3736,"text":"Kendilerinden önce nice nesilleri yok ettiğimizi, onların bir daha kendilerine dönmediklerini görmezler mi?","numberInSurah":31,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3737,"text":"Hepsi huzurumuza getirileceklerdir.","numberInSurah":32,"juz":23,"manzil":5,"page":442,"ruku":382,"hizbQuarter":177,"sajda":false},{"number":3738,"text":"İşte onlara bir delil: Ölü yeri diriltir ve oradan taneler çıkarırız da ondan yerler.","numberInSurah":33,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3739,"text":"Orada hurmalıklar ve üzüm bağları var ederiz, aralarında pınarlar fışkırtırız.","numberInSurah":34,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3740,"text":"Onun ve elleriyle yaptıklarının ürünlerini yesinler; şükretmezler mi?","numberInSurah":35,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3741,"text":"Yerin yetiştirdiklerinden, kendilerinden ve daha bilmediklerinden çift çift yaratan Allah münezzehtir.","numberInSurah":36,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3742,"text":"Onlara bir delil de gecedir; gündüzü ondan sıyırırız da karanlıkta kalıverirler.","numberInSurah":37,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3743,"text":"Güneş de yörüngesinde yürüyüp gitmektedir. Bu, güçlü ve bilgin olan Allah'ın kanunudur.","numberInSurah":38,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3744,"text":"Ay için de sonunda kuru bir hurma dalına döneceği konaklar tayin etmişizdir.","numberInSurah":39,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3745,"text":"Aya erişmek güneşe düşmez. Gece de gündüzü geçemez. Her biri bir yörüngede yürürler.","numberInSurah":40,"juz":23,"manzil":5,"page":442,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3746,"text":"Onlara bir delil de: Soylarını dolu gemiyle taşımamız ve kendileri için bunun gibi daha nice binekler yaratmış olmamızdır.","numberInSurah":41,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3747,"text":"Onlara bir delil de: Soylarını dolu gemiyle taşımamız ve kendileri için bunun gibi daha nice binekler yaratmış olmamızdır.","numberInSurah":42,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3748,"text":"Dilesek, onları suda boğardık; ne yardımlarına koşan bulunur ve ne de kendileri kurtulabilirlerdi.","numberInSurah":43,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3749,"text":"Ama katımızdan bir rahmet ve bir süreye kadar geçinme olarak onları geri bıraktık.","numberInSurah":44,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3750,"text":"Onlara: \"Geçmişinizden ve geleceğinizden sakının, belki acınırsınız\" dendiği zaman yüz çevirirler.","numberInSurah":45,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3751,"text":"Zaten Rabbinin ayetlerinden herhangi biri kendilerine geldiğinde ondan hep yüz çeviregelmişlerdi.","numberInSurah":46,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3752,"text":"Onlara: \"Allah'ın size verdiği rızıktan sarfedin\" denince inkar edenler inananlara: \"Allah dileseydi doyurabileceği bir kimseyi biz mi doyuralım? Doğrusu siz apaçık bir sapıklıktasınız\" derler.","numberInSurah":47,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3753,"text":"\"Doğru sözlü iseniz bildirin bu vaad ne zamandır?\" derler.","numberInSurah":48,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3754,"text":"Çekişip dururlarken kendilerini yakalayacak bir tek çığlığı beklerler.","numberInSurah":49,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3755,"text":"O zaman, artık ne vasiyet edebilirler ne de ailelerine dönebilirler.","numberInSurah":50,"juz":23,"manzil":5,"page":443,"ruku":383,"hizbQuarter":177,"sajda":false},{"number":3756,"text":"Sura üflenince, kabirlerinden Rablerine koşarak çıkarlar.","numberInSurah":51,"juz":23,"manzil":5,"page":443,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3757,"text":"\"Vah halimize! Yattığımız yerden bizi kim kaldırdı?\" derler. Onlara: \"İşte Rahman olan Allah'ın vadettiği budur, peygamberler doğru söylemişlerdi\" denir.","numberInSurah":52,"juz":23,"manzil":5,"page":443,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3758,"text":"Tek bir çığlık kopar, hepsi, hemen huzurumuza getirilmiş olur.","numberInSurah":53,"juz":23,"manzil":5,"page":443,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3759,"text":"Artık bugün kimseye hiçbir haksızlıkta bulunulmaz. İşlediklerinizden başkasıyla karşılık görmezsiniz.","numberInSurah":54,"juz":23,"manzil":5,"page":443,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3760,"text":"Doğrusu bugün, cennetlikler eğlenceyle meşguldürler.","numberInSurah":55,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3761,"text":"Onlar ve eşleri gölgeliklerde, tahtlar üzerine yaslanmışlardır.","numberInSurah":56,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3762,"text":"Orada meyveler ve her istedikleri onlarındır.","numberInSurah":57,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3763,"text":"Merhametli olan Rab katından onlara selam vardır.","numberInSurah":58,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3764,"text":"Allah şöyle buyurur: Ey suçlular! Bugün müminlerden ayrılın. Ey insanoğulları! Ben size, şeytana tapmayın, o sizin için apaçık bir düşmandır, Bana kulluk edin, bu doğru yoldur, diye bildirmedim mi?","numberInSurah":59,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":177,"sajda":false},{"number":3765,"text":"Allah şöyle buyurur: Ey suçlular! Bugün müminlerden ayrılın. Ey insanoğulları! Ben size, şeytana tapmayın, o sizin için apaçık bir düşmandır, Bana kulluk edin, bu doğru yoldur, diye bildirmedim mi?","numberInSurah":60,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3766,"text":"Allah şöyle buyurur: Ey suçlular! Bugün müminlerden ayrılın. Ey insanoğulları! Ben size, şeytana tapmayın, o sizin için apaçık bir düşmandır, Bana kulluk edin, bu doğru yoldur, diye bildirmedim mi?","numberInSurah":61,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3767,"text":"And olsun ki, o sizden nice nesilleri saptırmıştı, akletmez miydiniz?","numberInSurah":62,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3768,"text":"İşte bu, size söz verilen cehennemdir.","numberInSurah":63,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3769,"text":"Bugün, inkarcılığınıza karşılık oraya girin.","numberInSurah":64,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3770,"text":"İşte o gün ağızlarını mühürleriz, Bizimle elleri konuşur, ayakları da yaptıklarına şahidlik eder.","numberInSurah":65,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3771,"text":"Dilesek, gözlerini kör ederdik de yol bulmağa çalışırlardı. Nasıl görebilirlerdi?","numberInSurah":66,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3772,"text":"Dilesek, onları oldukları yerde dondururduk da, ne ileri gidebilirler ve ne de geri dönebilirlerdi.","numberInSurah":67,"juz":23,"manzil":5,"page":444,"ruku":384,"hizbQuarter":178,"sajda":false},{"number":3773,"text":"Uzun ömürlü yaptığımızın hilkatini tersine çevirmişizdir. Akletmezler mi?","numberInSurah":68,"juz":23,"manzil":5,"page":444,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3774,"text":"Biz ona şiir öğretmedik, zaten ona gerekmezdi. Bu bir öğüt ve apaçık Kuran'dır.","numberInSurah":69,"juz":23,"manzil":5,"page":444,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3775,"text":"Diri olan kimseyi uyarsın ve verilen söz de inkarcıların aleyhine çıksın.","numberInSurah":70,"juz":23,"manzil":5,"page":444,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3776,"text":"Kudretimizle kendileri için hayvanlar yarattığımızı görmezler mi? Onlara sahip olmaktadırlar.","numberInSurah":71,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3777,"text":"Onları kendilerinin buyruğuna verdik; bindikleri de, etini yedikleri de vardır.","numberInSurah":72,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3778,"text":"Onlarda daha nice faydalar, içecekler vardır; şükretmezler mi?","numberInSurah":73,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3779,"text":"Allah'ı bırakıp da, kendilerine yardımı dokunur diye, başka tanrılar edindiler.","numberInSurah":74,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3780,"text":"Oysa onlar yardım edemezler, ancak kendileri o tanrılara koruyuculuk için nöbet beklerler.","numberInSurah":75,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3781,"text":"Bunların sözü seni üzmesin. Biz onların gizlediklerini de, açığa vurduklarını da şüphesiz biliriz.","numberInSurah":76,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3782,"text":"İnsan kendisini bir nutfeden yarattığımızı görmez mi ki hemen apaçık bir hasım kesilir ve kendi yaratılışını unutur da; \"Çürümüş kemikleri kim yaratacak\" diyerek, Bize misal vermeye kalkar?","numberInSurah":77,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3783,"text":"İnsan kendisini bir nutfeden yarattığımızı görmez mi ki hemen apaçık bir hasım kesilir ve kendi yaratılışını unutur da; \"Çürümüş kemikleri kim yaratacak\" diyerek, Bize misal vermeye kalkar?","numberInSurah":78,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3784,"text":"De ki: \"Onları ilk defa yaratan diriltecektir. O, her türlü yaratmayı bilendir.\"","numberInSurah":79,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3785,"text":"Yaş ağaçtan size ateş çıkarandır. Ondan ateş yakarsınız.","numberInSurah":80,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3786,"text":"Gökleri ve yeri yaratan, kendilerinin benzerini yaratmaya kadir olmaz mı? Elbette olur; çünkü O, yaratan ve bilendir.","numberInSurah":81,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3787,"text":"Bir şeyi dilediği zaman, O'nun buyruğu sadece, o şeye \"Ol\" demektir, hemen olur.","numberInSurah":82,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false},{"number":3788,"text":"Her şeyin hükümranlığı elinde olan ve sizin de kendisine döneceğiniz Allah münezzehtir.","numberInSurah":83,"juz":23,"manzil":5,"page":445,"ruku":385,"hizbQuarter":178,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}