{"arabic":{"number":40,"name":"سُورَةُ غَافِرٍ","englishName":"Mü'min","englishNameTranslation":"The Forgiver","revelationType":"Meccan","numberOfAyahs":85,"ayahs":[{"number":4134,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ حم","numberInSurah":1,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4135,"text":"تَنْزِيلُ الْكِتَابِ مِنَ اللَّهِ الْعَزِيزِ الْعَلِيمِ","numberInSurah":2,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4136,"text":"غَافِرِ الذَّنْبِ وَقَابِلِ التَّوْبِ شَدِيدِ الْعِقَابِ ذِي الطَّوْلِ ۖ لَا إِلَٰهَ إِلَّا هُوَ ۖ إِلَيْهِ الْمَصِيرُ","numberInSurah":3,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4137,"text":"مَا يُجَادِلُ فِي آيَاتِ اللَّهِ إِلَّا الَّذِينَ كَفَرُوا فَلَا يَغْرُرْكَ تَقَلُّبُهُمْ فِي الْبِلَادِ","numberInSurah":4,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4138,"text":"كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَالْأَحْزَابُ مِنْ بَعْدِهِمْ ۖ وَهَمَّتْ كُلُّ أُمَّةٍ بِرَسُولِهِمْ لِيَأْخُذُوهُ ۖ وَجَادَلُوا بِالْبَاطِلِ لِيُدْحِضُوا بِهِ الْحَقَّ فَأَخَذْتُهُمْ ۖ فَكَيْفَ كَانَ عِقَابِ","numberInSurah":5,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4139,"text":"وَكَذَٰلِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى الَّذِينَ كَفَرُوا أَنَّهُمْ أَصْحَابُ النَّارِ","numberInSurah":6,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4140,"text":"الَّذِينَ يَحْمِلُونَ الْعَرْشَ وَمَنْ حَوْلَهُ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيُؤْمِنُونَ بِهِ وَيَسْتَغْفِرُونَ لِلَّذِينَ آمَنُوا رَبَّنَا وَسِعْتَ كُلَّ شَيْءٍ رَحْمَةً وَعِلْمًا فَاغْفِرْ لِلَّذِينَ تَابُوا وَاتَّبَعُوا سَبِيلَكَ وَقِهِمْ عَذَابَ الْجَحِيمِ","numberInSurah":7,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4141,"text":"رَبَّنَا وَأَدْخِلْهُمْ جَنَّاتِ عَدْنٍ الَّتِي وَعَدْتَهُمْ وَمَنْ صَلَحَ مِنْ آبَائِهِمْ وَأَزْوَاجِهِمْ وَذُرِّيَّاتِهِمْ ۚ إِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ","numberInSurah":8,"juz":24,"manzil":6,"page":468,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4142,"text":"وَقِهِمُ السَّيِّئَاتِ ۚ وَمَنْ تَقِ السَّيِّئَاتِ يَوْمَئِذٍ فَقَدْ رَحِمْتَهُ ۚ وَذَٰلِكَ هُوَ الْفَوْزُ الْعَظِيمُ","numberInSurah":9,"juz":24,"manzil":6,"page":468,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4143,"text":"إِنَّ الَّذِينَ كَفَرُوا يُنَادَوْنَ لَمَقْتُ اللَّهِ أَكْبَرُ مِنْ مَقْتِكُمْ أَنْفُسَكُمْ إِذْ تُدْعَوْنَ إِلَى الْإِيمَانِ فَتَكْفُرُونَ","numberInSurah":10,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4144,"text":"قَالُوا رَبَّنَا أَمَتَّنَا اثْنَتَيْنِ وَأَحْيَيْتَنَا اثْنَتَيْنِ فَاعْتَرَفْنَا بِذُنُوبِنَا فَهَلْ إِلَىٰ خُرُوجٍ مِنْ سَبِيلٍ","numberInSurah":11,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4145,"text":"ذَٰلِكُمْ بِأَنَّهُ إِذَا دُعِيَ اللَّهُ وَحْدَهُ كَفَرْتُمْ ۖ وَإِنْ يُشْرَكْ بِهِ تُؤْمِنُوا ۚ فَالْحُكْمُ لِلَّهِ الْعَلِيِّ الْكَبِيرِ","numberInSurah":12,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4146,"text":"هُوَ الَّذِي يُرِيكُمْ آيَاتِهِ وَيُنَزِّلُ لَكُمْ مِنَ السَّمَاءِ رِزْقًا ۚ وَمَا يَتَذَكَّرُ إِلَّا مَنْ يُنِيبُ","numberInSurah":13,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4147,"text":"فَادْعُوا اللَّهَ مُخْلِصِينَ لَهُ الدِّينَ وَلَوْ كَرِهَ الْكَافِرُونَ","numberInSurah":14,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4148,"text":"رَفِيعُ الدَّرَجَاتِ ذُو الْعَرْشِ يُلْقِي الرُّوحَ مِنْ أَمْرِهِ عَلَىٰ مَنْ يَشَاءُ مِنْ عِبَادِهِ لِيُنْذِرَ يَوْمَ التَّلَاقِ","numberInSurah":15,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4149,"text":"يَوْمَ هُمْ بَارِزُونَ ۖ لَا يَخْفَىٰ عَلَى اللَّهِ مِنْهُمْ شَيْءٌ ۚ لِمَنِ الْمُلْكُ الْيَوْمَ ۖ لِلَّهِ الْوَاحِدِ الْقَهَّارِ","numberInSurah":16,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4150,"text":"الْيَوْمَ تُجْزَىٰ كُلُّ نَفْسٍ بِمَا كَسَبَتْ ۚ لَا ظُلْمَ الْيَوْمَ ۚ إِنَّ اللَّهَ سَرِيعُ الْحِسَابِ","numberInSurah":17,"juz":24,"manzil":6,"page":469,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4151,"text":"وَأَنْذِرْهُمْ يَوْمَ الْآزِفَةِ إِذِ الْقُلُوبُ لَدَى الْحَنَاجِرِ كَاظِمِينَ ۚ مَا لِلظَّالِمِينَ مِنْ حَمِيمٍ وَلَا شَفِيعٍ يُطَاعُ","numberInSurah":18,"juz":24,"manzil":6,"page":469,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4152,"text":"يَعْلَمُ خَائِنَةَ الْأَعْيُنِ وَمَا تُخْفِي الصُّدُورُ","numberInSurah":19,"juz":24,"manzil":6,"page":469,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4153,"text":"وَاللَّهُ يَقْضِي بِالْحَقِّ ۖ وَالَّذِينَ يَدْعُونَ مِنْ دُونِهِ لَا يَقْضُونَ بِشَيْءٍ ۗ إِنَّ اللَّهَ هُوَ السَّمِيعُ الْبَصِيرُ","numberInSurah":20,"juz":24,"manzil":6,"page":469,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4154,"text":"۞ أَوَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ كَانُوا مِنْ قَبْلِهِمْ ۚ كَانُوا هُمْ أَشَدَّ مِنْهُمْ قُوَّةً وَآثَارًا فِي الْأَرْضِ فَأَخَذَهُمُ اللَّهُ بِذُنُوبِهِمْ وَمَا كَانَ لَهُمْ مِنَ اللَّهِ مِنْ وَاقٍ","numberInSurah":21,"juz":24,"manzil":6,"page":469,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4155,"text":"ذَٰلِكَ بِأَنَّهُمْ كَانَتْ تَأْتِيهِمْ رُسُلُهُمْ بِالْبَيِّنَاتِ فَكَفَرُوا فَأَخَذَهُمُ اللَّهُ ۚ إِنَّهُ قَوِيٌّ شَدِيدُ الْعِقَابِ","numberInSurah":22,"juz":24,"manzil":6,"page":469,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4156,"text":"وَلَقَدْ أَرْسَلْنَا مُوسَىٰ بِآيَاتِنَا وَسُلْطَانٍ مُبِينٍ","numberInSurah":23,"juz":24,"manzil":6,"page":469,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4157,"text":"إِلَىٰ فِرْعَوْنَ وَهَامَانَ وَقَارُونَ فَقَالُوا سَاحِرٌ كَذَّابٌ","numberInSurah":24,"juz":24,"manzil":6,"page":469,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4158,"text":"فَلَمَّا جَاءَهُمْ بِالْحَقِّ مِنْ عِنْدِنَا قَالُوا اقْتُلُوا أَبْنَاءَ الَّذِينَ آمَنُوا مَعَهُ وَاسْتَحْيُوا نِسَاءَهُمْ ۚ وَمَا كَيْدُ الْكَافِرِينَ إِلَّا فِي ضَلَالٍ","numberInSurah":25,"juz":24,"manzil":6,"page":469,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4159,"text":"وَقَالَ فِرْعَوْنُ ذَرُونِي أَقْتُلْ مُوسَىٰ وَلْيَدْعُ رَبَّهُ ۖ إِنِّي أَخَافُ أَنْ يُبَدِّلَ دِينَكُمْ أَوْ أَنْ يُظْهِرَ فِي الْأَرْضِ الْفَسَادَ","numberInSurah":26,"juz":24,"manzil":6,"page":470,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4160,"text":"وَقَالَ مُوسَىٰ إِنِّي عُذْتُ بِرَبِّي وَرَبِّكُمْ مِنْ كُلِّ مُتَكَبِّرٍ لَا يُؤْمِنُ بِيَوْمِ الْحِسَابِ","numberInSurah":27,"juz":24,"manzil":6,"page":470,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4161,"text":"وَقَالَ رَجُلٌ مُؤْمِنٌ مِنْ آلِ فِرْعَوْنَ يَكْتُمُ إِيمَانَهُ أَتَقْتُلُونَ رَجُلًا أَنْ يَقُولَ رَبِّيَ اللَّهُ وَقَدْ جَاءَكُمْ بِالْبَيِّنَاتِ مِنْ رَبِّكُمْ ۖ وَإِنْ يَكُ كَاذِبًا فَعَلَيْهِ كَذِبُهُ ۖ وَإِنْ يَكُ صَادِقًا يُصِبْكُمْ بَعْضُ الَّذِي يَعِدُكُمْ ۖ إِنَّ اللَّهَ لَا يَهْدِي مَنْ هُوَ مُسْرِفٌ كَذَّابٌ","numberInSurah":28,"juz":24,"manzil":6,"page":470,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4162,"text":"يَا قَوْمِ لَكُمُ الْمُلْكُ الْيَوْمَ ظَاهِرِينَ فِي الْأَرْضِ فَمَنْ يَنْصُرُنَا مِنْ بَأْسِ اللَّهِ إِنْ جَاءَنَا ۚ قَالَ فِرْعَوْنُ مَا أُرِيكُمْ إِلَّا مَا أَرَىٰ وَمَا أَهْدِيكُمْ إِلَّا سَبِيلَ الرَّشَادِ","numberInSurah":29,"juz":24,"manzil":6,"page":470,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4163,"text":"وَقَالَ الَّذِي آمَنَ يَا قَوْمِ إِنِّي أَخَافُ عَلَيْكُمْ مِثْلَ يَوْمِ الْأَحْزَابِ","numberInSurah":30,"juz":24,"manzil":6,"page":470,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4164,"text":"مِثْلَ دَأْبِ قَوْمِ نُوحٍ وَعَادٍ وَثَمُودَ وَالَّذِينَ مِنْ بَعْدِهِمْ ۚ وَمَا اللَّهُ يُرِيدُ ظُلْمًا لِلْعِبَادِ","numberInSurah":31,"juz":24,"manzil":6,"page":470,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4165,"text":"وَيَا قَوْمِ إِنِّي أَخَافُ عَلَيْكُمْ يَوْمَ التَّنَادِ","numberInSurah":32,"juz":24,"manzil":6,"page":470,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4166,"text":"يَوْمَ تُوَلُّونَ مُدْبِرِينَ مَا لَكُمْ مِنَ اللَّهِ مِنْ عَاصِمٍ ۗ وَمَنْ يُضْلِلِ اللَّهُ فَمَا لَهُ مِنْ هَادٍ","numberInSurah":33,"juz":24,"manzil":6,"page":470,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4167,"text":"وَلَقَدْ جَاءَكُمْ يُوسُفُ مِنْ قَبْلُ بِالْبَيِّنَاتِ فَمَا زِلْتُمْ فِي شَكٍّ مِمَّا جَاءَكُمْ بِهِ ۖ حَتَّىٰ إِذَا هَلَكَ قُلْتُمْ لَنْ يَبْعَثَ اللَّهُ مِنْ بَعْدِهِ رَسُولًا ۚ كَذَٰلِكَ يُضِلُّ اللَّهُ مَنْ هُوَ مُسْرِفٌ مُرْتَابٌ","numberInSurah":34,"juz":24,"manzil":6,"page":471,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4168,"text":"الَّذِينَ يُجَادِلُونَ فِي آيَاتِ اللَّهِ بِغَيْرِ سُلْطَانٍ أَتَاهُمْ ۖ كَبُرَ مَقْتًا عِنْدَ اللَّهِ وَعِنْدَ الَّذِينَ آمَنُوا ۚ كَذَٰلِكَ يَطْبَعُ اللَّهُ عَلَىٰ كُلِّ قَلْبِ مُتَكَبِّرٍ جَبَّارٍ","numberInSurah":35,"juz":24,"manzil":6,"page":471,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4169,"text":"وَقَالَ فِرْعَوْنُ يَا هَامَانُ ابْنِ لِي صَرْحًا لَعَلِّي أَبْلُغُ الْأَسْبَابَ","numberInSurah":36,"juz":24,"manzil":6,"page":471,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4170,"text":"أَسْبَابَ السَّمَاوَاتِ فَأَطَّلِعَ إِلَىٰ إِلَٰهِ مُوسَىٰ وَإِنِّي لَأَظُنُّهُ كَاذِبًا ۚ وَكَذَٰلِكَ زُيِّنَ لِفِرْعَوْنَ سُوءُ عَمَلِهِ وَصُدَّ عَنِ السَّبِيلِ ۚ وَمَا كَيْدُ فِرْعَوْنَ إِلَّا فِي تَبَابٍ","numberInSurah":37,"juz":24,"manzil":6,"page":471,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4171,"text":"وَقَالَ الَّذِي آمَنَ يَا قَوْمِ اتَّبِعُونِ أَهْدِكُمْ سَبِيلَ الرَّشَادِ","numberInSurah":38,"juz":24,"manzil":6,"page":471,"ruku":408,"hizbQuarter":188,"sajda":false},{"number":4172,"text":"يَا قَوْمِ إِنَّمَا هَٰذِهِ الْحَيَاةُ الدُّنْيَا مَتَاعٌ وَإِنَّ الْآخِرَةَ هِيَ دَارُ الْقَرَارِ","numberInSurah":39,"juz":24,"manzil":6,"page":471,"ruku":408,"hizbQuarter":188,"sajda":false},{"number":4173,"text":"مَنْ عَمِلَ سَيِّئَةً فَلَا يُجْزَىٰ إِلَّا مِثْلَهَا ۖ وَمَنْ عَمِلَ صَالِحًا مِنْ ذَكَرٍ أَوْ أُنْثَىٰ وَهُوَ مُؤْمِنٌ فَأُولَٰئِكَ يَدْخُلُونَ الْجَنَّةَ يُرْزَقُونَ فِيهَا بِغَيْرِ حِسَابٍ","numberInSurah":40,"juz":24,"manzil":6,"page":471,"ruku":408,"hizbQuarter":188,"sajda":false},{"number":4174,"text":"۞ وَيَا قَوْمِ مَا لِي أَدْعُوكُمْ إِلَى النَّجَاةِ وَتَدْعُونَنِي إِلَى النَّارِ","numberInSurah":41,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4175,"text":"تَدْعُونَنِي لِأَكْفُرَ بِاللَّهِ وَأُشْرِكَ بِهِ مَا لَيْسَ لِي بِهِ عِلْمٌ وَأَنَا أَدْعُوكُمْ إِلَى الْعَزِيزِ الْغَفَّارِ","numberInSurah":42,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4176,"text":"لَا جَرَمَ أَنَّمَا تَدْعُونَنِي إِلَيْهِ لَيْسَ لَهُ دَعْوَةٌ فِي الدُّنْيَا وَلَا فِي الْآخِرَةِ وَأَنَّ مَرَدَّنَا إِلَى اللَّهِ وَأَنَّ الْمُسْرِفِينَ هُمْ أَصْحَابُ النَّارِ","numberInSurah":43,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4177,"text":"فَسَتَذْكُرُونَ مَا أَقُولُ لَكُمْ ۚ وَأُفَوِّضُ أَمْرِي إِلَى اللَّهِ ۚ إِنَّ اللَّهَ بَصِيرٌ بِالْعِبَادِ","numberInSurah":44,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4178,"text":"فَوَقَاهُ اللَّهُ سَيِّئَاتِ مَا مَكَرُوا ۖ وَحَاقَ بِآلِ فِرْعَوْنَ سُوءُ الْعَذَابِ","numberInSurah":45,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4179,"text":"النَّارُ يُعْرَضُونَ عَلَيْهَا غُدُوًّا وَعَشِيًّا ۖ وَيَوْمَ تَقُومُ السَّاعَةُ أَدْخِلُوا آلَ فِرْعَوْنَ أَشَدَّ الْعَذَابِ","numberInSurah":46,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4180,"text":"وَإِذْ يَتَحَاجُّونَ فِي النَّارِ فَيَقُولُ الضُّعَفَاءُ لِلَّذِينَ اسْتَكْبَرُوا إِنَّا كُنَّا لَكُمْ تَبَعًا فَهَلْ أَنْتُمْ مُغْنُونَ عَنَّا نَصِيبًا مِنَ النَّارِ","numberInSurah":47,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4181,"text":"قَالَ الَّذِينَ اسْتَكْبَرُوا إِنَّا كُلٌّ فِيهَا إِنَّ اللَّهَ قَدْ حَكَمَ بَيْنَ الْعِبَادِ","numberInSurah":48,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4182,"text":"وَقَالَ الَّذِينَ فِي النَّارِ لِخَزَنَةِ جَهَنَّمَ ادْعُوا رَبَّكُمْ يُخَفِّفْ عَنَّا يَوْمًا مِنَ الْعَذَابِ","numberInSurah":49,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4183,"text":"قَالُوا أَوَلَمْ تَكُ تَأْتِيكُمْ رُسُلُكُمْ بِالْبَيِّنَاتِ ۖ قَالُوا بَلَىٰ ۚ قَالُوا فَادْعُوا ۗ وَمَا دُعَاءُ الْكَافِرِينَ إِلَّا فِي ضَلَالٍ","numberInSurah":50,"juz":24,"manzil":6,"page":473,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4184,"text":"إِنَّا لَنَنْصُرُ رُسُلَنَا وَالَّذِينَ آمَنُوا فِي الْحَيَاةِ الدُّنْيَا وَيَوْمَ يَقُومُ الْأَشْهَادُ","numberInSurah":51,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4185,"text":"يَوْمَ لَا يَنْفَعُ الظَّالِمِينَ مَعْذِرَتُهُمْ ۖ وَلَهُمُ اللَّعْنَةُ وَلَهُمْ سُوءُ الدَّارِ","numberInSurah":52,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4186,"text":"وَلَقَدْ آتَيْنَا مُوسَى الْهُدَىٰ وَأَوْرَثْنَا بَنِي إِسْرَائِيلَ الْكِتَابَ","numberInSurah":53,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4187,"text":"هُدًى وَذِكْرَىٰ لِأُولِي الْأَلْبَابِ","numberInSurah":54,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4188,"text":"فَاصْبِرْ إِنَّ وَعْدَ اللَّهِ حَقٌّ وَاسْتَغْفِرْ لِذَنْبِكَ وَسَبِّحْ بِحَمْدِ رَبِّكَ بِالْعَشِيِّ وَالْإِبْكَارِ","numberInSurah":55,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4189,"text":"إِنَّ الَّذِينَ يُجَادِلُونَ فِي آيَاتِ اللَّهِ بِغَيْرِ سُلْطَانٍ أَتَاهُمْ ۙ إِنْ فِي صُدُورِهِمْ إِلَّا كِبْرٌ مَا هُمْ بِبَالِغِيهِ ۚ فَاسْتَعِذْ بِاللَّهِ ۖ إِنَّهُ هُوَ السَّمِيعُ الْبَصِيرُ","numberInSurah":56,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4190,"text":"لَخَلْقُ السَّمَاوَاتِ وَالْأَرْضِ أَكْبَرُ مِنْ خَلْقِ النَّاسِ وَلَٰكِنَّ أَكْثَرَ النَّاسِ لَا يَعْلَمُونَ","numberInSurah":57,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4191,"text":"وَمَا يَسْتَوِي الْأَعْمَىٰ وَالْبَصِيرُ وَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ وَلَا الْمُسِيءُ ۚ قَلِيلًا مَا تَتَذَكَّرُونَ","numberInSurah":58,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4192,"text":"إِنَّ السَّاعَةَ لَآتِيَةٌ لَا رَيْبَ فِيهَا وَلَٰكِنَّ أَكْثَرَ النَّاسِ لَا يُؤْمِنُونَ","numberInSurah":59,"juz":24,"manzil":6,"page":474,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4193,"text":"وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ ۚ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ","numberInSurah":60,"juz":24,"manzil":6,"page":474,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4194,"text":"اللَّهُ الَّذِي جَعَلَ لَكُمُ اللَّيْلَ لِتَسْكُنُوا فِيهِ وَالنَّهَارَ مُبْصِرًا ۚ إِنَّ اللَّهَ لَذُو فَضْلٍ عَلَى النَّاسِ وَلَٰكِنَّ أَكْثَرَ النَّاسِ لَا يَشْكُرُونَ","numberInSurah":61,"juz":24,"manzil":6,"page":474,"ruku":410,"hizbQuarter":189,"sajda":false},{"number":4195,"text":"ذَٰلِكُمُ اللَّهُ رَبُّكُمْ خَالِقُ كُلِّ شَيْءٍ لَا إِلَٰهَ إِلَّا هُوَ ۖ فَأَنَّىٰ تُؤْفَكُونَ","numberInSurah":62,"juz":24,"manzil":6,"page":474,"ruku":410,"hizbQuarter":189,"sajda":false},{"number":4196,"text":"كَذَٰلِكَ يُؤْفَكُ الَّذِينَ كَانُوا بِآيَاتِ اللَّهِ يَجْحَدُونَ","numberInSurah":63,"juz":24,"manzil":6,"page":474,"ruku":410,"hizbQuarter":189,"sajda":false},{"number":4197,"text":"اللَّهُ الَّذِي جَعَلَ لَكُمُ الْأَرْضَ قَرَارًا وَالسَّمَاءَ بِنَاءً وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ وَرَزَقَكُمْ مِنَ الطَّيِّبَاتِ ۚ ذَٰلِكُمُ اللَّهُ رَبُّكُمْ ۖ فَتَبَارَكَ اللَّهُ رَبُّ الْعَالَمِينَ","numberInSurah":64,"juz":24,"manzil":6,"page":474,"ruku":410,"hizbQuarter":189,"sajda":false},{"number":4198,"text":"هُوَ الْحَيُّ لَا إِلَٰهَ إِلَّا هُوَ فَادْعُوهُ مُخْلِصِينَ لَهُ الدِّينَ ۗ الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ","numberInSurah":65,"juz":24,"manzil":6,"page":474,"ruku":410,"hizbQuarter":189,"sajda":false},{"number":4199,"text":"۞ قُلْ إِنِّي نُهِيتُ أَنْ أَعْبُدَ الَّذِينَ تَدْعُونَ مِنْ دُونِ اللَّهِ لَمَّا جَاءَنِيَ الْبَيِّنَاتُ مِنْ رَبِّي وَأُمِرْتُ أَنْ أُسْلِمَ لِرَبِّ الْعَالَمِينَ","numberInSurah":66,"juz":24,"manzil":6,"page":474,"ruku":410,"hizbQuarter":190,"sajda":false},{"number":4200,"text":"هُوَ الَّذِي خَلَقَكُمْ مِنْ تُرَابٍ ثُمَّ مِنْ نُطْفَةٍ ثُمَّ مِنْ عَلَقَةٍ ثُمَّ يُخْرِجُكُمْ طِفْلًا ثُمَّ لِتَبْلُغُوا أَشُدَّكُمْ ثُمَّ لِتَكُونُوا شُيُوخًا ۚ وَمِنْكُمْ مَنْ يُتَوَفَّىٰ مِنْ قَبْلُ ۖ وَلِتَبْلُغُوا أَجَلًا مُسَمًّى وَلَعَلَّكُمْ تَعْقِلُونَ","numberInSurah":67,"juz":24,"manzil":6,"page":475,"ruku":410,"hizbQuarter":190,"sajda":false},{"number":4201,"text":"هُوَ الَّذِي يُحْيِي وَيُمِيتُ ۖ فَإِذَا قَضَىٰ أَمْرًا فَإِنَّمَا يَقُولُ لَهُ كُنْ فَيَكُونُ","numberInSurah":68,"juz":24,"manzil":6,"page":475,"ruku":410,"hizbQuarter":190,"sajda":false},{"number":4202,"text":"أَلَمْ تَرَ إِلَى الَّذِينَ يُجَادِلُونَ فِي آيَاتِ اللَّهِ أَنَّىٰ يُصْرَفُونَ","numberInSurah":69,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4203,"text":"الَّذِينَ كَذَّبُوا بِالْكِتَابِ وَبِمَا أَرْسَلْنَا بِهِ رُسُلَنَا ۖ فَسَوْفَ يَعْلَمُونَ","numberInSurah":70,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4204,"text":"إِذِ الْأَغْلَالُ فِي أَعْنَاقِهِمْ وَالسَّلَاسِلُ يُسْحَبُونَ","numberInSurah":71,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4205,"text":"فِي الْحَمِيمِ ثُمَّ فِي النَّارِ يُسْجَرُونَ","numberInSurah":72,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4206,"text":"ثُمَّ قِيلَ لَهُمْ أَيْنَ مَا كُنْتُمْ تُشْرِكُونَ","numberInSurah":73,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4207,"text":"مِنْ دُونِ اللَّهِ ۖ قَالُوا ضَلُّوا عَنَّا بَلْ لَمْ نَكُنْ نَدْعُو مِنْ قَبْلُ شَيْئًا ۚ كَذَٰلِكَ يُضِلُّ اللَّهُ الْكَافِرِينَ","numberInSurah":74,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4208,"text":"ذَٰلِكُمْ بِمَا كُنْتُمْ تَفْرَحُونَ فِي الْأَرْضِ بِغَيْرِ الْحَقِّ وَبِمَا كُنْتُمْ تَمْرَحُونَ","numberInSurah":75,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4209,"text":"ادْخُلُوا أَبْوَابَ جَهَنَّمَ خَالِدِينَ فِيهَا ۖ فَبِئْسَ مَثْوَى الْمُتَكَبِّرِينَ","numberInSurah":76,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4210,"text":"فَاصْبِرْ إِنَّ وَعْدَ اللَّهِ حَقٌّ ۚ فَإِمَّا نُرِيَنَّكَ بَعْضَ الَّذِي نَعِدُهُمْ أَوْ نَتَوَفَّيَنَّكَ فَإِلَيْنَا يُرْجَعُونَ","numberInSurah":77,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4211,"text":"وَلَقَدْ أَرْسَلْنَا رُسُلًا مِنْ قَبْلِكَ مِنْهُمْ مَنْ قَصَصْنَا عَلَيْكَ وَمِنْهُمْ مَنْ لَمْ نَقْصُصْ عَلَيْكَ ۗ وَمَا كَانَ لِرَسُولٍ أَنْ يَأْتِيَ بِآيَةٍ إِلَّا بِإِذْنِ اللَّهِ ۚ فَإِذَا جَاءَ أَمْرُ اللَّهِ قُضِيَ بِالْحَقِّ وَخَسِرَ هُنَالِكَ الْمُبْطِلُونَ","numberInSurah":78,"juz":24,"manzil":6,"page":476,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4212,"text":"اللَّهُ الَّذِي جَعَلَ لَكُمُ الْأَنْعَامَ لِتَرْكَبُوا مِنْهَا وَمِنْهَا تَأْكُلُونَ","numberInSurah":79,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false},{"number":4213,"text":"وَلَكُمْ فِيهَا مَنَافِعُ وَلِتَبْلُغُوا عَلَيْهَا حَاجَةً فِي صُدُورِكُمْ وَعَلَيْهَا وَعَلَى الْفُلْكِ تُحْمَلُونَ","numberInSurah":80,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false},{"number":4214,"text":"وَيُرِيكُمْ آيَاتِهِ فَأَيَّ آيَاتِ اللَّهِ تُنْكِرُونَ","numberInSurah":81,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false},{"number":4215,"text":"أَفَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلِهِمْ ۚ كَانُوا أَكْثَرَ مِنْهُمْ وَأَشَدَّ قُوَّةً وَآثَارًا فِي الْأَرْضِ فَمَا أَغْنَىٰ عَنْهُمْ مَا كَانُوا يَكْسِبُونَ","numberInSurah":82,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false},{"number":4216,"text":"فَلَمَّا جَاءَتْهُمْ رُسُلُهُمْ بِالْبَيِّنَاتِ فَرِحُوا بِمَا عِنْدَهُمْ مِنَ الْعِلْمِ وَحَاقَ بِهِمْ مَا كَانُوا بِهِ يَسْتَهْزِئُونَ","numberInSurah":83,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false},{"number":4217,"text":"فَلَمَّا رَأَوْا بَأْسَنَا قَالُوا آمَنَّا بِاللَّهِ وَحْدَهُ وَكَفَرْنَا بِمَا كُنَّا بِهِ مُشْرِكِينَ","numberInSurah":84,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false},{"number":4218,"text":"فَلَمْ يَكُ يَنْفَعُهُمْ إِيمَانُهُمْ لَمَّا رَأَوْا بَأْسَنَا ۖ سُنَّتَ اللَّهِ الَّتِي قَدْ خَلَتْ فِي عِبَادِهِ ۖ وَخَسِرَ هُنَالِكَ الْكَافِرُونَ","numberInSurah":85,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":40,"name":"سُورَةُ غَافِرٍ","englishName":"Mü'min","englishNameTranslation":"The Forgiver","revelationType":"Meccan","numberOfAyahs":85,"ayahs":[{"number":4134,"text":"Ha, Mim.","numberInSurah":1,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4135,"text":"Kitap'ın indirilmesi, güçlü ve bilgin olan Allah katındandır.","numberInSurah":2,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4136,"text":"O, günahı bağışlayan, tevbeyi kabul eden, cezası şiddetli, lütfu bol olandır. O'ndan başka tanrı yoktur, dönüş O'nadır.","numberInSurah":3,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4137,"text":"Allah'ın ayetleri üzerinde, inkar edenlerden başkası tartışmaya girişmez. İnkarcıların memlekette gezip dolaşması seni aldatmasın.","numberInSurah":4,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4138,"text":"Onlardan önce, Nuh milleti, ardından, peygamberlere karşı gelen topluluklar da peygamberlerini yalanlamış; her ümmet, peygamberini cezalandırmaya azmetmişti. Hakkı batılla gidermek için mücadele etmişlerdi. Bunun üzerine Ben onları yakaladım. Cezalandırmam nasılmış?","numberInSurah":5,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4139,"text":"İnkar edenlerin cehennemlik olduklarına dair Rabbinin sözü böylece gerçekleşti.","numberInSurah":6,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4140,"text":"Arşı yüklenen ve çevresinde bulunanlar, Rablerini överek tesbih ederler; O'na inanırlar. Müminler için: \"Rabbimiz! İlmin ve rahmetin herşeyi içine almıştır. Tevbe edip Senin yoluna uyanları bağışla; onları cehennemin azabından koru\" diye bağışlanma dilerler.","numberInSurah":7,"juz":24,"manzil":6,"page":467,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4141,"text":"\"Rabbimiz! Müminleri ve babalarından, eşlerinden, soylarından iyi olanları, kendilerine söz verdiğin Adn cennetlerine koy; şüphesiz güçlü olan, Hakim olan ancak Sensin\"","numberInSurah":8,"juz":24,"manzil":6,"page":468,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4142,"text":"\"Onları kötülüklerden koru! O gün kötülüklerden kimi korursan, ona şüphesiz rahmet etmiş olursun. Bu büyük kurtuluştur.\"","numberInSurah":9,"juz":24,"manzil":6,"page":468,"ruku":404,"hizbQuarter":187,"sajda":false},{"number":4143,"text":"Ama inkar edenlere, \"Allah'ın gazabı, sizin birbirinize olan öfkenizden daha büyüktür; imana çağrıldığınızda inkar ederdiniz\" diye seslenilir.","numberInSurah":10,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4144,"text":"Onlar: \"Rabbimiz! Bizi iki defa öldürdün, iki defa dirilttin. Biz de suçlarımızı itiraf ettik, bir daha çıkmağa yol var mıdır?\" derler.","numberInSurah":11,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4145,"text":"Onlara: \"Yalnız Allah çağrıldığı zaman inkar ederdiniz de, O'na eş koşulunca inanırdınız. Bugün hüküm, yüce Allah'ındır\" denir.","numberInSurah":12,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4146,"text":"Size mucizelerini gösteren, size gökten rızık indiren O'dur. Allah'a yönelenden başkası ibret almaz.","numberInSurah":13,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4147,"text":"Ey inananlar! İnkarcılar istemese de, dini yalnız Allah'a has kılarak O'na yalvarın.","numberInSurah":14,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4148,"text":"Arş sahibi, varlıkların en yücesi olan Allah, kavuşma gününü ihtar etmek için kullarından dilediğine emriyle vahyi indirir.","numberInSurah":15,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4149,"text":"O gün onlar meydana çıkarlar; onların hiçbir şeyi Allah'a gizli kalmaz. \"Bugün hükümranlık kimindir?\" denir; hepsi: \"Gücü herşeye yeten tek Allah'ındır\" derler.","numberInSurah":16,"juz":24,"manzil":6,"page":468,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4150,"text":"Bugün herkese, kazandığının karşılığı verilir. Bugün haksızlık yoktur. Doğrusu Allah, hesabı çabuk görendir.","numberInSurah":17,"juz":24,"manzil":6,"page":469,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4151,"text":"Onları, yüreklerin ağıza geleceği, tasadan yutkunacakları, yaklaşan kıyamet günü ile uyar. Zalimlerin ne dostu ne de sözü dinlenecek şefaatçisi olur.","numberInSurah":18,"juz":24,"manzil":6,"page":469,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4152,"text":"Allah gözlerin hainliğini ve gönüllerin gizlediğini bilir.","numberInSurah":19,"juz":24,"manzil":6,"page":469,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4153,"text":"Allah, gerçekle hükmeder. O'nu bırakıp da yalvardıkları putlar bir şeye hüküm veremez. Şüphesiz Allah işitir ve görür.","numberInSurah":20,"juz":24,"manzil":6,"page":469,"ruku":405,"hizbQuarter":187,"sajda":false},{"number":4154,"text":"Yeryüzünde dolaşıp, kendilerinden önce ve kendilerinden daha kuvvetli olan ve yeryüzünde daha çok eser bırakan kimselerin sonuçlarının nasıl olduğunu görmezler mi? Allah onları suçlarıyla yakalamıştır. Allah'a karşı onları koruyan yoktur.","numberInSurah":21,"juz":24,"manzil":6,"page":469,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4155,"text":"Bu, kendilerine açık belgelerle gelen peygamberlerini inkar etmelerinden ötürüdür. Allah da onları bunun için yakalamıştır. Doğrusu O, kuvvetlidir, cezalandırması da şiddetlidir.","numberInSurah":22,"juz":24,"manzil":6,"page":469,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4156,"text":"And olsun ki Musa'yı, mucizelerimiz ve apaçık delillerle Firavun, Haman ve Karun'a göndermişizdir. Onlar: \"Bu, yalancı sihirbazın biridir\" demişlerdi.","numberInSurah":23,"juz":24,"manzil":6,"page":469,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4157,"text":"And olsun ki Musa'yı, mucizelerimiz ve apaçık delillerle Firavun, Haman ve Karun'a göndermişizdir. Onlar: \"Bu, yalancı sihirbazın biridir\" demişlerdi.","numberInSurah":24,"juz":24,"manzil":6,"page":469,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4158,"text":"Musa katımızdan onlara gerçeği getirince: \"Onunla beraber iman etmiş kimselerin oğullarını öldürün, kadınlarını sağ bırakın\" dediler. Ama inkarcıların hilesi elbette boşa gider.","numberInSurah":25,"juz":24,"manzil":6,"page":469,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4159,"text":"Firavun: \"Beni bırakın da Musa'yı öldüreyim, o, Rabbine yalvaradursun. Onun, sizin dininizi değiştireceğinden veya yeryüzünde bozgun çıkaracağından korkuyorum\" dedi.","numberInSurah":26,"juz":24,"manzil":6,"page":470,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4160,"text":"Musa: \"Doğrusu ben, hesap görülecek güne inanmayan böbürlenenlerin hepsinden, benim de Rabbim sizin de Rabbiniz olan Allah'a sığınırım\" dedi.","numberInSurah":27,"juz":24,"manzil":6,"page":470,"ruku":406,"hizbQuarter":188,"sajda":false},{"number":4161,"text":"Firavun ailesinden olup da, inandığını gizleyen bir adam dedi ki: \"Rabbim Allah'tır diyen bir adamı mı öldüreceksiniz? Oysa size Rabbinizden belgelerle gelmiştir. Eğer yalancıysa, yalanı kendisinedir; eğer doğru sözlü ise, sizi tehdit ettiklerinin bir kısmı başınıza gelebilir. Doğrusu Allah, aşırı yalancıyı doğru yola eriştirmez.\"","numberInSurah":28,"juz":24,"manzil":6,"page":470,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4162,"text":"\"Ey milletim; Bugün memlekette hükümranlık sizindir, galip olanlar sizsiniz. Ama Allah'ın baskını bize çatınca, O'na karşı bize kim yardım eder?\" Firavun: \"Ben size kendi görüşümden başkasını söylemiyorum. Ben size ancak doğru yolu gösteriyorum\" dedi.","numberInSurah":29,"juz":24,"manzil":6,"page":470,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4163,"text":"İnanmış olan adam dedi ki: \"Ey milletim! Doğrusu ben sizin için, Nuh milletinin, Ad, Semud ve onlardan sonra gelenlerin durumu gibi, peygamberleri yalanlayan toplulukların uğradıkları bir günün benzerinden korkuyorum. Allah kullara zulüm dilemez.\"","numberInSurah":30,"juz":24,"manzil":6,"page":470,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4164,"text":"İnanmış olan adam dedi ki: \"Ey milletim! Doğrusu ben sizin için, Nuh milletinin, Ad, Semud ve onlardan sonra gelenlerin durumu gibi, peygamberleri yalanlayan toplulukların uğradıkları bir günün benzerinden korkuyorum. Allah kullara zulüm dilemez.\"","numberInSurah":31,"juz":24,"manzil":6,"page":470,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4165,"text":"\"Ey milletim! Ahu figan gününden sizin hesabınıza korkuyorum.\"","numberInSurah":32,"juz":24,"manzil":6,"page":470,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4166,"text":"\"Arkanıza dönüp kaçacağınız gün Allah'a karşı sizi koruyan bulunmaz. Allah'ın saptırdığını doğru yola getirecek yoktur.\"","numberInSurah":33,"juz":24,"manzil":6,"page":470,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4167,"text":"\"And olsun ki, Yusuf da, daha önce, size belgelerle gelmişti. Size getirdiği şeylerden şüphelenip durmuştunuz. Sonunda Yusuf ölünce, Allah onun ardından hiçbir peygamber göndermeyecek demiştiniz. Allah, aşırı şüpheciyi işte böylece saptırır.\"","numberInSurah":34,"juz":24,"manzil":6,"page":471,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4168,"text":"\"Bunlar, Allah'ın ayetleri üzerinde kendilerine gelmiş bir delil bulunmadan tartışırlar. Bu, Allah katında da, inananların yanında da öfkeyi arttırır. Allah, büyüklük taslayan her zorbanın kalbini bundan dolayı mühürler.\"","numberInSurah":35,"juz":24,"manzil":6,"page":471,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4169,"text":"Firavun: \"Ey Haman! Bana bir kule yap; belki yollara, göklerin yollarına erişirim de Musa'nın Tanrısını görürüm. Doğrusu ben, onu yalancı sanıyorum\" dedi. Firavun'a, kötü işi böylece güzel gösterildi ve doğru yoldan alıkondu. Firavun'un hilesi elbette boşa gidecekti.","numberInSurah":36,"juz":24,"manzil":6,"page":471,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4170,"text":"Firavun: \"Ey Haman! Bana bir kule yap; belki yollara, göklerin yollarına erişirim de Musa'nın Tanrısını görürüm. Doğrusu ben, onu yalancı sanıyorum\" dedi. Firavun'a, kötü işi böylece güzel gösterildi ve doğru yoldan alıkondu. Firavun'un hilesi elbette boşa gidecekti.","numberInSurah":37,"juz":24,"manzil":6,"page":471,"ruku":407,"hizbQuarter":188,"sajda":false},{"number":4171,"text":"O inanan kimse dedi ki: \"Ey milletim! Bana uyun, sizi doğru yola eriştireyim.\"","numberInSurah":38,"juz":24,"manzil":6,"page":471,"ruku":408,"hizbQuarter":188,"sajda":false},{"number":4172,"text":"\"Ey milletim! Şüphesiz bu dünya hayatı geçicidir, ama ahiret, doğrusu işte o, kalınacak yurttur.\"","numberInSurah":39,"juz":24,"manzil":6,"page":471,"ruku":408,"hizbQuarter":188,"sajda":false},{"number":4173,"text":"\"Kim bir kötülük işlerse ancak onun kadar ceza görür. Kadın veya erkek, kim, inanarak yararlı iş işlerse, işte onlar cennete girerler; orada hesapsız şekilde rızıklanırlar.\"","numberInSurah":40,"juz":24,"manzil":6,"page":471,"ruku":408,"hizbQuarter":188,"sajda":false},{"number":4174,"text":"\"Ey milletim! Nedir başıma gelen? Ben sizi kurtuluşa çağırıyorum, siz beni ateşe çağırıyorsunuz.\"","numberInSurah":41,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4175,"text":"\"Siz beni Allah'ı inkar etmeye, bilmediğim bir şeyi O'na ortak koşmaya çağırıyorsunuz; ben ise sizi, güçlü olan, çok bağışlayan Allah'a çağırıyorum.\"","numberInSurah":42,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4176,"text":"\"Beni kendisine çağırdığınızın, bu dünyada da ahirette de çağırabilecek kabiliyette olmadığında, hepimizin Allah'a döneceğinde, aşırı gidenlerin ateşlikler olduklarında şüphe yoktur.\"","numberInSurah":43,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4177,"text":"\"Size söylediğimi hatırlayacaksınız. Ben işimi Allah'a bırakıyorum. Doğrusu Allah, kulları görür.\"","numberInSurah":44,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4178,"text":"Allah o adamı, kurmak istedikleri tuzaktan korudu. Kötü azap Firavun'un adamlarını sardı.","numberInSurah":45,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4179,"text":"Onlar, sabah akşam ateşe sunulurlar. Kıyamet çattığı gün, \"Firavun'un adamlarını azabın en ağırına sokun\"denir.","numberInSurah":46,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4180,"text":"Ateşin içinde birbirleriyle tartışırlarken, güçsüzler, büyüklük taslayanlara: \"Doğrusu biz size uymuştuk, şimdi ateşin bir parçasını olsun bizden savabilir misiniz?\" derler.","numberInSurah":47,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4181,"text":"Büyüklük taslayanlar: \"Doğrusu hepimiz onun içindeyiz. Allah kullar arasında şüphesiz hüküm vermiştir\" derler.","numberInSurah":48,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4182,"text":"Ateşte olanlar, cehennemin bekçilerine: \"Rabbinize yalvarın da hiç değilse bir gün, azabımızı hafifletsin\" derler.","numberInSurah":49,"juz":24,"manzil":6,"page":472,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4183,"text":"Bekçiler: \"Size, belgelerle peygamberleriniz gelmiş miydi?\" derler. Onlar da: \"Evet, gelmişti\" derler. Bekçiler: \"O halde kendiniz yalvarın\" derler. İnkarcıların yalvarışı şüphesiz boşunadır.","numberInSurah":50,"juz":24,"manzil":6,"page":473,"ruku":408,"hizbQuarter":189,"sajda":false},{"number":4184,"text":"Doğrusu Biz, peygamberlerimize ve inananlara dünya hayatında ve şahidlerin şahidlik edecekleri günde yardım ederiz.","numberInSurah":51,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4185,"text":"O gün zalimlere, özür beyan etmeleri fayda vermez. Lanet onlaradır. Yurdun kötüsü de onlaradır.","numberInSurah":52,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4186,"text":"And olsun ki Biz Musa'ya doğruluk rehberi verdik. İsrailoğullarını da, akıl sahipleri için bir öğüt ve doğruluk rehberi olan Kitap'a, Tevrat'a varis kıldık.","numberInSurah":53,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4187,"text":"And olsun ki Biz Musa'ya doğruluk rehberi verdik. İsrailoğullarını da, akıl sahipleri için bir öğüt ve doğruluk rehberi olan Kitap'a, Tevrat'a varis kıldık.","numberInSurah":54,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4188,"text":"Sabret, Allah'ın verdiği söz şüphesiz gerçektir. Suçunun bağışlanmasını dile; Rabbini akşam, sabah, överek tesbih et.","numberInSurah":55,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4189,"text":"Allah'ın ayetleri üzerinde kendilerine gelen bir delil olmadan tartışanların gönüllerinde, ulaşamayacakları bir büyüklenme vardır. Sen Allah'a sığın. O şüphesiz işitendir, görendir.","numberInSurah":56,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4190,"text":"Göklerin ve yerin yaratılması, insanların yaratılmasından daha büyük bir şeydir. Fakat insanların çoğu bilmezler.","numberInSurah":57,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4191,"text":"Körle gören, inanıp yararlı iş işleyenlerle kötülük yapan bir değildir. Ne kadar az düşünüyorsunuz?","numberInSurah":58,"juz":24,"manzil":6,"page":473,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4192,"text":"Kıyamet günü mutlaka gelecektir. Bunda şüphe yoktur, fakat, insanların çoğu inanmıyor.","numberInSurah":59,"juz":24,"manzil":6,"page":474,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4193,"text":"Rabbiniz: \"Bana dua edin ki duanıza icabet edeyim. Bana kulluk etmeyi büyüklüklerine yediremeyenler alçalmış olarak cehenneme gireceklerdir\" buyurmuştur.","numberInSurah":60,"juz":24,"manzil":6,"page":474,"ruku":409,"hizbQuarter":189,"sajda":false},{"number":4194,"text":"Size, geceyi dinlenesiniz diye karanlık ve gündüzü aydınlık olarak yaratan Allah'tır. Doğrusu Allah insanlara karşı lütufkardır, ama insanların çoğu şükretmezler.","numberInSurah":61,"juz":24,"manzil":6,"page":474,"ruku":410,"hizbQuarter":189,"sajda":false},{"number":4195,"text":"İşte herşeyin yaratıcısı olan Rabbiniz Allah budur. O'ndan başka tanrı yoktur. Nasıl aldatılıp döndürülürsünüz?","numberInSurah":62,"juz":24,"manzil":6,"page":474,"ruku":410,"hizbQuarter":189,"sajda":false},{"number":4196,"text":"Allah'ın ayetlerini bile bile inkar edenler böylece döndürülüyorlardı.","numberInSurah":63,"juz":24,"manzil":6,"page":474,"ruku":410,"hizbQuarter":189,"sajda":false},{"number":4197,"text":"Sizin için yeri durak, göğü bina eden, size şekil verip de, şeklinizi güzel yapan, sizi temiz şeylerle rızıklandıran Allah'tır. İşte Rabbiniz olan Allah budur. Alemlerin Rabbi Allah ne yücedir!","numberInSurah":64,"juz":24,"manzil":6,"page":474,"ruku":410,"hizbQuarter":189,"sajda":false},{"number":4198,"text":"O diridir, O'ndan başka tanrı yoktur. Dini yalnız O'na has kılarak O'na yalvarın. Övgü, Alemlerin Rabbi Allah içindir.","numberInSurah":65,"juz":24,"manzil":6,"page":474,"ruku":410,"hizbQuarter":189,"sajda":false},{"number":4199,"text":"De ki: \"Sizin, Allah'ı bırakıp da kulluk ettiklerinize kulluk etmek bana yasak kılınmıştır. Zira bana Rabbimden belgeler gelmiştir. Ben, kendimi Alemlerin Rabbine vermekle emrolundum.\"","numberInSurah":66,"juz":24,"manzil":6,"page":474,"ruku":410,"hizbQuarter":190,"sajda":false},{"number":4200,"text":"Sizi topraktan, sonra nutfeden, sonra kan pıhtısından yaratan; sonra erginlik çağına ulaşmanız, sonra da yaşlanmanız için sizi bebek olarak dünyaya çıkaran O'dur. Kiminiz daha önce öldürülür, kiminiz de, belirtilmiş bir süreye ulaşırsınız. Belki artık düşünürsünüz.","numberInSurah":67,"juz":24,"manzil":6,"page":475,"ruku":410,"hizbQuarter":190,"sajda":false},{"number":4201,"text":"Dirilten, öldüren O'dur. Bir şeye karar verirse \"Ol\" der, o da oluverir.","numberInSurah":68,"juz":24,"manzil":6,"page":475,"ruku":410,"hizbQuarter":190,"sajda":false},{"number":4202,"text":"Allah'ın ayetleri üzerinde tartışanları görmez misin? Nasıl da döndürülüyorlar?","numberInSurah":69,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4203,"text":"Kitap'ı ve peygamberlerimize gönderdiklerimizi yalanlayanlar elbette bileceklerdir.","numberInSurah":70,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4204,"text":"Boyunlarında halkalar ve zincirler olarak kaynar suya sürülür, sonra ateşte yakılırlar.","numberInSurah":71,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4205,"text":"Boyunlarında halkalar ve zincirler olarak kaynar suya sürülür, sonra ateşte yakılırlar.","numberInSurah":72,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4206,"text":"Sonra onlara: \"Allah'ı bırakıp da koştuğunuz ortaklar nerededir?\" denir. \"Bizden uzaklaştılar; hayır, biz zaten önceleri hiçbir şeye kulluk etmiyorduk\" derler. İşte Allah inkarcıları böyle saptırır.","numberInSurah":73,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4207,"text":"Sonra onlara: \"Allah'ı bırakıp da koştuğunuz ortaklar nerededir?\" denir. \"Bizden uzaklaştılar; hayır, biz zaten önceleri hiçbir şeye kulluk etmiyorduk\" derler. İşte Allah inkarcıları böyle saptırır.","numberInSurah":74,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4208,"text":"Onlara: \"İşte bu, yeryüzünde haksız yere şımarmanız ve böbürlenmenizden ötürüdür. Temelli kalacağınız cehennem kapılarından girin\" denir. Büyüklenenlerin durağı ne kötüdür!","numberInSurah":75,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4209,"text":"Onlara: \"İşte bu, yeryüzünde haksız yere şımarmanız ve böbürlenmenizden ötürüdür. Temelli kalacağınız cehennem kapılarından girin\" denir. Büyüklenenlerin durağı ne kötüdür!","numberInSurah":76,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4210,"text":"Sabret; şüphesiz Allah'ın verdiği söz gerçektir. Onlara söz verdiğimiz azabın bir kısmını sana gösteririz veya seni öldürürüz, nasıl olsa onların dönüşü Bizedir.","numberInSurah":77,"juz":24,"manzil":6,"page":475,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4211,"text":"And olsun ki, senden önce birçok peygamberler gönderdik; sana onların kimini anlattık, kimini anlatmadık; hiçbir peygamber, Allah'ın izni olmadan bir mucize getiremez. Allah'ın buyruğu gelince iş gerçekten biter. İşte o zaman, boşa uğraşanlar hüsranda kalırlar.","numberInSurah":78,"juz":24,"manzil":6,"page":476,"ruku":411,"hizbQuarter":190,"sajda":false},{"number":4212,"text":"Binek olarak kullanmanız ve yemeniz için hayvanları sizin için yaratan Allah'tır.","numberInSurah":79,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false},{"number":4213,"text":"Onlarda sizin için daha nice faydalar vardır; gönüllerinizdeki arzulara, onlara binerek ulaşırsınız. Onlarla ve gemilerle taşınırsınız.","numberInSurah":80,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false},{"number":4214,"text":"Allah size delillerini gösteriyor. Allah'ın delillerinden hangisini inkar edersiniz?","numberInSurah":81,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false},{"number":4215,"text":"Yeryüzünde dolaşıp, kendilerinden daha çok, daha kuvvetli, yeryüzünde bıraktıkları eserler daha sağlam olan öncekilerin sonuçlarının nasıl olduğunu görmezler mi? Kazandıkları onlara bir fayda vermemiştir.","numberInSurah":82,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false},{"number":4216,"text":"Peygamberleri onlara belgelerle gelince, kendilerinde olan bilgiden gururlandılar da, alaya aldıkları şey kendilerini sarıverdi.","numberInSurah":83,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false},{"number":4217,"text":"Şiddetli azabımızı gördüklerinde: \"Yalnız Allah'a inandık; O'na koştuğumuz eşleri inkar ettik\" dediler.","numberInSurah":84,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false},{"number":4218,"text":"Ama, Bizim şiddetli azabımızı görüp de öyle inanmaları kendilerine fayda vermedi. Bu, Allah'ın kulları hakkında, öteden beri yürürlükte olan yasasıdır. İşte inkarcılar o zaman hüsranda kaldılar.","numberInSurah":85,"juz":24,"manzil":6,"page":476,"ruku":412,"hizbQuarter":190,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}