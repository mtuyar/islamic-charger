{"arabic":{"number":41,"name":"سُورَةُ فُصِّلَتۡ","englishName":"Fussilet","englishNameTranslation":"Explained in detail","revelationType":"Meccan","numberOfAyahs":54,"ayahs":[{"number":4219,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ حم","numberInSurah":1,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4220,"text":"تَنْزِيلٌ مِنَ الرَّحْمَٰنِ الرَّحِيمِ","numberInSurah":2,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4221,"text":"كِتَابٌ فُصِّلَتْ آيَاتُهُ قُرْآنًا عَرَبِيًّا لِقَوْمٍ يَعْلَمُونَ","numberInSurah":3,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4222,"text":"بَشِيرًا وَنَذِيرًا فَأَعْرَضَ أَكْثَرُهُمْ فَهُمْ لَا يَسْمَعُونَ","numberInSurah":4,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4223,"text":"وَقَالُوا قُلُوبُنَا فِي أَكِنَّةٍ مِمَّا تَدْعُونَا إِلَيْهِ وَفِي آذَانِنَا وَقْرٌ وَمِنْ بَيْنِنَا وَبَيْنِكَ حِجَابٌ فَاعْمَلْ إِنَّنَا عَامِلُونَ","numberInSurah":5,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4224,"text":"قُلْ إِنَّمَا أَنَا بَشَرٌ مِثْلُكُمْ يُوحَىٰ إِلَيَّ أَنَّمَا إِلَٰهُكُمْ إِلَٰهٌ وَاحِدٌ فَاسْتَقِيمُوا إِلَيْهِ وَاسْتَغْفِرُوهُ ۗ وَوَيْلٌ لِلْمُشْرِكِينَ","numberInSurah":6,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4225,"text":"الَّذِينَ لَا يُؤْتُونَ الزَّكَاةَ وَهُمْ بِالْآخِرَةِ هُمْ كَافِرُونَ","numberInSurah":7,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4226,"text":"إِنَّ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ","numberInSurah":8,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4227,"text":"۞ قُلْ أَئِنَّكُمْ لَتَكْفُرُونَ بِالَّذِي خَلَقَ الْأَرْضَ فِي يَوْمَيْنِ وَتَجْعَلُونَ لَهُ أَنْدَادًا ۚ ذَٰلِكَ رَبُّ الْعَالَمِينَ","numberInSurah":9,"juz":24,"manzil":6,"page":477,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4228,"text":"وَجَعَلَ فِيهَا رَوَاسِيَ مِنْ فَوْقِهَا وَبَارَكَ فِيهَا وَقَدَّرَ فِيهَا أَقْوَاتَهَا فِي أَرْبَعَةِ أَيَّامٍ سَوَاءً لِلسَّائِلِينَ","numberInSurah":10,"juz":24,"manzil":6,"page":477,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4229,"text":"ثُمَّ اسْتَوَىٰ إِلَى السَّمَاءِ وَهِيَ دُخَانٌ فَقَالَ لَهَا وَلِلْأَرْضِ ائْتِيَا طَوْعًا أَوْ كَرْهًا قَالَتَا أَتَيْنَا طَائِعِينَ","numberInSurah":11,"juz":24,"manzil":6,"page":477,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4230,"text":"فَقَضَاهُنَّ سَبْعَ سَمَاوَاتٍ فِي يَوْمَيْنِ وَأَوْحَىٰ فِي كُلِّ سَمَاءٍ أَمْرَهَا ۚ وَزَيَّنَّا السَّمَاءَ الدُّنْيَا بِمَصَابِيحَ وَحِفْظًا ۚ ذَٰلِكَ تَقْدِيرُ الْعَزِيزِ الْعَلِيمِ","numberInSurah":12,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4231,"text":"فَإِنْ أَعْرَضُوا فَقُلْ أَنْذَرْتُكُمْ صَاعِقَةً مِثْلَ صَاعِقَةِ عَادٍ وَثَمُودَ","numberInSurah":13,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4232,"text":"إِذْ جَاءَتْهُمُ الرُّسُلُ مِنْ بَيْنِ أَيْدِيهِمْ وَمِنْ خَلْفِهِمْ أَلَّا تَعْبُدُوا إِلَّا اللَّهَ ۖ قَالُوا لَوْ شَاءَ رَبُّنَا لَأَنْزَلَ مَلَائِكَةً فَإِنَّا بِمَا أُرْسِلْتُمْ بِهِ كَافِرُونَ","numberInSurah":14,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4233,"text":"فَأَمَّا عَادٌ فَاسْتَكْبَرُوا فِي الْأَرْضِ بِغَيْرِ الْحَقِّ وَقَالُوا مَنْ أَشَدُّ مِنَّا قُوَّةً ۖ أَوَلَمْ يَرَوْا أَنَّ اللَّهَ الَّذِي خَلَقَهُمْ هُوَ أَشَدُّ مِنْهُمْ قُوَّةً ۖ وَكَانُوا بِآيَاتِنَا يَجْحَدُونَ","numberInSurah":15,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4234,"text":"فَأَرْسَلْنَا عَلَيْهِمْ رِيحًا صَرْصَرًا فِي أَيَّامٍ نَحِسَاتٍ لِنُذِيقَهُمْ عَذَابَ الْخِزْيِ فِي الْحَيَاةِ الدُّنْيَا ۖ وَلَعَذَابُ الْآخِرَةِ أَخْزَىٰ ۖ وَهُمْ لَا يُنْصَرُونَ","numberInSurah":16,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4235,"text":"وَأَمَّا ثَمُودُ فَهَدَيْنَاهُمْ فَاسْتَحَبُّوا الْعَمَىٰ عَلَى الْهُدَىٰ فَأَخَذَتْهُمْ صَاعِقَةُ الْعَذَابِ الْهُونِ بِمَا كَانُوا يَكْسِبُونَ","numberInSurah":17,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4236,"text":"وَنَجَّيْنَا الَّذِينَ آمَنُوا وَكَانُوا يَتَّقُونَ","numberInSurah":18,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4237,"text":"وَيَوْمَ يُحْشَرُ أَعْدَاءُ اللَّهِ إِلَى النَّارِ فَهُمْ يُوزَعُونَ","numberInSurah":19,"juz":24,"manzil":6,"page":478,"ruku":415,"hizbQuarter":191,"sajda":false},{"number":4238,"text":"حَتَّىٰ إِذَا مَا جَاءُوهَا شَهِدَ عَلَيْهِمْ سَمْعُهُمْ وَأَبْصَارُهُمْ وَجُلُودُهُمْ بِمَا كَانُوا يَعْمَلُونَ","numberInSurah":20,"juz":24,"manzil":6,"page":478,"ruku":415,"hizbQuarter":191,"sajda":false},{"number":4239,"text":"وَقَالُوا لِجُلُودِهِمْ لِمَ شَهِدْتُمْ عَلَيْنَا ۖ قَالُوا أَنْطَقَنَا اللَّهُ الَّذِي أَنْطَقَ كُلَّ شَيْءٍ وَهُوَ خَلَقَكُمْ أَوَّلَ مَرَّةٍ وَإِلَيْهِ تُرْجَعُونَ","numberInSurah":21,"juz":24,"manzil":6,"page":479,"ruku":415,"hizbQuarter":191,"sajda":false},{"number":4240,"text":"وَمَا كُنْتُمْ تَسْتَتِرُونَ أَنْ يَشْهَدَ عَلَيْكُمْ سَمْعُكُمْ وَلَا أَبْصَارُكُمْ وَلَا جُلُودُكُمْ وَلَٰكِنْ ظَنَنْتُمْ أَنَّ اللَّهَ لَا يَعْلَمُ كَثِيرًا مِمَّا تَعْمَلُونَ","numberInSurah":22,"juz":24,"manzil":6,"page":479,"ruku":415,"hizbQuarter":191,"sajda":false},{"number":4241,"text":"وَذَٰلِكُمْ ظَنُّكُمُ الَّذِي ظَنَنْتُمْ بِرَبِّكُمْ أَرْدَاكُمْ فَأَصْبَحْتُمْ مِنَ الْخَاسِرِينَ","numberInSurah":23,"juz":24,"manzil":6,"page":479,"ruku":415,"hizbQuarter":191,"sajda":false},{"number":4242,"text":"فَإِنْ يَصْبِرُوا فَالنَّارُ مَثْوًى لَهُمْ ۖ وَإِنْ يَسْتَعْتِبُوا فَمَا هُمْ مِنَ الْمُعْتَبِينَ","numberInSurah":24,"juz":24,"manzil":6,"page":479,"ruku":415,"hizbQuarter":191,"sajda":false},{"number":4243,"text":"۞ وَقَيَّضْنَا لَهُمْ قُرَنَاءَ فَزَيَّنُوا لَهُمْ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَحَقَّ عَلَيْهِمُ الْقَوْلُ فِي أُمَمٍ قَدْ خَلَتْ مِنْ قَبْلِهِمْ مِنَ الْجِنِّ وَالْإِنْسِ ۖ إِنَّهُمْ كَانُوا خَاسِرِينَ","numberInSurah":25,"juz":24,"manzil":6,"page":479,"ruku":415,"hizbQuarter":192,"sajda":false},{"number":4244,"text":"وَقَالَ الَّذِينَ كَفَرُوا لَا تَسْمَعُوا لِهَٰذَا الْقُرْآنِ وَالْغَوْا فِيهِ لَعَلَّكُمْ تَغْلِبُونَ","numberInSurah":26,"juz":24,"manzil":6,"page":479,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4245,"text":"فَلَنُذِيقَنَّ الَّذِينَ كَفَرُوا عَذَابًا شَدِيدًا وَلَنَجْزِيَنَّهُمْ أَسْوَأَ الَّذِي كَانُوا يَعْمَلُونَ","numberInSurah":27,"juz":24,"manzil":6,"page":479,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4246,"text":"ذَٰلِكَ جَزَاءُ أَعْدَاءِ اللَّهِ النَّارُ ۖ لَهُمْ فِيهَا دَارُ الْخُلْدِ ۖ جَزَاءً بِمَا كَانُوا بِآيَاتِنَا يَجْحَدُونَ","numberInSurah":28,"juz":24,"manzil":6,"page":479,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4247,"text":"وَقَالَ الَّذِينَ كَفَرُوا رَبَّنَا أَرِنَا اللَّذَيْنِ أَضَلَّانَا مِنَ الْجِنِّ وَالْإِنْسِ نَجْعَلْهُمَا تَحْتَ أَقْدَامِنَا لِيَكُونَا مِنَ الْأَسْفَلِينَ","numberInSurah":29,"juz":24,"manzil":6,"page":479,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4248,"text":"إِنَّ الَّذِينَ قَالُوا رَبُّنَا اللَّهُ ثُمَّ اسْتَقَامُوا تَتَنَزَّلُ عَلَيْهِمُ الْمَلَائِكَةُ أَلَّا تَخَافُوا وَلَا تَحْزَنُوا وَأَبْشِرُوا بِالْجَنَّةِ الَّتِي كُنْتُمْ تُوعَدُونَ","numberInSurah":30,"juz":24,"manzil":6,"page":480,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4249,"text":"نَحْنُ أَوْلِيَاؤُكُمْ فِي الْحَيَاةِ الدُّنْيَا وَفِي الْآخِرَةِ ۖ وَلَكُمْ فِيهَا مَا تَشْتَهِي أَنْفُسُكُمْ وَلَكُمْ فِيهَا مَا تَدَّعُونَ","numberInSurah":31,"juz":24,"manzil":6,"page":480,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4250,"text":"نُزُلًا مِنْ غَفُورٍ رَحِيمٍ","numberInSurah":32,"juz":24,"manzil":6,"page":480,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4251,"text":"وَمَنْ أَحْسَنُ قَوْلًا مِمَّنْ دَعَا إِلَى اللَّهِ وَعَمِلَ صَالِحًا وَقَالَ إِنَّنِي مِنَ الْمُسْلِمِينَ","numberInSurah":33,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4252,"text":"وَلَا تَسْتَوِي الْحَسَنَةُ وَلَا السَّيِّئَةُ ۚ ادْفَعْ بِالَّتِي هِيَ أَحْسَنُ فَإِذَا الَّذِي بَيْنَكَ وَبَيْنَهُ عَدَاوَةٌ كَأَنَّهُ وَلِيٌّ حَمِيمٌ","numberInSurah":34,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4253,"text":"وَمَا يُلَقَّاهَا إِلَّا الَّذِينَ صَبَرُوا وَمَا يُلَقَّاهَا إِلَّا ذُو حَظٍّ عَظِيمٍ","numberInSurah":35,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4254,"text":"وَإِمَّا يَنْزَغَنَّكَ مِنَ الشَّيْطَانِ نَزْغٌ فَاسْتَعِذْ بِاللَّهِ ۖ إِنَّهُ هُوَ السَّمِيعُ الْعَلِيمُ","numberInSurah":36,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4255,"text":"وَمِنْ آيَاتِهِ اللَّيْلُ وَالنَّهَارُ وَالشَّمْسُ وَالْقَمَرُ ۚ لَا تَسْجُدُوا لِلشَّمْسِ وَلَا لِلْقَمَرِ وَاسْجُدُوا لِلَّهِ الَّذِي خَلَقَهُنَّ إِنْ كُنْتُمْ إِيَّاهُ تَعْبُدُونَ","numberInSurah":37,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4256,"text":"فَإِنِ اسْتَكْبَرُوا فَالَّذِينَ عِنْدَ رَبِّكَ يُسَبِّحُونَ لَهُ بِاللَّيْلِ وَالنَّهَارِ وَهُمْ لَا يَسْأَمُونَ ۩","numberInSurah":38,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":{"id":12,"recommended":false,"obligatory":true}},{"number":4257,"text":"وَمِنْ آيَاتِهِ أَنَّكَ تَرَى الْأَرْضَ خَاشِعَةً فَإِذَا أَنْزَلْنَا عَلَيْهَا الْمَاءَ اهْتَزَّتْ وَرَبَتْ ۚ إِنَّ الَّذِي أَحْيَاهَا لَمُحْيِي الْمَوْتَىٰ ۚ إِنَّهُ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":39,"juz":24,"manzil":6,"page":481,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4258,"text":"إِنَّ الَّذِينَ يُلْحِدُونَ فِي آيَاتِنَا لَا يَخْفَوْنَ عَلَيْنَا ۗ أَفَمَنْ يُلْقَىٰ فِي النَّارِ خَيْرٌ أَمْ مَنْ يَأْتِي آمِنًا يَوْمَ الْقِيَامَةِ ۚ اعْمَلُوا مَا شِئْتُمْ ۖ إِنَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ","numberInSurah":40,"juz":24,"manzil":6,"page":481,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4259,"text":"إِنَّ الَّذِينَ كَفَرُوا بِالذِّكْرِ لَمَّا جَاءَهُمْ ۖ وَإِنَّهُ لَكِتَابٌ عَزِيزٌ","numberInSurah":41,"juz":24,"manzil":6,"page":481,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4260,"text":"لَا يَأْتِيهِ الْبَاطِلُ مِنْ بَيْنِ يَدَيْهِ وَلَا مِنْ خَلْفِهِ ۖ تَنْزِيلٌ مِنْ حَكِيمٍ حَمِيدٍ","numberInSurah":42,"juz":24,"manzil":6,"page":481,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4261,"text":"مَا يُقَالُ لَكَ إِلَّا مَا قَدْ قِيلَ لِلرُّسُلِ مِنْ قَبْلِكَ ۚ إِنَّ رَبَّكَ لَذُو مَغْفِرَةٍ وَذُو عِقَابٍ أَلِيمٍ","numberInSurah":43,"juz":24,"manzil":6,"page":481,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4262,"text":"وَلَوْ جَعَلْنَاهُ قُرْآنًا أَعْجَمِيًّا لَقَالُوا لَوْلَا فُصِّلَتْ آيَاتُهُ ۖ أَأَعْجَمِيٌّ وَعَرَبِيٌّ ۗ قُلْ هُوَ لِلَّذِينَ آمَنُوا هُدًى وَشِفَاءٌ ۖ وَالَّذِينَ لَا يُؤْمِنُونَ فِي آذَانِهِمْ وَقْرٌ وَهُوَ عَلَيْهِمْ عَمًى ۚ أُولَٰئِكَ يُنَادَوْنَ مِنْ مَكَانٍ بَعِيدٍ","numberInSurah":44,"juz":24,"manzil":6,"page":481,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4263,"text":"وَلَقَدْ آتَيْنَا مُوسَى الْكِتَابَ فَاخْتُلِفَ فِيهِ ۗ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِنْ رَبِّكَ لَقُضِيَ بَيْنَهُمْ ۚ وَإِنَّهُمْ لَفِي شَكٍّ مِنْهُ مُرِيبٍ","numberInSurah":45,"juz":24,"manzil":6,"page":481,"ruku":418,"hizbQuarter":192,"sajda":false},{"number":4264,"text":"مَنْ عَمِلَ صَالِحًا فَلِنَفْسِهِ ۖ وَمَنْ أَسَاءَ فَعَلَيْهَا ۗ وَمَا رَبُّكَ بِظَلَّامٍ لِلْعَبِيدِ","numberInSurah":46,"juz":24,"manzil":6,"page":481,"ruku":418,"hizbQuarter":192,"sajda":false},{"number":4265,"text":"۞ إِلَيْهِ يُرَدُّ عِلْمُ السَّاعَةِ ۚ وَمَا تَخْرُجُ مِنْ ثَمَرَاتٍ مِنْ أَكْمَامِهَا وَمَا تَحْمِلُ مِنْ أُنْثَىٰ وَلَا تَضَعُ إِلَّا بِعِلْمِهِ ۚ وَيَوْمَ يُنَادِيهِمْ أَيْنَ شُرَكَائِي قَالُوا آذَنَّاكَ مَا مِنَّا مِنْ شَهِيدٍ","numberInSurah":47,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4266,"text":"وَضَلَّ عَنْهُمْ مَا كَانُوا يَدْعُونَ مِنْ قَبْلُ ۖ وَظَنُّوا مَا لَهُمْ مِنْ مَحِيصٍ","numberInSurah":48,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4267,"text":"لَا يَسْأَمُ الْإِنْسَانُ مِنْ دُعَاءِ الْخَيْرِ وَإِنْ مَسَّهُ الشَّرُّ فَيَئُوسٌ قَنُوطٌ","numberInSurah":49,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4268,"text":"وَلَئِنْ أَذَقْنَاهُ رَحْمَةً مِنَّا مِنْ بَعْدِ ضَرَّاءَ مَسَّتْهُ لَيَقُولَنَّ هَٰذَا لِي وَمَا أَظُنُّ السَّاعَةَ قَائِمَةً وَلَئِنْ رُجِعْتُ إِلَىٰ رَبِّي إِنَّ لِي عِنْدَهُ لَلْحُسْنَىٰ ۚ فَلَنُنَبِّئَنَّ الَّذِينَ كَفَرُوا بِمَا عَمِلُوا وَلَنُذِيقَنَّهُمْ مِنْ عَذَابٍ غَلِيظٍ","numberInSurah":50,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4269,"text":"وَإِذَا أَنْعَمْنَا عَلَى الْإِنْسَانِ أَعْرَضَ وَنَأَىٰ بِجَانِبِهِ وَإِذَا مَسَّهُ الشَّرُّ فَذُو دُعَاءٍ عَرِيضٍ","numberInSurah":51,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4270,"text":"قُلْ أَرَأَيْتُمْ إِنْ كَانَ مِنْ عِنْدِ اللَّهِ ثُمَّ كَفَرْتُمْ بِهِ مَنْ أَضَلُّ مِمَّنْ هُوَ فِي شِقَاقٍ بَعِيدٍ","numberInSurah":52,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4271,"text":"سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ حَتَّىٰ يَتَبَيَّنَ لَهُمْ أَنَّهُ الْحَقُّ ۗ أَوَلَمْ يَكْفِ بِرَبِّكَ أَنَّهُ عَلَىٰ كُلِّ شَيْءٍ شَهِيدٌ","numberInSurah":53,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4272,"text":"أَلَا إِنَّهُمْ فِي مِرْيَةٍ مِنْ لِقَاءِ رَبِّهِمْ ۗ أَلَا إِنَّهُ بِكُلِّ شَيْءٍ مُحِيطٌ","numberInSurah":54,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":41,"name":"سُورَةُ فُصِّلَتۡ","englishName":"Fussilet","englishNameTranslation":"Explained in detail","revelationType":"Meccan","numberOfAyahs":54,"ayahs":[{"number":4219,"text":"Ha, Mim.","numberInSurah":1,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4220,"text":"Bu Kitap, merhametli olan Allah katından indirilmedir; bilen bir millet için müjdeci ve uyarıcı olmak üzere Arapça okunarak, ayetleri uzun uzun açıklanmıştır. Ama insanların çoğu yüz çevirmiştir, onlar işitmezler de: \"Bizi çağırdığın şeye karşı kalblerimiz kapalıdır, kulaklarımızda ağırlık, bizimle senin aranda anlaşmamıza engel vardır; istediğini yap, biz de yapacağız\" derler.","numberInSurah":2,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4221,"text":"Bu Kitap, merhametli olan Allah katından indirilmedir; bilen bir millet için müjdeci ve uyarıcı olmak üzere Arapça okunarak, ayetleri uzun uzun açıklanmıştır. Ama insanların çoğu yüz çevirmiştir, onlar işitmezler de: \"Bizi çağırdığın şeye karşı kalblerimiz kapalıdır, kulaklarımızda ağırlık, bizimle senin aranda anlaşmamıza engel vardır; istediğini yap, biz de yapacağız\" derler.","numberInSurah":3,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4222,"text":"Bu Kitap, merhametli olan Allah katından indirilmedir; bilen bir millet için müjdeci ve uyarıcı olmak üzere Arapça okunarak, ayetleri uzun uzun açıklanmıştır. Ama insanların çoğu yüz çevirmiştir, onlar işitmezler de: \"Bizi çağırdığın şeye karşı kalblerimiz kapalıdır, kulaklarımızda ağırlık, bizimle senin aranda anlaşmamıza engel vardır; istediğini yap, biz de yapacağız\" derler.","numberInSurah":4,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4223,"text":"Bu Kitap, merhametli olan Allah katından indirilmedir; bilen bir millet için müjdeci ve uyarıcı olmak üzere Arapça okunarak, ayetleri uzun uzun açıklanmıştır. Ama insanların çoğu yüz çevirmiştir, onlar işitmezler de: \"Bizi çağırdığın şeye karşı kalblerimiz kapalıdır, kulaklarımızda ağırlık, bizimle senin aranda anlaşmamıza engel vardır; istediğini yap, biz de yapacağız\" derler.","numberInSurah":5,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4224,"text":"Onlara söyle: \"Ben de ancak sizin gibi bir insanım. Bana, tanrınızın tek bir Tanrı olduğu vahyolunuyor. Artık O'na yönelin, O'ndan bağışlanma dileyin; vay ortak koşanlara!\"","numberInSurah":6,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4225,"text":"Onlar zekat vermezler; ahireti inkar edenler de yalnız onlardır.","numberInSurah":7,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4226,"text":"Doğrusu inanıp yararlı iş işleyenlere, onlara kesintisiz bir ecir vardır.","numberInSurah":8,"juz":24,"manzil":6,"page":477,"ruku":413,"hizbQuarter":190,"sajda":false},{"number":4227,"text":"\"Siz yeri iki günde yaratanı mı inkar ediyor ve O'na eşler koşuyorsunuz! O, alemlerin Rabbidir\" de.","numberInSurah":9,"juz":24,"manzil":6,"page":477,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4228,"text":"Yeryüzüne üstünden ağır baskılar (dağlar) yerleştirdi, onu bereketli kıldı; arayıp soranlar için gıdalarını tam (toplam) dört gün içinde yetiştirmesi kanununu koydu (takdir etti).","numberInSurah":10,"juz":24,"manzil":6,"page":477,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4229,"text":"Sonra, duman halinde bulunan göğe yöneldi, ona ve yeryüzüne: \"İsteyerek veya istemeyerek buyruğuma gelin\" dedi. İkisi de: \"İsteyerek geldik\" dediler.","numberInSurah":11,"juz":24,"manzil":6,"page":477,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4230,"text":"Böylece onları, iki gün içinde yedi göğe tamamladı ve her göğün işini kendisine bildirdi. Yakın göğü ışıklarla donattık ve bozulmaktan koruduk. İşte bu, bilen, güçlü olan Allah'ın kanunudur.","numberInSurah":12,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4231,"text":"Eğer yüz çevirirlerse onlara de ki: \"İşte sizi, Ad ve Semud'un başına gelen yıldırıma benzer bir azap ile uyardım.\"","numberInSurah":13,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4232,"text":"Onlara, önlerinden, artlarından, her yönden: \"Allah'tan başkasına kulluk etmeyin\" diyen peygamberler gelmişti: \"Eğer Rabbimiz böyle bir şey dileseydi melekler indirirdi. Doğrusu sizinle gönderileni inkar ederiz\" demişlerdi.","numberInSurah":14,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4233,"text":"Ad milleti, yeryüzünde haksız yere büyüklük taslamış, \"Bizden daha kuvvetli kim vardır?\" demişti. Onlar, kendilerini yaratan Allah'ın onlardan daha kuvvetli olduğunu görmüyorlardı değil mi? Ayetlerimizi bile bile inkar ediyorlardı.","numberInSurah":15,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4234,"text":"Rezillik azabını onlara dünya hayatında tattırmak için uğursuz günlerde üzerlerine dondurucu bir kasırga gönderdik. Ahiret azabı ise daha çok alçaltıcıdır ve onlar yardım da görmezler.","numberInSurah":16,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4235,"text":"Semud milletine, doğru yolu göstermiştik, ama onlar körlüğü, doğru yolda gitmeye tercih ettiler. Kazandıklarının karşılığı olarak onları alçaltıcı azabın yıldırımı çarptı.","numberInSurah":17,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4236,"text":"İnananları ve Allah'a karşı gelmekten sakınmış olanları kurtardık.","numberInSurah":18,"juz":24,"manzil":6,"page":478,"ruku":414,"hizbQuarter":191,"sajda":false},{"number":4237,"text":"Allah'ın düşmanları o gün cehenneme sürülürler. Hepsi bir aradadırlar.","numberInSurah":19,"juz":24,"manzil":6,"page":478,"ruku":415,"hizbQuarter":191,"sajda":false},{"number":4238,"text":"Sonunda oraya varınca, kulakları, gözleri ve derileri, yaptıkları hakkında onların aleyhinde şahidlik ederler.","numberInSurah":20,"juz":24,"manzil":6,"page":478,"ruku":415,"hizbQuarter":191,"sajda":false},{"number":4239,"text":"Derilerine: \"Aleyhimize niçin şahidlik ettiniz?\" derler. \"Bizi, her şeyi konuşturan Allah konuşturdu. Sizi önce yaratan O'dur ve O'na döndürülüyorsunuz\" cevabını verirler.","numberInSurah":21,"juz":24,"manzil":6,"page":479,"ruku":415,"hizbQuarter":191,"sajda":false},{"number":4240,"text":"Siz, gözleriniz, kulaklarınız ve derilerinizin aleyhinize şahidlik edeceğinden korkarak kötü iş işlemekten çekinmiyordunuz. Hayır; Allah'ın, yaptıklarınızın çoğunu bilmediğini sanıyordunuz.","numberInSurah":22,"juz":24,"manzil":6,"page":479,"ruku":415,"hizbQuarter":191,"sajda":false},{"number":4241,"text":"İşte Rabbinizi böyle sanmanız sizi mahvetti de hüsrana uğrayanlardan oldunuz.","numberInSurah":23,"juz":24,"manzil":6,"page":479,"ruku":415,"hizbQuarter":191,"sajda":false},{"number":4242,"text":"İster sabretsinler ister etmesinler, onların durağı ateştir. Hoş tutulmalarını isteseler de artık hoş tutulmazlar.","numberInSurah":24,"juz":24,"manzil":6,"page":479,"ruku":415,"hizbQuarter":191,"sajda":false},{"number":4243,"text":"Onların yanına bir takım yardakçılar koyarız da geçmişlerini geleceklerini onlara güzel gösterirler. Verilen söz, gerek cinlerden ve gerekse insanlardan, gelip geçmiş ümmetler içinde, onların aleyhine gerçekleşmiştir. Doğrusu onlar hüsranda idiler.","numberInSurah":25,"juz":24,"manzil":6,"page":479,"ruku":415,"hizbQuarter":192,"sajda":false},{"number":4244,"text":"İnkar edenler: \"Bu Kuran'ı dinlemeyin, okunurken gürültü yapın, belki bastırırsınız\" dediler.","numberInSurah":26,"juz":24,"manzil":6,"page":479,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4245,"text":"İnkar edenlere çetin bir azap tattıracağız. İşledikleri en kötü işlere karşılık onların cezasını vereceğiz.","numberInSurah":27,"juz":24,"manzil":6,"page":479,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4246,"text":"İşte böyle; Allah'ın düşmanlarının cezası ateştir. Ayetlerimizi bile bile inkar etmeleri karşılığı orası onların temelli kalacakları yerdir.","numberInSurah":28,"juz":24,"manzil":6,"page":479,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4247,"text":"İnkar edenler: \"Rabbimiz! Cinlerden ve insanlardan, bizi saptıranları göster, onları ayaklarımızın altına alalım da en altta kalanlardan olsunlar\" derler.","numberInSurah":29,"juz":24,"manzil":6,"page":479,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4248,"text":"\"Rabbimiz Allah'tır\" deyip sonra da doğrulukta devam edenler, onları, melekler, ölümleri anında: \"Korkmayınız, üzülmeyiniz, size söz verilen cennetle sevinin, biz dünya hayatında da, ahirette de size dostuz. Burada, canlarınızın çektiği, umduğunuz şeyler, bağışlayan ve acıyan Allah katından bir ziyafet olarak size sunulur\" diyerek inerler.","numberInSurah":30,"juz":24,"manzil":6,"page":480,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4249,"text":"\"Rabbimiz Allah'tır\" deyip sonra da doğrulukta devam edenler, onları, melekler, ölümleri anında: \"Korkmayınız, üzülmeyiniz, size söz verilen cennetle sevinin, biz dünya hayatında da, ahirette de size dostuz. Burada, canlarınızın çektiği, umduğunuz şeyler, bağışlayan ve acıyan Allah katından bir ziyafet olarak size sunulur\" diyerek inerler.","numberInSurah":31,"juz":24,"manzil":6,"page":480,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4250,"text":"\"Rabbimiz Allah'tır\" deyip sonra da doğrulukta devam edenler, onları, melekler, ölümleri anında: \"Korkmayınız, üzülmeyiniz, size söz verilen cennetle sevinin, biz dünya hayatında da, ahirette de size dostuz. Burada, canlarınızın çektiği, umduğunuz şeyler, bağışlayan ve acıyan Allah katından bir ziyafet olarak size sunulur\" diyerek inerler.","numberInSurah":32,"juz":24,"manzil":6,"page":480,"ruku":416,"hizbQuarter":192,"sajda":false},{"number":4251,"text":"\"Doğrusu ben, kendini Allah'a verenlerdenim\" diyen, yararlı iş işleyen ve Allah'a çağıran kimseden daha güzel sözlü kim vardır?","numberInSurah":33,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4252,"text":"İyilik ve fenalık bir değildir. Ey inanan kişi: Sen, fenalığı en güzel şekilde sav; o zaman, seninle arasında düşmanlık bulunan kişinin yakın bir dost gibi olduğunu görürsün.","numberInSurah":34,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4253,"text":"Bu, ancak sabredenlere vergidir; bu ancak o büyük hazzı tadanlara vergidir.","numberInSurah":35,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4254,"text":"Şeytan seni dürtecek olursa Allah'a sığın; doğrusu O, işitendir, bilendir.","numberInSurah":36,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4255,"text":"Gece ile gündüz, güneş ile ay Allah'ın varlığının belgelerindendir. Güneşe ve aya secde etmeyin; eğer Allah'a kulluk etmek istiyorsanız, bunları yaratana secde edin.","numberInSurah":37,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4256,"text":"Eğer büyüklük taslarlarsa kendi aleyhlerinedir. Rabbinin katında bulunanlar hiç usanmadan, O'nu gece gündüz tesbih ederler.","numberInSurah":38,"juz":24,"manzil":6,"page":480,"ruku":417,"hizbQuarter":192,"sajda":{"id":12,"recommended":false,"obligatory":true}},{"number":4257,"text":"Kupkuru gördüğün yeryüzünün, Biz ona su indirdiğimiz zaman harekete geçmesi, kabarması, Allah'ın varlığının belgelerindendir. Ona can veren Allah şüphesiz ölüleri de diriltir. Doğrusu O her şeye kadir'dir.","numberInSurah":39,"juz":24,"manzil":6,"page":481,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4258,"text":"Ayetlerimizi inkar edenler Bize gizli değillerdir. Kıyamet gününde ateşe atılan mı, yoksa güven içinde gelen kimse mi daha iyidir? Dilediğinizi işleyin, doğrusu O, yaptıklarınızı gören'dir.","numberInSurah":40,"juz":24,"manzil":6,"page":481,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4259,"text":"Kitap kendilerine gelince, onlar, onu inkar etmişlerdir; oysa o, değerli bir Kitap'dır. Geçmişte ve gelecekte onu batıl kılacak yoktur. Hakim ve övülmeğe layık olan Allah katından indirilmedir.","numberInSurah":41,"juz":24,"manzil":6,"page":481,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4260,"text":"Kitap kendilerine gelince, onlar, onu inkar etmişlerdir; oysa o, değerli bir Kitap'dır. Geçmişte ve gelecekte onu batıl kılacak yoktur. Hakim ve övülmeğe layık olan Allah katından indirilmedir.","numberInSurah":42,"juz":24,"manzil":6,"page":481,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4261,"text":"Senin için söylenenler, senden önceki peygamberler için de söylenmişti. Doğrusu Rabbin hem bağışlayan ve hem de can yakıcı azap verendir.","numberInSurah":43,"juz":24,"manzil":6,"page":481,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4262,"text":"Biz bu Kuran'ı yabancı bir dil ile ortaya koysaydık: \"Ayetleri uzun açıklanmalı değil miydi? Araba yabancı bir dille söylenir mi?\" derlerdi. De ki: \"Bu, inananlara doğruluk rehberi ve gönüllerine şifadır.\" İnanmayanların kulaklarında ağırlık vardır ve onlara kapalıdır; sanki bunlara uzak bir mesafeden sesleniliyor da anlamıyorlar.","numberInSurah":44,"juz":24,"manzil":6,"page":481,"ruku":417,"hizbQuarter":192,"sajda":false},{"number":4263,"text":"And olsun ki Musa'ya Kitap vermiştik de onda ayrılığa düşmüşlerdi. Rabbinin verilmiş bir sözü olmasaydı, aralarında hükmedilmiş olurdu. Doğrusu onlar, onun hakkında şüphe ve endişe içindedirler.","numberInSurah":45,"juz":24,"manzil":6,"page":481,"ruku":418,"hizbQuarter":192,"sajda":false},{"number":4264,"text":"Kim yararlı iş işlerse kendi lehinedir; kim de kötülük işlerse kendi aleyhinedir. Rabbin, kullara karşı zalim değildir.","numberInSurah":46,"juz":24,"manzil":6,"page":481,"ruku":418,"hizbQuarter":192,"sajda":false},{"number":4265,"text":"Kıyametin ne zaman kopacağı bilgisi ona aittir. O'nun bilgisi dışında hiçbir ürün kabuğundan çıkmaz, hiçbir dişi gebe kalmaz ve doğurmaz. Onlara: \"Bana koştuğunuz ortaklar nerede?\" diye seslendiği gün: \"Sana, buna dair bizden hiçbir şahit olmadığınıarzederiz\" derler.","numberInSurah":47,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4266,"text":"Önceden yalvarıp durdukları şeyler onlardan uzaklaşmıştır. Kendilerinin kaçacak yerleri olmadığını anlamışlardır.","numberInSurah":48,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4267,"text":"İnsan, iyilik istemekten usanmaz da, kendisine bir kötülük gelince umutsuzluğa düşer, meyus olur.","numberInSurah":49,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4268,"text":"Başına gelen sıkıntıdan sonra, kendisine katımızdan bir rahmet tattırsak: \"Bu benim hakkımdır; kıyametin kopacağını sanmıyorum. Rabbime döndürülürsem, O'nun katında and olsun ki, benim için daha güzel şeyler vardır\" der. İnkar edenlere, işlediklerini, and olsun ki bildireceğiz. Onlara and olsun ki çetin bir azap tattıracağız.","numberInSurah":50,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4269,"text":"İnsana nimet verdiğimiz zaman yüz çevirerek yan çizer; başına bir kötülük gelince uzun uzun yalvarır.","numberInSurah":51,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4270,"text":"De ki: \"Kuran Allah katından gelmiş olup da siz de onu inkar etmişseniz, söyleyin bana, derin bir çıkmazda bulunan kimseden daha sapık kim vardır?\"","numberInSurah":52,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4271,"text":"Onun hak olduğu meydana çıkıncaya kadar varlığımızın belgelerini onlara hem dış dünyada ve hem de kendi içlerinde göstereceğiz. Rabbinin her şeye şahit olması yetmez mi?","numberInSurah":53,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false},{"number":4272,"text":"Dikkat edin; onlar Rablerine kavuşmaktan şüphededirler; dikkat edin; Allah şüphesiz her şeyi bilgisiyle kuşatandır.","numberInSurah":54,"juz":25,"manzil":6,"page":482,"ruku":418,"hizbQuarter":193,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}