{"arabic":{"number":49,"name":"سُورَةُ الحُجُرَاتِ","englishName":"Hucurât","englishNameTranslation":"The Inner Apartments","revelationType":"Medinan","numberOfAyahs":18,"ayahs":[{"number":4613,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تُقَدِّمُوا بَيْنَ يَدَيِ اللَّهِ وَرَسُولِهِ ۖ وَاتَّقُوا اللَّهَ ۚ إِنَّ اللَّهَ سَمِيعٌ عَلِيمٌ","numberInSurah":1,"juz":26,"manzil":6,"page":515,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4614,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا تَرْفَعُوا أَصْوَاتَكُمْ فَوْقَ صَوْتِ النَّبِيِّ وَلَا تَجْهَرُوا لَهُ بِالْقَوْلِ كَجَهْرِ بَعْضِكُمْ لِبَعْضٍ أَنْ تَحْبَطَ أَعْمَالُكُمْ وَأَنْتُمْ لَا تَشْعُرُونَ","numberInSurah":2,"juz":26,"manzil":6,"page":515,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4615,"text":"إِنَّ الَّذِينَ يَغُضُّونَ أَصْوَاتَهُمْ عِنْدَ رَسُولِ اللَّهِ أُولَٰئِكَ الَّذِينَ امْتَحَنَ اللَّهُ قُلُوبَهُمْ لِلتَّقْوَىٰ ۚ لَهُمْ مَغْفِرَةٌ وَأَجْرٌ عَظِيمٌ","numberInSurah":3,"juz":26,"manzil":6,"page":515,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4616,"text":"إِنَّ الَّذِينَ يُنَادُونَكَ مِنْ وَرَاءِ الْحُجُرَاتِ أَكْثَرُهُمْ لَا يَعْقِلُونَ","numberInSurah":4,"juz":26,"manzil":6,"page":515,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4617,"text":"وَلَوْ أَنَّهُمْ صَبَرُوا حَتَّىٰ تَخْرُجَ إِلَيْهِمْ لَكَانَ خَيْرًا لَهُمْ ۚ وَاللَّهُ غَفُورٌ رَحِيمٌ","numberInSurah":5,"juz":26,"manzil":6,"page":516,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4618,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ جَاءَكُمْ فَاسِقٌ بِنَبَإٍ فَتَبَيَّنُوا أَنْ تُصِيبُوا قَوْمًا بِجَهَالَةٍ فَتُصْبِحُوا عَلَىٰ مَا فَعَلْتُمْ نَادِمِينَ","numberInSurah":6,"juz":26,"manzil":6,"page":516,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4619,"text":"وَاعْلَمُوا أَنَّ فِيكُمْ رَسُولَ اللَّهِ ۚ لَوْ يُطِيعُكُمْ فِي كَثِيرٍ مِنَ الْأَمْرِ لَعَنِتُّمْ وَلَٰكِنَّ اللَّهَ حَبَّبَ إِلَيْكُمُ الْإِيمَانَ وَزَيَّنَهُ فِي قُلُوبِكُمْ وَكَرَّهَ إِلَيْكُمُ الْكُفْرَ وَالْفُسُوقَ وَالْعِصْيَانَ ۚ أُولَٰئِكَ هُمُ الرَّاشِدُونَ","numberInSurah":7,"juz":26,"manzil":6,"page":516,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4620,"text":"فَضْلًا مِنَ اللَّهِ وَنِعْمَةً ۚ وَاللَّهُ عَلِيمٌ حَكِيمٌ","numberInSurah":8,"juz":26,"manzil":6,"page":516,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4621,"text":"وَإِنْ طَائِفَتَانِ مِنَ الْمُؤْمِنِينَ اقْتَتَلُوا فَأَصْلِحُوا بَيْنَهُمَا ۖ فَإِنْ بَغَتْ إِحْدَاهُمَا عَلَى الْأُخْرَىٰ فَقَاتِلُوا الَّتِي تَبْغِي حَتَّىٰ تَفِيءَ إِلَىٰ أَمْرِ اللَّهِ ۚ فَإِنْ فَاءَتْ فَأَصْلِحُوا بَيْنَهُمَا بِالْعَدْلِ وَأَقْسِطُوا ۖ إِنَّ اللَّهَ يُحِبُّ الْمُقْسِطِينَ","numberInSurah":9,"juz":26,"manzil":6,"page":516,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4622,"text":"إِنَّمَا الْمُؤْمِنُونَ إِخْوَةٌ فَأَصْلِحُوا بَيْنَ أَخَوَيْكُمْ ۚ وَاتَّقُوا اللَّهَ لَعَلَّكُمْ تُرْحَمُونَ","numberInSurah":10,"juz":26,"manzil":6,"page":516,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4623,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا لَا يَسْخَرْ قَوْمٌ مِنْ قَوْمٍ عَسَىٰ أَنْ يَكُونُوا خَيْرًا مِنْهُمْ وَلَا نِسَاءٌ مِنْ نِسَاءٍ عَسَىٰ أَنْ يَكُنَّ خَيْرًا مِنْهُنَّ ۖ وَلَا تَلْمِزُوا أَنْفُسَكُمْ وَلَا تَنَابَزُوا بِالْأَلْقَابِ ۖ بِئْسَ الِاسْمُ الْفُسُوقُ بَعْدَ الْإِيمَانِ ۚ وَمَنْ لَمْ يَتُبْ فَأُولَٰئِكَ هُمُ الظَّالِمُونَ","numberInSurah":11,"juz":26,"manzil":6,"page":516,"ruku":451,"hizbQuarter":206,"sajda":false},{"number":4624,"text":"يَا أَيُّهَا الَّذِينَ آمَنُوا اجْتَنِبُوا كَثِيرًا مِنَ الظَّنِّ إِنَّ بَعْضَ الظَّنِّ إِثْمٌ ۖ وَلَا تَجَسَّسُوا وَلَا يَغْتَبْ بَعْضُكُمْ بَعْضًا ۚ أَيُحِبُّ أَحَدُكُمْ أَنْ يَأْكُلَ لَحْمَ أَخِيهِ مَيْتًا فَكَرِهْتُمُوهُ ۚ وَاتَّقُوا اللَّهَ ۚ إِنَّ اللَّهَ تَوَّابٌ رَحِيمٌ","numberInSurah":12,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":206,"sajda":false},{"number":4625,"text":"يَا أَيُّهَا النَّاسُ إِنَّا خَلَقْنَاكُمْ مِنْ ذَكَرٍ وَأُنْثَىٰ وَجَعَلْنَاكُمْ شُعُوبًا وَقَبَائِلَ لِتَعَارَفُوا ۚ إِنَّ أَكْرَمَكُمْ عِنْدَ اللَّهِ أَتْقَاكُمْ ۚ إِنَّ اللَّهَ عَلِيمٌ خَبِيرٌ","numberInSurah":13,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":206,"sajda":false},{"number":4626,"text":"۞ قَالَتِ الْأَعْرَابُ آمَنَّا ۖ قُلْ لَمْ تُؤْمِنُوا وَلَٰكِنْ قُولُوا أَسْلَمْنَا وَلَمَّا يَدْخُلِ الْإِيمَانُ فِي قُلُوبِكُمْ ۖ وَإِنْ تُطِيعُوا اللَّهَ وَرَسُولَهُ لَا يَلِتْكُمْ مِنْ أَعْمَالِكُمْ شَيْئًا ۚ إِنَّ اللَّهَ غَفُورٌ رَحِيمٌ","numberInSurah":14,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":207,"sajda":false},{"number":4627,"text":"إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ آمَنُوا بِاللَّهِ وَرَسُولِهِ ثُمَّ لَمْ يَرْتَابُوا وَجَاهَدُوا بِأَمْوَالِهِمْ وَأَنْفُسِهِمْ فِي سَبِيلِ اللَّهِ ۚ أُولَٰئِكَ هُمُ الصَّادِقُونَ","numberInSurah":15,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":207,"sajda":false},{"number":4628,"text":"قُلْ أَتُعَلِّمُونَ اللَّهَ بِدِينِكُمْ وَاللَّهُ يَعْلَمُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۚ وَاللَّهُ بِكُلِّ شَيْءٍ عَلِيمٌ","numberInSurah":16,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":207,"sajda":false},{"number":4629,"text":"يَمُنُّونَ عَلَيْكَ أَنْ أَسْلَمُوا ۖ قُلْ لَا تَمُنُّوا عَلَيَّ إِسْلَامَكُمْ ۖ بَلِ اللَّهُ يَمُنُّ عَلَيْكُمْ أَنْ هَدَاكُمْ لِلْإِيمَانِ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":17,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":207,"sajda":false},{"number":4630,"text":"إِنَّ اللَّهَ يَعْلَمُ غَيْبَ السَّمَاوَاتِ وَالْأَرْضِ ۚ وَاللَّهُ بَصِيرٌ بِمَا تَعْمَلُونَ","numberInSurah":18,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":207,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":49,"name":"سُورَةُ الحُجُرَاتِ","englishName":"Hucurât","englishNameTranslation":"The Inner Apartments","revelationType":"Medinan","numberOfAyahs":18,"ayahs":[{"number":4613,"text":"Ey inananlar! Allah'tan ve Peygamberinden öne geçmeyin; Allah'tan sakının, doğrusu Allah işitir ve bilir.","numberInSurah":1,"juz":26,"manzil":6,"page":515,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4614,"text":"Ey inananlar! Seslerinizi, Peygamberin sesini bastıracak şekilde yükseltmeyin. Farkına varmadan, işlediklerinizin boşa gitmemesi için, Peygambere birbirinize bağırdığınız gibi yüksek sesle bağırmayın.","numberInSurah":2,"juz":26,"manzil":6,"page":515,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4615,"text":"Seslerini Peygamberin yanında kısan kimseler, Allah'ın gönüllerini takva ile sınadığı kimselerdir. Onlara mağfiret ve büyük ecir vardır.","numberInSurah":3,"juz":26,"manzil":6,"page":515,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4616,"text":"Sana odaların ötesinden seslenenlerin çoğu akletmeyen kimselerdir.","numberInSurah":4,"juz":26,"manzil":6,"page":515,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4617,"text":"Eğer onlar, sen yanlarına çıkıncaya kadar sabretselerdi şüphesiz onlar için daha iyi olurdu. Allah bağışlayandır, merhamet edendir.","numberInSurah":5,"juz":26,"manzil":6,"page":516,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4618,"text":"Ey inananlar! Eğer yoldan çıkmışın biri size bir haber getirirse, onun iç yüzünü araştırın, yoksa bilmeden bir millete fenalık edersiniz de sonra ettiğinize pişman olursunuz.","numberInSurah":6,"juz":26,"manzil":6,"page":516,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4619,"text":"Bilin ki, içinizde Allah'ın Peygamberi bulunmaktadır. Eğer o, bir çok işlerde size uymuş olsaydı şüphesiz kötü duruma düşerdiniz; ama Allah size imanı sevdirmiş, onu gönüllerinize güzel göstermiş; inkarcılığı, yoldan çıkmayı ve baş kaldırmayı size iğrenç göstermiştir. İşte böyle olanlar, Allah katından bir lütuf ve nimet sayesinde doğru yolda bulunanlardır. Allah bilendir, Hakim'dir.","numberInSurah":7,"juz":26,"manzil":6,"page":516,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4620,"text":"Bilin ki, içinizde Allah'ın Peygamberi bulunmaktadır. Eğer o, bir çok işlerde size uymuş olsaydı şüphesiz kötü duruma düşerdiniz; ama Allah size imanı sevdirmiş, onu gönüllerinize güzel göstermiş; inkarcılığı, yoldan çıkmayı ve baş kaldırmayı size iğrenç göstermiştir. İşte böyle olanlar, Allah katından bir lütuf ve nimet sayesinde doğru yolda bulunanlardır. Allah bilendir, Hakim'dir.","numberInSurah":8,"juz":26,"manzil":6,"page":516,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4621,"text":"Eğer müminlerden iki topluluk birbirleriyle savaşırlarsa aralarını düzeltiniz; eğer biri diğeri üzerine saldırırsa, saldıranlarla Allah'ın buyruğuna dönmelerine kadar savaşınız; eğer dönerlerse aralarını adaletle bulunuz, adil davranınız, şüphesiz Allah adil davrananları sever.","numberInSurah":9,"juz":26,"manzil":6,"page":516,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4622,"text":"Şüphesiz müminler birbiri ile kardeştirler; öyle ise dargın olan kardeşlerinizin arasını düzeltin; Allah'tan sakının ki size acısın.","numberInSurah":10,"juz":26,"manzil":6,"page":516,"ruku":450,"hizbQuarter":206,"sajda":false},{"number":4623,"text":"Ey inananlar! Bir topluluk bir diğerini alaya almasın, belki de onlar kendilerinden daha iyidirler. Kadınlar da başka kadınları alaya almasınlar, belki onlar kendilerinden daha iyidirler. Kendi kendinizi ayıplamayın; birbirinizi kötü lakaplarla çağırmayın; inandıktan sonra yoldan çıkmış olmak ne kötü bir addır. Tevbe etmeyenler, işte onlar zalimlerdir.","numberInSurah":11,"juz":26,"manzil":6,"page":516,"ruku":451,"hizbQuarter":206,"sajda":false},{"number":4624,"text":"Ey inananlar! Zannın çoğundan sakının, zira zannın bir kısmı günahtır. Birbirinizin suçunu araştırmayın; kimse kimseyi çekiştirmesin; hangi biriniz ölü kardeşinin etini yemekten hoşlanır? Ondan tiksinirsiniz; Allah'tan sakının, şüphesiz Allah tevbeleri daima kabul edendir, acıyandır.","numberInSurah":12,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":206,"sajda":false},{"number":4625,"text":"Ey insanlar! Doğrusu Biz sizleri bir erkekle bir dişiden yarattık. Sizi milletler ve kabileler haline koyduk ki birbirinizi kolayca tanıyasınız. Şüphesiz, Allah katında en değerliniz, O'na karşı gelmekten en çok sakınanızdır. Allah bilendir, haberdardır.","numberInSurah":13,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":206,"sajda":false},{"number":4626,"text":"Bedeviler: \"İnandık\" dediler, de ki: \"İnanmadınız ama İslam olduk deyin; inanç henüz gönüllerinize yerleşmedi; eğer Allah'a ve Peygamberine itaat ederseniz, işlediklerinizden bir şey eksilmez; doğrusu Allah, bağışlar, merhamet eder.\"","numberInSurah":14,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":207,"sajda":false},{"number":4627,"text":"\"İnananlar, ancak Allah'a ve peygamberine inanmış, sonra şüpheye düşmemiş; Allah uğrunda mallarıyla, canlarıyla cihat etmiş olanlardır. İşte onlar doğru olanlardır.\"","numberInSurah":15,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":207,"sajda":false},{"number":4628,"text":"De ki: \"Dininizi Allah'a mı öğretiyorsunuz? Oysa Allah göklerde olanları da yerde olanları da bilir, Allah her şeyi bilendir.\"","numberInSurah":16,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":207,"sajda":false},{"number":4629,"text":"Müslüman oldular diye seni minnet altında bırakmak isterler; de ki: \"Müslüman olmanızla beni minnet altında tutmayın, hayır; eğer doğru kimselerseniz, sizi imana eriştirmekle Allah sizi minnet altında bırakır.\"","numberInSurah":17,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":207,"sajda":false},{"number":4630,"text":"Doğrusu Allah, göklerin ve yerin gaybını bilir. Allah, yaptıklarınızı görendir.","numberInSurah":18,"juz":26,"manzil":6,"page":517,"ruku":451,"hizbQuarter":207,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}