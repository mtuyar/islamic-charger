{"arabic":{"number":30,"name":"سُورَةُ الرُّومِ","englishName":"Rûm","englishNameTranslation":"The Romans","revelationType":"Meccan","numberOfAyahs":60,"ayahs":[{"number":3410,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ الم","numberInSurah":1,"juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3411,"text":"غُلِبَتِ الرُّومُ","numberInSurah":2,"juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3412,"text":"فِي أَدْنَى الْأَرْضِ وَهُمْ مِنْ بَعْدِ غَلَبِهِمْ سَيَغْلِبُونَ","numberInSurah":3,"juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3413,"text":"فِي بِضْعِ سِنِينَ ۗ لِلَّهِ الْأَمْرُ مِنْ قَبْلُ وَمِنْ بَعْدُ ۚ وَيَوْمَئِذٍ يَفْرَحُ الْمُؤْمِنُونَ","numberInSurah":4,"juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3414,"text":"بِنَصْرِ اللَّهِ ۚ يَنْصُرُ مَنْ يَشَاءُ ۖ وَهُوَ الْعَزِيزُ الرَّحِيمُ","numberInSurah":5,"juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3415,"text":"وَعْدَ اللَّهِ ۖ لَا يُخْلِفُ اللَّهُ وَعْدَهُ وَلَٰكِنَّ أَكْثَرَ النَّاسِ لَا يَعْلَمُونَ","numberInSurah":6,"juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3416,"text":"يَعْلَمُونَ ظَاهِرًا مِنَ الْحَيَاةِ الدُّنْيَا وَهُمْ عَنِ الْآخِرَةِ هُمْ غَافِلُونَ","numberInSurah":7,"juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3417,"text":"أَوَلَمْ يَتَفَكَّرُوا فِي أَنْفُسِهِمْ ۗ مَا خَلَقَ اللَّهُ السَّمَاوَاتِ وَالْأَرْضَ وَمَا بَيْنَهُمَا إِلَّا بِالْحَقِّ وَأَجَلٍ مُسَمًّى ۗ وَإِنَّ كَثِيرًا مِنَ النَّاسِ بِلِقَاءِ رَبِّهِمْ لَكَافِرُونَ","numberInSurah":8,"juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3418,"text":"أَوَلَمْ يَسِيرُوا فِي الْأَرْضِ فَيَنْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلِهِمْ ۚ كَانُوا أَشَدَّ مِنْهُمْ قُوَّةً وَأَثَارُوا الْأَرْضَ وَعَمَرُوهَا أَكْثَرَ مِمَّا عَمَرُوهَا وَجَاءَتْهُمْ رُسُلُهُمْ بِالْبَيِّنَاتِ ۖ فَمَا كَانَ اللَّهُ لِيَظْلِمَهُمْ وَلَٰكِنْ كَانُوا أَنْفُسَهُمْ يَظْلِمُونَ","numberInSurah":9,"juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3419,"text":"ثُمَّ كَانَ عَاقِبَةَ الَّذِينَ أَسَاءُوا السُّوأَىٰ أَنْ كَذَّبُوا بِآيَاتِ اللَّهِ وَكَانُوا بِهَا يَسْتَهْزِئُونَ","numberInSurah":10,"juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3420,"text":"اللَّهُ يَبْدَأُ الْخَلْقَ ثُمَّ يُعِيدُهُ ثُمَّ إِلَيْهِ تُرْجَعُونَ","numberInSurah":11,"juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3421,"text":"وَيَوْمَ تَقُومُ السَّاعَةُ يُبْلِسُ الْمُجْرِمُونَ","numberInSurah":12,"juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3422,"text":"وَلَمْ يَكُنْ لَهُمْ مِنْ شُرَكَائِهِمْ شُفَعَاءُ وَكَانُوا بِشُرَكَائِهِمْ كَافِرِينَ","numberInSurah":13,"juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3423,"text":"وَيَوْمَ تَقُومُ السَّاعَةُ يَوْمَئِذٍ يَتَفَرَّقُونَ","numberInSurah":14,"juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3424,"text":"فَأَمَّا الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ فَهُمْ فِي رَوْضَةٍ يُحْبَرُونَ","numberInSurah":15,"juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3425,"text":"وَأَمَّا الَّذِينَ كَفَرُوا وَكَذَّبُوا بِآيَاتِنَا وَلِقَاءِ الْآخِرَةِ فَأُولَٰئِكَ فِي الْعَذَابِ مُحْضَرُونَ","numberInSurah":16,"juz":21,"manzil":5,"page":406,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3426,"text":"فَسُبْحَانَ اللَّهِ حِينَ تُمْسُونَ وَحِينَ تُصْبِحُونَ","numberInSurah":17,"juz":21,"manzil":5,"page":406,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3427,"text":"وَلَهُ الْحَمْدُ فِي السَّمَاوَاتِ وَالْأَرْضِ وَعَشِيًّا وَحِينَ تُظْهِرُونَ","numberInSurah":18,"juz":21,"manzil":5,"page":406,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3428,"text":"يُخْرِجُ الْحَيَّ مِنَ الْمَيِّتِ وَيُخْرِجُ الْمَيِّتَ مِنَ الْحَيِّ وَيُحْيِي الْأَرْضَ بَعْدَ مَوْتِهَا ۚ وَكَذَٰلِكَ تُخْرَجُونَ","numberInSurah":19,"juz":21,"manzil":5,"page":406,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3429,"text":"وَمِنْ آيَاتِهِ أَنْ خَلَقَكُمْ مِنْ تُرَابٍ ثُمَّ إِذَا أَنْتُمْ بَشَرٌ تَنْتَشِرُونَ","numberInSurah":20,"juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3430,"text":"وَمِنْ آيَاتِهِ أَنْ خَلَقَ لَكُمْ مِنْ أَنْفُسِكُمْ أَزْوَاجًا لِتَسْكُنُوا إِلَيْهَا وَجَعَلَ بَيْنَكُمْ مَوَدَّةً وَرَحْمَةً ۚ إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِقَوْمٍ يَتَفَكَّرُونَ","numberInSurah":21,"juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3431,"text":"وَمِنْ آيَاتِهِ خَلْقُ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافُ أَلْسِنَتِكُمْ وَأَلْوَانِكُمْ ۚ إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِلْعَالِمِينَ","numberInSurah":22,"juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3432,"text":"وَمِنْ آيَاتِهِ مَنَامُكُمْ بِاللَّيْلِ وَالنَّهَارِ وَابْتِغَاؤُكُمْ مِنْ فَضْلِهِ ۚ إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِقَوْمٍ يَسْمَعُونَ","numberInSurah":23,"juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3433,"text":"وَمِنْ آيَاتِهِ يُرِيكُمُ الْبَرْقَ خَوْفًا وَطَمَعًا وَيُنَزِّلُ مِنَ السَّمَاءِ مَاءً فَيُحْيِي بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا ۚ إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِقَوْمٍ يَعْقِلُونَ","numberInSurah":24,"juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3434,"text":"وَمِنْ آيَاتِهِ أَنْ تَقُومَ السَّمَاءُ وَالْأَرْضُ بِأَمْرِهِ ۚ ثُمَّ إِذَا دَعَاكُمْ دَعْوَةً مِنَ الْأَرْضِ إِذَا أَنْتُمْ تَخْرُجُونَ","numberInSurah":25,"juz":21,"manzil":5,"page":407,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3435,"text":"وَلَهُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ ۖ كُلٌّ لَهُ قَانِتُونَ","numberInSurah":26,"juz":21,"manzil":5,"page":407,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3436,"text":"وَهُوَ الَّذِي يَبْدَأُ الْخَلْقَ ثُمَّ يُعِيدُهُ وَهُوَ أَهْوَنُ عَلَيْهِ ۚ وَلَهُ الْمَثَلُ الْأَعْلَىٰ فِي السَّمَاوَاتِ وَالْأَرْضِ ۚ وَهُوَ الْعَزِيزُ الْحَكِيمُ","numberInSurah":27,"juz":21,"manzil":5,"page":407,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3437,"text":"ضَرَبَ لَكُمْ مَثَلًا مِنْ أَنْفُسِكُمْ ۖ هَلْ لَكُمْ مِنْ مَا مَلَكَتْ أَيْمَانُكُمْ مِنْ شُرَكَاءَ فِي مَا رَزَقْنَاكُمْ فَأَنْتُمْ فِيهِ سَوَاءٌ تَخَافُونَهُمْ كَخِيفَتِكُمْ أَنْفُسَكُمْ ۚ كَذَٰلِكَ نُفَصِّلُ الْآيَاتِ لِقَوْمٍ يَعْقِلُونَ","numberInSurah":28,"juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":162,"sajda":false},{"number":3438,"text":"بَلِ اتَّبَعَ الَّذِينَ ظَلَمُوا أَهْوَاءَهُمْ بِغَيْرِ عِلْمٍ ۖ فَمَنْ يَهْدِي مَنْ أَضَلَّ اللَّهُ ۖ وَمَا لَهُمْ مِنْ نَاصِرِينَ","numberInSurah":29,"juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":162,"sajda":false},{"number":3439,"text":"فَأَقِمْ وَجْهَكَ لِلدِّينِ حَنِيفًا ۚ فِطْرَتَ اللَّهِ الَّتِي فَطَرَ النَّاسَ عَلَيْهَا ۚ لَا تَبْدِيلَ لِخَلْقِ اللَّهِ ۚ ذَٰلِكَ الدِّينُ الْقَيِّمُ وَلَٰكِنَّ أَكْثَرَ النَّاسِ لَا يَعْلَمُونَ","numberInSurah":30,"juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":162,"sajda":false},{"number":3440,"text":"۞ مُنِيبِينَ إِلَيْهِ وَاتَّقُوهُ وَأَقِيمُوا الصَّلَاةَ وَلَا تَكُونُوا مِنَ الْمُشْرِكِينَ","numberInSurah":31,"juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3441,"text":"مِنَ الَّذِينَ فَرَّقُوا دِينَهُمْ وَكَانُوا شِيَعًا ۖ كُلُّ حِزْبٍ بِمَا لَدَيْهِمْ فَرِحُونَ","numberInSurah":32,"juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3442,"text":"وَإِذَا مَسَّ النَّاسَ ضُرٌّ دَعَوْا رَبَّهُمْ مُنِيبِينَ إِلَيْهِ ثُمَّ إِذَا أَذَاقَهُمْ مِنْهُ رَحْمَةً إِذَا فَرِيقٌ مِنْهُمْ بِرَبِّهِمْ يُشْرِكُونَ","numberInSurah":33,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3443,"text":"لِيَكْفُرُوا بِمَا آتَيْنَاهُمْ ۚ فَتَمَتَّعُوا فَسَوْفَ تَعْلَمُونَ","numberInSurah":34,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3444,"text":"أَمْ أَنْزَلْنَا عَلَيْهِمْ سُلْطَانًا فَهُوَ يَتَكَلَّمُ بِمَا كَانُوا بِهِ يُشْرِكُونَ","numberInSurah":35,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3445,"text":"وَإِذَا أَذَقْنَا النَّاسَ رَحْمَةً فَرِحُوا بِهَا ۖ وَإِنْ تُصِبْهُمْ سَيِّئَةٌ بِمَا قَدَّمَتْ أَيْدِيهِمْ إِذَا هُمْ يَقْنَطُونَ","numberInSurah":36,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3446,"text":"أَوَلَمْ يَرَوْا أَنَّ اللَّهَ يَبْسُطُ الرِّزْقَ لِمَنْ يَشَاءُ وَيَقْدِرُ ۚ إِنَّ فِي ذَٰلِكَ لَآيَاتٍ لِقَوْمٍ يُؤْمِنُونَ","numberInSurah":37,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3447,"text":"فَآتِ ذَا الْقُرْبَىٰ حَقَّهُ وَالْمِسْكِينَ وَابْنَ السَّبِيلِ ۚ ذَٰلِكَ خَيْرٌ لِلَّذِينَ يُرِيدُونَ وَجْهَ اللَّهِ ۖ وَأُولَٰئِكَ هُمُ الْمُفْلِحُونَ","numberInSurah":38,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3448,"text":"وَمَا آتَيْتُمْ مِنْ رِبًا لِيَرْبُوَ فِي أَمْوَالِ النَّاسِ فَلَا يَرْبُو عِنْدَ اللَّهِ ۖ وَمَا آتَيْتُمْ مِنْ زَكَاةٍ تُرِيدُونَ وَجْهَ اللَّهِ فَأُولَٰئِكَ هُمُ الْمُضْعِفُونَ","numberInSurah":39,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3449,"text":"اللَّهُ الَّذِي خَلَقَكُمْ ثُمَّ رَزَقَكُمْ ثُمَّ يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ ۖ هَلْ مِنْ شُرَكَائِكُمْ مَنْ يَفْعَلُ مِنْ ذَٰلِكُمْ مِنْ شَيْءٍ ۚ سُبْحَانَهُ وَتَعَالَىٰ عَمَّا يُشْرِكُونَ","numberInSurah":40,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3450,"text":"ظَهَرَ الْفَسَادُ فِي الْبَرِّ وَالْبَحْرِ بِمَا كَسَبَتْ أَيْدِي النَّاسِ لِيُذِيقَهُمْ بَعْضَ الَّذِي عَمِلُوا لَعَلَّهُمْ يَرْجِعُونَ","numberInSurah":41,"juz":21,"manzil":5,"page":408,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3451,"text":"قُلْ سِيرُوا فِي الْأَرْضِ فَانْظُرُوا كَيْفَ كَانَ عَاقِبَةُ الَّذِينَ مِنْ قَبْلُ ۚ كَانَ أَكْثَرُهُمْ مُشْرِكِينَ","numberInSurah":42,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3452,"text":"فَأَقِمْ وَجْهَكَ لِلدِّينِ الْقَيِّمِ مِنْ قَبْلِ أَنْ يَأْتِيَ يَوْمٌ لَا مَرَدَّ لَهُ مِنَ اللَّهِ ۖ يَوْمَئِذٍ يَصَّدَّعُونَ","numberInSurah":43,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3453,"text":"مَنْ كَفَرَ فَعَلَيْهِ كُفْرُهُ ۖ وَمَنْ عَمِلَ صَالِحًا فَلِأَنْفُسِهِمْ يَمْهَدُونَ","numberInSurah":44,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3454,"text":"لِيَجْزِيَ الَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ مِنْ فَضْلِهِ ۚ إِنَّهُ لَا يُحِبُّ الْكَافِرِينَ","numberInSurah":45,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3455,"text":"وَمِنْ آيَاتِهِ أَنْ يُرْسِلَ الرِّيَاحَ مُبَشِّرَاتٍ وَلِيُذِيقَكُمْ مِنْ رَحْمَتِهِ وَلِتَجْرِيَ الْفُلْكُ بِأَمْرِهِ وَلِتَبْتَغُوا مِنْ فَضْلِهِ وَلَعَلَّكُمْ تَشْكُرُونَ","numberInSurah":46,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3456,"text":"وَلَقَدْ أَرْسَلْنَا مِنْ قَبْلِكَ رُسُلًا إِلَىٰ قَوْمِهِمْ فَجَاءُوهُمْ بِالْبَيِّنَاتِ فَانْتَقَمْنَا مِنَ الَّذِينَ أَجْرَمُوا ۖ وَكَانَ حَقًّا عَلَيْنَا نَصْرُ الْمُؤْمِنِينَ","numberInSurah":47,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3457,"text":"اللَّهُ الَّذِي يُرْسِلُ الرِّيَاحَ فَتُثِيرُ سَحَابًا فَيَبْسُطُهُ فِي السَّمَاءِ كَيْفَ يَشَاءُ وَيَجْعَلُهُ كِسَفًا فَتَرَى الْوَدْقَ يَخْرُجُ مِنْ خِلَالِهِ ۖ فَإِذَا أَصَابَ بِهِ مَنْ يَشَاءُ مِنْ عِبَادِهِ إِذَا هُمْ يَسْتَبْشِرُونَ","numberInSurah":48,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3458,"text":"وَإِنْ كَانُوا مِنْ قَبْلِ أَنْ يُنَزَّلَ عَلَيْهِمْ مِنْ قَبْلِهِ لَمُبْلِسِينَ","numberInSurah":49,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3459,"text":"فَانْظُرْ إِلَىٰ آثَارِ رَحْمَتِ اللَّهِ كَيْفَ يُحْيِي الْأَرْضَ بَعْدَ مَوْتِهَا ۚ إِنَّ ذَٰلِكَ لَمُحْيِي الْمَوْتَىٰ ۖ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":50,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3460,"text":"وَلَئِنْ أَرْسَلْنَا رِيحًا فَرَأَوْهُ مُصْفَرًّا لَظَلُّوا مِنْ بَعْدِهِ يَكْفُرُونَ","numberInSurah":51,"juz":21,"manzil":5,"page":410,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3461,"text":"فَإِنَّكَ لَا تُسْمِعُ الْمَوْتَىٰ وَلَا تُسْمِعُ الصُّمَّ الدُّعَاءَ إِذَا وَلَّوْا مُدْبِرِينَ","numberInSurah":52,"juz":21,"manzil":5,"page":410,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3462,"text":"وَمَا أَنْتَ بِهَادِ الْعُمْيِ عَنْ ضَلَالَتِهِمْ ۖ إِنْ تُسْمِعُ إِلَّا مَنْ يُؤْمِنُ بِآيَاتِنَا فَهُمْ مُسْلِمُونَ","numberInSurah":53,"juz":21,"manzil":5,"page":410,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3463,"text":"۞ اللَّهُ الَّذِي خَلَقَكُمْ مِنْ ضَعْفٍ ثُمَّ جَعَلَ مِنْ بَعْدِ ضَعْفٍ قُوَّةً ثُمَّ جَعَلَ مِنْ بَعْدِ قُوَّةٍ ضَعْفًا وَشَيْبَةً ۚ يَخْلُقُ مَا يَشَاءُ ۖ وَهُوَ الْعَلِيمُ الْقَدِيرُ","numberInSurah":54,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3464,"text":"وَيَوْمَ تَقُومُ السَّاعَةُ يُقْسِمُ الْمُجْرِمُونَ مَا لَبِثُوا غَيْرَ سَاعَةٍ ۚ كَذَٰلِكَ كَانُوا يُؤْفَكُونَ","numberInSurah":55,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3465,"text":"وَقَالَ الَّذِينَ أُوتُوا الْعِلْمَ وَالْإِيمَانَ لَقَدْ لَبِثْتُمْ فِي كِتَابِ اللَّهِ إِلَىٰ يَوْمِ الْبَعْثِ ۖ فَهَٰذَا يَوْمُ الْبَعْثِ وَلَٰكِنَّكُمْ كُنْتُمْ لَا تَعْلَمُونَ","numberInSurah":56,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3466,"text":"فَيَوْمَئِذٍ لَا يَنْفَعُ الَّذِينَ ظَلَمُوا مَعْذِرَتُهُمْ وَلَا هُمْ يُسْتَعْتَبُونَ","numberInSurah":57,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3467,"text":"وَلَقَدْ ضَرَبْنَا لِلنَّاسِ فِي هَٰذَا الْقُرْآنِ مِنْ كُلِّ مَثَلٍ ۚ وَلَئِنْ جِئْتَهُمْ بِآيَةٍ لَيَقُولَنَّ الَّذِينَ كَفَرُوا إِنْ أَنْتُمْ إِلَّا مُبْطِلُونَ","numberInSurah":58,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3468,"text":"كَذَٰلِكَ يَطْبَعُ اللَّهُ عَلَىٰ قُلُوبِ الَّذِينَ لَا يَعْلَمُونَ","numberInSurah":59,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3469,"text":"فَاصْبِرْ إِنَّ وَعْدَ اللَّهِ حَقٌّ ۖ وَلَا يَسْتَخِفَّنَّكَ الَّذِينَ لَا يُوقِنُونَ","numberInSurah":60,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":30,"name":"سُورَةُ الرُّومِ","englishName":"Rûm","englishNameTranslation":"The Romans","revelationType":"Meccan","numberOfAyahs":60,"ayahs":[{"number":3410,"text":"Elif, Lam, Mim.","numberInSurah":1,"juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3411,"text":"Rumlar en yakın bir yerde yenildiler. Onlar bu yenilgilerinden bir kaç yıl sonra galip geleceklerdir. İş, eninde sonunda Allah'a aittir. İşte o gün, inananlar, istediğine yardım eden Allah'ın yardımına sevineceklerdir. O güçlüdür, merhametlidir.","numberInSurah":2,"juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3412,"text":"Rumlar en yakın bir yerde yenildiler. Onlar bu yenilgilerinden bir kaç yıl sonra galip geleceklerdir. İş, eninde sonunda Allah'a aittir. İşte o gün, inananlar, istediğine yardım eden Allah'ın yardımına sevineceklerdir. O güçlüdür, merhametlidir.","numberInSurah":3,"juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3413,"text":"Rumlar en yakın bir yerde yenildiler. Onlar bu yenilgilerinden bir kaç yıl sonra galip geleceklerdir. İş, eninde sonunda Allah'a aittir. İşte o gün, inananlar, istediğine yardım eden Allah'ın yardımına sevineceklerdir. O güçlüdür, merhametlidir.","numberInSurah":4,"juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3414,"text":"Rumlar en yakın bir yerde yenildiler. Onlar bu yenilgilerinden bir kaç yıl sonra galip geleceklerdir. İş, eninde sonunda Allah'a aittir. İşte o gün, inananlar, istediğine yardım eden Allah'ın yardımına sevineceklerdir. O güçlüdür, merhametlidir.","numberInSurah":5,"juz":21,"manzil":5,"page":404,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3415,"text":"Bu, Allah'ın vaadidir; Allah verdiği sözden caymaz, fakat insanların çoğu bilmezler.","numberInSurah":6,"juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3416,"text":"Onlar, dünya hayatının görülen kısmını bilirler. Onlar, ahiretten habersizdirler.","numberInSurah":7,"juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3417,"text":"Kendi kendilerine, Allah'ın gökleri, yeri ve ikisinin arasında bulunanları, gerçek olarak ve belirli bir süre için yarattığını düşünmezler mi? Doğrusu insanların çoğu, Rablerine kavuşacaklarını inkar ederler.","numberInSurah":8,"juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3418,"text":"Yeryüzünde dolaşıp, kendilerinden önce geçmiş kimselerin sonlarının nasıl olduğuna bakmazlar mı? Ki onlar kendilerinden daha kuvvetli idiler, yeryüzünü kazıp alt üst ederek onlardan çok imar etmiş kimseydiler ve onlara belgelerle peygamberler gelmişti. Böylece Allah onlara zulmetmiyor, onlar kendilerine zulmediyorlardı.","numberInSurah":9,"juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3419,"text":"Sonra Allah'ın ayetlerini yalan sayıp, onları alaya alarak kötülük yapanların sonu pek kötü oldu.","numberInSurah":10,"juz":21,"manzil":5,"page":405,"ruku":349,"hizbQuarter":162,"sajda":false},{"number":3420,"text":"Allah önce yaratır, ölümünden sonra tekrar diriltir. Sonunda O'na döneceksiniz.","numberInSurah":11,"juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3421,"text":"Kıyamet koptuğu gün suçlular umutsuz kalıverirler.","numberInSurah":12,"juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3422,"text":"Koştukları ortakları artık şefaatçileri değildir; ortaklarını inkar ederler.","numberInSurah":13,"juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3423,"text":"Kıyamet koptuğu gün, işte o gün, darmadağın olurlar.","numberInSurah":14,"juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3424,"text":"Ama inanıp yararlı iş işleyenler, ağırlanacakları bir cennette bulunurlar.","numberInSurah":15,"juz":21,"manzil":5,"page":405,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3425,"text":"İnkar edip, ayetlerimizi ve ahirette Bana kavuşmayı yalanlayanlara gelince, işte onlar azabla yüzyüze bırakılırlar.","numberInSurah":16,"juz":21,"manzil":5,"page":406,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3426,"text":"Akşamlarken ve sabahlarken, öğle ve ikindi vaktinde Allah'ı -ki göklerde ve yerde hamd O'na mahsustur- tesbih edin, namaz kılın.","numberInSurah":17,"juz":21,"manzil":5,"page":406,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3427,"text":"Akşamlarken ve sabahlarken, öğle ve ikindi vaktinde Allah'ı -ki göklerde ve yerde hamd O'na mahsustur- tesbih edin, namaz kılın.","numberInSurah":18,"juz":21,"manzil":5,"page":406,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3428,"text":"O, ölüden diri çıkarır, diriden ölü çıkarır; yeryüzünü ölümünden sonra O canlandırır. Ey insanlar! İşte siz de böylece diriltileceksiniz.","numberInSurah":19,"juz":21,"manzil":5,"page":406,"ruku":350,"hizbQuarter":162,"sajda":false},{"number":3429,"text":"Sizi topraktan yaratması O'nun varlığının belgelerindendir. Sonra hemen birer insan olup yeryüzüne yayılırsınız.","numberInSurah":20,"juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3430,"text":"İçinizden, kendileriyle huzura kavuşacağınız eşler yaratıp; aranızda muhabbet ve rahmet var etmesi, O'nun varlığının belgelerindendir. Bunlarda, düşünen millet için dersler vardır.","numberInSurah":21,"juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3431,"text":"Gökleri ve yeri yaratması, dillerinizin ve renklerinizin değişik olması, O'nun varlığının belgelerindendir. Doğrusu bunlarda, bilenler için dersler vardır.","numberInSurah":22,"juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3432,"text":"Geceleyin uyumanız, gündüz de lütfundan rızık aramanız O'nun varlığının belgelerindendir. Bunlarda kulak veren millet için dersler vardır.","numberInSurah":23,"juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3433,"text":"Size korku ve ümit veren şimşeği göstermesi, gökten su indirip ölümünden sonra yeri onunla diriltmesi O'nun varlığının belgelerindendir. Bunlarda, düşünen millet için dersler vardır.","numberInSurah":24,"juz":21,"manzil":5,"page":406,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3434,"text":"Göğün ve yerin O'nun buyruğu ile ayakta durması O'nun varlığının belgelerindendir. Sonra sizi kabirlerinizden bir çağırmaya görsün, hemen çıkıverirsiniz.","numberInSurah":25,"juz":21,"manzil":5,"page":407,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3435,"text":"Göklerde ve yerde olanlar O'nundur; hepsi O'na boyun eğmiştir.","numberInSurah":26,"juz":21,"manzil":5,"page":407,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3436,"text":"Önce yaratan, ölümünden sonra tekrar dirilten O'dur. Bu, O'nun için daha kolaydır. Göklerde ve yerde olan en üstün sıfatlar O'nundur. O, güçlüdür, Hakim'dir.","numberInSurah":27,"juz":21,"manzil":5,"page":407,"ruku":351,"hizbQuarter":162,"sajda":false},{"number":3437,"text":"Allah size kendinizden bir misal vermektedir: Size verdiğimiz rızıklarda, emrinizde bulunan kölelerinizin de eşit surette hak sahibi olmalarına razı olur ve birbirinizi saydığınız gibi bu ortaklarınızı sayar mısınız? Düşünen millete ayetleri böylece uzun uzadıya açıklarız.","numberInSurah":28,"juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":162,"sajda":false},{"number":3438,"text":"Hayır; zulmedenler, körü körüne kendi heveslerine uymuşlardır. Allah'ın saptırdığı kimseleri kim doğru yola eriştirebilir? Onların yardımcıları da yoktur.","numberInSurah":29,"juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":162,"sajda":false},{"number":3439,"text":"Hakka yönelerek kendini Allah'ın insanlara yaratılışta verdiği dine ver. Zira Allah'ın yaratışında değişme yoktur; işte dosdoğru din budur, fakat insanların çoğu bilmezler.","numberInSurah":30,"juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":162,"sajda":false},{"number":3440,"text":"Allah'a yönelerek O'na karşı gelmekten sakınınız, namaz kılınız, dinlerinde ayrılığa düşüp fırka fırka olan, her fırkasının da kendisinde bulunanla sevindiği müşriklerden olmayınız.","numberInSurah":31,"juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3441,"text":"Allah'a yönelerek O'na karşı gelmekten sakınınız, namaz kılınız, dinlerinde ayrılığa düşüp fırka fırka olan, her fırkasının da kendisinde bulunanla sevindiği müşriklerden olmayınız.","numberInSurah":32,"juz":21,"manzil":5,"page":407,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3442,"text":"İnsanlar bir darlığa uğrayınca Rablerine dönerek O'na yalvarırlar, sonra Allah katından onlara bir rahmet tattırınca içlerinden bir takımı kendilerine verdiklerimize nankörlük ederek Rablerine eş koşarlar. Safa sürün bakalım, yakında göreceksiniz.","numberInSurah":33,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3443,"text":"İnsanlar bir darlığa uğrayınca Rablerine dönerek O'na yalvarırlar, sonra Allah katından onlara bir rahmet tattırınca içlerinden bir takımı kendilerine verdiklerimize nankörlük ederek Rablerine eş koşarlar. Safa sürün bakalım, yakında göreceksiniz.","numberInSurah":34,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3444,"text":"Yoksa onlara ortak koşmalarını söyleyen bir delil mi indirdik.","numberInSurah":35,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3445,"text":"İnsanlara bir rahmet tattırdığımız zaman ona sevinirler, ama yaptıklarından ötürü başlarına bir kötülük gelirse hemen ümitlerini kaybediverirler.","numberInSurah":36,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3446,"text":"Allah'ın, rızkı dilediğine yayıp bir ölçüye göre verdiğini görmezler mi? Doğrusu bunda, inananlar için dersler vardır.","numberInSurah":37,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3447,"text":"Yakınlığı olana, yoksula, yolda kalmışa hakkını ver. Allah'ın rızasını dileyenler için bu daha hayırlıdır. İşte onlar saadete erenlerdir.","numberInSurah":38,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3448,"text":"İnsanların malları içinde artsın diye verdiğiniz her hangi bir faiz Allah katında artmaz; fakat, Allah'ın rızasını dileyerek verdiğiniz herhangi bir sadaka (zekat) böyle değildir. İşte onlar sevablarını kat kat artıranlardır.","numberInSurah":39,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3449,"text":"Sizi yaratan, sonra rızıklandıran, sonra öldüren, daha sonra da dirilten Allah'tır. O'na koştuğunuz ortaklarınızdan böyle bir şey yapan var mıdır? Allah onların ortak koştukları şeylerden münezzehtir, yücedir.","numberInSurah":40,"juz":21,"manzil":5,"page":408,"ruku":352,"hizbQuarter":163,"sajda":false},{"number":3450,"text":"İnsanların elleriyle işledikleri yüzünden karada ve denizde fesat çıkar; Allah da belki dönerler diye yaptıklarının bir kısmını böylece kendilerine tattırır.","numberInSurah":41,"juz":21,"manzil":5,"page":408,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3451,"text":"De ki: \"Yeryüzünde dolaşın da daha öncekilerden çoğu ortak koşan (müşrik) olanların sonunun nasıl olduğuna bir bakın.\"","numberInSurah":42,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3452,"text":"İnsanların fırka fırka olacağı, Allah katından kaçınılmaz o günün gelmesinden önce, kendini dosdoğru dine yönelt.","numberInSurah":43,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3453,"text":"Kim inkar ederse, inkarı kendi aleyhine olur. Yararlı iş işleyen kimseler, kendileri için rahat bir yer hazırlamış olurlar.","numberInSurah":44,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3454,"text":"Çünkü Allah inanıp yararlı iş işleyenlere lütfundan karşılık verecektir. Doğrusu O, inkarcıları sevmez.","numberInSurah":45,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3455,"text":"Rüzgarları müjdeciler olarak göndermesi, size rahmetini tattırması, buyruğu ile gemilerin yürümesi, lütfundan rızık istemeniz, O'nun varlığının belgelerindendir. Belki şükredersiniz.","numberInSurah":46,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3456,"text":"And olsun ki! Senden önce, birçok peygamberleri ümmetlerine gönderdik, onlara belgeler getirdiler; dinlemeyip suç işleyenlerden öç aldık, zira inananlara yardım etmek bize hak olmuştu.","numberInSurah":47,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3457,"text":"Rüzgarları gönderip bulutları yürüten, onları gökte dilediği gibi yayan ve küme küme yığan Allah'tır. Artık sen de aralarından yağmurun çıktığını görürsün. Allah'ın kullarından dilediğine verdiği yağmurla, daha önceden kendilerine yağmur indirilmesinden ümidlerini kesmiş oldukları için onlar seviniverirler.","numberInSurah":48,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3458,"text":"Rüzgarları gönderip bulutları yürüten, onları gökte dilediği gibi yayan ve küme küme yığan Allah'tır. Artık sen de aralarından yağmurun çıktığını görürsün. Allah'ın kullarından dilediğine verdiği yağmurla, daha önceden kendilerine yağmur indirilmesinden ümidlerini kesmiş oldukları için onlar seviniverirler.","numberInSurah":49,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3459,"text":"Allah'ın rahmetinin belirtilerine bir bak, yeryüzünü ölümünden sonra nasıl diriltiyor? Şüphesiz ölüleri O diriltir. O her şeye Kadir'dir.","numberInSurah":50,"juz":21,"manzil":5,"page":409,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3460,"text":"Bir rüzgar göndersek de yeşilliklerin sarardığını görseler hemen nankörlüğe başlarlar.","numberInSurah":51,"juz":21,"manzil":5,"page":410,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3461,"text":"Tabiidir ki sen ölülere katiyyen işittiremezsin; dönüp giden sağırlara da çağrıyı duyuramazsın.","numberInSurah":52,"juz":21,"manzil":5,"page":410,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3462,"text":"Körleri sapıklıklarından vazgeçirip doğru yola döndüremezsin; ancak ayetlerimize inananlara duyurabilirsin; işte onlar Müslümanlardır.","numberInSurah":53,"juz":21,"manzil":5,"page":410,"ruku":353,"hizbQuarter":163,"sajda":false},{"number":3463,"text":"Sizi güçsüz olarak yaratan, güçsüzlükten sonra kuvvetli kılan, sonra da kuvvetliliğin ardından güçsüz ve ihtiyar yapan Allah'tır. O, dilediğini yaratır; bilendir, Kadir olandır.","numberInSurah":54,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3464,"text":"Kıyamet koptuğu gün suçlular sadece çok kısa bir müddet kalmış olduklarına yemin ederler. Böylece onlar dünyada da aldatılıp haktan döndürülüyorlardı.","numberInSurah":55,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3465,"text":"Kendilerine ilim ve iman verilenler; \"And olsun ki, siz Allah'ın yazısında mevcut yeniden dirilme gününe kadar kaldınız. İşte bu yeniden dirilme günüdür, fakat sizler anlamıyordunuz\" derler.","numberInSurah":56,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3466,"text":"Zulmedenlerin, o gün mazeretleri fayda vermez; artık kendilerinden Allah'ı hoşnut edecek şeyleri yapmaları da istenmez.","numberInSurah":57,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3467,"text":"And olsun ki bu Kuran'da insanlar için her türlü misali vermişizdir. Bununla beraber, eğer sen onlara bir mucize getirmiş olsan, inkar edenler: \"Siz ancak batıl şeyler ortaya atanlarsınız\" derler.","numberInSurah":58,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3468,"text":"Allah bilmeyenlerin kalblerini işte böylece kapatır.","numberInSurah":59,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false},{"number":3469,"text":"Sabret ki, Allah'ın sözü şüphesiz gerçektir. Kesin olarak inanmayanlar seni hafife almasınlar.","numberInSurah":60,"juz":21,"manzil":5,"page":410,"ruku":354,"hizbQuarter":164,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}