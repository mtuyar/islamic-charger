{"arabic":{"number":67,"name":"سُورَةُ المُلۡكِ","englishName":"Mülk","englishNameTranslation":"The Sovereignty","revelationType":"Meccan","numberOfAyahs":30,"ayahs":[{"number":5242,"text":"بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ تَبَارَكَ الَّذِي بِيَدِهِ الْمُلْكُ وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ","numberInSurah":1,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5243,"text":"الَّذِي خَلَقَ الْمَوْتَ وَالْحَيَاةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًا ۚ وَهُوَ الْعَزِيزُ الْغَفُورُ","numberInSurah":2,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5244,"text":"الَّذِي خَلَقَ سَبْعَ سَمَاوَاتٍ طِبَاقًا ۖ مَا تَرَىٰ فِي خَلْقِ الرَّحْمَٰنِ مِنْ تَفَاوُتٍ ۖ فَارْجِعِ الْبَصَرَ هَلْ تَرَىٰ مِنْ فُطُورٍ","numberInSurah":3,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5245,"text":"ثُمَّ ارْجِعِ الْبَصَرَ كَرَّتَيْنِ يَنْقَلِبْ إِلَيْكَ الْبَصَرُ خَاسِئًا وَهُوَ حَسِيرٌ","numberInSurah":4,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5246,"text":"وَلَقَدْ زَيَّنَّا السَّمَاءَ الدُّنْيَا بِمَصَابِيحَ وَجَعَلْنَاهَا رُجُومًا لِلشَّيَاطِينِ ۖ وَأَعْتَدْنَا لَهُمْ عَذَابَ السَّعِيرِ","numberInSurah":5,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5247,"text":"وَلِلَّذِينَ كَفَرُوا بِرَبِّهِمْ عَذَابُ جَهَنَّمَ ۖ وَبِئْسَ الْمَصِيرُ","numberInSurah":6,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5248,"text":"إِذَا أُلْقُوا فِيهَا سَمِعُوا لَهَا شَهِيقًا وَهِيَ تَفُورُ","numberInSurah":7,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5249,"text":"تَكَادُ تَمَيَّزُ مِنَ الْغَيْظِ ۖ كُلَّمَا أُلْقِيَ فِيهَا فَوْجٌ سَأَلَهُمْ خَزَنَتُهَا أَلَمْ يَأْتِكُمْ نَذِيرٌ","numberInSurah":8,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5250,"text":"قَالُوا بَلَىٰ قَدْ جَاءَنَا نَذِيرٌ فَكَذَّبْنَا وَقُلْنَا مَا نَزَّلَ اللَّهُ مِنْ شَيْءٍ إِنْ أَنْتُمْ إِلَّا فِي ضَلَالٍ كَبِيرٍ","numberInSurah":9,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5251,"text":"وَقَالُوا لَوْ كُنَّا نَسْمَعُ أَوْ نَعْقِلُ مَا كُنَّا فِي أَصْحَابِ السَّعِيرِ","numberInSurah":10,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5252,"text":"فَاعْتَرَفُوا بِذَنْبِهِمْ فَسُحْقًا لِأَصْحَابِ السَّعِيرِ","numberInSurah":11,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5253,"text":"إِنَّ الَّذِينَ يَخْشَوْنَ رَبَّهُمْ بِالْغَيْبِ لَهُمْ مَغْفِرَةٌ وَأَجْرٌ كَبِيرٌ","numberInSurah":12,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5254,"text":"وَأَسِرُّوا قَوْلَكُمْ أَوِ اجْهَرُوا بِهِ ۖ إِنَّهُ عَلِيمٌ بِذَاتِ الصُّدُورِ","numberInSurah":13,"juz":29,"manzil":7,"page":563,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5255,"text":"أَلَا يَعْلَمُ مَنْ خَلَقَ وَهُوَ اللَّطِيفُ الْخَبِيرُ","numberInSurah":14,"juz":29,"manzil":7,"page":563,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5256,"text":"هُوَ الَّذِي جَعَلَ لَكُمُ الْأَرْضَ ذَلُولًا فَامْشُوا فِي مَنَاكِبِهَا وَكُلُوا مِنْ رِزْقِهِ ۖ وَإِلَيْهِ النُّشُورُ","numberInSurah":15,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5257,"text":"أَأَمِنْتُمْ مَنْ فِي السَّمَاءِ أَنْ يَخْسِفَ بِكُمُ الْأَرْضَ فَإِذَا هِيَ تَمُورُ","numberInSurah":16,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5258,"text":"أَمْ أَمِنْتُمْ مَنْ فِي السَّمَاءِ أَنْ يُرْسِلَ عَلَيْكُمْ حَاصِبًا ۖ فَسَتَعْلَمُونَ كَيْفَ نَذِيرِ","numberInSurah":17,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5259,"text":"وَلَقَدْ كَذَّبَ الَّذِينَ مِنْ قَبْلِهِمْ فَكَيْفَ كَانَ نَكِيرِ","numberInSurah":18,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5260,"text":"أَوَلَمْ يَرَوْا إِلَى الطَّيْرِ فَوْقَهُمْ صَافَّاتٍ وَيَقْبِضْنَ ۚ مَا يُمْسِكُهُنَّ إِلَّا الرَّحْمَٰنُ ۚ إِنَّهُ بِكُلِّ شَيْءٍ بَصِيرٌ","numberInSurah":19,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5261,"text":"أَمَّنْ هَٰذَا الَّذِي هُوَ جُنْدٌ لَكُمْ يَنْصُرُكُمْ مِنْ دُونِ الرَّحْمَٰنِ ۚ إِنِ الْكَافِرُونَ إِلَّا فِي غُرُورٍ","numberInSurah":20,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5262,"text":"أَمَّنْ هَٰذَا الَّذِي يَرْزُقُكُمْ إِنْ أَمْسَكَ رِزْقَهُ ۚ بَلْ لَجُّوا فِي عُتُوٍّ وَنُفُورٍ","numberInSurah":21,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5263,"text":"أَفَمَنْ يَمْشِي مُكِبًّا عَلَىٰ وَجْهِهِ أَهْدَىٰ أَمَّنْ يَمْشِي سَوِيًّا عَلَىٰ صِرَاطٍ مُسْتَقِيمٍ","numberInSurah":22,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5264,"text":"قُلْ هُوَ الَّذِي أَنْشَأَكُمْ وَجَعَلَ لَكُمُ السَّمْعَ وَالْأَبْصَارَ وَالْأَفْئِدَةَ ۖ قَلِيلًا مَا تَشْكُرُونَ","numberInSurah":23,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5265,"text":"قُلْ هُوَ الَّذِي ذَرَأَكُمْ فِي الْأَرْضِ وَإِلَيْهِ تُحْشَرُونَ","numberInSurah":24,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5266,"text":"وَيَقُولُونَ مَتَىٰ هَٰذَا الْوَعْدُ إِنْ كُنْتُمْ صَادِقِينَ","numberInSurah":25,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5267,"text":"قُلْ إِنَّمَا الْعِلْمُ عِنْدَ اللَّهِ وَإِنَّمَا أَنَا نَذِيرٌ مُبِينٌ","numberInSurah":26,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5268,"text":"فَلَمَّا رَأَوْهُ زُلْفَةً سِيئَتْ وُجُوهُ الَّذِينَ كَفَرُوا وَقِيلَ هَٰذَا الَّذِي كُنْتُمْ بِهِ تَدَّعُونَ","numberInSurah":27,"juz":29,"manzil":7,"page":564,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5269,"text":"قُلْ أَرَأَيْتُمْ إِنْ أَهْلَكَنِيَ اللَّهُ وَمَنْ مَعِيَ أَوْ رَحِمَنَا فَمَنْ يُجِيرُ الْكَافِرِينَ مِنْ عَذَابٍ أَلِيمٍ","numberInSurah":28,"juz":29,"manzil":7,"page":564,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5270,"text":"قُلْ هُوَ الرَّحْمَٰنُ آمَنَّا بِهِ وَعَلَيْهِ تَوَكَّلْنَا ۖ فَسَتَعْلَمُونَ مَنْ هُوَ فِي ضَلَالٍ مُبِينٍ","numberInSurah":29,"juz":29,"manzil":7,"page":564,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5271,"text":"قُلْ أَرَأَيْتُمْ إِنْ أَصْبَحَ مَاؤُكُمْ غَوْرًا فَمَنْ يَأْتِيكُمْ بِمَاءٍ مَعِينٍ","numberInSurah":30,"juz":29,"manzil":7,"page":564,"ruku":497,"hizbQuarter":225,"sajda":false}],"edition":{"identifier":"quran-simple","language":"ar","name":"القرآن الكريم المبسط (تشكيل بسيط) (simple)","englishName":"Simple","format":"text","type":"quran"}},"turkish":{"number":67,"name":"سُورَةُ المُلۡكِ","englishName":"Mülk","englishNameTranslation":"The Sovereignty","revelationType":"Meccan","numberOfAyahs":30,"ayahs":[{"number":5242,"text":"Hükümranlık elinde olan Allah yücedir ve O herşeye Kadir'dir.","numberInSurah":1,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5243,"text":"Hanginizin daha iyi iş işlediğini belirtmek için, ölümü ve dirimi (hayatı) yaratan O'dur. O, güçlüdür, bağışlayandır.","numberInSurah":2,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5244,"text":"Gökleri yedi kat üzerine yaratan O'dur. Rahman'ın bu yaratmasında bir düzensizlik bulamazsın. Gözünü bir çevir bak, bir çatlak görebilir misin?","numberInSurah":3,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5245,"text":"Bir aksaklık bulmak için gözünü tekrar tekrar çevir bak; ama göz umduğunu bulamayıp bitkin ve yorgun düşer.","numberInSurah":4,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5246,"text":"And olsun ki, yakın göğü kandillerle donattık, onları şeytanlar için taşlamalar yaptık ve şeytanlara çılgın alev azabını hazırladık.","numberInSurah":5,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5247,"text":"Rablerini inkar eden kimseler için cehennem azabı vardır. Ne kötü bir dönüştür!","numberInSurah":6,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5248,"text":"Oraya atıldıkları zaman, onun kaynarken çıkardığı uğultuyu işitirler.","numberInSurah":7,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5249,"text":"Nerede ise öfkesinden paralanacak! İçine her bir topluluğun atılmasında, bekçileri onlara: \"Size bir uyarıcı gelmemiş miydi?\" diye sorarlar.","numberInSurah":8,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5250,"text":"Onlar: \"Evet; doğrusu bize bir uyarıcı geldi, fakat biz yalanladık ve Allah hiçbir şey indirmemiştir, siz büyük bir sapıklık içindesiniz demiştik\" derler.","numberInSurah":9,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5251,"text":"\"Eğer kulak vermiş veya akletmiş olsaydık, çılgın alevli cehennemlikler içinde olmazdık\" derler.","numberInSurah":10,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5252,"text":"Böylece, günahlarını itiraf ederler. Çılgın alevli cehennemlikler yok olsunlar!","numberInSurah":11,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5253,"text":"Doğrusu, görünmediği halde Rablerinden korkanlara, onlara, bağışlanma ve büyük ecir vardır.","numberInSurah":12,"juz":29,"manzil":7,"page":562,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5254,"text":"Sizler, sözlerinizi gizleseniz de açıklasanız da birdir; O, kalblerde olanı bilir.","numberInSurah":13,"juz":29,"manzil":7,"page":563,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5255,"text":"Yaratan bilmez olur mu? O, Latif'tir, haberdardır.","numberInSurah":14,"juz":29,"manzil":7,"page":563,"ruku":496,"hizbQuarter":225,"sajda":false},{"number":5256,"text":"Yeryüzünü, size boyun eğdiren O'dur; öyleyse yerin sırtlarında dolaşın, Allah'ın verdiği rızıktan yiyin; sonunda dönüş O'nadır.","numberInSurah":15,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5257,"text":"Gökte olanın sizi yerin dibine geçirmesinden güvende misiniz? O zaman, yer, sarsıldıkça sarsılır.","numberInSurah":16,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5258,"text":"Gökte olanın başınıza taş yağdırmasından güvende misiniz? Benim uyarmamın nasıl olduğunu yakında bileceksiniz.","numberInSurah":17,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5259,"text":"And olsun ki, bunlardan öncekiler de yalanlamışlardı. Beni inkar etmek nasılmış?","numberInSurah":18,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5260,"text":"Üzerlerinde kanat çırpan dizi dizi kuşları görmezler mi? Onları havada Rahman olan Allah'tan başkası tutmuyor; doğrusu, O, herşeyi görendir.","numberInSurah":19,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5261,"text":"Yahut, Rahman olan Allah'ın dışında size yardımda bulunabilecek taraftarlarınız kimdir? İnkarcılar sadece aldanmaktadırlar.","numberInSurah":20,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5262,"text":"Allah size verdiği rızkı kesiverirse, size rızık verecek başka kim vardır? Hayır; onlar, azgınlık ve nefrette direnmektedirler.","numberInSurah":21,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5263,"text":"Yüzükoyun sürünen mi, yoksa doğru yolda düpedüz yürüyen mi daha doğru yoldadır?","numberInSurah":22,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5264,"text":"De ki: \"Sizi yaratan sizin için kulaklar, gözler ve kalbler var eden O'dur. Ne az şükrediyorsunuz!\"","numberInSurah":23,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5265,"text":"Sizi yerde yaratıp yayan O'dur ve O'nun huzurunda toplanacaksınız.","numberInSurah":24,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5266,"text":"\"Doğru sözlü iseniz bildirin bu azap sözü ne zamandır?\" derler.","numberInSurah":25,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5267,"text":"De ki: \"Onu bilmek ancak Allah'a mahsustur. Ben sadece apaçık bir uyarıcıyım.\"","numberInSurah":26,"juz":29,"manzil":7,"page":563,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5268,"text":"Azabı yaklaşırken gördükleri zaman, inkar edenlerin yüzleri çirkinleşip kararır; onlara: \"Sizin arayıp durduğunuz işte budur\" denir.","numberInSurah":27,"juz":29,"manzil":7,"page":564,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5269,"text":"De ki: \"Allah, beni ve benimle beraber bulunanları isterse yok eder veya isterse merhamet eder; söyleyin, bu takdirde inkarcıları, can yakıcı azabdan kim alıkoyabilir?\"","numberInSurah":28,"juz":29,"manzil":7,"page":564,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5270,"text":"De ki: \"Bizim inandığımız ve kendisine güvendiğimiz, Rahman olan Allah'tır. Kimin apaçık bir sapıklıkta olduğunu yakında bileceksiniz.\"","numberInSurah":29,"juz":29,"manzil":7,"page":564,"ruku":497,"hizbQuarter":225,"sajda":false},{"number":5271,"text":"De ki: \"Suyunuz yere batarsa, söyleyin, size kim temiz bir su kaynağı getirebilir?\"","numberInSurah":30,"juz":29,"manzil":7,"page":564,"ruku":497,"hizbQuarter":225,"sajda":false}],"edition":{"identifier":"tr.diyanet","language":"tr","name":"Diyanet İşleri","englishName":"Diyanet Isleri","format":"text","type":"translation"}}}